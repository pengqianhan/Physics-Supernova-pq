import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# We'll use a threshold to determine if a room is heating.                      
# Since max dx is ~0.005 and min is ~-0.002, a threshold of 0.0 should work.    
# Actually, let's be more precise.                                              
def get_mode(dx1, dx2, dx3):                                                    
    if dx1 > 0: return 1                                                        
    if dx2 > 0: return 2                                                        
    if dx3 > 0: return 3                                                        
    return 0                                                                    
                                                                                
modes = np.array([get_mode(d1, d2, d3) for d1, d2, d3 in zip(dx1, dx2, dx3)])   
                                                                                
# Now let's group data by mode and room                                         
results = {}                                                                    
for m in range(4):                                                              
    mask = (modes == m)                                                         
    if np.sum(mask) < 2: continue                                               
    results[m] = {}                                                             
    for i in range(3):                                                          
        xi = X[i][mask]                                                         
        dxi = DX[i][mask]                                                       
        # Fit dxi = -k * xi + C                                                 
        # Or dxi = m * xi + C  => -k = m                                        
        reg = LinearRegression().fit(xi.reshape(-1, 1), dxi)                    
        k = -reg.coef_[0]                                                       
        C = reg.intercept_                                                      
        score = reg.score(xi.reshape(-1, 1), dxi)                               
        results[m][i] = {'k': k, 'C': C, 'score': score}                        
                                                                                
for m in results:                                                               
    print(f"Mode {m}:")                                                         
    for i in range(3):                                                          
        print(f"  Room {i+1}: k={results[m][i]['k']:.6f},                       
C={results[m][i]['C']:.6f}, R^2={results[m][i]['score']:.6f}")                  
                                                                                
