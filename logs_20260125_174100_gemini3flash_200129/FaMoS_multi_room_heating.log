# Task: Analyze the trajectory data to identify the hybrid automaton parameters.
# 1. Load the state data from the first sample.                                 
# 2. Estimate the derivative of each state variable (x1, x2, x3).               
# 3. Identify segments where only one variable is increasing (heating mode) and 
segments where all are decreasing (if any).                                     
# 4. For each mode, estimate the linear ODE parameters: x'[i] = a * x[i] + b.   
# 5. Determine the switching points (times and state values) to infer guard     
conditions.                                                                     
# 6. Check the initial state and mode.                                          
                                                                                
analysis_code = """                                                             
import numpy as np                                                              
                                                                                
def analyze_sample(data):                                                       
    state = data['state']                                                       
    dt = 0.001                                                                  
    time = np.arange(state.shape[1]) * dt                                       
                                                                                
    # Calculate derivatives using central differences                           
    dstate = np.gradient(state, dt, axis=1)                                     
                                                                                
    # Identify modes based on which variable is increasing                      
    # Mode 2: x1 increasing, Mode 3: x2 increasing, Mode 4: x3 increasing       
    # Mode 1: All decreasing (or no specific heating)                           
                                                                                
    is_increasing = dstate > 0.1 # threshold for noise                          
                                                                                
    # Let's find segments                                                       
    modes = np.zeros(state.shape[1])                                            
    for i in range(state.shape[1]):                                             
        inc = np.where(is_increasing[:, i])[0]                                  
        if len(inc) == 1:                                                       
            modes[i] = inc[0] + 2 # Mode 2, 3, or 4                             
        elif len(inc) == 0:                                                     
            modes[i] = 1                                                        
        else:                                                                   
            # multiple increasing? pick the one with largest derivative maybe   
            modes[i] = np.argmax(dstate[:, i]) + 2                              
                                                                                
    # Find change points                                                        
    change_points = np.where(modes[:-1] != modes[1:])[0]                        
                                                                                
    results = {                                                                 
        "initial_state": state[:, 0].tolist(),                                  
        "initial_mode": modes[0],                                               
        "change_points": []                                                     
    }                                                                           
                                                                                
    for cp in change_points:                                                    
        results["change_points"].append({                                       
            "time": time[cp],                                                   
            "from_mode": modes[cp],                                             
            "to_mode": modes[cp+1],                                             
            "state_at_switch": state[:, cp].tolist()                            
        })                                                                      
                                                                                
    # Estimate parameters for each mode                                         
    # x'[i] = a * x[i] + b                                                      
    # We assume 'a' is common across modes and variables for simplicity, or     
check it.                                                                       
                                                                                
    params = {}                                                                 
    for m in [1, 2, 3, 4]:                                                      
        indices = np.where(modes == m)[0]                                       
        if len(indices) > 50:                                                   
            m_params = {}                                                       
            for i in range(3):                                                  
                x = state[i, indices]                                           
                dx = dstate[i, indices]                                         
                # Fit dx = a*x + b                                              
                # Use linear regression                                         
                A = np.vstack([x, np.ones(len(x))]).T                           
                a, b = np.linalg.lstsq(A, dx, rcond=None)[0]                    
                m_params[f"x{i+1}"] = {"a": a, "b": b}                          
            params[m] = m_params                                                
                                                                                
    results["params"] = params                                                  
    return results                                                              
                                                                                
# Assuming the expert has access to multiple samples, let's look at one.        
import glob                                                                     
files = glob.glob("*.npz")                                                      
if files:                                                                       
    data = np.load(files[0])                                                    
    print(analyze_sample(data))                                                 
else:                                                                           
    print("No files found")                                                     
"""                                                                             
                                                                                
data_analysis_expert(task=analysis_code, additional_args={})                    
                                                                                
