import numpy as np                                                              
                                                                                
def get_heater_states(state, dx):                                               
    n_vars, n_steps = state.shape                                               
    heater_on = np.zeros((n_vars, n_steps-1), dtype=bool)                       
                                                                                
    for i in range(n_vars):                                                     
        d2x = np.diff(dx[i])                                                    
        jumps = np.where(np.abs(d2x) > 0.001)[0]                                
                                                                                
        # Determine initial state                                               
        # If the first jump is negative, it was ON and turned OFF.              
        # If the first jump is positive, it was OFF and turned ON.              
        # But we need to know if dx is positive or negative.                    
        # Generally, heater ON makes dx more positive.                          
        if len(jumps) > 0:                                                      
            first_jump_idx = jumps[0]                                           
            if d2x[first_jump_idx] > 0: # Turned ON                             
                heater_on[i, :first_jump_idx+1] = False                         
            else: # Turned OFF                                                  
                heater_on[i, :first_jump_idx+1] = True                          
                                                                                
            # Fill the rest                                                     
            current_state = not heater_on[i, first_jump_idx]                    
            last_idx = first_jump_idx + 1                                       
            for jump_idx in jumps[1:]:                                          
                heater_on[i, last_idx : jump_idx+1] = current_state             
                current_state = not current_state                               
                last_idx = jump_idx + 1                                         
            heater_on[i, last_idx:] = current_state                             
                                                                                
    return heater_on                                                            
                                                                                
# Process all samples                                                           
all_states = []                                                                 
all_dx = []                                                                     
all_heaters = []                                                                
                                                                                
for s in range(3):                                                              
    data = np.load(f'data_all/FaMoS/multi_room_heating/sample_{s}.npz')         
    state = data['state']                                                       
    dx = np.diff(state, axis=1)                                                 
    heaters = get_heater_states(state, dx)                                      
                                                                                
    # We have state from t=0 to 10000 (10001 points)                            
    # dx is from t=0 to 9999 (10000 points)                                     
    # heaters is from t=0 to 9999 (10000 points)                                
    # Align them: use state[:, :-1]                                             
    all_states.append(state[:, :-1])                                            
    all_dx.append(dx)                                                           
    all_heaters.append(heaters)                                                 
                                                                                
# Concatenate all data for regression                                           
X = np.concatenate(all_states, axis=1).T # Shape (N, 3)                         
Y = np.concatenate(all_dx, axis=1).T # Shape (N, 3)                             
H = np.concatenate(all_heaters, axis=1).T # Shape (N, 3)                        
                                                                                
# Regression for each room                                                      
# dy_i = a_i1*x1 + a_i2*x2 + a_i3*x3 + b_i + h_i*H_i                            
from sklearn.linear_model import LinearRegression                               
                                                                                
for i in range(3):                                                              
    # Features: x1, x2, x3, heater_i                                            
    # Note: Coupling might be (xj - xi)                                         
    # Let's use x1, x2, x3 and H_i                                              
    features = np.column_stack([X, H[:, i]])                                    
    model = LinearRegression().fit(features, Y[:, i])                           
    print(f"Room {i+1} model coefficients:")                                    
    print(f"  x1, x2, x3: {model.coef_[:3]}")                                   
    print(f"  Heater: {model.coef_[3]}")                                        
    print(f"  Intercept: {model.intercept_}")                                   
    print(f"  R^2: {model.score(features, Y[:, i])}")                           
                                                                                
