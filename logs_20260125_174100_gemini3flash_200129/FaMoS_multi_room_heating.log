  void Game::setup() {                                                          
      int choice;                                                               
      string name1, name2;                                                      
                                                                                
      cout << "Welcome to Tic Tac Toe!" << endl;                                
      cout << "1. Human vs Human" << endl;                                      
      cout << "2. Human vs Computer" << endl;                                   
      cout << "Enter choice: ";                                                 
      cin >> choice;                                                            
                                                                                
      cout << "Enter Player 1 name: ";                                          
      cin >> name1;                                                             
      player1 = new HumanPlayer(name1);                                         
                                                                                
      if (choice == 1) {                                                        
          cout << "Enter Player 2 name: ";                                      
          cin >> name2;                                                         
          player2 = new HumanPlayer(name2);                                     
      }                                                                         
      else {                                                                    
          player2 = new ComputerPlayer("Computer");                             
      }                                                                         
  }                                                                             
                                                                                
  void Game::play() {                                                           
      bool gameOver = false;                                                    
                                                                                
      while (!gameOver) {                                                       
          board.displayBoard();                                                 
          Player* currentPlayer = (board.getCurrentPlayer() == 1) ? player1 :   
  player2;                                                                      
                                                                                
          int move;                                                             
          bool validMove = false;                                               
          while (!validMove) {                                                  
              move = currentPlayer->getMove(board);                             
              int r = move / 10, c = move % 10;                                 
              if (board.makeMove(r, c)) {                                       
                  validMove = true;                                             
              }                                                                 
              else if (dynamic_cast<HumanPlayer*>(currentPlayer)) {             
                  cout << "Invalid move, try again." << endl;                   
              }                                                                 
          }                                                                     
                                                                                
          if (board.checkWinner()) {                                            
              board.displayBoard();                                             
              cout << "Winner: " << currentPlayer->getName() << "!" << endl;    
              gameOver = true;                                                  
          }                                                                     
          else if (board.isBoardFull()) {                                       
              board.displayBoard();                                             
              cout << "It's a tie!" << endl;                                    
              gameOver = true;                                                  
          }                                                                     
          else {                                                                
              board.switchPlayer();                                             
          }                                                                     
      }                                                                         
  }                                                                             
