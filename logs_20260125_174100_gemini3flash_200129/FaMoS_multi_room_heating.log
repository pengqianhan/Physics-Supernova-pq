def analyze_sample(data):                                                       
    # Usually data has 't' and 'x' or similar.                                  
    # Let's check keys and assume standard naming or inspect first few rows.    
    # Looking at the names, I expect 't' and 'x' (where x is [x1, x2, x3]).     
    t = data['t']                                                               
    x = data['x']                                                               
                                                                                
    dt = np.diff(t)                                                             
    dx = np.diff(x, axis=0)                                                     
    slopes = dx / dt[:, np.newaxis]                                             
                                                                                
    # Identify heating (positive slope)                                         
    # Since there might be noise or numerical errors, use a small threshold     
    threshold = 0.001                                                           
    heating = slopes > threshold                                                
                                                                                
    # Transitions: where heating mask changes                                   
    transitions = []                                                            
    for i in range(1, len(heating)):                                            
        if not np.array_equal(heating[i], heating[i-1]):                        
            transitions.append(t[i])                                            
                                                                                
    # Initial state                                                             
    initial_x = x[0]                                                            
    initial_heating = heating[0]                                                
                                                                                
    # Estimate k and Q                                                          
    # If all cooling: dx/dt = -k * x => k = -slope/x                            
    # If xi is heating: dx_i/dt = -k * xi + Q_i => Q_i = dx_i/dt + k * xi       
                                                                                
    all_cooling_mask = np.all(~heating, axis=1)                                 
    k_vals = []                                                                 
    if np.any(all_cooling_mask):                                                
        indices = np.where(all_cooling_mask)[0]                                 
        for idx in indices:                                                     
            for j in range(3):                                                  
                if x[idx, j] != 0:                                              
                    k_vals.append(-slopes[idx, j] / x[idx, j])                  
                                                                                
    k_est = np.median(k_vals) if k_vals else None                               
                                                                                
    q_ests = [None, None, None]                                                 
    if k_est is not None:                                                       
        for j in range(3):                                                      
            qi_vals = []                                                        
            is_heating = heating[:, j]                                          
            if np.any(is_heating):                                              
                indices = np.where(is_heating)[0]                               
                for idx in indices:                                             
                    qi_vals.append(slopes[idx, j] + k_est * x[idx, j])          
                q_ests[j] = np.median(qi_vals)                                  
                                                                                
    return {                                                                    
        "t": t,                                                                 
        "x": x,                                                                 
        "heating": heating,                                                     
        "transitions": transitions,                                             
        "initial_x": initial_x,                                                 
        "initial_heating": initial_heating,                                     
        "k": k_est,                                                             
        "Q": q_ests                                                             
    }                                                                           
                                                                                
results = [analyze_sample(d) for d in [data_0, data_1, data_2]]                 
                                                                                
for i, res in enumerate(results):                                               
    print(f"\n--- Sample {i} ---")                                              
    print(f"Initial State: {res['initial_x']}, Initial Heating:                 
{res['initial_heating']}")                                                      
    print(f"Transitions: {res['transitions']}")                                 
    print(f"Estimated k: {res['k']}, Estimated Qs: {res['Q']}")                 
    # Print transition values                                                   
    for ts in res['transitions']:                                               
        idx = np.searchsorted(res['t'], ts)                                     
        print(f"At t={ts:.3f}, x={res['x'][idx]}")                              
                                                                                
