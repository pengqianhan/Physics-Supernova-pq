import numpy as np                                                              
                                                                                
def analyze_room(x, name):                                                      
    dx = np.diff(x)                                                             
    # Cooling: dx is negative                                                   
    cool_idx = np.where(dx < 0)[0]                                              
    A_cool = np.vstack([x[cool_idx], np.ones(len(cool_idx))]).T                 
    slope_cool, intercept_cool = np.linalg.lstsq(A_cool, dx[cool_idx],          
rcond=None)[0]                                                                  
                                                                                
    # Heating: dx is positive                                                   
    heat_idx = np.where(dx > 0)[0]                                              
    A_heat = np.vstack([x[heat_idx], np.ones(len(heat_idx))]).T                 
    slope_heat, intercept_heat = np.linalg.lstsq(A_heat, dx[heat_idx],          
rcond=None)[0]                                                                  
                                                                                
    return (slope_cool, intercept_cool), (slope_heat, intercept_heat)           
                                                                                
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
res1 = analyze_room(state[0], "Room 1")                                         
res2 = analyze_room(state[1], "Room 2")                                         
res3 = analyze_room(state[2], "Room 3")                                         
                                                                                
print("Room 1:", res1)                                                          
