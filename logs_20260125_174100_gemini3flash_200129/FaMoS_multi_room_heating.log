# We can use a simple trick: for a fixed K, dx + K*x should be either B or B+H. 
# Let's try to find K that minimizes the variance of the two clusters.          
Ks = np.linspace(0, 0.01, 101) # dt*k                                           
variances = []                                                                  
for K in Ks:                                                                    
    val = r1_dx + K * r1_x                                                      
    # Use the variance of the two clusters?                                     
    # Or just the fact that most points are in one cluster.                     
    # Let's just fit a line to the majority.                                    
    hist, bins = np.histogram(val, bins=100)                                    
    variances.append(np.max(hist)) # Find K that gives the sharpest peak        
                                                                                
best_K = Ks[np.argmax(variances)]                                               
val = r1_dx + best_K * r1_x                                                     
hist, bins = np.histogram(val, bins=100)                                        
best_B = bins[np.argmax(hist)]                                                  
                                                                                
