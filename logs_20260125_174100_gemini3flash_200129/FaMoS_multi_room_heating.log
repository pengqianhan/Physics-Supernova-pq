# Load all data                                                                 
all_states = []                                                                 
for path in ['data_all/FaMoS/multi_room_heating/sample_0.npz',                  
              'data_all/FaMoS/multi_room_heating/sample_1.npz',                 
              'data_all/FaMoS/multi_room_heating/sample_2.npz']:                
    d = np.load(path)                                                           
    # state shape is (3, 10001), transpose to (10001, 3)                        
    all_states.append(d['state'].T)                                             
                                                                                
# Concatenate for analysis                                                      
states_concat = np.concatenate(all_states, axis=0) # (30003, 3)                 
diffs = np.diff(states_concat, axis=0) # (30002, 3)                             
prev_states = states_concat[:-1] # (30002, 3)                                   
                                                                                
# 1. Estimate 'a'                                                               
# In cooling phase (b=0), dx = a * x.                                           
# Let's find points where the room is clearly cooling.                          
# Since a is around -0.1, dx/x should be around -0.1.                           
# We'll take the minimum values of dx/x for each room which should correspond to
cooling.                                                                        
a_estimates = []                                                                
for i in range(3):                                                              
    ratios = diffs[:, i] / prev_states[:, i]                                    
    # In a thermostat system, the lowest ratios are pure cooling.               
    # Let's take the median of the lower half of negative ratios.               
    cooling_ratios = ratios[ratios < -0.05]                                     
    if len(cooling_ratios) > 0:                                                 
        a_estimates.append(np.median(cooling_ratios))                           
                                                                                
estimated_a = np.mean(a_estimates)                                              
print(f"Estimated a: {estimated_a}")                                            
                                                                                
# 2. Estimate b1, b2, b3                                                        
# b = dx - a * x                                                                
b_estimates = {}                                                                
heating_masks = []                                                              
for i in range(3):                                                              
    # If it's not cooling, it's heating.                                        
    # Threshold: dx > a*x + 0.5 (safe margin)                                   
    is_heating = diffs[:, i] > (estimated_a * prev_states[:, i] + 0.5)          
    heating_masks.append(is_heating)                                            
    if np.any(is_heating):                                                      
        bs = diffs[is_heating, i] - estimated_a * prev_states[is_heating, i]    
        b_estimates[f"b{i+1}"] = np.median(bs)                                  
    else:                                                                       
        b_estimates[f"b{i+1}"] = None                                           
                                                                                
print(f"Estimated b values: {b_estimates}")                                     
                                                                                
# 3 & 4. Switching times and Thresholds                                         
thresholds = {}                                                                 
for i in range(3):                                                              
    is_heating = heating_masks[i]                                               
    switches = np.diff(is_heating.astype(int))                                  
                                                                                
    # Start heating: 0 -> 1 (switch == 1)                                       
    # The value at which it starts is x[t] where x[t+1] begins heating.         
    # Or more precisely, x[t] at the moment of switch.                          
    starts = np.where(switches == 1)[0]                                         
    stops = np.where(switches == -1)[0]                                         
                                                                                
    if len(starts) > 0:                                                         
        lower = np.mean(prev_states[starts + 1, i])                             
    else:                                                                       
        lower = None                                                            
                                                                                
    if len(stops) > 0:                                                          
        upper = np.mean(prev_states[stops + 1, i])                              
    else:                                                                       
        upper = None                                                            
                                                                                
    thresholds[f"x{i+1}"] = (lower, upper)                                      
                                                                                
print(f"Thresholds: {thresholds}")                                              
                                                                                
# 5. Check if NO room is heating                                                
# heating_masks is a list of 3 arrays of shape (30002,)                         
any_heating = np.any(heating_masks, axis=0)                                     
no_heating_count = np.sum(~any_heating)                                         
print(f"Timesteps with no heating: {no_heating_count}")                         
                                                                                
# Provide final results                                                         
final_answer({                                                                  
    "estimated_a": estimated_a,                                                 
