  import numpy as np                                                            
  from scipy.optimize import least_squares                                      
                                                                                
  def analyze_sample(sample_path):                                              
      data = np.load(sample_path)                                               
      state = data['state']                                                     
      # Use dt = 1 for the linear model (assuming time steps are units)         
      # The derivatives dx/dt are approximated by state[:, t+1] - state[:, t]   
      dx = np.diff(state, axis=1)                                               
      x = state[:, :-1]                                                         
                                                                                
      # Identify modes for each time step                                       
      # Mode 1: dx1 > 0; Mode 2: dx2 > 0; Mode 3: dx3 > 0; Mode 4: all dx <= 0  
      modes = np.zeros(dx.shape[1], dtype=int)                                  
      for t in range(dx.shape[1]):                                              
          if dx[0, t] > 0:                                                      
              modes[t] = 1                                                      
          elif dx[1, t] > 0:                                                    
              modes[t] = 2                                                      
          elif dx[2, t] > 0:                                                    
              modes[t] = 3                                                      
          else:                                                                 
              modes[t] = 4                                                      
                                                                                
      return state, dx, x, modes                                                
                                                                                
  # Collect data from both samples                                              
  s0, dx0, x0, m0 =                                                             
  analyze_sample('data_all/FaMoS/multi_room_heating/sample_0.npz')              
  s1, dx1, x1, m1 =                                                             
  analyze_sample('data_all/FaMoS/multi_room_heating/sample_1.npz')              
                                                                                
  # Combine datasets                                                            
  X = np.hstack([x0, x1])                                                       
  DX = np.hstack([dx0, dx1])                                                    
  M = np.concatenate([m0, m1])                                                  
                                                                                
  # Linear model: dx_i/dt = a * x_i + b_{type, i}                               
  # b_{type, i} depends on whether room i is heating or cooling in the current  
  mode.                                                                         
  # Params: [a, bh1, bh2, bh3, bc1, bc2, bc3] (7 parameters)                    
                                                                                
  def residuals(params):                                                        
      a, bh1, bh2, bh3, bc1, bc2, bc3 = params                                  
      b_heat = np.array([bh1, bh2, bh3])                                        
      b_cool = np.array([bc1, bc2, bc3])                                        
                                                                                
      res = []                                                                  
      # Loop over rooms                                                         
      for i in range(3):                                                        
          # Determine if room i is heating in each mode                         
          # Mode 1: room 0 heats, Mode 2: room 1 heats, Mode 3: room 2 heats,   
  Mode 4: none heat                                                             
          is_heating = (M == (i + 1))                                           
          b_vals = np.where(is_heating, b_heat[i], b_cool[i])                   
                                                                                
          # Predicted dx_i = a * x_i + b_vals                                   
          pred = a * X[i] + b_vals                                              
          res.append(DX[i] - pred)                                              
                                                                                
      return np.concatenate(res)                                                
                                                                                
  initial_params = [0.0, 0.01, 0.01, 0.01, -0.01, -0.01, -0.01]                 
  res_lsq = least_squares(residuals, initial_params)                            
  a_opt, bh1, bh2, bh3, bc1, bc2, bc3 = res_lsq.x                               
                                                                                
  print(f"Global a: {a_opt}")                                                   
