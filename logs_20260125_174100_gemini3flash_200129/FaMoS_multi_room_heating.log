    labels = kmeans.labels_                                                     
                                                                                
    # For each cluster, fit a line                                              
    line1 = estimate_line(x[labels == 0], dx[labels == 0])                      
    line2 = estimate_line(x[labels == 1], dx[labels == 1])                      
    return line1, line2, labels                                                 
                                                                                
