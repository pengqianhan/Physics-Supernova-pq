there's a base ambient b)                                                       
# Usually, dx/dt = -a*(x - x_ambient).                                          
# Let's assume dx = (-a_dt * x + b_dt).                                         
# For x1, we should see two lines in the dx vs x plot: one for heating and one  
for not heating.                                                                
                                                                                
def estimate_line(x_vals, dx_vals):                                             
    # dx = c0 * x + c1                                                          
    # We use a simple linear regression                                         
    # Filter out outliers if necessary                                          
    A = np.vstack([x_vals, np.ones(len(x_vals))]).T                             
    c, residuals, rank, s = np.linalg.lstsq(A, dx_vals, rcond=None)             
    return c # c[0] is slope (-a*dt), c[1] is intercept (b*dt)                  
                                                                                
