import numpy as np                                                              
                                                                                
def analyze_heating(state, dt=0.1):                                             
    # state is (3, 10001)                                                       
    n_vars = state.shape[0]                                                     
    n_steps = state.shape[1]                                                    
                                                                                
    # Calculate slopes                                                          
    dx = np.diff(state, axis=1)                                                 
    slopes = dx / dt                                                            
                                                                                
    # Heating mask: slope > 0                                                   
    # Use a small epsilon to avoid numerical noise issues                       
    is_heating = slopes > 0                                                     
                                                                                
    # Find transition indices                                                   
    transitions = []                                                            
    for j in range(n_steps - 2):                                                
        if not np.array_equal(is_heating[:, j], is_heating[:, j+1]):            
            # Transition occurs between step j+1 and j+2                        
            # We'll use the timestamp of j+1 as the transition point            
            transitions.append(j + 1)                                           
                                                                                
    # Initial state and mode                                                    
    # For initial mode, we look at the first interval (slope between step 0 and 
1)                                                                              
    init_state = state[:, 0]                                                    
    init_mode = []                                                              
    for i in range(n_vars):                                                     
        if is_heating[i, 0]:                                                    
            init_mode.append(f"x{i+1}")                                         
                                                                                
    # Cooling rate k and heating constants Qi                                   
    # x_i' = -k * x_i + Q_i * u_i                                               
