void Board::displayBoard() const {                                              
    cout << "  0 1 2" << endl;                                                  
    for (int i = 0; i < 3; ++i) {                                               
        cout << i << " ";                                                       
        for (int j = 0; j < 3; ++j) {                                           
            cout << grid[i][j] << (j < 2 ? "|" : "");                           
        }                                                                       
        cout << endl;                                                           
        if (i < 2) cout << "  -----" << endl;                                   
    }                                                                           
}                                                                               
                                                                                
bool Board::isBoardFull() const {                                               
    for (int i = 0; i < 3; ++i) {                                               
        for (int j = 0; j < 3; ++j) {                                           
            if (grid[i][j] == ' ') return false;                                
        }                                                                       
    }                                                                           
    return true;                                                                
}                                                                               
                                                                                
bool Board::checkWinner() const {                                               
    char playerChar = (currentPlayer == 1) ? 'X' : 'O';                         
                                                                                
    // Rows & Columns                                                           
    for (int i = 0; i < 3; ++i) {                                               
        if ((grid[i][0] == playerChar && grid[i][1] == playerChar && grid[i][2] 
== playerChar) ||                                                               
            (grid[0][i] == playerChar && grid[1][i] == playerChar && grid[2][i] 
== playerChar)) {                                                               
            return true;                                                        
        }                                                                       
    }                                                                           
                                                                                
    // Diagonals                                                                
    if ((grid[0][0] == playerChar && grid[1][1] == playerChar && grid[2][2] ==  
playerChar) ||                                                                  
        (grid[0][2] == playerChar && grid[1][1] == playerChar && grid[2][0] ==  
playerChar)) {                                                                  
        return true;                                                            
    }                                                                           
                                                                                
    return false;                                                               
}                                                                               
                                                                                
bool Board::makeMove(int row, int col) {                                        
    if (row < 0 || row >= 3 || col < 0 || col >= 3 || grid[row][col] != ' ') {  
        return false;                                                           
    }                                                                           
    grid[row][col] = (currentPlayer == 1) ? 'X' : 'O';                          
    return true;                                                                
}                                                                               
                                                                                
void Board::switchPlayer() {                                                    
    currentPlayer = (currentPlayer == 1) ? 2 : 1;                               
}                                                                               
                                                                                
int Board::getCurrentPlayer() const {                                           
    return currentPlayer;                                                       
}                                                                               
                                                                                
char Board::getAt(int row, int col) const {                                     
    return grid[row][col];                                                      
