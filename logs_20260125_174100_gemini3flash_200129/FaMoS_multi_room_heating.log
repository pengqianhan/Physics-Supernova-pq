import numpy as np                                                              
                                                                                
data = np.load('data_all/FaMoS/multi_room_heating/sample_0.npz')                
state = data['state']                                                           
dt = 0.001                                                                      
num_steps = state.shape[1]                                                      
t = np.arange(num_steps) * dt                                                   
                                                                                
# Initial state                                                                 
initial_state = state[:, 0]                                                     
print(f"Initial State: x1={initial_state[0]}, x2={initial_state[1]},            
x3={initial_state[2]}")                                                         
                                                                                
# Calculate derivatives                                                         
dx = np.diff(state, axis=1) / dt                                                
# Estimate B for each variable                                                  
B_est = dx + 0.1 * state[:, :-1]                                                
                                                                                
# Find where sign of derivative changes                                         
# Derivative has shape (3, 10000)                                               
sign_dx = np.sign(dx)                                                           
sign_changes = []                                                               
for i in range(1, dx.shape[1]):                                                 
    for var_idx in range(3):                                                    
        if sign_dx[var_idx, i] != sign_dx[var_idx, i-1] and sign_dx[var_idx, i] 
!= 0 and sign_dx[var_idx, i-1] != 0:                                            
            sign_changes.append((i, var_idx))                                   
                                                                                
# Sort by time index                                                            
sign_changes.sort()                                                             
                                                                                
# Also look for jumps in B to define segments more accurately                   
# (though the prompt asks for sign changes specifically)                        
                                                                                
# Extract first 5 sign changes                                                  
first_5_changes = []                                                            
seen_indices = set()                                                            
for idx, var in sign_changes:                                                   
    if idx not in seen_indices:                                                 
        first_5_changes.append((idx, var))                                      
        seen_indices.add(idx)                                                   
    if len(first_5_changes) == 5:                                               
        break                                                                   
                                                                                
for idx, var in first_5_changes:                                                
    print(f"Change point at index {idx}, time {t[idx]:.3f}, variable x{var+1},  
values: {state[:, idx]}, sign change in dx{var+1}")                             
                                                                                
# Estimate parameters for segments                                              
segments = [0] + [c[0] for c in first_5_changes] + [num_steps-1]                
for i in range(len(segments)-1):                                                
    start = segments[i]                                                         
    end = segments[i+1]                                                         
    # Estimate B in this segment                                                
    # B = dx + 0.1 * x                                                          
    B_val = np.mean(B_est[:, start:end], axis=1)                                
    print(f"Segment {i} ({t[start]:.3f} to {t[end]:.3f}): B = {B_val}")         
                                                                                
