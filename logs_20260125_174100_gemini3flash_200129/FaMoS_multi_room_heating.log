import numpy as np                                                              
                                                                                
def analyze_all_data(file_paths):                                               
    all_transitions = []                                                        
    all_k_data_x = []                                                           
    all_k_data_dx = []                                                          
                                                                                
    # To store (x_i, dx_i) for heating rooms                                    
    heating_data = {1: [[], []], 2: [[], []], 3: [[], []]}                      
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        state = data['state']                                                   
        x1, x2, x3 = state[0], state[1], state[2]                               
        dx1 = np.diff(x1)                                                       
        dx2 = np.diff(x2)                                                       
        dx3 = np.diff(x3)                                                       
                                                                                
        # Identify modes                                                        
        modes = []                                                              
        for i in range(len(dx1)):                                               
            if dx1[i] > 0: modes.append(1)                                      
            elif dx2[i] > 0: modes.append(2)                                    
            elif dx3[i] > 0: modes.append(3)                                    
            else: modes.append(0)                                               
        modes = np.array(modes)                                                 
                                                                                
        # Collect data for k and C                                              
        for i in range(len(dx1)):                                               
            m = modes[i]                                                        
            # Room 1                                                            
            if m == 1:                                                          
                heating_data[1][0].append(x1[i])                                
                heating_data[1][1].append(dx1[i])                               
            else:                                                               
                all_k_data_x.append(x1[i])                                      
                all_k_data_dx.append(dx1[i])                                    
                                                                                
            # Room 2                                                            
            if m == 2:                                                          
                heating_data[2][0].append(x2[i])                                
                heating_data[2][1].append(dx2[i])                               
            else:                                                               
                all_k_data_x.append(x2[i])                                      
                all_k_data_dx.append(dx2[i])                                    
                                                                                
            # Room 3                                                            
            if m == 3:                                                          
                heating_data[3][0].append(x3[i])                                
                heating_data[3][1].append(dx3[i])                               
            else:                                                               
                all_k_data_x.append(x3[i])                                      
                all_k_data_dx.append(dx3[i])                                    
                                                                                
        # Transitions                                                           
        for i in range(1, len(modes)):                                          
            if modes[i] != modes[i-1]:                                          
                all_transitions.append({                                        
                    'prev': modes[i-1],                                         
                    'curr': modes[i],                                           
                    'x': [x1[i], x2[i], x3[i]]                                  
                })                                                              
                                                                                
    # Regression for k: dx = -k*x                                               
    all_k_data_x = np.array(all_k_data_x)                                       
    all_k_data_dx = np.array(all_k_data_dx)                                     
    # p[0] is -k, p[1] is intercept (should be 0)                               
    p_k = np.polyfit(all_k_data_x, all_k_data_dx, 1)                            
    k_val = -p_k[0]                                                             
                                                                                
    # Regression for Ci: dx = -k*x + Ci => dx + k*x = Ci                        
    c_vals = {}                                                                 
    for i in [1, 2, 3]:                                                         
        hx = np.array(heating_data[i][0])                                       
        hdx = np.array(heating_data[i][1])                                      
        # Ci = dx + k*x                                                         
        c_vals[i] = np.mean(hdx + k_val * hx)                                   
                                                                                
    return k_val, c_vals, all_transitions                                       
                                                                                
