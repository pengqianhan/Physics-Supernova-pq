<code>                                                                          
import numpy as np                                                              
                                                                                
# Load data again for clarity                                                   
data = np.load('data_all/FaMoS/multi_room_heating/sample_0.npz')                
state = data['state']                                                           
x1, x2, x3 = state[0], state[1], state[2]                                       
dx1, dx2, dx3 = np.diff(x1), np.diff(x2), np.diff(x3)                           
                                                                                
# Define modes                                                                  
# Mode 0: None heating                                                          
# Mode 1: x1 heating                                                            
# Mode 2: x2 heating                                                            
# Mode 3: x3 heating                                                            
num_steps = len(dx1)                                                            
modes = []                                                                      
for k in range(num_steps):                                                      
    h1 = dx1[k] > 1e-9                                                          
    h2 = dx2[k] > 1e-9                                                          
    h3 = dx3[k] > 1e-9                                                          
    if h1: modes.append(1)                                                      
    elif h2: modes.append(2)                                                    
    elif h3: modes.append(3)                                                    
    else: modes.append(0)                                                       
                                                                                
# Analyze transitions                                                           
transitions = []                                                                
for k in range(1, len(modes)):                                                  
    if modes[k] != modes[k-1]:                                                  
        # Switch occurred at index k                                            
        # modes[k-1] was the mode for interval [k-1, k]                         
        # modes[k] is the mode for interval [k, k+1]                            
        transitions.append({                                                    
            'step': k,                                                          
            'from': modes[k-1],                                                 
            'to': modes[k],                                                     
            'x1': x1[k],                                                        
            'x2': x2[k],                                                        
            'x3': x3[k]                                                         
        })                                                                      
                                                                                
# Print details of the first 15 transitions                                     
for t in transitions[:15]:                                                      
    print(f"Step {t['step']}: {t['from']} -> {t['to']} | x1={t['x1']:.2f},      
x2={t['x2']:.2f}, x3={t['x3']:.2f}")                                            
                                                                                
# Check lower thresholds more carefully                                         
# When a room starts heating (mode becomes i), what was its value?              
for i in [1, 2, 3]:                                                             
    start_vals = [t[f'x{i}'] for t in transitions if t['to'] == i]              
    end_vals = [t[f'x{i}'] for t in transitions if t['from'] == i]              
    print(f"Room {i}: Starts heating at mean {np.mean(start_vals):.2f}, range   
[{np.min(start_vals):.2f}, {np.max(start_vals):.2f}]")                          
    print(f"Room {i}: Stops heating at mean {np.mean(end_vals):.2f}, range      
[{np.min(end_vals):.2f}, {np.max(end_vals):.2f}]")                              
                                                                                
# Determine sequence                                                            
# Look at 'to' mode sequences                                                   
mode_seq = [t['to'] for t in transitions]                                       
print("Mode sequence:", mode_seq[:20])                                          
                                                                                
