import numpy as np                                                              
                                                                                
def simple_linreg(x, y):                                                        
    n = len(x)                                                                  
    sum_x = np.sum(x)                                                           
    sum_y = np.sum(y)                                                           
    sum_xx = np.sum(x*x)                                                        
    sum_xy = np.sum(x*y)                                                        
                                                                                
    a = (n * sum_xy - sum_x * sum_y) / (n * sum_xx - sum_x**2)                  
    b = (sum_y - a * sum_x) / n                                                 
    return a, b                                                                 
                                                                                
