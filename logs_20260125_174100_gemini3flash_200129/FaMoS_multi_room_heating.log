import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the first sample                                                         
data = np.load(DATA_FILE_PATHS[0])                                              
t = data['t']                                                                   
x = data['x'] # Shape (N, 3)                                                    
u = data['u'] # Shape (N, 1) or similar if available                            
                                                                                
# Since the task describes x1, x2, x3 as rooms, x should have 3 columns.        
# dx/dt estimation                                                              
dt = np.diff(t)                                                                 
dx = np.diff(x, axis=0)                                                         
slopes = dx / dt[:, np.newaxis]                                                 
                                                                                
# Analysis for each variable xi                                                 
results = {}                                                                    
for i in range(3):                                                              
    xi = x[:, i]                                                                
    si = slopes[:, i]                                                           
                                                                                
    # Identify heating (slope > 0) and cooling (slope < 0)                      
    # Actually, the model says dx/dt = -k*x + B.                                
    # When B=0, it's cooling. When B > k*x, it's heating.                       
                                                                                
    heating_mask = si > 0                                                       
    cooling_mask = si < 0                                                       
                                                                                
    avg_slope_h = np.mean(si[heating_mask]) if any(heating_mask) else 0         
    avg_slope_c = np.mean(si[cooling_mask]) if any(cooling_mask) else 0         
                                                                                
    # Start and end of heating                                                  
    # Find contiguous segments of heating                                       
    is_heating = (si > 0).astype(int)                                           
    diff_h = np.diff(is_heating)                                                
    starts = np.where(diff_h == 1)[0] + 1                                       
    ends = np.where(diff_h == -1)[0]                                            
                                                                                
    # If it starts heating at index 0                                           
    if is_heating[0] == 1:                                                      
        starts = np.insert(starts, 0, 0)                                        
    # If it's still heating at the end                                          
    if is_heating[-1] == 1:                                                     
        ends = np.append(ends, len(is_heating) - 1)                             
                                                                                
    heating_vals = []                                                           
    for s, e in zip(starts, ends):                                              
        heating_vals.append((xi[s], xi[e+1]))                                   
                                                                                
    # Parameter estimation: dx/dt = -k*x + B                                    
    # During cooling (B=0): dx/dt = -k*x => k = - (dx/dt) / x                   
    k_est = -np.mean(si[cooling_mask] / xi[:-1][cooling_mask])                  
                                                                                
    # During heating (B > 0): B = dx/dt + k*x                                   
    B_est = np.mean(si[heating_mask] + k_est * xi[:-1][heating_mask])           
                                                                                
    results[f'x{i+1}'] = {                                                      
        'avg_slope_heating': avg_slope_h,                                       
        'avg_slope_cooling': avg_slope_c,                                       
        'heating_start_end': heating_vals,                                      
        'k': k_est,                                                             
        'B': B_est,                                                             
        'threshold_low': np.min([v[0] for v in heating_vals]) if heating_vals   
else None,                                                                      
        'threshold_high': np.max([v[1] for v in heating_vals]) if heating_vals  
else None                                                                       
    }                                                                           
                                                                                
print(results)                                                                  
                                                                                
