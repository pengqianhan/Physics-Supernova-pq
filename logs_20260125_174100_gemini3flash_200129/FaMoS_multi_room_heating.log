x_dot = dx / dt[:, np.newaxis]                                                  
x_mid = (x[:-1] + x[1:]) / 2                                                    
                                                                                
# Identify jumps in derivatives (mode changes)                                  
# We calculate the change in x_dot between steps                                
diff_x_dot = np.abs(np.diff(x_dot, axis=0))                                     
# Threshold for a jump                                                          
jump_threshold = 0.5                                                            
change_indices = np.where(np.any(diff_x_dot > jump_threshold, axis=1))[0] + 1   
                                                                                
# Segment the data                                                              
segments = []                                                                   
start = 0                                                                       
for idx in change_indices:                                                      
    segments.append((start, idx))                                               
    start = idx                                                                 
segments.append((start, len(x_dot)))                                            
                                                                                
# Fit parameters for each segment                                               
mode_data = []                                                                  
for start, end in segments:                                                     
    if end - start < 3: continue                                                
                                                                                
    seg_x = x_mid[start:end]                                                    
    seg_x_dot = x_dot[start:end]                                                
                                                                                
    coeffs = []                                                                 
    for i in range(3):                                                          
        # Fit x_dot_i = a_i * x_i + b_i using linregress                        
        slope, intercept, r_value, p_value, std_err =                           
scipy.stats.linregress(seg_x[:, i], seg_x_dot[:, i])                            
        coeffs.append((slope, intercept))                                       
                                                                                
    # Identify mode by which b is high                                          
    b_vals = [c[1] for c in coeffs]                                             
    mode_id = 0 # Default: All off                                              
    if b_vals[0] > 3.0: mode_id = 1                                             
    elif b_vals[1] > 3.0: mode_id = 2                                           
    elif b_vals[2] > 3.0: mode_id = 3                                           
                                                                                
    # Check guard at the end of the segment                                     
    guard_x = x[end]                                                            
    mode_data.append({                                                          
        'mode': mode_id,                                                        
        'a': [c[0] for c in coeffs],                                            
        'b': [c[1] for c in coeffs],                                            
        'guard_x': guard_x                                                      
    })                                                                          
                                                                                
# Group parameters by mode                                                      
modes = {0: [], 1: [], 2: [], 3: []}                                            
for entry in mode_data:                                                         
    modes[entry['mode']].append(entry)                                          
                                                                                
# Calculate average parameters and guard thresholds                             
final_params = {}                                                               
for m, entries in modes.items():                                                
    if not entries: continue                                                    
    avg_a = np.mean([e['a'] for e in entries], axis=0)                          
    avg_b = np.mean([e['b'] for e in entries], axis=0)                          
    guards = [e['guard_x'] for e in entries]                                    
    final_params[m] = {'a': avg_a, 'b': avg_b, 'guards': guards}                
                                                                                
# Print summary                                                                 
for m, p in final_params.items():                                               
