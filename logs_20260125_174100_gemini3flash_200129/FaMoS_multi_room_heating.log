    mi = (dx1 > 0) if i==0 else (dx2 > 0) if i==1 else (dx3 > 0)                
    # Start: mi transitions from False to True                                  
    starts = np.where(np.diff(mi.astype(int)) == 1)[0]                          
    # Stop: mi transitions from True to False                                   
    stops = np.where(np.diff(mi.astype(int)) == -1)[0]                          
                                                                                
    if len(starts) > 0:                                                         
        start_vals = xi[starts+1] # value when it just started                  
        print(f"Room {i+1} starts heating at approx: {np.mean(start_vals)}")    
    if len(stops) > 0:                                                          
        stop_vals = xi[stops] # last value before stopping                      
        print(f"Room {i+1} stops heating at approx: {np.mean(stop_vals)}")      
                                                                                
