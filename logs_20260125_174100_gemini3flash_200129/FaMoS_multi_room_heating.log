    state = data['state']                                                       
                                                                                
    # Check shape and transpose if necessary                                    
    if state.shape[0] < state.shape[1]:                                         
        x = state.T                                                             
    else:                                                                       
        x = state                                                               
                                                                                
    print(f"\n--- File {i}: {file_path} ---")                                   
    print(f"State shape: {x.shape}")                                            
    print(f"Initial state (t=0): {x[0]}")                                       
                                                                                
    # Calculate differences                                                     
    dx = np.diff(x, axis=0)                                                     
                                                                                
    # Determine modes using signs of derivatives                                
    # Rounded to avoid noise                                                    
    signs = np.sign(np.round(dx, decimals=6))                                   
                                                                                
    # Group into modes                                                          
    mode_segments = []                                                          
    if len(signs) > 0:                                                          
        curr_mode = signs[0]                                                    
        start_t = 0                                                             
        for t in range(1, len(signs)):                                          
            if not np.array_equal(signs[t], curr_mode):                         
                mode_segments.append((start_t, t, curr_mode))                   
                start_t = t                                                     
                curr_mode = signs[t]                                            
        mode_segments.append((start_t, len(signs), curr_mode))                  
                                                                                
    # Test decay coefficients                                                   
    decays = [-0.05, -0.1, -0.15]                                               
    best_decay = -0.1                                                           
    min_variance = float('inf')                                                 
                                                                                
    for d in decays:                                                            
        alpha = 1 + d                                                           
        c_series = x[1:] - alpha * x[:-1]                                       
        # Sum of variances across all modes and dimensions                      
        total_var = 0                                                           
        for start, end, _ in mode_segments:                                     
            if end - start > 5: # Only modes with enough data                   
                total_var += np.sum(np.var(c_series[start:end], axis=0))        
        if total_var < min_variance:                                            
            min_variance = total_var                                            
            best_decay = d                                                      
                                                                                
    print(f"Best decay coefficient: {best_decay}")                              
    alpha = 1 + best_decay                                                      
    c_series = x[1:] - alpha * x[:-1]                                           
                                                                                
    # Detailed Mode Analysis                                                    
    print("Mode sequence:")                                                     
    for j, (start, end, s) in enumerate(mode_segments):                         
        c_avg = np.mean(c_series[start:end], axis=0)                            
        print(f"  Mode {j} (t={start} to {end}): Signs={s}, C={c_avg}")         
        if end < len(x) - 1:                                                    
            print(f"    Guard condition at t={end}: x={x[end]}")                
                                                                                
