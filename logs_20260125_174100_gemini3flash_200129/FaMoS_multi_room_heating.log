      all_x_list.append(x)                                                      
      all_dx_list.append(dx)                                                    
                                                                                
  all_x = np.concatenate(all_x_list, axis=1)                                    
  all_dx = np.concatenate(all_dx_list, axis=1)                                  
                                                                                
  # Fit dx = -K*x + B for cooling points                                        
  # Let's find K, B by looking at the "bottom" line in a dx vs x plot.          
  # Or just use the fact that most points are cooling.                          
  # We'll use RANSAC-like approach or just look at the distribution of (dx +    
  K*x).                                                                         
  # Try a range of K.                                                           
  best_K = 0                                                                    
  best_B = 0                                                                    
  min_error = float('inf')                                                      
                                                                                
