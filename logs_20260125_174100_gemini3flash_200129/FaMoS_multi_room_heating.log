import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load all data                                                                 
state_data = []                                                                 
for i in range(3):                                                              
    d = np.load(f'data_all/FaMoS/multi_room_heating/sample_{i}.npz')            
    state_data.append(d['state'])                                               
                                                                                
# Combine all trajectories (we can process them separately to find transitions) 
# or just concatenate them for regression after computing differences per       
sample.                                                                         
                                                                                
all_states = []                                                                 
all_diffs = []                                                                  
                                                                                
for s in state_data:                                                            
    # s is (3, 10001)                                                           
    diff = s[:, 1:] - s[:, :-1]                                                 
    all_states.append(s[:, :-1])                                                
    all_diffs.append(diff)                                                      
                                                                                
# Flatten for global regression if needed, but we should also look at modes     
states_concat = np.concatenate(all_states, axis=1).T # (N, 3)                   
diffs_concat = np.concatenate(all_diffs, axis=1).T   # (N, 3)                   
                                                                                
# Assign modes                                                                  
# Mode 1: dx1 > 0, dx2 < 0, dx3 < 0                                             
# Mode 2: dx1 < 0, dx2 > 0, dx3 < 0                                             
# Mode 3: dx1 < 0, dx2 < 0, dx3 > 0                                             
# Mode 4: dx1 < 0, dx2 < 0, dx3 < 0                                             
                                                                                
def get_mode(dx):                                                               
    if dx[0] > 0 and dx[1] <= 0 and dx[2] <= 0: return 1                        
    if dx[0] <= 0 and dx[1] > 0 and dx[2] <= 0: return 2                        
    if dx[0] <= 0 and dx[1] <= 0 and dx[2] > 0: return 3                        
    if dx[0] <= 0 and dx[1] <= 0 and dx[2] <= 0: return 4                       
    return 0 # Unknown                                                          
                                                                                
modes = np.array([get_mode(d) for d in diffs_concat])                           
                                                                                
# Analyze segments for thresholds and transitions                               
# Thresholds: value at the last point of a mode or first point of next.         
# Let's say transition from mode A to mode B happens between step k and k+1.    
# The value at step k is the threshold.                                         
                                                                                
# Regression                                                                    
# Case 1: Increasing (Heating)                                                  
# x1 is increasing in Mode 1.                                                   
# x2 is increasing in Mode 2.                                                   
# x3 is increasing in Mode 3.                                                   
# Case 2: Decreasing (Cooling)                                                  
# x1 is decreasing in Modes 2, 3, 4.                                            
# x2 is decreasing in Modes 1, 3, 4.                                            
# x3 is decreasing in Modes 1, 2, 4.                                            
                                                                                
# We need to perform regression: dx = a*x + b                                   
def fit_linear(x_vals, dx_vals):                                                
    if len(x_vals) < 2: return None, None                                       
    model = LinearRegression()                                                  
    model.fit(x_vals.reshape(-1, 1), dx_vals)                                   
    return model.coef_[0], model.intercept_                                     
                                                                                
# For x1:                                                                       
# heating: Mode 1                                                               
# cooling: Modes 2, 3, 4                                                        
results = {}                                                                    
for i in range(3): # For x1, x2, x3                                             
    # Heating                                                                   
    idx_heat = (modes == (i + 1))                                               
    a_heat, b_heat = fit_linear(states_concat[idx_heat, i],                     
diffs_concat[idx_heat, i])                                                      
    # Cooling                                                                   
    idx_cool = (modes != (i + 1)) & (modes != 0)                                
    a_cool, b_cool = fit_linear(states_concat[idx_cool, i],                     
diffs_concat[idx_cool, i])                                                      
    results[f'x{i+1}'] = {'heat': (a_heat, b_heat), 'cool': (a_cool, b_cool)}   
                                                                                
print("Regression Results:", results)                                           
                                                                                
# Switching thresholds                                                          
# Transitions...                                                                
transitions = []                                                                
thresholds_upper = [] # [x1, x2, x3] when heating stops                         
thresholds_lower = [] # [x1, x2, x3] when heating starts                        
                                                                                
for s_idx in range(len(state_data)):                                            
