      dx1, dx2, dx3 = np.diff(x1), np.diff(x2), np.diff(x3)                     
                                                                                
      modes = []                                                                
      for i in range(len(dx1)):                                                 
          d1, d2, d3 = dx1[i], dx2[i], dx3[i]                                   
          if d1 > 0 and d2 <= 0 and d3 <= 0: m = 1                              
          elif d1 <= 0 and d2 > 0 and d3 <= 0: m = 2                            
          elif d1 <= 0 and d2 <= 0 and d3 > 0: m = 3                            
          elif d1 <= 0 and d2 <= 0 and d3 <= 0: m = 4                           
          else: m = 0 # Transition/noise                                        
          modes.append(m)                                                       
      modes = np.array(modes)                                                   
                                                                                
      # Dynamics data                                                           
      x_m = [x1[:-1], x2[:-1], x3[:-1]]                                         
      dx_m = [dx1, dx2, dx3]                                                    
      for j in range(3):                                                        
          var_idx = j + 1                                                       
          # Heating is specifically mode 'var_idx'                              
          heat_mask = (modes == var_idx)                                        
          # Cooling is any mode where it's not heating                          
          cool_mask = (modes != var_idx) & (modes != 0)                         
                                                                                
          if var_idx == 1:                                                      
              all_x1[1].extend(x_m[j][heat_mask])                               
              all_dx1[1].extend(dx_m[j][heat_mask])                             
              all_x1['cool'].extend(x_m[j][cool_mask])                          
              all_dx1['cool'].extend(dx_m[j][cool_mask])                        
          elif var_idx == 2:                                                    
              all_x2[2].extend(x_m[j][heat_mask])                               
              all_dx2[2].extend(dx_m[j][heat_mask])                             
              all_x2['cool'].extend(x_m[j][cool_mask])                          
              all_dx2['cool'].extend(dx_m[j][cool_mask])                        
          elif var_idx == 3:                                                    
              all_x3[3].extend(x_m[j][heat_mask])                               
              all_dx3[3].extend(dx_m[j][heat_mask])                             
              all_x3['cool'].extend(x_m[j][cool_mask])                          
              all_dx3['cool'].extend(dx_m[j][cool_mask])                        
                                                                                
      # Thresholds                                                              
      # Heating starts for xi when mode changes to i                            
      # Heating stops for xi when mode changes from i                           
      for i in range(len(modes) - 1):                                           
          m_curr = modes[i]                                                     
          m_next = modes[i+1]                                                   
          if m_curr != m_next and m_curr != 0 and m_next != 0:                  
              # Entry to mode m_next (heating starts for x_{m_next})            
              if m_next in [1, 2, 3]:                                           
                  lower_thresh[m_next].append(x_m[m_next-1][i+1])               
              # Exit from mode m_curr (heating stops for x_{m_curr})            
              if m_curr in [1, 2, 3]:                                           
                  upper_thresh[m_curr].append(x_m[m_curr-1][i+1])               
                                                                                
      # Compact sequence                                                        
      change_idx = np.where(modes[:-1] != modes[1:])[0]                         
      compact = [modes[0]] + [modes[idx+1] for idx in change_idx if             
  modes[idx+1] != 0]                                                            
      overall_sequences.append(compact)                                         
                                                                                
  def get_lin(x, dx):                                                           
      a, b = np.polyfit(x, dx, 1)                                               
      return a, b                                                               
                                                                                
  res = {}                                                                      
  res['x1_h'] = get_lin(all_x1[1], all_dx1[1])                                  
  res['x1_c'] = get_lin(all_x1['cool'], all_dx1['cool'])                        
  res['x2_h'] = get_lin(all_x2[2], all_dx2[2])                                  
  res['x2_c'] = get_lin(all_x2['cool'], all_dx2['cool'])                        
  res['x3_h'] = get_lin(all_x3[3], all_dx3[3])                                  
  res['x3_c'] = get_lin(all_x3['cool'], all_dx3['cool'])                        
                                                                                
  print("Final Dynamics:", res)                                                 
  print("Lower Thresholds (Start Heating):", {k: np.mean(v) for k, v in         
  lower_thresh.items() if v})                                                   
  print("Upper Thresholds (Stop Heating):", {k: np.mean(v) for k, v in          
  upper_thresh.items() if v})                                                   
  print("Sequence Example (Sample 0):", overall_sequences[0][:20])              
  print("Sequence Example (Sample 1):", overall_sequences[1][:20])              
