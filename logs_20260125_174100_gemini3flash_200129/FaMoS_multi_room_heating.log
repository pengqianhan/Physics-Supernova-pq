for mode_id in range(4):                                                        
    results[mode_id] = {}                                                       
                                                                                
    mode_x_prev = []                                                            
    mode_x_next = []                                                            
                                                                                
    for s, xp, m in zip(all_states, all_x_prev, all_modes):                     
        idx = np.where(m == mode_id)[0]                                         
        if len(idx) > 0:                                                        
