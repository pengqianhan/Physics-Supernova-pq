def fit_segment(x_seg):                                                         
    # x_seg is a sequence of values in one mode                                 
    if len(x_seg) < 2: return None, None                                        
    A = np.vstack([x_seg[:-1], np.ones(len(x_seg)-1)]).T                        
    alpha, beta = np.linalg.lstsq(A, x_seg[1:], rcond=None)[0]                  
    return alpha, beta                                                          
                                                                                
