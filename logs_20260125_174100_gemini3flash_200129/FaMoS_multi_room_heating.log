import pandas as pd                                                             
                                                                                
# Load the first data file                                                      
data = np.load('data_all/FaMoS/multi_room_heating/sample_0.npz')                
state = data['state'] # shape (3, 10001)                                        
x1, x2, x3 = state[0], state[1], state[2]                                       
                                                                                
# Assume dt=0.1 (common in these datasets) or just look at differences          
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
dx3 = np.diff(x3)                                                               
                                                                                
# Find where heating happens. Usually dx/dt > -a*x.                             
# Let's look at the signs of derivatives or just the behavior.                  
# Heating: dx/dt will be positive or much larger than cooling.                  
# Let's try to detect modes based on the derivative.                            
                                                                                
# Heuristic: if dx_i > some threshold, it's heating.                            
# But cooling also has a slope.                                                 
# Let's look at the data values first to see ranges.                            
print("x1 range:", np.min(x1), np.max(x1))                                      
print("x2 range:", np.min(x2), np.max(x2))                                      
print("x3 range:", np.min(x3), np.max(x3))                                      
                                                                                
# Calculate mode based on which room is heating.                                
# In "All cooling", all dx_i should be negative.                                
# In "xi heating", dx_i should be positive (or significantly larger).           
                                                                                
# Let's assume dt = 0.1 for now.                                                
dt = 0.1                                                                        
t = np.arange(0, len(x1)*dt, dt)                                                
                                                                                
# Identify modes                                                                
modes = np.zeros(len(dx1))                                                      
for i in range(len(dx1)):                                                       
    # Simple thresholding for demonstration, will refine                        
    # Actually, let's check which room has the largest derivative               
    derivatives = np.array([dx1[i], dx2[i], dx3[i]])                            
    if np.all(derivatives < 0):                                                 
        modes[i] = 4                                                            
    else:                                                                       
        modes[i] = np.argmax(derivatives) + 1                                   
                                                                                
# Check sequence of modes                                                       
mode_changes = []                                                               
if len(modes) > 0:                                                              
    current_mode = modes[0]                                                     
    mode_changes.append((0, current_mode))                                      
    for i in range(1, len(modes)):                                              
        if modes[i] != current_mode:                                            
            current_mode = modes[i]                                             
            mode_changes.append((i, current_mode))                              
                                                                                
print("Mode sequence (first 10):", mode_changes[:10])                           
                                                                                
# Estimate a and b                                                              
# dx/dt = -a*x + b                                                              
# For Mode 4 (All cooling), b_i = 0. So dx_i/dt = -a*x_i => a = - (dx/dt) / x   
mode4_indices = np.where(modes == 4)[0]                                         
if len(mode4_indices) > 0:                                                      
    idx = mode4_indices[10:-10] # avoid transitions                             
    a_est = -dx1[idx] / (x1[idx] * dt)                                          
    print("Estimated a from x1 in mode 4:", np.mean(a_est))                     
    a_val = np.mean(a_est)                                                      
else:                                                                           
    a_val = 0.05 # Fallback common value                                        
                                                                                
# Now estimate b for each mode                                                  
for m in [1, 2, 3]:                                                             
    m_indices = np.where(modes == m)[0]                                         
    if len(m_indices) > 0:                                                      
        idx = m_indices[5:-5]                                                   
        # dx/dt = -a*x + b => b = dx/dt + a*x                                   
        b_est = dx1[idx]/dt + a_val*x1[idx] if m==1 else (dx2[idx]/dt +         
a_val*x2[idx] if m==2 else dx3[idx]/dt + a_val*x3[idx])                         
        print(f"Estimated b_{m} in mode {m}:", np.mean(b_est))                  
                                                                                
# Identify thresholds                                                           
thresholds = []                                                                 
for i in range(1, len(mode_changes)):                                           
    idx, next_mode = mode_changes[i]                                            
    prev_idx, prev_mode = mode_changes[i-1]                                     
    # State at transition                                                       
    state_at_transition = state[:, idx]                                         
    thresholds.append({'from': prev_mode, 'to': next_mode, 'x':                 
state_at_transition})                                                           
                                                                                
# Print some transitions                                                        
for t_info in thresholds[:5]:                                                   
    print(f"Transition {t_info['from']} -> {t_info['to']}: x={t_info['x']}")    
                                                                                
