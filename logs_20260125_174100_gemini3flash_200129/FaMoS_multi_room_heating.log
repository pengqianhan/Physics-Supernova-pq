# Let's look for dt. Usually dt is 0.1.                                         
# Let's check the transitions to find thresholds.                               
# A transition from cooling to heating happens at x_low.                        
# A transition from heating to cooling happens at x_high.                       
                                                                                
def find_thresholds(x_arr, dx_arr, K, B, H, room_idx):                          
    # dx + K*x = B (cooling) or B + H (heating)                                 
    val = dx_arr[room_idx] + K * x_arr[room_idx]                                
    is_heating = val > (B + H/2)                                                
                                                                                
    starts = []                                                                 
    ends = []                                                                   
