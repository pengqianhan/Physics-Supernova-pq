data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1, x2, x3 = state                                                              
                                                                                
# Define modes                                                                  
# We assume heating is when dx is clearly positive                              
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
dx3 = np.diff(x3)                                                               
                                                                                
# Use a threshold to identify modes                                             
# Max dx is around 0.005. Let's use 0 as a first guess.                         
mode1 = dx1 > 0                                                                 
mode2 = dx2 > 0                                                                 
mode3 = dx3 > 0                                                                 
                                                                                
# Check if modes are mutually exclusive                                         
overlap_12 = np.sum(mode1 & mode2)                                              
overlap_13 = np.sum(mode1 & mode3)                                              
overlap_23 = np.sum(mode2 & mode3)                                              
print(f"Overlaps: 1&2: {overlap_12}, 1&3: {overlap_13}, 2&3: {overlap_23}")     
                                                                                
# Identify segments where no heating occurs for a specific room                 
# a can be estimated from dx_i = -a * x_i during decay                          
# Actually, if dx_i = x_i[k+1] - x_i[k], then (x_i[k+1]-x_i[k])/x_i[k] = -a * dt
                                                                                
# Let's find segments where each room is NOT heated                             
not_heated1 = ~mode1                                                            
not_heated2 = ~mode2                                                            
not_heated3 = ~mode3                                                            
                                                                                
# Since a is the same for all:                                                  
# Calculate -dx_i / x_i for all i where not heated                              
# Use indices up to 10000 for x                                                 
ratios = []                                                                     
for i in range(3):                                                              
    xi = state[i][:-1]                                                          
    dxi = np.diff(state[i])                                                     
    mi = (dxi < 0) # Heating indicator - more robust than just >0               
    # Wait, if not heated, dxi should be approximately -a * xi                  
    # -dxi / xi should be a                                                     
    ratios.append(-dxi[mi] / xi[mi])                                            
                                                                                
a_est = np.mean(np.concatenate(ratios))                                         
print(f"Estimated a: {a_est}")                                                  
                                                                                
# Now estimate b_i                                                              
# When heated, dx_i = -a * x_i + b_i  => b_i = dx_i + a * x_i                   
b_ests = []                                                                     
for i in range(3):                                                              
    xi = state[i][:-1]                                                          
    dxi = np.diff(state[i])                                                     
    if i == 0: mi = mode1                                                       
    elif i == 1: mi = mode2                                                     
    else: mi = mode3                                                            
    bi = dxi[mi] + a_est * xi[mi]                                               
    b_ests.append(np.mean(bi))                                                  
                                                                                
print(f"Estimated b_i: {b_ests}")                                               
                                                                                
# Find thresholds                                                               
# At what value of x_i does heating start/stop?                                 
# For room i, heating starts when it enters mode i, and stops when it leaves    
mode i.                                                                         
