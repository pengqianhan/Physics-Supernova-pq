    xp = s[:, :-1]                                                              
                                                                                
    # Identify modes for this sample                                            
    is_heating = dx > 0                                                         
    m = np.zeros(dx.shape[1], dtype=int)                                        
    m[is_heating[0, :]] = 1                                                     
    m[is_heating[1, :]] = 2                                                     
    m[is_heating[2, :]] = 3                                                     
                                                                                
    all_states.append(s)                                                        
    all_dx.append(dx)                                                           
    all_x_prev.append(xp)                                                       
    all_modes.append(m)                                                         
                                                                                
