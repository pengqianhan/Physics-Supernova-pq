import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
a_cont = -0.1                                                                   
                                                                                
def analyze_all_samples():                                                      
    results = []                                                                
    for i in range(3):                                                          
        data = np.load(DATA_FILE_PATHS[i])                                      
        x = data['state']                                                       
        dx = (x[:, 1:] - x[:, :-1]) / dt                                        
        x_mid = (x[:, 1:] + x[:, :-1]) / 2.0                                    
                                                                                
        b = dx - a_cont * x_mid                                                 
                                                                                
        # Determine mode at each step                                           
        # b should be approx 0 for decay, or ~8.1, ~7.0, ~6.6 for heating       
        # We can use a threshold of 1.0 to distinguish heating from decay       
        modes = [] # 0: decay, 1: room 0, 2: room 1, 3: room 2                  
        for t in range(b.shape[1]):                                             
            if np.max(b[:, t]) < 1.0:                                           
                modes.append(0)                                                 
            else:                                                               
                modes.append(np.argmax(b[:, t]) + 1)                            
                                                                                
        # Identify transition points                                            
        transitions = []                                                        
        current_mode = modes[0]                                                 
        transitions.append((0, current_mode, x[:, 0]))                          
                                                                                
        for t in range(1, len(modes)):                                          
            if modes[t] != current_mode:                                        
                transitions.append((t, modes[t], x[:, t]))                      
                current_mode = modes[t]                                         
                                                                                
        # Estimate b values for each heating mode                               
        b_estimates = {1: [], 2: [], 3: []}                                     
        for t in range(len(modes)):                                             
            m = modes[t]                                                        
            if m > 0:                                                           
                b_estimates[m].append(b[m-1, t])                                
                                                                                
        avg_bs = {m: np.mean(vals) if vals else 0 for m, vals in                
