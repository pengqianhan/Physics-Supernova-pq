import numpy as np                                                              
import os                                                                       
                                                                                
# Function to analyze a single file                                             
def analyze_file(file_path):                                                    
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    dt = 0.001 # based on config                                                
                                                                                
    # Calculate derivatives                                                     
    derivs = np.diff(state, axis=1) / dt                                        
                                                                                
    # Initial states and derivatives                                            
    initial_state = state[:, 0]                                                 
    initial_deriv = derivs[:, 0]                                                
                                                                                
    # Identify modes based on which variable is increasing (heating)            
    # If all are decreasing, it's decay mode.                                   
    # We'll look for intervals where one derivative is significantly positive.  
                                                                                
    modes = []                                                                  
    num_steps = state.shape[1]                                                  
    current_mode = -1                                                           
    change_points = []                                                          
                                                                                
    for i in range(num_steps - 1):                                              
        d = derivs[:, i]                                                        
        if d[0] > 0: # Heating x1                                               
            mode = 2                                                            
        elif d[1] > 0: # Heating x2                                             
            mode = 3                                                            
        elif d[2] > 0: # Heating x3                                             
            mode = 4                                                            
        else: # Decay                                                           
            mode = 1                                                            
                                                                                
        if mode != current_mode:                                                
            change_points.append((i * dt, mode))                                
            current_mode = mode                                                 
                                                                                
    # Estimate coefficients: x'[i] = a * x[i] + b                               
    # For decay mode (mode 1): x'[i] = a * x[i]                                 
    # For heating mode j (mode j): x_j'[i] = a * x_j[i] + b_j                   
                                                                                
    # Extract data for Mode 1 (Decay)                                           
    mode1_mask = []                                                             
    current_mode = -1                                                           
    for i in range(num_steps - 1):                                              
        d = derivs[:, i]                                                        
        if d[0] <= 0 and d[1] <= 0 and d[2] <= 0:                               
            mode1_mask.append(i)                                                
                                                                                
    a_est = 0                                                                   
    if mode1_mask:                                                              
        m1 = np.array(mode1_mask)                                               
        # Use x1 for decay estimation                                           
        # x1' = a * x1                                                          
        a_est = np.mean(derivs[0, m1] / state[0, m1])                           
                                                                                
    # Estimate forcing terms for heating modes                                  
    b_coeffs = {}                                                               
    for m_id, var_idx in [(2, 0), (3, 1), (4, 2)]:                              
        mask = []                                                               
        for i in range(num_steps - 1):                                          
            if derivs[var_idx, i] > 0:                                          
                mask.append(i)                                                  
        if mask:                                                                
            idx = np.array(mask)                                                
            # x' = a*x + b => b = x' - a*x                                      
            b_vals = derivs[var_idx, idx] - a_est * state[var_idx, idx]         
            b_coeffs[m_id] = np.mean(b_vals)                                    
                                                                                
    # Determine thresholds (switching conditions)                               
    # Transitions happen at specific values of x1, x2, x3.                      
    thresholds = {}                                                             
    for i in range(len(change_points) - 1):                                     
        t, m_from = change_points[i]                                            
        t_next, m_to = change_points[i+1]                                       
        step_idx = int(t_next / dt)                                             
        state_at_switch = state[:, step_idx]                                    
        thresholds[(m_from, m_to)] = state_at_switch                            
                                                                                
    return {                                                                    
        "initial_state": initial_state,                                         
        "initial_deriv": initial_deriv,                                         
        "change_points": change_points[:10],                                    
        "a_est": a_est,                                                         
        "b_coeffs": b_coeffs,                                                   
        "thresholds": thresholds                                                
    }                                                                           
                                                                                
