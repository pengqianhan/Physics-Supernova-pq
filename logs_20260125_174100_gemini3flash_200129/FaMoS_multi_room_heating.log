  # Mode 2: x2 heating                                                          
  # Mode 3: x3 heating                                                          
  num_steps = len(dx1)                                                          
  modes = []                                                                    
  for k in range(num_steps):                                                    
      h1 = dx1[k] > 1e-9                                                        
      h2 = dx2[k] > 1e-9                                                        
      h3 = dx3[k] > 1e-9                                                        
      if h1: modes.append(1)                                                    
      elif h2: modes.append(2)                                                  
      elif h3: modes.append(3)                                                  
      else: modes.append(0)                                                     
                                                                                
  # Analyze transitions                                                         
  transitions = []                                                              
  for k in range(1, len(modes)):                                                
      if modes[k] != modes[k-1]:                                                
          # Switch occurred at index k                                          
          # modes[k-1] was the mode for interval [k-1, k]                       
          # modes[k] is the mode for interval [k, k+1]                          
          transitions.append({                                                  
              'step': k,                                                        
              'from': modes[k-1],                                               
              'to': modes[k],                                                   
              'x1': x1[k],                                                      
              'x2': x2[k],                                                      
              'x3': x3[k]                                                       
          })                                                                    
                                                                                
  # Print details of the first 15 transitions                                   
  for t in transitions[:15]:                                                    
