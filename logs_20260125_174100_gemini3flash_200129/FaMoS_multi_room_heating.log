Thought: I will load the data files and inspect the 'state' variable to         
determine the trajectories of $x_1$, $x_2$, and $x_3$. I'll then calculate the  
differences between consecutive time steps to estimate the derivatives and      
identify the different operational modes. I will also test the decay            
coefficients (-0.05, -0.1, -0.15) to see which one best fits the model $x[k+1] =
(1 + \text{decay})x[k] + C$.                                                    
                                                                                
<code>                                                                          
import numpy as np                                                              
                                                                                
files = ['data_all/FaMoS/multi_room_heating/sample_0.npz',                      
         'data_all/FaMoS/multi_room_heating/sample_1.npz',                      
         'data_all/FaMoS/multi_room_heating/sample_2.npz']                      
                                                                                
results = []                                                                    
                                                                                
for i, file_path in enumerate(files):                                           
    data = np.load(file_path)                                                   
    state = data['state']                                                       
                                                                                
    # x1, x2, x3 are the columns of state                                       
    x1, x2, x3 = state[:, 0], state[:, 1], state[:, 2]                          
                                                                                
    # Calculate differences (derivatives)                                       
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
    dx3 = np.diff(x3)                                                           
                                                                                
    # Identify modes based on signs of dx1, dx2, dx3                            
    # Use a small epsilon to handle noise if necessary, but assuming clean data 
    signs = np.sign(np.column_stack((dx1, dx2, dx3)))                           
                                                                                
    # Initial state                                                             
    initial_state = state[0].tolist()                                           
                                                                                
    print(f"File {i}: Initial state {initial_state}")                           
                                                                                
    # Group into segments with the same mode                                    
    modes = []                                                                  
    current_mode = signs[0]                                                     
    start_idx = 0                                                               
    for idx in range(1, len(signs)):                                            
        if not np.array_equal(signs[idx], current_mode):                        
            modes.append({                                                      
                'mode_sign': current_mode.tolist(),                             
                'start_idx': start_idx,                                         
                'end_idx': idx,                                                 
                'guard_state': state[idx].tolist()                              
            })                                                                  
            current_mode = signs[idx]                                           
            start_idx = idx                                                     
    modes.append({                                                              
        'mode_sign': current_mode.tolist(),                                     
        'start_idx': start_idx,                                                 
        'end_idx': len(signs),                                                  
        'guard_state': state[-1].tolist()                                       
    })                                                                          
                                                                                
    # For each mode, estimate C values with decay -0.1 (factor 0.9)             
    # x[k+1] = 0.9 * x[k] + C  => C = x[k+1] - 0.9 * x[k]                       
    # Check multiple decay coefficients                                         
    decay_options = [-0.05, -0.1, -0.15]                                        
    best_decay = -0.1                                                           
    min_std = float('inf')                                                      
                                                                                
    for d in decay_options:                                                     
        factor = 1 + d                                                          
        c_vals = state[1:] - factor * state[:-1]                                
        std_sum = np.sum(np.std(c_vals, axis=0))                                
        if std_sum < min_std:                                                   
            min_std = std_sum                                                   
            best_decay = d                                                      
                                                                                
    print(f"File {i}: Best decay coefficient found: {best_decay}")              
                                                                                
    factor = 1 + best_decay                                                     
    mode_analysis = []                                                          
    for m in modes:                                                             
        idx_range = slice(m['start_idx'], m['end_idx'])                         
        # x[k+1] = factor * x[k] + C                                            
        # Use states from range to estimate C                                   
        xk = state[m['start_idx'] : m['end_idx']]                               
        xnext = state[m['start_idx'] + 1 : m['end_idx'] + 1]                    
        c_estimates = np.mean(xnext - factor * xk, axis=0)                      
        mode_analysis.append({                                                  
            'signs': m['mode_sign'],                                            
            'C': c_estimates.tolist(),                                          
            'guard': m['guard_state'],                                          
            'length': m['end_idx'] - m['start_idx']                             
        })                                                                      
                                                                                
    results.append({                                                            
        'file': file_path,                                                      
        'initial_state': initial_state,                                         
        'best_decay': best_decay,                                               
        'mode_analysis': mode_analysis                                          
    })                                                                          
                                                                                
for res in results:                                                             
    print(f"--- {res['file']} ---")                                             
    print(f"Initial: {res['initial_state']}")                                   
    for j, ma in enumerate(res['mode_analysis']):                               
        print(f"Mode {j}: Signs={ma['signs']}, C={ma['C']},                     
Length={ma['length']}")                                                         
        print(f"  Switching/End State: {ma['guard']}")                          
                                                                                
