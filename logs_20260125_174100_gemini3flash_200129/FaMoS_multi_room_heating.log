def get_switches(path):                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    dx = np.diff(state, axis=1)                                                 
    h = dx > 0                                                                  
    modes = np.zeros(h.shape[1], dtype=int)                                     
    for i in range(3):                                                          
        modes[h[i]] = i+1                                                       
    sw = np.where(modes[:-1] != modes[1:])[0]                                   
    return state, modes, sw                                                     
                                                                                
for path in DATA_FILE_PATHS:                                                    
    s, m, sw = get_switches(path)                                               
    print(f"File {path}:")                                                      
    for idx in sw:                                                              
        print(f"  Step {idx}: {m[idx]} -> {m[idx+1]} at {s[:, idx]}")           
                                                                                
