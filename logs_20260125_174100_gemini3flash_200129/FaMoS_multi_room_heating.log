      # Calculate slopes                                                        
      dx = np.diff(state, axis=1)                                               
      slopes = dx / dt                                                          
                                                                                
      # Heating mask: slope > 0                                                 
      # Use a small epsilon to avoid numerical noise issues                     
      is_heating = slopes > 0                                                   
                                                                                
      # Find transition indices                                                 
      transitions = []                                                          
      for j in range(n_steps - 2):                                              
          if not np.array_equal(is_heating[:, j], is_heating[:, j+1]):          
