import numpy as np                                                              
                                                                                
def estimate_a_b(paths):                                                        
    all_a_dt = []                                                               
    all_b1_dt = []                                                              
    all_b2_dt = []                                                              
    all_b3_dt = []                                                              
                                                                                
    for path in paths:                                                          
        data = np.load(path)                                                    
        state = data['state']                                                   
        x = state[:, :-1]                                                       
        dx = np.diff(state, axis=1)                                             
                                                                                
        h1 = dx[0] > 0                                                          
        h2 = dx[1] > 0                                                          
        h3 = dx[2] > 0                                                          
                                                                                
        # Cooling slopes to find a_dt                                           
        # Room 1 cooling                                                        
        m1_cool = ~(h1)                                                         
        a_dt_1 = -np.polyfit(x[0, m1_cool], dx[0, m1_cool], 1)[0]               
        # Room 2 cooling                                                        
        m2_cool = ~(h2)                                                         
        a_dt_2 = -np.polyfit(x[1, m2_cool], dx[1, m2_cool], 1)[0]               
        # Room 3 cooling                                                        
        m3_cool = ~(h3)                                                         
        a_dt_3 = -np.polyfit(x[2, m3_cool], dx[2, m3_cool], 1)[0]               
                                                                                
        all_a_dt.extend([a_dt_1, a_dt_2, a_dt_3])                               
                                                                                
        # Assuming a_dt is the mean of these                                    
        curr_a_dt = np.mean([a_dt_1, a_dt_2, a_dt_3])                           
                                                                                
        # Calculate b_i_dt = dx_i + a_dt * x_i                                  
        if np.any(h1): all_b1_dt.append(np.mean(dx[0, h1] + curr_a_dt * x[0,    
h1]))                                                                           
        if np.any(h2): all_b2_dt.append(np.mean(dx[1, h2] + curr_a_dt * x[1,    
h2]))                                                                           
        if np.any(h3): all_b3_dt.append(np.mean(dx[2, h3] + curr_a_dt * x[2,    
h3]))                                                                           
                                                                                
    return np.mean(all_a_dt), np.mean(all_b1_dt), np.mean(all_b2_dt),           
np.mean(all_b3_dt)                                                              
                                                                                
a_dt, b1_dt, b2_dt, b3_dt = estimate_a_b(DATA_FILE_PATHS)                       
