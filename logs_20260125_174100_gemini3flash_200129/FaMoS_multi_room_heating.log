import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load the data files                                                           
data_files = ['data_all/FaMoS/multi_room_heating/sample_0.npz',                 
              'data_all/FaMoS/multi_room_heating/sample_1.npz',                 
              'data_all/FaMoS/multi_room_heating/sample_2.npz']                 
                                                                                
results = []                                                                    
                                                                                
for i, file_path in enumerate(data_files):                                      
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    time = data['time']                                                         
                                                                                
    dt = np.diff(time)                                                          
    # Average dt                                                                
    avg_dt = np.mean(dt)                                                        
                                                                                
    # Calculate derivatives                                                     
    # state is (3, N)                                                           
    dx = np.diff(state, axis=1) / dt                                            
                                                                                
    # x values for the derivatives (midpoints or shifted)                       
    x_mid = state[:, :-1]                                                       
                                                                                
    results.append({                                                            
        'state': state,                                                         
        'time': time,                                                           
        'dx': dx,                                                               
        'x_mid': x_mid,                                                         
        'dt': avg_dt                                                            
    })                                                                          
                                                                                
# Now let's try to identify the modes and parameters.                           
# Mode 1: All cooling dx_i = -k * x_i + b                                       
# Mode 2: x1 heating dx1 = -k * x1 + Q1 + b, dx2 = -k * x2 + b, dx3 = -k * x3 + 
b                                                                               
# ...                                                                           
                                                                                
# Collect all data points to perform regression                                 
# We can distinguish cooling vs heating by looking at dx + k*x.                 
# For cooling, dx + k*x = b. For heating x_i, dx_i + k*x_i = Q_i + b.           
                                                                                
# Let's estimate k and b first.                                                 
# Looking at points where all variables are likely cooling (derivatives are     
negative)                                                                       
# Or better, look at the correlations.                                          
all_dx = np.concatenate([res['dx'] for res in results], axis=1)                 
all_x = np.concatenate([res['x_mid'] for res in results], axis=1)               
                                                                                
# Estimate k and b using the cooling phase of any variable.                     
# Usually, k is small. Let's try to find k by looking at segments where         
variables are cooling.                                                          
# In cooling phase: dx = -k * x + b                                             
# Since multiple rooms might be cooling even if one is heating,                 
# we can look for the most common linear relationship.                          
                                                                                
# Let's try to find k and b using points where dx is low.                       
# Pick room 1 cooling points.                                                   
room1_dx = all_dx[0]                                                            
room1_x = all_x[0]                                                              
                                                                                
# Filter points that are likely cooling (dx < 0 or low)                         
mask_cooling1 = room1_dx < 0                                                    
if np.any(mask_cooling1):                                                       
    coeffs = np.polyfit(room1_x[mask_cooling1], room1_dx[mask_cooling1], 1)     
    k_est = -coeffs[0]                                                          
    b_est = coeffs[1]                                                           
    print(f"Room 1 Cooling: k={k_est}, b={b_est}")                              
                                                                                
# Check other rooms                                                             
room2_dx = all_dx[1]                                                            
room2_x = all_x[1]                                                              
