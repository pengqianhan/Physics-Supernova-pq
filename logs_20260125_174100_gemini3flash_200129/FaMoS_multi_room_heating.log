  # Extract time and state variables                                            
  t = data['t']                                                                 
  x = data['x']                                                                 
                                                                                
  print("Shape of t:", t.shape)                                                 
  print("Shape of x:", x.shape)                                                 
                                                                                
  # Let's look at the first few rows                                            
  for i in range(5):                                                            
