  # If dt=0.1, then k*0.1*20 + b*0.1 ~ -0.002 => -k*2 + 0.1b = -0.002.          
  # Let's look for dt. Usually dt is 0.1.                                       
  # Let's check the transitions to find thresholds.                             
  # A transition from cooling to heating happens at x_low.                      
  # A transition from heating to cooling happens at x_high.                     
                                                                                
  def find_thresholds(x_arr, dx_arr, K, B, H, room_idx):                        
      # dx + K*x = B (cooling) or B + H (heating)                               
      val = dx_arr[room_idx] + K * x_arr[room_idx]                              
      is_heating = val > (B + H/2)                                              
                                                                                
      starts = []                                                               
      ends = []                                                                 
      for t in range(1, len(is_heating)):                                       
          if is_heating[t] and not is_heating[t-1]:                             
              starts.append(x_arr[room_idx, t])                                 
          if not is_heating[t] and is_heating[t-1]:                             
              ends.append(x_arr[room_idx, t])                                   
      return starts, ends                                                       
                                                                                
  starts1, ends1 = find_thresholds(all_x, all_dx, best_K, best_B, H1, 0)        
  starts2, ends2 = find_thresholds(all_x, all_dx, best_K, best_B, H2, 1)        
  starts3, ends3 = find_thresholds(all_x, all_dx, best_K, best_B, H3, 2)        
                                                                                
  print(f"Room 1: Low={np.mean(starts1)}, High={np.mean(ends1)}")               
  print(f"Room 2: Low={np.mean(starts2)}, High={np.mean(ends2)}")               
  print(f"Room 3: Low={np.mean(starts3)}, High={np.mean(ends3)}")               
                                                                                
