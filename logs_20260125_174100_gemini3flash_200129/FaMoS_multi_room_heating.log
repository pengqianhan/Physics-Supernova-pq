import numpy as np                                                              
import scipy.stats                                                              
                                                                                
# Load data                                                                     
state_data = []                                                                 
for i in range(3):                                                              
    d = np.load(f'data_all/FaMoS/multi_room_heating/sample_{i}.npz')            
    state_data.append(d['state'])                                               
                                                                                
all_states = []                                                                 
all_diffs = []                                                                  
                                                                                
for s in state_data:                                                            
    diff = s[:, 1:] - s[:, :-1]                                                 
    all_states.append(s[:, :-1])                                                
    all_diffs.append(diff)                                                      
                                                                                
states_concat = np.concatenate(all_states, axis=1).T                            
diffs_concat = np.concatenate(all_diffs, axis=1).T                              
                                                                                
def get_mode(dx):                                                               
    if dx[0] > 1e-8 and dx[1] <= 1e-8 and dx[2] <= 1e-8: return 1               
    if dx[0] <= 1e-8 and dx[1] > 1e-8 and dx[2] <= 1e-8: return 2               
    if dx[0] <= 1e-8 and dx[1] <= 1e-8 and dx[2] > 1e-8: return 3               
    if dx[0] <= 1e-8 and dx[1] <= 1e-8 and dx[2] <= 1e-8: return 4              
    return 0                                                                    
                                                                                
modes = np.array([get_mode(d) for d in diffs_concat])                           
                                                                                
# Fit linear dynamics: dx = a*x + b                                             
def fit_linear(x, y):                                                           
    if len(x) < 2: return None, None                                            
    slope, intercept, r_value, p_value, std_err = scipy.stats.linregress(x, y)  
    return slope, intercept                                                     
                                                                                
results = {}                                                                    
for i in range(3):                                                              
    idx_heat = (modes == (i+1))                                                 
    a_h, b_h = fit_linear(states_concat[idx_heat, i], diffs_concat[idx_heat, i])
                                                                                
    idx_cool = (modes != (i+1)) & (modes != 0)                                  
    a_c, b_c = fit_linear(states_concat[idx_cool, i], diffs_concat[idx_cool, i])
    results[f'x{i+1}'] = {'heating': (a_h, b_h), 'cooling': (a_c, b_c)}         
                                                                                
# Thresholds and Transitions                                                    
transitions_seq = []                                                            
x1_low, x1_high = [], []                                                        
x2_low, x2_high = [], []                                                        
x3_low, x3_high = [], []                                                        
                                                                                
for s_idx, (s, diff_arr) in enumerate(zip(state_data, all_diffs)):              
    m = np.array([get_mode(dx) for dx in diff_arr.T])                           
    # Sequence of modes for this sample                                         
    mode_changes = [m[0]]                                                       
    for j in range(len(m) - 1):                                                 
        if m[j] != m[j+1]:                                                      
            trans = (m[j], m[j+1])                                              
            transitions_seq.append(trans)                                       
            mode_changes.append(m[j+1])                                         
            val_next = s[:, j+1]                                                
                                                                                
            if m[j] == 1 and m[j+1] != 1: x1_high.append(val_next[0])           
            if m[j] != 1 and m[j+1] == 1: x1_low.append(val_next[0])            
            if m[j] == 2 and m[j+1] != 2: x2_high.append(val_next[1])           
            if m[j] != 2 and m[j+1] == 2: x2_low.append(val_next[1])            
            if m[j] == 3 and m[j+1] != 3: x3_high.append(val_next[2])           
            if m[j] != 3 and m[j+1] == 3: x3_low.append(val_next[2])            
    print(f"Sample {s_idx} mode sequence: {mode_changes[:20]}...")              
                                                                                
print("\nRegression Results:")                                                  
for var, res in results.items():                                                
    print(f"{var}: Heating a={res['heating'][0]:.6f}, b={res['heating'][1]:.6f} 
| Cooling a={res['cooling'][0]:.6f}, b={res['cooling'][1]:.6f}")                
                                                                                
print("\nUnique transitions observed:", sorted(list(set(transitions_seq))))     
print(f"x1 thresholds: Low={np.mean(x1_low):.4f}, High={np.mean(x1_high):.4f}") 
print(f"x2 thresholds: Low={np.mean(x2_low):.4f}, High={np.mean(x2_high):.4f}") 
print(f"x3 thresholds: Low={np.mean(x3_low):.4f}, High={np.mean(x3_high):.4f}") 
                                                                                
