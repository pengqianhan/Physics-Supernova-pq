import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the first data file                                                      
data0 = np.load('data_all/FaMoS/multi_room_heating/sample_0.npz')               
print("Keys in sample_0:", list(data0.keys()))                                  
                                                                                
# Extract time and state variables                                              
# Assuming 't' for time and 'x' or similar for states. Let's check the keys.    
# Let's assume the keys are 't' and 'x' (typical for trajectories).             
t = data0['t']                                                                  
x = data0['x']                                                                  
print("t shape:", t.shape)                                                      
print("x shape:", x.shape)                                                      
                                                                                
# Compute numerical derivatives                                                 
dt = np.diff(t)                                                                 
dx = np.diff(x, axis=0)                                                         
dxdt = dx / dt[:, np.newaxis]                                                   
                                                                                
# Mode identification logic                                                     
# Mode 1: x1 increasing (heater 1 on)                                           
# Mode 2: x2 increasing (heater 2 on)                                           
# Mode 3: x3 increasing (heater 3 on)                                           
# Mode 4: All decreasing                                                        
# We use dxdt to identify which variable is increasing.                         
                                                                                
modes = np.zeros(len(dxdt), dtype=int)                                          
for i in range(len(dxdt)):                                                      
    if dxdt[i, 0] > 0.01: # Threshold for "increasing"                          
        modes[i] = 1                                                            
    elif dxdt[i, 1] > 0.01:                                                     
        modes[i] = 2                                                            
    elif dxdt[i, 2] > 0.01:                                                     
        modes[i] = 3                                                            
    else:                                                                       
        modes[i] = 4                                                            
                                                                                
# Fit dx_i/dt = a_i * x_i + b_i for each mode                                   
results = []                                                                    
for m in [1, 2, 3, 4]:                                                          
    idx = np.where(modes == m)[0]                                               
    if len(idx) < 2: continue                                                   
                                                                                
    # Take the state x at the start of each interval for the derivative         
    xm = x[idx]                                                                 
    dxdtm = dxdt[idx]                                                           
                                                                                
    mode_params = {}                                                            
    for j in range(3): # For x1, x2, x3                                         
        # Linear regression: dxdt = a*x + b                                     
        # y = A @ p where y = dxdt, A = [x, 1], p = [a, b]                      
        A = np.vstack([xm[:, j], np.ones(len(idx))]).T                          
        p, _, _, _ = np.linalg.lstsq(A, dxdtm[:, j], rcond=None)                
        mode_params[f'a{j+1}'] = p[0]                                           
        mode_params[f'b{j+1}'] = p[1]                                           
    results.append({'mode': m, 'params': mode_params})                          
                                                                                
# Extract thresholds                                                            
# Transitions occur when mode changes.                                          
switches = np.where(modes[:-1] != modes[1:])[0]                                 
thresholds = []                                                                 
for s in switches:                                                              
    m_from = modes[s]                                                           
    m_to = modes[s+1]                                                           
    val = x[s+1]                                                                
    thresholds.append({'from': m_from, 'to': m_to, 'val': val})                 
                                                                                
print("Fitted parameters:", results)                                            
print("Switches:", thresholds[:10])                                             
                                                                                
