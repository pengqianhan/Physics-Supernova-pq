  # Sort by x1 to see the two lines.                                            
  r1_x = all_x[0]                                                               
  r1_dx = all_dx[0]                                                             
                                                                                
  # Try to find two lines.                                                      
  # We can use a simple trick: for a fixed K, dx + K*x should be either B or    
  B+H.                                                                          
  # Let's try to find K that minimizes the variance of the two clusters.        
  Ks = np.linspace(0, 0.01, 101) # dt*k                                         
  variances = []                                                                
  for K in Ks:                                                                  
      val = r1_dx + K * r1_x                                                    
      # Use the variance of the two clusters?                                   
      # Or just the fact that most points are in one cluster.                   
      # Let's just fit a line to the majority.                                  
      hist, bins = np.histogram(val, bins=100)                                  
      variances.append(np.max(hist)) # Find K that gives the sharpest peak      
                                                                                
  best_K = Ks[np.argmax(variances)]                                             
  val = r1_dx + best_K * r1_x                                                   
  hist, bins = np.histogram(val, bins=100)                                      
  best_B = bins[np.argmax(hist)]                                                
                                                                                
  print(f"Estimated K (k*dt): {best_K}")                                        
  print(f"Estimated B (b*dt): {best_B}")                                        
                                                                                
  # Now find H1, H2, H3 (Q_i * dt)                                              
  # Room 1                                                                      
  val1 = all_dx[0] + best_K * all_x[0]                                          
  H1 = np.max(val1) - best_B                                                    
  # Room 2                                                                      
  val2 = all_dx[1] + best_K * all_x[1]                                          
  H2 = np.max(val2) - best_B                                                    
  # Room 3                                                                      
  val3 = all_dx[2] + best_K * all_x[2]                                          
  H3 = np.max(val3) - best_B                                                    
                                                                                
