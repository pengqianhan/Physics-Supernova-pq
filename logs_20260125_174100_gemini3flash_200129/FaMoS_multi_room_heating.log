import numpy as np                                                              
from scipy import stats                                                         
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/multi_room_heating/sample_0.npz')                
state = data['state']                                                           
# state shape is (3, 10001)                                                     
x1, x2, x3 = state[0], state[1], state[2]                                       
                                                                                
def analyze_variable(x, name):                                                  
    dx = np.diff(x)                                                             
    heating_idx = np.where(dx > 1e-9)[0] # Room is heating                      
    cooling_idx = np.where(dx < -1e-9)[0] # Room is cooling                     
                                                                                
    # Linear relationship x[k+1] = a * x[k] + b                                 
    # Heating                                                                   
    if len(heating_idx) > 0:                                                    
        res_h = stats.linregress(x[heating_idx], x[heating_idx+1])              
        a_h, b_h = res_h.slope, res_h.intercept                                 
    else:                                                                       
        a_h, b_h = None, None                                                   
                                                                                
    # Cooling                                                                   
    if len(cooling_idx) > 0:                                                    
        res_c = stats.linregress(x[cooling_idx], x[cooling_idx+1])              
        a_c, b_c = res_c.slope, res_c.intercept                                 
    else:                                                                       
        a_c, b_c = None, None                                                   
                                                                                
    # Thresholds                                                                
    # Switches from heating to cooling (upper threshold)                        
    # Switches from cooling to heating (lower threshold)                        
    # Let's find local extrema                                                  
    upper_thresholds = []                                                       
    lower_thresholds = []                                                       
    for i in range(1, len(dx)):                                                 
        if dx[i-1] > 0 and dx[i] <= 0: # Switch from heating to cooling or off  
             upper_thresholds.append(x[i])                                      
        if dx[i-1] <= 0 and dx[i] > 0: # Switch from cooling/off to heating     
             lower_thresholds.append(x[i])                                      
                                                                                
    return {                                                                    
        'heating': (a_h, b_h),                                                  
        'cooling': (a_c, b_c),                                                  
        'upper': np.mean(upper_thresholds) if upper_thresholds else None,       
        'lower': np.mean(lower_thresholds) if lower_thresholds else None        
    }                                                                           
                                                                                
results = {                                                                     
    'x1': analyze_variable(x1, 'x1'),                                           
    'x2': analyze_variable(x2, 'x2'),                                           
    'x3': analyze_variable(x3, 'x3')                                            
}                                                                               
                                                                                
print(results)                                                                  
                                                                                
# Determine mode logic                                                          
# For each time step, identify which room is heating                            
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
dx3 = np.diff(x3)                                                               
                                                                                
num_steps = len(dx1)                                                            
modes = []                                                                      
for k in range(num_steps):                                                      
    h1 = dx1[k] > 1e-9                                                          
    h2 = dx2[k] > 1e-9                                                          
    h3 = dx3[k] > 1e-9                                                          
                                                                                
    if h1 and not h2 and not h3:                                                
        modes.append(1)                                                         
    elif not h1 and h2 and not h3:                                              
        modes.append(2)                                                         
    elif not h1 and not h2 and h3:                                              
        modes.append(3)                                                         
    elif not h1 and not h2 and not h3:                                          
        modes.append(0) # All off                                               
    else:                                                                       
        modes.append(-1) # Multiple heating?                                    
                                                                                
print("Unique modes found:", np.unique(modes))                                  
                                                                                
# Switching sequence                                                            
switches = []                                                                   
for k in range(1, len(modes)):                                                  
    if modes[k] != modes[k-1]:                                                  
        switches.append((modes[k-1], modes[k]))                                 
                                                                                
print("First few switches:", switches[:10])                                     
                                                                                
