│ **With reset map:**                                                          │
│ ```json                                                                      │
│ {                                                                            │
│     "automaton": {                                                           │
│         "var": "x1, x2",                                                     │
│         "input": "u1",                                                       │
│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
