import numpy as np                                                              
                                                                                
data = np.load(DATA_FILE_PATH)                                                  
state = data['state'] # (3, 10001)                                              
x1, x2, x3 = state[0], state[1], state[2]                                       
                                                                                
# 1. Determine decay constant 'a'                                               
# Look at segments where room is cooling.                                       
# Let's assume cooling is when x_i[t+1] < x_i[t]                                
# Let's check ratios for all rooms when they are cooling.                       
a_estimates = []                                                                
for i in range(3):                                                              
    x = state[i]                                                                
    ratios = x[1:] / x[:-1]                                                     
    # To be sure it's cooling and not the first step of heating                 
    # we look for where it's decreasing                                         
    cooling_mask = x[1:] < x[:-1]                                               
    a_estimates.extend(ratios[cooling_mask])                                    
                                                                                
a = np.median(a_estimates)                                                      
print(f"Estimated decay constant a: {a}")                                       
                                                                                
# 2. Determine heating constants b_i                                            
b_estimates = [[], [], []]                                                      
for i in range(3):                                                              
    x = state[i]                                                                
    # heating is when x[t+1] > a * x[t] + epsilon                               
    # or simply when it's not cooling                                           
    heating_mask = x[1:] > (a * x[:-1] + 1e-6)                                  
    diffs = x[1:][heating_mask] - a * x[:-1][heating_mask]                      
    b_estimates[i].extend(diffs)                                                
                                                                                
b = [np.median(be) if len(be) > 0 else 0 for be in b_estimates]                 
print(f"Estimated heating constants b: {b}")                                    
                                                                                
# 3. Switching thresholds                                                       
# Lower threshold: x_i[t] when it starts heating.                               
# Upper threshold: x_i[t] when it stops heating.                                
thresholds = []                                                                 
for i in range(3):                                                              
    x = state[i]                                                                
    heating = x[1:] > (a * x[:-1] + 1e-6)                                       
    # Start heating: heating[t] is True, heating[t-1] was False                 
    starts = np.where(np.diff(heating.astype(int)) == 1)[0] + 1                 
    # Stop heating: heating[t] is False, heating[t-1] was True                  
    stops = np.where(np.diff(heating.astype(int)) == -1)[0] + 1                 
                                                                                
    lower = x[starts]                                                           
    upper = x[stops]                                                            
    thresholds.append({'lower': np.mean(lower), 'upper': np.mean(upper)})       
                                                                                
print("Thresholds:", thresholds)                                                
                                                                                
# 4. Sequence of heating                                                        
# Let's see which room heats at what time                                       
heating_status = []                                                             
for i in range(3):                                                              
    x = state[i]                                                                
    h = x[1:] > (a * x[:-1] + 1e-6)                                             
    heating_status.append(h)                                                    
                                                                                
heating_status = np.array(heating_status) # (3, 10000)                          
# Check how many rooms heat at once                                             
concurrent_heating = np.sum(heating_status, axis=0)                             
print("Max concurrent heating rooms:", np.max(concurrent_heating))              
                                                                                
# Identify sequence                                                             
heating_starts = []                                                             
for t in range(1, 10000):                                                       
    for i in range(3):                                                          
        if heating_status[i, t] and not heating_status[i, t-1]:                 
            heating_starts.append((t, i, state[:, t]))                          
                                                                                
print("First few heating starts (time, room, [x1, x2, x3]):")                   
for start in heating_starts[:10]:                                               
    print(start)                                                                
                                                                                
                                                                                
