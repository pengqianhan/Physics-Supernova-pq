def get_mode(d1, d2, d3):                                                       
    if d1 > 0 and d2 < 0 and d3 < 0: return 1                                   
    if d1 < 0 and d2 > 0 and d3 < 0: return 2                                   
    if d1 < 0 and d2 < 0 and d3 > 0: return 3                                   
    if d1 < 0 and d2 < 0 and d3 < 0: return 4                                   
