import numpy as np                                                              
import scipy.stats                                                              
                                                                                
# Function to fit dx/dt = a*x + b                                               
def fit_linear(x_vals, dx_vals):                                                
    if len(x_vals) < 2:                                                         
        return None, None                                                       
    # np.polyfit(x, y, 1) returns [a, b] for y = ax + b                         
    slope, intercept = np.polyfit(x_vals, dx_vals, 1)                           
    return slope, intercept                                                     
                                                                                
# Collect data from all files                                                   
all_x_inc = {1: [], 2: [], 3: []}                                               
all_dx_inc = {1: [], 2: [], 3: []}                                              
all_x_dec = {1: [], 2: [], 3: []}                                               
all_dx_dec = {1: [], 2: [], 3: []}                                              
all_transitions = []                                                            
all_sequences = []                                                              
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    t = data['t'].flatten()                                                     
    x = data['x']                                                               
    dt = np.diff(t)                                                             
                                                                                
    # Calculate derivatives                                                     
    dx = np.diff(x, axis=0) / dt[:, np.newaxis]                                 
                                                                                
    # Use the mid-points or just the first N-1 points for x                     
    x_mid = x[:-1]                                                              
                                                                                
    # Define modes for each step                                                
    # Mode 1: x1 inc, others dec                                                
    # Mode 2: x2 inc, others dec                                                
    # Mode 3: x3 inc, others dec                                                
    # Mode 4: All dec                                                           
                                                                                
    modes = []                                                                  
    for i in range(len(dx)):                                                    
        d1, d2, d3 = dx[i]                                                      
        if d1 > 0 and d2 < 0 and d3 < 0:                                        
            modes.append(1)                                                     
        elif d1 < 0 and d2 > 0 and d3 < 0:                                      
            modes.append(2)                                                     
        elif d1 < 0 and d2 < 0 and d3 > 0:                                      
            modes.append(3)                                                     
        elif d1 < 0 and d2 < 0 and d3 < 0:                                      
            modes.append(4)                                                     
        else:                                                                   
            modes.append(0) # Transition/Other                                  
                                                                                
    modes = np.array(modes)                                                     
    all_sequences.append(modes)                                                 
                                                                                
    # Collect data for regression                                               
    for j in range(3): # For x1, x2, x3                                         
        var_idx = j                                                             
        inc_mask = dx[:, var_idx] > 0                                           
        dec_mask = dx[:, var_idx] < 0                                           
                                                                                
        all_x_inc[j+1].extend(x_mid[inc_mask, var_idx])                         
        all_dx_inc[j+1].extend(dx[inc_mask, var_idx])                           
        all_x_dec[j+1].extend(x_mid[dec_mask, var_idx])                         
        all_dx_dec[j+1].extend(dx[dec_mask, var_idx])                           
                                                                                
    # Identify transitions                                                      
    for i in range(len(modes) - 1):                                             
        if modes[i] != modes[i+1] and modes[i] != 0 and modes[i+1] != 0:        
            all_transitions.append({                                            
                'from': modes[i],                                               
                'to': modes[i+1],                                               
                'x': x_mid[i]                                                   
            })                                                                  
                                                                                
# 2. Fit dynamics                                                               
dynamics = {}                                                                   
for i in range(1, 4):                                                           
    a_inc, b_inc = fit_linear(all_x_inc[i], all_dx_inc[i])                      
    a_dec, b_dec = fit_linear(all_x_dec[i], all_dx_dec[i])                      
    dynamics[f'x{i}_inc'] = (a_inc, b_inc)                                      
    dynamics[f'x{i}_dec'] = (a_dec, b_dec)                                      
                                                                                
print("Dynamics (a, b):", dynamics)                                             
                                                                                
# 3. Switching thresholds                                                       
# Lower thresholds: when heating starts (transition from 4 to 1, 2, or 3)       
# Upper thresholds: when heating stops (transition from 1, 2, or 3 to 4)        
lower_thresholds = {1: [], 2: [], 3: []}                                        
upper_thresholds = {1: [], 2: [], 3: []}                                        
                                                                                
for trans in all_transitions:                                                   
    f, t_mode, val = trans['from'], trans['to'], trans['x']                     
    if f == 4 and t_mode in [1, 2, 3]:                                          
        lower_thresholds[t_mode].append(val[t_mode-1])                          
    elif f in [1, 2, 3] and t_mode == 4:                                        
        upper_thresholds[f].append(val[f-1])                                    
                                                                                
print("Lower Thresholds (mean):", {k: np.mean(v) for k, v in                    
lower_thresholds.items() if v})                                                 
print("Upper Thresholds (mean):", {k: np.mean(v) for k, v in                    
upper_thresholds.items() if v})                                                 
                                                                                
# 4. Mode transitions sequence                                                  
# Check the sequence in the first sample                                        
seq = all_sequences[0]                                                          
change_indices = np.where(seq[:-1] != seq[1:])[0]                               
compact_seq = [seq[0]] + [seq[i+1] for i in change_indices if seq[i+1] != 0]    
print("Compact sequence example:", compact_seq[:15])                            
                                                                                
