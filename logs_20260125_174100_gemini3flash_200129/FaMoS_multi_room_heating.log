import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/multi_room_heating/sample_0.npz')                
state = data['state']                                                           
x1, x2, x3 = state                                                              
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
dx3 = np.diff(x3)                                                               
                                                                                
X = [x1[:-1], x2[:-1], x3[:-1]]                                                 
DX = [dx1, dx2, dx3]                                                            
                                                                                
def get_mode(d1, d2, d3):                                                       
    if d1 > 0: return 1                                                         
    if d2 > 0: return 2                                                         
    if d3 > 0: return 3                                                         
    return 0                                                                    
                                                                                
modes = np.array([get_mode(d1, d2, d3) for d1, d2, d3 in zip(dx1, dx2, dx3)])   
                                                                                
results = {}                                                                    
for m in range(4):                                                              
    mask = (modes == m)                                                         
    if np.sum(mask) < 2: continue                                               
    results[m] = {}                                                             
    for i in range(3):                                                          
        xi = X[i][mask]                                                         
        dxi = DX[i][mask]                                                       
        p = np.polyfit(xi, dxi, 1)                                              
        k = -p[0]                                                               
        C = p[1]                                                                
        # Correlation coefficient                                               
        corr = np.corrcoef(xi, dxi)[0, 1]                                       
        results[m][i] = {'k': k, 'C': C, 'r': corr}                             
                                                                                
for m in results:                                                               
    print(f"Mode {m}:")                                                         
    for i in range(3):                                                          
        print(f"  Room {i+1}: k={results[m][i]['k']:.6f},                       
C={results[m][i]['C']:.6f}, r={results[m][i]['r']:.6f}")                        
                                                                                
# Transition analysis                                                           
transitions = np.where(modes[1:] != modes[:-1])[0]                              
print("\nTransitions detected at indices:", transitions[:10])                   
                                                                                
for idx in transitions[:10]:                                                    
    m_prev = modes[idx]                                                         
    m_next = modes[idx+1]                                                       
    print(f"Transition at {idx}: Mode {m_prev} -> Mode {m_next}")               
    print(f"  x1={x1[idx+1]:.4f}, x2={x2[idx+1]:.4f}, x3={x3[idx+1]:.4f}")      
                                                                                
