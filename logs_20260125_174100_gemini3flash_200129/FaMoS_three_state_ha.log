import numpy as np                                                              
                                                                                
# Load and analyze samples to confirm values                                    
def analyze_data():                                                             
    results = []                                                                
    for i in range(3):                                                          
        data = np.load(DATA_FILE_PATHS[i])                                      
        x = data['state'][0]                                                    
        v = np.diff(x)                                                          
        a = np.diff(v)                                                          
                                                                                
        # Simple switch detection based on absolute jumps in                    
acceleration/velocity                                                           
        da = np.abs(np.diff(a))                                                 
