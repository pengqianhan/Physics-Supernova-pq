  # Transitions: 1->2 (x1 >= 15), 2->3 (x1 >= 25), 3->1 (x1 <= 20 and velocity  
  < 0)                                                                          
  modes = np.zeros(len(x1), dtype=int)                                          
  current_mode = 1                                                              
                                                                                
  for i in range(len(x1)):                                                      
      if current_mode == 1:                                                     
          if x1[i] >= 15:                                                       
              current_mode = 2                                                  
      elif current_mode == 2:                                                   
          if x1[i] >= 25:                                                       
              current_mode = 3                                                  
      elif current_mode == 3:                                                   
          # Check condition x1 <= 20 and x1[1] < 0?                             
          # Usually, x1[1] in guard means derivative. In discrete: x1[i] -      
  x1[i-1] < 0                                                                   
          if i > 0 and x1[i] <= 20 and (x1[i] - x1[i-1] < 0):                   
