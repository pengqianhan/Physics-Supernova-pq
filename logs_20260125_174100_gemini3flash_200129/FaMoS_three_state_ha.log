import numpy as np                                                              
                                                                                
def compute_derivatives(x, dt):                                                 
    # x is (1, 10001)                                                           
    x1 = x[0, :]                                                                
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
    return x1, x1_dot, x1_ddot                                                  
                                                                                
def fit_linear_model(x1, x1_dot, x1_ddot):                                      
    # Model: x1_ddot = a*x1_dot + b*x1 + c                                      
    # A * [a, b, c]^T = y                                                       
    A = np.column_stack([x1_dot, x1, np.ones(len(x1))])                         
    y = x1_ddot                                                                 
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    return coeffs                                                               
                                                                                
