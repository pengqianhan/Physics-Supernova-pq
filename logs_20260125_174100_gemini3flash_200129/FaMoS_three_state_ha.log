    idx_valley = np.argmin(s[idx_peak:]) + idx_peak                             
                                                                                
    # Rising: 0 to idx_peak                                                     
    if idx_peak > 2:                                                            
        seg = s[:idx_peak+1]                                                    
        rising_data_x.append(seg[1:-1])                                         
        rising_data_dx.append((seg[2:] - seg[:-2]) / (2*dt))                    
        rising_data_d2x.append((seg[2:] - 2*seg[1:-1] + seg[:-2]) / (dt**2))    
                                                                                
    # Falling: idx_peak to idx_valley                                           
    if idx_valley > idx_peak + 2:                                               
        seg = s[idx_peak:idx_valley+1]                                          
        falling_data_x.append(seg[1:-1])                                        
        falling_data_dx.append((seg[2:] - seg[:-2]) / (2*dt))                   
        falling_data_d2x.append((seg[2:] - 2*seg[1:-1] + seg[:-2]) / (dt**2))   
                                                                                
    # Recovery: idx_valley to end                                               
    if len(s) > idx_valley + 2:                                                 
        seg = s[idx_valley:]                                                    
        recovery_data_x.append(seg[1:-1])                                       
        recovery_data_dx.append((seg[2:] - seg[:-2]) / (2*dt))                  
        recovery_data_d2x.append((seg[2:] - 2*seg[1:-1] + seg[:-2]) / (dt**2))  
                                                                                
def solve_for_coeffs(list_x, list_dx, list_d2x):                                
    if not list_x: return None                                                  
    X = np.concatenate(list_x)                                                  
    DX = np.concatenate(list_dx)                                                
    D2X = np.concatenate(list_d2x)                                              
    A = np.column_stack([DX, X, np.ones_like(X)])                               
    params, _, _, _ = np.linalg.lstsq(A, D2X, rcond=None)                       
    return params                                                               
                                                                                
coeffs_rising = solve_for_coeffs(rising_data_x, rising_data_dx, rising_data_d2x)
coeffs_falling = solve_for_coeffs(falling_data_x, falling_data_dx,              
falling_data_d2x)                                                               
coeffs_recovery = solve_for_coeffs(recovery_data_x, recovery_data_dx,           
recovery_data_d2x)                                                              
                                                                                
print("Coeffs Rising (a, b, c):", coeffs_rising)                                
print("Coeffs Falling (a, b, c):", coeffs_falling)                              
print("Coeffs Recovery (a, b, c):", coeffs_recovery)                            
                                                                                
