data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
x = data['state'][0]                                                            
dt = 0.01                                                                       
v = np.diff(x) / dt                                                             
acc = np.diff(v) / dt                                                           
                                                                                
# Use the segments identified previously                                        
idx1, idx2 = 1500, 3950                                                         
                                                                                
def get_ode_coeffs(x_arr, v_arr, a_arr, start, end):                            
    # Fit a_arr = a*v_arr + b*x_arr + c                                         
    A = np.column_stack([v_arr[start:end], x_arr[start:end],                    
np.ones(end-start)])                                                            
    coeffs, _, _, _ = np.linalg.lstsq(A, a_arr[start:end], rcond=None)          
    return coeffs                                                               
                                                                                
