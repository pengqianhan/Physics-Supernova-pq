import numpy as np                                                              
                                                                                
def compute_derivatives(x, dt=0.01):                                            
    # x is (N,)                                                                 
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return x, v, a                                                              
                                                                                
files = ['data_all/FaMoS/three_state_ha/sample_0.npz',                          
'data_all/FaMoS/three_state_ha/sample_1.npz',                                   
'data_all/FaMoS/three_state_ha/sample_2.npz']                                   
                                                                                
all_x = []                                                                      
all_v = []                                                                      
all_a = []                                                                      
                                                                                
for f in files:                                                                 
    data = np.load(f)                                                           
