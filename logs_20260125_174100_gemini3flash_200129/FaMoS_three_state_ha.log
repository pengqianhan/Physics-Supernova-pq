import numpy as np                                                              
                                                                                
def estimate_coefficients(x, window_size=200, step=50):                         
    dx = np.diff(x)                                                             
    d2x = np.diff(dx)                                                           
                                                                                
    n = len(d2x)                                                                
    coeffs = []                                                                 
    times = []                                                                  
                                                                                
    for i in range(0, n - window_size, step):                                   
        X = np.column_stack([dx[i:i+window_size], x[i:i+window_size],           
np.ones(window_size)])                                                          
        y = d2x[i:i+window_size]                                                
                                                                                
        # Solve least squares                                                   
        try:                                                                    
            sol, resid, rank, s = np.linalg.lstsq(X, y, rcond=None)             
            coeffs.append(sol)                                                  
            times.append(i + window_size // 2)                                  
        except:                                                                 
            pass                                                                
                                                                                
    return np.array(times), np.array(coeffs)                                    
                                                                                
