import numpy as np                                                              
                                                                                
# Load the primary data file                                                    
data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
state = data['state']                                                           
t = np.linspace(0, 10, 10001)                                                   
dt = t[1] - t[0]                                                                
                                                                                
# x1 is state[0]                                                                
x1_pos = state[0]                                                               
                                                                                
# Compute derivatives                                                           
x1_vel = np.gradient(x1_pos, dt)                                                
x1_acc = np.gradient(x1_vel, dt)                                                
                                                                                
def fit_segment(t_start, t_end):                                                
    mask = (t >= t_start) & (t <= t_end)                                        
    y = x1_acc[mask]                                                            
    # Matrix A: [x1_vel, x1_pos, 1]                                             
