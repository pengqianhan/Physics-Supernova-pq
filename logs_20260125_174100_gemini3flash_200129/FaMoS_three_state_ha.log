    y = x1_ddot[i-window_size:i+window_size]                                    
    X = np.column_stack([x1_dot[i-window_size:i+window_size],                   
x1[i-window_size:i+window_size]])                                               
    reg = LinearRegression().fit(X, y)                                          
    res = np.mean((y - reg.predict(X))**2)                                      
    residuals.append(res)                                                       
                                                                                
# Peaks in residuals indicate transitions                                       
residuals = np.array(residuals)                                                 
threshold = np.mean(residuals) * 5                                              
transition_indices = np.where(residuals > threshold)[0] + window_size           
                                                                                
# Group close indices into single transition points                             
if len(transition_indices) > 0:                                                 
    cleaned_transitions = [transition_indices[0]]                               
    for t in transition_indices[1:]:                                            
