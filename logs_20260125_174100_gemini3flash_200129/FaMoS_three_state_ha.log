Thought: I will load the provided NPZ files to extract the state trajectories   
for $x1$, then calculate its first and second derivatives ($x1^{(1)}$ and       
$x1^{(2)}$) using a time step $dt=0.001$. I will identify switching points by   
detecting discontinuities in the acceleration ($x1^{(2)}$) and segment the data 
into discrete modes. For each mode, I will use linear regression to find the    
coefficients $a, b, c$ for the system equation $x1^{(2)} = a \cdot x1^{(1)} + b 
\cdot x1^{(0)} + c$. Finally, I will determine the transition conditions        
(guards) between these modes and compile the equations and guards into a        
detailed report.                                                                
                                                                                
<code>                                                                          
import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the first NPZ file to see structure                                      
data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
print("Keys in npz:", list(data.keys()))                                        
x1 = data['x1']                                                                 
print("x1 shape:", x1.shape)                                                    
                                                                                
dt = 0.001                                                                      
# Calculate derivatives                                                         
# x1[1] is velocity, x1[2] is acceleration                                      
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Identify switching points by jumps in acceleration                            
# Using a threshold for the absolute difference                                 
diff_ddot = np.abs(np.diff(x1_ddot))                                            
threshold = np.percentile(diff_ddot, 99.5) # Look for top outliers              
switches = np.where(diff_ddot > threshold)[0]                                   
                                                                                
# Consolidate switches that are too close                                       
refined_switches = []                                                           
if len(switches) > 0:                                                           
    refined_switches.append(switches[0])                                        
    for s in switches[1:]:                                                      
        if s - refined_switches[-1] > 50: # Avoid multiple detections of same   
jump                                                                            
            refined_switches.append(s)                                          
                                                                                
print("Detected switches at indices:", refined_switches)                        
                                                                                
# Define segments                                                               
indices = [0] + [s + 1 for s in refined_switches] + [len(x1)]                   
segments = []                                                                   
for i in range(len(indices)-1):                                                 
    start, end = indices[i], indices[i+1]                                       
    # Trim a bit to avoid transition noise                                      
    if end - start > 100:                                                       
        segments.append((start + 10, end - 10))                                 
                                                                                
# Fit models for each segment                                                   
models = []                                                                     
for start, end in segments:                                                     
    X = np.column_stack((x1_dot[start:end], x1[start:end]))                     
    y = x1_ddot[start:end]                                                      
    reg = LinearRegression().fit(X, y)                                          
    a, b = reg.coef_                                                            
    c = reg.intercept_                                                          
    models.append({'a': a, 'b': b, 'c': c, 'start_val': x1[start], 'end_val':   
x1[end-1]})                                                                     
    print(f"Segment {start}-{end}: a={a:.4f}, b={b:.4f}, c={c:.4f}")            
                                                                                
# Guard identification: look at x1 value at transitions                         
guards = []                                                                     
for i in range(len(refined_switches)):                                          
    idx = refined_switches[i]                                                   
    guards.append(f"Transition {i}->{i+1} at x1 ≈ {x1[idx]:.4f}")               
                                                                                
print("Guards:", guards)                                                        
                                                                                
