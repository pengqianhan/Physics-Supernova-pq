def refine_transitions(changes, min_dist=100):                                  
    if not changes: return []                                                   
    refined = [changes[0]]                                                      
    for c in changes[1:]:                                                       
        if c - refined[-1] > min_dist:                                          
            refined.append(c)                                                   
    return refined                                                              
                                                                                
transitions = refine_transitions(changes)                                       
print(f"Refined transitions for sample 0: {transitions}")                       
                                                                                
