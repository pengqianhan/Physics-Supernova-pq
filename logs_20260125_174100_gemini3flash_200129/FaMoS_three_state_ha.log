            seg_ddx = ddx[start:end]                                            
                                                                                
            # Linear regression: ddx = a*dx + b*x + c                           
            # We'll use a simple matrix inversion (Least Squares)               
            A = np.stack([seg_dx, seg_x, np.ones_like(seg_x)], axis=1)          
