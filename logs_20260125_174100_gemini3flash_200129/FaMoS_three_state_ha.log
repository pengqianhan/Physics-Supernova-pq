<code>                                                                          
import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
state = data['state']                                                           
x1 = state[0]                                                                   
dt = 0.001                                                                      
t = np.arange(len(x1)) * dt                                                     
                                                                                
# Higher precision derivatives                                                  
v = np.gradient(x1, dt)                                                         
acc = np.gradient(v, dt)                                                        
                                                                                
# Let's find where acc jumps. We look at the derivative of acc.                 
jerk = np.gradient(acc, dt)                                                     
                                                                                
# Find peaks in jerk to identify transitions                                    
threshold_jerk = np.max(np.abs(jerk)) * 0.1                                     
transitions = np.where(np.abs(jerk) > threshold_jerk)[0]                        
                                                                                
# Group consecutive transition indices                                          
if len(transitions) > 0:                                                        
    diffs = np.diff(transitions)                                                
    split_indices = np.where(diffs > 10)[0] + 1                                 
    transition_groups = np.split(transitions, split_indices)                    
    transition_points = [int(np.mean(g)) for g in transition_groups]            
    print(f"Transition indices: {transition_points}")                           
    print(f"Transition times: {[t[i] for i in transition_points]}")             
    print(f"x1 at transitions: {[x1[i] for i in transition_points]}")           
else:                                                                           
    print("No transitions detected.")                                           
                                                                                
# Just to be sure, let's plot everything                                        
fig, axs = plt.subplots(4, 1, figsize=(10, 12))                                 
axs[0].plot(t, x1)                                                              
axs[0].set_ylabel('x1')                                                         
axs[1].plot(t, v)                                                               
axs[1].set_ylabel('v')                                                          
axs[2].plot(t, acc)                                                             
axs[2].set_ylabel('acc')                                                        
axs[3].plot(t, jerk)                                                            
axs[3].set_ylabel('jerk')                                                       
plt.savefig('transitions_plot.png')                                             
                                                                                
