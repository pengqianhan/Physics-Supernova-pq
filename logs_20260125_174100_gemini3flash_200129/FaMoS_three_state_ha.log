def get_mode(a, b, c):                                                          
    if np.allclose([a, b, c], [-0.5, 0.5, 0], atol=0.1):                        
        return 'A'                                                              
    if np.allclose([a, b, c], [-0.5, -0.5, 0], atol=0.1):                       
        return 'B'                                                              
    if np.allclose([a, b, c], [0, -0.5, 0], atol=0.1):                          
        return 'C'                                                              
    return 'Unknown'                                                            
                                                                                
# Refine analysis to find exact transition points                               
