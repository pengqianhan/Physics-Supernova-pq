import numpy as np                                                              
                                                                                
def get_coeffs_clean(s, start, end):                                            
    seg = s[start:end]                                                          
    dt = 0.001                                                                  
    x = seg[1:-1]                                                               
    dx = (seg[2:] - seg[:-2]) / (2*dt)                                          
    d2x = (seg[2:] - 2*seg[1:-1] + seg[:-2]) / (dt**2)                          
    A = np.column_stack([dx, x, np.ones_like(x)])                               
    params, _, _, _ = np.linalg.lstsq(A, d2x, rcond=None)                       
    return params                                                               
                                                                                
data0 = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')['state'][0]       
print("Sample 0 Falling (3000-5000):", get_coeffs_clean(data0, 3000, 5000))     
print("Sample 0 Falling (6000-8000):", get_coeffs_clean(data0, 6000, 8000))     
                                                                                
data1 = np.load('data_all/FaMoS/three_state_ha/sample_1.npz')['state'][0]       
print("Sample 1 Falling (4000-6000):", get_coeffs_clean(data1, 4000, 6000))     
                                                                                
