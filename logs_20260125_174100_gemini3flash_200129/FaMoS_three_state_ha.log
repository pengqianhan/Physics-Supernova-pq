import numpy as np                                                              
                                                                                
def check_segment(sample_idx, x_threshold):                                     
    data = np.load(f'data_all/FaMoS/three_state_ha/sample_{sample_idx}.npz')    
    s = data['state'][0]                                                        
    idx_peak = np.argmax(s)                                                     
                                                                                
    # Let's find where s drops below x_threshold after the peak                 
    below_thresh = np.where((s < x_threshold) & (np.arange(len(s)) >            
idx_peak))[0]                                                                   
    if len(below_thresh) > 0:                                                   
        idx_switch = below_thresh[0]                                            
        print(f"Sample {sample_idx} passes {x_threshold} at index {idx_switch}")
        # Fit before and after                                                  
        seg1 = s[idx_peak:idx_switch]                                           
        seg2 = s[idx_switch:]                                                   
        return seg1, seg2                                                       
    else:                                                                       
        print(f"Sample {sample_idx} never passes {x_threshold}")                
        return s[idx_peak:], None                                               
                                                                                
for i in range(3):                                                              
