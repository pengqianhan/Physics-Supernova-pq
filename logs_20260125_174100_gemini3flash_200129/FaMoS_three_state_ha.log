print("Stats for dx1:", full_df['dx1'].describe())                              
                                                                                
# Identifying modes based on dx1 and x1 behavior                                
# Segment 1: dx1 > 0 (Rising)                                                   
# Segment 2: dx1 < 0 (Falling)                                                  
# Segment 3: dx1 ~ 0 (Steady state / Recovery)                                  
                                                                                
# Let's refine based on typical "three state" models (e.g., Rising, Falling,    
Steady)                                                                         
def classify_mode(row):                                                         
    if row['dx1'] > 0.5:                                                        
        return 1 # Rising                                                       
    elif row['dx1'] < -0.5:                                                     
        return 2 # Falling                                                      
    else:                                                                       
        return 3 # Recovery / Baseline                                          
                                                                                
full_df['mode'] = full_df.apply(classify_mode, axis=1)                          
                                                                                
results = {}                                                                    
for m in [1, 2, 3]:                                                             
    subset = full_df[full_df['mode'] == m]                                      
    if len(subset) > 10:                                                        
        X = subset[['dx1', 'x1']].values                                        
        X = np.hstack([X, np.ones((X.shape[0], 1))])                            
        y = subset['d2x1'].values                                               
                                                                                
        # Linear regression: d2x1 = a*dx1 + b*x1 + c                            
        # Solve (X^T X) beta = X^T y                                            
        beta = np.linalg.lstsq(X, y, rcond=None)[0]                             
        results[m] = {                                                          
            'a': beta[0],                                                       
            'b': beta[1],                                                       
            'c': beta[2],                                                       
            'count': len(subset),                                               
            'x1_min': subset['x1'].min(),                                       
            'x1_max': subset['x1'].max(),                                       
            'dx1_min': subset['dx1'].min(),                                     
            'dx1_max': subset['dx1'].max()                                      
        }                                                                       
                                                                                
print(results)                                                                  
                                                                                
