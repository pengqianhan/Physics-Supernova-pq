  # Using differences in the second derivative                                  
  jumps = np.abs(np.diff(x1_ddot))                                              
  # Ignore boundaries (first 10 and last 10 points)                             
  jumps[:10] = 0                                                                
  jumps[-10:] = 0                                                               
                                                                                
  # Find the two most significant jumps that are not too close to each other    
  sorted_indices = np.argsort(jumps)[::-1]                                      
  switches = []                                                                 
  for idx in sorted_indices:                                                    
      if all(abs(idx - s) > 500 for s in switches):                             
          switches.append(idx)                                                  
      if len(switches) == 2:                                                    
          break                                                                 
  switches.sort()                                                               
                                                                                
  # Define the 3 modes based on the 2 switches                                  
  segments = [(0, switches[0]), (switches[0], switches[1]), (switches[1],       
