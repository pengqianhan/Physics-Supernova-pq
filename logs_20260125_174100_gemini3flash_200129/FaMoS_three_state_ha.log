        A = np.column_stack([seg_v, seg_x, np.ones_like(seg_x)])                
        coeffs, _, _, _ = np.linalg.lstsq(A, seg_a, rcond=None)                 
                                                                                
        all_modes.append({                                                      
            'sample': i,                                                        
            'start_idx': start, 'end_idx': end,                                 
            'x_range': (x_full[start], x_full[end-1]),                          
            'v_avg': np.mean(seg_v),                                            
            'coeffs': coeffs                                                    
        })                                                                      
                                                                                
