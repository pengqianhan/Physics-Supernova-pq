# Load all three files                                                          
data_files = ['data_all/FaMoS/three_state_ha/sample_0.npz',                     
              'data_all/FaMoS/three_state_ha/sample_1.npz',                     
              'data_all/FaMoS/three_state_ha/sample_2.npz']                     
                                                                                
dt = 0.01                                                                       
all_x = []                                                                      
all_v = []                                                                      
all_a = []                                                                      
                                                                                
for file in data_files:                                                         
    data = np.load(file)                                                        
    x = data['state'][0]                                                        
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    all_x.append(x)                                                             
    all_v.append(v)                                                             
    all_a.append(a)                                                             
                                                                                
x_full = np.concatenate(all_x)                                                  
v_full = np.concatenate(all_v)                                                  
a_full = np.concatenate(all_a)                                                  
                                                                                
def fit_ode(x, v, a):                                                           
    A = np.column_stack([v, x, np.ones_like(x)])                                
    coeffs, _, _, _ = np.linalg.lstsq(A, a, rcond=None)                         
    return coeffs                                                               
                                                                                
# Thresholds identified through search                                          
t1, t2 = 0.5, 3.5                                                               
                                                                                
m1 = x_full < t1                                                                
m2 = (x_full >= t1) & (x_full < t2)                                             
m3 = x_full >= t2                                                               
                                                                                
c1 = fit_ode(x_full[m1], v_full[m1], a_full[m1])                                
c2 = fit_ode(x_full[m2], v_full[m2], a_full[m2])                                
c3 = fit_ode(x_full[m3], v_full[m3], a_full[m3])                                
                                                                                
# Format for final output                                                       
final_answer({                                                                  
    "### 1. Task outcome (short version):": (                                   
        "The state trajectory for 'x1' belongs to a three-state hybrid system   
with recurring linear 2nd-order modes. "                                        
        "The dynamics follow the form x1[2] = a*x1[1] + b*x1[0] + c (where [2], 
[1], [0] denote derivatives). "                                                 
        "The system switches between modes based on state thresholds at x1 ≈ 0.5
and x1 ≈ 3.5. "                                                                 
        "No state resets occur during transitions."                             
    ),                                                                          
    "### 2. Task outcome (extremely detailed version):": (                      
        f"1. **Mode Regions and Identifiers:**\n"                               
        f"   - **Mode 1 (Lower Region):** Active for x1 < {t1}. Spend           
significantly recurring time here during oscillations.\n"                       
        f"   - **Mode 2 (Central Region):** Active for {t1} <= x1 < {t2}. This  
is the 'linear' or low-force operating range.\n"                                
        f"   - **Mode 3 (Upper Region):** Active for x1 >= {t2}. The system     
spends the majority of its time here or returning from here.\n\n"               
        f"2. **Estimated Coefficients (a, b, c):**\n"                           
        f"   The model x1[2] = a*x1[1] + b*x1[0] + c yields:\n"                 
        f"   - **Mode 1:** a ≈ {c1[0]:.2f}, b ≈ {c1[1]:.2f}, c ≈ {c1[2]:.2f}\n" 
        f"   - **Mode 2:** a ≈ {c2[0]:.2f}, b ≈ {c2[1]:.2f}, c ≈ {c2[2]:.4f}\n" 
        f"   - **Mode 3:** a ≈ {c3[0]:.2f}, b ≈ {c3[1]:.2f}, c ≈                
