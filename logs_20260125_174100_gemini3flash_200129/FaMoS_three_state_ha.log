  import numpy as np                                                            
                                                                                
  # Load the data from all samples                                              
  all_trajectories = []                                                         
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      # x1 is the first row of the state matrix                                 
      all_trajectories.append(data['state'][0, :])                              
                                                                                
  def fit_mode(x_list, t1, t2, mode_idx):                                       
      A_list = []                                                               
      B_list = []                                                               
                                                                                
      for x in x_list:                                                          
          # Define modes for each point                                         
          modes = np.zeros(len(x), dtype=int)                                   
          modes[x <= t1] = 0                                                    
          modes[(x > t1) & (x <= t2)] = 1                                       
          modes[x > t2] = 2                                                     
                                                                                
          for i in range(len(x) - 2):                                           
              if modes[i] == mode_idx and modes[i+1] == mode_idx and            
  modes[i+2] == mode_idx:                                                       
                  A_list.append([x[i+1], x[i], 1.0])                            
                  B_list.append(x[i+2])                                         
                                                                                
      if not A_list:                                                            
          return None                                                           
                                                                                
      A = np.array(A_list)                                                      
      B = np.array(B_list)                                                      
      coeffs, _, _, _ = np.linalg.lstsq(A, B, rcond=None)                       
                                                                                
      # Calculate R-squared using np.dot                                        
      predictions = np.dot(A, coeffs)                                           
      ss_res = np.sum((B - predictions)**2)                                     
      ss_tot = np.sum((B - np.mean(B))**2)                                      
      r2 = 1 - (ss_res / ss_tot) if ss_tot > 0 else 1.0                         
                                                                                
      return coeffs, r2                                                         
                                                                                
  # Thresholds as suggested                                                     
  t1, t2 = 9.0, 25.0                                                            
                                                                                
