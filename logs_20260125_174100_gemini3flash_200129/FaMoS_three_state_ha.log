import numpy as np                                                              
                                                                                
def get_coeffs(x, v, a, start, end):                                            
    A = np.column_stack([v[start:end], x[start:end], np.ones(end-start)])       
    coeffs, _, _, _ = np.linalg.lstsq(A, a[start:end], rcond=None)              
    return coeffs                                                               
                                                                                
def find_best_splits(x, v, a):                                                  
    N = len(a)                                                                  
    best_mse = float('inf')                                                     
    best_i, best_j = 0, 0                                                       
    # Search every 50 points to be efficient                                    
    for i in range(100, N-200, 50):                                             
        for j in range(i+100, N-100, 50):                                       
            # Fit three segments                                                
            A1 = np.column_stack([v[:i], x[:i], np.ones(i)])                    
            _, r1, _, _ = np.linalg.lstsq(A1, a[:i], rcond=None)                
                                                                                
            A2 = np.column_stack([v[i:j], x[i:j], np.ones(j-i)])                
            _, r2, _, _ = np.linalg.lstsq(A2, a[i:j], rcond=None)               
                                                                                
            A3 = np.column_stack([v[j:], x[j:], np.ones(N-j)])                  
            _, r3, _, _ = np.linalg.lstsq(A3, a[j:], rcond=None)                
                                                                                
            total_mse = (r1[0] if len(r1)>0 else 0) + (r2[0] if len(r2)>0 else  
0) + (r3[0] if len(r3)>0 else 0)                                                
            if total_mse < best_mse:                                            
                best_mse = total_mse                                            
                best_i, best_j = i, j                                           
    return best_i, best_j                                                       
                                                                                
results = []                                                                    
for i in range(3):                                                              
    data = np.load(f'data_all/FaMoS/three_state_ha/sample_{i}.npz')             
    x = data['state'][0]                                                        
    dt = 0.01                                                                   
    v = np.diff(x) / dt                                                         
    acc = np.diff(v) / dt                                                       
                                                                                
    # Trim to same length                                                       
    v_f = v[:-1]                                                                
    x_f = x[:-2]                                                                
    a_f = acc                                                                   
                                                                                
    i1, i2 = find_best_splits(x_f, v_f, a_f)                                    
    c1 = get_coeffs(x_f, v_f, a_f, 0, i1)                                       
    c2 = get_coeffs(x_f, v_f, a_f, i1, i2)                                      
    c3 = get_coeffs(x_f, v_f, a_f, i2, len(a_f))                                
                                                                                
    results.append({                                                            
        'sample': i,                                                            
        'splits': (i1, i2),                                                     
        'times': (i1*dt, i2*dt),                                                
        'states_at_t1': (x[i1], v[i1]),                                         
        'states_at_t2': (x[i2], v[i2]),                                         
        'coeffs': (c1, c2, c3)                                                  
    })                                                                          
                                                                                
for res in results:                                                             
