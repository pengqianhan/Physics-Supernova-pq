import numpy as np                                                              
import pandas as pd                                                             
from scipy.stats import linregress                                              
from sklearn.linear_model import LinearRegression                               
from sklearn.metrics import r2_score                                            
                                                                                
dt = 0.001                                                                      
all_x1 = []                                                                     
all_x1_dot = []                                                                 
all_x1_ddot = []                                                                
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # x1 is state[0, :]                                                         
    x1 = data['state'][0, :]                                                    
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    all_x1.append(x1)                                                           
    all_x1_dot.append(x1_dot)                                                   
    all_x1_ddot.append(x1_ddot)                                                 
                                                                                
# Combine data from all samples                                                 
X1 = np.concatenate(all_x1)                                                     
X1_dot = np.concatenate(all_x1_dot)                                             
X1_ddot = np.concatenate(all_x1_ddot)                                           
                                                                                
# Partition data                                                                
regions = {                                                                     
    'A': (X1 < 15),                                                             
    'B': (X1 >= 15) & (X1 < 25),                                                
    'C': (X1 >= 25)                                                             
}                                                                               
                                                                                
results = {}                                                                    
                                                                                
for name, mask in regions.items():                                              
    if np.any(mask):                                                            
        # Prepare features for linear regression: x1_dot, x1, and bias          
        features = np.stack([X1_dot[mask], X1[mask]], axis=1)                   
        target = X1_ddot[mask]                                                  
                                                                                
        model = LinearRegression()                                              
        model.fit(features, target)                                             
                                                                                
        c1, c0 = model.coef_                                                    
        bias = model.intercept_                                                 
        r2 = r2_score(target, model.predict(features))                          
                                                                                
        results[name] = {                                                       
            'c1': c1,                                                           
            'c0': c0,                                                           
            'bias': bias,                                                       
            'r2': r2,                                                           
            'count': np.sum(mask)                                               
        }                                                                       
                                                                                
print("Regression Results:")                                                    
for name, res in results.items():                                               
    print(f"Region {name}: c1={res['c1']:.4f}, c0={res['c0']:.4f},              
bias={res['bias']:.4f}, R2={res['r2']:.4f}, count={res['count']}")              
                                                                                
# Check for discontinuities/resets                                              
# We look for large jumps in x1_dot between consecutive points in a single      
sample                                                                          
max_jumps = []                                                                  
for x1_d in all_x1_dot:                                                         
    max_jumps.append(np.max(np.abs(np.diff(x1_d))))                             
print(f"Max jump in x1_dot: {max_index := np.max(max_jumps)}")                  
                                                                                
# Check transition triggers                                                     
# We can check if boundaries are crossed                                        
crossings = []                                                                  
for x1 in all_x1:                                                               
    crossed_15 = np.where(np.diff(np.sign(x1 - 15)))[0]                         
    crossed_25 = np.where(np.diff(np.sign(x1 - 25)))[0]                         
    crossings.append((len(crossed_15), len(crossed_25)))                        
print(f"Crossings (15, 25) per sample: {crossings}")                            
                                                                                
# Final Answer Construction                                                     
final_results = results                                                         
                                                                                
