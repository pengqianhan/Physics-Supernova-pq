# Sliding window regression                                                     
window_size = 200                                                               
step = 50                                                                       
results = []                                                                    
                                                                                
for i in range(0, len(x1) - window_size, step):                                 
    idx = slice(i, i + window_size)                                             
    # Solve x1_ddot = A * x1_dot + B * x1 + C                                   
    Y = x1_ddot[idx]                                                            
    X = np.column_stack([x1_dot[idx], x1[idx], np.ones(window_size)])           
    # Ordinary Least Squares                                                    
    coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    results.append({                                                            
        'start_idx': i,                                                         
        'end_idx': i + window_size,                                             
        'coeffs': coeffs,                                                       
        'residual': residuals[0] if len(residuals) > 0 else 0                   
    })                                                                          
                                                                                
