        if s_end - s_start < 20: continue                                       
        seg_x = x[s_start+5:s_end-5]                                            
        seg_v = v[s_start+5:s_end-5]                                            
        seg_a = a[s_start+5:s_end-5]                                            
        M = np.column_stack([seg_v, seg_x, np.ones(len(seg_a))])                
        coeffs, _, _, _ = np.linalg.lstsq(M, seg_a, rcond=None)                 
                                                                                
        # Determine transition condition at the end of segment                  
        if s_end < len(x):                                                      
