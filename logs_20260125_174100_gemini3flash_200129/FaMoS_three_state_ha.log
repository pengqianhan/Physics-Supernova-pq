import numpy as np                                                              
                                                                                
def solve():                                                                    
    # Load sample 0                                                             
    data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                
    x = data['state'][0]                                                        
    dt = 0.01  # Assuming dt based on 10001 points                              
                                                                                
    # Derivatives                                                               
    v = np.diff(x) / dt                                                         
    accel = np.diff(v) / dt                                                     
                                                                                
    # Matching lengths for ODE fit: accel[i] = a*v[i] + b*x[i] + c              
    x_fit = x[:-2]                                                              
    v_fit = v[:-1]                                                              
    a_fit = accel                                                               
                                                                                
    # Find segments: search for two split points i, j to minimize total MSE     
    # To speed up, search every 100 steps                                       
    best_i, best_j = 0, 0                                                       
    min_error = float('inf')                                                    
                                                                                
    N = len(a_fit)                                                              
                                                                                
    def get_mse(x_seg, v_seg, a_seg):                                           
        if len(x_seg) < 4: return 0                                             
        A = np.column_stack([v_seg, x_seg, np.ones_like(x_seg)])                
        coeffs, residuals, rank, s = np.linalg.lstsq(A, a_seg, rcond=None)      
        return residuals[0] if len(residuals) > 0 else 0                        
                                                                                
    # Coarse search                                                             
    for i in range(500, N-1000, 500):                                           
        for j in range(i+500, N-500, 500):                                      
            err = (get_mse(x_fit[:i], v_fit[:i], a_fit[:i]) +                   
                   get_mse(x_fit[i:j], v_fit[i:j], a_fit[i:j]) +                
                   get_mse(x_fit[j:], v_fit[j:], a_fit[j:]))                    
            if err < min_error:                                                 
                min_error = err                                                 
                best_i, best_j = i, j                                           
                                                                                
    # Fine search around best_i, best_j                                         
    fine_i, fine_j = best_i, best_j                                             
    for i in range(max(50, best_i-500), min(N-500, best_i+500), 50):            
        for j in range(max(i+500, best_j-500), min(N-50, best_j+500), 50):      
            err = (get_mse(x_fit[:i], v_fit[:i], a_fit[:i]) +                   
                   get_mse(x_fit[i:j], v_fit[i:j], a_fit[i:j]) +                
                   get_mse(x_fit[j:], v_fit[j:], a_fit[j:]))                    
            if err < min_error:                                                 
                min_error = err                                                 
                fine_i, fine_j = i, j                                           
                                                                                
    print(f"Detected split indices: {fine_i}, {fine_j}")                        
                                                                                
    # Final fits                                                                
    def get_coeffs(x_seg, v_seg, a_seg):                                        
        A = np.column_stack([v_seg, x_seg, np.ones_like(x_seg)])                
        coeffs, _, _, _ = np.linalg.lstsq(A, a_seg, rcond=None)                 
        return coeffs                                                           
                                                                                
    c1 = get_coeffs(x_fit[:fine_i], v_fit[:fine_i], a_fit[:fine_i])             
    c2 = get_coeffs(x_fit[fine_i:fine_j], v_fit[fine_i:fine_j],                 
a_fit[fine_i:fine_j])                                                           
    c3 = get_coeffs(x_fit[fine_j:], v_fit[fine_j:], a_fit[fine_j:])             
                                                                                
    print(f"Mode 1 coeffs: {c1}")                                               
    print(f"Mode 2 coeffs: {c2}")                                               
    print(f"Mode 3 coeffs: {c3}")                                               
                                                                                
    # Check for resets at transitions                                           
    # At index fine_i: compare x[fine_i] and v[fine_i] with prev/next           
    # If no jump in x or v, no reset.                                           
    print(f"State at transition 1: x={x[fine_i]}, v={v[fine_i]}")               
    print(f"State around transition 1: x_prev={x[fine_i-1]},                    
x_next={x[fine_i+1]}")                                                          
    print(f"State at transition 2: x={x[fine_j]}, v={v[fine_j]}")               
                                                                                
solve()                                                                         
                                                                                
