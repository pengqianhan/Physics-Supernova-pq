import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
dt = 0.001                                                                      
data_samples = []                                                               
                                                                                
for i in range(3):                                                              
    data = np.load(DATA_FILE_PATHS[i])                                          
    x1 = data['x'][:, 0]  # Assuming x1 is the first column                     
                                                                                
    # Numerical derivatives                                                     
    v = np.gradient(x1, dt)                                                     
    a = np.gradient(v, dt)                                                      
                                                                                
    data_samples.append({'x1': x1, 'v': v, 'a': a})                             
                                                                                
# Plotting to identify modes visually or via change points                      
plt.figure(figsize=(12, 8))                                                     
for i, d in enumerate(data_samples):                                            
    plt.subplot(3, 1, i+1)                                                      
    plt.plot(d['x1'], label='x1')                                               
    plt.plot(d['v'], label='v')                                                 
    plt.legend()                                                                
plt.savefig('trajectories.png')                                                 
                                                                                
# Identify modes using a clustering or thresholding approach on the             
acceleration/velocity relationship                                              
# Since we expect 3 modes, let's use a simple heuristic or manual inspection if 
necessary.                                                                      
# However, clustering (e.g., K-Means on features [x1, v, a]) might be more      
robust.                                                                         
from sklearn.cluster import KMeans                                              
                                                                                
all_x1 = np.concatenate([d['x1'] for d in data_samples])                        
all_v = np.concatenate([d['v'] for d in data_samples])                          
all_a = np.concatenate([d['a'] for d in data_samples])                          
                                                                                
features = np.stack([all_x1, all_v, all_a], axis=1)                             
# Standardize for clustering                                                    
features_std = (features - features.mean(axis=0)) / features.std(axis=0)        
kmeans = KMeans(n_clusters=3, random_state=42).fit(features_std)                
labels = kmeans.labels_                                                         
                                                                                
# Now fit the ODE for each mode                                                 
results = []                                                                    
for m in range(3):                                                              
    mask = labels == m                                                          
    X = np.stack([all_v[mask], all_x1[mask], np.ones(np.sum(mask))], axis=1)    
    y = all_a[mask]                                                             
    coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)              
    results.append({'mode': m, 'c1': coeffs[0], 'c0': coeffs[1], 'bias':        
coeffs[2]})                                                                     
                                                                                
# Identify transitions                                                          
transitions = []                                                                
idx = 0                                                                         
for d in data_samples:                                                          
    L = len(d['x1'])                                                            
    sample_labels = labels[idx:idx+L]                                           
    idx += L                                                                    
    for j in range(1, L):                                                       
        if sample_labels[j] != sample_labels[j-1]:                              
            transitions.append({                                                
                'from': sample_labels[j-1],                                     
                'to': sample_labels[j],                                         
                'x1': d['x1'][j],                                               
                'v': d['v'][j],                                                 
                'reset_x': d['x1'][j] - d['x1'][j-1],                           
                'reset_v': d['v'][j] - d['v'][j-1]                              
            })                                                                  
                                                                                
print("ODE Coefficients:", results)                                             
print("Transitions sample:", transitions[:5])                                   
                                                                                
