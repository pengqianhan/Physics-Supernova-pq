    for x in samples:                                                           
        v = (x[2:] - x[:-2]) / (2 * dt)                                         
        a = (x[2:] - 2*x[1:-1] + x[:-2]) / (dt**2)                              
        pos = x[1:-1]                                                           
                                                                                
        # Filter by range                                                       
        mask = (pos >= x_min) & (pos <= x_max)                                  
        all_v.extend(v[mask])                                                   
        all_pos.extend(pos[mask])                                               
        all_a.extend(a[mask])                                                   
                                                                                
    return np.array(all_v), np.array(all_pos), np.array(all_a)                  
                                                                                
