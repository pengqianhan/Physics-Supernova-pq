{m['coeffs'][1]:.4f}*x1 + {m['intercept']:.4f}")                                
    print(f"  Range: {m['range']}, x1 in [{m['x1_range'][0]:.4f},               
{m['x1_range'][1]:.4f}]")                                                       
                                                                                
# Identify guards                                                               
guards = []                                                                     
for i in range(len(cleaned_transitions)):                                       
