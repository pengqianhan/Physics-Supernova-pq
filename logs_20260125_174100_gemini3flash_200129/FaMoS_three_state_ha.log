      if len(jumps) > 0:                                                        
          cjumps.append(jumps[0])                                               
          for j in jumps[1:]:                                                   
              if j > cjumps[-1] + 10:                                           
                  cjumps.append(j)                                              
                                                                                
      indices = [0] + [j + 1 for j in cjumps] + [len(x1_2)]                     
                                                                                
      res = []                                                                  
      for start, end in zip(indices[:-1], indices[1:]):                         
          if end - start > 10:                                                  
              s, e = start + 2, end - 2                                         
              if e > s:                                                         
                  # Fit x1_2 = a*x1_1 + b*x1_0 + c                              
                  X = np.column_stack((x1_1[s:e], x1_0[s:e], np.ones(e-s)))     
                  coeffs, _, _, _ = np.linalg.lstsq(X, x1_2[s:e], rcond=None)   
                  res.append({                                                  
                      'start_idx': start,                                       
                      'end_idx': end,                                           
                      'coeffs': coeffs,                                         
                      'x0_start': x1_0[start],                                  
                      'x0_end': x1_0[end-1],                                    
                      'x1_start': x1_1[start],                                  
                      'x1_end': x1_1[end-1]                                     
                  })                                                            
      return res                                                                
                                                                                
  # Analyze all samples                                                         
  all_results = []                                                              
  for i in range(3):                                                            
      all_results.append(analyze_sample(f'data_all/FaMoS/three_state_ha/sample  
  _{i}.npz'))                                                                   
                                                                                
  for i, res in enumerate(all_results):                                         
      print(f"Sample {i}:")                                                     
      for j, r in enumerate(res):                                               
          c = r['coeffs']                                                       
          print(f"  Mode {j}: a={c[0]:.6f}, b={c[1]:.6f}, c={c[2]:.6f}")        
          print(f"    x0: {r['x0_start']:.2f} -> {r['x0_end']:.2f}, x1:         
  {r['x1_start']:.4f} -> {r['x1_end']:.4f}")                                    
