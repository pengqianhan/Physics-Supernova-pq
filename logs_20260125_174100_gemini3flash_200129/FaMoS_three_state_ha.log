<code>                                                                          
def get_derivatives_central(sample_path):                                       
    data = np.load(sample_path)                                                 
    s = data['state'][0]                                                        
    dt = 0.001                                                                  
    # Central difference for v: (s[i+1] - s[i-1]) / (2*dt)                      
    v = (s[2:] - s[:-2]) / (2 * dt)                                             
    # Central difference for a: (s[i+1] - 2*s[i] + s[i-1]) / (dt^2)             
    a = (s[2:] - 2 * s[1:-1] + s[:-2]) / (dt**2)                                
    # s should be s[1:-1]                                                       
    return s[1:-1], v, a                                                        
                                                                                
