import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
print(f"Keys in npz file: {list(data.keys())}")                                 
                                                                                
# Assuming 't' and 'x' are the keys based on common HA data structures          
t = data['t']                                                                   
x = data['x']                                                                   
# x1 is usually the first dimension of x                                        
x1 = x[:, 0]                                                                    
                                                                                
print(f"t shape: {t.shape}")                                                    
print(f"x1 shape: {x1.shape}")                                                  
                                                                                
# Function to compute derivatives and fit the model                             
def analyze_segment(t_seg, x1_seg):                                             
    dt = t_seg[1] - t_seg[0]                                                    
    # x1[1] = dx1/dt                                                            
    x1_dot = np.gradient(x1_seg, dt)                                            
    # x1[2] = d2x1/dt2                                                          
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    # Fit x1_ddot = a*x1_dot + b*x1 + c                                         
    # A * [a, b, c]^T = x1_ddot                                                 
    A = np.column_stack((x1_dot, x1_seg, np.ones_like(x1_seg)))                 
    coeffs, residuals, rank, s = np.linalg.lstsq(A, x1_ddot, rcond=None)        
    return coeffs                                                               
                                                                                
# Define segments                                                               
seg1_mask = (t >= 0) & (t <= 1.5)                                               
seg2_mask = (t > 1.5) & (t <= 4.5)                                              
seg3_mask = (t > 4.5) & (t <= 10)                                               
                                                                                
coeffs1 = analyze_segment(t[seg1_mask], x1[seg1_mask])                          
coeffs2 = analyze_segment(t[seg2_mask], x1[seg2_mask])                          
coeffs3 = analyze_segment(t[seg3_mask], x1[seg3_mask])                          
                                                                                
# Guard conditions (x1 at transitions)                                          
# Find the value of x1 closest to 1.5 and 4.5                                   
idx15 = np.argmin(np.abs(t - 1.5))                                              
idx45 = np.argmin(np.abs(t - 4.5))                                              
val15 = x1[idx15]                                                               
val45 = x1[idx45]                                                               
                                                                                
print(f"Mode 1 coeffs (a, b, c): {coeffs1}")                                    
print(f"Mode 2 coeffs (a, b, c): {coeffs2}")                                    
print(f"Mode 3 coeffs (a, b, c): {coeffs3}")                                    
print(f"Guard x1 at t=1.5: {val15}")                                            
print(f"Guard x1 at t=4.5: {val45}")                                            
                                                                                
                                                                                
