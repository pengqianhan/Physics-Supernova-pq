# Prepare features for the ODE: x[k+2] = a*x[k+1] + b*x[k] + c                  
# We'll use a sliding window to get local coefficients                          
def get_local_coeffs(x, window_size=10):                                        
    n = len(x)                                                                  
    coeffs = []                                                                 
    for i in range(n - window_size - 2):                                        
        X = []                                                                  
        Y = []                                                                  
        for j in range(i, i + window_size):                                     
            X.append([x[j+1], x[j], 1.0])                                       
            Y.append(x[j+2])                                                    
        c, resid, rank, s = np.linalg.lstsq(X, Y, rcond=None)                   
        coeffs.append(c)                                                        
    return np.array(coeffs)                                                     
                                                                                
