<code>                                                                          
import numpy as np                                                              
import pandas as pd                                                             
from scipy.signal import medfilt                                                
                                                                                
# Load the first sample                                                         
data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
print("Keys in npz:", data.files)                                               
                                                                                
# Extract x1 and time                                                           
# Assuming 'x' might be the state and 't' the time, or 'x1' is a specific key   
if 'x1' in data:                                                                
    x1_data = data['x1']                                                        
elif 'x' in data:                                                               
    x1_data = data['x']                                                         
else:                                                                           
    # Fallback to first available key that looks like data                      
    x1_data = data[data.files[0]]                                               
                                                                                
# Inspect shape                                                                 
print("x1 shape:", x1_data.shape)                                               
                                                                                
# Assuming x1 contains [position, velocity, acceleration] or we need to compute 
them                                                                            
# If it's (N, 3), it's likely [x, dx, ddx]                                      
# If it's (N,), we need to compute derivatives.                                 
# Let's assume the columns are x, dx, ddx if shape is (N, 3) based on the ODE   
format.                                                                         
                                                                                
if x1_data.ndim == 2 and x1_data.shape[1] >= 3:                                 
    pos = x1_data[:, 0]                                                         
    vel = x1_data[:, 1]                                                         
    acc = x1_data[:, 2]                                                         
    time = np.arange(len(pos)) # Default time if not provided                   
else:                                                                           
    # Handle (N,) or (N, 1) or (N, 2)                                           
    pos = x1_data.flatten()                                                     
    dt = 1.0 # Assumption, will refine if 't' exists                            
    if 't' in data:                                                             
        t_arr = data['t'].flatten()                                             
        dt = t_arr[1] - t_arr[0]                                                
        time = t_arr                                                            
    else:                                                                       
        time = np.arange(len(pos))                                              
                                                                                
    vel = np.gradient(pos, dt)                                                  
    acc = np.gradient(vel, dt)                                                  
                                                                                
# Identify switching times by looking at discontinuities in acceleration        
# We look for large jumps in ddx                                                
acc_diff = np.abs(np.diff(acc))                                                 
# Thresholding to find peaks (switching points)                                 
# Using a simple percentile-based threshold or local max                        
threshold = np.percentile(acc_diff, 99)                                         
switch_indices = np.where(acc_diff > threshold)[0]                              
                                                                                
# Group indices that are close together (multiple points might trigger near a   
