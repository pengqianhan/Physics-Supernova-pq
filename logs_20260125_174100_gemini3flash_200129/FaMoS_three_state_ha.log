  def compute_derivatives(x, dt):                                               
      v = np.zeros_like(x)                                                      
      a = np.zeros_like(x)                                                      
      v[1:-1] = (x[2:] - x[:-2]) / (2 * dt)                                     
      a[1:-1] = (x[2:] - 2 * x[1:-1] + x[:-2]) / (dt**2)                        
      v[0], v[-1] = (x[1] - x[0]) / dt, (x[-1] - x[-2]) / dt                    
      a[0], a[-1] = a[1], a[-2]                                                 
      return v, a                                                               
                                                                                
  def get_transitions(a, threshold_factor=10):                                  
      da = np.diff(a)                                                           
      threshold = np.std(da) * threshold_factor                                 
      indices = np.where(np.abs(da) > threshold)[0]                             
      if len(indices) == 0: return []                                           
      clusters = []                                                             
      current_cluster = [indices[0]]                                            
      for i in range(1, len(indices)):                                          
          if indices[i] - indices[i-1] < 10:                                    
              current_cluster.append(indices[i])                                
          else:                                                                 
              clusters.append(int(np.mean(current_cluster)))                    
              current_cluster = [indices[i]]                                    
      clusters.append(int(np.mean(current_cluster)))                            
