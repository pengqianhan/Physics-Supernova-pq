import numpy as np                                                              
                                                                                
def get_total_mse(x, t1, t2):                                                   
    x_t = x[2:]                                                                 
    x_t1 = x[1:-1]                                                              
    x_t0 = x[0:-2]                                                              
    m1 = x_t1 < t1                                                              
    m2 = (x_t1 >= t1) & (x_t1 < t2)                                             
    m3 = x_t1 >= t2                                                             
    err = 0                                                                     
    for mask in [m1, m2, m3]:                                                   
        if np.sum(mask) > 3:                                                    
            A = np.column_stack([x_t1[mask], x_t0[mask], np.ones(np.sum(mask))])
            y = x_t[mask]                                                       
            _, residuals, _, _ = np.linalg.lstsq(A, y, rcond=None)              
            if len(residuals) > 0:                                              
                err += residuals[0]                                             
    return err                                                                  
                                                                                
data = np.load(DATA_FILE_PATHS[0])                                              
x = data['state'][0]                                                            
                                                                                
t1_range = np.linspace(14, 16, 21)                                              
t2_range = np.linspace(24, 26, 21)                                              
                                                                                
best_err = float('inf')                                                         
best_ts = (15, 25)                                                              
                                                                                
for t1 in t1_range:                                                             
    for t2 in t2_range:                                                         
        err = get_total_mse(x, t1, t2)                                          
        if err < best_err:                                                      
            best_err = err                                                      
            best_ts = (t1, t2)                                                  
                                                                                
print(f"Refined thresholds: {best_ts}")                                         
                                                                                
