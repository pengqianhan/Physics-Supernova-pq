import numpy as np                                                              
import pandas as pd                                                             
from sklearn.cluster import KMeans                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
print("Keys:", list(data.keys()))                                               
                                                                                
# The prompt refers to x1[0], x1[1], x1[2]. Let's check the shape of x1.        
x1 = data['x1']                                                                 
t = data['t']                                                                   
print("x1 shape:", x1.shape)                                                    
print("t shape:", t.shape)                                                      
                                                                                
# Identify switching times by looking for discontinuities in x1[2]              
# x1[2] is the second derivative.                                               
# Jump detection:                                                               
jumps = np.where(np.abs(np.diff(x1[2, :])) > 0.01)[0]                           
switching_indices = jumps + 1                                                   
switching_times = t[switching_indices]                                          
                                                                                
print("Switching indices:", switching_indices)                                  
print("Switching times:", switching_times)                                      
                                                                                
# Partition data into segments                                                  
segments = []                                                                   
start_idx = 0                                                                   
for end_idx in switching_indices:                                               
    segments.append((start_idx, end_idx))                                       
    start_idx = end_idx                                                         
segments.append((start_idx, x1.shape[1]))                                       
                                                                                
# For each segment, solve for a, b, c in x1[2] = a*x1[1] + b*x1[0] + c          
segment_coeffs = []                                                             
for start, end in segments:                                                     
    # Use a few points away from the jump to avoid transient noise              
    if end - start < 5: continue                                                
                                                                                
    Y = x1[2, start+1:end-1]                                                    
    X = np.column_stack([x1[1, start+1:end-1], x1[0, start+1:end-1],            
np.ones(len(Y))])                                                               
                                                                                
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    segment_coeffs.append(coeffs)                                               
                                                                                
# Cluster coefficients into 3 modes                                             
segment_coeffs = np.array(segment_coeffs)                                       
kmeans = KMeans(n_clusters=3, random_state=0).fit(segment_coeffs)               
