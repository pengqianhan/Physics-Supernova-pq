import numpy as np                                                              
import pandas as pd                                                             
                                                                                
def get_derivatives(x, dt):                                                     
    v = np.diff(x) / dt                                                         
    a = np.diff(v) / dt                                                         
    return v[:-1], a, x[:-2]                                                    
                                                                                
def estimate_coefficients(v, a, x):                                             
    # a_acc = c1 * v + c2 * x + c3                                              
    A = np.column_stack([v, x, np.ones_like(v)])                                
    coeffs, residuals, rank, s = np.linalg.lstsq(A, a, rcond=None)              
    return coeffs                                                               
                                                                                
