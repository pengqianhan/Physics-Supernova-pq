def fit_mode_coeffs_v2(x, start, end):                                          
    if end - start < 10: return None                                            
    dt = 0.01                                                                   
    seg = x[start:end]                                                          
    # x'' = (x[i+1] - 2*x[i] + x[i-1]) / dt^2                                   
    # x' = (x[i+1] - x[i-1]) / (2*dt)                                           
                                                                                
    # Using central differences on the segment                                  
    v = (seg[2:] - seg[:-2]) / (2 * dt)                                         
    a = (seg[2:] - 2*seg[1:-1] + seg[:-2]) / (dt**2)                            
    pos = seg[1:-1]                                                             
                                                                                
    A = np.column_stack([v, pos, np.ones_like(pos)])                            
    coeffs, _, _, _ = np.linalg.lstsq(A, a, rcond=None)                         
    return coeffs # [p, q, r] -> x'' = p*x' + q*x + r                           
                                                                                
