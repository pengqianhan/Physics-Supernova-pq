    # Use velocity jumps to identify switches                                   
    dv = np.abs(np.diff(v_full))                                                
    switches = np.where(dv > (np.mean(dv) + 10 * np.std(dv)))[0] + 1            
                                                                                
    # Filter nearby switches                                                    
