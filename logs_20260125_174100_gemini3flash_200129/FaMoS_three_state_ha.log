from scipy import stats                                                         
                                                                                
def compute_derivatives(x, dt):                                                 
    x1 = x[0]                                                                   
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
    return x1, x1_dot, x1_ddot                                                  
                                                                                
def segment_data(x1, x1_dot, x1_ddot, dt, window_size=100, threshold=0.1):      
    n = len(x1)                                                                 
    segments = []                                                               
    start = 0                                                                   
                                                                                
    while start < n - window_size:                                              
        # Fit model for the current window                                      
        end = start + window_size                                               
        A = np.column_stack([x1_dot[start:end], x1[start:end],                  
np.ones(window_size)])                                                          
        y = x1_ddot[start:end]                                                  
        coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)          
                                                                                
        # Try to extend the segment                                             
        curr_end = end                                                          
        while curr_end < n:                                                     
            val = x1_ddot[curr_end]                                             
            pred = coeffs[0] * x1_dot[curr_end] + coeffs[1] * x1[curr_end] +    
coeffs[2]                                                                       
            if abs(val - pred) > threshold:                                     
                break                                                           
            curr_end += 1                                                       
                                                                                
        if curr_end - start >= window_size:                                     
            # Refit on the whole segment                                        
            A_full = np.column_stack([x1_dot[start:curr_end],                   
x1[start:curr_end], np.ones(curr_end-start)])                                   
            y_full = x1_ddot[start:curr_end]                                    
            coeffs_full, _, _, _ = np.linalg.lstsq(A_full, y_full, rcond=None)  
            segments.append({                                                   
                'start_idx': start,                                             
                'end_idx': curr_end,                                            
                'coeffs': coeffs_full,                                          
                'start_time': start * dt,                                       
                'end_time': curr_end * dt                                       
            })                                                                  
            start = curr_end                                                    
        else:                                                                   
            start += 1                                                          
                                                                                
    return segments                                                             
                                                                                
