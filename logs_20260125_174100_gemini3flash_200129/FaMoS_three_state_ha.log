dt = 0.001                                                                      
                                                                                
def find_transition_indices(x1, x1_dot):                                        
    peak_idx = np.argmax(x1)                                                    
    trough_dot_idx = np.argmin(x1_dot)                                          
    tail_candidates = np.where(x1_dot[trough_dot_idx:] > -0.5)[0]               
    if len(tail_candidates) > 0:                                                
        tail_start_idx = trough_dot_idx + tail_candidates[0]                    
    else:                                                                       
        tail_start_idx = len(x1) - 1                                            
    return peak_idx, tail_start_idx                                             
                                                                                
def get_coefficients(x1, x1_dot, x1_ddot, start, end):                          
    if end - start < 10: return None                                            
    y = x1_ddot[start:end]                                                      
    A = np.vstack([x1_dot[start:end], x1[start:end], np.ones(end-start)]).T     
    coeffs, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                         
    return coeffs                                                               
                                                                                
all_coeffs = {'Mode 1': [], 'Mode 2': [], 'Mode 3': []}                         
guards = {'1to2': [], '2to3': []}                                               
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x1 = data['state'][0, :]                                                    
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    idx1, idx2 = find_transition_indices(x1, x1_dot)                            
                                                                                
    c1 = get_coefficients(x1, x1_dot, x1_ddot, 0, idx1)                         
    c2 = get_coefficients(x1, x1_dot, x1_ddot, idx1, idx2)                      
    c3 = get_coefficients(x1, x1_dot, x1_ddot, idx2, len(x1))                   
                                                                                
    if c1 is not None: all_coeffs['Mode 1'].append(c1)                          
    if c2 is not None: all_coeffs['Mode 2'].append(c2)                          
    if c3 is not None: all_coeffs['Mode 3'].append(c3)                          
                                                                                
    guards['1to2'].append((x1[idx1], x1_dot[idx1]))                             
    if idx2 < len(x1) - 1:                                                      
        guards['2to3'].append((x1[idx2], x1_dot[idx2]))                         
                                                                                
avg_coeffs = {mode: np.mean(coeffs, axis=0) for mode, coeffs in                 
