Thought: I will load all the data, compute the first and second derivatives ($x$
and $v$) using a time step $dt=0.001$, and then identify the three modes by     
detecting switching points where the second derivative $a$ (acceleration)       
changes abruptly. I will then fit an ODE of the form $a = \alpha v + \beta x +  
\gamma$ for each mode and determine the guard conditions that trigger           
transitions. Finally, I will check for any resets at the switching points.      
                                                                                
<code>                                                                          
import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
all_x = []                                                                      
all_v = []                                                                      
all_a = []                                                                      
all_t = []                                                                      
                                                                                
for i, path in enumerate(DATA_FILE_PATHS):                                      
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    # Simple finite differences                                                 
    v = np.diff(x) / dt                                                         
    a = np.diff(v) / dt                                                         
                                                                                
    # Align lengths                                                             
    x_val = x[:-2]                                                              
    v_val = v[:-1]                                                              
    # We want x_i, v_i, a_i to correspond to the same time                      
    # a_i = (v_{i+1} - v_i) / dt = (x_{i+2} - 2x_{i+1} + x_i) / dt^2            
    # So we use x[i], v[i], a[i]                                                
    all_x.append(x[:-2])                                                        
    all_v.append(v[:-1])                                                        
    all_a.append(a)                                                             
    all_t.append(np.arange(len(a)) * dt)                                        
                                                                                
# Concatenate for global analysis                                               
X = np.concatenate(all_x)                                                       
V = np.concatenate(all_v)                                                       
A = np.concatenate(all_a)                                                       
                                                                                
# Let's find switches in each sample                                            
all_switches = []                                                               
for i in range(len(all_a)):                                                     
    da = np.abs(np.diff(all_a[i]))                                              
    # Find points where acceleration jumps significantly                        
    # Let's use a robust threshold                                              
    threshold = 100 # a is around 1-10, jump might be large                     
    sw = np.where(da > threshold)[0]                                            
    # Group switches that are very close (due to numerical derivative of a jump)
    if len(sw) > 0:                                                             
        clean_sw = [sw[0]]                                                      
        for s in sw[1:]:                                                        
            if s > clean_sw[-1] + 10:                                           
                clean_sw.append(s)                                              
        all_switches.append(clean_sw)                                           
    else:                                                                       
        all_switches.append([])                                                 
                                                                                
print("Switches in samples:", all_switches)                                     
                                                                                
# Collect segments for each mode                                                
# We expect 3 modes. Let's group segments by their linear fit properties.       
segments = []                                                                   
for s_idx, sw in enumerate(all_switches):                                       
    indices = [0] + [s+1 for s in sw] + [len(all_a[s_idx])]                     
    for i in range(len(indices)-1):                                             
        start, end = indices[i], indices[i+1]                                   
        if end - start > 10: # Ignore very short segments                       
            segments.append({                                                   
                'x': all_x[s_idx][start:end],                                   
                'v': all_v[s_idx][start:end],                                   
                'a': all_a[s_idx][start:end],                                   
                'sample': s_idx,                                                
                'start': start,                                                 
                'end': end                                                      
            })                                                                  
                                                                                
# Fit a = alpha*v + beta*x + gamma for each segment                             
for seg in segments:                                                            
    # Linear regression: A = [V X 1] * [alpha beta gamma]^T                     
