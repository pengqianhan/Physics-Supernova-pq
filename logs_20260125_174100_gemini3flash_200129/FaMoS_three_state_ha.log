        modes.append(get_mode(c[0], c[1], c[2]))                                
                                                                                
    transitions = []                                                            
    for i in range(1, len(modes)):                                              
        if modes[i] != modes[i-1] and modes[i] != 'Unknown' and modes[i-1] !=   
'Unknown':                                                                      
            # Transition at index i + window_size // 2                          
            idx = i + window_size // 2                                          
            transitions.append((idx, modes[i-1], modes[i]))                     
    return transitions                                                          
                                                                                
