print("Shape of x1:", x1.shape)                                                 
                                                                                
# Helper function to fit the model x1[:, 2] = a * x1[:, 1] + b * x1[:, 0] + c   
def fit_mode(t_arr, x1_arr, t_start, t_end):                                    
    mask = (t_arr >= t_start) & (t_arr <= t_end)                                
    x1_segment = x1_arr[mask]                                                   
                                                                                
    # x1_segment[:, 2] = a * x1_segment[:, 1] + b * x1_segment[:, 0] + c        
    # Prepare matrix A for least squares: [x1_dot, x1, 1]                       
    A = np.column_stack((x1_segment[:, 1], x1_segment[:, 0],                    
