import numpy as np                                                              
                                                                                
# Load the first data sample                                                    
data_path = 'data_all/FaMoS/three_state_ha/sample_0.npz'                        
data = np.load(data_path)                                                       
x1 = data['state'][0]                                                           
dt = 0.001                                                                      
n_points = len(x1)                                                              
                                                                                
# 2. Compute first and second derivatives                                       
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# 3. Identify mode switching points                                             
# We use a sliding window to compute the residual of the linear model x1_ddot = 
a*x1_dot + b*x1 + c                                                             
win = 60                                                                        
residuals = np.zeros(n_points)                                                  
for i in range(win, n_points - win):                                            
    X_win = np.column_stack([x1_dot[i-win:i+win], x1[i-win:i+win],              
np.ones(2*win)])                                                                
    y_win = x1_ddot[i-win:i+win]                                                
    _, res, _, _ = np.linalg.lstsq(X_win, y_win, rcond=None)                    
    if len(res) > 0:                                                            
        residuals[i] = res[0]                                                   
                                                                                
# Detect peaks in residuals as transitions                                      
# We expect a few transitions since it's a three-state system                   
# Filter and find unique peaks                                                  
threshold = np.mean(residuals) + 2 * np.std(residuals)                          
potential_trans = np.where(residuals > threshold)[0]                            
if len(potential_trans) > 0:                                                    
    cleaned_trans = [potential_trans[0]]                                        
    for p in potential_trans[1:]:                                               
        if p - cleaned_trans[-1] > 2 * win:                                     
            cleaned_trans.append(p)                                             
else:                                                                           
    cleaned_trans = []                                                          
                                                                                
print(f"Detected transition indices: {cleaned_trans}")                          
                                                                                
# 4. Partition data into segments                                               
segments = []                                                                   
start_idx = 0                                                                   
for t in cleaned_trans:                                                         
    segments.append((start_idx, t))                                             
    start_idx = t                                                               
segments.append((start_idx, n_points))                                          
                                                                                
# 5. Fit linear models for each mode                                            
mode_models = []                                                                
for i, (start, end) in enumerate(segments):                                     
    # Avoid the transition region itself to get a cleaner fit                   
    s_fit, e_fit = start + 10, end - 10                                         
    if e_fit - s_fit < 50: # fallback for small segments                        
        s_fit, e_fit = start, end                                               
                                                                                
    X = np.column_stack([x1_dot[s_fit:e_fit], x1[s_fit:e_fit],                  
np.ones(e_fit-s_fit)])                                                          
    y = x1_ddot[s_fit:e_fit]                                                    
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    mode_models.append({                                                        
        'coeffs': coeffs,                                                       
        'indices': (start, end),                                                
        'x1_range': (np.min(x1[start:end]), np.max(x1[start:end]))              
    })                                                                          
                                                                                
# 6. Identify guard conditions                                                  
# We look at the value of x1 at the transition point                            
guards = []                                                                     
for i in range(len(cleaned_trans)):                                             
    idx = cleaned_trans[i]                                                      
    val = x1[idx]                                                               
    # Check if x1 was increasing or decreasing to determine the guard direction 
    if x1_dot[idx] > 0:                                                         
        guards.append(f"x1 > {val:.4f}")                                        
    else:                                                                       
        guards.append(f"x1 < {val:.4f}")                                        
                                                                                
# Formatting output                                                             
results = []                                                                    
for i, model in enumerate(mode_models):                                         
    a, b, c = model['coeffs']                                                   
    results.append(f"Mode {i}: x1'' = {a:.4f}*x1' + {b:.4f}*x1 + {c:.4f}")      
                                                                                
print("\n".join(results))                                                       
print(f"Transitions and Guards: {guards}")                                      
                                                                                
