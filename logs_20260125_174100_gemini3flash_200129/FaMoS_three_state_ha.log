import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
state = data['state']                                                           
x1 = state[0]                                                                   
dt = 0.001                                                                      
t = np.arange(len(x1)) * dt                                                     
                                                                                
# Compute derivatives                                                           
v = np.gradient(x1, dt)                                                         
acc = np.gradient(v, dt)                                                        
jerk = np.gradient(acc, dt)                                                     
                                                                                
# Identify transition points                                                    
threshold_jerk = np.max(np.abs(jerk)) * 0.1                                     
transitions = np.where(np.abs(jerk) > threshold_jerk)[0]                        
diffs = np.diff(transitions)                                                    
split_indices = np.where(diffs > 15)[0] + 1                                     
transition_groups = np.split(transitions, split_indices)                        
t_points = [0] + [int(np.mean(g)) for g in transition_groups] + [len(x1)-1]     
                                                                                
# Perform fitting for each interval                                             
for i in range(len(t_points) - 1):                                              
    start, end = t_points[i], t_points[i+1]                                     
    # Use index range directly                                                  
    idx = np.arange(start + 20, end - 20)                                       
    if len(idx) < 3: continue                                                   
                                                                                
    A = np.column_stack([v[idx], x1[idx], np.ones_like(x1[idx])])               
    b_vec = acc[idx]                                                            
    coeffs, _, _, _ = np.linalg.lstsq(A, b_vec, rcond=None)                     
    a, b, c = coeffs                                                            
                                                                                
    print(f"Interval {i+1} (t={t[start]:.3f} to {t[end]:.3f}): a={a:.5f},       
b={b:.5f}, c={c:.5f}, x1_start={x1[start]:.3f}, x1_end={x1[end]:.3f}")          
                                                                                
# Check for resets at transitions                                               
for tp in t_points[1:-1]:                                                       
    jump_x1 = x1[tp+1] - x1[tp] - v[tp]*dt                                      
    jump_v = v[tp+1] - v[tp]                                                    
    print(f"At t={t[tp]:.3f}: x1_reset_check={jump_x1:.6f},                     
v_jump={jump_v:.6f}")                                                           
                                                                                
