import numpy as np                                                              
import pandas as pd                                                             
from scipy.optimize import curve_fit                                            
                                                                                
# Define a function for the linear fit                                          
def linear_model(X, a, b, c):                                                   
    x1_0, x1_1 = X                                                              
    return a * x1_1 + b * x1_0 + c                                              
                                                                                
results = []                                                                    
                                                                                
for i, path in enumerate(DATA_FILE_PATHS):                                      
    data = np.load(path)                                                        
    # Keys might be 'x', 't', 'labels' or similar.                              
    # Usually FaMoS datasets have 'x' (states) and 'labels' (modes).            
    x = data['x']                                                               
    labels = data['labels']                                                     
                                                                                
    sample_results = {'sample': i, 'modes': {}}                                 
                                                                                
    for mode in np.unique(labels):                                              
        indices = np.where(labels == mode)[0]                                   
        # x shape is likely (N, d). We use x[indices, 0], x[indices, 1],        
x[indices, 2]                                                                   
        # if x1[2] refers to the 3rd component of the state vector.             
        sub_x = x[indices]                                                      
                                                                                
        # Fit x[2] = a*x[1] + b*x[0] + c                                        
        # Independent variables: x[:, 0] and x[:, 1]. Dependent: x[:, 2]        
        if len(sub_x) > 3:                                                      
            X_data = (sub_x[:, 0], sub_x[:, 1])                                 
            Y_data = sub_x[:, 2]                                                
            popt, _ = curve_fit(linear_model, X_data, Y_data)                   
            a, b, c = popt                                                      
            sample_results['modes'][mode] = {'coeffs': (a, b, c)}               
                                                                                
            # Identify thresholds. Thresholds are typically on one of the       
states.                                                                         
            # Look at the values of x at transition points.                     
            transitions = np.where(np.diff(labels) != 0)[0]                     
            thresholds = []                                                     
            for trans_idx in transitions:                                       
                # Value of x[0] at transition                                   
                thresholds.append(x[trans_idx, 0])                              
            sample_results['thresholds'] = thresholds                           
                                                                                
    results.append(sample_results)                                              
                                                                                
print(results)                                                                  
                                                                                
