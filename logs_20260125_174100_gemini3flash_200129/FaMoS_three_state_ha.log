import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
all_x1 = []                                                                     
all_x1_dot = []                                                                 
all_x1_ddot = []                                                                
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0, :]                                                            
                                                                                
    # Compute derivatives                                                       
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    all_x1.append(x1)                                                           
    all_x1_dot.append(x1_dot)                                                   
    all_x1_ddot.append(x1_ddot)                                                 
                                                                                
# Combine data                                                                  
X1 = np.concatenate(all_x1)                                                     
X1_dot = np.concatenate(all_x1_dot)                                             
X1_ddot = np.concatenate(all_x1_ddot)                                           
                                                                                
# Define regions                                                                
regions = {                                                                     
    'A': X1 < 15,                                                               
    'B': (X1 >= 15) & (X1 < 25),                                                
    'C': X1 >= 25                                                               
}                                                                               
                                                                                
results = {}                                                                    
                                                                                
for name, mask in regions.items():                                              
    if np.any(mask):                                                            
        y = X1_ddot[mask]                                                       
        x1_m = X1[mask]                                                         
        x1_dot_m = X1_dot[mask]                                                 
                                                                                
        # Prepare feature matrix [x1_dot, x1, 1]                                
        X_mat = np.column_stack([x1_dot_m, x1_m, np.ones(len(x1_m))])           
                                                                                
        # Linear regression                                                     
        beta, residuals, rank, s = np.linalg.lstsq(X_mat, y, rcond=None)        
        c1, c0, bias = beta                                                     
                                                                                
        # Prediction (avoiding @)                                               
        y_pred = c1 * x1_dot_m + c0 * x1_m + bias                               
                                                                                
        # R2 calculation                                                        
        ssr = np.sum((y - y_pred)**2)                                           
        sst = np.sum((y - np.mean(y))**2)                                       
        r2 = 1 - (ssr / sst) if sst != 0 else 1.0                               
                                                                                
        results[name] = {'c1': c1, 'c0': c0, 'bias': bias, 'r2': r2, 'count':   
len(y)}                                                                         
                                                                                
print("--- Regression Results ---")                                             
for name, res in results.items():                                               
    print(f"Region {name}: c1={res['c1']:.4f}, c0={res['c0']:.4f},              
bias={res['bias']:.4f}, R2={res['r2']:.4f}, count={res['count']}")              
                                                                                
# Check for resets/discontinuities                                              
max_dot_jump = 0                                                                
for x1_d in all_x1_dot:                                                         
    max_dot_jump = max(max_dot_jump, np.max(np.abs(np.diff(x1_d))))             
print(f"\nMax jump in x1_dot: {max_dot_jump:.6f}")                              
                                                                                
# Verify boundary crossings                                                     
print("\n--- Boundary Analysis ---")                                            
for i, x1 in enumerate(all_x1):                                                 
    c15 = np.where(np.diff((x1 < 15).astype(int)))[0]                           
    c25 = np.where(np.diff((x1 < 25).astype(int)))[0]                           
    print(f"Sample {i}: Crossing 15 at indices {c15}, Crossing 25 at indices    
{c25}")                                                                         
                                                                                
                                                                                
