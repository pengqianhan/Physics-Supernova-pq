import numpy as np                                                              
import pandas as pd                                                             
from sklearn.cluster import KMeans                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# 1. Load all samples                                                           
dt = 0.001                                                                      
data_list = []                                                                  
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # Assuming the position is 'x1' or the first column of 'X'                  
    # Based on the prompt, x1 is the primary state.                             
    # Looking at common FaMoS structures, 'X' or 'x' might contain the data.    
    # Let's inspect the keys.                                                   
    if 'x' in data:                                                             
        x_val = data['x']                                                       
    elif 'X' in data:                                                           
        x_val = data['X']                                                       
    else:                                                                       
        # Fallback to first available array                                     
        key = list(data.keys())[0]                                              
        x_val = data[key]                                                       
                                                                                
    # x1 is usually the first component                                         
    if len(x_val.shape) > 1 and x_val.shape[1] > 0:                             
        x1 = x_val[:, 0]                                                        
    else:                                                                       
        x1 = x_val                                                              
                                                                                
    # 2. Compute derivatives                                                    
    v = np.gradient(x1, dt)                                                     
    a = np.gradient(v, dt)                                                      
                                                                                
    # Store for clustering                                                      
    data_list.append(np.column_stack((x1, v, a)))                               
                                                                                
all_data = np.vstack(data_list)                                                 
x1_all = all_data[:, 0]                                                         
v_all = all_data[:, 1]                                                          
a_all = all_data[:, 2]                                                          
                                                                                
# 3. Clustering into 3 modes                                                    
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)                       
labels = kmeans.fit_predict(all_data)                                           
                                                                                
# 4. Fit linear models for each mode: a_val = c1 * v + c2 * x1 + c3             
models = {}                                                                     
for i in range(3):                                                              
    mask = (labels == i)                                                        
    X_fit = np.column_stack((v_all[mask], x1_all[mask]))                        
    y_fit = a_all[mask]                                                         
    reg = LinearRegression().fit(X_fit, y_fit)                                  
    models[i] = {                                                               
        'coeffs': reg.coef_, # [a, b]                                           
        'intercept': reg.intercept_, # c                                        
        'bounds': (np.min(x1_all[mask]), np.max(x1_all[mask]))                  
    }                                                                           
                                                                                
print("Models:", models)                                                        
                                                                                
# 5. Identify transition conditions and graph structure                         
# We look at the sequence of labels to see transitions                          
transitions = []                                                                
for path in DATA_FILE_PATHS:                                                    
    # Re-predict for each sample to keep sequence                               
    data = np.load(path)                                                        
    # (Assuming same extraction logic as above)                                 
    if 'x' in data: x_v = data['x'][:, 0]                                       
    else: x_v = np.load(path)[list(data.keys())[0]][:, 0]                       
                                                                                
    v_v = np.gradient(x_v, dt)                                                  
    a_v = np.gradient(v_v, dt)                                                  
    feat = np.column_stack((x_v, v_v, a_v))                                     
    seq_labels = kmeans.predict(feat)                                           
                                                                                
    for j in range(len(seq_labels) - 1):                                        
        if seq_labels[j] != seq_labels[j+1]:                                    
            transitions.append((seq_labels[j], seq_labels[j+1], x_v[j]))        
                                                                                
print("Transitions Sample:", transitions[:10])                                  
                                                                                
