import numpy as np                                                              
                                                                                
def analyze_system():                                                           
    # Load data                                                                 
    data_files = ['data_all/FaMoS/three_state_ha/sample_0.npz',                 
                  'data_all/FaMoS/three_state_ha/sample_1.npz',                 
                  'data_all/FaMoS/three_state_ha/sample_2.npz']                 
                                                                                
    dt = 0.01  # Typical dt                                                     
    all_x = []                                                                  
    all_v = []                                                                  
    all_a = []                                                                  
                                                                                
    for file in data_files:                                                     
        data = np.load(file)                                                    
        x = data['state'][0]                                                    
        # Use central differences for better derivatives                        
        v = np.gradient(x, dt)                                                  
        a = np.gradient(v, dt)                                                  
        all_x.append(x)                                                         
        all_v.append(v)                                                         
        all_a.append(a)                                                         
                                                                                
    x_full = np.concatenate(all_x)                                              
    v_full = np.concatenate(all_v)                                              
    a_full = np.concatenate(all_a)                                              
                                                                                
    # Identify modes based on state regions                                     
    # Let's try to find thresholds. Typical values are 0, 10, etc.              
    # Looking at the range [-7, 30], let's try a scan.                          
                                                                                
    def fit_and_error(mask):                                                    
        if np.sum(mask) < 20:                                                   
            return None, np.inf                                                 
        X = np.column_stack([v_full[mask], x_full[mask], np.ones(np.sum(mask))])
        y = a_full[mask]                                                        
        coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)          
        error = np.mean((y - X @ coeffs)**2)                                    
        return coeffs, error                                                    
                                                                                
    best_err = float('inf')                                                     
    best_thresholds = (0, 0)                                                    
    best_c = []                                                                 
                                                                                
    # Search for two thresholds t1 and t2                                       
    t_candidates = np.linspace(np.min(x_full) + 1, np.max(x_full) - 1, 30)      
    for i in range(len(t_candidates)):                                          
        for j in range(i + 1, len(t_candidates)):                               
            t1, t2 = t_candidates[i], t_candidates[j]                           
            m1 = x_full < t1                                                    
            m2 = (x_full >= t1) & (x_full < t2)                                 
            m3 = x_full >= t2                                                   
                                                                                
            c1, e1 = fit_and_error(m1)                                          
            c2, e2 = fit_and_error(m2)                                          
            c3, e3 = fit_and_error(m3)                                          
                                                                                
            if c1 is None or c2 is None or c3 is None:                          
                continue                                                        
                                                                                
            total_err = e1 + e2 + e3                                            
            if total_err < best_err:                                            
                best_err = total_err                                            
                best_thresholds = (t1, t2)                                      
                best_c = [c1, c2, c3]                                           
                                                                                
    print(f"Thresholds: {best_thresholds}")                                     
    for i, c in enumerate(best_c):                                              
        print(f"Mode {i+1}: a={c[0]:.4f}, b={c[1]:.4f}, c={c[2]:.4f}")          
                                                                                
    # Reset Map Analysis                                                        
    # Compare v before and after threshold crossing                             
    for t in best_thresholds:                                                   
        for i in range(len(all_x)):                                             
            x_s = all_x[i]                                                      
            v_s = all_v[i]                                                      
            crossings = np.where(np.diff(np.sign(x_s - t)))[0]                  
            if len(crossings) > 0:                                              
                idx = crossings[0]                                              
                print(f"Sample {i} cross threshold {t:.2f} at index {idx}:      
v_pre={v_s[idx]:.4f}, v_post={v_s[idx+1]:.4f}")                                 
                                                                                
analyze_system()                                                                
                                                                                
