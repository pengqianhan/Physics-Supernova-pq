import numpy as np                                                              
                                                                                
def detect_modes(x, window_size=50, threshold=0.01):                            
    n = len(x)                                                                  
    coeffs = []                                                                 
                                                                                
    for i in range(2, n - window_size):                                         
        # Window of data                                                        
        X_win = x[i:i+window_size]                                              
        X1 = x[i-1:i-1+window_size]                                             
        X2 = x[i-2:i-2+window_size]                                             
                                                                                
        # Fit model: X_win = c1 * X1 + c2 * X2 + b                              
        # [X1 X2 1] * [c1 c2 b]^T = X_win                                       
        A = np.column_stack([X1, X2, np.ones_like(X1)])                         
        try:                                                                    
            c, _, _, _ = np.linalg.lstsq(A, X_win, rcond=None)                  
            coeffs.append(c)                                                    
        except:                                                                 
            coeffs.append(np.array([0, 0, 0]))                                  
                                                                                
    coeffs = np.array(coeffs)                                                   
                                                                                
    # Detect changes in coefficients                                            
    changes = []                                                                
    for i in range(1, len(coeffs)):                                             
        if np.linalg.norm(coeffs[i] - coeffs[i-1]) > threshold:                 
            changes.append(i + 2) # Offset due to range start                   
                                                                                
    return coeffs, changes                                                      
                                                                                
# Test on the first sample                                                      
coeffs, changes = detect_modes(samples[0])                                      
