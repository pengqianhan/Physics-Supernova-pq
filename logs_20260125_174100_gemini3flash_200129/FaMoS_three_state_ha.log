import numpy as np                                                              
                                                                                
def fit_modes(path):                                                            
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    x_t = x[2:]                                                                 
    x_t1 = x[1:-1]                                                              
    x_t0 = x[0:-2]                                                              
                                                                                
    t1, t2 = 15, 25                                                             
    masks = [x_t1 < t1, (x_t1 >= t1) & (x_t1 < t2), x_t1 >= t2]                 
                                                                                
    coeffs = []                                                                 
    for mask in masks:                                                          
        if np.sum(mask) > 3:                                                    
            A = np.column_stack([x_t1[mask], x_t0[mask], np.ones(np.sum(mask))])
            y = x_t[mask]                                                       
            c, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                      
            coeffs.append(c)                                                    
        else:                                                                   
            coeffs.append(None)                                                 
    return coeffs                                                               
                                                                                
for path in DATA_FILE_PATHS:                                                    
    print(f"File: {path}")                                                      
    print(fit_modes(path))                                                      
                                                                                
