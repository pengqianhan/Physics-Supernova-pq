    d_mean = data.mean(axis=0)                                                  
    d_std = data.std(axis=0)                                                    
    d_scaled = (data - d_mean) / d_std                                          
                                                                                
    indices = np.random.choice(data.shape[0], k, replace=False)                 
    centroids = d_scaled[indices]                                               
                                                                                
    for _ in range(iterations):                                                 
        distances = np.linalg.norm(d_scaled[:, np.newaxis] - centroids, axis=2) 
        labels = np.argmin(distances, axis=1)                                   
        new_centroids = np.array([d_scaled[labels == i].mean(axis=0) for i in   
range(k)])                                                                      
        if np.allclose(centroids, new_centroids):                               
            break                                                               
        centroids = new_centroids                                               
    return labels                                                               
                                                                                
