# Identify modes based on x1 thresholds.                                        
# Common thresholds in such problems are -0.5, 0, 0.5.                          
# Let's try to detect switches by looking at residuals of a global fit.         
# Or more simply, try to find where the relationship x1_ddot = a*x1_dot + b*x1 +
c changes.                                                                      
                                                                                
def fit_mode(x, dx, ddx):                                                       
    A = np.column_stack([dx, x, np.ones_like(x)])                               
    res = np.linalg.lstsq(A, ddx, rcond=None)                                   
    return res[0], res[1] # coeffs, residuals                                   
                                                                                
# Try splitting by x1 values to find the 3 modes                                
# Typically these are x1 < -0.5, -0.5 <= x1 <= 0.5, x1 > 0.5                    
thresholds = [-0.5, 0.5]                                                        
                                                                                
