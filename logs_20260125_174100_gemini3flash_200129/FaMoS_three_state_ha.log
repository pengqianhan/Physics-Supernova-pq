              'data_all/FaMoS/three_state_ha/sample_2.npz']                     
                                                                                
all_x1 = []                                                                     
dt = 0.01                                                                       
                                                                                
for file in data_files:                                                         
    data = np.load(file)                                                        
    all_x1.append(data['state'][0])                                             
                                                                                
# Combine all data for global analysis                                          
x_full = np.concatenate(all_x1)                                                 
v_full = np.gradient(x_full, dt)                                                
a_full = np.gradient(v_full, dt)                                                
                                                                                
# Identify thresholds using a sliding window or checking fit error              
# Let's try to fit in 3 regions: x < T1, T1 <= x < T2, x >= T2                  
def fit_ode(x, v, a):                                                           
    A = np.column_stack([v, x, np.ones_like(x)])                                
    c, resid, rank, s = np.linalg.lstsq(A, a, rcond=None)                       
    return c                                                                    
                                                                                
# Based on previous trial logs, thresholds appear to be around 1.0 and 3.0      
# Let's refine them by searching around these values                            
best_err = float('inf')                                                         
best_params = (1.0, 3.0)                                                        
best_coeffs = []                                                                
                                                                                
for t1 in np.linspace(0.5, 1.5, 11):                                            
    for t2 in np.linspace(2.5, 3.5, 11):                                        
        m1 = x_full < t1                                                        
        m2 = (x_full >= t1) & (x_full < t2)                                     
        m3 = x_full >= t2                                                       
                                                                                
        if np.sum(m1) < 100 or np.sum(m2) < 100 or np.sum(m3) < 100: continue   
                                                                                
        c1 = fit_ode(x_full[m1], v_full[m1], a_full[m1])                        
        c2 = fit_ode(x_full[m2], v_full[m2], a_full[m2])                        
        c3 = fit_ode(x_full[m3], v_full[m3], a_full[m3])                        
                                                                                
        err = (np.sum((a_full[m1] - (c1[0]*v_full[m1] + c1[1]*x_full[m1] +      
c1[2]))**2) +                                                                   
               np.sum((a_full[m2] - (c2[0]*v_full[m2] + c2[1]*x_full[m2] +      
c2[2]))**2) +                                                                   
               np.sum((a_full[m3] - (c3[0]*v_full[m3] + c3[1]*x_full[m3] +      
c3[2]))**2))                                                                    
                                                                                
        if err < best_err:                                                      
            best_err = err                                                      
            best_params = (t1, t2)                                              
            best_coeffs = [c1, c2, c3]                                          
                                                                                
print(f"Optimal Thresholds: {best_params}")                                     
print(f"Mode 1 coeffs: {best_coeffs[0]}")                                       
print(f"Mode 2 coeffs: {best_coeffs[1]}")                                       
print(f"Mode 3 coeffs: {best_coeffs[2]}")                                       
                                                                                
# Check for resets at thresholds                                                
for t in best_params:                                                           
    crossings = np.where(np.diff(np.sign(x_full - t)))[0]                       
    for idx in crossings[:5]: # Check first 5 crossings                         
        v_diff = np.abs(v_full[idx+1] - v_full[idx])                            
        print(f"Threshold {t} crossing at index {idx}, velocity diff: {v_diff}")
                                                                                
                                                                                
