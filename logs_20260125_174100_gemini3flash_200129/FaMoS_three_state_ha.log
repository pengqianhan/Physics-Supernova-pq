import numpy as np                                                              
                                                                                
def fit_ar2(x_segment):                                                         
    if len(x_segment) < 4:                                                      
        return None, float('inf')                                               
    y = x_segment[2:]                                                           
    x1 = x_segment[1:-1]                                                        
    x0 = x_segment[0:-2]                                                        
    A = np.column_stack([x1, x0, np.ones_like(x1)])                             
    try:                                                                        
        coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)          
        mse = residuals[0] / len(y) if len(residuals) > 0 else 0                
        return coeffs, mse                                                      
    except:                                                                     
        return None, float('inf')                                               
                                                                                
