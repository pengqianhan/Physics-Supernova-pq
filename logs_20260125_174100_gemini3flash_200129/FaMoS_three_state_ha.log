        filtered = [switches[0]]                                                
        for s in switches[1:]:                                                  
            if s - filtered[-1] > 100:                                          
                filtered.append(s)                                              
        switches = filtered                                                     
                                                                                
    indices = [0] + switches + [len(x_full)]                                    
                                                                                
    for j in range(len(indices)-1):                                             
        start, end = indices[j], indices[j+1]                                   
        if end - start < 100: continue                                          
                                                                                
        # Linear regression on a = a*v + b*x + c                                
        s_start, s_end = start + 10, end - 10                                   
