          indices = [0] + transitions + [len(x1)]                               
          mode_params = []                                                      
                                                                                
          for start, end in zip(indices[:-1], indices[1:]):                     
              # Buffer indices slightly to stay away from the discontinuity     
  spike                                                                         
              b_start, b_end = start + 20, end - 20                             
