import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
dt = 0.001                                                                      
modes_data = {1: {'x_dot': [], 'x': [], 'x_ddot': []},                          
              2: {'x_dot': [], 'x': [], 'x_ddot': []},                          
              3: {'x_dot': [], 'x': [], 'x_ddot': []}}                          
                                                                                
