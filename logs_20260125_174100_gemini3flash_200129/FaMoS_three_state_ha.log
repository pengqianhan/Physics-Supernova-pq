        if end - start > 30: # Filter short segments                            
            seg_pos = pos[start:end]                                            
            seg_vel = vel[start:end]                                            
            seg_acc = acc[start:end]                                            
                                                                                
            # Regression: acc = a*vel + b*pos + c                               
            A = np.column_stack([seg_vel, seg_pos, np.ones_like(seg_pos)])      
            try:                                                                
                coeffs, _, _, _ = np.linalg.lstsq(A, seg_acc, rcond=None)       
                                                                                
                # Capture state at transition                                   
