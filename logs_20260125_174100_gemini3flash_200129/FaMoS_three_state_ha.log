  import numpy as np                                                            
                                                                                
  # Load the primary data file                                                  
  data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                  
  state = data['state']                                                         
  t = np.linspace(0, 10, 10001)                                                 
  dt = t[1] - t[0]                                                              
                                                                                
  # x1 is state[0]                                                              
  x1_pos = state[0]                                                             
                                                                                
  # Compute derivatives                                                         
  x1_vel = np.gradient(x1_pos, dt)                                              
  x1_acc = np.gradient(x1_vel, dt)                                              
                                                                                
  def fit_segment(t_start, t_end):                                              
      mask = (t >= t_start) & (t <= t_end)                                      
      y = x1_acc[mask]                                                          
      # Matrix A: [x1_vel, x1_pos, 1]                                           
      A = np.column_stack((x1_vel[mask], x1_pos[mask], np.ones(np.sum(mask))))  
      coeffs, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                       
      return coeffs                                                             
                                                                                
  # Fit for each mode                                                           
  mode1_coeffs = fit_segment(0, 1.3)                                            
  mode2_coeffs = fit_segment(1.5, 4.0)                                          
  mode3_coeffs = fit_segment(4.7, 10.0)                                         
                                                                                
  print(f"Mode 1 coeffs (a, b, c): {mode1_coeffs}")                             
  print(f"Mode 2 coeffs (a, b, c): {mode2_coeffs}")                             
  print(f"Mode 3 coeffs (a, b, c): {mode3_coeffs}")                             
                                                                                
  # Sign switches of second derivative (x1_acc)                                 
  sign_changes = np.where(np.diff(np.sign(x1_acc)) != 0)[0]                     
  for idx in sign_changes:                                                      
      # Linear interpolation for more precision? Or just take the value.        
      # The moment is between idx and idx+1.                                    
      t_switch = (t[idx] + t[idx+1]) / 2                                        
      val_switch = (x1_pos[idx] + x1_pos[idx+1]) / 2                            
      print(f"Sign switch at t={t_switch:.4f}, x1={val_switch:.4f}")            
                                                                                
  # Check Mode 1 vs Mode 3                                                      
  print(f"Mode 1 vs Mode 3 signs: {np.sign(mode1_coeffs)} vs                    
  {np.sign(mode3_coeffs)}")                                                     
