import numpy as np                                                              
                                                                                
# Load all three files                                                          
data_files = ['data_all/FaMoS/three_state_ha/sample_0.npz',                     
              'data_all/FaMoS/three_state_ha/sample_1.npz',                     
              'data_all/FaMoS/three_state_ha/sample_2.npz']                     
                                                                                
all_x1 = []                                                                     
all_times = []                                                                  
dt = 0.01                                                                       
                                                                                
for i, file in enumerate(data_files):                                           
    data = np.load(file)                                                        
    x = data['state'][0]                                                        
    all_x1.append(x)                                                            
    all_times.append(np.arange(len(x)) * dt + i * 200) # Offset for clarity     
                                                                                
# Concatenate for global analysis                                               
x1 = np.concatenate(all_x1)                                                     
v1 = np.diff(x1) / dt                                                           
a1 = np.diff(v1) / dt                                                           
                                                                                
# Alignment                                                                     
x1_fit = x1[:-2]                                                                
v1_fit = v1[:-1]                                                                
a1_fit = a1                                                                     
                                                                                
def fit_model(mask):                                                            
    if np.sum(mask) < 10: return None                                           
    A = np.column_stack((v1_fit[mask], x1_fit[mask], np.ones(np.sum(mask))))    
    coeffs, residuals, rank, s = np.linalg.lstsq(A, a1_fit[mask], rcond=None)   
    return coeffs                                                               
                                                                                
# Scan for thresholds by checking fit error                                     
thresholds = np.linspace(np.min(x1), np.max(x1), 50)                            
errors = []                                                                     
                                                                                
# Try to find two thresholds t1, t2                                             
best_err = float('inf')                                                         
best_t = (0, 0)                                                                 
                                                                                
# Since searching all pairs is slow, let's look at coefficients over sliding    
windows of x1                                                                   
sorted_idx = np.argsort(x1_fit)                                                 
x_sorted = x1_fit[sorted_idx]                                                   
v_sorted = v1_fit[sorted_idx]                                                   
a_sorted = a1_fit[sorted_idx]                                                   
                                                                                
window_size = 500                                                               
results = []                                                                    
for i in range(0, len(x_sorted) - window_size, 100):                            
    subset_mask = np.zeros(len(x_sorted), dtype=bool)                           
    subset_mask[i:i+window_size] = True                                         
    A = np.column_stack((v_sorted[subset_mask], x_sorted[subset_mask],          
np.ones(window_size)))                                                          
    c, res, _, _ = np.linalg.lstsq(A, a_sorted[subset_mask], rcond=None)        
    results.append((np.mean(x_sorted[subset_mask]), c))                         
                                                                                
for res in results:                                                             
    print(f"x ~ {res[0]:.2f}: a={res[1][0]:.2f}, b={res[1][1]:.2f},             
c={res[1][2]:.2f}")                                                             
                                                                                
# Check for resets: looking for jumps in velocity                               
v_jumps = np.abs(np.diff(v1))                                                   
print(f"Max velocity jump: {np.max(v_jumps)}")                                  
                                                                                
