def fit_mode_coeffs(x, start, end):                                             
    # Fit continuous model dx^2/dt^2 = a*dx/dt + b*x + c                        
    dt = 0.01                                                                   
    seg = x[start:end]                                                          
    v = np.gradient(seg, dt)                                                    
    a = np.gradient(v, dt)                                                      
                                                                                
    # a = p*v + q*seg + r                                                       
    A = np.column_stack([v, seg, np.ones_like(seg)])                            
    try:                                                                        
        coeffs, _, _, _ = np.linalg.lstsq(A, a, rcond=None)                     
        return coeffs # [p, q, r]                                               
    except:                                                                     
        return None                                                             
                                                                                
