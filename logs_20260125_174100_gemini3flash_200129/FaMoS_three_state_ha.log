    keys = list(data.keys())                                                    
    all_x.extend(data['x'] if 'x' in keys else data[keys[0]])                   
all_x = np.array(all_x)                                                         
if len(all_x.shape) > 1: all_x = all_x[:, 0]                                    
print(f"Max x1 below 25: {np.max(all_x[all_x < 25])}")                          
print(f"Min x1 above or at 25: {np.min(all_x[all_x >= 25])}")                   
                                                                                
