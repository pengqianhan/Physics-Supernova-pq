    vel = np.gradient(pos, dt)                                                  
    acc = np.gradient(vel, dt)                                                  
                                                                                
    # Identify jumps in acceleration to find switching times                    
    acc_diff = np.abs(np.diff(acc))                                             
    threshold = np.mean(acc_diff) + 5 * np.std(acc_diff)                        
    switches = np.where(acc_diff > threshold)[0] + 1                            
                                                                                
    # Segment the data                                                          
    indices = np.sort(np.unique(np.concatenate(([0], switches, [len(pos)]))))   
    for i in range(len(indices)-1):                                             
