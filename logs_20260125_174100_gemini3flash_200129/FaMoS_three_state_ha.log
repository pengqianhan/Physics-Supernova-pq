              coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)               
                                                                                
              # Guard is the value of x1 at the switch                          
              guard_val = x1_full[indices[j+1]] if j < len(refined_switches)    
  else None                                                                     
              segments.append({'coeffs': coeffs, 'guard': guard_val})           
                                                                                
  # Filter out segments that might be noise and group them by coefficient       
  values                                                                        
  # We expect 3 distinct modes. Let's cluster based on the coefficients.        
  # A simple way is to look at the 'c' (intercept) or 'b' (linear) values.      
  # Let's just print all unique-looking modes found.                            
  unique_modes = []                                                             
  for seg in segments:                                                          
      is_new = True                                                             
      for um in unique_modes:                                                   
          if np.allclose(seg['coeffs'], um['coeffs'], atol=0.1):                
              if seg['guard'] is not None:                                      
                  um['guards'].add(round(seg['guard'], 2))                      
              is_new = False                                                    
              break                                                             
      if is_new:                                                                
          unique_modes.append({                                                 
              'coeffs': seg['coeffs'],                                          
              'guards': {round(seg['guard'], 2)} if seg['guard'] is not None    
  else set()                                                                    
          })                                                                    
                                                                                
  print(f"Found {len(unique_modes)} distinct modes.")                           
  for i, m in enumerate(unique_modes):                                          
      a, b, c = m['coeffs']                                                     
      print(f"Mode {i}: x1'' = {a:.3f}*x1' + {b:.3f}*x1 + {c:.3f}")             
      if m['guards']:                                                           
          print(f"  Transitions observed at x1 ≈ {list(m['guards'])}")          
