import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
all_x1 = []                                                                     
all_x1_dot = []                                                                 
all_x1_ddot = []                                                                
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # The prompt says x1 is state[0, :]                                         
    state = data['state']                                                       
    x1 = state[0, :]                                                            
                                                                                
    # Check if state[1, :] is already x1_dot                                    
    # We'll compute it using gradient as requested                              
    x1_dot_calc = np.gradient(x1, dt)                                           
    x1_ddot_calc = np.gradient(x1_dot_calc, dt)                                 
                                                                                
    all_x1.append(x1)                                                           
    all_x1_dot.append(x1_dot_calc)                                              
    all_x1_ddot.append(x1_ddot_calc)                                            
                                                                                
# Combine data from all samples                                                 
X1 = np.concatenate(all_x1)                                                     
X1_dot = np.concatenate(all_x1_dot)                                             
X1_ddot = np.concatenate(all_x1_ddot)                                           
                                                                                
# Partition data                                                                
regions = {                                                                     
    'A': X1 < 15,                                                               
    'B': (X1 >= 15) & (X1 < 25),                                                
    'C': X1 >= 25                                                               
}                                                                               
                                                                                
results = {}                                                                    
                                                                                
for name, mask in regions.items():                                              
    if np.any(mask):                                                            
        y = X1_ddot[mask]                                                       
        # X matrix: [x1_dot, x1, 1]                                             
        X_mat = np.column_stack([X1_dot[mask], X1[mask], np.ones(np.sum(mask))])
                                                                                
        # Linear regression using lstsq                                         
        beta, residuals, rank, s = np.linalg.lstsq(X_mat, y, rcond=None)        
        c1, c0, bias = beta                                                     
                                                                                
        # R-squared calculation                                                 
        y_pred = X_mat @ beta                                                   
        ssr = np.sum((y - y_pred)**2)                                           
        sst = np.sum((y - np.mean(y))**2)                                       
        r2 = 1 - (ssr / sst) if sst != 0 else 1.0                               
                                                                                
        results[name] = {                                                       
            'c1': c1,                                                           
            'c0': c0,                                                           
            'bias': bias,                                                       
            'r2': r2,                                                           
            'count': np.sum(mask)                                               
        }                                                                       
                                                                                
print("Regression Results:")                                                    
for name, res in results.items():                                               
    print(f"Region {name}: c1={res['c1']:.6f}, c0={res['c0']:.6f},              
bias={res['bias']:.6f}, R2={res['r2']:.6f}, count={res['count']}")              
                                                                                
# Check for discontinuities/resets in x1_dot                                    
jumps = []                                                                      
for x1_d in all_x1_dot:                                                         
    jumps.append(np.max(np.abs(np.diff(x1_d))))                                 
print(f"Max jump in x1_dot: {max(jumps):.6f}")                                  
                                                                                
# Check transitions                                                             
for i, x1 in enumerate(all_x1):                                                 
    cross_15 = np.where(np.diff(x1 < 15))[0]                                    
    cross_25 = np.where(np.diff(x1 < 25))[0]                                    
    print(f"Sample {i} crossings: 15 at {cross_15}, 25 at {cross_25}")          
                                                                                
                                                                                
