def estimate_coefficients(x, dx, ddx):                                          
    A = np.column_stack([dx, x, np.ones_like(x)])                               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, ddx, rcond=None)            
    return coeffs                                                               
                                                                                
