def get_derivatives(x, dt=0.01):                                                
    v = np.diff(x) / dt                                                         
    a = np.diff(v) / dt                                                         
    return v, a                                                                 
                                                                                
def fit_linear(x, v, a):                                                        
    # a = c0*v + c1*x + c2                                                      
    A = np.column_stack([v, x, np.ones_like(x)])                                
    coeffs, residuals, rank, s = np.linalg.lstsq(A, a, rcond=None)              
    return coeffs                                                               
                                                                                
