    x1 = data['x'] if 'x' in keys else data[keys[0]]                            
    if len(x1.shape) > 1 and x1.shape[1] > 1:                                   
        x1 = x1[:, 0] # Take first column if it's a matrix                      
                                                                                
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    # Segment A: x1 < 25 and x1 is increasing (Mode 1)                          
    mask1 = (x1 < 25) & (x1_dot > 0)                                            
    # Segment B: x1 >= 25 (Mode 2)                                              
    mask2 = (x1 >= 25)                                                          
    # Segment C: x1 < 25 and x1 is decreasing (Mode 3)                          
    mask3 = (x1 < 25) & (x1_dot < 0)                                            
                                                                                
