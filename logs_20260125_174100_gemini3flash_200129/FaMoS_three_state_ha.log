def solve_ls(X, y):                                                             
    # Manual least squares: (X.T * X)^-1 * X.T * y                              
    XT = X.T                                                                    
    XTX = np.dot(XT, X)                                                         
    XTy = np.dot(XT, y)                                                         
    try:                                                                        
        sol = np.linalg.solve(XTX, XTy)                                         
        return sol                                                              
    except:                                                                     
        return None                                                             
                                                                                
