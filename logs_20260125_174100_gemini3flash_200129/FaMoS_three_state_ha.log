def fit_discrete_coeffs(x, start, end):                                         
    if end - start < 10: return None                                            
    # x[n] = c1*x[n-1] + c2*x[n-2] + bias                                       
    X_target = x[start+2:end]                                                   
    X1 = x[start+1:end-1]                                                       
    X2 = x[start:end-2]                                                         
    A = np.column_stack([X1, X2, np.ones_like(X1)])                             
    c, _, _, _ = np.linalg.lstsq(A, X_target, rcond=None)                       
    return c # [c1, c2, bias]                                                   
                                                                                
