import numpy as np                                                              
                                                                                
def get_coeffs_clean(s, start, end):                                            
    seg = s[start:end]                                                          
    dt = 0.001                                                                  
    x = seg[1:-1]                                                               
    dx = (seg[2:] - seg[:-2]) / (2*dt)                                          
    d2x = (seg[2:] - 2*seg[1:-1] + seg[:-2]) / (dt**2)                          
    A = np.column_stack([dx, x, np.ones_like(x)])                               
    params, _, _, _ = np.linalg.lstsq(A, d2x, rcond=None)                       
    return params                                                               
                                                                                
# Segment definitions:                                                          
# Rising: 0 to peak                                                             
# Falling: peak to x=1                                                          
# Recovery: x=1 to end                                                          
                                                                                
def get_segments(sample_idx):                                                   
    data = np.load(f'data_all/FaMoS/three_state_ha/sample_{sample_idx}.npz')    
    s = data['state'][0]                                                        
    idx_peak = np.argmax(s)                                                     
    idx_switch = np.where((s <= 1.0) & (np.arange(len(s)) > idx_peak))[0][0]    
    return s[:idx_peak+1], s[idx_peak:idx_switch+1], s[idx_switch:]             
                                                                                
all_rising = []                                                                 
all_falling = []                                                                
all_recovery = []                                                               
                                                                                
for i in range(3):                                                              
    r, f, rec = get_segments(i)                                                 
    # Collect data for fit                                                      
    def add_data(seg, target_list):                                             
        if len(seg) < 5: return                                                 
        dt = 0.001                                                              
        target_list.append((seg[1:-1], (seg[2:]-seg[:-2])/(2*dt),               
(seg[2:]-2*seg[1:-1]+seg[:-2])/(dt**2)))                                        
    add_data(r, all_rising)                                                     
    add_data(f, all_falling)                                                    
    add_data(rec, all_recovery)                                                 
                                                                                
def fit_all(data_list):                                                         
    X = np.concatenate([d[0] for d in data_list])                               
    DX = np.concatenate([d[1] for d in data_list])                              
    D2X = np.concatenate([d[2] for d in data_list])                             
    A = np.column_stack([DX, X, np.ones_like(X)])                               
    return np.linalg.lstsq(A, D2X, rcond=None)[0]                               
                                                                                
print("Final Coeffs Rising:", fit_all(all_rising))                              
print("Final Coeffs Falling:", fit_all(all_falling))                            
print("Final Coeffs Recovery:", fit_all(all_recovery))                          
                                                                                
