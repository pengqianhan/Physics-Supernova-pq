            cleaned_transitions.append(t)                                       
else:                                                                           
    cleaned_transitions = []                                                    
                                                                                
print(f"Detected transition points at indices: {cleaned_transitions}")          
print(f"Times: {[t * dt for t in cleaned_transitions]}")                        
                                                                                
# Partition data                                                                
segments = []                                                                   
start = 0                                                                       
for t in cleaned_transitions:                                                   
