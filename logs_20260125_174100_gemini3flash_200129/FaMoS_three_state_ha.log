  # 2. Identify mode switch times by looking for jumps in x1[2]                 
  # Using a more robust jump detection                                          
  diff_x1_2 = np.abs(np.diff(x1_2))                                             
  threshold = np.max(diff_x1_2) * 0.2                                           
  switches = np.where(diff_x1_2 > threshold)[0]                                 
                                                                                
  filtered_switches = []                                                        
  if len(switches) > 0:                                                         
      filtered_switches.append(switches[0])                                     
      for s in switches[1:]:                                                    
          if s - filtered_switches[-1] > 100: # filter out noisy detections     
              filtered_switches.append(s)                                       
                                                                                
  print(f"Detected switches at indices: {filtered_switches}")                   
                                                                                
  # 3. For each segment, fit linear ODE: x1[2] = k1 * x1[1] + k0 * x1[0] +      
  bias                                                                          
  indices = [0] + filtered_switches + [len(x1_0)-1]                             
  modes = []                                                                    
                                                                                
  for i in range(len(indices)-1):                                               
      start = indices[i]                                                        
      end = indices[i+1]                                                        
                                                                                
      # Trim to avoid boundary effects                                          
      s = start + 20                                                            
      e = end - 20                                                              
      if e - s < 50: continue # Skip segments too short                         
                                                                                
      A = np.column_stack([x1_1[s:e], x1_0[s:e], np.ones(e-s)])                 
      b = x1_2[s:e]                                                             
                                                                                
      sol, _, _, _ = np.linalg.lstsq(A, b, rcond=None)                          
      k1, k0, bias = sol                                                        
                                                                                
      modes.append({                                                            
          'id': i,                                                              
          'k1': k1,                                                             
          'k0': k0,                                                             
          'bias': bias,                                                         
          'start': start,                                                       
          'end': end                                                            
      })                                                                        
                                                                                
  for m in modes:                                                               
