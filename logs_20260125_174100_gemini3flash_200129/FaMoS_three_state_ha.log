def classify_point(x, dx, ddx):                                                 
    # Modes: A: [-0.5, 0.5, 0], B: [-0.5, -0.5, 0], C: [0, -0.5, 0]             
    errA = (ddx - (-0.5*dx + 0.5*x))**2                                         
    errB = (ddx - (-0.5*dx - 0.5*x))**2                                         
    errC = (ddx - (-0.5*x))**2                                                  
    m = np.argmin([errA, errB, errC])                                           
    return ['A', 'B', 'C'][m]                                                   
                                                                                
