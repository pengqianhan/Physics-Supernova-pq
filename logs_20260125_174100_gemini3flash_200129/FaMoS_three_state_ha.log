import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
dt = 0.001                                                                      
all_x = []                                                                      
all_dx = []                                                                     
all_ddx = []                                                                    
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'][0]  # x1 is the only variable                         
                                                                                
    # Calculate first derivative                                                
    dx = np.gradient(state, dt)                                                 
    # Calculate second derivative                                               
    ddx = np.gradient(dx, dt)                                                   
                                                                                
    all_x.append(state)                                                         
    all_dx.append(dx)                                                           
    all_ddx.append(ddx)                                                         
                                                                                
# Concatenate for global analysis if needed                                     
X = np.concatenate(all_x)                                                       
DX = np.concatenate(all_dx)                                                     
DDX = np.concatenate(all_ddx)                                                   
                                                                                
# Visualize x1'' vs x1 and x1' to see modes                                     
