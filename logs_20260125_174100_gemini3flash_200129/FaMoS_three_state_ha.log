          'switch_val': x1[e] if i < 2 else None                                
      })                                                                        
                                                                                
  # 5. Report coefficients and switching conditions                             
  output_text = "Mode analysis results:\n"                                      
  for res in mode_results:                                                      
      output_text += f"Mode {res['mode']} (Interval {res['indices']}):          
  a={res['a']:.4f}, b={res['b']:.4f}, c={res['c']:.4f}\n"                       
                                                                                
  trans1_x = x1[switches[0]]                                                    
