import numpy as np                                                              
                                                                                
def analyze():                                                                  
    data_files = ['data_all/FaMoS/three_state_ha/sample_0.npz',                 
                  'data_all/FaMoS/three_state_ha/sample_1.npz',                 
                  'data_all/FaMoS/three_state_ha/sample_2.npz']                 
                                                                                
    dt = 0.01                                                                   
    all_x = []                                                                  
    all_v = []                                                                  
    all_a = []                                                                  
                                                                                
    for file in data_files:                                                     
        data = np.load(file)                                                    
        x = data['state'][0]                                                    
        v = np.gradient(x, dt)                                                  
        a = np.gradient(v, dt)                                                  
        all_x.append(x)                                                         
        all_v.append(v)                                                         
        all_a.append(a)                                                         
                                                                                
    x_f = np.concatenate(all_x)                                                 
    v_f = np.concatenate(all_v)                                                 
    a_f = np.concatenate(all_a)                                                 
                                                                                
    # Test suspected thresholds                                                 
    t1, t2 = 0.9, 3.1                                                           
                                                                                
    masks = [x_f < t1, (x_f >= t1) & (x_f < t2), x_f >= t2]                     
                                                                                
    print("--- Mode Identification ---")                                        
    regions = ["Mode 2 (x < 0.9)", "Mode 1 (0.9 <= x < 3.1)", "Mode 3 (x >=     
3.1)"]                                                                          
    for i, m in enumerate(masks):                                               
        if np.sum(m) > 10:                                                      
            A = np.column_stack([v_f[m], x_f[m], np.ones(np.sum(m))])           
            coeffs, _, _, _ = np.linalg.lstsq(A, a_f[m], rcond=None)            
            print(f"{regions[i]}: a={coeffs[0]:.2f}, b={coeffs[1]:.2f},         
c={coeffs[2]:.2f}, count={np.sum(m)}")                                          
                                                                                
    print("\n--- Reset Map Analysis (Sample 0) ---")                            
    x0, v0 = all_x[0], all_v[0]                                                 
    for t in [t1, t2]:                                                          
        crossings = np.where(np.diff(np.sign(x0 - t)))[0]                       
        for idx in crossings[:3]:                                               
            print(f"Crossing {t} at index {idx}:                                
x={x0[idx]:.4f}->{x0[idx+1]:.4f}, v={v0[idx]:.4f}->{v0[idx+1]:.4f}")            
                                                                                
analyze()                                                                       
                                                                                
