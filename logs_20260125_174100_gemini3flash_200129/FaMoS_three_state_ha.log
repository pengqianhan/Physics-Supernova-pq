print(f"Unique mode coefficients (a, b, c): {np.unique(clustering.labels_)}")   
                                                                                
# Let's refine the modes by averaging the coefficients                          
unique_labels = set(clustering.labels_)                                         
if -1 in unique_labels: unique_labels.remove(-1)                                
mode_params = {}                                                                
for label in unique_labels:                                                     
    mode_params[label] = models[clustering.labels_ == label].mean(axis=0)       
    print(f"Mode {label} params: {mode_params[label]}")                         
                                                                                
# Now assign each point to a mode based on minimal residual                     
all_modes = []                                                                  
for t in trajectories:                                                          
    residuals = []                                                              
    labels = sorted(mode_params.keys())                                         
    for label in labels:                                                        
        p = mode_params[label]                                                  
        res = np.abs(t['a'] - (p[0] * t['v'] + p[1] * t['x'] + p[2]))           
        residuals.append(res)                                                   
    best_mode = np.argmin(np.stack(residuals), axis=0)                          
    all_modes.append(best_mode)                                                 
                                                                                
# Transition analysis                                                           
for i, modes in enumerate(all_modes):                                           
    switches = np.where(modes[:-1] != modes[1:])[0]                             
    for s in switches:                                                          
        m_from = modes[s]                                                       
        m_to = modes[s+1]                                                       
        x_val = trajectories[i]['x'][s]                                         
        v_val = trajectories[i]['v'][s]                                         
        print(f"Switch from {m_from} to {m_to} at x={x_val:.4f}, v={v_val:.4f}")
                                                                                
# Reset check: check if x or v jump significantly at switches                   
for i, modes in enumerate(all_modes):                                           
    switches = np.where(modes[:-1] != modes[1:])[0]                             
    for s in switches:                                                          
        dx = trajectories[i]['x'][s+1] - trajectories[i]['x'][s]                
        dv = trajectories[i]['v'][s+1] - trajectories[i]['v'][s]                
        if abs(dx) > 0.1 or abs(dv) > 0.1:                                      
            print(f"Potential reset at switch {s}: dx={dx:.4f}, dv={dv:.4f}")   
                                                                                
