# Simple segmentation based on sliding window variance or error                 
def find_segments(x1, x1_dot, x1_ddot, dt, win=200, step=50, tol=0.5):          
    n = len(x1)                                                                 
    segments = []                                                               
    i = 0                                                                       
    while i < n - win:                                                          
        # Fit on current window                                                 
        c = fit_linear_model(x1[i:i+win], x1_dot[i:i+win], x1_ddot[i:i+win])    
                                                                                
        # Extend segment                                                        
        j = i + win                                                             
        while j < n:                                                            
            pred = c[0]*x1_dot[j] + c[1]*x1[j] + c[2]                           
            if abs(x1_ddot[j] - pred) > tol:                                    
                break                                                           
            j += 1                                                              
                                                                                
        # If segment is long enough, record it                                  
        if j - i >= win:                                                        
            # Refit on whole segment                                            
            c_final = fit_linear_model(x1[i:j], x1_dot[i:j], x1_ddot[i:j])      
            segments.append({                                                   
                'start': i,                                                     
                'end': j,                                                       
                'coeffs': c_final,                                              
                'start_time': i*dt,                                             
                'end_time': j*dt                                                
            })                                                                  
            i = j                                                               
        else:                                                                   
            i += step                                                           
    return segments                                                             
                                                                                
