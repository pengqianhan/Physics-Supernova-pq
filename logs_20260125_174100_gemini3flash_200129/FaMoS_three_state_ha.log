for i in range(3):                                                              
    data = np.load(DATA_FILE_PATHS[i])                                          
    x = data['state'][0]                                                        
    v, a = get_derivatives(x)                                                   
                                                                                
    # Switches                                                                  
    da = np.abs(np.diff(a))                                                     
    switches = np.where(da > (np.mean(da) + 5 * np.std(da)))[0] + 1             
                                                                                
    # Filter                                                                    
    if len(switches) > 0:                                                       
        filtered = [switches[0]]                                                
        for s in switches[1:]:                                                  
            if s - filtered[-1] > 100:                                          
                filtered.append(s)                                              
        switches = filtered                                                     
                                                                                
    # Add start and end                                                         
    indices = [0] + switches + [len(x)]                                         
                                                                                
