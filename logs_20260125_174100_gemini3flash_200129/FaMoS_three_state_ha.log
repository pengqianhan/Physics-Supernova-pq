import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def get_continuous_coeffs(s):                                                   
    # s is a 1D array                                                           
    # Central differences for better accuracy                                   
    # x(t) = s[i]                                                               
    # x'(t) = (s[i+1] - s[i-1]) / (2*dt)                                        
    # x''(t) = (s[i+1] - 2*s[i] + s[i-1]) / (dt**2)                             
                                                                                
    x = s[1:-1]                                                                 
    dx = (s[2:] - s[0:-2]) / (2 * dt)                                           
    d2x = (s[2:] - 2*s[1:-1] + s[0:-2]) / (dt**2)                               
                                                                                
    A = np.column_stack([dx, x, np.ones_like(x)])                               
    params, _, _, _ = np.linalg.lstsq(A, d2x, rcond=None)                       
    return params                                                               
                                                                                
# We need to collect data for each mode across all samples to get the best fit. 
rising_data_x = []                                                              
rising_data_dx = []                                                             
rising_data_d2x = []                                                            
                                                                                
falling_data_x = []                                                             
falling_data_dx = []                                                            
falling_data_d2x = []                                                           
                                                                                
recovery_data_x = []                                                            
recovery_data_dx = []                                                           
recovery_data_d2x = []                                                          
                                                                                
