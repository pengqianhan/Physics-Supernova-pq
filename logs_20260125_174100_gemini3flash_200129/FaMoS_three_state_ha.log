        'mode': i,                                                              
        'coeffs': reg.coef_,                                                    
        'intercept': reg.intercept_,                                            
        'range': (s, e),                                                        
        'x1_range': (np.min(x1[s:e]), np.max(x1[s:e]))                          
    })                                                                          
                                                                                
for m in models:                                                                
