def get_error(x, dx, d2x, a, b, c, dt=0.01):                                    
    alpha = a * dt                                                              
    beta = b * dt**2                                                            
    gamma = c * dt**2                                                           
    pred = alpha * dx + beta * x + gamma                                        
    return np.abs(d2x - pred)                                                   
                                                                                
