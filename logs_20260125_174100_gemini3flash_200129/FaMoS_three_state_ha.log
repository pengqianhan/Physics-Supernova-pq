import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def analyze():                                                                  
    mode_data = []                                                              
                                                                                
    for i in range(3):                                                          
        data = np.load(DATA_FILE_PATHS[i])                                      
        x = data['state'][0]                                                    
        n = len(x)                                                              
                                                                                
        # Manual derivatives                                                    
        v = np.zeros(n-1)                                                       
        for k in range(n-1):                                                    
            v[k] = (x[k+1] - x[k]) / dt                                         
                                                                                
        a = np.zeros(n-2)                                                       
        for k in range(n-2):                                                    
            a[k] = (v[k+1] - v[k]) / dt                                         
                                                                                
        # Detect switches based on velocity jumps                               
        v_jumps = []                                                            
        for k in range(n-2):                                                    
            if abs(v[k+1] - v[k]) > 0.5: # Significant jump                     
                v_jumps.append(k+1)                                             
                                                                                
        # Filter jumps                                                          
        if len(v_jumps) > 0:                                                    
            filtered = [v_jumps[0]]                                             
            for j in v_jumps[1:]:                                               
                if j - filtered[-1] > 20:                                       
                    filtered.append(j)                                          
            v_jumps = filtered                                                  
                                                                                
        # Segment indices                                                       
        indices = [0] + v_jumps + [n-2]                                         
                                                                                
        for idx in range(len(indices)-1):                                       
            start, end = indices[idx], indices[idx+1]                           
            if end - start < 100: continue                                      
                                                                                
            # Regression segment                                                
            rs, re = start + 5, end - 5                                         
            sx = x[rs:re]                                                       
            sv = v[rs:re]                                                       
            sa = a[rs:re-1] # a is 1 shorter than v                             
                                                                                
            # Match lengths                                                     
            sx = sx[:len(sa)]                                                   
            sv = sv[:len(sa)]                                                   
                                                                                
            A = np.column_stack([sv, sx, np.ones_like(sx)])                     
            coeffs, _, _, _ = np.linalg.lstsq(A, sa, rcond=None)                
                                                                                
            mode_data.append({                                                  
                'sample': i,                                                    
                'mode_idx': idx,                                                
                'x_start': x[start],                                            
                'x_end': x[end],                                                
                'v_start': v[start],                                            
                'v_end': v[end-1],                                              
                'coeffs': coeffs                                                
            })                                                                  
                                                                                
    return mode_data                                                            
                                                                                
