import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data                                                                 
samples = []                                                                    
for path in DATA_FILE_PATHS:                                                    
    samples.append(np.load(path))                                               
                                                                                
# Process x1 data and its derivatives                                           
all_segments = []                                                               
                                                                                
for i, data in enumerate(samples):                                              
    # data['X'] shape is (N, state_dim)                                         
    # Based on the prompt, x1 is likely the first component                     
    # x1[0] = x1, x1[1] = dx1/dt, x1[2] = d^2x1/dt^2                            
    # If the data already contains derivatives in the state vector:             
    # Let's check the shape.                                                    
    X = data['X']                                                               
    t = data['t']                                                               
                                                                                
    # Identify x1, dx1, d2x1                                                    
    # Often in these datasets X[:, 0] is x1, X[:, 1] is dx1, X[:, 2] is d2x1    
    x1_0 = X[:, 0]                                                              
    x1_1 = X[:, 1]                                                              
    x1_2 = X[:, 2]                                                              
                                                                                
    # Identify switching times by looking for discontinuities in x1[2]          
    # We look for large jumps in x1_2                                           
    diff_x1_2 = np.abs(np.diff(x1_2))                                           
    threshold = np.percentile(diff_x1_2, 99) * 5 # Heuristic threshold          
    switch_indices = np.where(diff_x1_2 > threshold)[0] + 1                     
                                                                                
    # Split into segments                                                       
    indices = [0] + list(switch_indices) + [len(t)]                             
    for j in range(len(indices) - 1):                                           
        start, end = indices[j], indices[j+1]                                   
        if end - start < 5: continue # Skip very short segments                 
                                                                                
        seg_x1_0 = x1_0[start:end]                                              
        seg_x1_1 = x1_1[start:end]                                              
        seg_x1_2 = x1_2[start:end]                                              
                                                                                
        # Linear Regression: x1_2 = a * x1_1 + b * x1_0 + c                     
        features = np.column_stack([seg_x1_1, seg_x1_0])                        
        model = LinearRegression().fit(features, seg_x1_2)                      
        a, b = model.coef_                                                      
        c = model.intercept_                                                    
                                                                                
        all_segments.append({                                                   
            'sample': i,                                                        
            'start_idx': start,                                                 
            'end_idx': end,                                                     
            'a': a, 'b': b, 'c': c,                                             
            'x_start': x1_0[start], 'dx_start': x1_1[start],                    
            'x_end': x1_0[end-1], 'dx_end': x1_1[end-1]                         
        })                                                                      
                                                                                
print(pd.DataFrame(all_segments))                                               
                                                                                
