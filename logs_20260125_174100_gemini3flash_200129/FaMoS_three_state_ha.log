import numpy as np                                                              
from sklearn.cluster import KMeans                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load all NPZ files                                                            
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'][0])                                         
                                                                                
# Assuming dt = 0.1 for derivatives (common in these tasks, will adjust if      
needed)                                                                         
dt = 0.1                                                                        
                                                                                
features = []                                                                   
for x in all_states:                                                            
    dx = np.gradient(x, dt)                                                     
    d2x = np.gradient(dx, dt)                                                   
    # Stack features: [x, dx, d2x]                                              
    traj_features = np.stack([x, dx, d2x], axis=1)                              
    features.append(traj_features)                                              
                                                                                
# Concatenate all features for clustering                                       
X_all = np.concatenate(features, axis=0)                                        
                                                                                
# Clustering into 3 modes                                                       
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)                       
labels = kmeans.fit_predict(X_all)                                              
                                                                                
# Organize data by mode                                                         
modes_data = {i: [] for i in range(3)}                                          
for i, label in enumerate(labels):                                              
    modes_data[label].append(X_all[i])                                          
                                                                                
results = []                                                                    
for i in range(3):                                                              
    data = np.array(modes_data[i])                                              
    # Model: d2x = a * dx + b * x + c                                           
    X_reg = data[:, :2]  # [x, dx]                                              
    y_reg = data[:, 2]   # d2x                                                  
                                                                                
    # We want d2x = a * dx + b * x + c                                          
    # So features are [dx, x]                                                   
    X_reg_ordered = np.stack([data[:, 1], data[:, 0]], axis=1)                  
                                                                                
    model = LinearRegression()                                                  
    model.fit(X_reg_ordered, y_reg)                                             
                                                                                
    a, b = model.coef_                                                          
    c = model.intercept_                                                        
    results.append({'mode': i, 'a': a, 'b': b, 'c': c, 'score':                 
model.score(X_reg_ordered, y_reg)})                                             
                                                                                
print("Linear Model Coefficients (d2x = a*dx + b*x + c):")                      
for res in results:                                                             
    print(f"Mode {res['mode']}: a={res['a']:.4f}, b={res['b']:.4f},             
c={res['c']:.4f}, R^2={res['score']:.4f}")                                      
                                                                                
# Identify transitions and guards                                               
# We'll look at the first trajectory for transition points                      
traj_labels = labels[:10001]                                                    
traj_x = all_states[0]                                                          
traj_dx = np.gradient(traj_x, dt)                                               
                                                                                
transitions = []                                                                
for i in range(1, len(traj_labels)):                                            
    if traj_labels[i] != traj_labels[i-1]:                                      
        transitions.append({                                                    
            'from': traj_labels[i-1],                                           
            'to': traj_labels[i],                                               
            'x': traj_x[i],                                                     
            'dx': traj_dx[i]                                                    
        })                                                                      
                                                                                
print("\nSample Transitions:")                                                  
for t in transitions[:10]:                                                      
    print(f"From Mode {t['from']} to {t['to']} at x={t['x']:.4f},               
dx={t['dx']:.4f}")                                                              
                                                                                
