  def solve_for_coeffs(x_data, indices):                                        
      # Find contiguous blocks                                                  
      if len(indices) == 0:                                                     
          return None                                                           
                                                                                
      blocks = []                                                               
      current_block = [indices[0]]                                              
      for i in range(1, len(indices)):                                          
          if indices[i] == indices[i-1] + 1:                                    
              current_block.append(indices[i])                                  
          else:                                                                 
              if len(current_block) >= 3:                                       
                  blocks.append(current_block)                                  
              current_block = [indices[i]]                                      
      if len(current_block) >= 3:                                               
          blocks.append(current_block)                                          
                                                                                
      A_list = []                                                               
      B_list = []                                                               
      for block in blocks:                                                      
          vals = x_data[block]                                                  
          # x[n+2] = a*x[n+1] + b*x[n] + c                                      
          # B = A * [a, b, c]^T                                                 
          for j in range(len(vals) - 2):                                        
              B_list.append(vals[j+2])                                          
              A_list.append([vals[j+1], vals[j], 1.0])                          
                                                                                
      if not A_list:                                                            
