from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data and compute derivatives                                             
dt = 1.0 # Assuming unit time step                                              
trajectories = []                                                               
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x1 = data['state'][0]                                                       
    v = np.gradient(x1, dt)                                                     
    a = np.gradient(v, dt)                                                      
    trajectories.append({'x': x1, 'v': v, 'a': a})                              
                                                                                
# Concatenate all data points for mode analysis                                 
all_x = np.concatenate([t['x'] for t in trajectories])                          
all_v = np.concatenate([t['v'] for t in trajectories])                          
all_a = np.concatenate([t['a'] for t in trajectories])                          
                                                                                
# Simple approach: Plotting or histogram of the dynamics to see clusters        
# However, to be more systematic, let's use a small window and fit local models 
# and then cluster those models.                                                
                                                                                
# Better: use the trajectory structure.                                         
# Let's try to detect switches by looking at residuals of a global fit          
# Or use a sliding window fit.                                                  
                                                                                
def fit_segment(x, v, a):                                                       
    X = np.stack([v, x, np.ones_like(x)], axis=1)                               
    model = LinearRegression().fit(X, a)                                        
    return model.coef_[0], model.coef_[1], model.intercept_, model.score(X, a)  
                                                                                
# Let's try to find segments in the first trajectory                            
traj = trajectories[0]                                                          
n = len(traj['x'])                                                              
window_size = 50                                                                
models = []                                                                     
for i in range(0, n - window_size, window_size):                                
    idx = slice(i, i + window_size)                                             
    ma, mb, mc, score = fit_segment(traj['x'][idx], traj['v'][idx],             
traj['a'][idx])                                                                 
    if score > 0.9: # Only keep good fits                                       
        models.append([ma, mb, mc])                                             
                                                                                
from sklearn.cluster import DBSCAN                                              
models = np.array(models)                                                       
clustering = DBSCAN(eps=0.01, min_samples=2).fit(models)                        
print(f"Number of modes detected via clustering: {len(set(clustering.labels_)) -
