import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/three_state_ha/sample_0.npz')                    
x = data['state'][0]                                                            
n = len(x)                                                                      
dt = 0.01 # Guessing dt based on typical values and data patterns               
                                                                                
# Derivatives                                                                   
v = np.gradient(x, dt)                                                          
a_accel = np.gradient(v, dt)                                                    
                                                                                
# Identify switching points by finding jumps in acceleration                    
# Since gradient smoothes jumps, we look for the max change in acceleration     
da = np.abs(np.diff(a_accel))                                                   
# Use a threshold to find points of change                                      
threshold = np.percentile(da, 99.5)                                             
switches = np.where(da > threshold)[0] + 1                                      
                                                                                
# Group close switches                                                          
refined_switches = []                                                           
if len(switches) > 0:                                                           
    last = -100                                                                 
    for s in switches:                                                          
        if s - last > 100:                                                      
            refined_switches.append(s)                                          
            last = s                                                            
                                                                                
print("Detected switches at indices:", refined_switches)                        
                                                                                
# Partition and fit                                                             
indices = [0] + refined_switches + [n]                                          
segments = []                                                                   
for i in range(len(indices)-1):                                                 
    s_idx = indices[i]                                                          
    e_idx = indices[i+1]                                                        
    if e_idx - s_idx < 50: continue                                             
                                                                                
    # Fit ODE: a_accel = a*v + b*x + c                                          
    # Use central part of segment to avoid boundary effects                     
    mid_s = s_idx + 10                                                          
    mid_e = e_idx - 10                                                          
                                                                                
    Y = a_accel[mid_s:mid_e]                                                    
    X = np.column_stack([v[mid_s:mid_e], x[mid_s:mid_e], np.ones(mid_e-mid_s)]) 
                                                                                
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    segments.append({                                                           
        'start': s_idx,                                                         
        'end': e_idx,                                                           
        'coeffs': coeffs,                                                       
        'x_at_start': x[s_idx],                                                 
        'v_at_start': v[s_idx],                                                 
        'x_at_end': x[e_idx-1],                                                 
        'v_at_end': v[e_idx-1]                                                  
    })                                                                          
                                                                                
# Identify 3 modes                                                              
# Use the coefficients to group them                                            
modes_found = []                                                                
for seg in segments:                                                            
    c = seg['coeffs']                                                           
    is_new = True                                                               
    for m in modes_found:                                                       
        if np.allclose(c, m['coeffs'], atol=0.01, rtol=0.01):                   
            m['segs'].append(seg)                                               
            is_new = False                                                      
            break                                                               
    if is_new:                                                                  
        modes_found.append({'coeffs': c, 'segs': [seg], 'id': len(modes_found)})
                                                                                
# Print Mode Params                                                             
for m in modes_found:                                                           
    print(f"Mode {m['id']}: a={m['coeffs'][0]:.6f}, b={m['coeffs'][1]:.6f},     
c={m['coeffs'][2]:.6f}")                                                        
                                                                                
# Transitions and Guards                                                        
for i in range(len(segments)-1):                                                
    curr = segments[i]                                                          
    nxt = segments[i+1]                                                         
                                                                                
    # Find mode IDs                                                             
    m_from = -1                                                                 
