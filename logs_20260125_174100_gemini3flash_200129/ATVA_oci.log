      X = (x1_mid[indices], x2_mid[indices])                                    
      popt1, _ = curve_fit(linear_model, X, dx1[indices])                       
      popt2, _ = curve_fit(linear_model, X, dx2[indices])                       
      return popt1, popt2                                                       
                                                                                
