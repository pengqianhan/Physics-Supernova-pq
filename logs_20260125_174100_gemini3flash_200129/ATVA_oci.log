import numpy as np                                                              
                                                                                
# Load the data                                                                 
data_files = ['data_all/ATVA/oci/sample_0.npz',                                 
'data_all/ATVA/oci/sample_1.npz', 'data_all/ATVA/oci/sample_2.npz']             
dt = 0.001                                                                      
                                                                                
all_states = []                                                                 
all_inputs = []                                                                 
trace_data = []                                                                 
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    # Check if 'input' exists                                                   
    if 'input' in data.files:                                                   
        inp = data['input']                                                     
    else:                                                                       
        inp = np.zeros((len(state), 1))                                         
                                                                                
    trace_data.append({'state': state, 'input': inp})                           
    all_states.append(state)                                                    
    all_inputs.append(inp)                                                      
                                                                                
# Combine for analysis                                                          
combined_states = np.concatenate(all_states)                                    
x1 = combined_states[:, 0]                                                      
x2 = combined_states[:, 1]                                                      
                                                                                
# Prepare regression data: x[k] -> x[k+1]                                       
x_curr_list = []                                                                
x_next_list = []                                                                
for state in all_states:                                                        
    x_curr_list.append(state[:-1])                                              
    x_next_list.append(state[1:])                                               
                                                                                
x_curr = np.concatenate(x_curr_list)                                            
x_next = np.concatenate(x_next_list)                                            
                                                                                
x1_curr = x_curr[:, 0]                                                          
x2_curr = x_curr[:, 1]                                                          
x1_next = x_next[:, 0]                                                          
x2_next = x_next[:, 1]                                                          
                                                                                
# Identify threshold. Let's look at the range and try to find a split point.    
# A common threshold in these problems is 0.0 or a value that splits the        
behavior.                                                                       
# Let's check the distribution of x1.                                           
x1_min, x1_max = np.min(x1), np.max(x1)                                         
print(f"x1 range: {x1_min} to {x1_max}")                                        
                                                                                
# We'll use a threshold of 0.0 as a candidate and verify fit.                   
# If the data is all positive or all negative, we might need a different one.   
threshold = 0.0                                                                 
if x1_min > 0 or x1_max < 0:                                                    
    threshold = (x1_min + x1_max) / 2                                           
                                                                                
def fit_linear_model(X_data, Y_data):                                           
    # Model: Y = X * beta                                                       
    # X_data should have a column of ones for intercept                         
    beta, residuals, rank, s = np.linalg.lstsq(X_data, Y_data, rcond=None)      
    mse = residuals[0] / len(Y_data) if residuals.size > 0 else np.mean((Y_data 
- X_data @ beta)**2)                                                            
    return beta, mse                                                            
                                                                                
# Split data                                                                    
mask1 = x1_curr < threshold                                                     
mask2 = ~mask1                                                                  
                                                                                
def perform_fits(mask):                                                         
    xc = x_curr[mask]                                                           
    xn = x_next[mask]                                                           
                                                                                
    # Full model: x_next = a1*x1 + a2*x2 + b                                    
    X_full = np.column_stack([xc[:, 0], xc[:, 1], np.ones(len(xc))])            
    beta1_full, mse1_full = fit_linear_model(X_full, xn[:, 0])                  
    beta2_full, mse2_full = fit_linear_model(X_full, xn[:, 1])                  
                                                                                
    # Simple model: x1_next = a*x1 + b, x2_next = c*x2 + d                      
    X1_simple = np.column_stack([xc[:, 0], np.ones(len(xc))])                   
    beta1_simple, mse1_simple = fit_linear_model(X1_simple, xn[:, 0])           
                                                                                
    X2_simple = np.column_stack([xc[:, 1], np.ones(len(xc))])                   
    beta2_simple, mse2_simple = fit_linear_model(X2_simple, xn[:, 1])           
                                                                                
    return (beta1_full, beta2_full, mse1_full + mse2_full), (beta1_simple,      
beta2_simple, mse1_simple + mse2_simple)                                        
                                                                                
res1_full, res1_simple = perform_fits(mask1)                                    
res2_full, res2_simple = perform_fits(mask2)                                    
                                                                                
print(f"Mode 1 (x1 < {threshold}): Full MSE: {res1_full[2]:.8f}, Simple MSE:    
