    if 'x' in data:                                                             
        x = data['x']                                                           
        all_x1.append(x[:, 0])                                                  
        all_x2.append(x[:, 1])                                                  
    elif 'x1' in data and 'x2' in data:                                         
        all_x1.append(data['x1'])                                               
        all_x2.append(data['x2'])                                               
    else:                                                                       
        # Fallback to checking the first two keys if names differ               
        keys = list(data.keys())                                                
        all_x1.append(data[keys[0]])                                            
        all_x2.append(data[keys[1]])                                            
                                                                                
def solve_dynamics(x, y):                                                       
    x = x.reshape(-1, 1)                                                        
    model = LinearRegression().fit(x, y)                                        
    return model.coef_[0], model.intercept_                                     
                                                                                
