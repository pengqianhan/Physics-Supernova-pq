import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
def analyze_data(file_paths):                                                   
    all_x1 = []                                                                 
    all_x2 = []                                                                 
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        # Assuming the npz contains arrays named 'x' where x[:, 0] is x1 and    
x[:, 1] is x2                                                                   
        # If the keys are different, I'll need to check. Let's list keys first. 
