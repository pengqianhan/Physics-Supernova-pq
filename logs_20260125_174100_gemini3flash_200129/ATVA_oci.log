import numpy as np                                                              
from scipy.stats import linregress                                              
                                                                                
data_files = ['data_all/ATVA/oci/sample_0.npz',                                 
'data_all/ATVA/oci/sample_1.npz', 'data_all/ATVA/oci/sample_2.npz']             
                                                                                
mode_data = {                                                                   
    'mode1': {'x1_prev': [], 'x1_curr': [], 'x2_prev': [], 'x2_curr': []},      
    'mode2': {'x1_prev': [], 'x1_curr': [], 'x2_prev': [], 'x2_curr': []}       
}                                                                               
                                                                                
guards = []                                                                     
                                                                                
for f in data_files:                                                            
    data = np.load(f)                                                           
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    dx1 = np.diff(x1)                                                           
    ddx1 = np.diff(dx1)                                                         
    switches = np.where(np.abs(ddx1) > 0.0001)[0]                               
                                                                                
    # Add start and end indices for partitioning                                
    # switches indices are where the jump happens between dx[i] and dx[i+1]     
    # so the segments are (0, switches[0]+1), (switches[0]+1, switches[1]+1),   
...                                                                             
    segments = []                                                               
    curr = 0                                                                    
    for s in switches:                                                          
        segments.append((curr, s + 1))                                          
        curr = s + 1                                                            
    segments.append((curr, len(x1) - 1))                                        
                                                                                
    for start, end in segments:                                                 
        seg_x1 = x1[start:end+1]                                                
        seg_x2 = x2[start:end+1]                                                
                                                                                
        # Determine mode by the sign of average dx1 or similar                  
        avg_dx1 = np.mean(np.diff(seg_x1))                                      
                                                                                
        # Let's say Mode 1 has one characteristic and Mode 2 has another        
        # Based on previous output, dx1 was ~ -0.03 or ~0.008 or -0.002         
        # Let's see all avg_dx1                                                 
        mode = 'mode1' if avg_dx1 > 0 else 'mode2'                              
                                                                                
        mode_data[mode]['x1_prev'].extend(seg_x1[:-1])                          
        mode_data[mode]['x1_curr'].extend(seg_x1[1:])                           
        mode_data[mode]['x2_prev'].extend(seg_x2[:-1])                          
        mode_data[mode]['x2_curr'].extend(seg_x2[1:])                           
                                                                                
    for s in switches:                                                          
        guards.append(x1[s+1])                                                  
                                                                                
# Regression                                                                    
results = {}                                                                    
for m in ['mode1', 'mode2']:                                                    
    if len(mode_data[m]['x1_prev']) > 0:                                        
        slope1, intercept1, r1, p1, se1 = linregress(mode_data[m]['x1_prev'],   
mode_data[m]['x1_curr'])                                                        
        slope2, intercept2, r2, p2, se2 = linregress(mode_data[m]['x2_prev'],   
mode_data[m]['x2_curr'])                                                        
        results[m] = {                                                          
            'alpha1': slope1, 'beta1': intercept1,                              
            'alpha2': slope2, 'beta2': intercept2                               
        }                                                                       
                                                                                
print("Results:", results)                                                      
print("Guards (unique):", np.sort(np.unique(guards)))                           
                                                                                
