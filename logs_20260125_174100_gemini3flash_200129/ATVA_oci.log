import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def process():                                                                  
    final_output = []                                                           
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x1, x2 = data['state'][0], data['state'][1]                             
        dx1, dx2 = np.diff(x1), np.diff(x2)                                     
        ddx1, ddx2 = np.diff(dx1), np.diff(dx2)                                 
                                                                                
        # Max of absolute differences                                           
        crit = np.maximum(np.abs(ddx1), np.abs(ddx2))                           
        thresh = np.mean(crit) + 10 * np.std(crit)                              
        trans_idxs = np.where(crit > thresh)[0] + 1 # idx of first point in new 
mode                                                                            
                                                                                
        # debounce                                                              
        if len(trans_idxs) > 0:                                                 
            filtered = [trans_idxs[0]]                                          
            for t in trans_idxs[1:]:                                            
                if t - filtered[-1] > 10: filtered.append(t)                    
            trans_idxs = filtered                                               
                                                                                
        states_before = [(x1[i], x2[i]) for i in trans_idxs]                    
                                                                                
        # Fits                                                                  
        edges = [0] + list(trans_idxs) + [len(x1)-1]                            
        fits = []                                                               
        for i in range(len(edges)-1):                                           
            s, e = edges[i], edges[i+1]                                         
            # y = m*x + b => dx = -a*x + b                                      
            a, b, _, _, _ = stats.linregress(x1[s:e], dx1[s:e])                 
            c, d, _, _, _ = stats.linregress(x2[s:e], dx2[s:e])                 
            fits.append((-a, b, -c, d))                                         
                                                                                
        final_output.append({                                                   
            'trans_idxs': trans_idxs,                                           
            'states': states_before,                                            
            'fits': fits                                                        
        })                                                                      
    return final_output                                                         
                                                                                
res = process()                                                                 
# Print out first few for reporting                                             
for i, r in enumerate(res):                                                     
    print(f"Sample {i} states: {r['states'][:3]}")                              
    print(f"Sample {i} fit example: {r['fits'][0]}")                            
