m1_x2_pairs = []                                                                
m2_x1_pairs = []                                                                
m2_x2_pairs = []                                                                
trough_vals = []                                                                
peak_vals = []                                                                  
                                                                                
for x1, x2 in zip(all_x1, all_x2):                                              
    dx1 = np.diff(x1)                                                           
