import numpy as np                                                              
                                                                                
# Load the data                                                                 
data_files = ['data_all/ATVA/oci/sample_0.npz',                                 
'data_all/ATVA/oci/sample_1.npz', 'data_all/ATVA/oci/sample_2.npz']             
dt = 0.001                                                                      
                                                                                
all_states = []                                                                 
all_inputs = []                                                                 
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    all_states.append(data['state'])                                            
    if 'input' in data.files:                                                   
        all_inputs.append(data['input'])                                        
    else:                                                                       
        all_inputs.append(None)                                                 
                                                                                
# Let's inspect the data                                                        
for i in range(3):                                                              
    print(f"Sample {i}: state shape {all_states[i].shape}, input {all_inputs[i] 
if all_inputs[i] is None else all_inputs[i].shape}")                            
    if all_inputs[i] is not None:                                               
        print(f"First 5 inputs: {all_inputs[i][:5].flatten()}")                 
                                                                                
# If input is constant or zero, then modes are internal.                        
# Let's compute derivatives for all points.                                     
x_curr_all = []                                                                 
x_next_all = []                                                                 
dx_dt_all = []                                                                  
                                                                                
for s in all_states:                                                            
    xc = s[:-1]                                                                 
    xn = s[1:]                                                                  
    dx = (xn - xc) / dt                                                         
    x_curr_all.append(xc)                                                       
    x_next_all.append(xn)                                                       
    dx_dt_all.append(dx)                                                        
                                                                                
x_curr = np.concatenate(x_curr_all)                                             
x_next = np.concatenate(x_next_all)                                             
dx_dt = np.concatenate(dx_dt_all)                                               
                                                                                
x1 = x_curr[:, 0]                                                               
x2 = x_curr[:, 1]                                                               
dx1 = dx_dt[:, 0]                                                               
dx2 = dx_dt[:, 1]                                                               
                                                                                
# Check if there are distinct clusters in (x1, dx1)                             
# Maybe the modes are separated by a threshold in x1.                           
# Let's look at the distribution of dx1.                                        
print(f"dx1 range: {np.min(dx1):.4f} to {np.max(dx1):.4f}")                     
print(f"dx2 range: {np.min(dx2):.4f} to {np.max(dx2):.4f}")                     
                                                                                
# Heuristic clustering: split by mean of dx1 if it's bimodal                    
mean_dx1 = np.mean(dx1)                                                         
mode_a_mask = dx1 < mean_dx1                                                    
mode_b_mask = ~mode_a_mask                                                      
                                                                                
def solve_lstsq(A, b):                                                          
    # Solves Ax = b                                                             
    return np.linalg.lstsq(A, b, rcond=None)[0]                                 
                                                                                
def fit_models(mask):                                                           
    if np.sum(mask) < 2: return None                                            
    xc = x_curr[mask]                                                           
    xn = x_next[mask]                                                           
                                                                                
    # Model 1: Full x1[1] = a11*x1 + a12*x2 + b1                                
    A_full = np.column_stack([xc[:, 0], xc[:, 1], np.ones(len(xc))])            
    params_x1_full = solve_lstsq(A_full, xn[:, 0])                              
    params_x2_full = solve_lstsq(A_full, xn[:, 1])                              
                                                                                
    # Model 2: Simple x1[1] = a1*x1 + b1                                        
    A_sim1 = np.column_stack([xc[:, 0], np.ones(len(xc))])                      
    params_x1_sim = solve_lstsq(A_sim1, xn[:, 0])                               
    A_sim2 = np.column_stack([xc[:, 1], np.ones(len(xc))])                      
    params_x2_sim = solve_lstsq(A_sim2, xn[:, 1])                               
                                                                                
    # Compare MSE                                                               
    mse_full = np.mean((xn[:, 0] - np.dot(A_full, params_x1_full))**2) + \      
               np.mean((xn[:, 1] - np.dot(A_full, params_x2_full))**2)          
    mse_sim = np.mean((xn[:, 0] - np.dot(A_sim1, params_x1_sim))**2) + \        
              np.mean((xn[:, 1] - np.dot(A_sim2, params_x2_sim))**2)            
                                                                                
    return {                                                                    
        'full': (params_x1_full, params_x2_full, mse_full),                     
        'simple': (params_x1_sim, params_x2_sim, mse_sim)                       
    }                                                                           
                                                                                
res_a = fit_models(mode_a_mask)                                                 
res_b = fit_models(mode_b_mask)                                                 
                                                                                
print("\nMode A results (dx1 < mean):")                                         
if res_a:                                                                       
    print(f"Full MSE: {res_a['full'][2]:.2e}, Simple MSE:                       
{res_a['simple'][2]:.2e}")                                                      
print("Mode B results (dx1 >= mean):")                                          
if res_b:                                                                       
    print(f"Full MSE: {res_b['full'][2]:.2e}, Simple MSE:                       
