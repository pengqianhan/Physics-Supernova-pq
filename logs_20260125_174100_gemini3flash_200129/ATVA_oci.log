<code>                                                                          
import numpy as np                                                              
from scipy.stats import linregress                                              
                                                                                
dt = 0.001                                                                      
data_inc_x1 = {'x1': [], 'dx1': [], 'x2': [], 'dx2': []}                        
data_dec_x1 = {'x1': [], 'dx1': [], 'x2': [], 'dx2': []}                        
transitions_inc_to_dec = []                                                     
transitions_dec_to_inc = []                                                     
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    # Calculate derivatives                                                     
    dx1 = (x1[1:] - x1[:-1]) / dt                                               
    dx2 = (x2[1:] - x2[:-1]) / dt                                               
                                                                                
    # Values at current time step (for regression)                              
    x1_val = x1[:-1]                                                            
    x2_val = x2[:-1]                                                            
                                                                                
    # Detect sign of derivative to determine mode                               
    # Note: Using np.sign might have issues with 0, but we can assume dx1 is    
mostly non-zero                                                                 
    # Transitions occur when sign(dx1[i]) != sign(dx1[i+1])                     
    signs = np.sign(dx1)                                                        
                                                                                
    for i in range(len(signs)):                                                 
        if signs[i] > 0:                                                        
            data_inc_x1['x1'].append(x1_val[i])                                 
            data_inc_x1['dx1'].append(dx1[i])                                   
            data_inc_x1['x2'].append(x2_val[i])                                 
            data_inc_x1['dx2'].append(dx2[i])                                   
        elif signs[i] < 0:                                                      
            data_dec_x1['x1'].append(x1_val[i])                                 
            data_dec_x1['dx1'].append(dx1[i])                                   
            data_dec_x1['x2'].append(x2_val[i])                                 
            data_dec_x1['dx2'].append(dx2[i])                                   
                                                                                
        # Check for transition                                                  
        if i < len(signs) - 1:                                                  
            if signs[i] > 0 and signs[i+1] < 0:                                 
                # Transition from increasing to decreasing                      
                transitions_inc_to_dec.append(x1[i+1])                          
            elif signs[i] < 0 and signs[i+1] > 0:                               
                # Transition from decreasing to increasing                      
                transitions_dec_to_inc.append(x1[i+1])                          
                                                                                
# Perform Linear Regressions                                                    
def get_coeffs(x, y):                                                           
    slope, intercept, r_value, p_value, std_err = linregress(x, y)              
    return slope, intercept                                                     
                                                                                
# Increasing mode                                                               
a_inc, b_inc = get_coeffs(data_inc_x1['x1'], data_inc_x1['dx1'])                
c_inc, d_inc = get_coeffs(data_inc_x1['x2'], data_inc_x1['dx2'])                
                                                                                
# Decreasing mode                                                               
a_dec, b_dec = get_coeffs(data_dec_x1['x1'], data_dec_x1['dx1'])                
c_dec, d_dec = get_coeffs(data_dec_x1['x2'], data_dec_x1['dx2'])                
                                                                                
# Results                                                                       
results = {                                                                     
    'inc_coeffs': (a_inc, b_inc, c_inc, d_inc),                                 
    'dec_coeffs': (a_dec, b_dec, c_dec, d_dec),                                 
    'thresh_inc_to_dec': np.mean(transitions_inc_to_dec),                       
    'thresh_dec_to_inc': np.mean(transitions_dec_to_inc)                        
}                                                                               
                                                                                
print(results)                                                                  
                                                                                
