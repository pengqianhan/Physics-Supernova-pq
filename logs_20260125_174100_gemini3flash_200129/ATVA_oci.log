avg_reset_1to2 = np.mean(resets_1to2, axis=0) if resets_1to2 else np.zeros(2)   
avg_reset_2to1 = np.mean(resets_2to1, axis=0) if resets_2to1 else np.zeros(2)   
                                                                                
print("Mode 1 A:", A1)                                                          
print("Mode 1 B:", B1)                                                          
print("Mode 2 A:", A2)                                                          
print("Mode 2 B:", B2)                                                          
print("Threshold 1->2 (max x1):", threshold_1to2)                               
print("Threshold 2->1 (min x1):", threshold_2to1)                               
print("Average Reset 1->2:", avg_reset_1to2)                                    
print("Average Reset 2->1:", avg_reset_2to1)                                    
                                                                                
