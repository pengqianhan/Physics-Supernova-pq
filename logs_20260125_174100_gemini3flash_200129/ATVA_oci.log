m1_x2_pairs = np.array(m1_x2_pairs)                                             
m2_x1_pairs = np.array(m2_x1_pairs)                                             
m2_x2_pairs = np.array(m2_x2_pairs)                                             
                                                                                
a11, b11 = solve_dynamics(m1_x1_pairs[:, 0], m1_x1_pairs[:, 1])                 
a12, b12 = solve_dynamics(m1_x2_pairs[:, 0], m1_x2_pairs[:, 1])                 
a21, b21 = solve_dynamics(m2_x1_pairs[:, 0], m2_x1_pairs[:, 1])                 
a22, b22 = solve_dynamics(m2_x2_pairs[:, 0], m2_x2_pairs[:, 1])                 
                                                                                
threshold_trough = np.mean(trough_vals) if trough_vals else None                
threshold_peak = np.mean(peak_vals) if peak_vals else None                      
                                                                                
print(f"Mode 1: a11={a11:.6f}, b11={b11:.6f}, a12={a12:.6f}, b12={b12:.6f}")    
print(f"Mode 2: a21={a21:.6f}, b21={b21:.6f}, a22={a22:.6f}, b22={b22:.6f}")    
print(f"Trough (M1->M2): {threshold_trough}, Peak (M2->M1): {threshold_peak}")  
                                                                                
final_answer({                                                                  
