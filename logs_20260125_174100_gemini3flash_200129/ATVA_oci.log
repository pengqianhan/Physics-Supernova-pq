def fit_linear_manual(X_vars, y):                                               
    # X_vars is a list of arrays                                                
    A = np.vstack([*X_vars, np.ones(len(y))]).T                                 
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    # Calculate R^2                                                             
