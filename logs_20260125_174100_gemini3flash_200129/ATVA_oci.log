import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
from scipy.stats import linregress                                              
                                                                                
# Load data from the first sample                                               
data = np.load('data_all/ATVA/oci/sample_0.npz')                                
print("Keys:", data.files)                                                      
                                                                                
t = data['t']                                                                   
x = data['x']  # Assuming x is (N, 2) or contains x1, x2                        
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
dt = np.diff(t)                                                                 
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
                                                                                
# Midpoints for states corresponding to derivatives                             
x1_mid = (x1[:-1] + x1[1:]) / 2                                                 
x2_mid = (x2[:-1] + x2[1:]) / 2                                                 
                                                                                
# Mode segmentation: x1 increases in one, decreases in the other                
mode1_idx = dx1 > 0                                                             
mode2_idx = dx1 < 0                                                             
                                                                                
def fit_mode(xm, dx, mask):                                                     
    # Fit dx = a * xm + b                                                       
    slope, intercept, r_value, p_value, std_err = linregress(xm[mask], dx[mask])
    return slope, intercept                                                     
                                                                                
# Mode 1 parameters                                                             
a1_m1, b1_m1 = fit_mode(x1_mid, dx1, mode1_idx)                                 
a2_m1, b2_m1 = fit_mode(x2_mid, dx2, mode1_idx)                                 
                                                                                
# Mode 2 parameters                                                             
a1_m2, b1_m2 = fit_mode(x1_mid, dx1, mode2_idx)                                 
a2_m2, b2_m2 = fit_mode(x2_mid, dx2, mode2_idx)                                 
                                                                                
# Switching points                                                              
# Identify where mode1_idx changes                                              
transitions = np.where(mode1_idx[:-1] != mode1_idx[1:])[0]                      
switch_x1 = x1[transitions + 1]                                                 
switch_x2 = x2[transitions + 1]                                                 
                                                                                
print(f"Mode 1 (Increasing x1): a1={a1_m1:.4f}, b1={b1_m1:.4f}, a2={a2_m1:.4f}, 
b2={b2_m1:.4f}")                                                                
print(f"Mode 2 (Decreasing x1): a1={a1_m2:.4f}, b1={b1_m2:.4f}, a2={a2_m2:.4f}, 
b2={b2_m2:.4f}")                                                                
print(f"Switching thresholds (x1): {np.unique(np.round(switch_x1, 2))}")        
print(f"Switching thresholds (x2): {np.unique(np.round(switch_x2, 2))}")        
                                                                                
final_results = {                                                               
    "mode1": {"a1": a1_m1, "b1": b1_m1, "a2": a2_m1, "b2": b2_m1},              
    "mode2": {"a1": a1_m2, "b1": b1_m2, "a2": a2_m2, "b2": b2_m2},              
    "switches": {"x1": np.unique(np.round(switch_x1, 4)).tolist(), "x2":        
np.unique(np.round(switch_x2, 4)).tolist()}                                     
}                                                                               
                                                                                
