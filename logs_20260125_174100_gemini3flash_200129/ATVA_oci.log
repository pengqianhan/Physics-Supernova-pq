import numpy as np                                                              
from scipy.stats import linregress                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/ATVA/oci/sample_0.npz')                                
state = data['state']                                                           
x1 = state[0]                                                                   
x2 = state[1]                                                                   
dt = 0.001                                                                      
n = len(x1)                                                                     
                                                                                
# Compute derivatives using finite differences                                  
dx1 = (x1[1:] - x1[:-1]) / dt                                                   
dx2 = (x2[1:] - x2[:-1]) / dt                                                   
                                                                                
# Identify modes: Mode 1 (decreasing x1), Mode 2 (increasing x1)                
# To be robust, we'll identify segments between peaks and valleys.              
# Since x1 is likely smooth, we can look at the sign of dx1.                    
modes = np.zeros(n-1)                                                           
modes[dx1 < 0] = 1                                                              
modes[dx1 >= 0] = 2                                                             
                                                                                
# Segment the data                                                              
mode1_indices = np.where(modes == 1)[0]                                         
mode2_indices = np.where(modes == 2)[0]                                         
                                                                                
# Fit linear models for Mode 1                                                  
# dx1/dt = a1_1 * x1 + b1_1                                                     
# dx2/dt = a2_1 * x2 + b2_1                                                     
slope1_x1, intercept1_x1, _, _, _ = linregress(x1[mode1_indices],               
dx1[mode1_indices])                                                             
slope1_x2, intercept1_x2, _, _, _ = linregress(x2[mode1_indices],               
dx2[mode1_indices])                                                             
                                                                                
# Fit linear models for Mode 2                                                  
slope2_x1, intercept2_x1, _, _, _ = linregress(x1[mode2_indices],               
dx2[mode2_indices]) # wait, dx1                                                 
slope2_x1, intercept2_x1, _, _, _ = linregress(x1[mode2_indices],               
dx1[mode2_indices])                                                             
slope2_x2, intercept2_x2, _, _, _ = linregress(x2[mode2_indices],               
dx2[mode2_indices])                                                             
                                                                                
# Identify transition points (peaks and valleys of x1)                          
# A peak is when mode switches from 2 to 1. A valley is from 1 to 2.            
transitions = []                                                                
for i in range(1, len(modes)):                                                  
    if modes[i] != modes[i-1]:                                                  
        transitions.append({'from': modes[i-1], 'to': modes[i], 'index': i,     
'x1': x1[i]})                                                                   
                                                                                
valleys = [t['x1'] for t in transitions if t['from'] == 1 and t['to'] == 2]     
peaks = [t['x1'] for t in transitions if t['from'] == 2 and t['to'] == 1]       
                                                                                
print("Mode 1 Linear Model (dx1/dt = a1*x1 + b1):")                             
print(f"a1: {slope1_x1}, b1: {intercept1_x1}")                                  
print("Mode 1 Linear Model (dx2/dt = a2*x2 + b2):")                             
print(f"a2: {slope1_x2}, b2: {intercept1_x2}")                                  
                                                                                
print("\nMode 2 Linear Model (dx1/dt = a1*x1 + b1):")                           
print(f"a1: {slope2_x1}, b1: {intercept2_x1}")                                  
print("Mode 2 Linear Model (dx2/dt = a2*x2 + b2):")                             
print(f"a2: {slope2_x2}, b2: {intercept2_x2}")                                  
                                                                                
print("\nTransition points (Valleys - 1 to 2):", valleys)                       
print("Transition points (Peaks - 2 to 1):", peaks)                             
                                                                                
