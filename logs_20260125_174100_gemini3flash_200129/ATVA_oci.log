for i in range(len(modes) - 1):                                                 
    if modes[i] == 1 and modes[i+1] == 2:                                       
        transitions_1to2.append(x1[i+1])                                        
    elif modes[i] == 2 and modes[i+1] == 1:                                     
        transitions_2to1.append(x1[i+1])                                        
                                                                                
threshold_1to2 = np.mean(transitions_1to2) if transitions_1to2 else None        
threshold_2to1 = np.mean(transitions_2to1) if transitions_2to1 else None        
                                                                                
# Check for resets                                                              
# A reset would be a jump in x1 or x2 at the transition points.                 
# Let's check the difference between x[i] and x[i+1] at transitions.            
resets_1to2 = []                                                                
