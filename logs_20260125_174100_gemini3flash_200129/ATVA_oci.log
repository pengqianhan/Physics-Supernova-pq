data = np.load('data_all/ATVA/oci/sample_0.npz')                                
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Compute differences (assuming dt=1 for the derivative calculation as dt is not
provided)                                                                       
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
                                                                                
