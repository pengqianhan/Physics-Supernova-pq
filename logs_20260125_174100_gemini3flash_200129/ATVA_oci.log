            if i > 0 and dx1[i-1] > 0: # Transition 2 -> 1 (Peak)               
                peak_vals.append(x1[i])                                         
        elif dx1[i] > 0: # Mode 2                                               
            m2_x1_pairs.append((x1[i], x1[i+1]))                                
            m2_x2_pairs.append((x2[i], x2[i+1]))                                
            if i > 0 and dx1[i-1] < 0: # Transition 1 -> 2 (Trough)             
