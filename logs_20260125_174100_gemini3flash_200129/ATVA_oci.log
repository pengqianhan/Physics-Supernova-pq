import numpy as np                                                              
from scipy.optimize import curve_fit                                            
                                                                                
# Load the primary data file                                                    
data = np.load(DATA_FILE_PATH)                                                  
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Assuming dt = 0.01 based on typical dynamics data                             
dt = 0.01                                                                       
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
                                                                                
# Midpoints for matching derivatives                                            
x1_mid = (x1[:-1] + x1[1:]) / 2                                                 
x2_mid = (x2[:-1] + x2[1:]) / 2                                                 
                                                                                
# Identify switching points based on derivative jumps                           
# We look for large changes in the derivative of the derivatives                
ddx1 = np.diff(dx1)                                                             
ddx2 = np.diff(dx2)                                                             
combined_diff = np.abs(ddx1) + np.abs(ddx2)                                     
threshold = np.percentile(combined_diff, 99.9)                                  
switch_indices = np.where(combined_diff > threshold)[0] + 1                     
                                                                                
print(f"Switch indices identified: {switch_indices}")                           
                                                                                
# Segment the data                                                              
# Based on the prompt and the indices, we likely have:                          
# Mode 1: [0, switch_indices[0]]                                                
# Mode 2: [switch_indices[0], switch_indices[1]]                                
# Mode 1: [switch_indices[1], end]                                              
                                                                                
idx1 = switch_indices[0]                                                        
idx2 = switch_indices[1]                                                        
                                                                                
mode1_indices = np.concatenate([np.arange(0, idx1), np.arange(idx2, len(dx1))]) 
mode2_indices = np.arange(idx1, idx2)                                           
                                                                                
def linear_model(X, a, b, c):                                                   
    x1, x2 = X                                                                  
    return a*x1 + b*x2 + c                                                      
                                                                                
