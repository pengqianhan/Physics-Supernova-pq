import numpy as np                                                              
from scipy.stats import linregress                                              
                                                                                
# Load data                                                                     
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Assume dt = 0.01                                                              
dt = 0.01                                                                       
                                                                                
# Compute numerical derivatives                                                 
dx1_dt = (x1[1:] - x1[:-1]) / dt                                                
dx2_dt = (x2[1:] - x2[:-1]) / dt                                                
                                                                                
# Use state values at time t for regression                                     
x1_val = x1[:-1]                                                                
x2_val = x2[:-1]                                                                
                                                                                
# Segmenting data                                                               
mode_a_mask = dx1_dt > 0                                                        
mode_b_mask = dx1_dt < 0                                                        
                                                                                
# Mode A regression                                                             
# dx1/dt = a1_A * x1 + b1_A                                                     
# dx2/dt = a2_A * x2 + b2_A                                                     
a1_A, b1_A, r_val_1A, p_val_1A, std_err_1A = linregress(x1_val[mode_a_mask],    
dx1_dt[mode_a_mask])                                                            
a2_A, b2_A, r_val_2A, p_val_2A, std_err_2A = linregress(x2_val[mode_a_mask],    
dx2_dt[mode_a_mask])                                                            
                                                                                
# Mode B regression                                                             
# dx1/dt = a1_B * x1 + b1_B                                                     
# dx2/dt = a2_B * x2 + b2_B                                                     
a1_B, b1_B, r_val_1B, p_val_1B, std_err_1B = linregress(x1_val[mode_b_mask],    
dx1_dt[mode_b_mask])                                                            
a2_B, b2_B, r_val_2B, p_val_2B, std_err_2B = linregress(x2_val[mode_b_mask],    
dx2_dt[mode_b_mask])                                                            
                                                                                
print(f"Mode A: a1={a1_A}, b1={b1_A}, r^2={r_val_1A**2}")                       
print(f"Mode A: a2={a2_A}, b2={b2_A}, r^2={r_val_2A**2}")                       
print(f"Mode B: a1={a1_B}, b1={b1_B}, r^2={r_val_1B**2}")                       
print(f"Mode B: a2={a2_B}, b2={b2_B}, r^2={r_val_2B**2}")                       
                                                                                
# Identify transition points                                                    
# Switches from A to B (x1 stops increasing and starts decreasing)              
# Switches from B to A (x1 stops decreasing and starts increasing)              
# We find indices where the mode changes                                        
mode_a = (dx1_dt > 0).astype(int)                                               
transitions = np.diff(mode_a)                                                   
# transitions == -1: A -> B                                                     
# transitions == 1: B -> A                                                      
                                                                                
idx_AtoB = np.where(transitions == -1)[0]                                       
idx_BtoA = np.where(transitions == 1)[0]                                        
                                                                                
x1_AtoB = x1[idx_AtoB]                                                          
x1_BtoA = x1[idx_BtoA]                                                          
                                                                                
print("x1 at A to B transitions:", x1_AtoB)                                     
print("x1 at B to A transitions:", x1_BtoA)                                     
                                                                                
# Calculate mean thresholds                                                     
threshold_AtoB = np.mean(x1_AtoB)                                               
threshold_BtoA = np.mean(x1_BtoA)                                               
print(f"Average threshold A->B: {threshold_AtoB}")                              
print(f"Average threshold B->A: {threshold_BtoA}")                              
                                                                                
