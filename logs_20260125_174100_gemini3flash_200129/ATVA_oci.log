        # Based on standard trajectory data, 'x' or 'states' are common keys.   
        # Let's assume 'x' based on the task description of x1, x2.             
        x = data['x']                                                           
        all_x1.append(x[:, 0])                                                  
        all_x2.append(x[:, 1])                                                  
                                                                                
    x1 = np.concatenate(all_x1)                                                 
    x2 = np.concatenate(all_x2)                                                 
                                                                                
    # Identify modes                                                            
    # Mode 1: x1 is decreasing                                                  
    # Mode 2: x1 is increasing                                                  
                                                                                
    modes = []                                                                  
    for i in range(len(x1) - 1):                                                
        if x1[i+1] < x1[i]:                                                     
            modes.append(1)                                                     
        else:                                                                   
            modes.append(2)                                                     
    modes.append(modes[-1]) # match length                                      
    modes = np.array(modes)                                                     
                                                                                
    # Refine modes to handle noise if necessary, but let's try raw first        
    # Estimate thresholds                                                       
    peaks = []                                                                  
    troughs = []                                                                
    for i in range(1, len(x1) - 1):                                             
        if x1[i] > x1[i-1] and x1[i] > x1[i+1]:                                 
            peaks.append(x1[i])                                                 
        elif x1[i] < x1[i-1] and x1[i] < x1[i+1]:                               
            troughs.append(x1[i])                                               
                                                                                
    threshold_high = np.mean(peaks) if peaks else 0.64                          
    threshold_low = np.mean(troughs) if troughs else -0.64                      
                                                                                
    results = {}                                                                
    for m in [1, 2]:                                                            
