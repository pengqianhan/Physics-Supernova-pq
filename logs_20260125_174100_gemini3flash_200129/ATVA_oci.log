import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
from scipy.stats import linregress                                              
                                                                                
# Load data                                                                     
data_files = ['data_all/ATVA/oci/sample_0.npz',                                 
'data_all/ATVA/oci/sample_1.npz', 'data_all/ATVA/oci/sample_2.npz']             
                                                                                
modes_x1 = {1: [], 2: []}                                                       
modes_dx1 = {1: [], 2: []}                                                      
modes_x2 = {1: [], 2: []}                                                       
modes_dx2 = {1: [], 2: []}                                                      
                                                                                
guards = []                                                                     
                                                                                
for f in data_files:                                                            
    data = np.load(f)                                                           
    state = data['state']                                                       
    x1 = state[:, 0]                                                            
    x2 = state[:, 1]                                                            
                                                                                
    # Calculate differences                                                     
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    # Identify modes based on dx1 behavior                                      
    # Let's assume Mode 1 and Mode 2 can be separated by a threshold in dx1 or  
dx2                                                                             
    # In many of these tasks, dx1 jumps significantly.                          
    # Let's look at the distribution of dx1                                     
                                                                                
    # For now, let's find the threshold by looking at the jumps.                
    for i in range(len(dx1)):                                                   
        # Very simple mode detection: let's try to see if dx1 is positive or    
negative, or based on magnitude.                                                
        # Actually, let's try to cluster them or find the discontinuity.        
        # Usually Mode 1 might be dx1 = alpha1*x1 + beta1 and Mode 2 similarly. 
        # Let's use a simple heuristic: if dx1 > -0.01 it's Mode 1, else Mode 2?
        # (Based on DX1 range: -0.03 to 0.007)                                  
        if dx1[i] > -0.01:                                                      
            modes_x1[1].append(x1[i])                                           
            modes_dx1[1].append(dx1[i])                                         
            modes_x2[1].append(x2[i])                                           
            modes_dx2[1].append(dx2[i])                                         
        else:                                                                   
            modes_x1[2].append(x1[i])                                           
            modes_dx1[2].append(dx1[i])                                         
            modes_x2[2].append(x2[i])                                           
            modes_dx2[2].append(dx2[i])                                         
                                                                                
        # Detect switching                                                      
        if i > 0:                                                               
            # If the mode changed (heuristic)                                   
            m_prev = 1 if dx1[i-1] > -0.01 else 2                               
            m_curr = 1 if dx1[i] > -0.01 else 2                                 
            if m_prev != m_curr:                                                
                guards.append(x1[i])                                            
                                                                                
# Perform regressions                                                           
results = {}                                                                    
for m in [1, 2]:                                                                
    if len(modes_x1[m]) > 0:                                                    
        slope1, intercept1, r_val1, p_val1, std_err1 = linregress(modes_x1[m],  
modes_dx1[m])                                                                   
        slope2, intercept2, r_val2, p_val2, std_err2 = linregress(modes_x2[m],  
modes_dx2[m])                                                                   
        results[m] = {                                                          
            'alpha1': slope1, 'beta1': intercept1,                              
            'alpha2': slope2, 'beta2': intercept2                               
        }                                                                       
                                                                                
print("Mode 1:", results.get(1))                                                
print("Mode 2:", results.get(2))                                                
print("Guard conditions (x1 at switches):", np.unique(guards))                  
                                                                                
