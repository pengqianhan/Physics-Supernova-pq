```python                                                                       
import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def analyze_sample(sample_idx):                                                 
    data = np.load(DATA_FILE_PATHS[sample_idx])                                 
    state = data['state']                                                       
    x1, x2 = state[0], state[1]                                                 
                                                                                
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
    ddx1 = np.abs(np.diff(dx1))                                                 
    ddx2 = np.abs(np.diff(dx2))                                                 
                                                                                
    # Combined discontinuity detection                                          
    combined_dd = ddx1 + ddx2                                                   
    # Use a robust threshold                                                    
    threshold = np.mean(combined_dd) + 10 * np.std(combined_dd)                 
    trans_indices = np.where(combined_dd > threshold)[0] + 1                    
                                                                                
    # Filter indices that are too close (de-bounce)                             
    if len(trans_indices) > 0:                                                  
        filtered_indices = [trans_indices[0]]                                   
        for idx in trans_indices[1:]:                                           
            if idx - filtered_indices[-1] > 10:                                 
                filtered_indices.append(idx)                                    
        trans_indices = filtered_indices                                        
                                                                                
    print(f"Sample {sample_idx} transitions at: {trans_indices}")               
                                                                                
    # Values before switch                                                      
    results = []                                                                
    for idx in trans_indices:                                                   
        results.append((x1[idx], x2[idx]))                                      
                                                                                
    # Fit coefficients for each mode                                            
    # Modes are separated by trans_indices                                      
    mode_edges = [0] + list(trans_indices) + [len(x1)-1]                        
    fits = []                                                                   
    for i in range(len(mode_edges)-1):                                          
        start, end = mode_edges[i], mode_edges[i+1]                             
        if end - start < 5: continue                                            
                                                                                
        # Segment x and dx                                                      
        seg_x1 = x1[start:end]                                                  
        seg_dx1 = dx1[start:end]                                                
        seg_x2 = x2[start:end]                                                  
        seg_dx2 = dx2[start:end]                                                
                                                                                
        # Linear regression: dx = slope * x + intercept                         
        slope1, intercept1, r1, _, _ = stats.linregress(seg_x1, seg_dx1)        
        slope2, intercept2, r2, _, _ = stats.linregress(seg_x2, seg_dx2)        
                                                                                
        fits.append({                                                           
            'a': -slope1, 'b': intercept1,                                      
            'c': -slope2, 'd': intercept2                                       
        })                                                                      
                                                                                
    return trans_indices, results, fits                                         
                                                                                
# Let's run for all samples                                                     
