mode = (val > 0).astype(int)                                                    
                                                                                
def solve_dynamics(x_curr, x_next):                                             
    # Solves x_next = a * x_curr + b                                            
    # Matrix A = [[x_curr[0], 1], [x_curr[1], 1], ...]                          
    # Vector B = [x_next[0], x_next[1], ...]                                    
    A = np.vstack([x_curr, np.ones(len(x_curr))]).T                             
    p, residuals, rank, s = np.linalg.lstsq(A, x_next, rcond=None)              
    return p[0], p[1]                                                           
                                                                                
