import numpy as np                                                              
from scipy.stats import linregress                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/ATVA/oci/sample_0.npz')                                
state = data['state']                                                           
dt = 0.001                                                                      
                                                                                
# Correct extraction based on shape (2, 10001)                                  
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate derivatives                                                         
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
                                                                                
# Match state variables to the derivative indices                               
x1_m = x1[:-1]                                                                  
x2_m = x2[:-1]                                                                  
                                                                                
# Mode 1: dx1/dt < 0                                                            
mode1_idx = dx1 < 0                                                             
# Mode 2: dx1/dt > 0                                                            
mode2_idx = dx1 > 0                                                             
                                                                                
# Fitting Mode 1                                                                
if np.any(mode1_idx):                                                           
    slope11, intercept1, _, _, _ = linregress(x1_m[mode1_idx], dx1[mode1_idx])  
    slope12, intercept2, _, _, _ = linregress(x2_m[mode1_idx], dx2[mode1_idx])  
    mode1_params = {'a11': slope11, 'b1': intercept1, 'a22': slope12, 'b2':     
intercept2}                                                                     
else:                                                                           
    mode1_params = None                                                         
                                                                                
# Fitting Mode 2                                                                
if np.any(mode2_idx):                                                           
    slope21, intercept21, _, _, _ = linregress(x1_m[mode2_idx], dx1[mode2_idx]) 
    slope22, intercept22, _, _, _ = linregress(x2_m[mode2_idx], dx2[mode2_idx]) 
    mode2_params = {'A11': slope21, 'B1': intercept21, 'A22': slope22, 'B2':    
intercept22}                                                                    
else:                                                                           
    mode2_params = None                                                         
                                                                                
# Switching points                                                              
# 1 -> 2: dx1/dt switches from negative to positive                             
sw_12 = []                                                                      
# 2 -> 1: dx1/dt switches from positive to negative                             
sw_21 = []                                                                      
                                                                                
for i in range(len(dx1) - 1):                                                   
    if dx1[i] < 0 and dx1[i+1] > 0:                                             
        sw_12.append(x1[i+1])                                                   
    elif dx1[i] > 0 and dx1[i+1] < 0:                                           
        sw_21.append(x1[i+1])                                                   
                                                                                
avg_sw12 = np.mean(sw_12) if sw_12 else None                                    
avg_sw21 = np.mean(sw_21) if sw_21 else None                                    
                                                                                
print(f"Mode 1 params: {mode1_params}")                                         
print(f"Mode 2 params: {mode2_params}")                                         
print(f"Switch 1->2 (x1): {avg_sw12}")                                          
print(f"Switch 2->1 (x1): {avg_sw21}")                                          
                                                                                
