# Using the sign of dx1 to determine the mode                                   
signs = np.sign(dx1)                                                            
# Handle potential zeros in signs by filling them with the previous sign        
for i in range(1, len(signs)):                                                  
    if signs[i] == 0:                                                           
        signs[i] = signs[i-1]                                                   
                                                                                
switching_indices = []                                                          
for i in range(1, len(signs)):                                                  
    if signs[i] != signs[i-1]:                                                  
        switching_indices.append(i)                                             
                                                                                
# Mode identification:                                                          
# Mode 1: x1 decreasing (sign < 0)                                              
# Mode 2: x1 increasing (sign > 0)                                              
mode1_mask = signs < 0                                                          
mode2_mask = signs > 0                                                          
                                                                                
# Extract data for Mode 1                                                       
x1_m1 = x1[:-1][mode1_mask]                                                     
x2_m1 = x2[:-1][mode1_mask]                                                     
dx1_m1 = dx1[mode1_mask]                                                        
dx2_m1 = dx2[mode1_mask]                                                        
                                                                                
# Extract data for Mode 2                                                       
x1_m2 = x1[:-1][mode2_mask]                                                     
x2_m2 = x2[:-1][mode2_mask]                                                     
dx1_m2 = dx1[mode2_mask]                                                        
dx2_m2 = dx2[mode2_mask]                                                        
                                                                                
# Linear regression for Mode 1                                                  
# x1[1] = a * x1[0] + b => dx1 = a * x1 + b                                     
a1, b1 = np.polyfit(x1_m1, dx1_m1, 1)                                           
# x2[1] = c * x2[0] + d => dx2 = c * x2 + d                                     
c1, d1 = np.polyfit(x2_m1, dx2_m1, 1)                                           
                                                                                
# Linear regression for Mode 2                                                  
a2, b2 = np.polyfit(x1_m2, dx1_m2, 1)                                           
c2, d2 = np.polyfit(x2_m2, dx2_m2, 1)                                           
                                                                                
# Switching thresholds                                                          
switching_x1 = x1[switching_indices]                                            
min_threshold = np.min(switching_x1)                                            
max_threshold = np.max(switching_x1)                                            
                                                                                
print(f"Mode 1 parameters: a={a1}, b={b1}, c={c1}, d={d1}")                     
print(f"Mode 2 parameters: a={a2}, b={b2}, c={c2}, d={d2}")                     
print(f"Switching thresholds (x1): {min_threshold} to {max_threshold}")         
