          if 'x' in data:                                                       
              x = data['x']                                                     
          elif 'states' in data:                                                
              x = data['states']                                                
          else:                                                                 
              # Fallback to first key                                           
              x = data[list(data.keys())[0]]                                    
                                                                                
          all_x1.append(x[:, 0])                                                
          all_x2.append(x[:, 1])                                                
                                                                                
      # Process each file separately to identify transitions accurately         
      results_list = []                                                         
      peaks = []                                                                
      troughs = []                                                              
                                                                                
      # We want to collect (x[t], x[t+1]) pairs for each mode                   
      mode1_x1_pairs = []                                                       
      mode1_x2_pairs = []                                                       
      mode2_x1_pairs = []                                                       
      mode2_x2_pairs = []                                                       
                                                                                
      for i in range(len(all_x1)):                                              
          x1 = all_x1[i]                                                        
          x2 = all_x2[i]                                                        
                                                                                
          # Calculate diff to identify increasing/decreasing                    
          # Mode 1: Decreasing (x1[t+1] < x1[t])                                
          # Mode 2: Increasing (x1[t+1] > x1[t])                                
                                                                                
          for t in range(len(x1) - 1):                                          
              if x1[t+1] < x1[t]:                                               
                  # Mode 1                                                      
                  mode1_x1_pairs.append((x1[t], x1[t+1]))                       
                  mode1_x2_pairs.append((x2[t], x2[t+1]))                       
              else:                                                             
                  # Mode 2                                                      
                  mode2_x1_pairs.append((x1[t], x1[t+1]))                       
                  mode2_x2_pairs.append((x2[t], x2[t+1]))                       
                                                                                
          # Identify peaks and troughs for thresholds                           
          for t in range(1, len(x1) - 1):                                       
              if x1[t] > x1[t-1] and x1[t] > x1[t+1]:                           
                  peaks.append(x1[t])                                           
              elif x1[t] < x1[t-1] and x1[t] < x1[t+1]:                         
                  troughs.append(x1[t])                                         
                                                                                
      # Linear Regression using numpy.polyfit (y = ax + b)                      
      def get_coeffs(pairs):                                                    
          if not pairs: return 0, 0                                             
          X = np.array([p[0] for p in pairs])                                   
          Y = np.array([p[1] for p in pairs])                                   
          a, b = np.polyfit(X, Y, 1)                                            
          return a, b                                                           
                                                                                
