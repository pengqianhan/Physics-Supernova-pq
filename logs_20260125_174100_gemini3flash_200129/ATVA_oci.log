  a22, b22 = lin_reg(m2_x2_pairs)                                               
                                                                                
  threshold_trough = np.mean(troughs)                                           
  threshold_peak = np.mean(peaks)                                               
                                                                                
  print(f"a11: {a11}, b11: {b11}, a12: {a12}, b12: {b12}")                      
