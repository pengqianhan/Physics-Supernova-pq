  etc.                                                                          
  diff_dx2 = np.abs(np.diff(dx2))                                               
  threshold = np.max(diff_dx2) * 0.5                                            
  switches = np.where(diff_dx2 > threshold)[0] + 1                              
                                                                                
  # Filter consecutive switches                                                 
  filtered_switches = []                                                        
  if len(switches) > 0:                                                         
      filtered_switches.append(switches[0])                                     
      for s in switches[1:]:                                                    
          if s - filtered_switches[-1] > 100:                                   
              filtered_switches.append(s)                                       
                                                                                
  print(f"Detected switches: {filtered_switches}")                              
                                                                                
  # Segment and identify modes                                                  
  # Transition 1 -> 2 at x1 ~ 0.63, x2 ~ -0.45                                  
  # Transition 2 -> 1 at x1 ~ -0.64, x2 ~ 0.46                                  
  segments = []                                                                 
  start_idx = 0                                                                 
  for s in filtered_switches:                                                   
      segments.append(np.arange(start_idx, s))                                  
      start_idx = s                                                             
  segments.append(np.arange(start_idx, len(dx1)))                               
                                                                                
  mode_labels = []                                                              
  for i, seg in enumerate(segments):                                            
      # Peek at the end of the segment to see where it's switching              
      end_idx = seg[-1]                                                         
      if i < len(filtered_switches):                                            
          sx1, sx2 = x1[end_idx], x2[end_idx]                                   
          if abs(sx1 - 0.63) < 0.1: # Switching to Mode 2                       
              mode_labels.append(1) # Current segment is Mode 1                 
          else: # Switching to Mode 1                                           
              mode_labels.append(2) # Current segment is Mode 2                 
      else:                                                                     
          # Last segment: assume it follows the pattern                         
          mode_labels.append(3 - mode_labels[-1])                               
                                                                                
  # Correcting labels: if mode_labels[0] is 1, then segments[0] is Mode 1       
  m1_indices = np.concatenate([segments[i] for i, label in                      
  enumerate(mode_labels) if label == 1])                                        
  m2_indices = np.concatenate([segments[i] for i in range(len(segments)) if     
  mode_labels[i] == 2])                                                         
                                                                                
  def fit_linear_model(indices):                                                
      A = np.vstack([x1_mid[indices], x2_mid[indices],                          
  np.ones(len(indices))]).T                                                     
      sol1, _, _, _ = np.linalg.lstsq(A, dx1[indices], rcond=None)              
      sol2, _, _, _ = np.linalg.lstsq(A, dx2[indices], rcond=None)              
      return sol1, sol2                                                         
                                                                                
  m1_sol1, m1_sol2 = fit_linear_model(m1_indices)                               
  m2_sol1, m2_sol2 = fit_linear_model(m2_indices)                               
                                                                                
  # Guard checks                                                                
  m1_to_m2_states = []                                                          
  m2_to_m1_states = []                                                          
  for i, s_idx in enumerate(filtered_switches):                                 
      if mode_labels[i] == 1:                                                   
          m1_to_m2_states.append((x1[s_idx], x2[s_idx]))                        
      else:                                                                     
          m2_to_m1_states.append((x1[s_idx], x2[s_idx]))                        
                                                                                
  avg_m1_m2 = np.mean(m1_to_m2_states, axis=0) if m1_to_m2_states else [0,0]    
  avg_m2_m1 = np.mean(m2_to_m1_states, axis=0) if m2_to_m1_states else [0,0]    
                                                                                
  print(f"Mode 1 -> 2 avg: x1={avg_m1_m2[0]:.4f}, x2={avg_m1_m2[1]:.4f}")       
  print(f"Mode 2 -> 1 avg: x1={avg_m2_m1[0]:.4f}, x2={avg_m2_m1[1]:.4f}")       
                                                                                
  # Final Answer assembly                                                       
  m1_eq = f"dx1/dt = {m1_sol1[0]:.4f}*x1 + {m1_sol1[1]:.4f}*x2 +                
  {m1_sol1[2]:.4f}\ndx2/dt = {m1_sol2[0]:.4f}*x1 + {m1_sol2[1]:.4f}*x2 +        
  {m1_sol2[2]:.4f}"                                                             
  m2_eq = f"dx1/dt = {m2_sol1[0]:.4f}*x1 + {m2_sol1[1]:.4f}*x2 +                
  {m2_sol1[2]:.4f}\ndx2/dt = {m2_sol2[0]:.4f}*x1 + {m2_sol2[1]:.4f}*x2 +        
  {m2_sol2[2]:.4f}"                                                             
                                                                                
  final_answer(f"### 1. Task outcome (short version):\nThe analysis of Sample   
