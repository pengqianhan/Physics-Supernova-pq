from scipy import stats                                                         
                                                                                
# Load the data                                                                 
data = np.load(DATA_FILE_PATH)                                                  
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate derivatives (dx1/dt)                                                
# Assuming dt=1 for the index-based differencing                                
dx1 = np.diff(x1)                                                               
                                                                                
# Indices for Mode 1: dx1/dt > 0.01                                             
mode1_indices = np.where(dx1 > 0.01)[0]                                         
# Indices for Mode 2: dx1/dt < -0.01                                            
mode2_indices = np.where(dx1 < -0.01)[0]                                        
                                                                                
def fit_linear_model(indices, x1, x2):                                          
    # We want to fit x[k+1] = A*x[k] + B                                        
    # x1[k+1] = a11*x1[k] + a12*x2[k] + b1                                      
    # x2[k+1] = a21*x1[k] + a22*x2[k] + b2                                      
                                                                                
    # Filter indices to ensure k+1 is also in the data                          
    valid_indices = [i for i in indices if i + 1 < len(x1)]                     
                                                                                
    if not valid_indices:                                                       
        return None, None                                                       
                                                                                
    X = np.column_stack([x1[valid_indices], x2[valid_indices],                  
np.ones(len(valid_indices))])                                                   
    Y1 = x1[np.array(valid_indices) + 1]                                        
    Y2 = x2[np.array(valid_indices) + 1]                                        
                                                                                
    # Solve for [a11, a12, b1]                                                  
    w1, _, _, _ = np.linalg.lstsq(X, Y1, rcond=None)                            
    # Solve for [a21, a22, b2]                                                  
    w2, _, _, _ = np.linalg.lstsq(X, Y2, rcond=None)                            
                                                                                
    A = np.array([[w1[0], w1[1]], [w2[0], w2[1]]])                              
    B = np.array([w1[2], w2[2]])                                                
    return A, B                                                                 
                                                                                
# Fit models                                                                    
A1, B1 = fit_linear_model(mode1_indices, x1, x2)                                
A2, B2 = fit_linear_model(mode2_indices, x1, x2)                                
                                                                                
# Find switching thresholds                                                     
# Transition 1 -> 2: x1 reaches max                                             
# Transition 2 -> 1: x1 reaches min                                             
# We look for where the mode changes in the sequence                            
modes = np.zeros(len(dx1))                                                      
modes[mode1_indices] = 1                                                        
modes[mode2_indices] = 2                                                        
                                                                                
transitions_1to2 = []                                                           
