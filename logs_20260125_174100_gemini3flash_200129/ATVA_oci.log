import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load the data                                                                 
data0 = np.load('data_all/ATVA/oci/sample_0.npz')                               
data1 = np.load('data_all/ATVA/oci/sample_1.npz')                               
