plt.plot(t0, x1, label='x1')                                                    
plt.plot(t0, x2, label='x2')                                                    
plt.legend()                                                                    
plt.subplot(2,1,2)                                                              
plt.plot(t_mid, dx1, label='dx1/dt')                                            
plt.plot(t_mid, dx2, label='dx2/dt')                                            
plt.legend()                                                                    
plt.savefig('dynamics.png')                                                     
                                                                                
