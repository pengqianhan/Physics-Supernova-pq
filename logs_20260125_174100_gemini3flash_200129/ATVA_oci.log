import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the first NPZ file                                                       
data = np.load('data_all/ATVA/oci/sample_0.npz')                                
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Compute differences                                                           
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
                                                                                
# Identify switching points where x1 changes direction                          
# Sign of dx1                                                                   
signs = np.sign(dx1)                                                            
# We need to find where signs change.                                           
# Handle potential zeros in signs by filling them with the previous sign        
for i in range(1, len(signs)):                                                  
    if signs[i] == 0:                                                           
        signs[i] = signs[i-1]                                                   
                                                                                
switching_indices = []                                                          
for i in range(1, len(signs)):                                                  
    if signs[i] != signs[i-1]:                                                  
        switching_indices.append(i)                                             
                                                                                
print("Switching indices:", switching_indices)                                  
print("x1 values at switching points:", x1[switching_indices])                  
print("x2 values at switching points:", x2[switching_indices])                  
                                                                                
# For each point t, decide which mode it belongs to                             
# dx1[t] corresponds to interval [t, t+1]                                       
# We'll associate (x1[t], dx1[t]) and (x2[t], dx2[t]) with the mode at index t. 
modes = signs # signs has length N-1                                            
                                                                                
mode1_indices = np.where(modes < 0)[0] # Decreasing                             
mode2_indices = np.where(modes > 0)[0] # Increasing                             
                                                                                
print(f"Number of points in Mode 1: {len(mode1_indices)}")                      
print(f"Number of points in Mode 2: {len(mode2_indices)}")                      
                                                                                
# Linear regression for Mode 1                                                  
# Target: dx1/dt = a1 * x1 + b1, dx2/dt = c1 * x2 + d1                          
# I will assume dt = 1 for now unless I find a better estimate.                 
# If the task says "x1[1] = ...", it might refer to the derivative.             
# Let's perform regression.                                                     
def perform_regression(indices, x_vals, dx_vals):                               
    X = x_vals[indices].reshape(-1, 1)                                          
    y = dx_vals[indices]                                                        
    model = LinearRegression().fit(X, y)                                        
    return model.coef_[0], model.intercept_                                     
                                                                                
a1, b1 = perform_regression(mode1_indices, x1, dx1)                             
c1, d1 = perform_regression(mode1_indices, x2, dx2)                             
                                                                                
a2, b2 = perform_regression(mode2_indices, x1, dx1)                             
c2, d2 = perform_regression(mode2_indices, x2, dx2)                             
                                                                                
print(f"Mode 1 (Decreasing): a={a1}, b={b1}, c={c1}, d={d1}")                   
print(f"Mode 2 (Increasing): a={a2}, b={b2}, c={c2}, d={d2}")                   
                                                                                
