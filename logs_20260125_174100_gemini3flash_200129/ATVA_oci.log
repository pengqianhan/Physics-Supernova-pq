import numpy as np                                                              
                                                                                
# Load the first NPZ file                                                       
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
# Based on the shape (2, 10001), x1 is the first row and x2 is the second row   
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Print the state at index 0                                                    
print(f"State at index 0: x1 = {x1[0]}, x2 = {x2[0]}")                          
                                                                                
# Calculate the numerical derivatives (differences)                             
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
                                                                                
# Identify sign changes in derivatives                                          
# sign(dx[i]) != sign(dx[i-1]) implies a change at index i                      
sign_dx1 = np.sign(dx1)                                                         
sign_dx2 = np.sign(dx2)                                                         
                                                                                
# Indices where sign changes (using indices relative to the original state      
array)                                                                          
# np.diff(sign_dx) != 0 gives indices where the sign changed between j and j+1  
in the dx array.                                                                
# Since dx[j] = x[j+1] - x[j], a sign change between dx[j-1] and dx[j] occurs at
index j.                                                                        
switches_sign_x1 = np.where(np.diff(sign_dx1) != 0)[0] + 1                      
switches_sign_x2 = np.where(np.diff(sign_dx2) != 0)[0] + 1                      
                                                                                
# Identify jumps in derivatives (significant change in velocity)                
ddx1 = np.abs(np.diff(dx1))                                                     
ddx2 = np.abs(np.diff(dx2))                                                     
                                                                                
# Threshold for a 'jump' (using 10 times the median to avoid noise)             
threshold1 = 10 * np.median(ddx1) if len(ddx1) > 0 else 0                       
threshold2 = 10 * np.median(ddx2) if len(ddx2) > 0 else 0                       
                                                                                
switches_jump_x1 = np.where(ddx1 > threshold1)[0] + 1 if threshold1 > 0 else [] 
switches_jump_x2 = np.where(ddx2 > threshold2)[0] + 1 if threshold2 > 0 else [] 
                                                                                
# Combine and sort all unique switch indices                                    
all_switches = np.unique(np.concatenate([switches_sign_x1, switches_sign_x2,    
switches_jump_x1, switches_jump_x2]))                                           
all_switches = np.sort(all_switches)                                            
                                                                                
print(f"Total potential mode switches detected: {len(all_switches)}")           
print("First 5 mode switches:")                                                 
for idx in all_switches[:5]:                                                    
    # Ensure index is within bounds                                             
    if idx < len(x1):                                                           
        v1 = x1[idx]                                                            
        v2 = x2[idx]                                                            
        combined = v1 + 1.4 * v2                                                
        print(f"Switch at index {idx}: x1 = {v1:.6f}, x2 = {v2:.6f}, x1 + 1.4*x2
= {combined:.6f}")                                                              
                                                                                
