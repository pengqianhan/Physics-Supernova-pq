import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data                                                                 
data = np.load(DATA_FILE_PATH)                                                  
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Prepare sequences for linear regression                                       
# x_next = a * x_curr + b                                                       
x1_curr = x1[:-1]                                                               
x1_next = x1[1:]                                                                
x2_curr = x2[:-1]                                                               
x2_next = x2[1:]                                                                
                                                                                
# Switching condition provided: x1 + 1.4*x2 = 0                                 
# Let's determine the mode for each step based on this condition                
v = x1_curr + 1.4 * x2_curr                                                     
mode = (v > 0).astype(int)                                                      
                                                                                
# Identify indices for each mode                                                
idx0 = np.where(mode == 0)[0]                                                   
idx1 = np.where(mode == 1)[0]                                                   
                                                                                
# Fit Mode 0                                                                    
reg1_m0 = LinearRegression().fit(x1_curr[idx0].reshape(-1, 1), x1_next[idx0])   
a1_m0, b1_m0 = reg1_m0.coef_[0], reg1_m0.intercept_                             
reg2_m0 = LinearRegression().fit(x2_curr[idx0].reshape(-1, 1), x2_next[idx0])   
a2_m0, b2_m0 = reg2_m0.coef_[0], reg2_m0.intercept_                             
                                                                                
# Fit Mode 1                                                                    
reg1_m1 = LinearRegression().fit(x1_curr[idx1].reshape(-1, 1), x1_next[idx1])   
a1_m1, b1_m1 = reg1_m1.coef_[0], reg1_m1.intercept_                             
reg2_m1 = LinearRegression().fit(x2_curr[idx1].reshape(-1, 1), x2_next[idx1])   
a2_m1, b2_m1 = reg2_m1.coef_[0], reg2_m1.intercept_                             
                                                                                
# Result extraction                                                             
# Format for final answer                                                       
res = {                                                                         
