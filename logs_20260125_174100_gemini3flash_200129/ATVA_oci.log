import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
def analyze_file(path):                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    return x1, x2                                                               
                                                                                
x1_0, x2_0 = analyze_file(DATA_FILE_PATHS[0])                                   
x1_1, x2_1 = analyze_file(DATA_FILE_PATHS[1])                                   
x1_2, x2_2 = analyze_file(DATA_FILE_PATHS[2])                                   
                                                                                
# Combine all transitions                                                       
X1_start = np.concatenate([x1_0[:-1], x1_1[:-1], x1_2[:-1]])                    
X2_start = np.concatenate([x2_0[:-1], x2_1[:-1], x2_2[:-1]])                    
X1_end = np.concatenate([x1_0[1:], x1_1[1:], x1_2[1:]])                         
X2_end = np.concatenate([x2_0[1:], x2_1[1:], x2_2[1:]])                         
                                                                                
# Check for resets: A reset happens if (x1[k+1], x2[k+1]) is not a continuous   
function of (x1[k], x2[k])                                                      
# or if it deviates significantly from the local linear model.                  
# However, in discrete time, "reset" usually means the state jumps to a value   
not predicted by the current mode's ODE.                                        
# But for a hybrid automaton in discrete time, we usually just have different   
modes.                                                                          
                                                                                
# Let's try to cluster the points (x1_k, x2_k, x1_{k+1}, x2_{k+1})              
# Feature vector for each transition: [x1_k, x2_k, x1_{k+1}, x2_{k+1}]          
# Even better: the relationship is [x1_{k+1}, x2_{k+1}] = A [x1_k, x2_k, 1]^T   
# So for each k, we can consider the "coefficient" vector if it's uniquely      
determined (it's not).                                                          
# Let's just plot x1_{k+1} vs x1_k and x2_k                                     
                                                                                
print("Data range x1:", np.min(X1_start), np.max(X1_start))                     
print("Data range x2:", np.min(X2_start), np.max(X2_start))                     
                                                                                
