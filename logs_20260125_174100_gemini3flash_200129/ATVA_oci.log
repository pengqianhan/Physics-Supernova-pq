    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx1 = np.diff(x1)                                                           
                                                                                
    # Modes                                                                     
    for i in range(len(dx1)):                                                   
        # x[i] -> x[i+1]                                                        
        feat = [x1[i], x2[i]]                                                   
        target = [x1[i+1], x2[i+1]]                                             
        if dx1[i] > 0.01:                                                       
            mode1_X.append(feat)                                                
            mode1_Y.append(target)                                              
        elif dx1[i] < -0.01:                                                    
            mode2_X.append(feat)                                                
            mode2_Y.append(target)                                              
                                                                                
    # Switching points and resets                                               
    mode_seq = np.zeros_like(dx1)                                               
    mode_seq[dx1 > 0.01] = 1                                                    
    mode_seq[dx1 < -0.01] = 2                                                   
                                                                                
    for i in range(len(mode_seq) - 1):                                          
        if mode_seq[i] == 1 and mode_seq[i+1] == 2:                             
            # Transition 1 -> 2                                                 
            thresholds_max.append(x1[i+1])                                      
            resets_1to2.append([x1[i+2] - x1[i+1], x2[i+2] - x2[i+1]])          
        elif mode_seq[i] == 2 and mode_seq[i+1] == 1:                           
            # Transition 2 -> 1                                                 
            thresholds_min.append(x1[i+1])                                      
            resets_2to1.append([x1[i+2] - x1[i+1], x2[i+2] - x2[i+1]])          
                                                                                
# Fitting models                                                                
A1, B1 = fit_model(np.array(mode1_X), np.array(mode1_Y))                        
A2, B2 = fit_model(np.array(mode2_X), np.array(mode2_Y))                        
                                                                                
# Thresholds                                                                    
max_x1 = np.mean(thresholds_max) if thresholds_max else None                    
min_x1 = np.mean(thresholds_min) if thresholds_min else None                    
                                                                                
# Resets                                                                        
avg_reset_1to2 = np.mean(resets_1to2, axis=0) if resets_1to2 else [0, 0]        
avg_reset_2to1 = np.mean(resets_2to1, axis=0) if resets_2to1 else [0, 0]        
                                                                                
print(f"Mode 1 A:\n{A1}\nMode 1 B: {B1}")                                       
print(f"Mode 2 A:\n{A2}\nMode 2 B: {B2}")                                       
print(f"Threshold Max: {max_x1}, Min: {min_x1}")                                
print(f"Reset 1->2: {avg_reset_1to2}")                                          
print(f"Reset 2->1: {avg_reset_2to1}")                                          
                                                                                
                                                                                
