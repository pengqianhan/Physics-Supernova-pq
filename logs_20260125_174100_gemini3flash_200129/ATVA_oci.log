        # x1[t+1] = a1 * x1[t] + b1                                             
        X1_t = x1[indices].reshape(-1, 1)                                       
        X1_next = x1[indices + 1]                                               
        reg1 = LinearRegression().fit(X1_t, X1_next)                            
                                                                                
        # x2[t+1] = a2 * x2[t] + b2                                             
        X2_t = x2[indices].reshape(-1, 1)                                       
        X2_next = x2[indices + 1]                                               
        reg2 = LinearRegression().fit(X2_t, X2_next)                            
                                                                                
        results[m] = {                                                          
            'a1': reg1.coef_[0], 'b1': reg1.intercept_,                         
            'a2': reg2.coef_[0], 'b2': reg2.intercept_                          
        }                                                                       
                                                                                
    return results, threshold_high, threshold_low                               
                                                                                
