    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Calculate derivatives                                                     
    x1_dot = np.diff(x1) / dt                                                   
    x2_dot = np.diff(x2) / dt                                                   
                                                                                
    x1_ddot = np.diff(x1_dot) / dt                                              
    x2_ddot = np.diff(x2_dot) / dt                                              
                                                                                
    # Align data (using N-2 points)                                             
    # Target: x2_ddot[i]                                                        
    # Features: x1[i], x2[i], x2_dot[i]                                         
    # Note: indices for aligned data should be the same                         
    n = len(x2_ddot)                                                            
    x1_data.append(x1[:n])                                                      
    x1_dot_data.append(x1_dot[:n])                                              
    x1_ddot_data.append(x1_ddot[:n])                                            
    x2_data.append(x2[:n])                                                      
    x2_dot_data.append(x2_dot[:n])                                              
    x2_ddot_data.append(x2_ddot[:n])                                            
                                                                                
