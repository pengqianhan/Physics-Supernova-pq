x1_all[clean_indices]*x2_all[clean_indices],                                    
                            np.ones(len(clean_indices))])                       
    coeffs_nl, _, _, _ = np.linalg.lstsq(X_nl, Y, rcond=None)                   
    mse_nl = np.mean((Y - np.dot(X_nl, coeffs_nl))**2)                          
                                                                                
    return coeffs_lin, mse_lin, coeffs_nl, mse_nl                               
                                                                                
