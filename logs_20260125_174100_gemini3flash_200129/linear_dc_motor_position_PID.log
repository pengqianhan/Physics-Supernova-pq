import numpy as np                                                              
                                                                                
# Load the data                                                                 
data0 = np.load('data_all/linear/dc_motor_position_PID/sample_0.npz')           
t = data0['t'].flatten()                                                        
x = data0['x']                                                                  
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
print(f"Time shape: {t.shape}, x shape: {x.shape}")                             
                                                                                
# Identify modes                                                                
# Mode 1: x1 increases from 0 to 5                                              
# Mode 2: x1 decreases from 5 to 0                                              
# Let's find segments where x1 is increasing vs decreasing                      
dx1 = np.diff(x1)                                                               
# Since we know the rates are around 1 and -1, we can use the sign of dx1       
# But guards are x1 >= 5 and x1 <= 0.                                           
# Let's label modes based on the logic:                                         
# Start in Mode 1 (increasing). Switch when x1 >= 5. Switch back when x1 <= 0.  
modes = np.zeros(len(x1), dtype=int)                                            
current_mode = 1                                                                
for i in range(len(x1)):                                                        
    if current_mode == 1:                                                       
        if x1[i] >= 5.0:                                                        
            current_mode = 2                                                    
    else:                                                                       
        if x1[i] <= 0.0:                                                        
            current_mode = 1                                                    
    modes[i] = current_mode                                                     
                                                                                
# Calculate derivatives                                                         
dt = np.diff(t)                                                                 
x1_dot = np.diff(x1) / dt                                                       
x2_dot = np.diff(x2) / dt                                                       
                                                                                
# We need to align the derivatives with x1, x2 (use the midpoints or just the   
first N-1 points)                                                               
x1_mid = x1[:-1]                                                                
x2_mid = x2[:-1]                                                                
modes_mid = modes[:-1]                                                          
                                                                                
# Filter indices where we are clearly in one mode (avoiding the transition point
index)                                                                          
mode1_idx = np.where(modes_mid == 1)[0]                                         
mode2_idx = np.where(modes_mid == 2)[0]                                         
                                                                                
# Fit Mode 1                                                                    
print("--- Mode 1 Analysis ---")                                                
x1_dot_m1 = x1_dot[mode1_idx]                                                   
print(f"Mean x1_dot in Mode 1: {np.mean(x1_dot_m1)}")                           
                                                                                
# Fit x2_dot in Mode 1                                                          
# Model: x2_dot = c1*x1 + c2*x2 + c3*x1^2 + c4*x2^2 + c5*x1*x2 + c6             
A1 = np.column_stack([                                                          
    x1_mid[mode1_idx],                                                          
    x2_mid[mode1_idx],                                                          
    x1_mid[mode1_idx]**2,                                                       
    x2_mid[mode1_idx]**2,                                                       
    x1_mid[mode1_idx]*x2_mid[mode1_idx],                                        
    np.ones(len(mode1_idx))                                                     
])                                                                              
coeffs1, residuals1, rank1, s1 = np.linalg.lstsq(A1, x2_dot[mode1_idx],         
rcond=None)                                                                     
print(f"Mode 1 x2_dot coefficients: {coeffs1}")                                 
                                                                                
# Fit Mode 2                                                                    
print("\n--- Mode 2 Analysis ---")                                              
x1_dot_m2 = x1_dot[mode2_idx]                                                   
print(f"Mean x1_dot in Mode 2: {np.mean(x1_dot_m2)}")                           
                                                                                
A2 = np.column_stack([                                                          
    x1_mid[mode2_idx],                                                          
    x2_mid[mode2_idx],                                                          
    x1_mid[mode2_idx]**2,                                                       
    x2_mid[mode2_idx]**2,                                                       
    x1_mid[mode2_idx]*x2_mid[mode2_idx],                                        
    np.ones(len(mode2_idx))                                                     
])                                                                              
coeffs2, residuals2, rank2, s2 = np.linalg.lstsq(A2, x2_dot[mode2_idx],         
rcond=None)                                                                     
print(f"Mode 2 x2_dot coefficients: {coeffs2}")                                 
                                                                                
# Check for resets                                                              
# Find indices where mode changes                                               
mode_changes = np.where(np.diff(modes) != 0)[0]                                 
for idx in mode_changes:                                                        
    print(f"Transition at index {idx} (t={t[idx]}): x before={x[idx]}, x        
after={x[idx+1]}")                                                              
                                                                                
