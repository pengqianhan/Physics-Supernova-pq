dt = 0.001                                                                      
                                                                                
results = []                                                                    
                                                                                
for states in all_states:                                                       
    x1 = states[:, 0]                                                           
    x2 = states[:, 1]                                                           
                                                                                
    # First derivatives                                                         
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
                                                                                
    # Second derivatives                                                        
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
    # Modes                                                                     
    # Use a small threshold to avoid noise at peaks/troughs                     
    mode1_mask = dx1 > 0.5                                                      
    mode2_mask = dx1 < -0.5                                                     
                                                                                
    # Mode 1 fitting                                                            
    if np.any(mode1_mask):                                                      
        X1 = np.stack([x1[mode1_mask], dx1[mode1_mask], x2[mode1_mask],         
dx2[mode1_mask]], axis=1)                                                       
        y1 = d2x2[mode1_mask]                                                   
        reg1 = LinearRegression().fit(X1, y1)                                   
                                                                                
        # Mode 2 fitting                                                        
        X2 = np.stack([x1[mode2_mask], dx1[mode2_mask], x2[mode2_mask],         
dx2[mode2_mask]], axis=1)                                                       
        y2 = d2x2[mode2_mask]                                                   
        reg2 = LinearRegression().fit(X2, y2)                                   
                                                                                
        results.append({                                                        
            'mode1_coef': reg1.coef_,                                           
            'mode1_bias': reg1.intercept_,                                      
            'mode1_dx1_mean': np.mean(dx1[mode1_mask]),                         
            'mode2_coef': reg2.coef_,                                           
            'mode2_bias': reg2.intercept_,                                      
            'mode2_dx1_mean': np.mean(dx1[mode2_mask])                          
        })                                                                      
                                                                                
# Summarize results (averaging across samples if consistent)                    
m1_c = np.mean([r['mode1_coef'] for r in results], axis=0)                      
m1_b = np.mean([r['mode1_bias'] for r in results])                              
m1_dx1 = np.mean([r['mode1_dx1_mean'] for r in results])                        
                                                                                
m2_c = np.mean([r['mode2_coef'] for r in results], axis=0)                      
m2_b = np.mean([r['mode2_bias'] for r in results])                              
m2_dx1 = np.mean([r['mode2_dx1_mean'] for r in results])                        
                                                                                
print(f"Mode 1 Coefficients: {m1_c}, Bias: {m1_b}, Mean dx1: {m1_dx1}")         
