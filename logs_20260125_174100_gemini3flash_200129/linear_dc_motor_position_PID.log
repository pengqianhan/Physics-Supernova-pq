          A = np.column_stack([x1[mask], x2[mask], np.ones_like(x1[mask])])     
          c, resid, _, _ = np.linalg.lstsq(A, target[mask], rcond=None)         
          r2 = 1 - resid / (len(target[mask]) * np.var(target[mask]))           
          return c, r2                                                          
                                                                                
