import numpy as np                                                              
import pandas as pd                                                             
from scipy.optimize import lsq_linear                                           
                                                                                
dt = 0.001                                                                      
all_x1 = []                                                                     
all_x2 = []                                                                     
all_dx1 = []                                                                    
all_dx2 = []                                                                    
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[:, 0]                                                            
    x2 = state[:, 1]                                                            
                                                                                
    # Calculate numerical derivatives                                           
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    # Trim the original states to match the derivative length                   
    all_x1.append(x1[:-1])                                                      
    all_x2.append(x2[:-1])                                                      
    all_dx1.append(dx1)                                                         
    all_dx2.append(dx2)                                                         
                                                                                
# Concatenate all data                                                          
x1_full = np.concatenate(all_x1)                                                
x2_full = np.concatenate(all_x2)                                                
dx1_full = np.concatenate(all_dx1)                                              
dx2_full = np.concatenate(all_dx2)                                              
                                                                                
# Identify modes                                                                
# Mode 1: dx1/dt approx 1.0                                                     
mask1 = (dx1_full > 0.5) & (dx1_full < 1.5)                                     
# Mode 2: dx1/dt approx -1.0                                                    
mask2 = (dx1_full > -1.5) & (dx1_full < -0.5)                                   
                                                                                
def perform_regression(x1, x2, dx2):                                            
    # Model: dx2/dt = c0 + c1*x1 + c2*x2 + c3*x1^2 + c4*x2^2 + c5*x1*x2         
    A = np.column_stack([                                                       
        np.ones_like(x1),                                                       
        x1,                                                                     
        x2,                                                                     
        x1**2,                                                                  
        x2**2,                                                                  
        x1*x2                                                                   
    ])                                                                          
    res = np.linalg.lstsq(A, dx2, rcond=None)[0]                                
    return res                                                                  
                                                                                
coeffs1 = perform_regression(x1_full[mask1], x2_full[mask1], dx2_full[mask1])   
coeffs2 = perform_regression(x1_full[mask2], x2_full[mask2], dx2_full[mask2])   
                                                                                
print(f"Coefficients Mode 1 (dx1/dt ~ 1.0): {coeffs1}")                         
print(f"Coefficients Mode 2 (dx1/dt ~ -1.0): {coeffs2}")                        
                                                                                
# Check for resets                                                              
# We check the difference between consecutive points in the raw data            
resets = []                                                                     
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[:, 0]                                                            
    x2 = state[:, 1]                                                            
    dx1_raw = np.diff(x1)                                                       
    dx2_raw = np.diff(x2)                                                       
                                                                                
    # Look for jumps larger than what's expected from dx/dt * dt                
    # Expected jump is approx 1.0 * 0.001 = 0.001                               
    jump_indices = np.where((np.abs(dx1_raw) > 0.1) | (np.abs(dx2_raw) >        
0.1))[0]                                                                        
    if len(jump_indices) > 0:                                                   
        for idx in jump_indices:                                                
            resets.append({                                                     
                'file': path,                                                   
                'index': idx,                                                   
                'x1_before': x1[idx],                                           
                'x1_after': x1[idx+1],                                          
                'x2_before': x2[idx],                                           
                'x2_after': x2[idx+1]                                           
            })                                                                  
                                                                                
print(f"Found {len(resets)} resets.")                                           
if resets:                                                                      
    print("Example reset:", resets[0])                                          
                                                                                
