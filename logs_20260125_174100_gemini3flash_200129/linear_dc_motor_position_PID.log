import numpy as np                                                              
                                                                                
def fit_linear(X, y):                                                           
    A = np.column_stack((np.ones(X.shape[0]), X))                               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    y_pred = np.dot(A, coeffs)                                                  
    r2 = 1 - np.sum((y - y_pred)**2) / np.sum((y - np.mean(y))**2)              
    return coeffs, r2                                                           
                                                                                
