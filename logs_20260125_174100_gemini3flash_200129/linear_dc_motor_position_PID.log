import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def solve_for_mode(all_data_paths, mode_type):                                  
    X_list = []                                                                 
    Y_list = []                                                                 
                                                                                
    for path in all_data_paths:                                                 
        data = np.load(path)                                                    
        state = data['state']                                                   
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
                                                                                
        # Split point                                                           
        peak_idx = np.argmax(x1)                                                
                                                                                
        if mode_type == 1:                                                      
            # Mode 1: 0 to peak                                                 
            seg_x1 = x1[:peak_idx]                                              
            seg_x2 = x2[:peak_idx]                                              
        else:                                                                   
            # Mode 2: peak to end                                               
            seg_x1 = x1[peak_idx:]                                              
            seg_x2 = x2[peak_idx:]                                              
                                                                                
        if len(seg_x1) > 10:                                                    
            # Calculate derivatives locally to segment                          
            dx2 = np.gradient(seg_x2, dt)                                       
            ddx2 = np.gradient(dx2, dt)                                         
                                                                                
            # Design matrix [x1, x2, dx2, 1]                                    
            X_seg = np.column_stack([                                           
                seg_x1,                                                         
                seg_x2,                                                         
                dx2,                                                            
                np.ones_like(seg_x1)                                            
            ])                                                                  
            X_list.append(X_seg)                                                
            Y_list.append(ddx2)                                                 
                                                                                
    X = np.vstack(X_list)                                                       
    Y = np.concatenate(Y_list)                                                  
                                                                                
    coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    return coeffs                                                               
                                                                                
