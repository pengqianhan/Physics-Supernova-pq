# Mode 2: dx1 approx -1.0                                                       
mask1 = (dx1 > 0.5)                                                             
mask2 = (dx1 < -0.5)                                                            
                                                                                
def fit_mode(mask, name):                                                       
    if not np.any(mask):                                                        
        print(f"No data for {name}")                                            
        return None                                                             
                                                                                
    # Target: ddx2                                                              
    # Features: x1, x2, dx2, bias                                               
    Y = ddx2[mask]                                                              
    features = np.column_stack([x1[mask], x2[mask], dx2[mask]])                 
                                                                                
    reg = LinearRegression().fit(features, Y)                                   
    score = reg.score(features, Y)                                              
                                                                                
    return {                                                                    
        'coeffs': reg.coef_,                                                    
        'intercept': reg.intercept_,                                            
        'r2': score                                                             
    }                                                                           
                                                                                
