    m_x2_d = x2_d[idx]                                                          
    m_x1 = x1_m[idx]                                                            
    m_x2 = x2_m[idx]                                                            
                                                                                
    print(f"\n--- Mode {m_val} ---")                                            
    print(f"x1_dot: mean={np.mean(m_x1_d):.6f}, std={np.std(m_x1_d):.6e}")      
                                                                                
    # Fit x2_dot = c0 + c1*x1 + c2*x2 + c3*x1^2 + c4*x2^2 + c5*x1*x2            
