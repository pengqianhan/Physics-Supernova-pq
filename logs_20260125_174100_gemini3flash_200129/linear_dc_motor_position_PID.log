ddx2_dt2 = np.diff(dx2_dt) / dt                                                 
                                                                                
# Note:                                                                         
# x1[0] -> x1[i]                                                                
# x1[1] -> dx1/dt[i]                                                            
# x2[0] -> x2[i]                                                                
