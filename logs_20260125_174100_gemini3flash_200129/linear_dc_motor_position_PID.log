import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
dt = 0.001                                                                      
                                                                                
mode1_data = [] # List of (x1, x2, dx2, d2x2)                                   
mode2_data = []                                                                 
                                                                                
paths = ['data_all/linear/dc_motor_position_PID/sample_0.npz',                  
'data_all/linear/dc_motor_position_PID/sample_1.npz',                           
'data_all/linear/dc_motor_position_PID/sample_2.npz']                           
                                                                                
for path in paths:                                                              
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    # Calculate derivatives using central differences                           
    # dx/dt at index i: (x[i+1] - x[i-1]) / (2*dt)                              
    # d2x/dt2 at index i: (x[i+1] - 2*x[i] + x[i-1]) / (dt**2)                  
                                                                                
    dx1 = (x1[2:] - x1[:-2]) / (2 * dt)                                         
    dx2 = (x2[2:] - x2[:-2]) / (2 * dt)                                         
    d2x1 = (x1[2:] - 2 * x1[1:-1] + x1[:-2]) / (dt**2)                          
    d2x2 = (x2[2:] - 2 * x2[1:-1] + x2[:-2]) / (dt**2)                          
                                                                                
    # Values at corresponding indices                                           
    x1_val = x1[1:-1]                                                           
    x2_val = x2[1:-1]                                                           
                                                                                
    for i in range(len(dx1)):                                                   
        row = [x1_val[i], x2_val[i], dx2[i], d2x2[i], dx1[i], d2x1[i]]          
        if np.isclose(dx1[i], 1.0, atol=0.1):                                   
            mode1_data.append(row)                                              
        elif np.isclose(dx1[i], -1.0, atol=0.1):                                
            mode2_data.append(row)                                              
                                                                                
mode1_data = np.array(mode1_data)                                               
mode2_data = np.array(mode2_data)                                               
                                                                                
print(f"Mode 1 points: {len(mode1_data)}")                                      
print(f"Mode 2 points: {len(mode2_data)}")                                      
                                                                                
# Verify x1[2] approx 0                                                         
print(f"Mode 1 mean d2x1: {np.mean(np.abs(mode1_data[:, 5]))}")                 
print(f"Mode 2 mean d2x1: {np.mean(np.abs(mode2_data[:, 5]))}")                 
                                                                                
# Check initial values of dx1 in each mode                                      
# The task asks to check the initial values of x1[1] in each mode to ensure     
correct transition resets.                                                      
# This probably means when a mode starts, what is dx1/dt?                       
# In our filtering, it's already near 1 or -1.                                  
                                                                                
def perform_regression(data):                                                   
    # data: x1, x2, dx2, d2x2                                                   
    X1 = data[:, 0]                                                             
    X2 = data[:, 1]                                                             
    DX2 = data[:, 2]                                                            
    Y = data[:, 3]                                                              
                                                                                
    # x2[2] = a0 + a1*x1[0] + a2*x2[0] + a3*x2[1] + a4*x1[0]**2 + a5*x2[0]**2 + 
a6*x2[1]**2 + a7*x1[0]*x2[0] + a8*x1[0]*x2[1] + a9*x2[0]*x2[1]                  
    feat = np.column_stack([                                                    
        np.ones_like(X1),      # a0                                             
        X1,                    # a1                                             
        X2,                    # a2                                             
        DX2,                   # a3                                             
        X1**2,                 # a4                                             
        X2**2,                 # a5                                             
        DX2**2,                # a6                                             
        X1*X2,                 # a7                                             
        X1*DX2,                # a8                                             
        X2*DX2                 # a9                                             
    ])                                                                          
                                                                                
    # Use least squares                                                         
    coeffs, residuals, rank, s = np.linalg.lstsq(feat, Y, rcond=None)           
    return coeffs                                                               
                                                                                
coeffs1 = perform_regression(mode1_data)                                        
coeffs2 = perform_regression(mode2_data)                                        
                                                                                
print("Coeffs Mode 1:", coeffs1)                                                
print("Coeffs Mode 2:", coeffs2)                                                
                                                                                
