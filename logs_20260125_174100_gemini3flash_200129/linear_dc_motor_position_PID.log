import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
# Load data                                                                     
data = np.load(DATA_FILE_PATH)                                                  
# Assuming 'x' contains the state variables and 't' the time                    
x = data['x']                                                                   
t = data['t']                                                                   
dt = 0.001                                                                      
                                                                                
# x1 and x2 are the variables. Based on the task, they likely correspond to the 
columns of x.                                                                   
# Let's assume x[:, 0] is x1 and x[:, 1] is x2.                                 
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
# Compute derivatives                                                           
def get_derivs(y, dt):                                                          
    v = np.gradient(y, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return v, a                                                                 
                                                                                
x1_dot, x1_ddot = get_derivs(x1, dt)                                            
x2_dot, x2_ddot = get_derivs(x2, dt)                                            
                                                                                
# Segment data                                                                  
# Mode 1: x1 increasing (x1_dot > 0), Mode 2: x1 decreasing (x1_dot < 0)        
# Use a small threshold to avoid noise near turning points                      
mask1 = x1_dot > 0.5                                                            
mask2 = x1_dot < -0.5                                                           
                                                                                
def fit_model(features, target):                                                
    # Add constant for 'd'                                                      
    X = np.column_stack([features, np.ones(len(features))])                     
    coeffs, residuals, rank, s = np.linalg.lstsq(X, target, rcond=None)         
                                                                                
    # Calculate R-squared                                                       
    y_mean = np.mean(target)                                                    
    ss_tot = np.sum((target - y_mean)**2)                                       
    ss_res = np.sum((target - X @ coeffs)**2)                                   
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    return coeffs, r2                                                           
                                                                                
# Linear features: x1, x2, x2_dot                                               
feat_lin_1 = np.column_stack([x1[mask1], x2[mask1], x2_dot[mask1]])             
target_1 = x2_ddot[mask1]                                                       
coeffs_1, r2_1 = fit_model(feat_lin_1, target_1)                                
                                                                                
feat_lin_2 = np.column_stack([x1[mask2], x2[mask2], x2_dot[mask2]])             
target_2 = x2_ddot[mask2]                                                       
coeffs_2, r2_2 = fit_model(feat_lin_2, target_2)                                
                                                                                
# Quadratic features: x1, x2, x2_dot, x1^2, x2^2, x1*x2                         
feat_quad_1 = np.column_stack([x1[mask1], x2[mask1], x2_dot[mask1],             
x1[mask1]**2, x2[mask1]**2, x1[mask1]*x2[mask1]])                               
coeffs_quad_1, r2_quad_1 = fit_model(feat_quad_1, target_1)                     
                                                                                
feat_quad_2 = np.column_stack([x1[mask2], x2[mask2], x2_dot[mask2],             
x1[mask2]**2, x2[mask2]**2, x1[mask2]*x2[mask2]])                               
coeffs_quad_2, r2_quad_2 = fit_model(feat_quad_2, target_2)                     
                                                                                
print(f"Mode 1 Linear Coeffs (a, b, c, d): {coeffs_1}, R2: {r2_1}")             
print(f"Mode 1 Quad R2: {r2_quad_1}")                                           
print(f"Mode 2 Linear Coeffs (a, b, c, d): {coeffs_2}, R2: {r2_2}")             
print(f"Mode 2 Quad R2: {r2_quad_2}")                                           
                                                                                
