    output_detailed += f"  c2 (x2):   {res['c2']:.12f}\n"                       
    output_detailed += f"  c3 (dx2):  {res['c3']:.12f}\n"                       
    output_detailed += f"  bias:      {res['bias']:.12f}\n"                     
    output_detailed += f"  R^2:       {res['r2']}\n"                            
                                                                                
output_detailed += "\nTransition Analysis:\n" + "\n".join(transition_analysis)  
                                                                                
