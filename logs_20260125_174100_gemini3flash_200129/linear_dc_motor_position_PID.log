import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
data_files = ['data_all/linear/dc_motor_position_PID/sample_0.npz',             
              'data_all/linear/dc_motor_position_PID/sample_1.npz',             
              'data_all/linear/dc_motor_position_PID/sample_2.npz']             
                                                                                
def analyze_pid(files):                                                         
    all_x1, all_x2, all_dx2, all_ddx2, all_int_e = [], [], [], [], []           
    all_mode = []                                                               
                                                                                
    for path in files:                                                          
        data = np.load(path)                                                    
        state = data['state']                                                   
        x1, x2 = state[0], state[1]                                             
                                                                                
        # Calculate error integral                                              
        e = x1 - x2                                                             
        int_e = np.cumsum(e) * dt                                               
                                                                                
        dx2 = np.diff(x2) / dt                                                  
        ddx2 = np.diff(dx2) / dt                                                
                                                                                
        # Aligned features at indices where ddx2 is defined (2 to N-1)          
        # ddx2[i] corresponds to time t_i+1 (index i+1)                         
        # x2[i+1] is the state at that time                                     
        # dx2[i] is approx velocity at that time or between i and i+1           
        # Let's align all to index i+1                                          
        x1_v = x1[1:-1]                                                         
        x2_v = x2[1:-1]                                                         
        dx2_v = dx2[:-1]                                                        
        int_e_v = int_e[1:-1]                                                   
                                                                                
        dx1_v = (np.diff(x1)/dt)[1:]                                            
                                                                                
        all_x1.append(x1_v)                                                     
        all_x2.append(x2_v)                                                     
        all_dx2.append(dx2_v)                                                   
        all_int_e.append(int_e_v)                                               
        all_ddx2.append(ddx2)                                                   
        all_mode.append(dx1_v)                                                  
                                                                                
    return (np.concatenate(all_x1), np.concatenate(all_x2),                     
            np.concatenate(all_dx2), np.concatenate(all_int_e),                 
            np.concatenate(all_ddx2), np.concatenate(all_mode))                 
                                                                                
x1, x2, dx2, int_e, ddx2, modes = analyze_pid(data_files)                       
                                                                                
def fit_pid(x1, x2, dx2, int_e, ddx2, modes, target_mode):                      
    if target_mode == 1:                                                        
        idx = np.where(modes > 0.5)[0]                                          
    else:                                                                       
        idx = np.where(modes < -0.5)[0]                                         
                                                                                
    # Model: ddx2 = k1*x1 + k2*x2 + k3*dx2 + k4*int_e + k5                      
    X = np.stack([x1[idx], x2[idx], dx2[idx], int_e[idx],                       
np.ones_like(x1[idx])], axis=1)                                                 
    coeffs, residuals, rank, s = np.linalg.lstsq(X, ddx2[idx], rcond=None)      
    pred = np.dot(X, coeffs)                                                    
    mse = np.mean((ddx2[idx] - pred)**2)                                        
    return coeffs, mse                                                          
                                                                                
