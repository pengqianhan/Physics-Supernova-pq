def fit_poly(X, y, degree):                                                     
    n_samples = X.shape[0]                                                      
    features = [np.ones(n_samples)]                                             
    for d in range(1, degree + 1):                                              
        for i in range(d + 1):                                                  
            features.append((X[:, 0]**(d-i)) * (X[:, 1]**i))                    
                                                                                
    A = np.column_stack(features)                                               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
                                                                                
    y_pred = np.dot(A, coeffs)                                                  
    ss_res = np.sum((y - y_pred)**2)                                            
    ss_tot = np.sum((y - np.mean(y))**2)                                        
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    return coeffs, r2                                                           
                                                                                
print("Fitting Mode 1 (dx1 = 1):")                                              
for d in [4]:                                                                   
    coeffs, r2 = fit_poly(X1, y1, d)                                            
    print(f"Degree {d} R2: {r2}")                                               
    print(f"Degree {d} coefficients:", coeffs)                                  
                                                                                
print("\nFitting Mode 2 (dx1 = -1):")                                           
for d in [4]:                                                                   
    coeffs, r2 = fit_poly(X2, y2, d)                                            
    print(f"Degree {d} R2: {r2}")                                               
    print(f"Degree {d} coefficients:", coeffs)                                  
                                                                                
