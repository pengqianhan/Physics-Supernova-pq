import numpy as np                                                              
from scipy.signal import savgol_filter                                          
                                                                                
dt = 0.001                                                                      
                                                                                
def get_derivatives_smooth(y, dt):                                              
    # Use Savitzky-Golay to smooth and differentiate                            
    # window_length must be odd. Let's try 51.                                  
    dy = savgol_filter(y, 51, 3, deriv=1, delta=dt)                             
    ddy = savgol_filter(y, 51, 3, deriv=2, delta=dt)                            
    return dy, ddy                                                              
                                                                                
all_results = []                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1_f, x2_f = state[0], state[1]                                             
                                                                                
    # x1_dot for mode                                                           
    x1_dot_f = savgol_filter(x1_f, 51, 3, deriv=1, delta=dt)                    
    x2_dot_f, x2_ddot_f = get_derivatives_smooth(x2_f, dt)                      
                                                                                
    m1 = (x1_dot_f > 0.9) & (x1_dot_f < 1.1)                                    
    m2 = (x1_dot_f > -1.1) & (x1_dot_f < -0.9)                                  
                                                                                
    def erode(mask, n=50):                                                      
        if np.sum(mask) < 2*n: return np.zeros_like(mask, dtype=bool)           
        m = mask.copy()                                                         
        for _ in range(n):                                                      
            m[1:] &= mask[:-1]                                                  
            m[:-1] &= mask[1:]                                                  
        return m                                                                
    m1, m2 = erode(m1, 100), erode(m2, 100)                                     
    all_results.append((x1_f, x2_f, x2_dot_f, x2_ddot_f, m1, m2))               
                                                                                
def solve_for_coeffs(results, mode_idx):                                        
    all_X = []                                                                  
    all_Y = []                                                                  
    for res in results:                                                         
        mask = res[mode_idx]                                                    
        if np.any(mask):                                                        
            X = np.stack([res[0][mask], res[1][mask], res[2][mask],             
np.ones(np.sum(mask))], axis=1)                                                 
            all_X.append(X)                                                     
            all_Y.append(res[3][mask])                                          
    X = np.concatenate(all_X)                                                   
    Y = np.concatenate(all_Y)                                                   
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
                                                                                
    Y_pred = np.dot(X, coeffs)                                                  
    r2 = 1 - np.sum((Y - Y_pred)**2) / np.sum((Y - np.mean(Y))**2)              
    return coeffs, r2                                                           
                                                                                
c1, r1 = solve_for_coeffs(all_results, 4)                                       
c2, r2 = solve_for_coeffs(all_results, 5)                                       
                                                                                
print(f"Mode 1: a={c1[0]}, b={c1[1]}, c={c1[2]}, d={c1[3]}, R2={r1}")           
print(f"Mode 2: a={c2[0]}, b={c2[1]}, c={c2[2]}, d={c2[3]}, R2={r2}")           
                                                                                
