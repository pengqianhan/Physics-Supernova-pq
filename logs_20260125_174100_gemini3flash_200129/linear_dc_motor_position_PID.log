all_ix])                                                                        
                                                                                
    # Linear model: dx2/dt = c1*x1 + c2*x2 + c3                                 
    c_lin = solve_lstsq(np.column_stack([all_x1, all_x2]), all_dx2)             
                                                                                
    # PID-like linear model: dx2/dt = Kp*err + Ki*ix + C                        
    # error = x1 - x2. So dx2/dt = Kp*x1 - Kp*x2 + Ki*ix + C                    
    c_pid = solve_lstsq(np.column_stack([all_x1 - all_x2, all_ix]), all_dx2)    
                                                                                
    # Check saturation                                                          
    max_dx2 = np.max(all_dx2)                                                   
    min_dx2 = np.min(all_dx2)                                                   
                                                                                
    # Polynomial model                                                          
    X_poly = np.column_stack([all_x1, all_x2, all_x1**2, all_x2**2,             
all_x1*all_x2])                                                                 
    c_poly = solve_lstsq(X_poly, all_dx2)                                       
                                                                                
    results[mode_name] = {                                                      
        'linear': c_lin,                                                        
        'pid': c_pid,                                                           
        'poly': c_poly,                                                         
