  all_x2 = []                                                                   
  all_dx1 = []                                                                  
  all_dx2 = []                                                                  
                                                                                
  dt = 0.001                                                                    
                                                                                
  for path in data_paths:                                                       
      data = np.load(path)                                                      
      state = data['state']                                                     
      # state is (2, 10001)                                                     
      x1 = state[0, :]                                                          
      x2 = state[1, :]                                                          
                                                                                
      # Forward difference for derivatives                                      
      dx1 = np.diff(x1) / dt                                                    
      dx2 = np.diff(x2) / dt                                                    
                                                                                
      # Align states with derivatives (use k-th state for k-th derivative)      
      all_x1.append(x1[:-1])                                                    
      all_x2.append(x2[:-1])                                                    
      all_dx1.append(dx1)                                                       
      all_dx2.append(dx2)                                                       
                                                                                
  # Concatenate all data                                                        
  x1_all = np.concatenate(all_x1)                                               
  x2_all = np.concatenate(all_x2)                                               
  dx1_all = np.concatenate(all_dx1)                                             
  dx2_all = np.concatenate(all_dx2)                                             
                                                                                
  # Define modes                                                                
  # Mode 1: dx1/dt approx 1                                                     
  # Mode 2: dx1/dt approx -1                                                    
  mode1_mask = np.abs(dx1_all - 1.0) < 0.1                                      
  mode2_mask = np.abs(dx1_all + 1.0) < 0.1                                      
                                                                                
  def perform_regression(mask):                                                 
      X1 = x1_all[mask]                                                         
      X2 = x2_all[mask]                                                         
      target = dx2_all[mask]                                                    
                                                                                
      # Feature matrix: [1, x1, x2, x1^2, x2^2, x1*x2]                          
      A = np.column_stack([                                                     
          np.ones_like(X1),                                                     
          X1,                                                                   
          X2,                                                                   
          X1**2,                                                                
          X2**2,                                                                
          X1 * X2                                                               
      ])                                                                        
                                                                                
      # Solve Ac = target                                                       
      coeffs, residuals, rank, s = np.linalg.lstsq(A, target, rcond=None)       
      return coeffs                                                             
                                                                                
  coeffs1 = perform_regression(mode1_mask)                                      
  coeffs2 = perform_regression(mode2_mask)                                      
                                                                                
  print(f"Mode 1 Coefficients (c0, c1, c2, c3, c4, c5):")                       
  print(coeffs1)                                                                
  print(f"Mode 2 Coefficients (c0, c1, c2, c3, c4, c5):")                       
  print(coeffs2)                                                                
                                                                                
  # Checking for small coefficients                                             
  threshold = 1e-4                                                              
  print("Mode 1 Small Coeffs:", np.abs(coeffs1) < threshold)                    
  print("Mode 2 Small Coeffs:", np.abs(coeffs2) < threshold)                    
