import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
data_files = ['data_all/linear/dc_motor_position_PID/sample_0.npz',             
              'data_all/linear/dc_motor_position_PID/sample_1.npz',             
              'data_all/linear/dc_motor_position_PID/sample_2.npz']             
                                                                                
all_m1_x1, all_m1_x2, all_m1_dx2 = [], [], []                                   
all_m2_x1, all_m2_x2, all_m2_dx2 = [], [], []                                   
                                                                                
for f in data_files:                                                            
    data = np.load(f)                                                           
    x1, x2 = data['state'][0], data['state'][1]                                 
    dx1 = np.diff(x1)/dt                                                        
    dx2 = np.diff(x2)/dt                                                        
    for i in range(len(dx1)):                                                   
        if dx1[i] > 0.5:                                                        
            all_m1_x1.append(x1[i])                                             
            all_m1_x2.append(x2[i])                                             
            all_m1_dx2.append(dx2[i])                                           
        elif dx1[i] < -0.5:                                                     
            all_m2_x1.append(x1[i])                                             
            all_m2_x2.append(x2[i])                                             
            all_m2_dx2.append(dx2[i])                                           
                                                                                
def fit_final(x1, x2, dx2):                                                     
    X = np.stack([x1, x2, np.ones_like(x1)], axis=1)                            
    coeffs, residuals, rank, s = np.linalg.lstsq(X, dx2, rcond=None)            
    mse = np.mean((dx2 - np.dot(X, coeffs))**2)                                 
    return coeffs, mse                                                          
                                                                                
c1, mse1 = fit_final(np.array(all_m1_x1), np.array(all_m1_x2),                  
np.array(all_m1_dx2))                                                           
c2, mse2 = fit_final(np.array(all_m2_x1), np.array(all_m2_x2),                  
np.array(all_m2_dx2))                                                           
                                                                                
print(f"Mode 1 coeffs: {c1}, MSE: {mse1}")                                      
print(f"Mode 2 coeffs: {c2}, MSE: {mse2}")                                      
                                                                                
