                  'data_all/linear/dc_motor_position_PID/sample_2.npz']         
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        all_x.append(data['state'])                                             
    return all_x                                                                
                                                                                
states = get_data()                                                             
dt = 0.001                                                                      
                                                                                
def analyze(states):                                                            
    x1_all = []                                                                 
    x2_all = []                                                                 
    x1_dot_all = []                                                             
    x2_dot_all = []                                                             
    modes_all = []                                                              
                                                                                
    for state in states:                                                        
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
                                                                                
        # Mode identification                                                   
        m = np.zeros(len(x1), dtype=int)                                        
        curr = 1                                                                
        for i in range(len(x1)):                                                
            if curr == 1:                                                       
                if x1[i] >= 5.0: curr = 2                                       
            else:                                                               
                if x1[i] <= 0.0: curr = 1                                       
            m[i] = curr                                                         
                                                                                
        x1_dot = np.diff(x1) / dt                                               
        x2_dot = np.diff(x2) / dt                                               
                                                                                
        x1_all.append(x1[:-1])                                                  
        x2_all.append(x2[:-1])                                                  
        x1_dot_all.append(x1_dot)                                               
        x2_dot_all.append(x2_dot)                                               
        modes_all.append(m[:-1])                                                
                                                                                
    return (np.concatenate(x1_all), np.concatenate(x2_all),                     
            np.concatenate(x1_dot_all), np.concatenate(x2_dot_all),             
            np.concatenate(modes_all))                                          
                                                                                
x1_m, x2_m, x1_d, x2_d, modes_m = analyze(states)                               
                                                                                
for m_val in [1, 2]:                                                            
