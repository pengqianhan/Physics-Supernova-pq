        ])                                                                      
        coeffs, _, _, _ = np.linalg.lstsq(M, A2, rcond=None)                    
        preds = np.dot(M, coeffs)                                               
        return get_r2(A2, preds)                                                
                                                                                
    def fit_1st(mask):                                                          
        # Using the same mask points to compare apples to apples                
