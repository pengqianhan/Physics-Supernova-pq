import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
X1_list, y1_list = [], []                                                       
X2_list, y2_list = [], []                                                       
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x1 = data['state'][0]                                                       
    x2 = data['state'][1]                                                       
                                                                                
    # Use central difference for v2 and x2_accel                                
    # v2[i] = (x2[i+1] - x2[i-1]) / (2*dt)                                      
    # a2[i] = (x2[i+1] - 2*x2[i] + x2[i-1]) / (dt**2)                           
    # These are valid for i from 1 to N-2                                       
                                                                                
    idx = np.arange(1, len(x1) - 1)                                             
    x1_val = x1[idx]                                                            
    x2_val = x2[idx]                                                            
    v1_val = (x1[idx+1] - x1[idx-1]) / (2*dt)                                   
    v2_val = (x2[idx+1] - x2[idx-1]) / (2*dt)                                   
    a2_val = (x2[idx+1] - 2*x2[idx] + x2[idx-1]) / (dt**2)                      
                                                                                
    m1 = np.abs(v1_val - 1.0) < 0.05                                            
    m2 = np.abs(v1_val + 1.0) < 0.05                                            
                                                                                
    if np.any(m1):                                                              
        X1_list.append(np.column_stack([x1_val[m1], x2_val[m1], v2_val[m1],     
np.ones(np.sum(m1))]))                                                          
        y1_list.append(a2_val[m1])                                              
    if np.any(m2):                                                              
        X2_list.append(np.column_stack([x1_val[m2], x2_val[m2], v2_val[m2],     
np.ones(np.sum(m2))]))                                                          
        y2_list.append(a2_val[m2])                                              
                                                                                
X1 = np.concatenate(X1_list)                                                    
y1 = np.concatenate(y1_list)                                                    
X2 = np.concatenate(X2_list)                                                    
y2 = np.concatenate(y2_list)                                                    
                                                                                
c1, _, _, _ = np.linalg.lstsq(X1, y1, rcond=None)                               
c2, _, _, _ = np.linalg.lstsq(X2, y2, rcond=None)                               
                                                                                
print("Mode 1 (a, b, c, d):", c1)                                               
print("Mode 2 (a, b, c, d):", c2)                                               
                                                                                
# Check residuals to see if the fit is good                                     
res1 = np.mean((y1 - X1 @ c1)**2)                                               
res2 = np.mean((y2 - X2 @ c2)**2)                                               
print("Residuals Mode 1:", res1)                                                
print("Residuals Mode 2:", res2)                                                
                                                                                
