    Y = a2_val[mask]                                                            
    X = np.column_stack([x1_val[mask], x2_val[mask], v2_val[mask],              
np.ones(np.sum(mask))])                                                         
                                                                                
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
