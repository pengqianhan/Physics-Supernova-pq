      r2 = 1 - (ss_res / ss_tot)                                                
                                                                                
      return coeffs, r2                                                         
                                                                                
  # Linear fits                                                                 
  coeffs1, r2_1 = perform_regression_no_matmult(mode1)                          
  coeffs2, r2_2 = perform_regression_no_matmult(mode2)                          
                                                                                
  # Non-linear fits for comparison                                              
