    state = data['state']                                                       
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    # Use central difference for better derivative                              
    dx2_dt = np.gradient(x2, dt)                                                
    dx1_dt = np.gradient(x1, dt)                                                
                                                                                
    # Identify modes                                                            
    m1 = dx1_dt > 0.5                                                           
    m2 = dx1_dt < -0.5                                                          
                                                                                
    # Trim edges of modes to avoid transition artifacts (e.g., 100 points)      
    def trim_mask(mask):                                                        
        indices = np.where(mask)[0]                                             
        if len(indices) > 200:                                                  
            return indices[100:-100]                                            
        return indices                                                          
                                                                                
    m1_idx = trim_mask(m1)                                                      
    m2_idx = trim_mask(m2)                                                      
                                                                                
    return x1, x2, dx2_dt, m1_idx, m2_idx                                       
                                                                                
