X1_ddot = np.concatenate(x1_ddot_data)                                          
X2 = np.concatenate(x2_data)                                                    
X2_dot = np.concatenate(x2_dot_data)                                            
X2_ddot = np.concatenate(x2_ddot_data)                                          
                                                                                
# Identify modes                                                                
# Mode 1: X1_dot ~ 1                                                            
# Mode 2: X1_dot ~ -1                                                           
mode1_mask = X1_dot > 0.5                                                       
mode2_mask = X1_dot < -0.5                                                      
                                                                                
