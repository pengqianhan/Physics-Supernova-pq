│           "minLength": 1,                                                    │
│           "examples": [                                                      │
│             "x1",                                                            │
│             "x1, x2",                                                        │
│             "x, y, z"                                                        │
│           \]                                                                 │
│         },                                                                   │
│         "input": {                                                           │
│           "type": "string",                                                  │
