    modes = np.zeros(len(x1), dtype=int)                                        
    current_mode = 1                                                            
    for i in range(len(x1)):                                                    
        if current_mode == 1:                                                   
            if x1[i] >= 5.0: current_mode = 2                                   
        else:                                                                   
            if x1[i] <= 0.0: current_mode = 1                                   
        modes[i] = current_mode                                                 
                                                                                
    x1_dot = np.diff(x1) / dt                                                   
    x2_dot = np.diff(x2) / dt                                                   
    x1_mid = x1[:-1]                                                            
    x2_mid = x2[:-1]                                                            
    modes_mid = modes[:-1]                                                      
                                                                                
    return x1_mid, x2_mid, x1_dot, x2_dot, modes_mid, x1, x2, modes             
                                                                                
