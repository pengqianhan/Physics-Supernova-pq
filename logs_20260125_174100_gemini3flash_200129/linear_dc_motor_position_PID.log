import numpy as np                                                              
                                                                                
# Load data                                                                     
data0 = np.load('data_all/linear/dc_motor_position_PID/sample_0.npz')           
state = data0['state']                                                          
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Estimate dt from x1 change                                                    
# Mode 1: x1 increases from 0 to 5 at rate ~1.0.                                
# Let's find a region where x1 is increasing.                                   
dx1 = np.diff(x1)                                                               
# Assuming the rate is exactly 1.0 or -1.0                                      
dt = np.abs(dx1[0]) / 1.0                                                       
# Let's round dt to a reasonable value                                          
dt = round(dt, 4)                                                               
print(f"Estimated dt: {dt}")                                                    
                                                                                
# Mode Identification                                                           
modes = np.zeros(len(x1), dtype=int)                                            
current_mode = 1                                                                
for i in range(len(x1)):                                                        
    if current_mode == 1:                                                       
        if x1[i] >= 5.0:                                                        
            current_mode = 2                                                    
    else:                                                                       
        if x1[i] <= 0.0:                                                        
            current_mode = 1                                                    
    modes[i] = current_mode                                                     
                                                                                
# Derivatives                                                                   
x1_dot = np.diff(x1) / dt                                                       
x2_dot = np.diff(x2) / dt                                                       
                                                                                
# Align data                                                                    
x1_mid = x1[:-1]                                                                
x2_mid = x2[:-1]                                                                
modes_mid = modes[:-1]                                                          
                                                                                
# Mode 1 Analysis                                                               
m1_idx = np.where(modes_mid == 1)[0]                                            
print("--- Mode 1 ---")                                                         
print(f"Actual x1_dot (Mean): {np.mean(x1_dot[m1_idx])}")                       
                                                                                
def fit_x2_dot(idx, label):                                                     
    # Model: x2_dot = c0 + c1*x1 + c2*x2 + c3*x1^2 + c4*x2^2 + c5*x1*x2         
    A = np.column_stack([                                                       
        np.ones(len(idx)),                                                      
        x1_mid[idx],                                                            
        x2_mid[idx],                                                            
        x1_mid[idx]**2,                                                         
        x2_mid[idx]**2,                                                         
        x1_mid[idx]*x2_mid[idx]                                                 
    ])                                                                          
    b = x2_dot[idx]                                                             
    coeffs, resid, rank, s = np.linalg.lstsq(A, b, rcond=None)                  
    print(f"{label} x2_dot coefficients [const, x1, x2, x1^2, x2^2, x1*x2]:")   
    print(coeffs)                                                               
    return coeffs                                                               
                                                                                
coeffs1 = fit_x2_dot(m1_idx, "Mode 1")                                          
                                                                                
# Mode 2 Analysis                                                               
