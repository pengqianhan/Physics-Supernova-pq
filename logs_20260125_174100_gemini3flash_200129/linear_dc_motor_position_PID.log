def fit_linear(X_in, Y_out):                                                    
    # Add constant term for intercept                                           
    A = np.column_stack([X_in, np.ones(len(X_in))])                             
    # Solve A * coeff = Y_out                                                   
    coeffs, residuals, rank, s = np.linalg.lstsq(A, Y_out, rcond=None)          
    return coeffs, residuals                                                    
                                                                                
