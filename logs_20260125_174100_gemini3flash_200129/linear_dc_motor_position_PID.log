import numpy as np                                                              
import pandas as pd                                                             
                                                                                
data_files = [                                                                  
    'data_all/linear/dc_motor_position_PID/sample_0.npz',                       
    'data_all/linear/dc_motor_position_PID/sample_1.npz',                       
    'data_all/linear/dc_motor_position_PID/sample_2.npz'                        
]                                                                               
                                                                                
all_states = []                                                                 
for file in data_files:                                                         
    data = np.load(file)                                                        
    all_states.append(data['state'])                                            
                                                                                
# Combine states. states is (2, N)                                              
# Assuming a constant dt.                                                       
# Let's estimate dt for each file and see if it's consistent.                   
dts = []                                                                        
for state in all_states:                                                        
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    # Using delta x1 / x2. Avoid x2 close to 0.                                 
    mask = np.abs(x2) > 0.1                                                     
    if np.any(mask):                                                            
        dt_est = np.diff(x1)[mask[:-1]] / x2[:-1][mask[:-1]]                    
        dts.append(np.median(dt_est))                                           
                                                                                
dt = np.median(dts)                                                             
print(f"Estimated dt: {dt}")                                                    
                                                                                
# Collect data for regression                                                   
def get_derivatives(state, dt):                                                 
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx2 = np.gradient(x2, dt)                                                   
    ddx2 = np.gradient(dx2, dt)                                                 
    return x1, x2, dx2, ddx2                                                    
                                                                                
x1_all, x2_all, dx2_all, ddx2_all = [], [], [], []                              
for state in all_states:                                                        
    x1, x2, dx2, ddx2 = get_derivatives(state, dt)                              
    x1_all.append(x1)                                                           
    x2_all.append(x2)                                                           
    dx2_all.append(dx2)                                                         
    ddx2_all.append(ddx2)                                                       
                                                                                
x1_flat = np.concatenate(x1_all)                                                
x2_flat = np.concatenate(x2_all)                                                
dx2_flat = np.concatenate(dx2_all)                                              
ddx2_flat = np.concatenate(ddx2_all)                                            
                                                                                
# Mode 1: x1 increasing -> x2 > 0                                               
# Mode 2: x1 decreasing -> x2 < 0                                               
m1_mask = x2_flat > 1e-3                                                        
m2_mask = x2_flat < -1e-3                                                       
                                                                                
def fit(mask):                                                                  
    if not np.any(mask): return None                                            
    # Equation: ddx2 = a*x1 + b*x2 + c*dx2 + d                                  
    A = np.column_stack([x1_flat[mask], x2_flat[mask], dx2_flat[mask],          
np.ones(np.sum(mask))])                                                         
    y = ddx2_flat[mask]                                                         
    coeffs, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                         
    return coeffs                                                               
                                                                                
coeffs1 = fit(m1_mask)                                                          
coeffs2 = fit(m2_mask)                                                          
                                                                                
print(f"Mode 1 coeffs: {coeffs1}")                                              
print(f"Mode 2 coeffs: {coeffs2}")                                              
                                                                                
# Transitions: look at x1 when x2 crosses 0                                     
transitions_x1 = []                                                             
resets_x1 = []                                                                  
resets_x2 = []                                                                  
                                                                                
for state in all_states:                                                        
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    for i in range(1, len(x2)):                                                 
        # Check sign change of x2                                               
        if (x2[i-1] > 0 and x2[i] < 0) or (x2[i-1] < 0 and x2[i] > 0):          
            transitions_x1.append(x1[i])                                        
            resets_x1.append(x1[i] - x1[i-1])                                   
            resets_x2.append(x2[i] - x2[i-1])                                   
                                                                                
print(f"Transitions x1: {np.unique(np.round(transitions_x1, 3))}")              
print(f"Max reset x1: {np.max(np.abs(resets_x1))}")                             
print(f"Max reset x2: {np.max(np.abs(resets_x2))}")                             
                                                                                
