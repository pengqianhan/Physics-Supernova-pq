        if len(idx) == 0: return None, None                                     
        T = x2[idx + 2]                                                         
        F = np.stack([x1[idx], x2[idx], x2[idx+1], np.ones(len(idx))], axis=1)  
        return F, T                                                             
                                                                                
    f1, t1 = get_data(m1)                                                       
    if f1 is not None: all_results.append((f1, t1, 1))                          
    f2, t2 = get_data(m2)                                                       
