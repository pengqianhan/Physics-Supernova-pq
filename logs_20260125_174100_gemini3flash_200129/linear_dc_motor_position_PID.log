    'x1_0': x1[:N],                                                             
    'x1_1': dx1_dt[:N],                                                         
    'x2_0': x2[:N],                                                             
    'x2_1': dx2_dt[:N],                                                         
    'x2_2': ddx2_dt2                                                            
})                                                                              
                                                                                
