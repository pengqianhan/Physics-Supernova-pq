# Extract x1 and x2                                                             
x1 = X[:, 0]                                                                    
x2 = X[:, 1]                                                                    
                                                                                
# Compute derivatives                                                           
def get_derivatives(y, dt):                                                     
    dy = np.gradient(y, dt)                                                     
    ddy = np.gradient(dy, dt)                                                   
    return dy, ddy                                                              
                                                                                
dx1, ddx1 = get_derivatives(x1, dt)                                             
