        data = np.load(path)                                                    
        s = data['state']                                                       
        inp = data['input']                                                     
        x1, x2 = s[0], s[1]                                                     
        dx1 = np.diff(x1)                                                       
        dx2 = np.diff(x2)                                                       
        dt = 0.001                                                              
                                                                                
        mode = np.zeros_like(dx1)                                               
        mode[dx1 > 0.0001] = 1                                                  
        mode[dx1 < -0.0001] = 2                                                 
                                                                                
        all_x1.append(x1[:-1])                                                  
        all_x2.append(x2[:-1])                                                  
        all_x2_next.append(x2[1:])                                              
        all_dx2.append(dx2 / dt)                                                
        all_modes.append(mode)                                                  
        all_inputs.append(inp[:, :-1])                                          
                                                                                
    x1 = np.concatenate(all_x1)                                                 
    x2 = np.concatenate(all_x2)                                                 
    x2_next = np.concatenate(all_x2_next)                                       
    dx2 = np.concatenate(all_dx2)                                               
    m = np.concatenate(all_modes)                                               
    u = np.concatenate(all_inputs, axis=1)                                      
                                                                                
    def fit(target, mask):                                                      
        A = np.column_stack([x1[mask], x2[mask], np.ones_like(x1[mask])])       
        c, resid, _, _ = np.linalg.lstsq(A, target[mask], rcond=None)           
        r2 = 1 - resid / (len(target[mask]) * np.var(target[mask]))             
        return c, r2                                                            
                                                                                
    print("Model: dx2/dt = a*x1 + b*x2 + c")                                    
    c1, r1 = fit(dx2, m == 1)                                                   
    c2, r2 = fit(dx2, m == 2)                                                   
    print(f"Mode 1: a={c1[0]:.6f}, b={c1[1]:.6f}, c={c1[2]:.6f}, R2={r1}")      
