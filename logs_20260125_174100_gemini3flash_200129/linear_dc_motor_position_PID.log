import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
data_0 = np.load('data_all/linear/dc_motor_position_PID/sample_0.npz')          
t = data_0['t']                                                                 
x = data_0['x'] # Assuming x has shape (N, 2)                                   
                                                                                
# Calculate derivatives                                                         
dt = np.diff(t)                                                                 
dx = np.diff(x, axis=0)                                                         
x_dot = dx / dt[:, np.newaxis]                                                  
x_mid = x[:-1] # Use the current value to predict the derivative                
                                                                                
# Identify modes based on x1_dot                                                
# x1 is a triangular wave between 0 and 5, slopes approx +1 and -1              
mode1_mask = x_dot[:, 0] > 0 # Slope +1                                         
mode2_mask = x_dot[:, 0] < 0 # Slope -1                                         
                                                                                
# Prepare features for regression: bias, x1, x2, x1**2, x2**2, x1*x2, x1**3,    
x2**3                                                                           
def get_features(X):                                                            
    x1 = X[:, 0]                                                                
    x2 = X[:, 1]                                                                
    return np.column_stack([                                                    
        np.ones_like(x1),                                                       
        x1, x2,                                                                 
        x1**2, x2**2, x1*x2,                                                    
        x1**3, x2**3                                                            
    ])                                                                          
                                                                                
features = get_features(x_mid)                                                  
feature_names = ['bias', 'x1', 'x2', 'x1^2', 'x2^2', 'x1*x2', 'x1^3', 'x2^3']   
                                                                                
# Mode 1 Regression                                                             
X1 = features[mode1_mask]                                                       
y1 = x_dot[mode1_mask, 1]                                                       
reg1 = LinearRegression(fit_intercept=False).fit(X1, y1)                        
pred1 = reg1.predict(X1)                                                        
                                                                                
# Mode 2 Regression                                                             
X2 = features[mode2_mask]                                                       
y2 = x_dot[mode2_mask, 1]                                                       
reg2 = LinearRegression(fit_intercept=False).fit(X2, y2)                        
pred2 = reg2.predict(X2)                                                        
                                                                                
print("Mode 1 (x1_dot > 0) x1_dot mean:", np.mean(x_dot[mode1_mask, 0]))        
print("Mode 1 Coefficients:", dict(zip(feature_names, reg1.coef_)))             
print("Mode 1 Mean Abs Error:", np.mean(np.abs(y1 - pred1)))                    
                                                                                
print("Mode 2 (x1_dot < 0) x1_dot mean:", np.mean(x_dot[mode2_mask, 0]))        
print("Mode 2 Coefficients:", dict(zip(feature_names, reg2.coef_)))             
print("Mode 2 Mean Abs Error:", np.mean(np.abs(y2 - pred2)))                    
                                                                                
