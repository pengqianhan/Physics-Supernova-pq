    Y_reg2 = DDX2[mode2_idx]                                                    
    beta2 = solve_regression(X_reg2, Y_reg2)                                    
    print("Mode 2 (dx1 < -0.5) coefficients [a, b, c, d]:", beta2)              
else:                                                                           
    beta2 = None                                                                
                                                                                
# Check x1 model: ddx1 = K * (target_vel - dx1)                                 
# Mode 1: target_vel = 1                                                        
if np.sum(mode1_idx) > 0:                                                       
    target_vel1 = 1.0                                                           
    error_vec1 = 1.0 - DX1[mode1_idx]                                           
    # Solve ddx1 = K * error                                                    
    K1 = np.linalg.lstsq(error_vec1.reshape(-1, 1), DDX1[mode1_idx],            
