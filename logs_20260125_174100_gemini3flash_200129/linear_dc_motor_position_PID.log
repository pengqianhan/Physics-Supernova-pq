    x2 = state[1, :]                                                            
                                                                                
    # Forward difference for derivatives                                        
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    # Align states with derivatives (use k-th state for k-th derivative)        
    all_x1.append(x1[:-1])                                                      
    all_x2.append(x2[:-1])                                                      
    all_dx1.append(dx1)                                                         
    all_dx2.append(dx2)                                                         
                                                                                
