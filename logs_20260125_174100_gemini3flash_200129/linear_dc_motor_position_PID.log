  import numpy as np                                                            
                                                                                
  # Load data and prepare containers                                            
  all_x1 = []                                                                   
  all_x2 = []                                                                   
  all_v1 = []                                                                   
  all_v2 = []                                                                   
  all_a2 = []                                                                   
  resets = []                                                                   
                                                                                
  # First pass to determine dt                                                  
  data = np.load(DATA_FILE_PATHS[0])                                            
  state = data['state']                                                         
  x1_sample = state[0, :]                                                       
  dx1 = np.diff(x1_sample)                                                      
  # Assume dt is the step that makes the slope 1 or -1.                         
  # Since we are told slope is approx 1 or -1, and x1[1] is 1 or -1,            
  # then dx1 = slope * dt = 1 * dt or -1 * dt.                                  
  dt = np.median(np.abs(dx1))                                                   
  print(f"Detected dt: {dt}")                                                   
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      state = data['state']                                                     
      x1 = state[0, :]                                                          
      x2 = state[1, :]                                                          
                                                                                
      # Compute derivatives                                                     
      v1 = np.gradient(x1, dt)                                                  
      v2 = np.gradient(x2, dt)                                                  
      a2 = np.gradient(v2, dt)                                                  
                                                                                
      # Check for transitions and resets                                        
      # Transitions at x1 >= 5.0 (1 -> 2) and x1 <= 0.0 (2 -> 1)                
      # Mode 1: v1 approx 1, Mode 2: v1 approx -1                               
      for i in range(len(v1)-1):                                                
          # Detecting mode switch by v1 sign change                             
          if (v1[i] > 0.5 and v1[i+1] < -0.5) or (v1[i] < -0.5 and v1[i+1] >    
  0.5):                                                                         
              resets.append({                                                   
                  'at_x1': x1[i],                                               
                  'x2_0_before': x2[i],                                         
                  'x2_0_after': x2[i+1],                                        
                  'x2_1_before': v2[i],                                         
                  'x2_1_after': v2[i+1]                                         
              })                                                                
                                                                                
      all_x1.append(x1)                                                         
      all_x2.append(x2)                                                         
      all_v1.append(v1)                                                         
      all_v2.append(v2)                                                         
      all_a2.append(a2)                                                         
                                                                                
  # Concatenate all                                                             
  x1_full = np.concatenate(all_x1)                                              
  x2_full = np.concatenate(all_x2)                                              
  v1_full = np.concatenate(all_v1)                                              
  v2_full = np.concatenate(all_v2)                                              
  a2_full = np.concatenate(all_a2)                                              
                                                                                
  # Masks for modes                                                             
  # Mode 1: x1 increasing                                                       
  mode1_mask = v1_full > 0.5                                                    
  # Mode 2: x1 decreasing                                                       
  mode2_mask = v1_full < -0.5                                                   
                                                                                
  print(f"Mode 1 points: {np.sum(mode1_mask)}")                                 
  print(f"Mode 2 points: {np.sum(mode2_mask)}")                                 
                                                                                
  # Verify x1[1]                                                                
  print(f"Mode 1 x1[1] (v1) mean: {np.mean(v1_full[mode1_mask])}")              
  print(f"Mode 2 x1[1] (v1) mean: {np.mean(v1_full[mode2_mask])}")              
                                                                                
  # Fit ODEs: x2[2] = c1*x1[0] + c2*x2[0] + c3*x2[1] + bias                     
  def fit_mode(mask):                                                           
      Y = a2_full[mask]                                                         
      X = np.column_stack([                                                     
          x1_full[mask], # x1[0]                                                
          x2_full[mask], # x2[0]                                                
          v2_full[mask], # x2[1]                                                
          np.ones(np.sum(mask)) # bias                                          
      ])                                                                        
      coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                       
      return coeffs                                                             
                                                                                
  coeffs1 = fit_mode(mode1_mask)                                                
  coeffs2 = fit_mode(mode2_mask)                                                
                                                                                
  print(f"Coeffs Mode 1 (c1, c2, c3, bias): {coeffs1}")                         
  print(f"Coeffs Mode 2 (c1, c2, c3, bias): {coeffs2}")                         
  print(f"Resets found: {len(resets)}")                                         
  if resets:                                                                    
      print(f"First reset: {resets[0]}")                                        
