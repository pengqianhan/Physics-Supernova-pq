import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def analyze_pid_model(sample_idx):                                              
    data =                                                                      
np.load(f'data_all/linear/dc_motor_position_PID/sample_{sample_idx}.npz')       
    state = data['state']                                                       
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    dx1_dt = np.gradient(x1, dt)                                                
    dx2_dt = np.gradient(x2, dt)                                                
    d2x2_dt2 = np.gradient(dx2_dt, dt)                                          
                                                                                
    error = x1 - x2                                                             
    integral_error = np.cumsum(error) * dt                                      
    derror_dt = dx1_dt - dx2_dt                                                 
                                                                                
    # Modes                                                                     
    m1 = dx1_dt > 0.5                                                           
    m2 = dx1_dt < -0.5                                                          
                                                                                
    def get_coeffs(idx):                                                        
        if len(idx) < 10: return None                                           
        # Model: dx2/dt = Kp*error + Ki*integral_error + Kd*derror_dt + C       
        # Or maybe it's a second order system?                                  
        # Let's try dx2/dt = Kp*error + Ki*integral_error + C                   
        Y = dx2_dt[idx]                                                         
        X = np.column_stack([error[idx], integral_error[idx]])                  
        A = np.column_stack([X, np.ones(len(idx))])                             
        coeffs, _, _, _ = np.linalg.lstsq(A, Y, rcond=None)                     
                                                                                
        y_pred = A @ coeffs                                                     
        r2 = 1 - np.sum((Y - y_pred)**2) / np.sum((Y - np.mean(Y))**2)          
        return coeffs, r2                                                       
                                                                                
