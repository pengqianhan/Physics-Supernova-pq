            x1**3, x2**3                                                        
        ])                                                                      
                                                                                
    def fit(mask):                                                              
        feat = get_feats(X[mask])                                               
        target = DX[mask, 1]                                                    
        c, _, _, _ = np.linalg.lstsq(feat, target, rcond=None)                  
        preds = feat @ c                                                        
        err = np.abs(preds - target)                                            
        return c, np.mean(err), np.max(err)                                     
                                                                                
