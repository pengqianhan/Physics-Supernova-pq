import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
from sklearn.metrics import r2_score, mean_squared_error                        
                                                                                
dt = 0.001                                                                      
x1_list, x2_list, dx1_list, dx2_list, ddx2_list = [], [], [], [], []            
times_list = []                                                                 
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # data['x'] shape is (2, T)                                                 
    x = data['x']                                                               
    x1 = x[0, :]                                                                
    x2 = x[1, :]                                                                
    t = data['t']                                                               
                                                                                
    dx = np.gradient(x, dt, axis=1)                                             
    ddx = np.gradient(dx, dt, axis=1)                                           
                                                                                
    x1_list.append(x1)                                                          
    x2_list.append(x2)                                                          
    dx1_list.append(dx[0, :])                                                   
    dx2_list.append(dx[1, :])                                                   
    ddx2_list.append(ddx[1, :])                                                 
    times_list.append(t)                                                        
                                                                                
# Concatenate all data                                                          
x1_all = np.concatenate(x1_list)                                                
x2_all = np.concatenate(x2_list)                                                
dx1_all = np.concatenate(dx1_list)                                              
dx2_all = np.concatenate(dx2_list)                                              
ddx2_all = np.concatenate(ddx2_list)                                            
                                                                                
# Split into modes                                                              
m1_mask = dx1_all > 0                                                           
m2_mask = dx1_all < 0                                                           
                                                                                
def perform_regressions(mask):                                                  
    X1 = x1_all[mask]                                                           
    X2 = x2_all[mask]                                                           
    DX2 = dx2_all[mask]                                                         
    Y = ddx2_all[mask]                                                          
                                                                                
    # Linear: a*x1 + b*x2 + c*dx2 + d                                           
    X_lin = np.stack([X1, X2, DX2], axis=1)                                     
    reg_lin = LinearRegression().fit(X_lin, Y)                                  
    y_pred_lin = reg_lin.predict(X_lin)                                         
    r2_lin = r2_score(Y, y_pred_lin)                                            
    mse_lin = mean_squared_error(Y, y_pred_lin)                                 
                                                                                
    # Quadratic: a*x1 + b*x2 + c*dx2 + d*x1**2 + e*x2**2 + f*x1*x2 + g          
    X_quad = np.stack([X1, X2, DX2, X1**2, X2**2, X1*X2], axis=1)               
    reg_quad = LinearRegression().fit(X_quad, Y)                                
    y_pred_quad = reg_quad.predict(X_quad)                                      
    r2_quad = r2_score(Y, y_pred_quad)                                          
    mse_quad = mean_squared_error(Y, y_pred_quad)                               
                                                                                
    return {                                                                    
        'lin': (reg_lin.coef_, reg_lin.intercept_, r2_lin, mse_lin),            
        'quad': (reg_quad.coef_, reg_quad.intercept_, r2_quad, mse_quad)        
    }                                                                           
                                                                                
results_m1 = perform_regressions(m1_mask)                                       
results_m2 = perform_regressions(m2_mask)                                       
                                                                                
# Identify transitions                                                          
transitions = []                                                                
for i in range(len(x1_list)):                                                   
    m_signs = np.sign(dx1_list[i])                                              
    change_idx = np.where(m_signs[:-1] != m_signs[1:])[0]                       
    for idx in change_idx:                                                      
        transitions.append({                                                    
            'file': i,                                                          
            'x1': x1_list[i][idx],                                              
            'x2': x2_list[i][idx],                                              
            'dx1': dx1_list[i][idx],                                            
            'dx2': dx2_list[i][idx],                                            
            'next_x1': x1_list[i][idx+1],                                       
            'next_dx1': dx1_list[i][idx+1]                                      
        })                                                                      
                                                                                
print("Mode 1 Results:", results_m1)                                            
print("Mode 2 Results:", results_m2)                                            
print("Number of transitions:", len(transitions))                               
if transitions:                                                                 
    print("Example transition x1:", transitions[0]['x1'])                       
                                                                                
