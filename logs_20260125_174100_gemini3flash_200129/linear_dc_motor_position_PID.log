import numpy as np                                                              
                                                                                
def process_data_cleaned():                                                     
    X1_0, X1_1, X2_0, X2_1, Y = [], [], [], [], []                              
    dt = 0.001                                                                  
                                                                                
    for p in ['data_all/linear/dc_motor_position_PID/sample_0.npz',             
              'data_all/linear/dc_motor_position_PID/sample_1.npz',             
              'data_all/linear/dc_motor_position_PID/sample_2.npz']:            
        data = np.load(p)                                                       
        st = data['state']                                                      
        x1 = st[0, :]                                                           
        x2 = st[1, :]                                                           
        dx1 = np.diff(x1) / dt                                                  
        dx2 = np.diff(x2) / dt                                                  
        ddx2 = np.diff(dx2) / dt                                                
                                                                                
        # Exclude 10 points around each switch                                  
        modes = np.sign(dx1)                                                    
        switches = np.where(np.diff(modes) != 0)[0]                             
                                                                                
        mask = np.ones(len(ddx2), dtype=bool)                                   
        for sw in switches:                                                     
            mask[max(0, sw-10):min(len(ddx2), sw+10)] = False                   
                                                                                
        N = len(ddx2)                                                           
        X1_0.extend(x1[:N][mask])                                               
        X1_1.extend(dx1[:N][mask])                                              
        X2_0.extend(x2[:N][mask])                                               
        X2_1.extend(dx2[:N][mask])                                              
        Y.extend(ddx2[mask])                                                    
                                                                                
    return np.array(X1_0), np.array(X1_1), np.array(X2_0), np.array(X2_1),      
np.array(Y)                                                                     
                                                                                
x1_0, x1_1, x2_0, x2_1, y = process_data_cleaned()                              
m = np.sign(x1_1)                                                               
m1 = m > 0.5                                                                    
m2 = m < -0.5                                                                   
                                                                                
def get_coeffs_all(mask):                                                       
    X = np.column_stack([x1_0[mask], x2_0[mask], x2_1[mask],                    
np.ones(np.sum(mask))])                                                         
    coeffs, _, _, _ = np.linalg.lstsq(X, y[mask], rcond=None)                   
    return coeffs                                                               
                                                                                
