               'data_all/linear/dc_motor_position_PID/sample_1.npz',            
               'data_all/linear/dc_motor_position_PID/sample_2.npz']            
                                                                                
      all_x1, all_x2, all_x2_next, all_dx2, all_modes, all_inputs = [], [],     
  [], [], [], []                                                                
                                                                                
      for path in paths:                                                        
          data = np.load(path)                                                  
          s = data['state']                                                     
          inp = data['input']                                                   
          x1, x2 = s[0], s[1]                                                   
          dx1 = np.diff(x1)                                                     
          dx2 = np.diff(x2)                                                     
          dt = 0.001                                                            
                                                                                
          mode = np.zeros_like(dx1)                                             
          mode[dx1 > 0.0001] = 1                                                
          mode[dx1 < -0.0001] = 2                                               
                                                                                
          all_x1.append(x1[:-1])                                                
          all_x2.append(x2[:-1])                                                
          all_x2_next.append(x2[1:])                                            
          all_dx2.append(dx2 / dt)                                              
          all_modes.append(mode)                                                
          all_inputs.append(inp[:, :-1])                                        
                                                                                
