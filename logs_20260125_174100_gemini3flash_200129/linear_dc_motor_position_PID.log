    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
    d2x2 = np.diff(dx2) / dt                                                    
                                                                                
    # Align lengths                                                             
    x1_val = x1[1:-1]                                                           
    x2_val = x2[1:-1]                                                           
    dx1_val = dx1[:-1] # dx1[i] is (x1[i+1]-x1[i])/dt, so dx1_val[i] corresponds
to x1[i+1] approx                                                               
    # Better: central diff for dx1 if possible? Or just align.                  
    # Let's use indices i=1 to N-1                                              
    # dx1[i] = (x1[i+1]-x1[i-1])/(2*dt)                                         
    # dx2[i] = (x2[i+1]-x2[i-1])/(2*dt)                                         
    # d2x2[i] = (x2[i+1]-2*x2[i]+x2[i-1])/(dt**2)                               
                                                                                
    idx = np.arange(1, len(x1) - 1)                                             
    x1_c = x1[idx]                                                              
    x2_c = x2[idx]                                                              
    dx1_c = (x1[idx+1] - x1[idx-1]) / (2 * dt)                                  
    dx2_c = (x2[idx+1] - x2[idx-1]) / (2 * dt)                                  
    d2x2_c = (x2[idx+1] - 2 * x2[idx] + x2[idx-1]) / (dt**2)                    
                                                                                
    # Identify Modes                                                            
    m1_mask = dx1_c > 0.5                                                       
    m2_mask = dx1_c < -0.5                                                      
                                                                                
    all_mode1_data.append(np.column_stack([x1_c[m1_mask], x2_c[m1_mask],        
dx2_c[m1_mask], d2x2_c[m1_mask]]))                                              
    all_mode2_data.append(np.column_stack([x1_c[m2_mask], x2_c[m2_mask],        
dx2_c[m2_mask], d2x2_c[m2_mask]]))                                              
                                                                                
    # Reset check: Transitions (x1 crossing 5.0 and 0.0)                        
    # x1 is a triangular wave. Transitions are peaks/valleys.                   
