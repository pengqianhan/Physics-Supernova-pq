import numpy as np                                                              
                                                                                
def analyze_file_detailed(file_path):                                           
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    dx1_raw = np.diff(x1)                                                       
    dt = np.median(np.abs(dx1_raw))                                             
                                                                                
    v1 = np.diff(x1) / dt                                                       
    v2 = np.diff(x2) / dt                                                       
    a2 = np.diff(v2) / dt                                                       
    a1 = np.diff(v1) / dt                                                       
                                                                                
    # Masks for modes (using v1 which is N-1)                                   
    # v1 is N-1. v1[:-1] matches a1 and a2 (N-2)                                
    m1_mask = v1[:-1] > 0.5                                                     
    m2_mask = v1[:-1] < -0.5                                                    
                                                                                
    # dx1/dt constancy within modes                                             
    v1_m1 = v1[:-1][m1_mask]                                                    
    v1_m2 = v1[:-1][m2_mask]                                                    
                                                                                
    a1_m1 = a1[m1_mask]                                                         
    a1_m2 = a1[m2_mask]                                                         
                                                                                
    # Reset detection at transitions                                            
    resets = []                                                                 
    # Transitions are where v1 switches sign.                                   
    # We want to check x2 and v2 (velocity of x2)                               
    for i in range(len(v1)-1):                                                  
        if (v1[i] > 0.5 and v1[i+1] < -0.5) or (v1[i] < -0.5 and v1[i+1] > 0.5):
            # Transition                                                        
            resets.append({                                                     
                'type': 'direction_change',                                     
                'x1': x1[i+1],                                                  
                'x2_diff': x2[i+2] - x2[i+1],                                   
                'v2_before': v2[i],                                             
                'v2_after': v2[i+1]                                             
            })                                                                  
                                                                                
    return {                                                                    
        'v1_m1_mean': np.mean(v1_m1), 'v1_m1_std': np.std(v1_m1),               
        'v1_m2_mean': np.mean(v1_m2), 'v1_m2_std': np.std(v1_m2),               
        'a1_m1_mean': np.mean(a1_m1), 'a1_m1_std': np.std(a1_m1),               
        'a1_m2_mean': np.mean(a1_m2), 'a1_m2_std': np.std(a1_m2),               
        'resets': resets                                                        
    }                                                                           
                                                                                
# Run detailed analysis on first file                                           
res_detail = analyze_file_detailed(DATA_FILE_PATHS[0])                          
print("Detailed Mode 1 dx1/dt:", res_detail['v1_m1_mean'], "+/-",               
res_detail['v1_m1_std'])                                                        
