from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
data_files = ['data_all/linear/dc_motor_position_PID/sample_0.npz',             
              'data_all/linear/dc_motor_position_PID/sample_1.npz',             
              'data_all/linear/dc_motor_position_PID/sample_2.npz']             
                                                                                
all_t, all_x = [], []                                                           
for f in data_files:                                                            
    d = np.load(f)                                                              
    all_t.append(d['t'])                                                        
    all_x.append(d['x'])                                                        
                                                                                
# Combine all data                                                              
t = np.concatenate(all_t)                                                       
x = np.concatenate(all_x)                                                       
                                                                                
# Since time steps are constant, we calculate derivatives                       
dt = t[1] - t[0]                                                                
dx = np.diff(x, axis=0) / dt                                                    
x_mid = (x[:-1] + x[1:]) / 2                                                    
                                                                                
# Separate modes based on dx1/dt                                                
# Mode 0: dx1/dt > 0, Mode 1: dx1/dt < 0                                        
m0_mask = dx[:, 0] > 0                                                          
m1_mask = dx[:, 0] < 0                                                          
                                                                                
def fit_ode(X_vals, target):                                                    
    # Features: bias, x1, x2, x1^2, x2^2, x1*x2, x1^3, x2^3                     
    feats = np.column_stack([                                                   
        np.ones(len(X_vals)),                                                   
        X_vals[:, 0], X_vals[:, 1],                                             
        X_vals[:, 0]**2, X_vals[:, 1]**2, X_vals[:, 0]*X_vals[:, 1],            
        X_vals[:, 0]**3, X_vals[:, 1]**3                                        
    ])                                                                          
    model = LinearRegression(fit_intercept=False).fit(feats, target)            
    preds = model.predict(feats)                                                
    err = np.abs(target - preds)                                                
    return model.coef_, np.mean(err), np.max(err)                               
                                                                                
# Fit Mode 0                                                                    
coefs0_x1, mean0_x1, max0_x1 = fit_ode(x_mid[m0_mask], dx[m0_mask, 0])          
coefs0_x2, mean0_x2, max0_x2 = fit_ode(x_mid[m0_mask], dx[m0_mask, 1])          
                                                                                
# Fit Mode 1                                                                    
coefs1_x1, mean1_x1, max1_x1 = fit_ode(x_mid[m1_mask], dx[m1_mask, 0])          
coefs1_x2, mean1_x2, max1_x2 = fit_ode(x_mid[m1_mask], dx[m1_mask, 1])          
                                                                                
print(f"Mode 0 (dx1 > 0): dx1/dt avg={np.mean(dx[m0_mask, 0]):.4f}, dx2 error   
