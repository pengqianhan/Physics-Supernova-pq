import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# 1. Load data                                                                  
dt = 0.001                                                                      
all_x1 = []                                                                     
all_x2 = []                                                                     
all_x1_dot = []                                                                 
all_x2_dot = []                                                                 
all_x2_ddot = []                                                                
                                                                                
for file_path in DATA_FILE_PATHS:                                               
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # 2. Numerical derivatives (central difference)                             
    # x1_dot = dx1/dt, x2_dot = dx2/dt, x2_ddot = d2x2/dt2                      
    x1_dot = np.gradient(x1, dt)                                                
    x2_dot = np.gradient(x2, dt)                                                
    x2_ddot = np.gradient(x2_dot, dt)                                           
                                                                                
    # Crop boundaries to avoid edge artifacts from gradient                     
    all_x1.append(x1[10:-10])                                                   
    all_x2.append(x2[10:-10])                                                   
    all_x1_dot.append(x1_dot[10:-10])                                           
    all_x2_dot.append(x2_dot[10:-10])                                           
    all_x2_ddot.append(x2_ddot[10:-10])                                         
                                                                                
# Combine all traces                                                            
x1_all = np.concatenate(all_x1)                                                 
x2_all = np.concatenate(all_x2)                                                 
x1_dot_all = np.concatenate(all_x1_dot)                                         
x2_dot_all = np.concatenate(all_x2_dot)                                         
x2_ddot_all = np.concatenate(all_x2_ddot)                                       
                                                                                
# 3. Segment the data into two modes based on velocity of x1 (x1_dot)           
mode1_mask = x1_dot_all > 0.5                                                   
mode2_mask = x1_dot_all < -0.5                                                  
                                                                                
# 4. Fit linear models for x2_ddot using x1, x2, x2_dot as features             
def fit_mode(mask):                                                             
    X = np.column_stack((x1_all[mask], x2_all[mask], x2_dot_all[mask]))         
    y = x2_ddot_all[mask]                                                       
    model = LinearRegression().fit(X, y)                                        
    return model.coef_, model.intercept_                                        
                                                                                
c1_m1, c2_m1, c3_m1 = 0, 0, 0                                                   
bias_m1 = 0                                                                     
c1_m2, c2_m2, c3_m2 = 0, 0, 0                                                   
bias_m2 = 0                                                                     
                                                                                
if np.any(mode1_mask):                                                          
    coeffs, bias = fit_mode(mode1_mask)                                         
    c1_m1, c2_m1, c3_m1 = coeffs                                                
    bias_m1 = bias                                                              
                                                                                
if np.any(mode2_mask):                                                          
    coeffs, bias = fit_mode(mode2_mask)                                         
    c1_m2, c2_m2, c3_m2 = coeffs                                                
    bias_m2 = bias                                                              
                                                                                
# 6. Verify switching conditions for x1                                         
data_s0 = np.load(DATA_FILE_PATHS[0])                                           
x1_s0 = data_s0['state'][0, :]                                                  
x1_dot_s0 = np.gradient(x1_s0, dt)                                              
                                                                                
transitions = []                                                                
for i in range(1, len(x1_dot_s0)):                                              
    if x1_dot_s0[i-1] * x1_dot_s0[i] <= 0:                                      
        transitions.append(x1_s0[i])                                            
                                                                                
# Formatting the output with high precision                                     
final_answer(f"""                                                               
