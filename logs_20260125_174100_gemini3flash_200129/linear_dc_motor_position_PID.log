import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
dt = 0.001                                                                      
data_files = ['data_all/linear/dc_motor_position_PID/sample_0.npz',             
              'data_all/linear/dc_motor_position_PID/sample_1.npz',             
              'data_all/linear/dc_motor_position_PID/sample_2.npz']             
                                                                                
def analyze_data(files):                                                        
    all_mode1_x1 = []                                                           
    all_mode1_x2 = []                                                           
    all_mode1_dx2 = []                                                          
                                                                                
    all_mode2_x1 = []                                                           
    all_mode2_x2 = []                                                           
    all_mode2_dx2 = []                                                          
                                                                                
    resets = []                                                                 
                                                                                
    for path in files:                                                          
        data = np.load(path)                                                    
        state = data['state']                                                   
        x1 = state[0]                                                           
        x2 = state[1]                                                           
                                                                                
        # Numerical derivatives                                                 
        dx1 = np.diff(x1) / dt                                                  
        dx2 = np.diff(x2) / dt                                                  
                                                                                
        # x values at the same points as derivatives (midpoints or start points)
        x1_val = x1[:-1]                                                        
        x2_val = x2[:-1]                                                        
                                                                                
        # Identify modes based on dx1                                           
        # Mode 1: dx1 ~ 1                                                       
        # Mode 2: dx1 ~ -1                                                      
                                                                                
        mode1_idx = np.where(dx1 > 0)[0]                                        
        mode2_idx = np.where(dx1 < 0)[0]                                        
                                                                                
        all_mode1_x1.append(x1_val[mode1_idx])                                  
        all_mode1_x2.append(x2_val[mode1_idx])                                  
        all_mode1_dx2.append(dx2[mode1_idx])                                    
                                                                                
        all_mode2_x1.append(x1_val[mode2_idx])                                  
        all_mode2_x2.append(x2_val[mode2_idx])                                  
        all_mode2_dx2.append(dx2[mode2_idx])                                    
                                                                                
        # Check for resets                                                      
        # Look for jumps in x1 or x2 when dx1 changes sign                      
        mode_seq = (dx1 > 0).astype(int)                                        
        mode_changes = np.where(np.diff(mode_seq) != 0)[0]                      
        for idx in mode_changes:                                                
            # Change at idx means idx is last of mode A, idx+1 is first of mode 
B                                                                               
            resets.append((x1[idx+1] - x1[idx], x2[idx+1] - x2[idx]))           
                                                                                
    return (np.concatenate(all_mode1_x1), np.concatenate(all_mode1_x2),         
np.concatenate(all_mode1_dx2),                                                  
            np.concatenate(all_mode2_x1), np.concatenate(all_mode2_x2),         
np.concatenate(all_mode2_dx2),                                                  
            resets)                                                             
                                                                                
m1_x1, m1_x2, m1_dx2, m2_x1, m2_x2, m2_dx2, resets = analyze_data(data_files)   
                                                                                
def fit_model(x1, x2, dx2):                                                     
    # Try dx2 = a*x1 + b*x2 + c                                                 
    X = np.stack([x1, x2, np.ones_like(x1)], axis=1)                            
    # Using normal equations or lstsq                                           
    coeffs, residuals, rank, s = np.linalg.lstsq(X, dx2, rcond=None)            
    return coeffs                                                               
                                                                                
coeffs1 = fit_model(m1_x1, m1_x2, m1_dx2)                                       
coeffs2 = fit_model(m2_x1, m2_x2, m2_dx2)                                       
                                                                                
print("Mode 1 coeffs (a*x1 + b*x2 + c):", coeffs1)                              
print("Mode 2 coeffs (a*x1 + b*x2 + c):", coeffs2)                              
print("Resets sample:", resets[:5])                                             
                                                                                
