  x1_0, x1_1, x2_0, x2_1, y = process_data_cleaned()                            
  m = np.sign(x1_1)                                                             
  m1 = m > 0.5                                                                  
  m2 = m < -0.5                                                                 
                                                                                
  def get_coeffs_all(mask):                                                     
      X = np.column_stack([x1_0[mask], x2_0[mask], x2_1[mask],                  
  np.ones(np.sum(mask))])                                                       
      coeffs, _, _, _ = np.linalg.lstsq(X, y[mask], rcond=None)                 
      return coeffs                                                             
                                                                                
  c1 = get_coeffs_all(m1)                                                       
  c2 = get_coeffs_all(m2)                                                       
                                                                                
  print("Cleaned Combined Mode 1 (A, C, D, Const1):", c1)                       
  print("Cleaned Combined Mode 2 (A, C, D, Const2):", c2)                       
                                                                                
  A = (c1[0] + c2[0]) / 2                                                       
  C = (c1[1] + c2[1]) / 2                                                       
  D = (c1[2] + c2[2]) / 2                                                       
  B = (c1[3] - c2[3]) / 2                                                       
  E = (c1[3] + c2[3]) / 2                                                       
  print(f"Final Derived: A={A}, B={B}, C={C}, D={D}, E={E}")                    
