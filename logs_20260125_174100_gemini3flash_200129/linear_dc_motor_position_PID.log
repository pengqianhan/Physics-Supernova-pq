  all_X1_m2, all_X2_m2, all_dX2_m2, all_dX1_m2 = [], [], [], []                 
                                                                                
  for state in all_states:                                                      
      x1 = state[0, :]                                                          
      x2 = state[1, :]                                                          
      dx1 = np.diff(x1)                                                         
      dx2 = np.diff(x2)                                                         
      dx1_dt = dx1 / dt                                                         
      dx2_dt = dx2 / dt                                                         
                                                                                
      # Identify modes (excluding transition indices where mode changes)        
      for i in range(len(dx1_dt)):                                              
          # Mode 1: dx1/dt approx 1                                             
          if dx1_dt[i] > 0.5:                                                   
              all_X1_m1.append(x1[i])                                           
              all_X2_m1.append(x2[i])                                           
              all_dX2_m1.append(dx2_dt[i])                                      
              all_dX1_m1.append(dx1_dt[i])                                      
          # Mode 2: dx1/dt approx -1                                            
          elif dx1_dt[i] < -0.5:                                                
              all_X1_m2.append(x1[i])                                           
              all_X2_m2.append(x2[i])                                           
              all_dX2_m2.append(dx2_dt[i])                                      
              all_dX1_m2.append(dx1_dt[i])                                      
                                                                                
  def get_design_matrix(X1, X2):                                                
      X1 = np.array(X1)                                                         
      X2 = np.array(X2)                                                         
      return np.column_stack([                                                  
          np.ones_like(X1),                                                     
          X1,                                                                   
          X2,                                                                   
          X1**2,                                                                
          X2**2,                                                                
          X1*X2                                                                 
      ])                                                                        
                                                                                
  def fit_model(X1, X2, dY):                                                    
      A = get_design_matrix(X1, X2)                                             
      coeffs, _, _, _ = np.linalg.lstsq(A, dY, rcond=None)                      
      return coeffs                                                             
                                                                                
  coeffs_m1 = fit_model(all_X1_m1, all_X2_m1, all_dX2_m1)                       
  coeffs_m2 = fit_model(all_X1_m2, all_X2_m2, all_dX2_m2)                       
                                                                                
