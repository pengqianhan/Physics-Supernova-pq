              'data_all/linear/dc_motor_position_PID/sample_2.npz']             
                                                                                
dt = 0.001                                                                      
X_clean0 = []                                                                   
dX2_clean0 = []                                                                 
X_clean1 = []                                                                   
dX2_clean1 = []                                                                 
                                                                                
for f in data_files:                                                            
    data = np.load(f)['state'].T                                                
    dx = (data[1:] - data[:-1]) / dt                                            
    x = data[:-1]                                                               
                                                                                
    # Identify modes                                                            
    for i in range(10, len(dx)-10):                                             
        # Mode 0: x1 increasing                                                 
        if np.all(dx[i-5:i+5, 0] > 0.9):                                        
            X_clean0.append(x[i])                                               
            dX2_clean0.append(dx[i, 1])                                         
        # Mode 1: x1 decreasing                                                 
        elif np.all(dx[i-5:i+5, 0] < -0.9):                                     
            X_clean1.append(x[i])                                               
            dX2_clean1.append(dx[i, 1])                                         
                                                                                
def get_feats(X):                                                               
    X = np.array(X)                                                             
    x1 = X[:, 0]                                                                
    x2 = X[:, 1]                                                                
    return np.column_stack([                                                    
        np.ones_like(x1), x1, x2, x1**2, x2**2, x1*x2, x1**3, x2**3             
    ])                                                                          
                                                                                
def solve(X, Y):                                                                
    A = get_feats(X)                                                            
    coeffs, _, _, _ = np.linalg.lstsq(A, Y, rcond=None)                         
    preds = np.dot(A, coeffs)                                                   
    err = np.abs(preds - Y)                                                     
    return coeffs, np.mean(err), np.max(err)                                    
                                                                                
