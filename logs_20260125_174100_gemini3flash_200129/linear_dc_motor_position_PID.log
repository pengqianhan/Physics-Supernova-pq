import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Parameters                                                                    
dt = 0.001                                                                      
files = ['data_all/linear/dc_motor_position_PID/sample_0.npz',                  
         'data_all/linear/dc_motor_position_PID/sample_1.npz',                  
         'data_all/linear/dc_motor_position_PID/sample_2.npz']                  
                                                                                
all_data = []                                                                   
                                                                                
for f in files:                                                                 
    data = np.load(f)                                                           
    state = data['state'] # Shape (2, 10001)                                    
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Derivatives                                                               
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
    df = pd.DataFrame({                                                         
        'x1': x1,                                                               
        'x2': x2,                                                               
        'dx1': dx1,                                                             
        'dx2': dx2,                                                             
        'd2x2': d2x2                                                            
    })                                                                          
    all_data.append(df)                                                         
                                                                                
df_total = pd.concat(all_data, ignore_index=True)                               
                                                                                
# Identify Operating Modes                                                      
mode1 = df_total[df_total['dx1'] > 0.5]                                         
mode2 = df_total[df_total['dx1'] < -0.5]                                        
                                                                                
print(f"Sample counts - Total: {len(df_total)}, Mode 1: {len(mode1)}, Mode 2:   
{len(mode2)}")                                                                  
                                                                                
def perform_regression(df, include_nonlinear=False):                            
    # Target: d2x2                                                              
    y = df['d2x2'].values                                                       
                                                                                
    # Features: x1[0], x2[0], x2[1], constant                                   
    # Note: x1[0] is state x1, x2[0] is state x2, x2[1] is dx2                  
    X = np.column_stack([df['x1'].values, df['x2'].values, df['dx2'].values,    
np.ones(len(df))])                                                              
                                                                                
    if include_nonlinear:                                                       
        X = np.column_stack([X, (df['x1']**2).values, (df['x2']**2).values])    
                                                                                
    coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)              
                                                                                
    # Calculate R2                                                              
    y_pred = X @ coeffs                                                         
    ss_res = np.sum((y - y_pred)**2)                                            
    ss_tot = np.sum((y - np.mean(y))**2)                                        
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    return coeffs, r2                                                           
                                                                                
coeffs1, r2_1 = perform_regression(mode1)                                       
coeffs2, r2_2 = perform_regression(mode2)                                       
r2_1_nl_info = perform_regression(mode1, include_nonlinear=True)[1]             
r2_2_nl_info = perform_regression(mode2, include_nonlinear=True)[1]             
                                                                                
print(f"Mode 1 Linear Coeffs (a, b, c, d): {coeffs1}")                          
print(f"Mode 1 R2: {r2_1:.6f}, with NL: {r2_1_nl_info:.6f}")                    
print(f"Mode 2 Linear Coeffs (a, b, c, d): {coeffs2}")                          
print(f"Mode 2 R2: {r2_2:.6f}, with NL: {r2_2_nl_info:.6f}")                    
                                                                                
# Extract individual coefficients                                               
a1, b1, c1, d1 = coeffs1                                                        
a2, b2, c2, d2 = coeffs2                                                        
                                                                                
print(f"\nFinal coefficients for Mode 1 (a, b, c, d): {a1}, {b1}, {c1}, {d1}")  
print(f"Final coefficients for Mode 2 (a, b, c, d): {a2}, {b2}, {c2}, {d2}")    
                                                                                
