  import numpy as np                                                            
                                                                                
  def get_intervals(idx):                                                       
      if len(idx) == 0:                                                         
          return []                                                             
      intervals = []                                                            
      start = idx[0]                                                            
      for i in range(1, len(idx)):                                              
          if idx[i] != idx[i-1] + 1:                                            
              intervals.append((start, idx[i-1]))                               
              start = idx[i]                                                    
      intervals.append((start, idx[-1]))                                        
      return intervals                                                          
                                                                                
