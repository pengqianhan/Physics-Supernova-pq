X2 = []                                                                         
for s in all_states:                                                            
    X1.append(s[0, :])                                                          
    X2.append(s[1, :])                                                          
                                                                                
def solve_for_mode(x1_list, x2_list, mode_condition_func):                      
    A = []                                                                      
    Y = []                                                                      
    A_ext = [] # for checking x1[1]                                             
                                                                                
    for x1, x2 in zip(x1_list, x2_list):                                        
        # We need x1[k], x2[k], x2[k+1] to predict x2[k+2]                      
        # dx1/dt at k is (x1[k+1] - x1[k])                                      
        for k in range(len(x1) - 2):                                            
            dx1 = x1[k+1] - x1[k]                                               
            if mode_condition_func(dx1):                                        
                # Equation: x2[k+2] = a*x1[k] + b*x2[k] + c*x2[k+1] + d         
                A.append([x1[k], x2[k], x2[k+1], 1.0])                          
                Y.append(x2[k+2])                                               
                # Extended for significance check: x1[k+1]                      
                A_ext.append([x1[k], x2[k], x2[k+1], 1.0, x1[k+1]])             
                                                                                
    A = np.array(A)                                                             
    Y = np.array(Y)                                                             
    A_ext = np.array(A_ext)                                                     
                                                                                
    # Solve A * [a, b, c, d]^T = Y                                              
    coeffs, residuals, rank, s = np.linalg.lstsq(A, Y, rcond=None)              
                                                                                
    # Solve A_ext * [a, b, c, d, e]^T = Y                                       
    coeffs_ext, residuals_ext, rank_ext, s_ext = np.linalg.lstsq(A_ext, Y,      
rcond=None)                                                                     
                                                                                
    return coeffs, coeffs_ext, residuals                                        
                                                                                
# Define modes                                                                  
mode1_func = lambda dx: dx > 1e-9                                               
mode2_func = lambda dx: dx < -1e-9                                              
                                                                                
