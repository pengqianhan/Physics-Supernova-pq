modes = np.sign(dx1_dt)                                                         
# Note: modes will have length 10000.                                           
# We can smooth it a bit if there's noise.                                      
# Let's find indices where sign changes.                                        
switches = np.where(np.diff(modes) != 0)[0]                                     
