import numpy as np                                                              
                                                                                
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
def analyze_mode(all_states, mode_filter):                                      
    # Collect data points                                                       
    X_k = [] # x1[k], x2[k], x2[k+1], 1                                         
    X_k_plus_1 = [] # x1[k+1], x2[k], x2[k+1], 1                                
    X_both = [] # x1[k], x1[k+1], x2[k], x2[k+1], 1                             
    Y = []                                                                      
                                                                                
    for s in all_states:                                                        
        x1 = s[0, :]                                                            
        x2 = s[1, :]                                                            
        for k in range(len(x1) - 2):                                            
            dx1 = x1[k+1] - x1[k]                                               
            if mode_filter(dx1):                                                
                X_k.append([x1[k], x2[k], x2[k+1], 1.0])                        
                X_k_plus_1.append([x1[k+1], x2[k], x2[k+1], 1.0])               
                X_both.append([x1[k], x1[k+1], x2[k], x2[k+1], 1.0])            
                Y.append(x2[k+2])                                               
                                                                                
    X_k = np.array(X_k)                                                         
    X_k_plus_1 = np.array(X_k_plus_1)                                           
    X_both = np.array(X_both)                                                   
    Y = np.array(Y)                                                             
                                                                                
    # Regression for Model A (using x1[k])                                      
    c_k, res_k, _, _ = np.linalg.lstsq(X_k, Y, rcond=None)                      
    # Regression for Model B (using x1[k+1])                                    
    c_kp1, res_kp1, _, _ = np.linalg.lstsq(X_k_plus_1, Y, rcond=None)           
    # Regression for Model C (using both)                                       
    c_both, res_both, _, _ = np.linalg.lstsq(X_both, Y, rcond=None)             
                                                                                
    return {                                                                    
        'coeffs_A': c_k, 'res_A': res_k,                                        
        'coeffs_B': c_kp1, 'res_B': res_kp1,                                    
        'coeffs_C': c_both, 'res_C': res_both                                   
    }                                                                           
                                                                                
mode1 = lambda dx: dx > 0.0005                                                  
mode2 = lambda dx: dx < -0.0005                                                 
                                                                                
res1 = analyze_mode(all_states, mode1)                                          
res2 = analyze_mode(all_states, mode2)                                          
                                                                                
print("Mode 1 Residuals: A={:.2e}, B={:.2e}, C={:.2e}".format(res1['res_A'][0], 
res1['res_B'][0], res1['res_C'][0]))                                            
print("Mode 2 Residuals: A={:.2e}, B={:.2e}, C={:.2e}".format(res2['res_A'][0], 
res2['res_B'][0], res2['res_C'][0]))                                            
                                                                                
print("\nMode 1 Coeffs A (a, b, c, d):", res1['coeffs_A'])                      
print("Mode 1 Coeffs C (a0, a1, b, c, d):", res1['coeffs_C'])                   
print("\nMode 2 Coeffs A (a, b, c, d):", res2['coeffs_A'])                      
print("Mode 2 Coeffs C (a0, a1, b, c, d):", res2['coeffs_C'])                   
                                                                                
