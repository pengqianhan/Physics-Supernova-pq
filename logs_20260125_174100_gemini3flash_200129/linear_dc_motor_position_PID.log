dt = 0.001                                                                      
data_files = ['data_all/linear/dc_motor_position_PID/sample_0.npz',             
              'data_all/linear/dc_motor_position_PID/sample_1.npz',             
              'data_all/linear/dc_motor_position_PID/sample_2.npz']             
                                                                                
def get_segments(files):                                                        
    m1_data = []                                                                
    m2_data = []                                                                
    for path in files:                                                          
        data = np.load(path)                                                    
        x1, x2 = data['state'][0], data['state'][1]                             
        dx1 = np.diff(x1) / dt                                                  
        dx2 = np.diff(x2) / dt                                                  
                                                                                
        for i in range(len(dx1)):                                               
            if dx1[i] > 0.5:                                                    
                m1_data.append([x1[i], x2[i], dx2[i]])                          
            elif dx1[i] < -0.5:                                                 
                m2_data.append([x1[i], x2[i], dx2[i]])                          
    return np.array(m1_data), np.array(m2_data)                                 
                                                                                
m1_all, m2_all = get_segments(data_files)                                       
                                                                                
def fit_linear(data):                                                           
    # dx2 = a*x1 + b*x2 + c                                                     
    X = np.stack([data[:, 0], data[:, 1], np.ones(len(data))], axis=1)          
    y = data[:, 2]                                                              
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    mse = np.mean((y - np.dot(X, coeffs))**2)                                   
    return coeffs, mse                                                          
                                                                                
