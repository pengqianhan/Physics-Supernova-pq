def get_clean_data():                                                           
    all_X1, all_y1 = [], []                                                     
    all_X2, all_y2 = [], []                                                     
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x1, x2 = data['state']                                                  
        # Use a larger window for derivatives to reduce noise                   
        # But not too large to avoid blurring transitions                       
        idx = np.arange(5, len(x1) - 5)                                         
        v1 = (x1[idx+1] - x1[idx-1]) / (2*dt)                                   
        v2 = (x2[idx+1] - x2[idx-1]) / (2*dt)                                   
        a2 = (x2[idx+1] - 2*x2[idx] + x2[idx-1]) / (dt**2)                      
                                                                                
        # Stricter mask: v1 should be very close to 1 or -1                     
        m1 = np.abs(v1 - 1.0) < 0.001                                           
        m2 = np.abs(v1 + 1.0) < 0.001                                           
                                                                                
        if np.any(m1):                                                          
            all_X1.append(np.column_stack([x1[idx][m1], x2[idx][m1], v2[m1],    
np.ones(np.sum(m1))]))                                                          
            all_y1.append(a2[m1])                                               
        if np.any(m2):                                                          
            all_X2.append(np.column_stack([x1[idx][m2], x2[idx][m2], v2[m2],    
np.ones(np.sum(m2))]))                                                          
            all_y2.append(a2[m2])                                               
                                                                                
    return np.concatenate(all_X1), np.concatenate(all_y1),                      
np.concatenate(all_X2), np.concatenate(all_y2)                                  
                                                                                
