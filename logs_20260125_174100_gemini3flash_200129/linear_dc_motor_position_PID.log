import numpy as np                                                              
import pandas as pd                                                             
                                                                                
dt = 0.001                                                                      
data_files = ['data_all/linear/dc_motor_position_PID/sample_0.npz',             
'data_all/linear/dc_motor_position_PID/sample_1.npz',                           
'data_all/linear/dc_motor_position_PID/sample_2.npz']                           
                                                                                
all_mode1_data = []                                                             
all_mode2_data = []                                                             
all_resets_check = []                                                           
                                                                                
for file in data_files:                                                         
    data = np.load(file)                                                        
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Use central differences for accuracy where possible                       
    idx = np.arange(1, len(x1) - 1)                                             
    x1_c = x1[idx]                                                              
    x2_c = x2[idx]                                                              
    dx1_c = (x1[idx+1] - x1[idx-1]) / (2 * dt)                                  
    dx2_c = (x2[idx+1] - x2[idx-1]) / (2 * dt)                                  
    d2x2_c = (x2[idx+1] - 2 * x2[idx] + x2[idx-1]) / (dt**2)                    
                                                                                
    # Identify Modes                                                            
    m1_mask = dx1_c > 0.5                                                       
    m2_mask = dx1_c < -0.5                                                      
                                                                                
    if np.any(m1_mask):                                                         
        all_mode1_data.append(np.column_stack([x1_c[m1_mask], x2_c[m1_mask],    
dx2_c[m1_mask], d2x2_c[m1_mask]]))                                              
    if np.any(m2_mask):                                                         
        all_mode2_data.append(np.column_stack([x1_c[m2_mask], x2_c[m2_mask],    
dx2_c[m2_mask], d2x2_c[m2_mask]]))                                              
                                                                                
    # Reset check at transitions                                                
    # Slope changes from +1 to -1 at x1=5 and -1 to +1 at x1=0                  
    for i in range(1, len(x1) - 1):                                             
        # Detecting peaks and valleys                                           
        if (x1[i] > x1[i-1] and x1[i] >= x1[i+1]) or (x1[i] < x1[i-1] and x1[i] 
<= x1[i+1]):                                                                    
             all_resets_check.append({                                          
                'file': file,                                                   
                'index': i,                                                     
                'x1': x1[i],                                                    
                'x2': x2[i],                                                    
                'dx2_before': (x2[i] - x2[i-1])/dt,                             
                'dx2_after': (x2[i+1] - x2[i])/dt,                              
                'jump_x2': x2[i+1] - x2[i]                                      
            })                                                                  
                                                                                
# Combine data                                                                  
mode1_data = np.vstack(all_mode1_data)                                          
mode2_data = np.vstack(all_mode2_data)                                          
                                                                                
def fit_and_evaluate(data, mode_name):                                          
    X1, X2, dX2, Y = data[:, 0], data[:, 1], data[:, 2], data[:, 3]             
                                                                                
    # Linear: c1*x1 + c2*x2 + c3*dx2 + bias                                     
    A_lin = np.column_stack([X1, X2, dX2, np.ones_like(X1)])                    
    coeffs_lin, residuals_lin, rank_lin, s_lin = np.linalg.lstsq(A_lin, Y,      
rcond=None)                                                                     
    pred_lin = A_lin @ coeffs_lin                                               
    mse_lin = np.mean((Y - pred_lin)**2)                                        
    r2_lin = 1 - (np.sum((Y - pred_lin)**2) / np.sum((Y - np.mean(Y))**2))      
                                                                                
    # Non-linear: c1*x1 + c2*x2 + c3*dx2 + c4*x1^2 + c5*x2^2 + c6*x1*x2 + bias  
    A_nl = np.column_stack([X1, X2, dX2, X1**2, X2**2, X1*X2, np.ones_like(X1)])
    coeffs_nl, residuals_nl, rank_nl, s_nl = np.linalg.lstsq(A_nl, Y,           
rcond=None)                                                                     
    pred_nl = A_nl @ coeffs_nl                                                  
    mse_nl = np.mean((Y - pred_nl)**2)                                          
    r2_nl = 1 - (np.sum((Y - pred_nl)**2) / np.sum((Y - np.mean(Y))**2))        
                                                                                
    return {                                                                    
        'mode': mode_name,                                                      
        'lin_coeffs': coeffs_lin,                                               
        'lin_mse': mse_lin,                                                     
        'lin_r2': r2_lin,                                                       
        'nl_coeffs': coeffs_nl,                                                 
        'nl_mse': mse_nl,                                                       
        'nl_r2': r2_nl                                                          
    }                                                                           
                                                                                
res1 = fit_and_evaluate(mode1_data, "Mode 1")                                   
res2 = fit_and_evaluate(mode2_data, "Mode 2")                                   
                                                                                
print("Mode 1 Results:", res1)                                                  
print("Mode 2 Results:", res2)                                                  
print("Reset check (first 5):", all_resets_check[:5])                           
                                                                                
