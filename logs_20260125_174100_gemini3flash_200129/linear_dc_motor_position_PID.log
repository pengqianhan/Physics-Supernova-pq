print("Shape of x:", x.shape)                                                   
dt = t[1] - t[0]                                                                
print("Time step dt:", dt)                                                      
                                                                                
# Combine all data from all files                                               
all_t = []                                                                      
all_x = []                                                                      
for path in DATA_FILE_PATHS:                                                    
    d = np.load(path)                                                           
    all_t.append(d['t'])                                                        
    all_x.append(d['x'])                                                        
                                                                                
# Calculate derivatives for each sample to avoid boundary issues between samples
all_dx1 = []                                                                    
all_ddx1 = []                                                                   
all_dx2 = []                                                                    
all_ddx2 = []                                                                   
valid_x1 = []                                                                   
valid_x2 = []                                                                   
                                                                                
for sample_x in all_x:                                                          
    x1 = sample_x[:, 0]                                                         
    x2 = sample_x[:, 1]                                                         
                                                                                
    # Central differences                                                       
    # dx[i] = (x[i+1] - x[i-1]) / (2*dt)                                        
    # ddx[i] = (x[i+1] - 2*x[i] + x[i-1]) / (dt**2)                             
                                                                                
    dx1 = (x1[2:] - x1[:-2]) / (2 * dt)                                         
    ddx1 = (x1[2:] - 2 * x1[1:-1] + x1[:-2]) / (dt**2)                          
                                                                                
    dx2 = (x2[2:] - x2[:-2]) / (2 * dt)                                         
    ddx2 = (x2[2:] - 2 * x2[1:-1] + x2[:-2]) / (dt**2)                          
                                                                                
    # Align states with derivatives (at indices 1 to -1)                        
    valid_x1.append(x1[1:-1])                                                   
    valid_x2.append(x2[1:-1])                                                   
    all_dx1.append(dx1)                                                         
    all_ddx1.append(ddx1)                                                       
    all_dx2.append(dx2)                                                         
    all_ddx2.append(ddx2)                                                       
                                                                                
# Concatenate all valid data points                                             
X1 = np.concatenate(valid_x1)                                                   
X2 = np.concatenate(valid_x2)                                                   
DX1 = np.concatenate(all_dx1)                                                   
DDX1 = np.concatenate(all_ddx1)                                                 
DX2 = np.concatenate(all_dx2)                                                   
DDX2 = np.concatenate(all_ddx2)                                                 
                                                                                
# Define modes                                                                  
mode1_idx = DX1 > 0.5                                                           
mode2_idx = DX1 < -0.5                                                          
                                                                                
print(f"Points in Mode 1: {np.sum(mode1_idx)}")                                 
print(f"Points in Mode 2: {np.sum(mode2_idx)}")                                 
                                                                                
# Linear Regression for x2: ddx2 = a*x1 + b*x2 + c*dx2 + d                      
def solve_regression(X_mat, Y_mat):                                             
    # Solves Y = X * beta                                                       
    beta = np.linalg.lstsq(X_mat, Y_mat, rcond=None)[0]                         
    return beta                                                                 
                                                                                
# Prepare data for Mode 1                                                       
if np.sum(mode1_idx) > 0:                                                       
    X_reg1 = np.stack([X1[mode1_idx], X2[mode1_idx], DX2[mode1_idx],            
np.ones_like(X1[mode1_idx])], axis=1)                                           
    Y_reg1 = DDX2[mode1_idx]                                                    
    beta1 = solve_regression(X_reg1, Y_reg1)                                    
    print("Mode 1 (dx1 > 0.5) coefficients [a, b, c, d]:", beta1)               
else:                                                                           
    beta1 = None                                                                
                                                                                
# Prepare data for Mode 2                                                       
if np.sum(mode2_idx) > 0:                                                       
    X_reg2 = np.stack([X1[mode2_idx], X2[mode2_idx], DX2[mode2_idx],            
