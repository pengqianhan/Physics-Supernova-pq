            # Potential transition point                                        
            # Compare state before and after the peak/valley                    
            # For a triangular wave, peaks are 5.0 and valleys are 0.0.         
            # Usually resets happen when a threshold is met.                    
            # Let's record the values around these points                       
            all_resets_check.append({                                           
                'file': file,                                                   
                'index': i,                                                     
                'x1': x1[i],                                                    
                'x2': x2[i],                                                    
                'dx1': (x1[i+1]-x1[i-1])/(2*dt),                                
                'dx2': (x2[i+1]-x2[i-1])/(2*dt),                                
                'jump_x1': x1[i+1] - x1[i],                                     
                'jump_x2': x2[i+1] - x2[i]                                      
            })                                                                  
                                                                                
