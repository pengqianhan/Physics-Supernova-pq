dx2 = np.gradient(x2, dt)                                                       
d2x2 = np.gradient(dx2, dt)                                                     
                                                                                
# Identify modes                                                                
# Mode 1: dx1/dt > 0, Mode 2: dx1/dt < 0                                        
mode1_indices = np.where(dx1 > 0.5)[0]                                          
