for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    s = data['state']                                                           
    x1, x2 = s[0], s[1]                                                         
                                                                                
    # Derivatives                                                               
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
    x1_list.append(x1)                                                          
    x2_list.append(x2)                                                          
    dx1_list.append(dx1)                                                        
    dx2_list.append(dx2)                                                        
    d2x2_list.append(d2x2)                                                      
                                                                                
# Combine all data                                                              
X1 = np.concatenate(x1_list)                                                    
X2 = np.concatenate(x2_list)                                                    
DX1 = np.concatenate(dx1_list)                                                  
DX2 = np.concatenate(dx2_list)                                                  
D2X2 = np.concatenate(d2x2_list)                                                
                                                                                
# Define masks for modes, avoiding transition regions                           
# Mode 1: dx1 approx 1                                                          
mask1 = (DX1 > 0.9) & (X1 > 0.1) & (X1 < 4.9)                                   
# Mode 2: dx1 approx -1                                                         
mask2 = (DX1 < -0.9) & (X1 > 0.1) & (X1 < 4.9)                                  
                                                                                
def solve_mode(mask):                                                           
    # Equation: d2x2 = a*x1 + b*x2 + c*dx2 + d                                  
    A = np.column_stack([X1[mask], X2[mask], DX2[mask], np.ones(np.sum(mask))]) 
    b = D2X2[mask]                                                              
    coeffs, residuals, rank, s = np.linalg.lstsq(A, b, rcond=None)              
    avg_dx1 = np.mean(DX1[mask])                                                
                                                                                
    # Calculate R-squared for verification                                      
    ss_res = np.sum((b - A @ coeffs)**2)                                        
    ss_tot = np.sum((b - np.mean(b))**2)                                        
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    return coeffs, avg_dx1, r2                                                  
                                                                                
