# Mode 1: x1_1 approx 1.0                                                       
mode1_df = data_df[data_df['mode'] > 0]                                         
# Mode 2: x1_1 approx -1.0                                                      
mode2_df = data_df[data_df['mode'] < 0]                                         
                                                                                
def solve_regression(df):                                                       
    X = df[['x1_0', 'x1_1', 'x2_0', 'x2_1']]                                    
    y = df['x2_2']                                                              
    model = LinearRegression()                                                  
    model.fit(X, y)                                                             
    return model.coef_, model.intercept_                                        
                                                                                
coef1, intercept1 = solve_regression(mode1_df)                                  
coef2, intercept2 = solve_regression(mode2_df)                                  
                                                                                
print("Mode 1 (Increasing) Coefs (x1_0, x1_1, x2_0, x2_1):", coef1,             
"Intercept:", intercept1)                                                       
print("Mode 2 (Decreasing) Coefs (x1_0, x1_1, x2_0, x2_1):", coef2,             
"Intercept:", intercept2)                                                       
                                                                                
# Verify x1 dynamics                                                            
