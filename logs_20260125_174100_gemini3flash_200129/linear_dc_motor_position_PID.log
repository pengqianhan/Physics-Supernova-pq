import numpy as np                                                              
                                                                                
def analyze():                                                                  
    paths = ['data_all/linear/dc_motor_position_PID/sample_0.npz',              
             'data_all/linear/dc_motor_position_PID/sample_1.npz',              
             'data_all/linear/dc_motor_position_PID/sample_2.npz']              
                                                                                
    all_x1, all_x2, all_dx2, all_modes = [], [], [], []                         
                                                                                
    for path in paths:                                                          
        data = np.load(path)                                                    
        s = data['state']                                                       
        x1, x2 = s[0], s[1]                                                     
        dx1 = np.diff(x1)                                                       
        dx2 = np.diff(x2)                                                       
        # dt estimation from dx1 assuming |x1_dot| = 1                          
        dt = np.mean(np.abs(dx1[np.abs(dx1) > 1e-6]))                           
                                                                                
        mode = np.zeros_like(dx1)                                               
        mode[dx1 > 0.0001] = 1                                                  
        mode[dx1 < -0.0001] = 2                                                 
                                                                                
        all_x1.append(x1[:-1])                                                  
        all_x2.append(x2[:-1])                                                  
        all_dx2.append(dx2 / dt)                                                
        all_modes.append(mode)                                                  
                                                                                
    x1 = np.concatenate(all_x1)                                                 
    x2 = np.concatenate(all_x2)                                                 
    dx2 = np.concatenate(all_dx2)                                               
    m = np.concatenate(all_modes)                                               
                                                                                
    def get_coeffs(mask):                                                       
        A = np.column_stack([x1[mask], x2[mask], np.ones_like(x1[mask])])       
        c, resid, _, _ = np.linalg.lstsq(A, dx2[mask], rcond=None)              
        r2 = 1 - resid / (len(dx2[mask]) * np.var(dx2[mask]))                   
        return c, r2                                                            
                                                                                
    c1, r1 = get_coeffs(m == 1)                                                 
    c2, r2 = get_coeffs(m == 2)                                                 
                                                                                
    print(f"Mode 1: a={c1[0]:.6f}, b={c1[1]:.6f}, c={c1[2]:.6f}, R2={r1}")      
    print(f"Mode 2: a={c2[0]:.6f}, b={c2[1]:.6f}, c={c2[2]:.6f}, R2={r2}")      
                                                                                
analyze()                                                                       
                                                                                
