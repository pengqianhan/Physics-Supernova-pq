    all_x1.append(x1_trimmed)                                                   
    all_x2.append(x2_trimmed)                                                   
    all_dx1.append(dx1)                                                         
    all_dx2.append(dx2)                                                         
    all_ddx2.append(ddx2)                                                       
                                                                                
