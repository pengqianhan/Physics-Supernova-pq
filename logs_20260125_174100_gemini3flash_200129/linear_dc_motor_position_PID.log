              mode2_data.append([x1[k], x2[k], x2[k+1], x2[k+2]])               
                                                                                
  m1 = np.array(mode1_data)                                                     
  m2 = np.array(mode2_data)                                                     
                                                                                
  def get_coeffs(m):                                                            
      A = np.column_stack((m[:, 0], m[:, 1], m[:, 2], np.ones(m.shape[0])))     
