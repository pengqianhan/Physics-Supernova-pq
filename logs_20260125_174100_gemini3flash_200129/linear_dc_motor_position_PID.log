mode1_data = np.vstack(all_mode1_data)                                          
mode2_data = np.vstack(all_mode2_data)                                          
                                                                                
def fit_models(data, mode_name):                                                
    X1, X2, dX2, d2X2 = data[:, 0], data[:, 1], data[:, 2], data[:, 3]          
                                                                                
    # Linear: c1*x1 + c2*x2 + c3*dx2 + bias                                     
    A_lin = np.column_stack([X1, X2, dX2, np.ones_like(X1)])                    
    coeffs_lin, _, _, _ = np.linalg.lstsq(A_lin, d2X2, rcond=None)              
    pred_lin = A_lin @ coeffs_lin                                               
    mse_lin = mean_squared_error(d2X2, pred_lin)                                
    r2_lin = r2_score(d2X2, pred_lin)                                           
                                                                                
    # Non-linear: c1*x1 + c2*x2 + c3*dx2 + c4*x1^2 + c5*x2^2 + c6*x1*x2 + bias  
    A_nl = np.column_stack([X1, X2, dX2, X1**2, X2**2, X1*X2, np.ones_like(X1)])
    coeffs_nl, _, _, _ = np.linalg.lstsq(A_nl, d2X2, rcond=None)                
    pred_nl = A_nl @ coeffs_nl                                                  
    mse_nl = mean_squared_error(d2X2, pred_nl)                                  
    r2_nl = r2_score(d2X2, pred_nl)                                             
                                                                                
    return {                                                                    
        'mode': mode_name,                                                      
        'lin_coeffs': coeffs_lin,                                               
        'lin_mse': mse_lin,                                                     
        'lin_r2': r2_lin,                                                       
        'nl_coeffs': coeffs_nl,                                                 
        'nl_mse': mse_nl,                                                       
        'nl_r2': r2_nl                                                          
    }                                                                           
                                                                                
res1 = fit_models(mode1_data, "Mode 1")                                         
res2 = fit_models(mode2_data, "Mode 2")                                         
                                                                                
print("Mode 1 Results:", res1)                                                  
print("Mode 2 Results:", res2)                                                  
# Check reset info                                                              
print("Reset check samples:", all_resets_check[:10])                            
                                                                                
