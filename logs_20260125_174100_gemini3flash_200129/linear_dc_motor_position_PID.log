              'data_all/linear/dc_motor_position_PID/sample_1.npz',             
              'data_all/linear/dc_motor_position_PID/sample_2.npz']             
                                                                                
dt = 0.001                                                                      
X_list, DX_list = [], []                                                        
                                                                                
for f in data_files:                                                            
    d = np.load(f)                                                              
    st = d['state'].T                                                           
    v = (st[1:] - st[:-1]) / dt                                                 
    xi = st[:-1]                                                                
    X_list.append(xi)                                                           
    DX_list.append(v)                                                           
                                                                                
X = np.concatenate(X_list)                                                      
DX = np.concatenate(DX_list)                                                    
                                                                                
