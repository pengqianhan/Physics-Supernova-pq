import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
data_files = ['data_all/linear/dc_motor_position_PID/sample_0.npz',             
              'data_all/linear/dc_motor_position_PID/sample_1.npz',             
              'data_all/linear/dc_motor_position_PID/sample_2.npz']             
                                                                                
def fit_pi_controller(files):                                                   
    all_e = []                                                                  
    all_inte = []                                                               
    all_dx2 = []                                                                
                                                                                
    for path in files:                                                          
        data = np.load(path)                                                    
        x1, x2 = data['state'][0], data['state'][1]                             
        e = x1 - x2                                                             
        # Global integral                                                       
        inte = np.cumsum(e) * dt                                                
        dx2 = np.diff(x2) / dt                                                  
                                                                                
        all_e.append(e[:-1])                                                    
        all_inte.append(inte[:-1])                                              
        all_dx2.append(dx2)                                                     
                                                                                
    e_vec = np.concatenate(all_e)                                               
    inte_vec = np.concatenate(all_inte)                                         
    dx2_vec = np.concatenate(all_dx2)                                           
                                                                                
    X = np.stack([e_vec, inte_vec], axis=1)                                     
    coeffs, _, _, _ = np.linalg.lstsq(X, dx2_vec, rcond=None)                   
    mse = np.mean((dx2_vec - np.dot(X, coeffs))**2)                             
    return coeffs, mse                                                          
                                                                                
coeffs, mse = fit_pi_controller(data_files)                                     
print(f"PI Controller: dx2/dt = {coeffs[0]:.4f}*(x1-x2) +                       
{coeffs[1]:.4f}*integral(x1-x2), MSE={mse:.10f}")                               
                                                                                
