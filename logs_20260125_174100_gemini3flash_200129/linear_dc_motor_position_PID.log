m0 = DX[:, 0] > 0.5                                                             
m1 = DX[:, 0] < -0.5                                                            
                                                                                
# Test hypothesis: dx2 = K * (dx1 - x2)                                         
# In Mode 0, dx1 = 1. In Mode 1, dx1 = -1.                                      
def fit_k(mask, dx1_val):                                                       
    target = DX[mask, 1]                                                        
    # target = K * (dx1_val - x2)                                               
    feat = (dx1_val - X[mask, 1]).reshape(-1, 1)                                
    k, _, _, _ = np.linalg.lstsq(feat, target, rcond=None)                      
    preds = feat @ k                                                            
    err = np.abs(preds.flatten() - target)                                      
    return k[0][0], np.mean(err), np.max(err)                                   
                                                                                
