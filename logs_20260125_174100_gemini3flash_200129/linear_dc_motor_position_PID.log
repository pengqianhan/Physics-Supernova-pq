<code>                                                                          
import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
def solve():                                                                    
    # Load all data                                                             
    all_data = []                                                               
    for path in DATA_FILE_PATHS:                                                
        with np.load(path) as data:                                             
            # Assuming 'states' is the key based on common patterns in these    
tasks                                                                           
            if 'states' in data:                                                
                all_data.append(data['states'])                                 
            else:                                                               
                # If 'states' isn't the key, let's find the correct one         
                key = list(data.keys())[0]                                      
                all_data.append(data[key])                                      
                                                                                
    # Concatenate all trajectories                                              
    states = np.concatenate(all_data, axis=0)                                   
                                                                                
    # x1 = setpoint, x2 = position                                              
    x1 = states[:, 0]                                                           
    x2 = states[:, 1]                                                           
    dt = 0.001                                                                  
                                                                                
    # Numerical differentiation for x2                                          
    dx2 = np.gradient(x2, dt)                                                   
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
    # Numerical differentiation for x1 to determine modes                       
    dx1 = np.gradient(x1, dt)                                                   
                                                                                
    # Identify modes                                                            
    # Mode 1: x1 increasing (slope ~ +1)                                        
    # Mode 2: x1 decreasing (slope ~ -1)                                        
    # Using a threshold to avoid noise at the peaks/troughs                     
    mode1_idx = dx1 > 0.5                                                       
    mode2_idx = dx1 < -0.5                                                      
                                                                                
    results = {}                                                                
                                                                                
    for mode_name, idx in [("Mode 1 (Increasing)", mode1_idx), ("Mode 2         
(Decreasing)", mode2_idx)]:                                                     
        y = d2x2[idx]                                                           
        # Features: x1[0], x2[0], x2[1], bias                                   
        X = np.column_stack([x1[idx], x2[idx], dx2[idx], np.ones(len(y))])      
                                                                                
        # Linear regression using least squares                                 
        coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)          
                                                                                
        results[mode_name] = {                                                  
            "c1": coeffs[0],                                                    
            "c2": coeffs[1],                                                    
            "c3": coeffs[2],                                                    
            "bias": coeffs[3],                                                  
            "r2": 1 - residuals[0] / (len(y) * np.var(y)) if len(residuals) > 0 
else "N/A"                                                                      
        }                                                                       
                                                                                
    # Analyze state transitions at x1=5 and x1=0                                
    # Find points near the transitions                                          
    peaks = np.where(np.diff(np.sign(dx1)))[0]                                  
    transition_analysis = []                                                    
    for p in peaks:                                                             
        val = x1[p]                                                             
        jump_x2 = x2[p+1] - x2[p]                                               
        jump_dx2 = dx2[p+1] - dx2[p]                                            
        transition_analysis.append(f"At x1={val:.2f}: Delta x2={jump_x2:.2e},   
Delta dx2={jump_dx2:.2e}")                                                      
                                                                                
    return results, transition_analysis                                         
                                                                                
results, transition_analysis = solve()                                          
print("Results:", results)                                                      
print("Transitions:", transition_analysis)                                      
                                                                                
# Final answer formatting                                                       
