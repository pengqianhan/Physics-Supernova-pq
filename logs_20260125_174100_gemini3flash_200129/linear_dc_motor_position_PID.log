import numpy as np                                                              
                                                                                
# List of data files                                                            
data_files = [                                                                  
    'data_all/linear/dc_motor_position_PID/sample_0.npz',                       
    'data_all/linear/dc_motor_position_PID/sample_1.npz',                       
    'data_all/linear/dc_motor_position_PID/sample_2.npz'                        
]                                                                               
                                                                                
# Analysis container                                                            
all_results = []                                                                
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Estimate dt using x1_dot = x2 relation                                    
    # dt = mean(dx1 / x2)                                                       
    mask = np.abs(x2) > 0.1                                                     
    dt_est = np.median(np.diff(x1)[mask[:-1]] / x2[:-1][mask[:-1]])             
                                                                                
    # Calculate derivatives                                                     
    dx2 = np.gradient(x2, dt_est)                                               
    ddx2 = np.gradient(dx2, dt_est)                                             
                                                                                
    # Identify mode for the entire sample (since each sample appears to be one  
mode)                                                                           
    # Mode 1: x1 increasing (x2 > 0), Mode 2: x1 decreasing (x2 < 0)            
    mode = 1 if np.mean(x2) > 0 else 2                                          
                                                                                
    # Perform linear regression for the mode: ddx2 = a*x1 + b*x2 + c*dx2 + d    
    A = np.column_stack([x1, x2, dx2, np.ones(len(x1))])                        
    coeffs, _, _, _ = np.linalg.lstsq(A, ddx2, rcond=None)                      
                                                                                
    all_results.append({                                                        
        'file': file_path,                                                      
        'mode': mode,                                                           
        'coeffs': coeffs,                                                       
        'x1_range': (np.min(x1), np.max(x1)),                                   
        'x2_range': (np.min(x2), np.max(x2)),                                   
        'dt': dt_est                                                            
    })                                                                          
                                                                                
# Group results by mode                                                         
