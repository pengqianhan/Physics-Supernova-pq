x2 = state[1, :]                                                                
dt = 0.001                                                                      
N = len(x1)                                                                     
                                                                                
# Central differences for i in 1 to N-2                                         
i = np.arange(1, N-1)                                                           
x1_val = x1[i]                                                                  
x2_val = x2[i]                                                                  
v2_val = (x2[i+1] - x2[i-1]) / (2 * dt)                                         
a2_val = (x2[i+1] - 2*x2[i] + x2[i-1]) / (dt**2)                                
                                                                                
# Mode identification for each i                                                
v1_val = (x1[i+1] - x1[i-1]) / (2 * dt)                                         
modes = np.zeros(len(i))                                                        
modes[v1_val > 0.5] = 1                                                         
modes[v1_val < -0.5] = 2                                                        
                                                                                
def solve_mode(m_idx):                                                          
    mask = (modes == m_idx)                                                     
    # Switches in 'modes'                                                       
    switches = np.where(np.diff(modes) != 0)[0]                                 
    for s in switches:                                                          
