print("### Mode 1 (x1 Increasing) Coefficients:")                               
print(f"a: {avg_coeffs[1][0]:.8f}")                                             
print(f"b: {avg_coeffs[1][1]:.8f}")                                             
print(f"c: {avg_coeffs[1][2]:.8f}")                                             
print(f"d: {avg_coeffs[1][3]:.8f}")                                             
                                                                                
print("\n### Mode 2 (x1 Decreasing) Coefficients:")                             
print(f"a: {avg_coeffs[2][0]:.8f}")                                             
print(f"b: {avg_coeffs[2][1]:.8f}")                                             
print(f"c: {avg_coeffs[2][2]:.8f}")                                             
print(f"d: {avg_coeffs[2][3]:.8f}")                                             
                                                                                
print("\n### Transition Analysis:")                                             
for t in transitions:                                                           
