│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[1\] = x1[0\] + 5"                                  │
│             },                                                               │
│             {                                                                │
│                 "id": 2,                                                     │
