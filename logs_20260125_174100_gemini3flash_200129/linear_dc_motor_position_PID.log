<code>                                                                          
import numpy as np                                                              
                                                                                
data = np.load('data_all/linear/dc_motor_position_PID/sample_0.npz')            
state = data['state']                                                           
# x is (2, 10001), so x1 is row 0, x2 is row 1                                  
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
dt = 0.001                                                                      
t = np.arange(len(x1)) * dt                                                     
                                                                                
v1 = np.diff(x1) / dt                                                           
# Mode 1: v1 ~ 1, Mode 2: v1 ~ -1                                               
# Let's find where it switches                                                  
modes = np.zeros_like(v1)                                                       
modes[v1 > 0] = 1                                                               
modes[v1 < 0] = 2                                                               
                                                                                
# Switching indices                                                             
switches = np.where(np.diff(modes) != 0)[0]                                     
print(f"Switching indices: {switches}")                                         
for s in switches:                                                              
    print(f"Switch at index {s}, t={t[s]}, x1={x1[s]}, x2={x2[s]}")             
                                                                                
# Derivatives for x2                                                            
v2 = np.diff(x2) / dt                                                           
a2 = np.diff(v2) / dt                                                           
                                                                                
# We need to align the data for regression                                      
# For x2[2] = a*x1[0] + b*x2[0] + c*x2[1] + d                                   
# Indices for a2: [0, ..., N-3] (length N-2)                                    
# Indices for v2: [0, ..., N-2] (length N-1)                                    
# Indices for x1, x2: [0, ..., N-1] (length N)                                  
# Alignment: a2[i] corresponds to x1[i], x2[i], v2[i]                           
x1_reg = x1[:-2]                                                                
x2_reg = x2[:-2]                                                                
v2_reg = v2[:-2]                                                                
a2_reg = a2                                                                     
modes_reg = modes[:-1] # Length N-1, match with v2/a2                           
                                                                                
# Separate modes                                                                
def solve_mode(m_idx):                                                          
    mask = (modes_reg == m_idx)                                                 
    # We should exclude the points near the switch to avoid artifacts from      
differentiation                                                                 
    # Maybe 5 points around each switch                                         
    for s in switches:                                                          
        mask[max(0, s-5):min(len(mask), s+5)] = False                           
                                                                                
    # Trim mask to length of a2_reg                                             
    mask = mask[:len(a2_reg)]                                                   
                                                                                
    Y = a2_reg[mask]                                                            
    X = np.column_stack([x1_reg[mask], x2_reg[mask], v2_reg[mask],              
np.ones(np.sum(mask))])                                                         
                                                                                
    # Solve X * [a, b, c, d]^T = Y                                              
    coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    return coeffs                                                               
                                                                                
coeffs1 = solve_mode(1)                                                         
coeffs2 = solve_mode(2)                                                         
                                                                                
print(f"Mode 1 coeffs: {coeffs1}")                                              
print(f"Mode 2 coeffs: {coeffs2}")                                              
                                                                                
# Verify dynamics of x1                                                         
v1_m1 = v1[modes == 1]                                                          
v1_m2 = v1[modes == 2]                                                          
print(f"v1 Mean Mode 1: {np.mean(v1_m1)}")                                      
print(f"v1 Mean Mode 2: {np.mean(v1_m2)}")                                      
                                                                                
