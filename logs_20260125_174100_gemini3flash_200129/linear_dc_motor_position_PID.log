import numpy as np                                                              
                                                                                
def fit_poly(X, y, degree):                                                     
    # X has shape (N, 2) where columns are x1, x2                               
    # y has shape (N,)                                                          
    n_samples = X.shape[0]                                                      
    features = [np.ones(n_samples)]                                             
    for d in range(1, degree + 1):                                              
        for i in range(d + 1):                                                  
            # x1^(d-i) * x2^i                                                   
            features.append((X[:, 0]**(d-i)) * (X[:, 1]**i))                    
                                                                                
    A = np.column_stack(features)                                               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
                                                                                
    # Calculate R-squared                                                       
    y_pred = A @ coeffs                                                         
    ss_res = np.sum((y - y_pred)**2)                                            
    ss_tot = np.sum((y - np.mean(y))**2)                                        
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    return coeffs, r2                                                           
                                                                                
# Prepare data for Mode 1                                                       
X1 = np.column_stack((x1_all[mode1_indices], x2_all[mode1_indices]))            
y1 = dx2_all[mode1_indices]                                                     
                                                                                
