for res in all_results:                                                         
    mode_coeffs[res['mode']].append(res['coeffs'])                              
                                                                                
# Average coefficients for each mode                                            
avg_coeffs = {}                                                                 
for m in [1, 2]:                                                                
    if mode_coeffs[m]:                                                          
        avg_coeffs[m] = np.mean(mode_coeffs[m], axis=0)                         
                                                                                
# Identify transition points                                                    
# In this dataset, transitions occur at the boundaries of the samples.          
transitions = []                                                                
for res in all_results:                                                         
    # A transition occurs at the end of each segment where the motion direction 
changes.                                                                        
    transitions.append(f"Sample {res['file']} (Mode {res['mode']}) at x1 range  
{res['x1_range']}")                                                             
                                                                                
