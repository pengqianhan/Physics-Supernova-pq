    gaps = np.where(np.diff(indices) > 1)[0]                                    
    starts = np.insert(indices[gaps + 1], 0, indices[0])                        
    ends = np.append(indices[gaps], indices[-1])                                
                                                                                
    clean_indices = []                                                          
    for s, e in zip(starts, ends):                                              
        length = e - s                                                          
        if length > 100:                                                        
            clean_indices.extend(range(s + length//10, e - length//10))         
                                                                                
    clean_indices = np.array(clean_indices)                                     
    Y = d2x2_all[clean_indices]                                                 
                                                                                
    # Linear                                                                    
    X_lin = np.column_stack([x1_all[clean_indices], x2_all[clean_indices],      
dx2_all[clean_indices], np.ones(len(clean_indices))])                           
    coeffs_lin, _, _, _ = np.linalg.lstsq(X_lin, Y, rcond=None)                 
    mse_lin = np.mean((Y - np.dot(X_lin, coeffs_lin))**2)                       
                                                                                
    # Nonlinear                                                                 
    X_nl = np.column_stack([x1_all[clean_indices], x2_all[clean_indices],       
dx2_all[clean_indices],                                                         
