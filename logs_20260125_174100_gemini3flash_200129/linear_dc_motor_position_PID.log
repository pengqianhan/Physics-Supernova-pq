import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
resets = []                                                                     
all_data_m1 = []                                                                
all_data_m2 = []                                                                
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']  # (2, 10001)                                         
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Precise derivatives                                                       
    x2_dot = np.zeros_like(x2)                                                  
    x2_dot[1:-1] = (x2[2:] - x2[:-2]) / (2 * dt)                                
    x2_dot[0] = (x2[1] - x2[0]) / dt                                            
    x2_dot[-1] = (x2[-1] - x2[-2]) / dt                                         
                                                                                
    x2_ddot = np.zeros_like(x2)                                                 
    x2_ddot[1:-1] = (x2[2:] - 2*x2[1:-1] + x2[:-2]) / (dt**2)                   
                                                                                
    x1_dot = np.gradient(x1, dt)                                                
                                                                                
    mode = np.zeros_like(x1, dtype=int)                                         
    mode[x1_dot > 0.5] = 1                                                      
    mode[x1_dot < -0.5] = 2                                                     
                                                                                
    # Find transitions                                                          
    for i in range(1, len(mode) - 1):                                           
        if mode[i] != mode[i-1] and mode[i-1] != 0:                             
            m_from, m_to = mode[i-1], mode[i]                                   
            # Print transition details                                          
            print(f"File {path}, Trans {m_from}->{m_to} at i={i}:               
x1={x1[i-1]:.4f}, x2={x2[i-1]:.4f}, x2_dot={x2_dot[i-1]:.4f}")                  
            print(f"  Post-trans: x1={x1[i]:.4f}, x2={x2[i]:.4f},               
x2_dot={x2_dot[i]:.4f}")                                                        
                                                                                
    # Collect data for regression, trimming 10 points around transitions        
    mask = (mode != 0)                                                          
    change = np.diff(mode) != 0                                                 
    for idx in np.where(change)[0]:                                             
        mask[max(0, idx-10):min(len(mode), idx+11)] = False                     
                                                                                
    m1_mask = mask & (mode == 1)                                                
    m2_mask = mask & (mode == 2)                                                
                                                                                
    if np.any(m1_mask):                                                         
        all_data_m1.append(np.column_stack([x1[m1_mask], x2[m1_mask],           
x2_dot[m1_mask], x2_ddot[m1_mask]]))                                            
    if np.any(m2_mask):                                                         
        all_data_m2.append(np.column_stack([x1[m2_mask], x2[m2_mask],           
x2_dot[m2_mask], x2_ddot[m2_mask]]))                                            
                                                                                
def get_coeffs(data_list):                                                      
    if not data_list: return None                                               
    data = np.concatenate(data_list)                                            
    X = data[:, :3]                                                             
    X = np.column_stack([X, np.ones(len(X))])                                   
    y = data[:, 3]                                                              
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    return coeffs                                                               
                                                                                
c1 = get_coeffs(all_data_m1)                                                    
c2 = get_coeffs(all_data_m2)                                                    
                                                                                
print("\nResults:")                                                             
print(f"Mode 1 coeffs (c1, c2, c3, bias): {c1}")                                
print(f"Mode 2 coeffs (c1, c2, c3, bias): {c2}")                                
                                                                                
