import numpy as np                                                              
import scipy.linalg                                                             
                                                                                
# 1. Load data and estimate derivatives                                         
dt = 0.001                                                                      
X1_all, X2_all, dX1_all, dX2_all = [], [], [], []                               
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    X1_all.append(x1[:-1])                                                      
    X2_all.append(x2[:-1])                                                      
    dX1_all.append(dx1)                                                         
    dX2_all.append(dx2)                                                         
                                                                                
x1 = np.concatenate(X1_all)                                                     
x2 = np.concatenate(X2_all)                                                     
dx1 = np.concatenate(dX1_all)                                                   
dx2 = np.concatenate(dX2_all)                                                   
                                                                                
# 2. Segment into modes                                                         
# Mode 1: dx1/dt approx +1.0                                                    
# Mode 2: dx1/dt approx -1.0                                                    
mask1 = np.abs(dx1 - 1.0) < 0.1                                                 
mask2 = np.abs(dx1 + 1.0) < 0.1                                                 
                                                                                
print(f"Mode 1 points: {np.sum(mask1)}")                                        
print(f"Mode 2 points: {np.sum(mask2)}")                                        
                                                                                
def solve_regression(x1_m, x2_m, target, include_quad=False):                   
    # Features: [x1, x2, 1]                                                     
    A = np.column_stack([x1_m, x2_m, np.ones_like(x1_m)])                       
    if include_quad:                                                            
        # Features: [x1, x2, 1, x1*x2, x1^2, x2^2]                              
        A = np.column_stack([x1_m, x2_m, np.ones_like(x1_m), x1_m*x2_m, x1_m**2,
x2_m**2])                                                                       
                                                                                
    coeffs, residuals, rank, s = np.linalg.lstsq(A, target, rcond=None)         
                                                                                
    # Calculate R-squared                                                       
    ss_res = np.sum((target - A @ coeffs)**2)                                   
    ss_tot = np.sum((target - np.mean(target))**2)                              
    r2 = 1 - (ss_res / ss_tot) if ss_tot > 0 else 0                             
    return coeffs, r2                                                           
                                                                                
# Results container                                                             
results = {}                                                                    
                                                                                
for mode_name, mask in [("Mode 1", mask1), ("Mode 2", mask2)]:                  
    if np.sum(mask) == 0:                                                       
        print(f"No points for {mode_name}")                                     
        continue                                                                
                                                                                
    x1_m = x1[mask]                                                             
    x2_m = x2[mask]                                                             
    dx1_m = dx1[mask]                                                           
    dx2_m = dx2[mask]                                                           
                                                                                
    # Linear models                                                             
    coeffs_dx1, r2_dx1 = solve_regression(x1_m, x2_m, dx1_m)                    
    coeffs_dx2, r2_dx2 = solve_regression(x1_m, x2_m, dx2_m)                    
                                                                                
    # Quadratic models for check                                                
    _, r2_dx1_q = solve_regression(x1_m, x2_m, dx1_m, include_quad=True)        
    _, r2_dx2_q = solve_regression(x1_m, x2_m, dx2_m, include_quad=True)        
                                                                                
    results[mode_name] = {                                                      
        "dx1": {"coeffs": coeffs_dx1, "r2": r2_dx1, "r2_quad": r2_dx1_q},       
        "dx2": {"coeffs": coeffs_dx2, "r2": r2_dx2, "r2_quad": r2_dx2_q}        
    }                                                                           
                                                                                
for mode, res in results.items():                                               
    print(f"--- {mode} ---")                                                    
    c1 = res["dx1"]["coeffs"]                                                   
    print(f"dx1/dt: a11={c1[0]:.4f}, a12={c1[1]:.4f}, b1={c1[2]:.4f}            
(R2={res['dx1']['r2']:.6f}, Quad R2={res['dx1']['r2_quad']:.6f})")              
    c2 = res["dx2"]["coeffs"]                                                   
    print(f"dx2/dt: a21={c2[0]:.4f}, a22={c2[1]:.4f}, b2={c2[2]:.4f}            
