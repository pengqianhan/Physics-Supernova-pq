    mode = np.zeros(v3.shape[0])                                                
    mode[v3 > 0.5] = 1                                                          
    mode[v3 < 0.5] = 2                                                          
                                                                                
    transitions = np.where(mode[:-1] != mode[1:])[0]                            
                                                                                
    results = []                                                                
    for t_idx in transitions:                                                   
