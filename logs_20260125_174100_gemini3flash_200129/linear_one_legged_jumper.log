import numpy as np                                                              
                                                                                
def solve_regression_nonlinear(X, y):                                           
    # Add nonlinear terms                                                       
    # x1, x2, x3, x4                                                            
    x1, x2, x3, x4 = X[:, 0], X[:, 1], X[:, 2], X[:, 3]                         
    X_aug = np.column_stack([                                                   
        x1, x2, x3, x4,                                                         
        x1*x1, x2*x2, x3*x3, x4*x4,                                             
        x1*x2, x3*x4,                                                           
        np.ones(X.shape[0])                                                     
    ])                                                                          
    coeffs, residuals, rank, s = np.linalg.lstsq(X_aug, y, rcond=None)          
    return coeffs, residuals                                                    
                                                                                
