  print(coeffs1) # Rows: x1, x2, x3, x4, bias. Columns: dx3, dx4                
  print("Mode 2 (Stance) Coefficients:")                                        
  print(coeffs0)                                                                
                                                                                
  # Check for resets at mode transitions                                        
  for p in data_paths:                                                          
      data = np.load(p)                                                         
