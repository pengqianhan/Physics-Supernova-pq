              valid_indices.append(i)                                           
                                                                                
      x_valid = s[:, valid_indices].T                                           
      dx_valid = (s[2:4, [i+1 for i in valid_indices]] - s[2:4,                 
  valid_indices]).T / dt                                                        
      m_valid = mode[valid_indices]                                             
                                                                                
      return x_valid, dx_valid, m_valid                                         
                                                                                
  X_all = []                                                                    
  DX_all = []                                                                   
  M_all = []                                                                    
                                                                                
  for p in data_paths:                                                          
      x, dx, m = analyze_sample(p, threshold=0.5)                               
      X_all.append(x)                                                           
      DX_all.append(dx)                                                         
      M_all.append(m)                                                           
                                                                                
  X = np.concatenate(X_all)                                                     
  DX = np.concatenate(DX_all)                                                   
  M = np.concatenate(M_all)                                                     
                                                                                
  def fit_linear(X, Y):                                                         
      X_aug = np.column_stack([X, np.ones(X.shape[0])])                         
      coeffs, _, _, _ = np.linalg.lstsq(X_aug, Y, rcond=None)                   
      return coeffs                                                             
                                                                                
  # Mode 1: Flight (M=1)                                                        
  X1 = X[M == 1]                                                                
  DX1 = DX[M == 1]                                                              
  coeffs1 = fit_linear(X1, DX1)                                                 
                                                                                
  # Mode 2: Stance (M=0)                                                        
  X0 = X[M == 0]                                                                
  DX0 = DX[M == 0]                                                              
  coeffs0 = fit_linear(X0, DX0)                                                 
                                                                                
