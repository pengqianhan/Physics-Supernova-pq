    mode_x2 = x2[start:end]                                                     
    mode_x3 = x3[start:end]                                                     
    mode_x4 = x4[start:end]                                                     
                                                                                
    # Check for constant acceleration                                           
    mean_dx3 = np.mean(mode_dx3)                                                
    mean_dx4 = np.mean(mode_dx4)                                                
    std_dx3 = np.std(mode_dx3)                                                  
    std_dx4 = np.std(mode_dx4)                                                  
                                                                                
    modes.append({                                                              
