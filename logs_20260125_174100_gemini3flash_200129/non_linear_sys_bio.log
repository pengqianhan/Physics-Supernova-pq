│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[1\] = x2[0\], x2[1\] = x1[0\] + u1"                │
│             }                                                                │
│         ],                                                                   │
│         "edge": [                                                            │
│             {                                                                │
│                 "direction": "1 -> 1",                                       │
│                 "condition": "x1 <= 0",                                      │
│                 "reset": {                                                   │
│                     "x1": [0\],                                              │
│                     "x2": ["-0.1 * x1[0\]"]                                  │
│                 }                                                            │
│             }                                                                │
│         ]                                                                    │
│     },                                                                       │
│     "config": {                                                              │
