Thought: I will load the data from the NPZ files, estimate the derivatives using
central differences, and fit a linear model for each variable. I will then      
evaluate the R-squared and, if necessary, add cross-product terms. Finally, I   
will analyze the stability of the system's linear part and provide the          
equations.                                                                      
                                                                                
<code>                                                                          
import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
from itertools import combinations_with_replacement                             
                                                                                
# Load all NPZ files                                                            
data_files = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
                                                                                
all_X = []                                                                      
all_dXdt = []                                                                   
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    t = data['t']                                                               
    x = data['x']  # Assuming x shape is (time_steps, 9)                        
                                                                                
    dt = t[1] - t[0]                                                            
    # Central differences for internal points                                   
    dxdt = (x[2:] - x[:-2]) / (2 * dt)                                          
    x_reduced = x[1:-1]                                                         
                                                                                
    all_X.append(x_reduced)                                                     
    all_dXdt.append(dxdt)                                                       
                                                                                
X_data = np.vstack(all_X)                                                       
dXdt_data = np.vstack(all_dXdt)                                                 
                                                                                
num_vars = 9                                                                    
models = []                                                                     
equations = []                                                                  
A_matrix = np.zeros((num_vars, num_vars))                                       
                                                                                
for i in range(num_vars):                                                       
    y = dXdt_data[:, i]                                                         
    # Linear fit first                                                          
    reg = LinearRegression().fit(X_data, y)                                     
    r2 = reg.score(X_data, y)                                                   
                                                                                
    coeffs = reg.coef_                                                          
    intercept = reg.intercept_                                                  
                                                                                
    if r2 < 0.99:                                                               
        # Try adding cross terms                                                
        cross_features = []                                                     
        cross_names = []                                                        
        for j, k in combinations_with_replacement(range(num_vars), 2):          
            cross_features.append((X_data[:, j] * X_data[:, k]).reshape(-1, 1)) 
            cross_names.append(f"x{j+1}*x{k+1}")                                
                                                                                
        cross_features_arr = np.hstack(cross_features)                          
                                                                                
        # Stepwise-like: find cross terms that improve fit                      
        # For simplicity in this task, let's try adding all and see if it hits  
0.99,                                                                           
        # but the prompt says "a few". Let's try adding them one by one or using
Lasso.                                                                          
        # However, since we just need "a few", let's identify the most          
correlated cross terms.                                                         
                                                                                
        extended_X = np.hstack([X_data, cross_features_arr])                    
        reg_ext = LinearRegression().fit(extended_X, y)                         
        r2_ext = reg_ext.score(extended_X, y)                                   
                                                                                
        # Select terms with absolute coefficient > threshold to keep it "a few" 
        # and re-fit to ensure stability of coefficients.                       
        selected_indices = np.where(np.abs(reg_ext.coef_[num_vars:]) > 1e-4)[0] 
        if len(selected_indices) > 0:                                           
            final_features = np.hstack([X_data, cross_features_arr[:,           
selected_indices]])                                                             
            reg_final = LinearRegression().fit(final_features, y)               
            r2 = reg_final.score(final_features, y)                             
                                                                                
            # Update A_matrix with linear part                                  
            A_matrix[i, :] = reg_final.coef_[:num_vars]                         
                                                                                
            # Build equation string                                             
            eq = f"dx{i+1}/dt = "                                               
            terms = []                                                          
            for j in range(num_vars):                                           
                if abs(reg_final.coef_[j]) > 1e-5:                              
                    terms.append(f"{reg_final.coef_[j]:.4f}*x{j+1}")            
            for idx, cross_idx in enumerate(selected_indices):                  
                coef = reg_final.coef_[num_vars + idx]                          
                if abs(coef) > 1e-5:                                            
                    terms.append(f"{coef:.4f}*{cross_names[cross_idx]}")        
            if abs(reg_final.intercept_) > 1e-5:                                
                terms.append(f"{reg_final.intercept_:.4f}")                     
            equations.append(" + ".join(terms).replace("+ -", "- "))            
        else:                                                                   
            A_matrix[i, :] = coeffs                                             
            eq = f"dx{i+1}/dt = " + " + ".join([f"{coeffs[j]:.4f}*x{j+1}" for j 
in range(num_vars)]) + f" + {intercept:.4f}"                                    
