  # Assuming dt = 1.0 for identifying the structure                             
  dt = 1.0                                                                      
  X_dot = np.diff(X, axis=0) / dt                                               
  X_mid = (X[:-1] + X[1:]) / 2.0                                                
                                                                                
  all_eqs = []                                                                  
  all_non_linear = []                                                           
                                                                                
  for i in range(9):                                                            
      # gLV: dx_i/dt = x_i * (b_i + sum A_ij * x_j)                             
      # Target: (dx_i/dt) / x_i                                                 
      # We use X_mid for x_i in the denominator and for the library             
      xi_mid = X_mid[:, i]                                                      
      mask = np.abs(xi_mid) > 1e-6                                              
                                                                                
      target = X_dot[mask, i] / xi_mid[mask]                                    
                                                                                
      # Library: [1, x0, x1, ..., x8]                                           
      lib = np.hstack([np.ones((np.sum(mask), 1)), X_mid[mask, :]])             
      names = ['1'] + [f"xi[{j}]" for j in range(9)]                            
                                                                                
      # Sparse regression                                                       
      threshold = 0.1                                                           
      coef = np.linalg.lstsq(lib, target, rcond=None)[0]                        
      for _ in range(10):                                                       
          small_idx = np.abs(coef) < threshold                                  
          coef[small_idx] = 0                                                   
          big_idx = ~small_idx                                                  
          if np.any(big_idx):                                                   
              coef[big_idx] = np.linalg.lstsq(lib[:, big_idx], target,          
  rcond=None)[0]                                                                
                                                                                
      # Now reconstruct the equation dx_i/dt = coef[0]*xi[i] +                  
  sum(coef[j+1]*xi[i]*xi[j])                                                    
      terms = []                                                                
      if coef[0] != 0:                                                          
          terms.append(f"({coef[0]:.3f})*xi[{i}]")                              
      for j in range(9):                                                        
          if coef[j+1] != 0:                                                    
              term_name = f"xi[{i}]*xi[{j}]"                                    
              terms.append(f"({coef[j+1]:.3f})*{term_name}")                    
              all_non_linear.append(term_name)                                  
                                                                                
      eq = f"xi[{i}] = " + " + ".join(terms)                                    
      all_eqs.append(eq)                                                        
                                                                                
  print("\n".join(all_eqs))                                                     
  unique_non_linear = sorted(list(set(all_non_linear)))                         
  print("\nNon-linear items:", ", ".join(unique_non_linear))                    
