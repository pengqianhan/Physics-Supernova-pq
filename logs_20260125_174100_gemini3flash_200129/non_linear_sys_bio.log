    d_state[:, 1:-1] = (state[:, 2:] - state[:, :-2]) / (2 * dt)                
    d_state[:, 0] = (state[:, 1] - state[:, 0]) / dt                            
    d_state[:, -1] = (state[:, -1] - state[:, -2]) / dt                         
    return d_state                                                              
                                                                                
