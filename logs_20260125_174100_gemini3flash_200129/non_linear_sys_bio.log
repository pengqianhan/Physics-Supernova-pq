import numpy as np                                                              
                                                                                
def find_best_sparse(X, y, feature_names, max_features=3):                      
    best_r2 = -1                                                                
    best_features = []                                                          
    best_coeffs = []                                                            
                                                                                
    # Just try all combinations of 1, 2, 3 features? Too many for 54 features.  
    # Let's try a simple greedy approach.                                       
    current_features = []                                                       
    for _ in range(max_features):                                               
        best_f = -1                                                             
        best_f_r2 = -1                                                          
        for f in range(X.shape[1]):                                             
            if f in current_features: continue                                  
            feat_idx = current_features + [f]                                   
            # Fit                                                               
            X_sub = X[:, feat_idx]                                              
            A = np.column_stack([X_sub, np.ones(X_sub.shape[0])])               
            coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)      
            y_mean = np.mean(y)                                                 
            ss_tot = np.sum((y - y_mean)**2)                                    
            r2 = 1 - residuals[0] / ss_tot if len(residuals) > 0 else 0         
            if r2 > best_f_r2:                                                  
                best_f_r2 = r2                                                  
                best_f = f                                                      
        if best_f != -1:                                                        
            current_features.append(best_f)                                     
            # Refit to get coeffs                                               
            X_sub = X[:, current_features]                                      
            A = np.column_stack([X_sub, np.ones(X_sub.shape[0])])               
            coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)      
            best_r2 = best_f_r2                                                 
            best_features = list(current_features)                              
            best_coeffs = coeffs                                                
                                                                                
    return best_features, best_coeffs, best_r2                                  
                                                                                
