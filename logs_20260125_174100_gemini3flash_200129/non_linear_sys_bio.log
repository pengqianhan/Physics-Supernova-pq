import numpy as np                                                              
                                                                                
# 1. Load data                                                                  
data_files = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
all_x = []                                                                      
all_dx = []                                                                     
dt = 0.001                                                                      
                                                                                
for file in data_files:                                                         
    data = np.load(file)                                                        
    x = data['x']  # x is (T, 9)                                                
    # 2. Compute derivatives using central difference                           
    dx = np.zeros_like(x)                                                       
    # Interior points: central difference                                       
    dx[1:-1, :] = (x[2:, :] - x[:-2, :]) / (2 * dt)                             
    # Endpoints: forward/backward difference                                    
    dx[0, :] = (x[1, :] - x[0, :]) / dt                                         
    dx[-1, :] = (x[-1, :] - x[-2, :]) / dt                                      
                                                                                
    all_x.append(x)                                                             
    all_dx.append(dx)                                                           
                                                                                
X_combined = np.concatenate(all_x, axis=0)                                      
dX_combined = np.concatenate(all_dx, axis=0)                                    
                                                                                
# 3. Construct feature matrix Theta                                             
# Indices: 0:x1, 1:x2, 2:x3, 3:x4, 4:x5, 5:x6, 6:x7, 7:x8, 8:x9                 
x1, x2, x3, x4, x5, x6, x7, x8, x9 = [X_combined[:, i] for i in range(9)]       
                                                                                
# Candidate features                                                            
# Constant (1.0), linear terms (x1-x9), quadratic/cross terms as specified      
feature_data = [                                                                
    ('1.0', np.ones(X_combined.shape[0])),                                      
    ('x1', x1), ('x2', x2), ('x3', x3), ('x4', x4), ('x5', x5),                 
    ('x6', x6), ('x7', x7), ('x8', x8), ('x9', x9),                             
    ('x2**2', x2**2),                                                           
    ('x2*x3', x2*x3), ('x2*x4', x2*x4), ('x2*x6', x2*x6), ('x2*x7', x2*x7),     
    ('x3*x4', x3*x4), ('x6*x8', x6*x8), ('x1*x2', x1*x2), ('x3*x6', x3*x6),     
    ('x6**2', x6**2), ('x2*x8', x2*x8), ('x4*x6', x4*x6)                        
]                                                                               
                                                                                
feature_names = [f[0] for f in feature_data]                                    
Theta = np.column_stack([f[1] for f in feature_data])                           
                                                                                
# 4. Sequential Thresholded Least Squares (STLSQ)                               
def stlsq(A, b, threshold=0.01, max_iter=10):                                   
    # Initial guess: least squares                                              
    coef, _, _, _ = np.linalg.lstsq(A, b, rcond=None)                           
                                                                                
    for _ in range(max_iter):                                                   
        small_indices = np.abs(coef) < threshold                                
        coef[small_indices] = 0                                                 
                                                                                
        # Only solve for the non-zero coefficients                              
        big_indices = np.abs(coef) >= threshold                                 
        if not np.any(big_indices):                                             
            break                                                               
                                                                                
        # Solve again using only identified features                            
        coef_new, _, _, _ = np.linalg.lstsq(A[:, big_indices], b, rcond=None)   
        coef[big_indices] = coef_new                                            
                                                                                
    return coef                                                                 
                                                                                
# 5. Perform regression for each variable                                       
all_equations = []                                                              
threshold = 0.05 # Reasonable threshold for sparsity                            
                                                                                
for i in range(9):                                                              
    b = dX_combined[:, i]                                                       
    # Process each xi                                                           
    identified_coefs = stlsq(Theta, b, threshold=threshold)                     
                                                                                
    # Format the equation                                                       
    terms = []                                                                  
    for j, val in enumerate(identified_coefs):                                  
        if abs(val) > 1e-4:                                                     
            # Match required formatting "xi[1] = ..."                           
            name = feature_names[j]                                             
            if name == '1.0':                                                   
                terms.append(f"{val:.4f}")                                      
            else:                                                               
                terms.append(f"{val:+.4f}*{name}")                              
                                                                                
    # Join terms and fix formatting                                             
    eq_body = " ".join(terms)                                                   
    # Ensure starting term doesn't have a leading + if it's the first one       
    if eq_body.startswith('+'):                                                 
        eq_body = eq_body[1:]                                                   
                                                                                
    eq_str = f"xi[{i+1}] = {eq_body}"                                           
    all_equations.append(eq_str)                                                
                                                                                
# Print results                                                                 
for eq in all_equations:                                                        
    print(eq)                                                                   
                                                                                
