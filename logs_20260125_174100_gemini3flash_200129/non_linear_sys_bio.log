import numpy as np                                                              
import scipy.stats                                                              
                                                                                
# Load data                                                                     
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
# Concatenate all samples                                                       
# Assuming shape is (Time, Variables)                                           
X = np.concatenate(all_states, axis=0)                                          
dt = 0.001                                                                      
                                                                                
# Calculate derivatives dx/dt using central differences for better accuracy if  
possible,                                                                       
# but simple forward difference is often used in these contexts.                
# Using central difference for interior points                                  
dXdt = np.zeros_like(X)                                                         
dXdt[1:-1] = (X[2:] - X[:-2]) / (2 * dt)                                        
dXdt[0] = (X[1] - X[0]) / dt                                                    
dXdt[-1] = (X[-1] - X[-2]) / dt                                                 
                                                                                
# Exclude boundaries to avoid edge effects if necessary, but we'll use the whole
set for now                                                                     
# unless the samples are disconnected.                                          
# Wait, each sample is a separate trajectory. I should calculate derivatives per
sample.                                                                         
                                                                                
dXdt_list = []                                                                  
X_trimmed_list = []                                                             
                                                                                
for s in all_states:                                                            
    d_s = np.zeros_like(s)                                                      
    d_s[1:-1] = (s[2:] - s[:-2]) / (2 * dt)                                     
    d_s[0] = (s[1] - s[0]) / dt                                                 
    d_s[-1] = (s[-1] - s[-2]) / dt                                              
    dXdt_list.append(d_s)                                                       
    X_trimmed_list.append(s)                                                    
                                                                                
X_total = np.concatenate(X_trimmed_list, axis=0)                                
dXdt_total = np.concatenate(dXdt_list, axis=0)                                  
                                                                                
n_samples, n_vars = X_total.shape                                               
                                                                                
# Build library: Constant, Linear, Quadratic                                    
# Linear: x1...x9                                                               
# Quadratic: xi*xj                                                              
library_names = ['1']                                                           
library_features = [np.ones((n_samples, 1))]                                    
                                                                                
# Linear                                                                        
for i in range(n_vars):                                                         
    library_names.append(f'x{i+1}')                                             
    library_features.append(X_total[:, i:i+1])                                  
                                                                                
# Quadratic                                                                     
for i in range(n_vars):                                                         
    for j in range(i, n_vars):                                                  
        library_names.append(f'x{i+1}*x{j+1}')                                  
        library_features.append(X_total[:, i:i+1] * X_total[:, j:j+1])          
                                                                                
Theta = np.hstack(library_features)                                             
                                                                                
# STLSQ function                                                                
def stlsq(A, b, threshold, max_iter=10):                                        
    coef = np.linalg.lstsq(A, b, rcond=None)[0]                                 
    for _ in range(max_iter):                                                   
        small_indices = np.abs(coef) < threshold                                
        coef[small_indices] = 0                                                 
        for j in range(b.shape[1]):                                             
            big_indices = ~small_indices[:, j]                                  
            if np.any(big_indices):                                             
                coef[big_indices, j] = np.linalg.lstsq(A[:, big_indices], b[:,  
j], rcond=None)[0]                                                              
    return coef                                                                 
                                                                                
# Perform sparse regression                                                     
threshold = 0.05 # Initial guess for threshold                                  
Xi = stlsq(Theta, dXdt_total, threshold)                                        
                                                                                
# Evaluate and Format                                                           
results = []                                                                    
non_linear_items = []                                                           
r2_scores = []                                                                  
                                                                                
for i in range(n_vars):                                                         
    eq_parts = []                                                               
    for j, c in enumerate(Xi[:, i]):                                            
        if abs(c) > 1e-5:                                                       
            eq_parts.append(f"{c:.4f}*{library_names[j]}")                      
            if '*' in library_names[j] or library_names[j].endswith('^2'):      
                 non_linear_items.append(f"x{i+1}[0] terms involving            
{library_names[j]}") # specific format requested?                               
                                                                                
    equation = f"x{i+1}' = " + " + ".join(eq_parts) if eq_parts else f"x{i+1}' =
0"                                                                              
                                                                                
    # R-squared                                                                 
    y_pred = Theta @ Xi[:, i]                                                   
    y_true = dXdt_total[:, i]                                                   
    ss_res = np.sum((y_true - y_pred)**2)                                       
    ss_tot = np.sum((y_true - np.mean(y_true))**2)                              
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    results.append(equation)                                                    
    r2_scores.append(r2)                                                        
                                                                                
print("Equations:")                                                             
for r in results: print(r)                                                      
print("\nR2 Scores:", r2_scores)                                                
                                                                                
# Check for regime change                                                       
