import numpy as np                                                              
                                                                                
# Load data                                                                     
data_files = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
dt = 0.001                                                                      
                                                                                
all_X = []                                                                      
all_dX = []                                                                     
                                                                                
for path in data_files:                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    dx = (state[:, 1:] - state[:, :-1]) / dt                                    
    x = state[:, :-1]                                                           
    all_X.append(x.T)                                                           
    all_dX.append(dx.T)                                                         
                                                                                
X = np.vstack(all_X)                                                            
dX = np.vstack(all_dX)                                                          
                                                                                
def solve_and_score(phi, target):                                               
    w, residuals, rank, s = np.linalg.lstsq(phi, target, rcond=None)            
    preds = np.dot(phi, w)                                                      
    mse = np.mean((target - preds)**2)                                          
    return w, mse, preds                                                        
                                                                                
results = []                                                                    
for i in range(9):                                                              
    target = dX[:, i]                                                           
    # Model 3: Bias + Linear + Quadratic                                        
    phi = np.column_stack([np.ones(X.shape[0]), X, X**2])                       
    w, mse, preds = solve_and_score(phi, target)                                
    results.append({'w': w, 'mse': mse, 'preds': preds})                        
                                                                                
# Check for switching in Sample 0                                               
sample_len = 10000                                                              
