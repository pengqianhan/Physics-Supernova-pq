# Function to build SINDy library                                               
def build_library(X):                                                           
    n_samples, n_vars = X.shape                                                 
    # Constant term                                                             
    library = [np.ones((n_samples, 1))]                                         
    names = ['1']                                                               
                                                                                
    # Linear terms                                                              
    for i in range(n_vars):                                                     
        library.append(X[:, i:i+1])                                             
        names.append(f"x{i}")                                                   
                                                                                
    # Quadratic terms (cross-terms)                                             
    for i in range(n_vars):                                                     
        for j in range(i, n_vars):                                              
            library.append((X[:, i] * X[:, j]).reshape(-1, 1))                  
            names.append(f"x{i}*x{j}")                                          
                                                                                
    return np.hstack(library), names                                            
                                                                                
# SINDy implementation                                                          
def sindy(X_dot, library, threshold=0.1):                                       
    n_features = library.shape[1]                                               
    n_targets = X_dot.shape[1]                                                  
    Xi = np.linalg.lstsq(library, X_dot, rcond=None)[0]                         
                                                                                
    # Iterate to enforce sparsity                                               
    for _ in range(10):                                                         
        small_indices = np.abs(Xi) < threshold                                  
        Xi[small_indices] = 0                                                   
        for i in range(n_targets):                                              
            big_indices = ~small_indices[:, i]                                  
            if np.any(big_indices):                                             
                Xi[big_indices, i] = np.linalg.lstsq(library[:, big_indices],   
X_dot[:, i], rcond=None)[0]                                                     
    return Xi                                                                   
                                                                                
library, names = build_library(X)                                               
Xi = sindy(X_dot, library, threshold=0.1)                                       
                                                                                
# Format the results                                                            
