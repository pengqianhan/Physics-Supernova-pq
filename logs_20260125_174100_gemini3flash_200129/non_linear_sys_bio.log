    data = np.load(path)                                                        
    if 'state' in data:                                                         
        states.append(data['state'])                                            
                                                                                
# Combine all trajectories                                                      
all_states = np.concatenate(states, axis=0)                                     
                                                                                
# Calculate derivatives dx/dt with dt=0.001                                     
dt = 0.001                                                                      
