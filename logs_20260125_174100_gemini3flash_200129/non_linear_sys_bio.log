        feats = [np.ones((inputs.shape[0], 1)), inputs]                         
        for i in range(num_vars):                                               
            for j in range(i, num_vars):                                        
                feats.append((inputs[:, i] * inputs[:, j]).reshape(-1, 1))      
        Phi = np.concatenate(feats, axis=1)                                     
                                                                                
