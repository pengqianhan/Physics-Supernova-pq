import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
from sklearn.metrics import r2_score, mean_squared_error                        
                                                                                
# Constants                                                                     
dt = 0.001                                                                      
data_files = ['data_all/non_linear/sys_bio/sample_0.npz',                       
              'data_all/non_linear/sys_bio/sample_1.npz',                       
              'data_all/non_linear/sys_bio/sample_2.npz']                       
                                                                                
all_X = []                                                                      
all_dXdt = []                                                                   
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    state = data['state'] # (9, 10001)                                          
                                                                                
    # Compute derivative using forward difference                               
    # dx/dt = (x(t+dt) - x(t)) / dt                                             
    dxdt = (state[:, 1:] - state[:, :-1]) / dt                                  
                                                                                
    # Use state at t for the features                                           
    x = state[:, :-1]                                                           
                                                                                
    all_X.append(x.T)                                                           
    all_dXdt.append(dxdt.T)                                                     
                                                                                
# Combine all data                                                              
X_combined = np.vstack(all_X) # (30000, 9)                                      
dXdt_combined = np.vstack(all_dXdt) # (30000, 9)                                
                                                                                
# Fit linear model dx/dt = A*x + b                                              
# We can use sklearn's LinearRegression or np.linalg.lstsq                      
model = LinearRegression()                                                      
model.fit(X_combined, dXdt_combined)                                            
                                                                                
A = model.coef_ # Shape (9, 9)                                                  
b = model.intercept_ # Shape (9,)                                               
                                                                                
# Predictions                                                                   
predictions = model.predict(X_combined)                                         
                                                                                
# Metrics                                                                       
r2 = r2_score(dXdt_combined, predictions, multioutput='uniform_average')        
mse = mean_squared_error(dXdt_combined, predictions)                            
                                                                                
# Formatting the output equations                                               
equations = []                                                                  
for i in range(9):                                                              
    terms = [f"{A[i, j]:.4f}*x{j+1}" for j in range(9)]                         
    eq = f"dx{i+1}/dt = {' + '.join(terms)} + {b[i]:.4f}"                       
    equations.append(eq)                                                        
                                                                                
print("Linear Model Equations:")                                                
for eq in equations:                                                            
    print(eq)                                                                   
                                                                                
print(f"\nR-squared: {r2:.6f}")                                                 
print(f"Mean Squared Error: {mse:.6e}")                                         
                                                                                
# Check individual R-squared to see if all modes fit well                       
r2_individual = r2_score(dXdt_combined, predictions, multioutput='raw_values')  
print(f"Individual R-squared: {r2_individual}")                                 
                                                                                
