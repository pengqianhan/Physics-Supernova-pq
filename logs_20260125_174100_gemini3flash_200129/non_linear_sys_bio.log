import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Parameters                                                                    
dt = 0.001                                                                      
N_vars = 9                                                                      
                                                                                
def load_and_process(file_paths):                                               
    all_states = []                                                             
    all_derivatives = []                                                        
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        state = data['state'] # (9, 10001)                                      
                                                                                
        # Calculate derivatives using central difference for interior points    
        # and forward/backward for endpoints                                    
        deriv = np.zeros_like(state)                                            
        deriv[:, 0] = (state[:, 1] - state[:, 0]) / dt                          
        deriv[:, -1] = (state[:, -1] - state[:, -2]) / dt                       
        deriv[:, 1:-1] = (state[:, 2:] - state[:, :-2]) / (2 * dt)              
                                                                                
        all_states.append(state.T) # (10001, 9)                                 
        all_derivatives.append(deriv.T) # (10001, 9)                            
                                                                                
    return np.vstack(all_states), np.vstack(all_derivatives)                    
                                                                                
X, dX = load_and_process(['data_all/non_linear/sys_bio/sample_0.npz',           
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz'])                                    
                                                                                
# Construct feature library: 1, x_i, x_i*x_j                                    
def create_features(X):                                                         
    n_samples, n_vars = X.shape                                                 
    features = [np.ones((n_samples, 1))]                                        
    feature_names = ['1']                                                       
                                                                                
    # Linear terms                                                              
    features.append(X)                                                          
    for i in range(n_vars):                                                     
        feature_names.append(f'x{i+1}')                                         
                                                                                
    # Quadratic terms                                                           
    for i in range(n_vars):                                                     
        for j in range(i, n_vars):                                              
            features.append((X[:, i] * X[:, j]).reshape(-1, 1))                 
            feature_names.append(f'x{i+1}*x{j+1}')                              
                                                                                
    return np.hstack(features), feature_names                                   
                                                                                
Phi, feature_names = create_features(X)                                         
                                                                                
# Regression for each derivative                                                
models = []                                                                     
equations = []                                                                  
residuals = []                                                                  
                                                                                
for i in range(N_vars):                                                         
    y = dX[:, i]                                                                
    # Use Lasso or Ridge if needed, but let's start with OLS for simplicity     
    # and look for sparse coefficients                                          
    reg = LinearRegression(fit_intercept=False).fit(Phi, y)                     
    coefs = reg.coef_                                                           
                                                                                
    # Filter small coefficients to make it readable                             
    expr_parts = []                                                             
    for val, name in zip(coefs, feature_names):                                 
        if abs(val) > 1e-4:                                                     
            expr_parts.append(f"{val:+.4f}*{name}")                             
                                                                                
    expr = " ".join(expr_parts) if expr_parts else "0"                          
    equations.append(f"x{i+1}[1] = {expr}")                                     
                                                                                
    # Calculate residuals                                                       
    res = np.abs(y - reg.predict(Phi))                                          
    residuals.append(res)                                                       
                                                                                
for eq in equations:                                                            
    print(eq)                                                                   
                                                                                
# Check for abrupt changes in residuals                                         
avg_residuals = np.mean(residuals, axis=0)                                      
max_residual = np.max(avg_residuals)                                            
print(f"Max average residual: {max_residual}")                                  
if max_residual > 0.1: # Heuristic threshold                                    
    print("Warning: Large residuals detected, possible mode transition or model 
mismatch.")                                                                     
else:                                                                           
    print("Residuals are low, single-mode system seems likely.")                
                                                                                
                                                                                
