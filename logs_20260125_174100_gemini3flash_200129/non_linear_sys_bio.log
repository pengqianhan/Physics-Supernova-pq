from sklearn.linear_model import LinearRegression                               
from sklearn.metrics import mean_squared_error                                  
                                                                                
# Load all data                                                                 
all_X = []                                                                      
all_Y = []                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'] # shape (9, 10001)                                    
                                                                                
    # We take X as the state at time t, and Y as the derivative (difference)    
    # Using dt=1 as a convention if not specified.                              
    X_part = state[:, :-1].T # (10000, 9)                                       
    Y_part = np.diff(state, axis=1).T # (10000, 9)                              
                                                                                
    all_X.append(X_part)                                                        
    all_Y.append(Y_part)                                                        
                                                                                
X = np.vstack(all_X)                                                            
Y = np.vstack(all_Y)                                                            
                                                                                
n_features = X.shape[1]                                                         
feature_names = [f'x{i+1}' for i in range(n_features)]                          
                                                                                
results = {}                                                                    
                                                                                
for i in range(n_features):                                                     
    yi = Y[:, i]                                                                
                                                                                
    # Linear Regression                                                         
    lr = LinearRegression()                                                     
    lr.fit(X, yi)                                                               
    y_pred = lr.predict(X)                                                      
    mse = mean_squared_error(yi, y_pred)                                        
                                                                                
    if mse <= 1e-4:                                                             
        # Linear fit is good                                                    
        coef = lr.coef_                                                         
        intercept = lr.intercept_                                               
        results[i+1] = {'type': 'linear', 'coef': coef, 'intercept': intercept, 
'mse': mse}                                                                     
    else:                                                                       
        # Try quadratic and interaction terms                                   
        # Terms: xi, xi^2, xi*xj                                                
        X_extended = [X]                                                        
        extended_names = list(feature_names)                                    
                                                                                
        # Quadratic terms                                                       
        for j in range(n_features):                                             
            X_extended.append((X[:, j]**2).reshape(-1, 1))                      
            extended_names.append(f'x{j+1}^2')                                  
                                                                                
        # Interaction terms                                                     
        for j in range(n_features):                                             
            for k in range(j + 1, n_features):                                  
                X_extended.append((X[:, j] * X[:, k]).reshape(-1, 1))           
                extended_names.append(f'x{j+1}*x{k+1}')                         
                                                                                
        X_ext = np.hstack(X_extended)                                           
        lr_ext = LinearRegression()                                             
        lr_ext.fit(X_ext, yi)                                                   
        y_pred_ext = lr_ext.predict(X_ext)                                      
        mse_ext = mean_squared_error(yi, y_pred_ext)                            
                                                                                
        results[i+1] = {                                                        
            'type': 'nonlinear',                                                
            'coef': lr_ext.coef_,                                               
            'intercept': lr_ext.intercept_,                                     
            'mse': mse_ext,                                                     
            'names': extended_names                                             
        }                                                                       
                                                                                
# Formulate the output equations                                                
equations = []                                                                  
for i in range(1, n_features + 1):                                              
    res = results[i]                                                            
    eq = f"x{i}[1] = "                                                          
    terms = []                                                                  
                                                                                
    if res['type'] == 'linear':                                                 
        for j, c in enumerate(res['coef']):                                     
            if abs(c) > 1e-5:                                                   
                terms.append(f"{c:.6f}*x{j+1}")                                 
        if abs(res['intercept']) > 1e-5:                                        
            terms.append(f"{res['intercept']:.6f}")                             
    else:                                                                       
        for j, c in enumerate(res['coef']):                                     
            if abs(c) > 1e-5:                                                   
                terms.append(f"{c:.6f}*{res['names'][j]}")                      
        if abs(res['intercept']) > 1e-5:                                        
            terms.append(f"{res['intercept']:.6f}")                             
                                                                                
    eq += " + ".join(terms).replace("+ -", "- ")                                
