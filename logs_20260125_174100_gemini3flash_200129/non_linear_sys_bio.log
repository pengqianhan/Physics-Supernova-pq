    dxdt = np.gradient(s, dt, axis=0)                                           
    all_dxdt.append(dxdt)                                                       
                                                                                
all_dxdt = np.concatenate(all_dxdt, axis=0)                                     
                                                                                
print(f"State shape: {all_states.shape}")                                       
print(f"Derivative shape: {all_dxdt.shape}")                                    
                                                                                
