        state = data['state']                                                   
        X_list.append(state[:, :-1].T)                                          
        Y_list.append(state[:, 1:].T)                                           
    X = np.vstack(X_list)                                                       
    Y = np.vstack(Y_list)                                                       
    return X, Y                                                                 
                                                                                
X_raw, Y = prepare_data([data_0, data_1, data_2])                               
