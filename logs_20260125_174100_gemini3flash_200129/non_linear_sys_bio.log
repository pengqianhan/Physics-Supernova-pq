def stlsq(Theta, dXdt, threshold=0.05, max_iter=20):                            
    # Initial least squares solution                                            
    Xi = np.linalg.lstsq(Theta, dXdt, rcond=None)[0]                            
                                                                                
    for _ in range(max_iter):                                                   
        small_indices = np.abs(Xi) < threshold                                  
        Xi[small_indices] = 0                                                   
        for i in range(dXdt.shape[1]):                                          
            big_indices = ~small_indices[:, i]                                  
            if np.any(big_indices):                                             
                Xi[big_indices, i] = np.linalg.lstsq(Theta[:, big_indices],     
dXdt[:, i], rcond=None)[0]                                                      
    return Xi                                                                   
                                                                                
