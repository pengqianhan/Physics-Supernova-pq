threshold = 0.1  # Threshold for normalized coefficients                        
                                                                                
def compute_derivatives(state, dt):                                             
    d_state = np.zeros_like(state)                                              
    d_state[:, 1:-1] = (state[:, 2:] - state[:, :-2]) / (2 * dt)                
    d_state[:, 0] = (state[:, 1] - state[:, 0]) / dt                            
    d_state[:, -1] = (state[:, -1] - state[:, -2]) / dt                         
    return d_state                                                              
                                                                                
