W_diff, _, _, _ = np.linalg.lstsq(X_lin, Diff, rcond=None)                      
                                                                                
Diff_pred = np.dot(X_lin, W_diff)                                               
SS_res = np.sum((Diff - Diff_pred)**2, axis=0)                                  
SS_tot = np.sum((Diff - np.mean(Diff, axis=0))**2, axis=0)                      
r2_diff = 1 - (SS_res / SS_tot)                                                 
print(f"R2 on differences (linear): {r2_diff}")                                 
print(f"Mean R2 on differences: {np.mean(r2_diff)}")                            
                                                                                
