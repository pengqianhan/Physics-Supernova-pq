paths = ['data_all/non_linear/sys_bio/sample_0.npz',                            
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
                                                                                
# Load and inspect data                                                         
all_x = []                                                                      
all_t = []                                                                      
                                                                                
for path in paths:                                                              
    data = np.load(path)                                                        
    all_x.append(data['x'])                                                     
    all_t.append(data['t'])                                                     
                                                                                
# Checking shapes                                                               
for i, (x, t) in enumerate(zip(all_x, all_t)):                                  
    print(f"Sample {i}: x shape {x.shape}, t shape {t.shape}")                  
                                                                                
dt = 0.001 # Given in the prompt                                                
                                                                                
# Preprocessing: compute derivatives and combine data                           
X_list = []                                                                     
dX_list = []                                                                    
                                                                                
for x in all_x:                                                                 
    # Forward difference for derivative                                         
    dx = (x[1:] - x[:-1]) / dt                                                  
    X_list.append(x[:-1]) # Match size with dx                                  
    dX_list.append(dx)                                                          
                                                                                
X = np.vstack(X_list)                                                           
dX = np.vstack(dX_list)                                                         
                                                                                
print(f"Combined X shape: {X.shape}")                                           
print(f"Combined dX shape: {dX.shape}")                                         
                                                                                
# Construct library: 1, x1...x9, x1^2, x1x2...x9^2                              
def build_library(X):                                                           
    n_samples, n_vars = X.shape                                                 
    library = [np.ones((n_samples, 1))] # Constant term                         
    library.append(X) # Linear terms                                            
                                                                                
    # Quadratic terms                                                           
    for i in range(n_vars):                                                     
        for j in range(i, n_vars):                                              
            library.append((X[:, i] * X[:, j]).reshape(-1, 1))                  
                                                                                
    return np.hstack(library)                                                   
                                                                                
Theta = build_library(X)                                                        
print(f"Library shape: {Theta.shape}")                                          
                                                                                
# Feature names for formatting                                                  
feature_names = ['1'] + [f'x{i+1}[0]' for i in range(9)]                        
for i in range(9):                                                              
    for j in range(i, 9):                                                       
        feature_names.append(f'x{i+1}[0]*x{j+1}[0]' if i != j else              
f'x{i+1}[0]**2')                                                                
                                                                                
# Solve least squares for each derivative                                       
coeffs = []                                                                     
for i in range(9):                                                              
    c, _, _, _ = np.linalg.lstsq(Theta, dX[:, i], rcond=None)                   
    coeffs.append(c)                                                            
                                                                                
coeffs = np.array(coeffs)                                                       
                                                                                
# Filter small coefficients to simplify equations (thresholding)                
threshold = 1e-3                                                                
coeffs_clean = np.where(np.abs(coeffs) > threshold, coeffs, 0)                  
                                                                                
# Format equations                                                              
equations = []                                                                  
non_linear_terms_used = set()                                                   
                                                                                
for i in range(9):                                                              
    row = coeffs_clean[i]                                                       
    terms = []                                                                  
    for val, name in zip(row, feature_names):                                   
        if val != 0:                                                            
            terms.append(f"{val:.4f}*{name}")                                   
            if '*' in name or '**' in name:                                     
                non_linear_terms_used.add(name)                                 
    eq = f"x{i+1}[1] = " + " + ".join(terms).replace("+ -", "- ")               
    equations.append(eq)                                                        
                                                                                
print("\n".join(equations))                                                     
print("\nNon-linear terms:", sorted(list(non_linear_terms_used)))               
                                                                                
# Prepare final answer parts                                                    
result_eqs = ", ".join(equations)                                               
non_linear_str = ", ".join(sorted(list(non_linear_terms_used)))                 
                                                                                
