      dx[1:-1, :] = (x[2:, :] - x[:-2, :]) / (2 * dt)                           
      dx[0, :] = (x[1, :] - x[0, :]) / dt                                       
      dx[-1, :] = (x[-1, :] - x[-2, :]) / dt                                    
      all_x.append(x)                                                           
      all_dx.append(dx)                                                         
                                                                                
  X = np.concatenate(all_x, axis=0)                                             
  dX = np.concatenate(all_dx, axis=0)                                           
                                                                                
  # 2. Build Candidate Features                                                 
  x1, x2, x3, x4, x5, x6, x7, x8, x9 = [X[:, i] for i in range(9)]              
  features = [                                                                  
      ('1.0', np.ones(X.shape[0])),                                             
      ('x1', x1), ('x2', x2), ('x3', x3), ('x4', x4), ('x5', x5),               
      ('x6', x6), ('x7', x7), ('x8', x8), ('x9', x9),                           
      ('x2**2', x2**2), ('x2*x3', x2*x3), ('x2*x4', x2*x4), ('x2*x6', x2*x6),   
      ('x2*x7', x2*x7), ('x3*x4', x3*x4), ('x6*x8', x6*x8), ('x1*x2', x1*x2),   
      ('x3*x6', x3*x6), ('x6**2', x6**2), ('x2*x8', x2*x8), ('x4*x6', x4*x6)    
  ]                                                                             
  feature_names = [f[0] for f in features]                                      
  Theta = np.column_stack([f[1] for f in features])                             
                                                                                
  # 3. Robust STLSQ algorithm                                                   
  def stlsq_robust(A, b, threshold=0.1, max_iter=20):                           
      # Use rcond=1e-3 to ignore small singular values (handles collinearity)   
      coef, _, _, _ = np.linalg.lstsq(A, b, rcond=1e-3)                         
      for _ in range(max_iter):                                                 
          small_indices = np.abs(coef) < threshold                              
          coef[small_indices] = 0                                               
          big_indices = np.abs(coef) >= threshold                               
          if not np.any(big_indices):                                           
              break                                                             
          reduced_A = A[:, big_indices]                                         
          coef_reduced, _, _, _ = np.linalg.lstsq(reduced_A, b, rcond=1e-3)     
          coef[big_indices] = coef_reduced                                      
      return coef                                                               
                                                                                
  # 4. Identification and Equation Formatting                                   
  final_equations = []                                                          
  for i in range(9):                                                            
      b = dX[:, i]                                                              
      c = stlsq_robust(Theta, b, threshold=0.1)                                 
                                                                                
      terms = []                                                                
      for val, name in zip(c, feature_names):                                   
          if abs(val) > 1e-4:                                                   
              if name == '1.0':                                                 
                  terms.append(f"{val:.4f}")                                    
              else:                                                             
                  sign = "+" if val >= 0 else "-"                               
                  terms.append(f" {sign} {abs(val):.4f}*{name}")                
                                                                                
      eq_body = "".join(terms).strip()                                          
      if eq_body.startswith('+'):                                               
          eq_body = eq_body[1:].strip()                                         
                                                                                
      final_equations.append(f"xi[{i+1}] = {eq_body}")                          
                                                                                
  # Output for manager                                                          
  for eq in final_equations:                                                    
      print(eq)                                                                 
