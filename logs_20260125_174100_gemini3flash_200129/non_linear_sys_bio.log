import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load(DATA_FILE_PATH)                                                  
state = data['state'] # Shape (9, 10001)                                        
X = state.T # Shape (10001, 9)                                                  
                                                                                
# Standard dt for 10001 points is often 0.01                                    
dt = 0.01                                                                       
X_dot = np.gradient(X, axis=0) / dt                                             
                                                                                
# Construct feature matrix Theta                                                
num_samples, num_vars = X.shape                                                 
Theta = [np.ones((num_samples, 1))] # Constant                                  
feature_names = ["1"]                                                           
                                                                                
# Linear terms                                                                  
for i in range(num_vars):                                                       
    Theta.append(X[:, i:i+1])                                                   
    feature_names.append(f"x{i+1}[0]")                                          
                                                                                
# Quadratic terms                                                               
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        Theta.append((X[:, i] * X[:, j]).reshape(-1, 1))                        
        name = f"x{i+1}[0]*x{j+1}[0]" if i != j else f"x{i+1}[0]**2"            
        feature_names.append(name)                                              
                                                                                
Theta = np.hstack(Theta)                                                        
                                                                                
# SINDy sparse regression                                                       
def sparse_regression(Theta, X_dot, threshold=0.01):                            
    coef = np.linalg.lstsq(Theta, X_dot, rcond=None)[0]                         
    for _ in range(10):                                                         
        small_indices = np.abs(coef) < threshold                                
        coef[small_indices] = 0                                                 
        for i in range(X_dot.shape[1]):                                         
            big_indices = np.abs(coef[:, i]) >= threshold                       
            if np.any(big_indices):                                             
                coef[big_indices, i] = np.linalg.lstsq(Theta[:, big_indices],   
X_dot[:, i], rcond=None)[0]                                                     
    return coef                                                                 
                                                                                
coefs = sparse_regression(Theta, X_dot, threshold=0.01)                         
                                                                                
# Format the results                                                            
equations = []                                                                  
non_linear_items = set()                                                        
                                                                                
for i in range(num_vars):                                                       
    terms = []                                                                  
    for j, c in enumerate(coefs[:, i]):                                         
        if abs(c) >= 0.01:                                                      
            val = round(float(c), 3)                                            
            name = feature_names[j]                                             
            if name == "1":                                                     
                terms.append(f"{val}")                                          
            else:                                                               
                terms.append(f"{val}*{name}")                                   
            if "*" in name or "**" in name:                                     
                non_linear_items.add(name)                                      
                                                                                
    eq = f"x{i+1}[1] = " + " + ".join(terms).replace("+ -", "- ")               
    equations.append(eq)                                                        
                                                                                
print("Equations String:")                                                      
print(", ".join(equations))                                                     
print("\nNon-linear Items String:")                                             
print(", ".join(sorted(list(non_linear_items))))                                
                                                                                
