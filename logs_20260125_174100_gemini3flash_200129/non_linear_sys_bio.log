states = []                                                                     
for path in data_files:                                                         
    data = np.load(path)                                                        
    states.append(data['state'])                                                
                                                                                
dt = 0.01  # Assumed time step                                                  
                                                                                
X_list = []                                                                     
dX_list = []                                                                    
                                                                                
for s in states:                                                                
    # s is (9, 10001)                                                           
    # Compute derivatives using central difference                              
    dx = np.zeros_like(s)                                                       
    dx[:, 1:-1] = (s[:, 2:] - s[:, :-2]) / (2 * dt)                             
    dx[:, 0] = (s[:, 1] - s[:, 0]) / dt                                         
    dx[:, -1] = (s[:, -1] - s[:, -2]) / dt                                      
                                                                                
    X_list.append(s.T)                                                          
    dX_list.append(dx.T)                                                        
                                                                                
X = np.vstack(X_list)                                                           
dX = np.vstack(dX_list)                                                         
                                                                                
# Build features: bias, x1..x9, xi*xj                                           
def get_features(X):                                                            
    n_samples, n_vars = X.shape                                                 
    features = [np.ones((n_samples, 1))] # Bias                                 
    features.append(X) # Linear                                                 
    # Quadratic                                                                 
    for i in range(n_vars):                                                     
        for j in range(i, n_vars):                                              
            features.append((X[:, i] * X[:, j]).reshape(-1, 1))                 
    return np.concatenate(features, axis=1)                                     
                                                                                
Phi = get_features(X)                                                           
                                                                                
