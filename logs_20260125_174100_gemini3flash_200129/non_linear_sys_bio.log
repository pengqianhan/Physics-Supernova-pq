    # 2. Compute derivatives using central differences                          
    # Using np.gradient with axis 1 (time dimension)                            
    dx = np.gradient(state, axis=1) / dt                                        
                                                                                
    all_X.append(state.T)                                                       
    all_dX.append(dx.T)                                                         
                                                                                
X = np.vstack(all_X)                                                            
dX = np.vstack(all_dX)                                                          
                                                                                
# 4. Candidate features                                                         
# Linear: x1 ... x9                                                             
# Quadratic: xi*xj                                                              
n_vars = 9                                                                      
feature_names = ["1"]                                                           
features = [np.ones((X.shape[0], 1))]                                           
                                                                                
# Linear                                                                        
for i in range(n_vars):                                                         
    feature_names.append(f"x{i+1}")                                             
    features.append(X[:, i:i+1])                                                
                                                                                
# Quadratic (xi * xj)                                                           
for i in range(n_vars):                                                         
    for j in range(i, n_vars):                                                  
        feature_names.append(f"x{i+1}*x{j+1}")                                  
        features.append((X[:, i] * X[:, j]).reshape(-1, 1))                     
                                                                                
Theta = np.hstack(features)                                                     
                                                                                
# 3. Check for single mode / 4. Sparse Regression                               
# We'll use Sequentially Thresholded Ridge Regression (STRidge)                 
def stridge(X, y, lam=0.1, threshold=0.01, max_iter=10):                        
    n, d = X.shape                                                              
    # Initial ridge regression                                                  
    coeffs = np.linalg.lstsq(X.T @ X + lam * np.eye(d), X.T @ y, rcond=None)[0] 
                                                                                
    for _ in range(max_iter):                                                   
        small_indices = np.abs(coeffs) < threshold                              
        coeffs[small_indices] = 0                                               
        big_indices = np.logical_not(small_indices)                             
        if not np.any(big_indices):                                             
            break                                                               
        # Re-solve on remaining indices                                         
        coeffs[big_indices] = np.linalg.lstsq(X[:, big_indices].T @ X[:,        
big_indices] + lam * np.eye(np.sum(big_indices)), X[:, big_indices].T @ y,      
rcond=None)[0]                                                                  
                                                                                
    return coeffs                                                               
                                                                                
final_odes = []                                                                 
scores = []                                                                     
                                                                                
for i in range(n_vars):                                                         
    y = dX[:, i]                                                                
    # We'll tune threshold/lam slightly or use reasonable defaults              
    # Since we need "Lasso-like" behavior, STRidge is a good proxy.             
    # We can try a few thresholds to find a sparse solution.                    
    best_coeffs = stridge(Theta, y, lam=0.1, threshold=0.0001)                  
                                                                                
    # Calculate R^2                                                             
    y_pred = Theta @ best_coeffs                                                
    ss_res = np.sum((y - y_pred)**2)                                            
    ss_tot = np.sum((y - np.mean(y))**2)                                        
    r2 = 1 - (ss_res / ss_tot)                                                  
    scores.append(r2)                                                           
                                                                                
    # Format ODE                                                                
    terms = []                                                                  
    for val, name in zip(best_coeffs, feature_names):                           
        if abs(val) > 1e-6:                                                     
            terms.append(f"({val:.6f})*{name}")                                 
                                                                                
    ode_str = f"xi[{i+1}] = " + (" + ".join(terms) if terms else "0")           
    final_odes.append(ode_str)                                                  
    print(f"Variable x{i+1} Identified. R^2: {r2:.4f}")                         
                                                                                
# Print final results                                                           
for ode in final_odes:                                                          
    print(ode)                                                                  
                                                                                
