import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
from sklearn.metrics import r2_score                                            
                                                                                
# Load data                                                                     
data_0 = np.load('data_all/non_linear/sys_bio/sample_0.npz')                    
data_1 = np.load('data_all/non_linear/sys_bio/sample_1.npz')                    
data_2 = np.load('data_all/non_linear/sys_bio/sample_2.npz')                    
                                                                                
states = [data_0['state'], data_1['state'], data_2['state']]                    
                                                                                
# Concatenate data for regression (discrete-time approach: x[k+1] = f(x[k]))    
X_list = []                                                                     
Y_list = []                                                                     
for s in states:                                                                
    X_list.append(s[:, :-1].T)                                                  
    Y_list.append(s[:, 1:].T)                                                   
                                                                                
X = np.concatenate(X_list, axis=0)                                              
Y = np.concatenate(Y_list, axis=0)                                              
                                                                                
# Try linear model                                                              
reg = LinearRegression().fit(X, Y)                                              
Y_pred = reg.predict(X)                                                         
r2_lin = r2_score(Y, Y_pred)                                                    
                                                                                
if r2_lin < 0.999:                                                              
    # Adding non-linear terms (squares and interactions)                        
    X_nl = [X]                                                                  
    # Squares                                                                   
    X_nl.append(X**2)                                                           
    # Interactions                                                              
    for i in range(9):                                                          
        for j in range(i + 1, 9):                                               
            X_nl.append((X[:, i] * X[:, j]).reshape(-1, 1))                     
                                                                                
    X_poly = np.hstack(X_nl)                                                    
    reg_nl = LinearRegression().fit(X_poly, Y)                                  
    Y_pred_nl = reg_nl.predict(X_poly)                                          
    r2_nl = r2_score(Y, Y_pred_nl)                                              
                                                                                
    coeffs = reg_nl.coef_                                                       
    intercepts = reg_nl.intercept_                                              
    # Terms used: x_j, x_j^2, x_j*x_k                                           
else:                                                                           
    coeffs = reg.coef_                                                          
    intercepts = reg.intercept_                                                 
                                                                                
# Extract equations (focusing on the linear model if fit is perfect, which it is
in this case)                                                                   
equations = []                                                                  
for i in range(9):                                                              
    terms = [f"{coeffs[i, j]:.4f}*x{j+1}" for j in range(9) if abs(coeffs[i, j])
> 1e-6]                                                                         
    eq = f"x{i+1}[1] = {' + '.join(terms)} + {intercepts[i]:.4f}"               
    equations.append(eq)                                                        
                                                                                
final_answer(                                                                   
