equations = []                                                                  
                                                                                
for i in range(num_states):                                                     
    y = DX_data[:, i]                                                           
    # Use Lasso to find sparse coefficients                                     
    lasso = Lasso(alpha=0.001, fit_intercept=True)                              
    lasso.fit(Phi, y)                                                           
                                                                                
    # Filter coefficients                                                       
    coeffs = lasso.coef_                                                        
    intercept = lasso.intercept_                                                
                                                                                
    terms = []                                                                  
    if abs(intercept) > 1e-4:                                                   
        terms.append(f"{intercept:.4f}")                                        
                                                                                
    for val, name in zip(coeffs, feature_names):                                
