import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
from sklearn.metrics import r2_score                                            
                                                                                
dt = 0.001                                                                      
states = []                                                                     
derivatives = []                                                                
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'] # shape (T, 9)                                        
    states.append(state[:-1])                                                   
    # Compute numerical derivative (forward difference)                         
    deriv = (state[1:] - state[:-1]) / dt                                       
    derivatives.append(deriv)                                                   
                                                                                
X = np.concatenate(states, axis=0)                                              
Y = np.concatenate(derivatives, axis=0)                                         
                                                                                
num_vars = 9                                                                    
equations = []                                                                  
                                                                                
for i in range(num_vars):                                                       
    y_i = Y[:, i]                                                               
    model = LinearRegression()                                                  
    model.fit(X, y_i)                                                           
    y_pred = model.predict(X)                                                   
    r2 = r2_score(y_i, y_pred)                                                  
                                                                                
    if r2 >= 0.99:                                                              
        # Linear fit is good                                                    
        terms = [f"{model.intercept_:.6f}"]                                     
        for j in range(num_vars):                                               
            if abs(model.coef_[j]) > 1e-6:                                      
                terms.append(f"{model.coef_[j]:+.6f} * x{j+1}")                 
        eq = f"x{i+1}[1] = " + " ".join(terms)                                  
        equations.append((i+1, eq, r2))                                         
    else:                                                                       
        # Try quadratic                                                         
        # Features: x1...x9, x1^2...x9^2, x1x2...                               
        X_quad = [X]                                                            
        quad_names = [f"x{j+1}" for j in range(num_vars)]                       
                                                                                
        # Squares                                                               
        for j in range(num_vars):                                               
            X_quad.append(X[:, j:j+1]**2)                                       
            quad_names.append(f"x{j+1}**2")                                     
                                                                                
        # Cross products                                                        
        for j in range(num_vars):                                               
            for k in range(j + 1, num_vars):                                    
                X_quad.append(X[:, j:j+1] * X[:, k:k+1])                        
                quad_names.append(f"x{j+1}*x{k+1}")                             
                                                                                
        X_quad_concat = np.concatenate(X_quad, axis=1)                          
        model_q = LinearRegression()                                            
        model_q.fit(X_quad_concat, y_i)                                         
        y_pred_q = model_q.predict(X_quad_concat)                               
        r2_q = r2_score(y_i, y_pred_q)                                          
                                                                                
        terms = [f"{model_q.intercept_:.6f}"]                                   
        for j in range(X_quad_concat.shape[1]):                                 
            if abs(model_q.coef_[j]) > 1e-4: # Higher threshold for clarity     
                terms.append(f"{model_q.coef_[j]:+.6f} * {quad_names[j]}")      
        eq = f"x{i+1}[1] = " + " ".join(terms)                                  
        equations.append((i+1, eq, r2_q))                                       
                                                                                
for idx, eq, r2 in equations:                                                   
    print(f"Variable x{idx}: R2 = {r2:.6f}")                                    
    print(eq)                                                                   
    print("-" * 20)                                                             
                                                                                
