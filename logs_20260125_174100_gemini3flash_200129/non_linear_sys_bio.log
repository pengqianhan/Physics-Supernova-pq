# Load data and check shapes                                                    
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
dt = 0.001                                                                      
dXdt_list = []                                                                  
X_list = []                                                                     
                                                                                
for s in all_states:                                                            
    # Use 2nd order central difference for interior, 1st order for edges        
    d_s = np.zeros_like(s)                                                      
    d_s[1:-1, :] = (s[2:, :] - s[:-2, :]) / (2 * dt)                            
    d_s[0, :] = (s[1, :] - s[0, :]) / dt                                        
    d_s[-1, :] = (s[-1, :] - s[-2, :]) / dt                                     
    dXdt_list.append(d_s)                                                       
    X_list.append(s)                                                            
                                                                                
X_total = np.vstack(X_list)                                                     
dXdt_total = np.vstack(dXdt_list)                                               
                                                                                
n_samples, n_vars = X_total.shape                                               
                                                                                
# Efficiently build the library                                                 
# 1 (const), 9 (linear), 45 (quadratic) = 55 features                           
n_features = 1 + n_vars + (n_vars * (n_vars + 1)) // 2                          
Theta = np.zeros((n_samples, n_features))                                       
lib_names = []                                                                  
                                                                                
# Constant                                                                      
Theta[:, 0] = 1                                                                 
lib_names.append('1')                                                           
                                                                                
# Linear                                                                        
for i in range(n_vars):                                                         
    Theta[:, 1 + i] = X_total[:, i]                                             
    lib_names.append(f'x{i+1}[0]')                                              
                                                                                
# Quadratic                                                                     
idx = 1 + n_vars                                                                
for i in range(n_vars):                                                         
    for j in range(i, n_vars):                                                  
        Theta[:, idx] = X_total[:, i] * X_total[:, j]                           
        if i == j:                                                              
            lib_names.append(f'x{i+1}[0]**2')                                   
        else:                                                                   
            lib_names.append(f'x{i+1}[0]*x{j+1}[0]')                            
        idx += 1                                                                
                                                                                
# Sparse regression (STLSQ)                                                     
def stlsq_fit(Theta, dXdt, threshold=0.1):                                      
    n_vars = dXdt.shape[1]                                                      
    Xi = np.linalg.lstsq(Theta, dXdt, rcond=None)[0]                            
    for _ in range(10):                                                         
        small_inds = np.abs(Xi) < threshold                                     
        Xi[small_inds] = 0                                                      
        for i in range(n_vars):                                                 
            big_inds = ~small_inds[:, i]                                        
            if np.any(big_inds):                                                
                Xi[big_inds, i] = np.linalg.lstsq(Theta[:, big_inds], dXdt[:,   
i], rcond=None)[0]                                                              
    return Xi                                                                   
                                                                                
Xi = stlsq_fit(Theta, dXdt_total, threshold=0.01)                               
                                                                                
# Format equations                                                              
