  dt = 0.001                                                                    
                                                                                
  for file_path in data_files:                                                  
      data = np.load(file_path)                                                 
      state = data['state'] # Shape (9, 10001)                                  
                                                                                
      # 2. Compute the state derivatives dx/dt                                  
      # Use forward difference: (x[t+1] - x[t]) / dt                            
      x_t = state[:, :-1]                                                       
      x_t_plus_1 = state[:, 1:]                                                 
      dxdt = (x_t_plus_1 - x_t) / dt                                            
                                                                                
      all_x.append(x_t.T) # Shape (10000, 9)                                    
      all_dxdt.append(dxdt.T) # Shape (10000, 9)                                
                                                                                
  # 3. Combine data from all traces                                             
  X = np.vstack(all_x) # (30000, 9)                                             
  Y = np.vstack(all_dxdt) # (30000, 9)                                          
                                                                                
  # 4. Fit a linear model dx/dt = A * x + b using least squares                 
  # Add a column of ones for the bias term b                                    
  X_aug = np.hstack([X, np.ones((X.shape[0], 1))])                              
                                                                                
  # Solve X_aug * W = Y                                                         
  # W will have shape (10, 9)                                                   
  W, residuals, rank, s = np.linalg.lstsq(X_aug, Y, rcond=None)                 
                                                                                
  # Coefficients A (9x9) and intercept b (9,)                                   
  A = W[:9, :].T                                                                
  b = W[9, :]                                                                   
                                                                                
  # 6. Check fit quality                                                        
  # Compute predictions using np.dot instead of @                               
  Y_pred = np.dot(X_aug, W)                                                     
                                                                                
  # Mean Squared Error                                                          
  mse = np.mean((Y - Y_pred)**2)                                                
                                                                                
  # R-squared                                                                   
  ss_res = np.sum((Y - Y_pred)**2, axis=0)                                      
  ss_tot = np.sum((Y - np.mean(Y, axis=0))**2, axis=0)                          
  r2_per_var = 1 - (ss_res / ss_tot)                                            
  r2_avg = np.mean(r2_per_var)                                                  
                                                                                
  # 5. Provide the resulting equations                                          
  equations = []                                                                
  for i in range(9):                                                            
      terms = [f"({A[i, j]:.6f} * x{j+1})" for j in range(9)]                   
      eq = f"x{i+1}[1] = " + " + ".join(terms) + f" + ({b[i]:.6f})"             
      equations.append(eq)                                                      
                                                                                
  print("Equations:")                                                           
  for eq in equations:                                                          
      print(eq)                                                                 
  print(f"\nAverage R-squared: {r2_avg:.6f}")                                   
  print(f"Individual R-squared: {r2_per_var}")                                  
  print(f"Mean Squared Error: {mse:.6e}")                                       
