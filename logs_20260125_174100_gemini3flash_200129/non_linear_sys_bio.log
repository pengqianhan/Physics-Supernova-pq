import numpy as np                                                              
                                                                                
# Load data and compute derivatives                                             
data_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
all_X = []                                                                      
all_dX = []                                                                     
                                                                                
for path in data_paths:                                                         
    data = np.load(path)                                                        
    # Based on observation, keys are 'state' and 'input'                        
    state = data['state'] # Shape (9, 10001)                                    
    # Transpose to (10001, 9) for easier processing                             
    X = state.T                                                                 
    # Calculate derivative assuming dt=1 (standard if not provided)             
    dX = np.gradient(X, axis=0)                                                 
    all_X.append(X)                                                             
    all_dX.append(dX)                                                           
                                                                                
X_combined = np.vstack(all_X)                                                   
dX_combined = np.vstack(all_dX)                                                 
                                                                                
num_samples, num_vars = X_combined.shape                                        
                                                                                
# Build the feature matrix Phi                                                  
features = []                                                                   
feature_names = ['1']                                                           
features.append(np.ones((num_samples, 1)))                                      
                                                                                
# Linear terms                                                                  
for i in range(num_vars):                                                       
    features.append(X_combined[:, i:i+1])                                       
    feature_names.append(f"x{i+1}")                                             
                                                                                
# Quadratic terms                                                               
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        features.append((X_combined[:, i] * X_combined[:, j]).reshape(-1, 1))   
        feature_names.append(f"x{i+1}*x{j+1}")                                  
                                                                                
Phi = np.hstack(features)                                                       
                                                                                
# Identify ODEs using Least Squares                                             
equations = {}                                                                  
mses = []                                                                       
threshold = 1e-4                                                                
                                                                                
for i in range(num_vars):                                                       
    target = dX_combined[:, i]                                                  
    # Solve Phi * xi = target                                                   
    xi, residuals, rank, s = np.linalg.lstsq(Phi, target, rcond=None)           
                                                                                
    # Generate equation string                                                  
    terms = []                                                                  
    for val, name in zip(xi, feature_names):                                    
        if abs(val) > threshold:                                                
            terms.append(f"({val:.6f})*{name}")                                 
                                                                                
    equations[f"x{i+1}"] = " + ".join(terms) if terms else "0"                  
                                                                                
    # Calculate MSE                                                             
    preds = Phi @ xi                                                            
    mse = np.mean((target - preds)**2)                                          
    mses.append(mse)                                                            
                                                                                
# Result Printing                                                               
print("Identified Equations (assuming dt=1):")                                  
for var, eq in equations.items():                                               
    print(f"d{var}/dt = {eq}")                                                  
                                                                                
avg_mse = np.mean(mses)                                                         
print(f"\nAverage MSE: {avg_mse:.6e}")                                          
print("Individual MSEs:", [f"{m:.2e}" for m in mses])                           
                                                                                
# Check for modes: If MSE is extremely small, it's likely a single mode.        
# If MSE is higher, we might check if error is localized.                       
if avg_mse < 1e-6:                                                              
    print("\nThe system is likely a single mode system.")                       
else:                                                                           
    print("\nThe MSE is relatively high; checking for potential switching.")    
                                                                                
