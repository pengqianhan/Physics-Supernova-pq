import numpy as np                                                              
import os                                                                       
                                                                                
# 1. Load data                                                                  
dt = 0.001                                                                      
data_paths = ["data_all/non_linear/sys_bio/sample_0.npz",                       
"data_all/non_linear/sys_bio/sample_1.npz",                                     
"data_all/non_linear/sys_bio/sample_2.npz"]                                     
                                                                                
all_states = []                                                                 
all_derivs = []                                                                 
                                                                                
for path in data_paths:                                                         
    data = np.load(path)                                                        
    state = data['state'] # shape (9, num_steps)                                
                                                                                
    # Calculate derivatives (forward difference)                                
    # x_dot(t) = (x(t+1) - x(t)) / dt                                           
    deriv = (state[:, 1:] - state[:, :-1]) / dt                                 
    # Match the state to the derivative timing (state at t)                     
    state_trimmed = state[:, :-1]                                               
                                                                                
    all_states.append(state_trimmed.T)                                          
    all_derivs.append(deriv.T)                                                  
                                                                                
# Concatenate all trajectories                                                  
X_data = np.vstack(all_states) # (N, 9)                                         
Y_data = np.vstack(all_derivs) # (N, 9)                                         
                                                                                
# 2. Build feature matrix                                                       
# Features: Constant, x1..x9, x1^2, x1*x2, ..., x9^2                            
num_samples = X_data.shape[0]                                                   
num_vars = 9                                                                    
                                                                                
# Create feature names for indexing                                             
feature_names = ['1'] + [f'x{i+1}' for i in range(num_vars)]                    
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        feature_names.append(f'x{i+1}*x{j+1}')                                  
                                                                                
# Construct the feature matrix PHI                                              
phi_list = [np.ones((num_samples, 1)), X_data]                                  
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        phi_list.append((X_data[:, i] * X_data[:, j]).reshape(-1, 1))           
                                                                                
PHI = np.hstack(phi_list)                                                       
                                                                                
# 3. Solve for coefficients using Least Squares                                 
# PHI * Coeffs = Y_data                                                         
coeffs, residuals, rank, s = np.linalg.lstsq(PHI, Y_data, rcond=None)           
                                                                                
# 4. Extract significant terms and format                                       
def format_equation(var_idx, coeffs_col, feature_names, threshold=1e-2):        
    terms = []                                                                  
    # Identify significant terms (magnitude > threshold)                        
    for i, c in enumerate(coeffs_col):                                          
        if abs(c) > threshold:                                                  
            # Round for readability                                             
            c_round = round(c, 4)                                               
            if feature_names[i] == '1':                                         
                terms.append(f"{c_round}")                                      
            else:                                                               
                terms.append(f"{c_round}*{feature_names[i]}")                   
                                                                                
    if not terms:                                                               
        return f"x{var_idx+1}[1] = 0"                                           
                                                                                
    eq = " + ".join(terms).replace("+ -", "- ")                                 
    return f"x{var_idx+1}[1] = {eq}"                                            
                                                                                
results = []                                                                    
for i in range(num_vars):                                                       
    eq = format_equation(i, coeffs[:, i], feature_names)                        
    results.append(eq)                                                          
                                                                                
for eq in results:                                                              
    print(eq)                                                                   
                                                                                
