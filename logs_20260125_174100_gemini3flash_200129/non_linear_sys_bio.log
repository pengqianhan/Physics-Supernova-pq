all_x = []                                                                      
all_dx = []                                                                     
dt = 0.001                                                                      
                                                                                
for path in file_paths:                                                         
    data = np.load(path)                                                        
    state = data['state'] # Shape (T, 9)                                        
    all_x.append(state[:-1])                                                    
    # Central difference or forward difference for derivatives                  
    dx = (state[1:] - state[:-1]) / dt                                          
    all_dx.append(dx)                                                           
                                                                                
X_data = np.vstack(all_x)                                                       
DX_data = np.vstack(all_dx)                                                     
                                                                                
