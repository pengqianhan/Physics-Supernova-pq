  import numpy as np                                                            
                                                                                
  def analyze_file(path):                                                       
      data = np.load(path)                                                      
      # Transpose state to get (10001, 9)                                       
      X = data['state'].T                                                       
      dt = 0.001                                                                
                                                                                
      # Calculate numerical derivative (forward difference)                     
      dX = (X[1:] - X[:-1]) / dt                                                
      X_reg = X[:-1]                                                            
                                                                                
      # Prepare matrix A with a column of ones for the intercept                
      A = np.column_stack([X_reg, np.ones(len(X_reg))])                         
                                                                                
      results = []                                                              
      for i in range(9):                                                        
          # Solve A * coeffs = dX[:, i]                                         
          coeffs, _, _, _ = np.linalg.lstsq(A, dX[:, i], rcond=None)            
          results.append(coeffs)                                                
                                                                                
      return results, X                                                         
                                                                                
  paths = ['data_all/non_linear/sys_bio/sample_0.npz',                          
  'data_all/non_linear/sys_bio/sample_1.npz',                                   
  'data_all/non_linear/sys_bio/sample_2.npz']                                   
                                                                                
  all_data_summary = ""                                                         
                                                                                
  for path in paths:                                                            
      all_data_summary += f"\n--- Analysis for {path} ---\n"                    
      results, X_data = analyze_file(path)                                      
                                                                                
      for i, coeffs in enumerate(results):                                      
          eqn_parts = []                                                        
          for j in range(9):                                                    
              if abs(coeffs[j]) > 1e-4:                                         
                  eqn_parts.append(f"{coeffs[j]:.4f}*x{j+1}")                   
          if abs(coeffs[9]) > 1e-4:                                             
              eqn_parts.append(f"{coeffs[9]:.4f}")                              
                                                                                
          eqn_str = f"x{i+1}[1] = " + (" + ".join(eqn_parts) if eqn_parts else  
  "0")                                                                          
          all_data_summary += eqn_str + "\n"                                    
                                                                                
      means = np.mean(X_data, axis=0)                                           
      stds = np.std(X_data, axis=0)                                             
      all_data_summary += f"Means: {means}\n"                                   
      all_data_summary += f"Stds: {stds}\n"                                     
                                                                                
  print(all_data_summary)                                                       
