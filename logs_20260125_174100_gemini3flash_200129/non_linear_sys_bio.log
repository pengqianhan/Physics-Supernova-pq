    total_X.append(x)                                                           
    total_Y.append(y)                                                           
                                                                                
X = np.vstack(total_X)                                                          
Y = np.vstack(total_Y)                                                          
                                                                                
# Build feature matrix                                                          
# Order: x1...x9, x1^2...x9^2, x1*x2, x1*x3...                                  
feature_names = []                                                              
features = []                                                                   
                                                                                
