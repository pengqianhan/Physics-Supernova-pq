import numpy as np                                                              
                                                                                
# Load one file to check structure                                              
data = np.load('data_all/non_linear/sys_bio/sample_0.npz')                      
print("Keys:", data.keys())                                                     
for key in data.keys():                                                         
    print(f"Key '{key}' shape:", data[key].shape)                               
                                                                                
# Load all data properly                                                        
data_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
                                                                                
all_x = []                                                                      
all_dxdt = []                                                                   
dt = 0.001                                                                      
                                                                                
for path in data_paths:                                                         
    data = np.load(path)                                                        
    # The key is likely 'x' or the first key                                    
    key = list(data.keys())[0]                                                  
    x = data[key]                                                               
                                                                                
    # Check if x needs transposing (we want shape (n_time, n_vars))             
    if x.shape[0] == 9 and x.shape[1] != 9:                                     
        x = x.T                                                                 
                                                                                
    # Compute derivative dx/dt using finite differences                         
    # Using central differences for better accuracy if possible                 
    dxdt = np.zeros_like(x)                                                     
    dxdt[1:-1] = (x[2:] - x[:-2]) / (2 * dt)                                    
    dxdt[0] = (x[1] - x[0]) / dt                                                
    dxdt[-1] = (x[-1] - x[-2]) / dt                                             
                                                                                
    all_x.append(x)                                                             
    all_dxdt.append(dxdt)                                                       
                                                                                
X = np.vstack(all_x)                                                            
DXDT = np.vstack(all_dxdt)                                                      
                                                                                
print(f"Concatenated X shape: {X.shape}")                                       
print(f"Concatenated DXDT shape: {DXDT.shape}")                                 
                                                                                
# Define library building function (vectorized)                                 
def build_library(X):                                                           
    n_samples, n_vars = X.shape                                                 
    library_parts = [np.ones((n_samples, 1))]                                   
    feature_names = ["1"]                                                       
                                                                                
    # Linear                                                                    
    for i in range(n_vars):                                                     
        library_parts.append(X[:, i:i+1])                                       
        feature_names.append(f"x{i+1}")                                         
                                                                                
    # Quadratic squares                                                         
    for i in range(n_vars):                                                     
        library_parts.append((X[:, i]**2).reshape(-1, 1))                       
        feature_names.append(f"x{i+1}^2")                                       
                                                                                
    # Cross terms                                                               
    for i in range(n_vars):                                                     
        for j in range(i + 1, n_vars):                                          
            library_parts.append((X[:, i] * X[:, j]).reshape(-1, 1))            
            feature_names.append(f"x{i+1}*x{j+1}")                              
                                                                                
    return np.hstack(library_parts), feature_names                              
                                                                                
Phi, feature_names = build_library(X)                                           
print(f"Library shape: {Phi.shape}")                                            
                                                                                
# Sequential Thresholded Least Squares                                          
def stls(Phi, y, threshold=0.05, max_iter=20):                                  
    n_vars = y.shape[1]                                                         
    n_features = Phi.shape[1]                                                   
    coef = np.zeros((n_features, n_vars))                                       
                                                                                
    for i in range(n_vars):                                                     
        # Initial guess                                                         
        c = np.linalg.lstsq(Phi, y[:, i], rcond=None)[0]                        
        # Iterative pruning                                                     
        for _ in range(max_iter):                                               
            small_indices = np.abs(c) < threshold                               
            c[small_indices] = 0                                                
            big_indices = ~small_indices                                        
            if not np.any(big_indices):                                         
                break                                                           
            c[big_indices] = np.linalg.lstsq(Phi[:, big_indices], y[:, i],      
rcond=None)[0]                                                                  
        coef[:, i] = c                                                          
    return coef                                                                 
                                                                                
coefficients = stls(Phi, DXDT)                                                  
                                                                                
# Verify fit with R^2                                                           
def compute_r2(y_true, y_pred):                                                 
    ss_res = np.sum((y_true - y_pred)**2, axis=0)                               
    ss_tot = np.sum((y_true - np.mean(y_true, axis=0))**2, axis=0)              
    return 1 - ss_res / ss_tot                                                  
                                                                                
predictions = Phi @ coefficients                                                
r2_values = compute_r2(DXDT, predictions)                                       
                                                                                
# Output results                                                                
nonlinear_items = []                                                            
equation_strings = []                                                           
for i in range(9):                                                              
    eq = f"x{i+1}[t] = "                                                        
    terms = []                                                                  
    for j, c in enumerate(coefficients[:, i]):                                  
        if abs(c) > 1e-3:                                                       
            term_name = feature_names[j]                                        
            # Format term name for the final answer                             
            clean_term = term_name.replace("x", "x").replace("^2", "**2")       
            terms.append(f"{c:.2f}*{clean_term}")                               
            if "*" in clean_term or "**2" in clean_term:                        
                nonlinear_items.append(clean_term)                              
    eq += " + ".join(terms)                                                     
    equation_strings.append(eq)                                                 
                                                                                
unique_nonlinear = sorted(list(set(nonlinear_items)))                           
                                                                                
print("\nIdentified Equations:")                                                
for eq in equation_strings:                                                     
    print(eq)                                                                   
print("\nR^2 values:", r2_values)                                               
print("\nUnique Nonlinear Terms:", unique_nonlinear)                            
                                                                                
final_answer({                                                                  
    "equations": equation_strings,                                              
    "r2_scores": r2_values.tolist(),                                            
    "non_linear_items": unique_nonlinear                                        
})                                                                              
                                                                                
