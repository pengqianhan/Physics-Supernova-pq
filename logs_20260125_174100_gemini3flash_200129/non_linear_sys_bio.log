    y = X_next[:, i]                                                            
    r2_lin, coeffs_lin = get_r2(A_lin, y)                                       
    r2_nl, coeffs_nl = get_r2(A_nl, y)                                          
    results.append({                                                            
        'i': i+1,                                                               
        'r2_lin': r2_lin,                                                       
        'r2_nl': r2_nl,                                                         
        'coeffs_lin': coeffs_lin                                                
