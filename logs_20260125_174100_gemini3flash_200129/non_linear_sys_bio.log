import numpy as np                                                              
from itertools import combinations_with_replacement                             
                                                                                
# 1. Load data                                                                  
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
dt = 0.001                                                                      
X_list = []                                                                     
Y_list = []                                                                     
                                                                                
for state in all_states:                                                        
    # state: (9, N)                                                             
    # dx/dt: (9, N-1)                                                           
    derivs = (state[:, 1:] - state[:, :-1]) / dt                                
    x_vals = state[:, :-1]                                                      
    X_list.append(x_vals.T)                                                     
    Y_list.append(derivs.T)                                                     
                                                                                
X_data = np.vstack(X_list) # (Total_N, 9)                                       
Y_data = np.vstack(Y_list) # (Total_N, 9)                                       
                                                                                
# Helper function for regression                                                
def solve_regression(X, y):                                                     
    # Add bias term (1s)                                                        
    A = np.column_stack([np.ones(X.shape[0]), X])                               
    coef, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)                
                                                                                
    # Calculate R2                                                              
    y_mean = np.mean(y)                                                         
    ss_tot = np.sum((y - y_mean)**2)                                            
    ss_res = np.sum((y - (A @ coef))**2)                                        
    r2 = 1 - (ss_res / ss_tot)                                                  
    return coef, r2                                                             
                                                                                
# 3 & 4. Regression and checking for improvements                               
refined_results = {}                                                            
THRESHOLD = 0.999                                                               
                                                                                
for i in range(9):                                                              
    y = Y_data[:, i]                                                            
    coef_lin, r2_lin = solve_regression(X_data, y)                              
                                                                                
    if r2_lin < THRESHOLD:                                                      
        # Build quadratic and cross terms                                       
        poly_cols = []                                                          
        poly_names = []                                                         
        for j in range(9):                                                      
