def stls(Theta, X_dot, threshold, max_iter=10):                                 
    # Theta: (N, M), X_dot: (N, D)                                              
    num_vars = X_dot.shape[1]                                                   
    num_features = Theta.shape[1]                                               
    W = np.linalg.lstsq(Theta, X_dot, rcond=None)[0]                            
                                                                                
    for _ in range(max_iter):                                                   
        small_indices = np.abs(W) < threshold                                   
        W[small_indices] = 0                                                    
        for i in range(num_vars):                                               
            big_indices = np.abs(W[:, i]) >= threshold                          
            if np.any(big_indices):                                             
                W[big_indices, i] = np.linalg.lstsq(Theta[:, big_indices],      
X_dot[:, i], rcond=None)[0]                                                     
    return W                                                                    
                                                                                
