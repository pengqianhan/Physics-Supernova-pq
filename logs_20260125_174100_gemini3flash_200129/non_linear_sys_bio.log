non_linear_items = set()                                                        
for i in range(Xi.shape[1]):                                                    
    terms = []                                                                  
    for j in range(Xi.shape[0]):                                                
        if Xi[j, i] != 0:                                                       
            term_name = names[j]                                                
            coeff = Xi[j, i]                                                    
            terms.append(f"({coeff:.3f})*{term_name}")                          
            if '*' in term_name:                                                
                non_linear_items.add(term_name)                                 
    eq = f"dx{i}/dt = " + " + ".join(terms)                                     
    equations.append(eq)                                                        
                                                                                
print("\n".join(equations))                                                     
print("\nNon-linear items:", ", ".join(sorted(list(non_linear_items))))         
                                                                                
