import numpy as np                                                              
                                                                                
def build_theta_names(n_features):                                              
    names = ["1"]                                                               
    for i in range(n_features):                                                 
        names.append(f"x{i+1}")                                                 
    for i in range(n_features):                                                 
        for j in range(i, n_features):                                          
            names.append(f"x{i+1}x{j+1}")                                       
    return names                                                                
                                                                                
def stlsq(Theta, dX, threshold=0.01, max_iter=10):                              
    n_features = Theta.shape[1]                                                 
    n_targets = dX.shape[1]                                                     
    Xi = np.linalg.lstsq(Theta, dX, rcond=None)[0]                              
                                                                                
    for _ in range(max_iter):                                                   
        small_indices = np.abs(Xi) < threshold                                  
        Xi[small_indices] = 0                                                   
        for i in range(n_targets):                                              
            big_indices = ~small_indices[:, i]                                  
            if np.any(big_indices):                                             
                Xi[big_indices, i] = np.linalg.lstsq(Theta[:, big_indices],     
dX[:, i], rcond=None)[0]                                                        
    return Xi                                                                   
                                                                                
# Feature names                                                                 
feature_names = build_theta_names(9)                                            
                                                                                
# Perform regression on combined data                                           
Xi = stlsq(Theta, dX, threshold=0.001)                                          
                                                                                
# Display equations                                                             
results = []                                                                    
for i in range(9):                                                              
    eq = f"x{i+1}[1] ="                                                         
    terms = []                                                                  
    for j in range(len(feature_names)):                                         
        if abs(Xi[j, i]) > 1e-6:                                                
            terms.append(f"{Xi[j, i]:.4f}*{feature_names[j]}")                  
    if not terms:                                                               
        eq += " 0"                                                              
    else:                                                                       
        eq += " " + " + ".join(terms)                                           
    results.append(eq)                                                          
    print(eq)                                                                   
                                                                                
# Check residuals per sample to see if it behaves as a single mode              
def get_residuals(Theta_part, dX_part, Xi):                                     
    return np.mean((dX_part - Theta_part @ Xi)**2, axis=0)                      
                                                                                
residuals = []                                                                  
for i in range(3):                                                              
    start = i * 10001                                                           
    end = (i + 1) * 10001                                                       
    res = get_residuals(Theta[start:end], dX[start:end], Xi)                    
    residuals.append(res)                                                       
    print(f"Sample {i} residuals mean: {np.mean(res)}")                         
                                                                                
print("\nResiduals per sample details:")                                        
print(residuals)                                                                
                                                                                
