# Extract A and b                                                               
# Each column of W corresponds to one variable's derivative                     
# W[0:9, j] are the A coefficients for dx_j/dt                                  
# W[9, j] is the intercept b_j for dx_j/dt                                      
A = W[:9, :].T # (9, 9)                                                         
b = W[9, :]     # (9,)                                                          
                                                                                
# Predictions                                                                   
