import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
dt = 0.001                                                                      
all_x = []                                                                      
all_dxdt = []                                                                   
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'] # Shape (9, 10001)                                    
                                                                                
    # Calculate numerical derivative using central difference where possible    
    # or forward difference for simplicity.                                     
    # dx/dt (t) = (x(t+dt) - x(t)) / dt                                         
    dxdt = (state[:, 1:] - state[:, :-1]) / dt                                  
    x_at_t = state[:, :-1]                                                      
                                                                                
    all_x.append(x_at_t.T) # (Time, Variables)                                  
    all_dxdt.append(dxdt.T)                                                     
                                                                                
X = np.vstack(all_x)                                                            
