  import numpy as np                                                            
                                                                                
  def solve():                                                                  
      dt = 0.001                                                                
      X_list = []                                                               
      Y_list = []                                                               
                                                                                
      # Load and process data                                                   
      for path in DATA_FILE_PATHS:                                              
          data = np.load(path)                                                  
          states = data['state'] # Shape (T, 9)                                 
                                                                                
          # Finite difference for derivatives                                   
          derivs = (states[1:] - states[:-1]) / dt                              
          inputs = states[:-1]                                                  
                                                                                
          X_list.append(inputs)                                                 
          Y_list.append(derivs)                                                 
                                                                                
      X_all = np.vstack(X_list)                                                 
      Y_all = np.vstack(Y_list)                                                 
                                                                                
      num_vars = 9                                                              
      features = []                                                             
      feature_names = []                                                        
                                                                                
      # 1. Bias                                                                 
      features.append(np.ones((X_all.shape[0], 1)))                             
      feature_names.append('1')                                                 
                                                                                
      # 2. Linear terms                                                         
      for i in range(num_vars):                                                 
          features.append(X_all[:, i:i+1])                                      
          feature_names.append(f'x{i+1}[0]')                                    
                                                                                
      # 3. Quadratic terms                                                      
      for i in range(num_vars):                                                 
          for j in range(i, num_vars):                                          
              features.append((X_all[:, i] * X_all[:, j]).reshape(-1, 1))       
              feature_names.append(f'x{i+1}[0]*x{j+1}[0]' if i != j else        
  f'x{i+1}[0]**2')                                                              
                                                                                
      Phi = np.concatenate(features, axis=1)                                    
                                                                                
      equations = {}                                                            
      r2_scores = {}                                                            
      residual_patterns = []                                                    
                                                                                
      for i in range(num_vars):                                                 
          y = Y_all[:, i]                                                       
          # Solve least squares: Phi @ coefs = y                                
          # Use np.linalg.lstsq                                                 
          coefs, residuals, rank, s = np.linalg.lstsq(Phi, y, rcond=None)       
                                                                                
          # Calculate R2                                                        
          y_pred = np.dot(Phi, coefs)                                           
          errors = y - y_pred                                                   
          y_mean = np.mean(y)                                                   
          ss_tot = np.sum((y - y_mean)**2)                                      
          ss_res = np.sum(errors**2)                                            
          r2 = 1 - (ss_res / ss_tot)                                            
          r2_scores[f'x{i+1}'] = r2                                             
                                                                                
          # Check for mode switching by looking at the maximum absolute error   
          max_err = np.max(np.abs(errors))                                      
          std_err = np.std(errors)                                              
          residual_patterns.append((max_err, std_err))                          
                                                                                
          terms = []                                                            
          for val, name in zip(coefs, feature_names):                           
              if abs(val) > 1e-3:                                               
                  if name == '1':                                               
                      terms.append(f"{val:.4f}")                                
                  else:                                                         
                      terms.append(f"{val:.4f}*{name}")                         
                                                                                
          eq_str = f"x{i+1}[1] = " + " + ".join(terms)                          
          eq_str = eq_str.replace(" + -", " - ")                                
          equations[f'x{i+1}'] = eq_str                                         
                                                                                
      print("Equations:")                                                       
      for k, v in equations.items():                                            
          print(f"{k}: {v}")                                                    
      print("\nR2 Scores:")                                                     
      for k, v in r2_scores.items():                                            
          print(f"{k}: {v:.6f}")                                                
                                                                                
      print("\nResidual Analysis (Max Err, Std Err):")                          
      for i, (me, se) in enumerate(residual_patterns):                          
          print(f"x{i+1}: Max Err = {me:.4f}, Std Err = {se:.4f}")              
                                                                                
  solve()                                                                       
