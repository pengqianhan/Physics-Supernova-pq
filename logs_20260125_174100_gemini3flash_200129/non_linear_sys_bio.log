      Xi = np.linalg.lstsq(A, b, rcond=None)[0]                                 
      for _ in range(iterations):                                               
          small_inds = np.abs(Xi) < threshold                                   
          Xi[small_inds] = 0                                                    
          for j in range(b.shape[1]):                                           
