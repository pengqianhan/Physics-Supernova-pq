    for j in range(len(feat_names)):                                            
        c = coefficients[j, i]                                                  
        if abs(c) > 1e-4:                                                       
            if feat_names[j] == "1.0":                                          
                terms.append(f"{c:+.4f}")                                       
            else:                                                               
                terms.append(f"{c:+.4f}*{feat_names[j]}")                       
                                                                                
    if not terms:                                                               
        eq += " 0.0000"                                                         
    else:                                                                       
        # Format the sum nicely                                                 
        formatted_rhs = " ".join(terms)                                         
        # Clean up the leading '+' and space                                    
        if formatted_rhs.startswith("+"):                                       
            formatted_rhs = formatted_rhs[1:]                                   
