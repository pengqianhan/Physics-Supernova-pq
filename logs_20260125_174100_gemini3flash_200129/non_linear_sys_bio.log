                cross_features.append(X[:, j] * X[:, k])                        
                                                                                
        cross_features = np.column_stack(cross_features)                        
        X_extended = np.column_stack([X, cross_features, np.ones(X.shape[0])])  
                                                                                
        # Re-fit                                                                
        coeffs_ext, _, _, _ = np.linalg.lstsq(X_extended, y, rcond=None)        
        y_pred_ext = X_extended @ coeffs_ext                                    
        r2 = get_r_squared(y, y_pred_ext)                                       
                                                                                
        # Store linear part for stability analysis                              
        A_matrix[i, :] = coeffs_ext[:num_vars]                                  
                                                                                
        # Build equation string                                                 
        eq_parts = []                                                           
        for j in range(num_vars):                                               
            if abs(coeffs_ext[j]) > 1e-6:                                       
                eq_parts.append(f"({coeffs_ext[j]:.4f})*x{j+1}")                
                                                                                
        # Cross terms                                                           
        num_cross = cross_features.shape[1]                                     
        for idx in range(num_cross):                                            
            c_val = coeffs_ext[num_vars + idx]                                  
            if abs(c_val) > 1e-4: # Only significant terms                      
