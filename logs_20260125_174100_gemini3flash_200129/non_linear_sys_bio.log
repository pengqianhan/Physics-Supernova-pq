    y = dXdt[:, i]                                                              
    # Linear model: dxi/dt = sum(aij * xj) + bi                                 
    # Construct feature matrix for linear model (including intercept)           
    X_linear = np.column_stack([X, np.ones(X.shape[0])])                        
                                                                                
    # Solve linear regression using least squares                               
    coeffs, _, _, _ = np.linalg.lstsq(X_linear, y, rcond=None)                  
                                                                                
    y_pred = X_linear @ coeffs                                                  
    r2 = get_r_squared(y, y_pred)                                               
                                                                                
    # If R-squared < 0.99, add cross-product terms                              
    if r2 < 0.99:                                                               
        # Generate cross-product names and features                             
        cross_names = []                                                        
