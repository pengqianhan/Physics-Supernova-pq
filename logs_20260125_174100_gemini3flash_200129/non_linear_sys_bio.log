<code>                                                                          
import numpy as np                                                              
                                                                                
# Load data                                                                     
data_files = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
dt = 0.001                                                                      
                                                                                
all_X = []                                                                      
all_dX = []                                                                     
                                                                                
for path in data_files:                                                         
    data = np.load(path)                                                        
    state = data['state'] # Shape (9, 10001)                                    
                                                                                
    # Calculate derivatives using finite differences                            
    dx = (state[:, 1:] - state[:, :-1]) / dt                                    
    x = state[:, :-1]                                                           
                                                                                
    all_X.append(x.T)                                                           
    all_dX.append(dx.T)                                                         
                                                                                
# Concatenate all samples                                                       
X = np.vstack(all_X) # (30000, 9)                                               
dX = np.vstack(all_dX) # (30000, 9)                                             
                                                                                
# Feature sets                                                                  
# 1. Linear: x1 ... x9                                                          
# 2. Linear + Bias: 1, x1 ... x9                                                
# 3. Linear + Bias + Quadratic: 1, x1 ... x9, x1^2 ... x9^2                     
                                                                                
def solve_and_score(phi, target):                                               
    w, residuals, rank, s = np.linalg.lstsq(phi, target, rcond=None)            
    preds = phi @ w                                                             
    error = np.mean((target - preds)**2)                                        
    return w, error                                                             
                                                                                
results = []                                                                    
                                                                                
for i in range(9):                                                              
    target = dX[:, i]                                                           
                                                                                
    # Model 1: Linear                                                           
    phi1 = X                                                                    
    w1, e1 = solve_and_score(phi1, target)                                      
                                                                                
    # Model 2: Linear + Bias                                                    
    phi2 = np.column_stack([np.ones(X.shape[0]), X])                            
    w2, e2 = solve_and_score(phi2, target)                                      
                                                                                
    # Model 3: Linear + Bias + Quadratic (xi^2)                                 
    phi3 = np.column_stack([np.ones(X.shape[0]), X, X**2])                      
    w3, e3 = solve_and_score(phi3, target)                                      
                                                                                
    results.append({                                                            
        'var': i+1,                                                             
        'linear': (w1, e1),                                                     
        'bias': (w2, e2),                                                       
        'quad': (w3, e3)                                                        
    })                                                                          
                                                                                
for res in results:                                                             
    print(f"Var x{res['var']}: Linear Err={res['linear'][1]:.6f}, Bias          
Err={res['bias'][1]:.6f}, Quad Err={res['quad'][1]:.6f}")                       
                                                                                
