            terms.append(f"{val:+.4f}*{name}")                                  
                                                                                
    eq = f"x{i+1}[1] = " + (" ".join(terms) if terms else "0")                  
    equations.append(eq)                                                        
    print(eq)                                                                   
                                                                                
                                                                                
