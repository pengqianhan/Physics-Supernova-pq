for p in paths:                                                                 
    data = np.load(p)                                                           
    state = data['state'] # (9, 10001)                                          
    all_X_curr.append(state[:, :-1].T)                                          
    all_X_next.append(state[:, 1:].T)                                           
                                                                                
X_curr = np.vstack(all_X_curr) # (30000, 9)                                     
X_next = np.vstack(all_X_next) # (30000, 9)                                     
                                                                                
n_samples = X_curr.shape[0]                                                     
ones = np.ones((n_samples, 1))                                                  
                                                                                
# Linear features: x1...x9, constant                                            
A_lin = np.hstack([X_curr, ones])                                               
                                                                                
# Non-linear features: x1...x9, x1^2, x5^2, x9^2, x1*x5, x1*x9, x5*x9, constant 
x1 = X_curr[:, 0]                                                               
x5 = X_curr[:, 4]                                                               
x9 = X_curr[:, 8]                                                               
A_nl = np.hstack([                                                              
    X_curr,                                                                     
    (x1**2).reshape(-1, 1),                                                     
    (x5**2).reshape(-1, 1),                                                     
    (x9**2).reshape(-1, 1),                                                     
    (x1*x5).reshape(-1, 1),                                                     
    (x1*x9).reshape(-1, 1),                                                     
    (x5*x9).reshape(-1, 1),                                                     
    ones                                                                        
])                                                                              
                                                                                
def get_r2(A, y):                                                               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    y_pred = A @ coeffs                                                         
    ss_res = np.sum((y - y_pred)**2)                                            
    ss_tot = np.sum((y - np.mean(y))**2)                                        
    r2 = 1 - (ss_res / ss_tot)                                                  
    return r2, coeffs                                                           
                                                                                
results = []                                                                    
