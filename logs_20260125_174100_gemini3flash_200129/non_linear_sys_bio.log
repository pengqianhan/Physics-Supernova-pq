import numpy as np                                                              
                                                                                
def check_modes():                                                              
    dt = 0.001                                                                  
    num_vars = 9                                                                
                                                                                
    sample_coefs = []                                                           
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        states = data['state']                                                  
        if states.shape[0] == 9:                                                
            states = states.T                                                   
                                                                                
        derivs = (states[1:] - states[:-1]) / dt                                
        inputs = states[:-1]                                                    
                                                                                
        # Build features                                                        
        feats = [np.ones((inputs.shape[0], 1)), inputs]                         
        for i in range(num_vars):                                               
            for j in range(i, num_vars):                                        
                feats.append((inputs[:, i] * inputs[:, j]).reshape(-1, 1))      
        Phi = np.concatenate(feats, axis=1)                                     
                                                                                
        # Solve for this sample                                                 
        coefs_sample = []                                                       
        for i in range(num_vars):                                               
            y = derivs[:, i]                                                    
            c, _, _, _ = np.linalg.lstsq(Phi, y, rcond=None)                    
            coefs_sample.append(c)                                              
        sample_coefs.append(coefs_sample)                                       
                                                                                
    # Compare coefficients between samples                                      
    sample_coefs = np.array(sample_coefs) # Shape (3, 9, 55)                    
    coef_std = np.std(sample_coefs, axis=0)                                     
    print(f"Mean coefficient variation (std): {np.mean(coef_std)}")             
                                                                                
    # Check residuals over time for Sample 0                                    
    data = np.load(DATA_FILE_PATHS[0])                                          
    states = data['state']                                                      
    if states.shape[0] == 9: states = states.T                                  
    derivs = (states[1:] - states[:-1]) / dt                                    
    inputs = states[:-1]                                                        
    feats = [np.ones((inputs.shape[0], 1)), inputs]                             
    for i in range(num_vars):                                                   
        for j in range(i, num_vars):                                            
            feats.append((inputs[:, i] * inputs[:, j]).reshape(-1, 1))          
    Phi = np.concatenate(feats, axis=1)                                         
                                                                                
    for i in range(num_vars):                                                   
        y = derivs[:, i]                                                        
        y_pred = Phi @ sample_coefs[0, i]                                       
        res = np.abs(y - y_pred)                                                
        if np.max(res) > 2 * np.mean(res):                                      
            print(f"x{i+1} has high residual peaks - possible switch.")         
                                                                                
check_modes()                                                                   
                                                                                
