# Sequential Thresholded Least Squares (SINDy)                                  
def sparse_regression(Phi, Y, threshold, iterations=10):                        
    coeffs = np.linalg.lstsq(Phi, Y, rcond=None)[0]                             
    for _ in range(iterations):                                                 
        small_coeffs = np.abs(coeffs) < threshold                               
        coeffs[small_coeffs] = 0                                                
