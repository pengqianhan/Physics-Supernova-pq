            features.append((X[:, i] * X[:, j]).reshape(-1, 1))                 
            feature_names.append(f'x{i+1}*x{j+1}')                              
                                                                                
    return np.hstack(features), feature_names                                   
                                                                                
Theta, feature_names = build_features(X)                                        
                                                                                
# Sequential Thresholded Least Squares (STLSQ)                                  
def stlsq(Theta, dXdt, threshold, max_iter=10):                                 
    n_features = Theta.shape[1]                                                 
    n_targets = dXdt.shape[1]                                                   
    Xi = np.linalg.lstsq(Theta, dXdt, rcond=None)[0]                            
                                                                                
    for _ in range(max_iter):                                                   
        small_indices = np.abs(Xi) < threshold                                  
        Xi[small_indices] = 0                                                   
        for i in range(n_targets):                                              
            big_indices = ~small_indices[:, i]                                  
            if np.any(big_indices):                                             
                Xi[big_indices, i] = np.linalg.lstsq(Theta[:, big_indices],     
dXdt[:, i], rcond=None)[0]                                                      
    return Xi                                                                   
                                                                                
Xi = stlsq(Theta, dXdt, threshold)                                              
                                                                                
# Format the results                                                            
results = []                                                                    
for i in range(9):                                                              
    eq_parts = []                                                               
    for j in range(len(feature_names)):                                         
        if abs(Xi[j, i]) > 1e-4:                                                
            eq_parts.append(f"{Xi[j, i]:.4f} * {feature_names[j]}")             
    equation = f"x{i+1}' = " + (" + ".join(eq_parts) if eq_parts else "0")      
    results.append(equation)                                                    
                                                                                
for res in results:                                                             
    print(res)                                                                  
                                                                                
