<code>                                                                          
import numpy as np                                                              
from sklearn.linear_model import Lasso                                          
import itertools                                                                
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/sys_bio/sample_0.npz')                      
state = data['state'] # Shape (9, 10001)                                        
X = state.T # Shape (10001, 9)                                                  
                                                                                
# Estimate derivatives using central difference (assuming dt = 1.0 for          
simplicity)                                                                     
# dt = 1.0 means coefficients might be scaled, but the structure remains the    
same.                                                                           
dt = 1.0                                                                        
dX = np.zeros_like(X)                                                           
dX[1:-1, :] = (X[2:, :] - X[:-2, :]) / (2 * dt)                                 
# End points                                                                    
dX[0, :] = (X[1, :] - X[0, :]) / dt                                             
dX[-1, :] = (X[-1, :] - X[-2, :]) / dt                                          
                                                                                
# Library of features                                                           
def build_library(X):                                                           
    n_samples, n_features = X.shape                                             
    library = [np.ones((n_samples, 1))] # Bias                                  
    feature_names = ['1']                                                       
                                                                                
    # Linear terms                                                              
    library.append(X)                                                           
    feature_names.extend([f'x{i+1}' for i in range(n_features)])                
                                                                                
    # Quadratic terms (xi * xj)                                                 
    for i in range(n_features):                                                 
        for j in range(i, n_features):                                          
            library.append((X[:, i] * X[:, j]).reshape(-1, 1))                  
            if i == j:                                                          
                feature_names.append(f'x{i+1}**2')                              
            else:                                                               
                feature_names.append(f'x{i+1}*x{j+1}')                          
                                                                                
    return np.hstack(library), feature_names                                    
                                                                                
Theta, feature_names = build_library(X)                                         
                                                                                
# STLSQ implementation                                                          
def stlsq(Theta, dX, threshold=0.1, max_iter=10):                               
    n_features = Theta.shape[1]                                                 
    n_targets = dX.shape[1]                                                     
    Xi = np.linalg.lstsq(Theta, dX, rcond=None)[0]                              
                                                                                
    for _ in range(max_iter):                                                   
        small_indices = np.abs(Xi) < threshold                                  
        Xi[small_indices] = 0                                                   
        for i in range(n_targets):                                              
            big_indices = ~small_indices[:, i]                                  
            if np.any(big_indices):                                             
                Xi[big_indices, i] = np.linalg.lstsq(Theta[:, big_indices],     
dX[:, i], rcond=None)[0]                                                        
    return Xi                                                                   
                                                                                
threshold = 0.1                                                                 
Xi = stlsq(Theta, dX, threshold=threshold)                                      
                                                                                
# Extract equations                                                             
equations = []                                                                  
non_linear_items = set()                                                        
                                                                                
for i in range(Xi.shape[1]):                                                    
    terms = []                                                                  
    for j in range(Xi.shape[0]):                                                
        if Xi[j, i] != 0:                                                       
            coeff = Xi[j, i]                                                    
            name = feature_names[j]                                             
            if name == '1':                                                     
                terms.append(f"{coeff:.4f}")                                    
            else:                                                               
                terms.append(f"{coeff:.4f}*{name}")                             
                if '*' in name or '**' in name:                                 
                    non_linear_items.add(name)                                  
                                                                                
    eq = f"x{i+1}[1] = " + " + ".join(terms)                                    
    # Replace + - with -                                                        
    eq = eq.replace("+ -", "- ")                                                
    equations.append(eq)                                                        
                                                                                
print("\n".join(equations))                                                     
print("Non-linear items:", sorted(list(non_linear_items)))                      
                                                                                
