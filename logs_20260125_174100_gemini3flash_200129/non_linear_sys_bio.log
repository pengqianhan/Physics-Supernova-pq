import numpy as np                                                              
                                                                                
# Load and combine all available sample data                                    
X_curr_list = []                                                                
X_next_list = []                                                                
paths = ['data_all/non_linear/sys_bio/sample_0.npz',                            
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
                                                                                
for path in paths:                                                              
    data = np.load(path)                                                        
    state = data['state']                                                       
    # state shape is (9, 10001)                                                 
    X_curr_list.append(state[:, :-1].T) # (10000, 9)                            
    X_next_list.append(state[:, 1:].T)  # (10000, 9)                            
                                                                                
X_curr = np.vstack(X_curr_list) # (30000, 9)                                    
X_next = np.vstack(X_next_list) # (30000, 9)                                    
                                                                                
# Linear features (x1...x9 and intercept)                                       
A_lin = np.hstack([X_curr, np.ones((X_curr.shape[0], 1))])                      
                                                                                
# Non-linear features (x1, x5, x9 squares and interactions)                     
x1, x5, x9 = X_curr[:, 0], X_curr[:, 4], X_curr[:, 8]                           
A_nl = np.hstack([                                                              
    X_curr,                                                                     
    (x1**2).reshape(-1, 1),                                                     
    (x5**2).reshape(-1, 1),                                                     
    (x9**2).reshape(-1, 1),                                                     
    (x1*x5).reshape(-1, 1),                                                     
    (x1*x9).reshape(-1, 1),                                                     
    (x5*x9).reshape(-1, 1),                                                     
    np.ones((X_curr.shape[0], 1))                                               
])                                                                              
                                                                                
results = []                                                                    
for i in range(9):                                                              
    y = X_next[:, i]                                                            
                                                                                
    # Linear Regression                                                         
    coeffs_lin, _, _, _ = np.linalg.lstsq(A_lin, y, rcond=None)                 
    y_pred_lin = np.dot(A_lin, coeffs_lin)                                      
    r2_lin = 1 - (np.sum((y - y_pred_lin)**2) / np.sum((y - np.mean(y))**2))    
                                                                                
    # Non-linear Regression                                                     
    coeffs_nl, _, _, _ = np.linalg.lstsq(A_nl, y, rcond=None)                   
    y_pred_nl = np.dot(A_nl, coeffs_nl)                                         
    r2_nl = 1 - (np.sum((y - y_pred_nl)**2) / np.sum((y - np.mean(y))**2))      
                                                                                
    results.append({                                                            
        'id': i + 1,                                                            
        'r2_lin': r2_lin,                                                       
        'r2_nl': r2_nl,                                                         
        'coeffs': coeffs_lin                                                    
    })                                                                          
                                                                                
# Output for diagnosis                                                          
for res in results:                                                             
    print(f"x{res['id']}: R2 Lin {res['r2_lin']:.10f}, R2 NL                    
{res['r2_nl']:.10f}, Diff {res['r2_nl'] - res['r2_lin']:.2e}")                  
                                                                                
# Build the final equation strings                                              
final_equations = []                                                            
for res in results:                                                             
    c = res['coeffs']                                                           
    terms = [f"{c[j]:.4f} * x{j+1}[0]" for j in range(9)]                       
    # Use +.4f for the intercept to handle the sign properly                    
    eq = f"x{res['id']}[1] = {' + '.join(terms)} + {c[9]:.4f}"                  
    final_equations.append(eq)                                                  
                                                                                
for eq in final_equations:                                                      
    print(eq)                                                                   
                                                                                
