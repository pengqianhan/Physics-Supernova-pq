# Load the data files                                                           
data_files = ['data_all/non_linear/sys_bio/sample_0.npz',                       
              'data_all/non_linear/sys_bio/sample_1.npz',                       
              'data_all/non_linear/sys_bio/sample_2.npz']                       
                                                                                
all_x = []                                                                      
all_dxdt = []                                                                   
dt = 0.001                                                                      
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    state = data['state'] # (9, 10001)                                          
                                                                                
    # x(t)                                                                      
    x = state[:, :-1]                                                           
    # dx/dt approx (x(t+dt) - x(t)) / dt                                        
    dxdt = (state[:, 1:] - state[:, :-1]) / dt                                  
                                                                                
    all_x.append(x.T)                                                           
    all_dxdt.append(dxdt.T)                                                     
                                                                                
# Combine all traces                                                            
X = np.vstack(all_x) # (N, 9)                                                   
Y = np.vstack(all_dxdt) # (N, 9)                                                
                                                                                
# Augment X with ones for the intercept b: dx/dt = Ax + b                       
# X_aug = [x1, x2, ..., x9, 1]                                                  
X_aug = np.hstack([X, np.ones((X.shape[0], 1))])                                
                                                                                
# Solve the least squares problem: X_aug * W = Y                                
# W will be (10, 9)                                                             
