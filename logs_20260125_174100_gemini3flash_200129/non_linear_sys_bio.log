import numpy as np                                                              
                                                                                
# Load data                                                                     
file_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
all_x = []                                                                      
all_dx = []                                                                     
dt = 0.001                                                                      
                                                                                
for path in file_paths:                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    dx = (state[1:] - state[:-1]) / dt                                          
    all_x.append(state[:-1])                                                    
    all_dx.append(dx)                                                           
                                                                                
X = np.vstack(all_x)                                                            
DX = np.vstack(all_dx)                                                          
                                                                                
# Check correlation                                                             
import pandas as pd                                                             
df = pd.DataFrame(X, columns=[f'x{i+1}' for i in range(9)])                     
print("Correlation Matrix:")                                                    
print(df.corr())                                                                
                                                                                
# Try Ridge regression for better stability                                     
def ridge_regression(Phi, y, alpha=0.1):                                        
    n_features = Phi.shape[1]                                                   
    # (Phi.T @ Phi + alpha * I) * coef = Phi.T @ y                              
    coef = np.linalg.solve(Phi.T @ Phi + alpha * np.eye(n_features), Phi.T @ y) 
    return coef                                                                 
                                                                                
# Simpler feature set first: just linear                                        
feature_names_lin = ['1'] + [f'x{i+1}' for i in range(9)]                       
Phi_lin = np.column_stack([np.ones(X.shape[0])] + [X[:, i] for i in range(9)])  
                                                                                
print("\nLinear Ridge Identification:")                                         
for i in range(9):                                                              
    coef = ridge_regression(Phi_lin, DX[:, i], alpha=1.0)                       
    terms = [f"{c:.4f}*{name}" if name != '1' else f"{c:.4f}" for c, name in    
zip(coef, feature_names_lin) if abs(c) > 0.01]                                  
    print(f"x{i+1}[1] = {' '.join(terms)}")                                     
                                                                                
# Now try with cross terms from prompt                                          
cross_terms = [(1, 1), (1, 3), (1, 5), (2, 3), (5, 7)] # x2^2, x2*x4, x2*x6,    
x3*x4, x6*x8                                                                    
Phi_cross = np.column_stack([Phi_lin] + [X[:, i] * X[:, j] for i, j in          
cross_terms])                                                                   
feature_names_cross = feature_names_lin + [f"x{i+1}*x{j+1}" for i, j in         
cross_terms]                                                                    
                                                                                
print("\nCross-term Ridge Identification:")                                     
for i in range(9):                                                              
    coef = ridge_regression(Phi_cross, DX[:, i], alpha=1.0)                     
    terms = [f"{c:.4f}*{name}" if name != '1' else f"{c:.4f}" for c, name in    
zip(coef, feature_names_cross) if abs(c) > 0.01]                                
    print(f"x{i+1}[1] = {' '.join(terms)}")                                     
                                                                                
