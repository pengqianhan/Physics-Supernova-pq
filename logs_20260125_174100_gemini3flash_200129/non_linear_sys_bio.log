x3*x4,                                                                          
    'x6*x8': x6*x8, 'x1*x2': x1*x2, 'x3*x6': x3*x6, 'x6**2': x6**2, 'x2*x8':    
x2*x8, 'x4*x6': x4*x6                                                           
}                                                                               
feature_names = list(features.keys())                                           
Theta = np.column_stack([features[name] for name in feature_names])             
                                                                                
# 4. Sparse Regression (Lasso)                                                  
equations = []                                                                  
for i in range(9):                                                              
    model = Lasso(alpha=1e-5, fit_intercept=False, max_iter=10000)              
    model.fit(Theta, dX[:, i])                                                  
    coefs = model.coef_                                                         
                                                                                
