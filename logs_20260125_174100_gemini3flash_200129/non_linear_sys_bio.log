    ss_res = np.sum((y - y_pred) ** 2)                                          
    ss_tot = np.sum((y - np.mean(y)) ** 2)                                      
    r2 = 1 - (ss_res / ss_tot)                                                  
    R2_scores.append(r2)                                                        
                                                                                
print("R2 Scores:", R2_scores)                                                  
print("A matrix:\n", A)                                                         
print("B vector:\n", B)                                                         
                                                                                
