import numpy as np                                                              
from itertools import combinations_with_replacement                             
                                                                                
# Load and prepare data                                                         
all_states_list = []                                                            
all_dxdt_list = []                                                              
dt = 0.001                                                                      
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    s = data['state']                                                           
    if s.shape[0] == 9 and s.shape[1] != 9:                                     
        s = s.T                                                                 
    dxdt = np.gradient(s, dt, axis=0)                                           
    all_states_list.append(s)                                                   
    all_dxdt_list.append(dxdt)                                                  
                                                                                
X = np.concatenate(all_states_list, axis=0)                                     
Y = np.concatenate(all_dxdt_list, axis=0)                                       
                                                                                
# Create quadratic features                                                     
# Linear terms + Constant                                                       
features = [X, np.ones((X.shape[0], 1))]                                        
feature_names = [f"x{i+1}" for i in range(9)] + ["1"]                           
                                                                                
# Interaction terms x_i * x_j                                                   
for i, j in combinations_with_replacement(range(9), 2):                         
    features.append((X[:, i] * X[:, j]).reshape(-1, 1))                         
    feature_names.append(f"x{i+1}*x{j+1}")                                      
                                                                                
X_poly = np.concatenate(features, axis=1)                                       
                                                                                
print(f"Number of features: {len(feature_names)}")                              
                                                                                
# Fit for each variable                                                         
for i in range(9):                                                              
    y_i = Y[:, i]                                                               
    beta, residuals, rank, s_vals = np.linalg.lstsq(X_poly, y_i, rcond=None)    
                                                                                
    y_pred = np.dot(X_poly, beta)                                               
    ss_res = np.sum((y_i - y_pred)**2)                                          
    ss_tot = np.sum((y_i - np.mean(y_i))**2)                                    
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    print(f"Variable x{i+1} poly fit R^2: {r2:.6f}")                            
    if r2 > 0.99:                                                               
        # Sort terms by magnitude of coefficient                                
        idx = np.argsort(np.abs(beta))[::-1]                                    
        terms = []                                                              
        for j in idx:                                                           
            if abs(beta[j]) > 0.01:                                             
                terms.append(f"({beta[j]:.3f})*{feature_names[j]}")             
        # Show top 5 terms                                                      
        print(f"  dx{i+1}/dt ≈ {' + '.join(terms[:5])} ...")                    
    else:                                                                       
        print(f"  Low R^2 even with poly terms for x{i+1}")                     
                                                                                
# If poly fit is still low for some, it might be switching modes or other       
