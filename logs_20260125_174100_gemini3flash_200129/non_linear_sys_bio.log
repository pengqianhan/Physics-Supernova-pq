import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the data from the provided NPZ files                                     
data0 = np.load('data_all/non_linear/sys_bio/sample_0.npz')                     
data1 = np.load('data_all/non_linear/sys_bio/sample_1.npz')                     
data2 = np.load('data_all/non_linear/sys_bio/sample_2.npz')                     
                                                                                
# Extract state data (9 variables, 10001 time steps)                            
state0 = data0['state']                                                         
state1 = data1['state']                                                         
state2 = data2['state']                                                         
                                                                                
# Combine transitions from all samples                                          
def get_transitions(state):                                                     
    # State is (9, 10001)                                                       
    # X_prev is state at t_k, X_next is state at t_{k+1}                        
    X_prev = state[:, :-1]                                                      
    X_next = state[:, 1:]                                                       
    return X_prev, X_next                                                       
                                                                                
X_prev0, X_next0 = get_transitions(state0)                                      
X_prev1, X_next1 = get_transitions(state1)                                      
X_prev2, X_next2 = get_transitions(state2)                                      
                                                                                
# Concatenate all available transitions                                         
X_prev_all = np.hstack([X_prev0, X_prev1, X_prev2])                             
X_next_all = np.hstack([X_next0, X_next1, X_next2])                             
                                                                                
# We solve for the transition matrix M and bias C such that X_next = M * X_prev 
+ C                                                                             
# Let Z = [X_prev; 1...1] (shape 10, N)                                         
# Then X_next = [M C] * Z                                                       
Z = np.vstack([X_prev_all, np.ones((1, X_prev_all.shape[1]))])                  
# Use least squares to solve for [M C]                                          
theta, residuals, rank, s = np.linalg.lstsq(Z.T, X_next_all.T, rcond=None)      
# theta is (10, 9), so we transpose it to get [M C] (9, 10)                     
model = theta.T                                                                 
M = model[:, :9]                                                                
C = model[:, 9]                                                                 
                                                                                
# Format the output equations                                                   
equations = []                                                                  
for i in range(9):                                                              
    eq = f"x{i+1}[1] = "                                                        
    terms = []                                                                  
    for j in range(9):                                                          
        coeff = M[i, j]                                                         
        terms.append(f"{coeff:.4f}*x{j+1}[0]")                                  
    eq += " + ".join(terms)                                                     
    # Add constant term                                                         
    eq += f" + {C[i]:.4f}"                                                      
    # Cleanup: replace "+ -" with "- "                                          
    eq = eq.replace("+ -", "- ")                                                
    equations.append(eq)                                                        
                                                                                
# Prepare final answer components                                               
outcome_short = "The system is a discrete-time linear dynamical system where the
state at step 1 is a linear combination of the state at step 0."                
outcome_detailed = "Based on the provided data, the system follows a perfectly  
