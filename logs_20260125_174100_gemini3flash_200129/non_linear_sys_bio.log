        if abs(coeffs[-1]) > 1e-6:                                              
            eq_parts.append(f"({coeffs[-1]:.4f})")                              
        equations.append(f"dx{i+1}/dt = " + " + ".join(eq_parts))               
                                                                                
# Stability Analysis                                                            
