import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import Lasso                                          
                                                                                
# Load data                                                                     
data_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
dt = 0.001                                                                      
                                                                                
X_all = []                                                                      
dX_all = []                                                                     
                                                                                
for path in data_paths:                                                         
    data = np.load(path)                                                        
    # Assuming data contains 'x' or similar. Usually npz from these tasks have  
'data' or 'x'.                                                                  
    # Let's check keys first.                                                   
    if 'x' in data:                                                             
        x = data['x']                                                           
    elif 'data' in data:                                                        
        x = data['data']                                                        
    else:                                                                       
        x = data[data.files[0]]                                                 
                                                                                
    # x shape is likely (Time, Variables)                                       
    X_all.append(x[:-1]) # State at t                                           
    # Finite difference (x(t+dt) - x(t)) / dt                                   
    dx = (x[1:] - x[:-1]) / dt                                                  
    dX_all.append(dx)                                                           
                                                                                
X = np.concatenate(X_all, axis=0)                                               
dX = np.concatenate(dX_all, axis=0)                                             
                                                                                
# Candidate features                                                            
# 1. Constant                                                                   
# 2. x1...x9                                                                    
# 3. x2**2                                                                      
# 4. Cross terms: x2*x3, x2*x4, x2*x6, x2*x7, x3*x4, x6*x8, x1*x2, x3*x6, x6**2,
x2*x8, x4*x6                                                                    
features = []                                                                   
feature_names = []                                                              
                                                                                
# Constant                                                                      
features.append(np.ones((X.shape[0], 1)))                                       
feature_names.append("1.0")                                                     
                                                                                
# Linear                                                                        
for i in range(9):                                                              
    features.append(X[:, i:i+1])                                                
    feature_names.append(f"x{i+1}")                                             
                                                                                
# Quadratic x2**2                                                               
features.append((X[:, 1]**2).reshape(-1, 1))                                    
feature_names.append("x2**2")                                                   
                                                                                
# Cross terms                                                                   
cross_terms = [(1,2), (1,3), (1,5), (1,6), (2,3), (5,7), (0,1), (2,5), (5,5),   
(1,7), (3,5)]                                                                   
# Note: indices are 0-based, so x2 is index 1.                                  
# x2*x3 -> (1, 2)                                                               
# x2*x4 -> (1, 3)                                                               
# x2*x6 -> (1, 5)                                                               
# x2*x7 -> (1, 6)                                                               
# x3*x4 -> (2, 3)                                                               
# x6*x8 -> (5, 7)                                                               
# x1*x2 -> (0, 1)                                                               
# x3*x6 -> (2, 5)                                                               
# x6**2 -> (5, 5)                                                               
# x2*x8 -> (1, 7)                                                               
# x4*x6 -> (3, 5)                                                               
                                                                                
for i, j in cross_terms:                                                        
    features.append((X[:, i] * X[:, j]).reshape(-1, 1))                         
    if i == j:                                                                  
        feature_names.append(f"x{i+1}**2")                                      
    else:                                                                       
        feature_names.append(f"x{i+1}*x{j+1}")                                  
                                                                                
Phi = np.concatenate(features, axis=1)                                          
                                                                                
# Sparse Regression (STLSQ)                                                     
def stlsq(Phi, b, threshold=0.01):                                              
    # Initial least squares                                                     
    coef = np.linalg.lstsq(Phi, b, rcond=None)[0]                               
    for _ in range(10):                                                         
        mask = np.abs(coef) >= threshold                                        
        coef[~mask] = 0                                                         
        for i in range(b.shape[1]):                                             
            if np.any(mask[:, i]):                                              
                coef[mask[:, i], i] = np.linalg.lstsq(Phi[:, mask[:, i]], b[:,  
i], rcond=None)[0]                                                              
    return coef                                                                 
                                                                                
coefficients = stlsq(Phi, dX)                                                   
                                                                                
# Format equations                                                              
equations = []                                                                  
for i in range(9):                                                              
    eq = f"x{i+1}[1] ="                                                         
    terms = []                                                                  
    for j in range(len(feature_names)):                                         
        c = coefficients[j, i]                                                  
        if abs(c) > 1e-5:                                                       
            terms.append(f" {c:+.4f}*{feature_names[j]}")                       
    if not terms:                                                               
        eq += " 0.0000"                                                         
    else:                                                                       
        eq += "".join(terms)                                                    
    equations.append(eq)                                                        
                                                                                
for eq in equations:                                                            
    print(eq)                                                                   
                                                                                
from tool_use import final_answer                                               
# Task outcome summary and detailed results                                     
short_outcome = "System identification completed for the 9-variable first-order 
system using sparse regression."                                                
detailed_outcome = "The ODEs for variables x1 to x9 were identified by          
processing time-series data from NPZ files. Derivatives were computed using     
finite differences (dt=0.001). A feature library including constants, linear,   
quadratic, and specific cross terms was used. Sequential Thresholded Least      
Squares (STLSQ) identified the following dynamics:\n" + "\n".join(equations)    
                                                                                
