      rhs = " ".join(eq_parts) if eq_parts else "0.0000"                        
      # Pretty formatting                                                       
      if rhs.startswith("+"):                                                   
          rhs = rhs[1:]                                                         
      rhs = rhs.replace("+", "+ ").replace("-", "- ")                           
      equation_str = f"x{i+1}[1] = {rhs}"                                       
      final_equations.append(equation_str)                                      
                                                                                
