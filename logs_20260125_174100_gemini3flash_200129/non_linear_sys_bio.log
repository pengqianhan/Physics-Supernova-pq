import numpy as np                                                              
                                                                                
# Load samples                                                                  
data0 = np.load('data_all/non_linear/sys_bio/sample_0.npz')                     
data1 = np.load('data_all/non_linear/sys_bio/sample_1.npz')                     
data2 = np.load('data_all/non_linear/sys_bio/sample_2.npz')                     
                                                                                
dt = 0.01  # Typical dt                                                         
                                                                                
def get_data(data):                                                             
    state = data['state']                                                       
    X = state[:, :-1].T                                                         
    # Calculate derivative                                                      
    Y = (state[:, 1:] - state[:, :-1]).T / dt                                   
    return X, Y                                                                 
                                                                                
X_list, Y_list = [], []                                                         
for d in [data0, data1, data2]:                                                 
    X_s, Y_s = get_data(d)                                                      
    X_list.append(X_s)                                                          
    Y_list.append(Y_s)                                                          
                                                                                
X_all = np.vstack(X_list)                                                       
Y_all = np.vstack(Y_list)                                                       
                                                                                
# Split by x1 < 1.5                                                             
mask1 = X_all[:, 0] < 1.5                                                       
mask2 = ~mask1                                                                  
                                                                                
X1, Y1 = X_all[mask1], Y_all[mask1]                                             
X2, Y2 = X_all[mask2], Y_all[mask2]                                             
                                                                                
def fit_ode(X, Y):                                                              
    # Add column of ones for the intercept b                                    
    X_aug = np.column_stack([X, np.ones(X.shape[0])])                           
    # Solve A_aug = (X_aug^T * X_aug)^-1 * X_aug^T * Y                          
    # Coefficients result in (n_features + 1, n_outputs)                        
    coeffs, residuals, rank, s = np.linalg.lstsq(X_aug, Y, rcond=None)          
    # coeffs is [A.T, b].T? No, X_aug @ coeffs = Y.                             
    # So coeffs.T is [A, b]                                                     
    A = coeffs[:-1, :].T                                                        
    b = coeffs[-1, :]                                                           
    return A, b                                                                 
                                                                                
A1, b1 = fit_ode(X1, Y1)                                                        
A2, b2 = fit_ode(X2, Y2)                                                        
                                                                                
def format_equations(A, b):                                                     
    lines = []                                                                  
    for i in range(9):                                                          
        terms = []                                                              
        for j in range(9):                                                      
            if abs(A[i, j]) > 1e-4:                                             
                terms.append(f"{A[i, j]:+.4f}*x{j+1}[0]")                       
        if abs(b[i]) > 1e-4:                                                    
            terms.append(f"{b[i]:+.4f}")                                        
        eq = " ".join(terms)                                                    
        if eq.startswith("+"): eq = eq[1:]                                      
        lines.append(f"x{i+1}[1] = {eq}")                                       
    return lines                                                                
                                                                                
