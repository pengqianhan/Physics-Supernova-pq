import numpy as np                                                              
                                                                                
# Load all samples                                                              
samples = [np.load(p)['state'] for p in DATA_FILE_PATHS]                        
dt = 0.01                                                                       
                                                                                
def get_derivatives(states, dt):                                                
    return (states[:, 1:] - states[:, :-1]) / dt                                
                                                                                
def fit_linear(X, Y):                                                           
    X_aug = np.column_stack([X, np.ones(X.shape[0])])                           
    coeffs, residuals, rank, s = np.linalg.lstsq(X_aug, Y, rcond=None)          
    return coeffs                                                               
                                                                                
def detect_modes(sample_states):                                                
    X = sample_states[:, :-1].T                                                 
    Y = get_derivatives(sample_states, dt).T                                    
                                                                                
    n_points = X.shape[0]                                                       
    switching_points = [0]                                                      
                                                                                
    # Check for switches by seeing when the local linear model fails            
    current_start = 0                                                           
    while current_start < n_points:                                             
        # We need at least some points to fit (e.g., 20)                        
        window = 20                                                             
        if current_start + window >= n_points:                                  
            break                                                               
                                                                                
        # Fit model on current window                                           
        X_ref = X[current_start:current_start+window]                           
        Y_ref = Y[current_start:current_start+window]                           
        coeffs = fit_linear(X_ref, Y_ref)                                       
                                                                                
        # Test how far this model holds                                         
        found_switch = False                                                    
        for i in range(current_start + window, n_points):                       
            x_test = X[i:i+1]                                                   
            y_test = Y[i:i+1]                                                   
            x_test_aug = np.column_stack([x_test, np.ones(1)])                  
            y_pred = np.dot(x_test_aug, coeffs)                                 
            error = np.linalg.norm(y_test - y_pred)                             
                                                                                
            if error > 1e-4: # Threshold for switch                             
                switching_points.append(i)                                      
                current_start = i                                               
                found_switch = True                                             
                break                                                           
                                                                                
        if not found_switch:                                                    
            break                                                               
                                                                                
    switching_points.append(n_points)                                           
    return switching_points                                                     
                                                                                
all_switches = []                                                               
for i, s in enumerate(samples):                                                 
    sw = detect_modes(s)                                                        
    all_switches.append(sw)                                                     
    print(f"Sample {i} switching points (indices):", sw)                        
