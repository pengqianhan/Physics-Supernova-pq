Thought: I will load the provided NPZ files, concatenate the state trajectories,
and estimate the time derivatives using a central difference method. Then, I    
will solve the linear regression problem $\frac{dx}{dt} \approx Ax + b$ by      
constructing a data matrix and using least squares. Finally, I will formulate   
the equations and evaluate the residuals to determine the quality of the fit.   
                                                                                
<code>                                                                          
import numpy as np                                                              
                                                                                
# 1. Load data                                                                  
all_x = []                                                                      
all_dxdt = []                                                                   
dt = 0.001                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # The file contains a 'x' key (9, N)                                        
    x = data['x'] # Shape (9, N)                                                
                                                                                
    # 2. Estimate derivative dx/dt using central difference for interior points 
    # dxdt[:, i] = (x[:, i+1] - x[:, i-1]) / (2*dt)                             
    dxdt = (x[:, 2:] - x[:, :-2]) / (2 * dt)                                    
    # Align x with dxdt                                                         
    x_reduced = x[:, 1:-1]                                                      
                                                                                
    all_x.append(x_reduced)                                                     
    all_dxdt.append(dxdt)                                                       
                                                                                
# Concatenate all samples                                                       
X = np.hstack(all_x).T # Shape (Total_N, 9)                                     
dXdt = np.hstack(all_dxdt).T # Shape (Total_N, 9)                               
                                                                                
# 3. Perform linear regression dx/dt = Ax + b                                   
# Augmented matrix [X, 1]                                                       
ones = np.ones((X.shape[0], 1))                                                 
X_aug = np.hstack([X, ones])                                                    
                                                                                
# Solve for weights W = [A, b]^T (10, 9)                                        
W, residuals_sum, rank, s = np.linalg.lstsq(X_aug, dXdt, rcond=None)            
                                                                                
A = W[:9, :].T                                                                  
b = W[9, :]                                                                     
                                                                                
# 4. Calculate residuals to evaluate fit                                        
predictions = X_aug @ W                                                         
residuals = dXdt - predictions                                                  
mse = np.mean(residuals**2)                                                     
r2_scores = []                                                                  
for i in range(9):                                                              
    ss_res = np.sum((dXdt[:, i] - predictions[:, i])**2)                        
    ss_tot = np.sum((dXdt[:, i] - np.mean(dXdt[:, i]))**2)                      
    r2_scores.append(1 - (ss_res / ss_tot))                                     
                                                                                
print(f"MSE: {mse}")                                                            
print(f"R2 Scores: {r2_scores}")                                                
print(f"Matrix A:\n{A}")                                                        
print(f"Vector b:\n{b}")                                                        
                                                                                
