import numpy as np                                                              
import os                                                                       
                                                                                
# Load all data files                                                           
all_states = []                                                                 
all_derivs = []                                                                 
dt = 0.001                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'] # Expected shape (9, N)                               
                                                                                
    # Calculate derivatives using central difference for interior points        
    # state is (9, N)                                                           
    # dx/dt at index j: (x[j+1] - x[j-1]) / (2*dt)                              
    d_state = (state[:, 2:] - state[:, :-2]) / (2 * dt)                         
                                                                                
    # Matching states for the derivatives (interior points)                     
    state_subset = state[:, 1:-1]                                               
                                                                                
    all_states.append(state_subset)                                             
    all_derivs.append(d_state)                                                  
                                                                                
# Concatenate all data                                                          
X_data = np.concatenate(all_states, axis=1).T # Shape (Total_N, 9)              
Y_data = np.concatenate(all_derivs, axis=1).T # Shape (Total_N, 9)              
                                                                                
# Construct feature matrix                                                      
# x1..x9 correspond to X_data[:, 0..8]                                          
num_samples = X_data.shape[0]                                                   
features = []                                                                   
                                                                                
# Constant term                                                                 
features.append(np.ones((num_samples, 1)))                                      
                                                                                
# Linear terms x1 to x9                                                         
for i in range(9):                                                              
    features.append(X_data[:, i:i+1])                                           
                                                                                
# Nonlinear terms: x2^2, x2*x6, x2*x4, x3*x4, x1*x2, x2*x3, x2*x7, x3*x6, x6*x8 
# Index mapping (0-indexed): x1->0, x2->1, x3->2, x4->3, x5->4, x6->5, x7->6,   
x8->7, x9->8                                                                    
nl_indices = [                                                                  
    (1, 1), (1, 5), (1, 3), (2, 3), (0, 1), (1, 2), (1, 6), (2, 5), (5, 7)      
]                                                                               
nl_names = ["x2^2", "x2*x6", "x2*x4", "x3*x4", "x1*x2", "x2*x3", "x2*x7",       
"x3*x6", "x6*x8"]                                                               
                                                                                
for idx1, idx2 in nl_indices:                                                   
    term = (X_data[:, idx1] * X_data[:, idx2]).reshape(-1, 1)                   
    features.append(term)                                                       
                                                                                
Theta = np.hstack(features)                                                     
feature_names = ["1", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9"] +   
nl_names                                                                        
                                                                                
# Ridge Regression: (Theta^T * Theta + alpha * I) * w = Theta^T * Y             
alpha = 1e-6                                                                    
I = np.eye(Theta.shape[1])                                                      
coeffs = np.linalg.solve(Theta.T @ Theta + alpha * I, Theta.T @ Y_data)         
                                                                                
# Printing equations                                                            
equations = []                                                                  
for i in range(9):                                                              
    terms_str = []                                                              
    for j in range(len(feature_names)):                                         
        val = coeffs[j, i]                                                      
        if abs(val) > 1e-4:                                                     
            terms_str.append(f"{val:.6f} * {feature_names[j]}")                 
    eq = f"dx{i+1}/dt = " + " + ".join(terms_str)                               
    equations.append(eq)                                                        
    print(eq)                                                                   
                                                                                
non_linear_items = ",".join(nl_names)                                           
print(f"non_linear_items: {non_linear_items}")                                  
                                                                                
