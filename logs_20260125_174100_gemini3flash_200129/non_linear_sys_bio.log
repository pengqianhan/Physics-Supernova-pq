    lasso.fit(Phi, y)                                                           
    coefs = lasso.coef_                                                         
                                                                                
    # Construct equation string                                                 
    terms = []                                                                  
    # Check if we should keep the term based on magnitude                       
    for val, name in zip(coefs, feature_names):                                 
        if abs(val) > threshold:                                                
            terms.append(f"{val:.4f} * {name}")                                 
                                                                                
    eq = f"x{i+1}[1] = " + (" + ".join(terms) if terms else "0")                
    equations.append(eq)                                                        
