import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
from sklearn.metrics import r2_score                                            
                                                                                
# Parameters from task description                                              
dt = 0.001                                                                      
num_vars = 9                                                                    
                                                                                
# Load all data and compute derivatives                                         
X_all = []                                                                      
dX_all = []                                                                     
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']  # Shape (9, 10001)                                   
                                                                                
    # x values (excluding last point for forward difference)                    
    x = state[:, :-1].T  # Shape (10000, 9)                                     
                                                                                
    # Numerical derivatives (forward difference)                                
    dx = (state[:, 1:] - state[:, :-1]) / dt                                    
    dx = dx.T  # Shape (10000, 9)                                               
                                                                                
    X_all.append(x)                                                             
    dX_all.append(dx)                                                           
                                                                                
# Combine all samples                                                           
X = np.vstack(X_all)                                                            
dX = np.vstack(dX_all)                                                          
                                                                                
# 1. Fit Linear Model: dx/dt = Ax + b                                           
linear_models = []                                                              
linear_r2 = []                                                                  
A = np.zeros((num_vars, num_vars))                                              
b = np.zeros(num_vars)                                                          
                                                                                
for i in range(num_vars):                                                       
    model = LinearRegression()                                                  
    model.fit(X, dX[:, i])                                                      
    linear_models.append(model)                                                 
    linear_r2.append(model.score(X, dX[:, i]))                                  
    A[i, :] = model.coef_                                                       
    b[i] = model.intercept_                                                     
                                                                                
print(f"Linear Model R2 scores: {linear_r2}")                                   
                                                                                
# 2. Check Nonlinear Terms (Squares and cross-products)                         
X_nonlin = X.copy()                                                             
nonlinear_terms_names = []                                                      
                                                                                
# Adding squares                                                                
for i in range(num_vars):                                                       
    X_nonlin = np.column_stack([X_nonlin, X[:, i]**2])                          
    nonlinear_terms_names.append(f"x{i+1}^2")                                   
                                                                                
# Adding some cross products (just a few for brevity/check)                     
for i in range(3):                                                              
    for j in range(i+1, 3):                                                     
        X_nonlin = np.column_stack([X_nonlin, X[:, i] * X[:, j]])               
        nonlinear_terms_names.append(f"x{i+1}*x{j+1}")                          
                                                                                
nonlin_r2 = []                                                                  
for i in range(num_vars):                                                       
    model_nl = LinearRegression()                                               
    model_nl.fit(X_nonlin, dX[:, i])                                            
    nonlin_r2.append(model_nl.score(X_nonlin, dX[:, i]))                        
                                                                                
print(f"Nonlinear Model R2 scores: {nonlin_r2}")                                
                                                                                
# Prepare final report output                                                   
equations = []                                                                  
for i in range(num_vars):                                                       
    terms = [f"({A[i, j]:.4f})*x{j+1}" for j in range(num_vars)]                
    eq = f"dx{i+1}/dt = " + " + ".join(terms) + f" + ({b[i]:.4f})"              
