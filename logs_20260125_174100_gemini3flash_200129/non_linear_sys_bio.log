import numpy as np                                                              
from sklearn.linear_model import Ridge                                          
from sklearn.metrics import r2_score                                            
                                                                                
# Load data                                                                     
all_states = []                                                                 
all_derivs = []                                                                 
dt = 0.001                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'] # shape (9, num_steps)                                
                                                                                
    # Compute derivatives using central difference for interior points          
    # dx/dt = (x(t+dt) - x(t-dt)) / (2*dt)                                      
    dx_dt = np.gradient(state, dt, axis=1)                                      
                                                                                
    all_states.append(state.T)                                                  
    all_derivs.append(dx_dt.T)                                                  
                                                                                
X = np.vstack(all_states)                                                       
Y = np.vstack(all_derivs)                                                       
                                                                                
# Fit linear model for each dimension                                           
# dx_i/dt = sum(a_ij * x_j) + b_i                                               
model = Ridge(alpha=1e-5)                                                       
model.fit(X, Y)                                                                 
Y_pred = model.predict(X)                                                       
r2 = r2_score(Y, Y_pred, multioutput='raw_values')                              
                                                                                
print(f"Linear R2 scores: {r2}")                                                
                                                                                
# Prepare equations                                                             
coefs = model.coef_                                                             
intercepts = model.intercept_                                                   
                                                                                
equations = []                                                                  
for i in range(9):                                                              
    terms = []                                                                  
    for j in range(9):                                                          
        if abs(coefs[i, j]) > 1e-3:                                             
            terms.append(f"{coefs[i, j]:.4f}*x{j+1}")                           
    if abs(intercepts[i]) > 1e-3:                                               
        terms.append(f"{intercepts[i]:.4f}")                                    
                                                                                
    eq = " + ".join(terms).replace("+ -", "- ")                                 
    equations.append(f"x{i+1}' = {eq}")                                         
                                                                                
for eq in equations:                                                            
    print(eq)                                                                   
                                                                                
