for i in range(9):                                                              
    p = results[i]['preds'][:sample_len]                                        
    t = dX[:sample_len, i]                                                      
    sample0_errors.append((t - p)**2)                                           
                                                                                
avg_error_t = np.mean(sample0_errors, axis=0)                                   
# Print some chunks to see if error is stable                                   
