'data_all/non_linear/sys_bio/sample_2.npz']:                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    all_states.append(state)                                                    
    all_d_states.append(compute_derivatives(state, dt))                         
                                                                                
# Concatenate along time axis                                                   
X = np.concatenate(all_states, axis=1).T  # Shape (N, 9)                        
