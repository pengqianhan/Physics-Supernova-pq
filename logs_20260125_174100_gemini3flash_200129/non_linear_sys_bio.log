import numpy as np                                                              
                                                                                
# Load data                                                                     
all_X = []                                                                      
all_dXdt = []                                                                   
dt = 0.001                                                                      
data_file_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                  
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
                                                                                
for path in data_file_paths:                                                    
    data = np.load(path)                                                        
    # The dictionary keys are likely 'X' or similar.                            
    # Based on the typical structure, let's assume 'X' or the first key.        
    key = 'X' if 'X' in data else data.files[0]                                 
    X = data[key]                                                               
                                                                                
    # Derivative                                                                
    dXdt = (X[1:] - X[:-1]) / dt                                                
    X_red = X[:-1]                                                              
                                                                                
    all_X.append(X_red)                                                         
    all_dXdt.append(dXdt)                                                       
                                                                                
X_total = np.vstack(all_X)                                                      
dXdt_total = np.vstack(all_dXdt)                                                
                                                                                
num_samples, num_vars = X_total.shape                                           
                                                                                
# Build feature matrix: bias, linear terms, and quadratic terms                 
# Features: [1, x1, ..., x9, x1^2, x1*x2, ..., x9^2]                            
features = [np.ones((num_samples, 1)), X_total]                                 
                                                                                
# Quadratic terms                                                               
quad_terms = []                                                                 
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        quad_terms.append((X_total[:, i] * X_total[:, j]).reshape(-1, 1))       
                                                                                
features.append(np.hstack(quad_terms))                                          
Phi = np.hstack(features)                                                       
                                                                                
# Feature names for reporting                                                   
feature_names = ['1'] + [f'x{i+1}' for i in range(num_vars)]                    
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        feature_names.append(f'x{i+1}*x{j+1}')                                  
                                                                                
# Regression for each dxi/dt                                                    
coeffs = []                                                                     
for i in range(num_vars):                                                       
    w, resid, rank, s = np.linalg.lstsq(Phi, dXdt_total[:, i], rcond=None)      
    coeffs.append(w)                                                            
                                                                                
coeffs = np.array(coeffs)                                                       
                                                                                
# Print equations (threshold small coefficients)                                
threshold = 1e-3                                                                
equations = []                                                                  
for i in range(num_vars):                                                       
    eq = f"dx{i+1}/dt ="                                                        
    terms = []                                                                  
    for val, name in zip(coeffs[i], feature_names):                             
        if abs(val) > threshold:                                                
            terms.append(f"{val:+.4f}*{name}")                                  
    if not terms:                                                               
        eq += " 0"                                                              
    else:                                                                       
        eq += " " + " ".join(terms)                                             
    equations.append(eq)                                                        
    print(eq)                                                                   
                                                                                
# Stability check: check eigenvalues of the linear part at the origin or a      
sample point?                                                                   
# Usually "stability" refers to the Jacobian.                                   
# Let's check the linear part coefficients for stability (local stability around
0).                                                                             
linear_part = coeffs[:, 1:num_vars+1]                                           
eigenvalues = np.linalg.eigvals(linear_part)                                    
print("Eigenvalues of linear part:", eigenvalues)                               
is_stable = np.all(np.real(eigenvalues) <= 0)                                   
print("Stable linear part?", is_stable)                                         
                                                                                
