from sklearn.preprocessing import PolynomialFeatures                            
                                                                                
# Load data                                                                     
data_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
                                                                                
all_X = []                                                                      
all_dX = []                                                                     
                                                                                
for path in data_paths:                                                         
    data = np.load(path)                                                        
    # Assuming 'x' is (N_samples, 9) and 't' is (N_samples,)                    
    # Or 'x' is (N_trajectories, N_timesteps, 9)                                
    x = data['x']                                                               
    t = data['t']                                                               
                                                                                
    if len(x.shape) == 3: # (N_traj, N_steps, 9)                                
        for i in range(x.shape[0]):                                             
            traj = x[i]                                                         
            dt = t[1] - t[0] # Assuming uniform                                 
            deriv = np.gradient(traj, dt, axis=0)                               
            all_X.append(traj)                                                  
            all_dX.append(deriv)                                                
    else: # (N_steps, 9)                                                        
        dt = t[1] - t[0]                                                        
        deriv = np.gradient(x, dt, axis=0)                                      
        all_X.append(x)                                                         
        all_dX.append(deriv)                                                    
                                                                                
X_data = np.vstack(all_X)                                                       
dX_data = np.vstack(all_dX)                                                     
                                                                                
# Features: 1, x1...x9, x1^2, x1x2, ...                                         
poly = PolynomialFeatures(degree=2, include_bias=True)                          
X_poly = poly.fit_transform(X_data)                                             
feature_names = poly.get_feature_names_out(['x1', 'x2', 'x3', 'x4', 'x5', 'x6', 
'x7', 'x8', 'x9'])                                                              
                                                                                
# Regression                                                                    
equations = []                                                                  
threshold = 1e-3                                                                
                                                                                
for i in range(9):                                                              
    y = dX_data[:, i]                                                           
    # Use simple least squares then threshold                                   
