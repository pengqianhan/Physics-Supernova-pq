  dt = 0.01                                                                     
  total_X = []                                                                  
  total_Y = []                                                                  
                                                                                
  for state in all_states:                                                      
      x = state.T                                                               
      y = np.gradient(x, axis=0) / dt                                           
      total_X.append(x)                                                         
      total_Y.append(y)                                                         
                                                                                
  X = np.vstack(total_X)                                                        
  Y = np.vstack(total_Y)                                                        
                                                                                
  feature_names = []                                                            
  features = []                                                                 
                                                                                
  # Linear terms                                                                
  for i in range(9):                                                            
      feature_names.append(f"x{i+1}[0]")                                        
      features.append(X[:, i])                                                  
                                                                                
  # Squared terms                                                               
  for i in range(9):                                                            
      feature_names.append(f"x{i+1}[0]**2")                                     
      features.append(X[:, i]**2)                                               
                                                                                
  # Interaction terms                                                           
  for i in range(9):                                                            
      for j in range(i + 1, 9):                                                 
          feature_names.append(f"x{i+1}[0]*x{j+1}[0]")                          
          features.append(X[:, i] * X[:, j])                                    
                                                                                
  Phi = np.column_stack(features)                                               
                                                                                
  # Sequential Thresholded Least Squares (SINDy)                                
  def sparse_regression(Phi, Y, threshold, iterations=10):                      
      coeffs = np.linalg.lstsq(Phi, Y, rcond=None)[0]                           
      for _ in range(iterations):                                               
          small_coeffs = np.abs(coeffs) < threshold                             
          coeffs[small_coeffs] = 0                                              
          for i in range(Y.shape[1]):                                           
              big_coeffs = ~small_coeffs[:, i]                                  
              if np.any(big_coeffs):                                            
                  coeffs[big_coeffs, i] = np.linalg.lstsq(Phi[:, big_coeffs],   
  Y[:, i], rcond=None)[0]                                                       
      return coeffs                                                             
                                                                                
  # Using a threshold to get a sparse model                                     
  threshold = 0.05                                                              
  coeffs = sparse_regression(Phi, Y, threshold)                                 
                                                                                
  final_equations = []                                                          
  used_non_linear = set()                                                       
                                                                                
  for i in range(9):                                                            
      eq_parts = []                                                             
