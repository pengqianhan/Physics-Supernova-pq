      data = np.load(path)                                                      
      state = data['state']                                                     
      # Use central difference for better derivative estimation if possible,    
      # but forward difference is okay for small dt.                            
      dx = (state[1:] - state[:-1]) / dt                                        
      all_x.append(state[:-1])                                                  
      all_dx.append(dx)                                                         
                                                                                
  X = np.vstack(all_x)                                                          
  DX = np.vstack(all_dx)                                                        
                                                                                
  print(f"X range: {X.min(axis=0)} to {X.max(axis=0)}")                         
  print(f"DX range: {DX.min(axis=0)} to {DX.max(axis=0)}")                      
                                                                                
  # Build features                                                              
  num_states = 9                                                                
  feature_names = ['1']                                                         
  features = [np.ones(X.shape[0])]                                              
  for i in range(num_states):                                                   
      feature_names.append(f"x{i+1}")                                           
      features.append(X[:, i])                                                  
  for i in range(num_states):                                                   
      for j in range(i, num_states):                                            
          feature_names.append(f"x{i+1}*x{j+1}")                                
          features.append(X[:, i] * X[:, j])                                    
                                                                                
  Phi = np.column_stack(features)                                               
                                                                                
  # SINDy with higher threshold and checking condition number                   
  def sindy(Phi, y, threshold=0.1):                                             
      n_features = Phi.shape[1]                                                 
      # Initial regression                                                      
      coef, _, _, _ = np.linalg.lstsq(Phi, y, rcond=None)                       
                                                                                
      for _ in range(20):                                                       
          small_idx = np.abs(coef) < threshold                                  
          coef[small_idx] = 0                                                   
          big_idx = ~small_idx                                                  
          if not np.any(big_idx):                                               
              break                                                             
          # Refit with only big coefficients                                    
          coef[big_idx], _, _, _ = np.linalg.lstsq(Phi[:, big_idx], y,          
  rcond=None)                                                                   
      return coef                                                               
                                                                                
  print("Condition number of Phi:", np.linalg.cond(Phi))                        
                                                                                
  for i in range(num_states):                                                   
      coef = sindy(Phi, DX[:, i], threshold=0.2)                                
      terms = []                                                                
      for c, name in zip(coef, feature_names):                                  
