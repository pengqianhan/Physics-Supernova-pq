    print(line)                                                                 
                                                                                
print("\nMode 2 (x1 >= 1.5):")                                                  
for line in format_equations(A2, b2):                                           
    print(line)                                                                 
                                                                                
# Check for other switches: compute residuals for each point                    
def check_other_switches(X, Y, A, b):                                           
    pred = X @ A.T + b                                                          
    res = np.abs(Y - pred)                                                      
    mean_res = np.mean(res, axis=0)                                             
    max_res = np.max(res, axis=0)                                               
    return mean_res, max_res, res                                               
                                                                                
mean_res1, max_res1, res1 = check_other_switches(X1, Y1, A1, b1)                
mean_res2, max_res2, res2 = check_other_switches(X2, Y2, A2, b2)                
                                                                                
print("\nResiduals Mode 1:", mean_res1)                                         
