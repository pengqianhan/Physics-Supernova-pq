features = [X_data[:, i] for i in range(num_states)]                            
                                                                                
# Add quadratic and cross terms                                                 
for i in range(num_states):                                                     
    for j in range(i, num_states):                                              
        features.append(X_data[:, i] * X_data[:, j])                            
        feature_names.append(f'x{i+1}*x{j+1}')                                  
                                                                                
# Convert list of arrays to 2D array                                            
Phi = np.column_stack(features)                                                 
                                                                                
