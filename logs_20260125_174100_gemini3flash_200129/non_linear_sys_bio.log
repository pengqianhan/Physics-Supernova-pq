def fit_stable(X, Y, alpha=1e-5):                                               
    X_aug = np.column_stack([X, np.ones(X.shape[0])])                           
    # Ridge regression: (X'X + alpha*I) b = X'Y                                 
    XtX = np.dot(X_aug.T, X_aug)                                                
    XtY = np.dot(X_aug.T, Y)                                                    
    I = np.eye(XtX.shape[0])                                                    
    coeffs = np.linalg.solve(XtX + alpha * I, XtY)                              
    return coeffs                                                               
                                                                                
