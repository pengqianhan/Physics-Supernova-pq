    # Estimate derivatives using central differences                            
    # dxdt[i] = (x[i+1] - x[i-1]) / (2*dt)                                      
    dxdt = (x[2:] - x[:-2]) / (2 * dt)                                          
    # Align x with the points where we estimated dxdt                           
    x_aligned = x[1:-1]                                                         
                                                                                
    all_x.append(x_aligned)                                                     
    all_dxdt.append(dxdt)                                                       
                                                                                
