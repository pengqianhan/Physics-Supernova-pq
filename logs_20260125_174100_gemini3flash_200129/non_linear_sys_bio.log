import numpy as np                                                              
from scipy import optimize                                                      
                                                                                
# Load data and inspect keys                                                    
all_x = []                                                                      
all_dx = []                                                                     
dt = 0.001                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # Assuming the state trajectory is stored under 'x' or similar              
    # If not sure, we can check data.files                                      
    x = data['x'] # Based on typical naming conventions in these tasks          
    all_x.append(x)                                                             
                                                                                
    # Calculate numerical derivative (central difference or forward difference) 
    # Forward difference for simplicity given the task context                  
    dx = (x[1:] - x[:-1]) / dt                                                  
    all_dx.append(dx)                                                           
                                                                                
# Combine data from all samples                                                 
# Use x[:-1] to match the length of dx                                          
X_data = np.vstack([x[:-1] for x in all_x])                                     
dX_data = np.vstack(all_dx)                                                     
                                                                                
num_samples, num_vars = X_data.shape                                            
                                                                                
# Build library: linear terms (x1..x9) and quadratic terms (xi*xj)              
# Terms order: x1, ..., x9, x1^2, x1*x2, ..., x9^2                              
library_names = [f"x[{i+1}]" for i in range(num_vars)]                          
library_cols = [X_data[:, i] for i in range(num_vars)]                          
                                                                                
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        library_names.append(f"x[{i+1}]*x[{j+1}]")                              
        library_cols.append(X_data[:, i] * X_data[:, j])                        
                                                                                
Theta = np.column_stack(library_cols)                                           
                                                                                
# STLSQ (Sequential Thresholded Least Squares) to find significant terms        
def fit_sparse(Theta, y, threshold=0.05):                                       
    # Initial least squares                                                     
    coef, _, _, _ = np.linalg.lstsq(Theta, y, rcond=None)                       
    # Thresholding                                                              
    for _ in range(10):                                                         
        small_indices = np.abs(coef) < threshold                                
        coef[small_indices] = 0                                                 
        big_indices = ~small_indices                                            
        if not np.any(big_indices): break                                       
        coef[big_indices], _, _, _ = np.linalg.lstsq(Theta[:, big_indices], y,  
rcond=None)                                                                     
    return coef                                                                 
                                                                                
equations = []                                                                  
for i in range(num_vars):                                                       
    coeffs = fit_sparse(Theta, dX_data[:, i], threshold=0.1)                    
    eq_parts = []                                                               
    for c, name in zip(coeffs, library_names):                                  
        if abs(c) > 1e-3:                                                       
            eq_parts.append(f"{c:+.4f}*{name}")                                 
                                                                                
    eq_str = f"x[{i+1}]' = " + (" ".join(eq_parts) if eq_parts else "0")        
    equations.append(eq_str)                                                    
                                                                                
for eq in equations:                                                            
    print(eq)                                                                   
                                                                                
