            if combo[0] == combo[1]:                                            
                poly_names.append(f"x{combo[0]+1}^2")                           
            else:                                                               
                poly_names.append(f"x{combo[0]+1}*x{combo[1]+1}")               
                                                                                
        X_poly = np.column_stack(poly_cols)                                     
        coef_poly, r2_poly = solve_regression(X_poly, y)                        
                                                                                
        refined_results[i] = {                                                  
            'type': 'poly',                                                     
            'coef': coef_poly,                                                  
            'r2': r2_poly,                                                      
            'names': poly_names                                                 
        }                                                                       
    else:                                                                       
        refined_results[i] = {                                                  
            'type': 'linear',                                                   
            'coef': coef_lin,                                                   
            'r2': r2_lin,                                                       
            'names': [f"x{j+1}" for j in range(9)]                              
        }                                                                       
                                                                                
# 5. Format Equations                                                           
equations = []                                                                  
for i in range(9):                                                              
    res = refined_results[i]                                                    
    # Intercept is res['coef'][0]                                               
    # Rest are res['coef'][1:] mapped to res['names']                           
    terms = []                                                                  
    intercept = res['coef'][0]                                                  
    if abs(intercept) > 1e-3:                                                   
        terms.append(f"{intercept:.4f}")                                        
                                                                                
    for c, name in zip(res['coef'][1:], res['names']):                          
