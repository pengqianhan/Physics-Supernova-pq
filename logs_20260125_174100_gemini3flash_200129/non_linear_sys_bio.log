import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
# Load data and compute derivatives                                             
dt = 0.001                                                                      
all_states = []                                                                 
all_derivs = []                                                                 
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'] # (9, num_steps)                                      
                                                                                
    # Compute derivative using central difference or forward difference         
    # Forward difference: (S[:, 1:] - S[:, :-1]) / dt                           
    # Using forward difference to match the number of points in X               
    deriv = (state[:, 1:] - state[:, :-1]) / dt                                 
    X_val = state[:, :-1]                                                       
                                                                                
    all_states.append(X_val.T)                                                  
    all_derivs.append(deriv.T)                                                  
                                                                                
# Concatenate all samples                                                       
X = np.vstack(all_states) # (N, 9)                                              
Y = np.vstack(all_derivs) # (N, 9)                                              
                                                                                
num_samples = X.shape[0]                                                        
                                                                                
# Prepare linear features: [1, x1, x2, ..., x9]                                 
X_linear = np.hstack([np.ones((num_samples, 1)), X])                            
                                                                                
results = {}                                                                    
                                                                                
def get_r2(y_true, y_pred):                                                     
    slope, intercept, r_value, p_value, std_err = stats.linregress(y_true,      
y_pred)                                                                         
    return r_value**2                                                           
                                                                                
def solve_regression(X_mat, y_vec):                                             
    # Solve (X^T X) beta = X^T y                                                
    beta = np.linalg.lstsq(X_mat, y_vec, rcond=None)[0]                         
    y_pred = X_mat @ beta                                                       
                                                                                
    # Calculate R2 manually                                                     
    ss_res = np.sum((y_vec - y_pred)**2)                                        
    ss_tot = np.sum((y_vec - np.mean(y_vec))**2)                                
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    return beta, r2                                                             
                                                                                
# Linear fits                                                                   
for i in range(9):                                                              
    beta, r2 = solve_regression(X_linear, Y[:, i])                              
    results[i] = {'beta_linear': beta, 'r2_linear': r2}                         
    print(f"Variable x{i+1} linear fit R2: {r2:.4f}")                           
                                                                                
# Check for poor fits and try quadratic                                         
for i in range(9):                                                              
    if results[i]['r2_linear'] < 0.95:                                          
        print(f"Variable x{i+1} has poor linear fit                             
({results[i]['r2_linear']:.4f}). Adding quadratic terms.")                      
        # Quadratic terms: x_j^2 and x_j * x_k                                  
        quad_features = []                                                      
        # Bias and linear terms already in X_linear                             
        # Let's build a new matrix                                              
        X_quad = [np.ones((num_samples, 1)), X]                                 
        # x_j * x_k for j <= k                                                  
        for j in range(9):                                                      
            for k in range(j, 9):                                               
                X_quad.append((X[:, j] * X[:, k]).reshape(-1, 1))               
                                                                                
        X_quad_mat = np.hstack(X_quad)                                          
        beta_q, r2_q = solve_regression(X_quad_mat, Y[:, i])                    
        results[i]['beta_quad'] = beta_q                                        
        results[i]['r2_quad'] = r2_q                                            
        results[i]['is_quad'] = True                                            
        print(f"Variable x{i+1} quadratic fit R2: {r2_q:.4f}")                  
    else:                                                                       
        results[i]['is_quad'] = False                                           
                                                                                
# Display results                                                               
for i in range(9):                                                              
    res = results[i]                                                            
    if res['is_quad']:                                                          
        print(f"x{i+1} best fit: Quadratic (R2={res['r2_quad']:.4f})")          
    else:                                                                       
        print(f"x{i+1} best fit: Linear (R2={res['r2_linear']:.4f})")           
                                                                                
                                                                                
