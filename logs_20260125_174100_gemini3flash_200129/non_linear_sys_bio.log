      all_x.append(x[::100])                                                    
      all_dx.append(dx[::100])                                                  
                                                                                
  X_data = np.vstack(all_x)                                                     
  dX_data = np.vstack(all_dx)                                                   
  num_samples, num_vars = X_data.shape                                          
                                                                                
  # Library building using more efficient numpy operations                      
  library_cols = [X_data[:, i] for i in range(num_vars)]                        
  library_names = [f"x[{i+1}]" for i in range(num_vars)]                        
                                                                                
  # Generate quadratic combinations without nested loops if possible, or keep   
  loops minimal                                                                 
  for i in range(num_vars):                                                     
      for j in range(i, num_vars):                                              
          library_cols.append(X_data[:, i] * X_data[:, j])                      
          library_names.append(f"x[{i+1}]*x[{j+1}]")                            
                                                                                
  Theta = np.column_stack(library_cols)                                         
                                                                                
  def fit_sparse(Theta, y, threshold=0.1):                                      
      coef, _, _, _ = np.linalg.lstsq(Theta, y, rcond=None)                     
      for _ in range(5): # Reduced iterations                                   
          mask = np.abs(coef) >= threshold                                      
          if not np.any(mask):                                                  
              coef = np.zeros_like(coef)                                        
              break                                                             
          coef[~mask] = 0                                                       
          coef[mask], _, _, _ = np.linalg.lstsq(Theta[:, mask], y, rcond=None)  
      return coef                                                               
                                                                                
  equations = []                                                                
  for i in range(num_vars):                                                     
      coeffs = fit_sparse(Theta, dX_data[:, i], threshold=0.1)                  
      eq_parts = []                                                             
      for c, name in zip(coeffs, library_names):                                
          if abs(c) > 0.05:                                                     
              sign = "+" if (c > 0 and eq_parts) else ""                        
              eq_parts.append(f"{sign}{c:.3f}*{name}")                          
      eq_str = f"x[{i+1}] = " + (" ".join(eq_parts) if eq_parts else "0")       
      equations.append(eq_str)                                                  
                                                                                
  for eq in equations:                                                          
      print(eq)                                                                 
