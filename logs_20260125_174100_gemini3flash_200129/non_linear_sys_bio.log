# Use the library and dXdt calculated previously                                
# Recalculate Xi with threshold 0.5 for cleaner equations                       
def stlsq_fixed(Theta, dXdt, threshold=0.5, max_iter=20):                       
    Xi = np.linalg.lstsq(Theta, dXdt, rcond=None)[0]                            
    for _ in range(max_iter):                                                   
        small_indices = np.abs(Xi) < threshold                                  
        Xi[small_indices] = 0                                                   
        for i in range(dXdt.shape[1]):                                          
            big_indices = ~small_indices[:, i]                                  
            if np.any(big_indices):                                             
                Xi[big_indices, i] = np.linalg.lstsq(Theta[:, big_indices],     
dXdt[:, i], rcond=None)[0]                                                      
    return Xi                                                                   
                                                                                
Xi_refined = stlsq_fixed(Theta, dXdt_all, threshold=0.5)                        
                                                                                
