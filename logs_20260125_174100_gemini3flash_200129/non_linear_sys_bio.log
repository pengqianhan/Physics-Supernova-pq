import numpy as np                                                              
                                                                                
# List of data files                                                            
data_files = ['data_all/non_linear/sys_bio/sample_0.npz',                       
              'data_all/non_linear/sys_bio/sample_1.npz',                       
              'data_all/non_linear/sys_bio/sample_2.npz']                       
                                                                                
dt = 0.001                                                                      
X_all = []                                                                      
dX_dt_all = []                                                                  
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    state = data['state'] # (9, 10001)                                          
                                                                                
    # x[t]                                                                      
    x_t = state[:, :-1].T # (10000, 9)                                          
    # x[t+dt]                                                                   
    x_t_plus_dt = state[:, 1:].T # (10000, 9)                                   
                                                                                
    # dx/dt = (x[t+dt] - x[t]) / dt                                             
    dx_dt = (x_t_plus_dt - x_t) / dt                                            
                                                                                
    X_all.append(x_t)                                                           
    dX_dt_all.append(dx_dt)                                                     
                                                                                
# Combine all samples                                                           
X_data = np.vstack(X_all) # (N, 9)                                              
dX_dt_data = np.vstack(dX_dt_all) # (N, 9)                                      
                                                                                
# Augment X with a column of ones for intercept B                               
X_augmented = np.column_stack([X_data, np.ones(X_data.shape[0])])               
                                                                                
# Solve for coefficients using least squares: (A_i1, ..., A_i9, B_i)            
# We can solve for all variables at once                                        
# dX_dt_data = X_augmented @ Coefficients.T                                     
# Coefficients will be of shape (9, 10)                                         
coefficients, residuals, rank, s = np.linalg.lstsq(X_augmented, dX_dt_data,     
rcond=None)                                                                     
