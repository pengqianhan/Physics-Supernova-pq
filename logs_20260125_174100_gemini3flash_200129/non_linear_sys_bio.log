  import numpy as np                                                            
                                                                                
  # Parameters                                                                  
  dt = 0.001                                                                    
  num_vars = 9                                                                  
                                                                                
  # Load data                                                                   
  X_all = []                                                                    
  dX_all = []                                                                   
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      state = data['state']                                                     
      x = state[:, :-1].T                                                       
      dx = (state[:, 1:] - state[:, :-1]) / dt                                  
      dx = dx.T                                                                 
      X_all.append(x)                                                           
      dX_all.append(dx)                                                         
                                                                                
  X = np.vstack(X_all)                                                          
  dX = np.vstack(dX_all)                                                        
                                                                                
  # Feature names                                                               
  feature_names = [f"x{i+1}" for i in range(num_vars)]                          
  X_nonlin = X.copy()                                                           
                                                                                
  # Add squares                                                                 
  for i in range(num_vars):                                                     
      X_nonlin = np.column_stack([X_nonlin, X[:, i]**2])                        
      feature_names.append(f"x{i+1}^2")                                         
                                                                                
  # Add cross products                                                          
  for i in range(num_vars):                                                     
      for j in range(i+1, num_vars):                                            
          X_nonlin = np.column_stack([X_nonlin, X[:, i] * X[:, j]])             
          feature_names.append(f"x{i+1}*x{j+1}")                                
                                                                                
  feature_names.append("1") # Constant term                                     
                                                                                
  def fit_and_report(X_feat, target, names):                                    
      X_aug = np.column_stack([X_feat, np.ones(X_feat.shape[0])])               
      coeffs, residuals, rank, s = np.linalg.lstsq(X_aug, target, rcond=None)   
                                                                                
      y_pred = np.dot(X_aug, coeffs)                                            
      ss_res = np.sum((target - y_pred)**2)                                     
      ss_tot = np.sum((target - np.mean(target))**2)                            
      r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else 1.0                        
                                                                                
      # Filter small coefficients for clarity                                   
      significant_terms = []                                                    
      for c, name in zip(coeffs, names):                                        
          if abs(c) > 0.01: # Threshold for significance                        
              significant_terms.append((c, name))                               
                                                                                
      return r2, significant_terms                                              
                                                                                
  print("Nonlinear Model Results:")                                             
  for i in range(num_vars):                                                     
      r2, terms = fit_and_report(X_nonlin, dX[:, i], feature_names)             
      eq_parts = [f"({c:+.4f})*{name}" if name != "1" else f"({c:+.4f})" for    
  c, name in terms]                                                             
      print(f"dx{i+1}/dt (R2={r2:.4f}): {' '.join(eq_parts)}")                  
