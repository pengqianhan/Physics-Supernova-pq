    data = np.load(path)                                                        
    state = data['state'] # (9, T)                                              
                                                                                
    # Central difference for internal points                                    
    # dx/dt[t] = (x[t+1] - x[t-1]) / (2*dt)                                     
    # For t=0: (x[1]-x[0])/dt                                                   
    # For t=T-1: (x[T-1]-x[T-2])/dt                                             
                                                                                
    T = state.shape[1]                                                          
    dXdt = np.zeros_like(state)                                                 
    dXdt[:, 1:-1] = (state[:, 2:] - state[:, :-2]) / (2*dt)                     
    dXdt[:, 0] = (state[:, 1] - state[:, 0]) / dt                               
    dXdt[:, -1] = (state[:, -1] - state[:, -2]) / dt                            
                                                                                
    all_X.append(state.T)                                                       
    all_dXdt.append(dXdt.T)                                                     
                                                                                
X_total = np.vstack(all_X)                                                      
