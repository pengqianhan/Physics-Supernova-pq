  dt = 1.0                                                                      
                                                                                
  X_mode1_all = []                                                              
  Y_mode1_all = []                                                              
  X_mode2_all = []                                                              
  Y_mode2_all = []                                                              
                                                                                
  for states in states_list:                                                    
      n_steps = states.shape[1]                                                 
      # Compute derivatives using central difference for better accuracy,       
      # but the task suggests np.diff(xi)/dt.                                   
      # Let's follow the task: dxi = (x[i+1] - x[i]) / dt                       
      # Features (state at time t) and Targets (derivative at time t)           
                                                                                
      # x1 is at index 0                                                        
      x1_traj = states[0, :]                                                    
                                                                                
      # Calculate derivatives                                                   
      diff_states = (states[:, 1:] - states[:, :-1]) / dt                       
      # Correlating derivatives with state at time t                            
      state_at_t = states[:, :-1]                                               
                                                                                
      # Partition based on x1                                                   
      mode1_indices = np.where(state_at_t[0, :] < 1.5)[0]                       
      mode2_indices = np.where(state_at_t[0, :] >= 1.5)[0]                      
                                                                                
      if len(mode1_indices) > 0:                                                
          X_mode1_all.append(state_at_t[:, mode1_indices].T)                    
          Y_mode1_all.append(diff_states[:, mode1_indices].T)                   
      if len(mode2_indices) > 0:                                                
          X_mode2_all.append(state_at_t[:, mode2_indices].T)                    
          Y_mode2_all.append(diff_states[:, mode2_indices].T)                   
                                                                                
  # Concatenate all data points                                                 
  X1 = np.vstack(X_mode1_all)                                                   
  Y1 = np.vstack(Y_mode1_all)                                                   
  X2 = np.vstack(X_mode2_all)                                                   
  Y2 = np.vstack(Y_mode2_all)                                                   
                                                                                
  def solve_linear_ode(X, Y):                                                   
      # Solve Y = X*A^T + b^T => Y = [X 1] * [A b]^T                            
      X_aug = np.column_stack([X, np.ones(X.shape[0])])                         
