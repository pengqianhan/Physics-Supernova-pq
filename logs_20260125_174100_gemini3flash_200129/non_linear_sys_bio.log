import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
def solve():                                                                    
    dt = 0.001                                                                  
    X_list = []                                                                 
    Y_list = []                                                                 
                                                                                
    # Load and process data                                                     
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        states = data['state'] # Shape (T, 9)                                   
                                                                                
        # Finite difference for derivatives                                     
        derivs = (states[1:] - states[:-1]) / dt                                
        inputs = states[:-1]                                                    
                                                                                
        X_list.append(inputs)                                                   
        Y_list.append(derivs)                                                   
                                                                                
    X_all = np.vstack(X_list)                                                   
    Y_all = np.vstack(Y_list)                                                   
                                                                                
    num_vars = 9                                                                
    features = []                                                               
    feature_names = []                                                          
                                                                                
    # 1. Bias                                                                   
    features.append(np.ones((X_all.shape[0], 1)))                               
    feature_names.append('1')                                                   
                                                                                
    # 2. Linear terms                                                           
    for i in range(num_vars):                                                   
        features.append(X_all[:, i:i+1])                                        
        feature_names.append(f'x{i+1}[0]')                                      
                                                                                
    # 3. Quadratic terms                                                        
    for i in range(num_vars):                                                   
        for j in range(i, num_vars):                                            
            features.append((X_all[:, i] * X_all[:, j]).reshape(-1, 1))         
            feature_names.append(f'x{i+1}[0]*x{j+1}[0]' if i != j else          
f'x{i+1}[0]**2')                                                                
                                                                                
    Phi = np.concatenate(features, axis=1)                                      
                                                                                
    results = {}                                                                
    equations = {}                                                              
                                                                                
    for i in range(num_vars):                                                   
        y = Y_all[:, i]                                                         
        model = LinearRegression().fit(Phi, y)                                  
        coefs = model.coef_                                                     
        intercept = model.intercept_                                            
                                                                                
        # Combine intercept into bias term if needed (LinearRegression separates
it)                                                                             
        # But we included a column of 1s, so coefs[0] is bias if we set         
fit_intercept=False                                                             
        # Let's re-fit with fit_intercept=False to simplify mapping             
        model = LinearRegression(fit_intercept=False).fit(Phi, y)               
        coefs = model.coef_                                                     
                                                                                
        terms = []                                                              
        for val, name in zip(coefs, feature_names):                             
            if abs(val) > 1e-3:                                                 
                terms.append(f"{val:.4f}*{name}")                               
                                                                                
        eq_str = f"x{i+1}[1] = " + (" + ".join(terms) if terms else "0")        
        # Replace "+ -" with "- " for cleaner look                              
        eq_str = eq_str.replace("+ -", "- ")                                    
        equations[f'x{i+1}'] = eq_str                                           
                                                                                
        # Check fit quality                                                     
        r2 = model.score(Phi, y)                                                
        results[f'x{i+1}_r2'] = r2                                              
                                                                                
    print(f"Equations: {equations}")                                            
    print(f"R2 Scores: {results}")                                              
                                                                                
solve()                                                                         
                                                                                
