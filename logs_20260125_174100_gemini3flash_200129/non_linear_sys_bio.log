import numpy as np                                                              
                                                                                
def solve():                                                                    
    dt = 0.001                                                                  
    X_list = []                                                                 
    Y_list = []                                                                 
                                                                                
    # Load and process data from all files                                      
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        states = data['state']                                                  
                                                                                
        # Adjust shape if necessary (expecting (T, 9))                          
        if states.shape[0] == 9 and states.shape[1] > 9:                        
            states = states.T                                                   
                                                                                
        derivs = (states[1:] - states[:-1]) / dt                                
        inputs = states[:-1]                                                    
                                                                                
        X_list.append(inputs)                                                   
        Y_list.append(derivs)                                                   
                                                                                
    X_all = np.vstack(X_list)                                                   
    Y_all = np.vstack(Y_list)                                                   
    num_vars = 9                                                                
                                                                                
    # Build feature library                                                     
    feature_names = ['1']                                                       
    for i in range(num_vars):                                                   
        feature_names.append(f'x{i+1}[0]')                                      
    for i in range(num_vars):                                                   
        for j in range(i, num_vars):                                            
            feature_names.append(f'x{i+1}[0]*x{j+1}[0]' if i != j else          
f'x{i+1}[0]**2')                                                                
                                                                                
    def get_features(X):                                                        
        feats = [np.ones((X.shape[0], 1)), X]                                   
        for i in range(num_vars):                                               
            for j in range(i, num_vars):                                        
                feats.append((X[:, i] * X[:, j]).reshape(-1, 1))                
        return np.concatenate(feats, axis=1)                                    
                                                                                
    Phi = get_features(X_all)                                                   
                                                                                
    equations = {}                                                              
    r2_scores = []                                                              
                                                                                
    for i in range(num_vars):                                                   
        y = Y_all[:, i]                                                         
        # Solve least squares                                                   
        coefs, residuals, rank, s = np.linalg.lstsq(Phi, y, rcond=None)         
                                                                                
        # Thresholding                                                          
        terms = []                                                              
        for val, name in zip(coefs, feature_names):                             
            if abs(val) > 1e-3:                                                 
                rounded_val = round(val, 4)                                     
                if abs(rounded_val) > 1e-3:                                     
                    if name == '1':                                             
                        terms.append(f"{rounded_val:.4f}")                      
                    else:                                                       
                        terms.append(f"{rounded_val:.4f}*{name}")               
                                                                                
        eq_str = f"x{i+1}[1] = " + (" + ".join(terms) if terms else "0")        
        eq_str = eq_str.replace(" + -", " - ")                                  
        equations[f'x{i+1}'] = eq_str                                           
                                                                                
        # Performance check                                                     
        y_pred = np.dot(Phi, coefs)                                             
        res = y - y_pred                                                        
        r2 = 1 - np.var(res) / np.var(y)                                        
        r2_scores.append(r2)                                                    
        print(f"x{i+1} R2: {r2:.6f}, Max Abs Err: {np.max(np.abs(res)):.4f}")   
                                                                                
