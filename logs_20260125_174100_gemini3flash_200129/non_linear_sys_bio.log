  def STLSQ(Theta, dXdt, threshold, max_iter=10):                               
      Xi, _, _, _ = np.linalg.lstsq(Theta, dXdt, rcond=None)                    
      for _ in range(max_iter):                                                 
          small_indices = np.abs(Xi) < threshold                                
          Xi[small_indices] = 0                                                 
          for i in range(Xi.shape[1]):                                          
              big_indices = np.logical_not(small_indices[:, i])                 
              if np.any(big_indices):                                           
                  Xi_temp, _, _, _ = np.linalg.lstsq(Theta[:, big_indices],     
  dXdt[:, i], rcond=None)                                                       
                  Xi[big_indices, i] = Xi_temp                                  
      return Xi                                                                 
                                                                                
