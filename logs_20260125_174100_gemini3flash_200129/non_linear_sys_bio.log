import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import Lasso, LinearRegression                        
                                                                                
# Load the data                                                                 
data_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
                                                                                
all_X = []                                                                      
all_dX = []                                                                     
                                                                                
for path in data_paths:                                                         
    data = np.load(path)                                                        
    # Common keys are 'X' and 'dXdt' or 'X' and 't'                             
    if 'X' in data and 'dX' in data:                                            
        all_X.append(data['X'])                                                 
        all_dX.append(data['dX'])                                               
    elif 'x' in data and 'dx' in data:                                          
        all_X.append(data['x'])                                                 
        all_dX.append(data['dx'])                                               
    else:                                                                       
        # If dX is not provided, we'd need to compute it from X and t           
        X = data['X']                                                           
        t = data['t']                                                           
        dt = t[1] - t[0]                                                        
        dX = np.gradient(X, dt, axis=0)                                         
        all_X.append(X)                                                         
        all_dX.append(dX)                                                       
                                                                                
X_combined = np.vstack(all_X)                                                   
dX_combined = np.vstack(all_dX)                                                 
                                                                                
num_samples, num_vars = X_combined.shape                                        
                                                                                
# Build features: constant, linear, quadratic                                   
features = []                                                                   
feature_names = ['1']                                                           
# Bias                                                                          
features.append(np.ones((num_samples, 1)))                                      
# Linear                                                                        
for i in range(num_vars):                                                       
    features.append(X_combined[:, i:i+1])                                       
    feature_names.append(f"x{i+1}")                                             
# Quadratic                                                                     
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        features.append((X_combined[:, i] * X_combined[:, j]).reshape(-1, 1))   
        feature_names.append(f"x{i+1}*x{j+1}")                                  
                                                                                
Phi = np.hstack(features)                                                       
                                                                                
# Solve for each dXi/dt                                                         
results = {}                                                                    
for i in range(num_vars):                                                       
    target = dX_combined[:, i]                                                  
    # Use Lasso for sparse identification or LinearRegression if simple         
    model = LinearRegression()                                                  
    model.fit(Phi, target)                                                      
    coefs = model.coef_                                                         
    intercept = model.intercept_ # Should be handled by '1' feature but         
LinearRegression adds its own if fit_intercept=True                             
                                                                                
    # Using fit_intercept=False because we have a bias term in Phi              
    model = LinearRegression(fit_intercept=False)                               
    model.fit(Phi, target)                                                      
    coefs = model.coef_                                                         
                                                                                
    # Filter small coefficients                                                 
    significant_terms = []                                                      
    for val, name in zip(coefs, feature_names):                                 
        if abs(val) > 1e-4:                                                     
            significant_terms.append(f"({val:.4f})*{name}")                     
                                                                                
    results[f"x{i+1}"] = " + ".join(significant_terms)                          
                                                                                
# Check for modes: comparing residuals of a single model vs splitting           
# If the error is very low, it's likely a single mode.                          
total_error = 0                                                                 
for i in range(num_vars):                                                       
    target = dX_combined[:, i]                                                  
    model = LinearRegression(fit_intercept=False)                               
    model.fit(Phi, target)                                                      
    preds = model.predict(Phi)                                                  
    mse = np.mean((target - preds)**2)                                          
    total_error += mse                                                          
                                                                                
print("Equations:")                                                             
for var, eq in results.items():                                                 
    print(f"d{var}/dt = {eq}")                                                  
print(f"Mean MSE: {total_error/num_vars}")                                      
                                                                                
                                                                                
