import numpy as np                                                              
                                                                                
def calculate_derivatives(x, dt):                                               
    # Use central differences for points in the middle                          
    dx = np.zeros_like(x)                                                       
    dx[1:-1, :] = (x[2:, :] - x[:-2, :]) / (2 * dt)                             
    # Forward difference at the start                                           
    dx[0, :] = (x[1, :] - x[0, :]) / dt                                         
    # Backward difference at the end                                            
    dx[-1, :] = (x[-1, :] - x[-2, :]) / dt                                      
    return dx                                                                   
                                                                                
# Load data                                                                     
data_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
dt = 0.001                                                                      
                                                                                
X_total = []                                                                    
dX_total = []                                                                   
                                                                                
for path in data_paths:                                                         
    data = np.load(path)                                                        
    # The variable is likely named 'x' based on typical patterns in these tasks 
    x = data['x']                                                               
    X_total.append(x)                                                           
    dX_total.append(calculate_derivatives(x, dt))                               
                                                                                
X = np.vstack(X_total)                                                          
dX = np.vstack(dX_total)                                                        
                                                                                
# Feature construction                                                          
# Constant (1.0)                                                                
# Linear: x1-x9                                                                 
# x2**2                                                                         
# Cross: x2*x3, x2*x4, x2*x6, x2*x7, x3*x4, x6*x8, x1*x2, x3*x6, x6**2, x2*x8,  
x4*x6                                                                           
feat_names = ["1.0"] + [f"x{i+1}" for i in range(9)] + ["x2**2"]                
feat_cols = [np.ones((X.shape[0], 1))]                                          
for i in range(9):                                                              
    feat_cols.append(X[:, i:i+1])                                               
feat_cols.append((X[:, 1]**2).reshape(-1, 1))                                   
                                                                                
cross_pairs = [                                                                 
    (1, 2), (1, 3), (1, 5), (1, 6), (2, 3), (5, 7),                             
    (0, 1), (2, 5), (5, 5), (1, 7), (3, 5)                                      
]                                                                               
                                                                                
for i, j in cross_pairs:                                                        
    p1, p2 = i + 1, j + 1                                                       
    if i == j:                                                                  
        feat_names.append(f"x{p1}**2")                                          
    else:                                                                       
        feat_names.append(f"x{p1}*x{p2}")                                       
    feat_cols.append((X[:, i] * X[:, j]).reshape(-1, 1))                        
                                                                                
Phi = np.hstack(feat_cols)                                                      
                                                                                
def stlsq(A, b, threshold=0.05, iterations=20):                                 
    # Initial guess with regularization if needed                               
    n_features = A.shape[1]                                                     
    n_targets = b.shape[1]                                                      
    Xi = np.zeros((n_features, n_targets))                                      
                                                                                
    for k in range(n_targets):                                                  
        target = b[:, k]                                                        
        # Robust least squares                                                  
        coef = np.linalg.lstsq(A, target, rcond=1e-3)[0]                        
                                                                                
        for _ in range(iterations):                                             
            small_inds = np.abs(coef) < threshold                               
            coef[small_inds] = 0                                                
            big_inds = ~small_inds                                              
            if not np.any(big_inds):                                            
                break                                                           
            coef[big_inds] = np.linalg.lstsq(A[:, big_inds], target,            
rcond=None)[0]                                                                  
        Xi[:, k] = coef                                                         
    return Xi                                                                   
                                                                                
coefficients = stlsq(Phi, dX, threshold=0.05)                                   
                                                                                
# Generate final equations                                                      
all_eqs = []                                                                    
for i in range(9):                                                              
    eq = f"x{i+1}[1] ="                                                         
