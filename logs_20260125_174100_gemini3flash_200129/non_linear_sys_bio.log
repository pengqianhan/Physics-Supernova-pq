import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the data                                                                 
data = np.load(DATA_FILE_PATH)                                                  
X = data['X']  # Shape (N, 9)                                                   
X_dot = data['X_dot']  # Shape (N, 9)                                           
                                                                                
# Construct feature matrix Theta                                                
# 1. Constant                                                                   
Theta = [np.ones((X.shape[0], 1))]                                              
                                                                                
# 2. Linear terms                                                               
Theta.append(X)                                                                 
                                                                                
# 3. Quadratic terms (xi * xj)                                                  
num_vars = X.shape[1]                                                           
quadratic_names = []                                                            
for i in range(num_vars):                                                       
    for j in range(i, num_vars):                                                
        Theta.append((X[:, i] * X[:, j]).reshape(-1, 1))                        
        quadratic_names.append(f"x{i+1}[0]*x{j+1}[0]" if i != j else            
f"x{i+1}[0]**2")                                                                
                                                                                
Theta = np.hstack(Theta)                                                        
                                                                                
# Feature names mapping                                                         
feature_names = ["1"] + [f"x{i+1}[0]" for i in range(num_vars)] +               
quadratic_names                                                                 
                                                                                
# Perform linear regression for each variable                                   
equations = []                                                                  
non_linear_items_set = set()                                                    
                                                                                
for i in range(num_vars):                                                       
    y = X_dot[:, i]                                                             
    # Solve using least squares                                                 
    coef, _, _, _ = np.linalg.lstsq(Theta, y, rcond=None)                       
                                                                                
    # Filter coefficients with threshold 0.01                                   
    terms = []                                                                  
    for val, name in zip(coef, feature_names):                                  
        if abs(val) >= 0.01:                                                    
            rounded_val = round(val, 3)                                         
            if name == "1":                                                     
                terms.append(f"{rounded_val}")                                  
            else:                                                               
                terms.append(f"{rounded_val}*{name}")                           
                                                                                
            # Identify non-linear items                                         
            if "*" in name or "**" in name:                                     
                non_linear_items_set.add(name)                                  
                                                                                
    eq_str = f"x{i+1}[1] = " + " + ".join(terms).replace("+ -", "- ")           
    equations.append(eq_str)                                                    
                                                                                
final_eqs = ", ".join(equations)                                                
non_linear_items = ", ".join(sorted(list(non_linear_items_set)))                
                                                                                
print(f"Equations: {final_eqs}")                                                
print(f"Non-linear items: {non_linear_items}")                                  
                                                                                
