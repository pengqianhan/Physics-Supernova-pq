import numpy as np                                                              
                                                                                
# Load all data                                                                 
all_X = []                                                                      
all_Y = []                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'] # shape (9, 10001)                                    
                                                                                
    # State at time t                                                           
    X_part = state[:, :-1].T # (10000, 9)                                       
    # Derivative estimate (difference)                                          
    # Assuming dt=1 for the regression target as implied by 'xi[1]' notation,   
    # but the task says "estimate its derivative". I'll use the difference.     
    Y_part = np.diff(state, axis=1).T # (10000, 9)                              
                                                                                
    all_X.append(X_part)                                                        
    all_Y.append(Y_part)                                                        
                                                                                
X_data = np.vstack(all_X)                                                       
Y_data = np.vstack(all_Y)                                                       
                                                                                
n_samples, n_vars = X_data.shape                                                
feature_names = [f'x{i+1}' for i in range(n_vars)]                              
                                                                                
def get_linear_features(X):                                                     
    # Add bias term                                                             
    return np.column_stack([X, np.ones(X.shape[0])])                            
                                                                                
def get_nonlinear_features(X):                                                  
    # Linear terms                                                              
    features = [X]                                                              
    names = [f'x{i+1}' for i in range(n_vars)]                                  
                                                                                
    # Quadratic terms                                                           
    for i in range(n_vars):                                                     
        features.append((X[:, i]**2).reshape(-1, 1))                            
        names.append(f'x{i+1}^2')                                               
                                                                                
    # Interaction terms                                                         
    for i in range(n_vars):                                                     
        for j in range(i + 1, n_vars):                                          
            features.append((X[:, i] * X[:, j]).reshape(-1, 1))                 
            names.append(f'x{i+1}*x{j+1}')                                      
                                                                                
    # Bias term                                                                 
    features.append(np.ones((X.shape[0], 1)))                                   
    names.append('1')                                                           
                                                                                
    return np.column_stack(features), names                                     
                                                                                
equations = []                                                                  
for i in range(n_vars):                                                         
    target = Y_data[:, i]                                                       
                                                                                
    # Try Linear                                                                
    A_lin = get_linear_features(X_data)                                         
    coeffs, residuals, rank, s = np.linalg.lstsq(A_lin, target, rcond=None)     
                                                                                
    predictions = A_lin @ coeffs                                                
    mse = np.mean((target - predictions)**2)                                    
                                                                                
    used_coeffs = coeffs                                                        
    used_names = feature_names + ['1']                                          
                                                                                
    if mse > 1e-4:                                                              
        # Try Non-linear                                                        
        A_nonlin, names_nonlin = get_nonlinear_features(X_data)                 
        coeffs_nonlin, residuals_nonlin, rank_nonlin, s_nonlin =                
np.linalg.lstsq(A_nonlin, target, rcond=None)                                   
                                                                                
        predictions_nonlin = A_nonlin @ coeffs_nonlin                           
        mse_nonlin = np.mean((target - predictions_nonlin)**2)                  
                                                                                
        used_coeffs = coeffs_nonlin                                             
        used_names = names_nonlin                                               
        mse = mse_nonlin                                                        
                                                                                
    # Build Equation String                                                     
    eq_parts = []                                                               
    for c, name in zip(used_coeffs, used_names):                                
        if abs(c) > 1e-7:                                                       
            if name == '1':                                                     
                eq_parts.append(f"{c:+.6f}")                                    
            else:                                                               
                eq_parts.append(f"{c:+.6f}*{name}")                             
                                                                                
    eq_str = f"x{i+1}[1] = " + " ".join(eq_parts)                               
    # Clean up the string (remove leading + if exists)                          
    if eq_str.startswith("x" + str(i+1) + "[1] = +"):                           
        eq_str = eq_str.replace("= +", "= ")                                    
                                                                                
    equations.append(eq_str)                                                    
    print(f"Variable x{i+1} Final MSE: {mse}")                                  
                                                                                
for eq in equations:                                                            
    print(eq)                                                                   
                                                                                
                                                                                
