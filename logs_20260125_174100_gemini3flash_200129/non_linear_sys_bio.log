# Build Feature Library                                                         
def build_features(X):                                                          
    n_samples, n_vars = X.shape                                                 
    features = [np.ones((n_samples, 1))] # Bias                                 
    feature_names = ['1']                                                       
                                                                                
    # Linear terms                                                              
    for i in range(n_vars):                                                     
        features.append(X[:, i:i+1])                                            
        feature_names.append(f'x{i+1}')                                         
                                                                                
    # Quadratic terms (xi * xj for i <= j)                                      
    for i in range(n_vars):                                                     
