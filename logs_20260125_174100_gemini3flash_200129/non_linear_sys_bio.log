def compute_derivatives(x, t):                                                  
    dt = t[1] - t[0]                                                            
    return np.gradient(x, dt, axis=0)                                           
                                                                                
def build_library(X):                                                           
    n_samples, n_vars = X.shape                                                 
    # Constant term                                                             
    library = [np.ones((n_samples, 1))]                                         
    # Linear terms                                                              
    library.append(X)                                                           
    # Quadratic terms (optional but often useful in SINDy)                      
    for i in range(n_vars):                                                     
        for j in range(i, n_vars):                                              
            library.append((X[:, i] * X[:, j]).reshape(-1, 1))                  
    return np.hstack(library)                                                   
                                                                                
def stlsq(X, y, threshold, max_iter=10):                                        
    coef = np.linalg.lstsq(X, y, rcond=None)[0]                                 
    for _ in range(max_iter):                                                   
        small_indices = np.abs(coef) < threshold                                
        coef[small_indices] = 0                                                 
        for j in range(y.shape[1]):                                             
            big_indices = np.abs(coef[:, j]) >= threshold                       
            if np.any(big_indices):                                             
                coef[big_indices, j] = np.linalg.lstsq(X[:, big_indices], y[:,  
j], rcond=None)[0]                                                              
    return coef                                                                 
                                                                                
