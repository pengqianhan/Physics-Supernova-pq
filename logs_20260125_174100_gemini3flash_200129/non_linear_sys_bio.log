X_mid = (X[:-1] + X[1:]) / 2.0 # Use midpoint for better accuracy               
                                                                                
def build_glv_library(X, i):                                                    
    # For variable i, gLV terms are x_i and x_i * x_j                           
    n_samples, n_vars = X.shape                                                 
    cols = []                                                                   
    names = []                                                                  
                                                                                
    # x_i term                                                                  
    cols.append(X[:, i:i+1])                                                    
    names.append(f"xi[{i}]")                                                    
                                                                                
    # x_i * x_j terms                                                           
    for j in range(n_vars):                                                     
        cols.append((X[:, i] * X[:, j]).reshape(-1, 1))                         
        names.append(f"xi[{i}]*xi[{j}]")                                        
                                                                                
    return np.hstack(cols), names                                               
                                                                                
def sparse_regression(Y, Phi, threshold=0.1):                                   
    # Standard SINDy step                                                       
    # Use np.linalg.lstsq                                                       
    coef = np.linalg.lstsq(Phi, Y, rcond=None)[0]                               
    for _ in range(10):                                                         
        small_idx = np.abs(coef) < threshold                                    
        coef[small_idx] = 0                                                     
        big_idx = ~small_idx                                                    
        if np.any(big_idx):                                                     
            # Solve restricted problem                                          
            Phi_sub = Phi[:, big_idx]                                           
            coef[big_idx] = np.linalg.lstsq(Phi_sub, Y, rcond=None)[0]          
    return coef                                                                 
                                                                                
