  X2, Y2 = X_all[mask2], Y_all[mask2]                                           
                                                                                
  def fit_ode(X, Y):                                                            
      # Add column of ones for the intercept b                                  
      X_aug = np.column_stack([X, np.ones(X.shape[0])])                         
      # Solve A_aug = (X_aug^T * X_aug)^-1 * X_aug^T * Y                        
      # Coefficients result in (n_features + 1, n_outputs)                      
