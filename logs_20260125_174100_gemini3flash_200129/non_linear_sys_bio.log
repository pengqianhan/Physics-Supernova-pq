import numpy as np                                                              
                                                                                
# Load data                                                                     
data_paths = ['data_all/non_linear/sys_bio/sample_0.npz',                       
'data_all/non_linear/sys_bio/sample_1.npz',                                     
'data_all/non_linear/sys_bio/sample_2.npz']                                     
                                                                                
all_x = []                                                                      
all_dxdt = []                                                                   
dt = 0.001                                                                      
                                                                                
for path in data_paths:                                                         
    data = np.load(path)                                                        
    # The keys are usually 'data' or similar. Let's check keys.                 
    keys = list(data.keys())                                                    
    x = data[keys[0]] # Assuming first key contains the state trajectory        
                                                                                
    # Compute derivative dx/dt using finite differences                         
    # (x[t+1] - x[t]) / dt                                                      
    dxdt = (x[1:] - x[:-1]) / dt                                                
    # Match the shapes of x and dxdt                                            
    x_reduced = x[:-1]                                                          
                                                                                
    all_x.append(x_reduced)                                                     
    all_dxdt.append(dxdt)                                                       
                                                                                
# Concatenate all samples                                                       
X = np.vstack(all_x)                                                            
DXDT = np.vstack(all_dxdt)                                                      
                                                                                
print(f"X shape: {X.shape}")                                                    
print(f"DXDT shape: {DXDT.shape}")                                              
                                                                                
# Define library                                                                
def build_library(X):                                                           
    n_samples, n_vars = X.shape                                                 
    # 1. Constant                                                               
    library = [np.ones((n_samples, 1))]                                         
    feature_names = ["1"]                                                       
                                                                                
    # 2. Linear                                                                 
    for i in range(n_vars):                                                     
        library.append(X[:, i:i+1])                                             
        feature_names.append(f"x{i+1}")                                         
                                                                                
    # 3. Quadratic                                                              
    for i in range(n_vars):                                                     
        library.append((X[:, i]**2).reshape(-1, 1))                             
        feature_names.append(f"x{i+1}^2")                                       
                                                                                
    # 4. Cross terms                                                            
    for i in range(n_vars):                                                     
        for j in range(i + 1, n_vars):                                          
            library.append((X[:, i] * X[:, j]).reshape(-1, 1))                  
            feature_names.append(f"x{i+1}*x{j+1}")                              
                                                                                
    return np.hstack(library), feature_names                                    
                                                                                
Phi, feature_names = build_library(X)                                           
print(f"Library shape: {Phi.shape}")                                            
                                                                                
# Sequential Thresholded Least Squares                                          
def stls(Phi, y, threshold=0.01, max_iter=10):                                  
    coef = np.linalg.lstsq(Phi, y, rcond=None)[0]                               
    for _ in range(max_iter):                                                   
        small_indices = np.abs(coef) < threshold                                
        coef[small_indices] = 0                                                 
        for i in range(y.shape[1]):                                             
            big_indices = ~small_indices[:, i]                                  
            if np.any(big_indices):                                             
                coef[big_indices, i] = np.linalg.lstsq(Phi[:, big_indices], y[:,
i], rcond=None)[0]                                                              
    return coef                                                                 
                                                                                
coefficients = stls(Phi, DXDT)                                                  
                                                                                
# Verify fit with R^2                                                           
def compute_r2(y_true, y_pred):                                                 
    ss_res = np.sum((y_true - y_pred)**2, axis=0)                               
    ss_tot = np.sum((y_true - np.mean(y_true, axis=0))**2, axis=0)              
    return 1 - ss_res / ss_tot                                                  
                                                                                
predictions = Phi @ coefficients                                                
r2_values = compute_r2(DXDT, predictions)                                       
                                                                                
# Output equations and nonlinear terms                                          
nonlinear_terms = []                                                            
equations = []                                                                  
for i in range(DXDT.shape[1]):                                                  
    eq = f"x{i+1}[t] = "                                                        
    terms = []                                                                  
    for j, c in enumerate(coefficients[:, i]):                                  
        if abs(c) > 1e-4:                                                       
            term_str = feature_names[j]                                         
            terms.append(f"{c:.2f} * {term_str}")                               
            if "^2" in term_str or "*" in term_str:                             
                nonlinear_terms.append(term_str)                                
    eq += " + ".join(terms)                                                     
    equations.append(eq)                                                        
                                                                                
unique_nonlinear_terms = sorted(list(set(nonlinear_terms)))                     
                                                                                
print("Equations:")                                                             
for eq in equations:                                                            
    print(eq)                                                                   
print("\nR2 values:", r2_values)                                                
print("\nUnique Nonlinear Terms:", unique_nonlinear_terms)                      
                                                                                
final_answer({                                                                  
    "equations": equations,                                                     
    "r2": r2_values.tolist(),                                                   
    "nonlinear_terms": unique_nonlinear_terms                                   
})                                                                              
                                                                                
