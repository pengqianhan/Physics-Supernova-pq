for i in range(1, 10):                                                          
    for j in range(i, 10):                                                      
        feature_names.append(f'x{i}[0]*x{j}[0]')                                
                                                                                
# Fit models for each dx_i/dt                                                   
models = []                                                                     
equations = []                                                                  
