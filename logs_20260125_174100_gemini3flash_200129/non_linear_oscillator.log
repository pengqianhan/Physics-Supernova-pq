import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
n = len(x1)                                                                     
                                                                                
# Variables for index and features                                              
X = np.stack([x1[:-1], x2[:-1], np.ones(n-1)], axis=1)                          
y1 = x1[1:]                                                                     
y2 = x2[1:]                                                                     
                                                                                
# Find the transition point by minimizing the sum of squared errors             
best_sse = float('inf')                                                         
best_idx = 0                                                                    
                                                                                
# Scan for the switch point                                                     
for i in range(100, n-100, 100):                                                
    # Mode 1                                                                    
    X1, Y2_1 = X[:i], y2[:i]                                                    
    # Mode 2                                                                    
    X2, Y2_2 = X[i:], y2[i:]                                                    
                                                                                
    beta1, _, _, _ = np.linalg.lstsq(X1, Y2_1, rcond=None)                      
    beta2, _, _, _ = np.linalg.lstsq(X2, Y2_2, rcond=None)                      
                                                                                
    sse1 = np.sum((Y2_1 - np.dot(X1, beta1))**2)                                
    sse2 = np.sum((Y2_2 - np.dot(X2, beta2))**2)                                
                                                                                
    if (sse1 + sse2) < best_sse:                                                
        best_sse = sse1 + sse2                                                  
        best_idx = i                                                            
                                                                                
# Refine around best_idx                                                        
for i in range(max(1, best_idx - 100), min(n-1, best_idx + 100)):               
    X1, Y2_1 = X[:i], y2[:i]                                                    
    X2, Y2_2 = X[i:], y2[i:]                                                    
    beta1, _, _, _ = np.linalg.lstsq(X1, Y2_1, rcond=None)                      
    beta2, _, _, _ = np.linalg.lstsq(X2, Y2_2, rcond=None)                      
    sse = np.sum((Y2_1 - np.dot(X1, beta1))**2) + np.sum((Y2_2 - np.dot(X2,     
beta2))**2)                                                                     
    if sse < best_sse:                                                          
        best_sse = sse                                                          
        best_idx = i                                                            
                                                                                
print(f"Refined transition index: {best_idx}")                                  
                                                                                
# Final fit                                                                     
X_m1, y1_m1, y2_m1 = X[:best_idx], y1[:best_idx], y2[:best_idx]                 
X_m2, y1_m2, y2_m2 = X[best_idx:], y1[best_idx:], y2[best_idx:]                 
                                                                                
c1_m1, _, _, _ = np.linalg.lstsq(X_m1, y1_m1, rcond=None)                       
c2_m1, _, _, _ = np.linalg.lstsq(X_m1, y2_m1, rcond=None)                       
c1_m2, _, _, _ = np.linalg.lstsq(X_m2, y1_m2, rcond=None)                       
c2_m2, _, _, _ = np.linalg.lstsq(X_m2, y2_m2, rcond=None)                       
                                                                                
print(f"Mode 1 x1 coeffs: {c1_m1}")                                             
print(f"Mode 1 x2 coeffs: {c2_m1}")                                             
print(f"Mode 2 x1 coeffs: {c1_m2}")                                             
print(f"Mode 2 x2 coeffs: {c2_m2}")                                             
print(f"Guard state: x1={x1[best_idx]}, x2={x2[best_idx]}")                     
                                                                                
