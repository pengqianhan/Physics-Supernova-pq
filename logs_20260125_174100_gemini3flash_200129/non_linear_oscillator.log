    err1 = np.sum((y1 - pred1)**2)                                              
                                                                                
    # Mode 2                                                                    
    A2 = np.column_stack([x1_k[mask2], x2_k[mask2], ones[mask2]])               
    y2 = dx2[mask2]                                                             
    res2 = np.linalg.lstsq(A2, y2, rcond=None)                                  
    c2 = res2[0]                                                                
    pred2 = np.dot(A2, c2)                                                      
    err2 = np.sum((y2 - pred2)**2)                                              
                                                                                
    total_error = err1 + err2                                                   
    if total_error < min_total_error:                                           
