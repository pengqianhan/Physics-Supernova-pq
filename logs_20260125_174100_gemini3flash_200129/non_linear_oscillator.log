          x_k = states[:, :-1]                                                  
          x_next = states[:, 1:]                                                
          # Concatenate to get (N, 4) where columns are x1_k, x2_k, x1_next,    
  x2_next                                                                       
          trans = np.vstack([x_k, x_next]).T                                    
          transitions.append(trans)                                             
      return np.concatenate(transitions, axis=0)                                
                                                                                
  transitions = get_transitions(all_states)                                     
                                                                                
  def fit_mode(data):                                                           
      if len(data) == 0:                                                        
          return None, None, None, 0                                            
      # Equation: x2_next = a21 * x1_k + a22 * x2_k + b2                        
      # Target: y = x2_next (column 3)                                          
