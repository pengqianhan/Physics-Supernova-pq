import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dt = 0.001                                                                  
    dx2 = np.gradient(x2, dt)                                                   
                                                                                
    # Use the second derivative to find the switch                              
    ddx2 = np.gradient(dx2, dt)                                                 
    idx = np.argmax(np.abs(ddx2))                                               
                                                                                
    # Refine idx by looking at where the error of a linear fit jumps            
    # But usually argmax of ddx2 is a good indicator of the switch in a hybrid  
system                                                                          
                                                                                
    # Segment 1: x1 < threshold                                                 
    # Segment 2: x1 >= threshold                                                
    # The transition happens at index idx.                                      
    # Let's take segments slightly away from the transition to get clean        
estimates.                                                                      
    # Mode 1: 0 to idx-5                                                        
    # Mode 2: idx+5 to end                                                      
                                                                                
    def get_coeffs(indices):                                                    
        X = np.stack([x1[indices], x2[indices], np.ones_like(x1[indices])],     
axis=1)                                                                         
        y = dx2[indices]                                                        
        coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)          
        return coeffs                                                           
                                                                                
    c1 = get_coeffs(slice(0, max(0, idx-10)))                                   
    c2 = get_coeffs(slice(idx+10, len(x1)))                                     
                                                                                
    threshold = x1[idx]                                                         
                                                                                
    # Check for reset: check if x1 or x2 jumps at idx                           
    # A jump would be visible in the state itself                               
    reset_x1 = x1[idx+1] - x1[idx]                                              
    reset_x2 = x2[idx+1] - x2[idx]                                              
                                                                                
    return {                                                                    
        'idx': idx,                                                             
        'time': idx * dt,                                                       
        'threshold': threshold,                                                 
        'coeffs1': c1,                                                          
        'coeffs2': c2,                                                          
        'reset': (reset_x1, reset_x2)                                           
    }                                                                           
                                                                                
