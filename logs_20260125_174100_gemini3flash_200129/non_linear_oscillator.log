def find_switch_time(x1, x2, dx2):                                              
    best_split = 0                                                              
    min_error = float('inf')                                                    
    # Try splits every 100 points                                               
    for split in range(1000, 9000, 100):                                        
        # Mode 1                                                                
        A1 = np.vstack([x1[:split], x2[:split], np.ones(split)]).T              
        y1 = dx2[:split]                                                        
        res1 = np.linalg.lstsq(A1, y1, rcond=None)[0]                           
        err1 = np.sum((y1 - A1 @ res1)**2)                                      
                                                                                
        # Mode 2                                                                
        A2 = np.vstack([x1[split:], x2[split:], np.ones(len(x1)-split)]).T      
        y2 = dx2[split:]                                                        
        res2 = np.linalg.lstsq(A2, y2, rcond=None)[0]                           
        err2 = np.sum((y2 - A2 @ res2)**2)                                      
                                                                                
        if err1 + err2 < min_error:                                             
            min_error = err1 + err2                                             
            best_split = split                                                  
    return best_split                                                           
                                                                                
