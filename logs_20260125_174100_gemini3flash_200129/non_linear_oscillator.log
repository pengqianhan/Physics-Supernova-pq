import numpy as np                                                              
                                                                                
def find_best_switch(x1, x2):                                                   
    n = len(x1) - 1                                                             
    X = np.stack([x1[:-1], x2[:-1], np.ones(n)], axis=1)                        
    y1 = x1[1:]                                                                 
    y2 = x2[1:]                                                                 
                                                                                
    best_err = float('inf')                                                     
    best_t = 0                                                                  
                                                                                
    # Try different switch points                                               
    for t in range(100, n - 100, 500):                                          
        # Mode 1: 0 to t                                                        
        # Mode 2: t to n                                                        
        # Fit Mode 1                                                            
        X1, Y1 = X[:t], y2[:t]                                                  
        X2, Y2 = X[t:], y2[t:]                                                  
                                                                                
        beta1, _, _, _ = np.linalg.lstsq(X1, Y1, rcond=None)                    
        beta2, _, _, _ = np.linalg.lstsq(X2, Y2, rcond=None)                    
                                                                                
        err1 = np.sum((Y1 - np.dot(X1, beta1))**2)                              
        err2 = np.sum((Y2 - np.dot(X2, beta2))**2)                              
                                                                                
        if (err1 + err2) < best_err:                                            
            best_err = err1 + err2                                              
            best_t = t                                                          
                                                                                
    return best_t                                                               
                                                                                
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
st = data['state']                                                              
