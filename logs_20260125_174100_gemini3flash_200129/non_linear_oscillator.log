│   "properties": {                                                            │
│     "automaton": {                                                           │
│       "type": "object",                                                      │
│       "description": "The hybrid automaton definition with variables, modes, │
│ and transitions",                                                            │
│       "required": [                                                          │
│         "var",                                                               │
│         "mode",                                                              │
│         "edge"                                                               │
│       \],                                                                    │
│       "properties": {                                                        │
│         "var": {                                                             │
│           "type": "string",                                                  │
│           "description": "Comma-separated list of state variable names       │
│ (e.g., 'x1' or 'x1, x2')",                                                   │
│           "pattern":                                                         │
│ "^[a-zA-Z_\][a-zA-Z0-9_\]*(\\s*,\\s*[a-zA-Z_\][a-zA-Z0-9_\]*)*$",            │
│           "minLength": 1,                                                    │
│           "examples": [                                                      │
│             "x1",                                                            │
│             "x1, x2",                                                        │
│             "x, y, z"                                                        │
│           \]                                                                 │
│         },                                                                   │
│         "input": {                                                           │
│           "type": "string",                                                  │
│           "description": "Comma-separated list of input variable names       │
│ (e.g., 'u1' or 'u1, u2'). Empty string if no inputs.",                       │
│           "pattern":                                                         │
│ "^([a-zA-Z_\][a-zA-Z0-9_\]*(\\s*,\\s*[a-zA-Z_\][a-zA-Z0-9_\]*)*)?$",         │
│           "default": "",                                                     │
│           "examples": [                                                      │
