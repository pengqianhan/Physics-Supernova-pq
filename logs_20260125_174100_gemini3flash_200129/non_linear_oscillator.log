import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
state = data['state'] # Shape (2, 10001)                                        
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Prepare features and targets                                                  
# x1[k+1] = a*x1[k] + b*x2[k] + c                                               
# x2[k+1] = d*x1[k] + e*x2[k] + f                                               
X = np.stack([x1[:-1], x2[:-1]], axis=1)                                        
y1 = x1[1:]                                                                     
y2 = x2[1:]                                                                     
                                                                                
# Detect transition point using a sliding window or residuals of a global fit   
# Let's try to see where the system stops behaving like the first part          
# Or simply check where the behavior changes drastically.                       
# Often in these tasks, a simple change in state or derivative is visible.      
                                                                                
residuals = []                                                                  
for i in range(10, 9990, 10):                                                   
    # Fit on a small window and check next point error                          
    reg = LinearRegression().fit(X[i-10:i], y2[i-10:i])                         
    pred = reg.predict(X[i:i+1])                                                
    residuals.append(np.abs(pred - y2[i])[0])                                   
                                                                                
# Find the index where residual spikes                                          
transition_index = np.argmax(residuals) * 10 + 10                               
print(f"Detected transition index: {transition_index}")                         
                                                                                
# Verify transition index by looking at the data values                         
print(f"Value at transition: x1={x1[transition_index]},                         
x2={x2[transition_index]}")                                                     
                                                                                
# Split data into two modes                                                     
X_m1, y1_m1, y2_m1 = X[:transition_index], y1[:transition_index],               
y2[:transition_index]                                                           
X_m2, y1_m2, y2_m2 = X[transition_index:], y1[transition_index:],               
y2[transition_index:]                                                           
                                                                                
def fit_mode(X_m, y1_m, y2_m):                                                  
    reg1 = LinearRegression().fit(X_m, y1_m)                                    
    reg2 = LinearRegression().fit(X_m, y2_m)                                    
    return (reg1.coef_[0], reg1.coef_[1], reg1.intercept_), (reg2.coef_[0],     
reg2.coef_[1], reg2.intercept_)                                                 
                                                                                
coeffs1_m1, coeffs2_m1 = fit_mode(X_m1, y1_m1, y2_m1)                           
coeffs1_m2, coeffs2_m2 = fit_mode(X_m2, y1_m2, y2_m2)                           
                                                                                
print("Mode 1 Coeffs (x1):", coeffs1_m1)                                        
print("Mode 1 Coeffs (x2):", coeffs2_m1)                                        
print("Mode 2 Coeffs (x1):", coeffs1_m2)                                        
print("Mode 2 Coeffs (x2):", coeffs2_m2)                                        
                                                                                
# Determine guard (look at the state at the transition point)                   
print(f"Guard check: x1[{transition_index-1}]={x1[transition_index-1]},         
x2[{transition_index-1}]={x2[transition_index-1]}")                             
print(f"Guard check: x1[{transition_index}]={x1[transition_index]},             
x2[{transition_index}]={x2[transition_index]}")                                 
                                                                                
