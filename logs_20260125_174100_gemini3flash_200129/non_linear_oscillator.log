# Load the data file                                                            
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
state = data['state']                                                           
input_data = data['input']                                                      
                                                                                
# Correcting orientation: state should be (N, 2)                                
if state.shape[0] == 2:                                                         
    state = state.T                                                             
                                                                                
x1 = state[:, 0]                                                                
x2 = state[:, 1]                                                                
                                                                                
# Check input_data for time information                                         
# If input_data is a sequence like 0, dt, 2dt..., it's likely time.             
# Otherwise, we'll assume a dt.                                                 
dt = 0.01                                                                       
if input_data.shape[1] == len(x1):                                              
    diffs = np.diff(input_data[0])                                              
    if np.allclose(diffs, diffs[0]):                                            
        dt = diffs[0]                                                           
        print(f"Detected dt from input: {dt}")                                  
                                                                                
# Compute derivatives                                                           
dx1 = np.gradient(x1, dt)                                                       
dx2 = np.gradient(x2, dt)                                                       
                                                                                
# Identify switching point                                                      
# A change in the derivative of x2 (acceleration) often indicates a switch in   
oscillators.                                                                    
ddx2 = np.abs(np.diff(dx2))                                                     
# Use a threshold or find the maximum jump                                      
switch_idx = np.argmax(ddx2) + 1                                                
                                                                                
print(f"Switching index: {switch_idx}")                                         
print(f"Switching time (approx): {switch_idx * dt}")                            
print(f"State at switch: x1={x1[switch_idx]:.4f}, x2={x2[switch_idx]:.4f}")     
                                                                                
# Segment 1 (Mode 1)                                                            
X1 = state[:switch_idx]                                                         
Y1 = np.column_stack([dx1[:switch_idx], dx2[:switch_idx]])                      
X1_b = np.column_stack([X1, np.ones(len(X1))])                                  
beta1, _, _, _ = np.linalg.lstsq(X1_b, Y1, rcond=None)                          
                                                                                
# Segment 2 (Mode 2)                                                            
X2 = state[switch_idx:]                                                         
Y2 = np.column_stack([dx1[switch_idx:], dx2[switch_idx:]])                      
X2_b = np.column_stack([X2, np.ones(len(X2))])                                  
beta2, _, _, _ = np.linalg.lstsq(X2_b, Y2, rcond=None)                          
                                                                                
