│                 "direction": "2 -> 1",                                       │
│                 "condition": "x1 <= 9"                                       │
│             }                                                                │
│         \]                                                                   │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.01,                                                          │
│         "total_time": 20.0,                                                  │
│         "order": 1,                                                          │
│         "need_reset": false,                                                 │
│         "non_linear_items": ""                                               │
│     }                                                                        │
│ }                                                                            │
│ ```                                                                          │
│                                                                              │
│ **With reset map:**                                                          │
│ ```json                                                                      │
│ {                                                                            │
│     "automaton": {                                                           │
│         "var": "x1, x2",                                                     │
│         "input": "u1",                                                       │
│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
