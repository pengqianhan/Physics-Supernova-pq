p[2])))                                                                         
                                                                                
res1 = minimize(obj1, [-41.0069, -15.4754, 0.6538], method='Nelder-Mead',       
tol=1e-8)                                                                       
c1, c2, b1 = res1.x                                                             
                                                                                
# Mode 2: indices 158 to end                                                    
y2 = (x2[idx_switch+1:] - x2[idx_switch:-1]) / dt                               
# Fitting without bias as suggested                                             
X2 = np.column_stack((x1[idx_switch:-1], x2[idx_switch:-1]))                    
c3, c4 = np.linalg.lstsq(X2, y2, rcond=None)[0]                                 
                                                                                
print(f"Mode 1: c1={c1:.4f}, c2={c2:.4f}, bias={b1:.4f}")                       
print(f"Mode 2: c3={c3:.4f}, c4={c4:.4f}, bias=0")                              
print(f"Threshold: {x1[idx_switch]:.4f}")                                       
                                                                                
