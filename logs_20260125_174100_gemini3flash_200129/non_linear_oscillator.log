coeffs1_dx2, _ = get_coeffs_and_res(x1_s[mask1], x2_s[mask1], dx2_dt[mask1])    
coeffs2_dx1, _ = get_coeffs_and_res(x1_s[mask2], x2_s[mask2], dx1_dt[mask2])    
coeffs2_dx2, _ = get_coeffs_and_res(x1_s[mask2], x2_s[mask2], dx2_dt[mask2])    
                                                                                
print("\nMode 1 (x1 < {:.6f}):".format(best_th))                                
print("dx1/dt: k1={:.10f}, k2={:.10f}, b1={:.10f}".format(*coeffs1_dx1))        
print("dx2/dt: k3={:.10f}, k4={:.10f}, b2={:.10f}".format(*coeffs1_dx2))        
                                                                                
print("\nMode 2 (x1 >= {:.6f}):".format(best_th))                               
print("dx1/dt: k1={:.10f}, k2={:.10f}, b1={:.10f}".format(*coeffs2_dx1))        
print("dx2/dt: k3={:.10f}, k4={:.10f}, b2={:.10f}".format(*coeffs2_dx2))        
                                                                                
