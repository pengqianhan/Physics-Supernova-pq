import numpy as np                                                              
import scipy.linalg                                                             
                                                                                
# Data extraction                                                               
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
state = data['state']                                                           
dt = 0.001                                                                      
                                                                                
# Select range                                                                  
indices = np.arange(0, 158) # 0 to 157                                          
x1 = state[0, indices]                                                          
x2 = state[1, indices]                                                          
# Derivative requires index 158                                                 
x2_next = state[1, 1:159]                                                       
x2_dot = (x2_next - x2) / dt                                                    
                                                                                
# Linear model: x2_dot = a21*x1 + a22*x2 + b2                                   
A_lin = np.column_stack([x1, x2, np.ones_like(x1)])                             
coeffs_lin, residuals_lin, rank_lin, s_lin = np.linalg.lstsq(A_lin, x2_dot,     
rcond=None)                                                                     
a21_lin, a22_lin, b2_lin = coeffs_lin                                           
                                                                                
# Calculate R-squared for linear model                                          
y_pred_lin = A_lin @ coeffs_lin                                                 
ss_res_lin = np.sum((x2_dot - y_pred_lin)**2)                                   
ss_tot = np.sum((x2_dot - np.mean(x2_dot))**2)                                  
r2_lin = 1 - (ss_res_lin / ss_tot)                                              
                                                                                
# Non-linear model: x2_dot = a21*x1 + a22*x2 + b2 + c2*x1^2                     
A_nonlin = np.column_stack([x1, x2, np.ones_like(x1), x1**2])                   
coeffs_nonlin, residuals_nonlin, rank_nonlin, s_nonlin =                        
np.linalg.lstsq(A_nonlin, x2_dot, rcond=None)                                   
a21_nonlin, a22_nonlin, b2_nonlin, c2_nonlin = coeffs_nonlin                    
                                                                                
# Calculate R-squared for non-linear model                                      
y_pred_nonlin = A_nonlin @ coeffs_nonlin                                        
ss_res_nonlin = np.sum((x2_dot - y_pred_nonlin)**2)                             
r2_nonlin = 1 - (ss_res_nonlin / ss_tot)                                        
                                                                                
print(f"Linear coefficients: a21={a21_lin:.10f}, a22={a22_lin:.10f},            
b2={b2_lin:.10f}")                                                              
print(f"Linear R-squared: {r2_lin:.10f}")                                       
print(f"Non-linear coefficients: a21={a21_nonlin:.10f}, a22={a22_nonlin:.10f},  
b2={b2_nonlin:.10f}, c2={c2_nonlin:.10f}")                                      
print(f"Non-linear R-squared: {r2_nonlin:.10f}")                                
