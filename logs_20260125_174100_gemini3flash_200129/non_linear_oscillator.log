dt = 0.001                                                                      
idx_switch = 158                                                                
                                                                                
# Mode 1: indices 0 to 157                                                      
y1 = (x2[1:idx_switch+1] - x2[:idx_switch]) / dt                                
def obj1(p):                                                                    
