# Let's check the residuals for Mode 1 fit across samples                       
def check_residuals(file_path, coeffs_m2):                                      
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dt = 0.001                                                                  
    dx2 = np.gradient(x2, dt)                                                   
    ddx2 = np.gradient(dx2, dt)                                                 
    idx = int(np.argmax(np.abs(ddx2)))                                          
                                                                                
    # Check Mode 2 (stable)                                                     
    seg2_x1 = x1[idx+20:]                                                       
    seg2_x2 = x2[idx+20:]                                                       
    seg2_dx2 = dx2[idx+20:]                                                     
    pred2 = coeffs_m2[0]*seg2_x1 + coeffs_m2[1]*seg2_x2 + coeffs_m2[2]          
    res2 = np.mean(np.abs(seg2_dx2 - pred2))                                    
                                                                                
    # Check Mode 1 (varying)                                                    
    # Maybe there's a constant acceleration or something else?                  
    # Let's see if Mode 1 is just different constants for each sample or a      
pattern.                                                                        
    seg1_x1 = x1[:idx-20]                                                       
    seg1_x2 = x2[:idx-20]                                                       
    seg1_dx2 = dx2[:idx-20]                                                     
    # Local fit for this sample                                                 
    X = np.stack([seg1_x1, seg1_x2, np.ones_like(seg1_x1)], axis=1)             
    c1_local, _, _, _ = np.linalg.lstsq(X, seg1_dx2, rcond=None)                
    pred1 = c1_local[0]*seg1_x1 + c1_local[1]*seg1_x2 + c1_local[2]             
    res1 = np.mean(np.abs(seg1_dx2 - pred1))                                    
                                                                                
    return res1, res2, c1_local                                                 
                                                                                
