  print("dx2/dt: k3={:.10f}, k4={:.10f}, b2={:.10f}".format(*coeffs1_dx2))      
                                                                                
  print("\nMode 2 (x1 >= {:.6f}):".format(best_th))                             
  print("dx1/dt: k1={:.10f}, k2={:.10f}, b1={:.10f}".format(*coeffs2_dx1))      
  print("dx2/dt: k3={:.10f}, k4={:.10f}, b2={:.10f}".format(*coeffs2_dx2))      
                                                                                
