# Load data                                                                     
data_0 = np.load('data_all/non_linear/oscillator/sample_0.npz')                 
data_1 = np.load('data_all/non_linear/oscillator/sample_1.npz')                 
data_2 = np.load('data_all/non_linear/oscillator/sample_2.npz')                 
                                                                                
states = [data_0['state'], data_1['state'], data_2['state']]                    
                                                                                
# Function to find switch point based on change in dx2                          
def find_exact_switch(state):                                                   
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx2 = np.diff(x2)                                                           
    # Looking for a jump in dx2 that is not explained by the previous trend     
    # We saw in Sample 0 it's around index 159.                                 
    # Let's use the difference of differences (second derivative)               
    ddx2 = np.abs(np.diff(dx2))                                                 
    # The index of the jump                                                     
    switch_idx = np.argmax(ddx2) + 1                                            
    return switch_idx                                                           
                                                                                
sw_indices = [find_exact_switch(s) for s in states]                             
                                                                                
print(f"Switch indices: {sw_indices}")                                          
