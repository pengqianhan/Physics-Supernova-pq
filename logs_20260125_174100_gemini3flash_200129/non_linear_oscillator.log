mae2 = np.mean(np.abs(dx1_dt[mask2] - x2_s[mask2]))                             
print(f"\nMAE(dx1/dt, x2) Mode 1: {mae1:.10f}")                                 
print(f"MAE(dx1/dt, x2) Mode 2: {mae2:.10f}")                                   
                                                                                
