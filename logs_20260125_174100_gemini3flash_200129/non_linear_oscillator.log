  mask2 = ~mask1                                                                
                                                                                
  coeffs1_dx1, _ = get_coeffs_and_res(x1_s[mask1], x2_s[mask1], dx1_dt[mask1])  
  coeffs1_dx2, _ = get_coeffs_and_res(x1_s[mask1], x2_s[mask1], dx2_dt[mask1])  
  coeffs2_dx1, _ = get_coeffs_and_res(x1_s[mask2], x2_s[mask2], dx1_dt[mask2])  
