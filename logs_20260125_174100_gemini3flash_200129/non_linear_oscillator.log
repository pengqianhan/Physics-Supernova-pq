  coeffs_lin, _, _, _ = np.linalg.lstsq(A_lin, x2_dot, rcond=None)              
  a21_lin, a22_lin, b2_lin = coeffs_lin                                         
                                                                                
  # Calculate R-squared for Linear Fit                                          
  y_pred_lin = np.dot(A_lin, coeffs_lin)                                        
  ss_res_lin = np.sum((x2_dot - y_pred_lin)**2)                                 
  ss_tot = np.sum((x2_dot - np.mean(x2_dot))**2)                                
  r2_lin = 1 - (ss_res_lin / ss_tot)                                            
                                                                                
  # Non-linear Fit: x2_dot = a21*x1 + a22*x2 + b2 + c2*x1^2                     
  A_nl = np.column_stack([x1, x2, np.ones_like(x1), x1**2])                     
  coeffs_nl, _, _, _ = np.linalg.lstsq(A_nl, x2_dot, rcond=None)                
  a21_nl, a22_nl, b2_nl, c2_nl = coeffs_nl                                      
                                                                                
  # Calculate R-squared for Non-linear Fit                                      
  y_pred_nl = np.dot(A_nl, coeffs_nl)                                           
  ss_res_nl = np.sum((x2_dot - y_pred_nl)**2)                                   
  r2_nl = 1 - (ss_res_nl / ss_tot)                                              
                                                                                
  print(f"Linear Model Results:")                                               
  print(f"a21: {a21_lin:.15f}")                                                 
  print(f"a22: {a22_lin:.15f}")                                                 
  print(f"b2: {b2_lin:.15f}")                                                   
  print(f"R-squared: {r2_lin:.15f}")                                            
  print()                                                                       
  print(f"Non-linear Model Results (with x1^2 term):")                          
  print(f"a21: {a21_nl:.15f}")                                                  
  print(f"a22: {a22_nl:.15f}")                                                  
  print(f"b2: {b2_nl:.15f}")                                                    
  print(f"c2: {c2_nl:.15f}")                                                    
  print(f"R-squared: {r2_nl:.15f}")                                             
  print()                                                                       
  print(f"Improvement (R2_nl - R2_lin): {r2_nl - r2_lin:.15e}")                 
