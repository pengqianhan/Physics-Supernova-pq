    A2 = np.column_stack([X1_curr[mask2], X2_curr[mask2],                       
np.ones(np.sum(mask2))])                                                        
    err += np.sum((dx1[mask2] - A2 @ c1_m2)**2) + np.sum((dx2[mask2] - A2 @     
