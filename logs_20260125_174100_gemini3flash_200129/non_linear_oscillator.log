idx_switch = 158                                                                
                                                                                
def fit_mode(x_subset, x_next_subset, dt):                                      
    # Target: (x2_next - x2_curr) / dt = c1 * x1 + c2 * x2 + bias               
    y_target = (x_next_subset[:, 1] - x_subset[:, 1]) / dt                      
    X = x_subset # x1, x2                                                       
                                                                                
    def objective(params):                                                      
        c1, c2, bias = params                                                   
        y_pred = c1 * X[:, 0] + c2 * X[:, 1] + bias                             
        return np.max(np.abs(y_target - y_pred))                                
                                                                                
    # Initial guess from the prompt or zero                                     
    res = minimize(objective, [0, 0, 0], method='Nelder-Mead')                  
    return res.x, res.fun                                                       
                                                                                
