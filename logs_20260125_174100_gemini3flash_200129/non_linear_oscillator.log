import numpy as np                                                              
                                                                                
def check_consistency(file_path):                                               
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dt = 0.001                                                                  
                                                                                
    # Check if x1' = x2                                                         
    x1_dot = np.gradient(x1, dt)                                                
    error_x1_dot = np.mean(np.abs(x1_dot - x2))                                 
                                                                                
    dx2 = np.gradient(x2, dt)                                                   
    ddx2 = np.gradient(dx2, dt)                                                 
    idx = int(np.argmax(np.abs(ddx2)))                                          
                                                                                
    # Try different buffers to see stability                                    
    def get_c(start, end):                                                      
        if start >= end: return None                                            
        X = np.stack([x1[start:end], x2[start:end],                             
np.ones_like(x1[start:end])], axis=1)                                           
        y = dx2[start:end]                                                      
        c, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                          
        return c                                                                
                                                                                
    c1_b20 = get_c(0, idx - 20)                                                 
    c1_b40 = get_c(0, idx - 40)                                                 
    c2_b20 = get_c(idx + 20, len(x1))                                           
    c2_b40 = get_c(idx + 40, len(x1))                                           
                                                                                
    # Check for reset                                                           
    # Expected x1[idx+1] = x1[idx] + x2[idx]*dt                                 
    # Expected x2[idx+1] = x2[idx] + dx2[idx]*dt                                
    # However, dx2 is discontinuous, so we should check the jump in x1 and x2   
    jump_x1 = x1[idx+1] - x1[idx]                                               
    jump_x2 = x2[idx+1] - x2[idx]                                               
                                                                                
    return {                                                                    
        'error_x1_dot': error_x1_dot,                                           
        'idx': idx,                                                             
        'threshold': x1[idx],                                                   
        'c1_20': c1_b20,                                                        
        'c1_40': c1_b40,                                                        
        'c2_20': c2_b20,                                                        
        'c2_40': c2_b40,                                                        
        'jump_x1': jump_x1,                                                     
        'jump_x2': jump_x2                                                      
    }                                                                           
                                                                                
for i in range(3):                                                              
    print(f"Sample {i} analysis:")                                              
    print(check_consistency(f'data_all/non_linear/oscillator/sample_{i}.npz'))  
                                                                                
