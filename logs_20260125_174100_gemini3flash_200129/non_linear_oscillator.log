# Assuming dx1 = x2 * dt                                                        
dt_estimates = []                                                               
for s in states:                                                                
    dx1 = np.diff(s[0, :])                                                      
    x2 = s[1, :-1]                                                              
    dt_estimates.append(np.mean(dx1 / x2))                                      
dt = np.mean(dt_estimates)                                                      
print(f"Estimated dt: {dt}")                                                    
                                                                                
# Task 4: Linear regression for Mode 1 and Mode 2 across all samples            
# x2' = a*x1 + b*x2 + c                                                         
# dx2/dt = a*x1 + b*x2 + c                                                      
                                                                                
def collect_data(states, sw_indices, mode):                                     
    X1, X2, DX2 = [], [], []                                                    
    for s, sw in zip(states, sw_indices):                                       
        if mode == 1:                                                           
            indices = slice(0, sw)                                              
        else:                                                                   
            indices = slice(sw, -1)                                             
                                                                                
        X1.extend(s[0, indices])                                                
        X2.extend(s[1, indices])                                                
        DX2.extend(np.diff(s[1, :])[indices])                                   
                                                                                
    return np.array(X1), np.array(X2), np.array(DX2)                            
                                                                                
# Mode 1                                                                        
x1_m1, x2_m1, dx2_m1 = collect_data(states, sw_indices, 1)                      
