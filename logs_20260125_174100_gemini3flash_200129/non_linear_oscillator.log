import numpy as np                                                              
                                                                                
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
n = len(x1)                                                                     
                                                                                
X = np.stack([x1[:-1], x2[:-1], np.ones(n-1)], axis=1)                          
y1 = x1[1:]                                                                     
y2 = x2[1:]                                                                     
                                                                                
window = 100                                                                    
coeffs_d = []                                                                   
coeffs_e = []                                                                   
indices = []                                                                    
                                                                                
for i in range(0, n - window, 20):                                              
    X_w = X[i : i + window]                                                     
    y_w = y2[i : i + window]                                                    
    sol, _, _, _ = np.linalg.lstsq(X_w, y_w, rcond=None)                        
    coeffs_d.append(sol[0])                                                     
    coeffs_e.append(sol[1])                                                     
    indices.append(i + window // 2)                                             
                                                                                
import matplotlib.pyplot as plt                                                 
plt.figure()                                                                    
plt.plot(indices, coeffs_d, label='d')                                          
plt.plot(indices, coeffs_e, label='e')                                          
plt.legend()                                                                    
plt.savefig('coeffs_evolution.png')                                             
                                                                                
# Find the jump in coefficients                                                 
diff_d = np.abs(np.diff(coeffs_d))                                              
if len(diff_d) > 0:                                                             
    jump_idx_in_list = np.argmax(diff_d)                                        
    transition_index = indices[jump_idx_in_list]                                
    print(f"Jump in d detected at index: {transition_index}")                   
else:                                                                           
    transition_index = n // 2                                                   
                                                                                
print(f"Candidate transition index: {transition_index}")                        
print(f"x1 at transition: {x1[transition_index]}")                              
print(f"x2 at transition: {x2[transition_index]}")                              
                                                                                
