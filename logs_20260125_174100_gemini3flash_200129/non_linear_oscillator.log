def get_coeffs(x1_sub, x2_sub):                                                 
    n = len(x1_sub) - 1                                                         
    if n < 3: return None, None                                                 
    X = np.column_stack([x1_sub[:-1], x2_sub[:-1], np.ones(n)])                 
    Y1 = x1_sub[1:]                                                             
    Y2 = x2_sub[1:]                                                             
    c1, _, _, _ = np.linalg.lstsq(X, Y1, rcond=None)                            
    c2, _, _, _ = np.linalg.lstsq(X, Y2, rcond=None)                            
    return c1, c2                                                               
                                                                                
def check_fit(c1, c2, x1_val, x2_val, x1_next, x2_next):                        
    pred1 = c1[0]*x1_val + c1[1]*x2_val + c1[2]                                 
    pred2 = c2[0]*x1_val + c2[1]*x2_val + c2[2]                                 
    return abs(pred1 - x1_next), abs(pred2 - x2_next)                           
                                                                                
def find_transitions(x1, x2, initial_c1, initial_c2):                           
    transitions = []                                                            
    current_c1, current_c2 = initial_c1, initial_c2                             
                                                                                
    i = 0                                                                       
    while i < len(x1) - 1:                                                      
        e1, e2 = check_fit(current_c1, current_c2, x1[i], x2[i], x1[i+1],       
x2[i+1])                                                                        
        if e1 > 1e-4 or e2 > 1e-4:                                              
