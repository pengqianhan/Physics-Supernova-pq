from scipy.optimize import minimize                                             
                                                                                
# 1. Load data                                                                  
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
t = data['t']                                                                   
x = data['x']  # Assuming x has shape (N, 2)                                    
