coeffs_m2, _, _, _ = np.linalg.lstsq(A_m2, dx2_m2 / dt, rcond=None)             
                                                                                
print("\nMode 1 coefficients (a, b, c):", coeffs_m1)                            
print("Mode 2 coefficients (a, b, c):", coeffs_m2)                              
                                                                                
# Task 5: Suggest a refined guard condition 'x1 >= threshold'                   
thresholds = [states[i][0, sw_indices[i]] for i in range(3)]                    
print(f"\nx1 at switch points: {thresholds}")                                   
print(f"Suggested threshold: {np.mean(thresholds)}")                            
                                                                                
