import numpy as np                                                              
                                                                                
def solve_lstsq(X, Y):                                                          
    c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                              
    return c                                                                    
                                                                                
data0 = np.load('data_all/non_linear/oscillator/sample_0.npz')                  
x1, x2 = data0['state']                                                         
n = len(x1)                                                                     
                                                                                
modes = []                                                                      
current_mode_indices = []                                                       
                                                                                
i = 0                                                                           
while i < n - 1:                                                                
    # Look for linear segments                                                  
    # Start a segment and see how far it goes                                   
    if i + 5 >= n: break                                                        
    X_seg = np.column_stack([x1[i:i+3], x2[i:i+3], np.ones(3)])                 
    Y2_seg = x2[i+1:i+4]                                                        
    c2 = solve_lstsq(X_seg, Y2_seg)                                             
                                                                                
    # Check if linear                                                           
    pred = np.dot(X_seg, c2)                                                    
    if np.max(np.abs(Y2_seg - pred)) < 1e-11:                                   
        # Extend segment                                                        
        start_idx = i                                                           
        while i < n - 1:                                                        
            feat = np.array([x1[i], x2[i], 1.0])                                
            pred_val = np.dot(feat, c2)                                         
            if np.abs(x2[i+1] - pred_val) > 1e-10:                              
                break                                                           
            i += 1                                                              
        end_idx = i                                                             
        modes.append({                                                          
            'start': start_idx,                                                 
            'end': end_idx,                                                     
            'coeffs': c2,                                                       
            'start_state': (x1[start_idx], x2[start_idx]),                      
            'end_state': (x1[end_idx], x2[end_idx])                             
        })                                                                      
    else:                                                                       
        i += 1                                                                  
                                                                                
print(f"Found {len(modes)} linear segments")                                    
for idx, m in enumerate(modes):                                                 
    print(f"Mode {idx}: Indices {m['start']} to {m['end']}")                    
