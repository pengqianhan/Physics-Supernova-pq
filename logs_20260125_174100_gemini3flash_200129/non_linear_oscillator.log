X2_curr = x2[:-1]                                                               
                                                                                
def fit_mode(mask):                                                             
    if np.sum(mask) < 2:                                                        
        return None, None                                                       
    A = np.column_stack([X1_curr[mask], X2_curr[mask], np.ones(np.sum(mask))])  
    y1 = dx1[mask]                                                              
    y2 = dx2[mask]                                                              
    c1, _, _, _ = lstsq(A, y1)                                                  
    c2, _, _, _ = lstsq(A, y2)                                                  
    return c1, c2                                                               
                                                                                
def get_total_error(threshold):                                                 
    mask1 = X1_curr < threshold                                                 
    mask2 = X1_curr >= threshold                                                
    c1_m1, c2_m1 = fit_mode(mask1)                                              
    c1_m2, c2_m2 = fit_mode(mask2)                                              
                                                                                
    if c1_m1 is None or c1_m2 is None: return np.inf                            
                                                                                
    err = 0                                                                     
    A1 = np.column_stack([X1_curr[mask1], X2_curr[mask1],                       
