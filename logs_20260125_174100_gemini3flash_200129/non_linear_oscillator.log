import numpy as np                                                              
                                                                                
data_files = ['data_all/non_linear/oscillator/sample_0.npz',                    
'data_all/non_linear/oscillator/sample_1.npz',                                  
'data_all/non_linear/oscillator/sample_2.npz']                                  
all_states = [np.load(f)['state'] for f in data_files]                          
                                                                                
def get_transitions(all_states):                                                
    transitions = []                                                            
    for states in all_states:                                                   
        z = states[0]                                                           
        # x1[k] = z[k], x2[k] = z[k+1]                                          
        # x1[k+1] = z[k+1] = x2[k]  (Identity 1 satisfied)                      
        # x2[k+1] = z[k+2]          (Equation to fit)                           
        x1_k = z[:-2]                                                           
        x2_k = z[1:-1]                                                          
        x2_next = z[2:]                                                         
        trans = np.column_stack([x1_k, x2_k, x2_next])                          
        transitions.append(trans)                                               
    return np.concatenate(transitions, axis=0)                                  
                                                                                
transitions = get_transitions(all_states)                                       
                                                                                
def fit_mode(data):                                                             
    if len(data) == 0: return None                                              
    # x2_next = a21*x1_k + a22*x2_k + b2                                        
    X = np.column_stack([data[:, 0], data[:, 1], np.ones(len(data))])           
    y = data[:, 2]                                                              
    coeffs, residuals, _, _ = np.linalg.lstsq(X, y, rcond=None)                 
    mse = residuals[0] / len(data) if len(residuals) > 0 else 0                 
    return coeffs, mse                                                          
                                                                                
# Find best threshold                                                           
thresholds = np.linspace(-0.55, -0.45, 1001)                                    
best_t = -0.4955                                                                
min_total_mse = float('inf')                                                    
                                                                                
for t in thresholds:                                                            
    m1 = transitions[transitions[:, 0] < t]                                     
    m2 = transitions[transitions[:, 0] >= t]                                    
    if len(m1) < 10 or len(m2) < 10: continue                                   
                                                                                
    res1 = fit_mode(m1)                                                         
    res2 = fit_mode(m2)                                                         
                                                                                
    total_mse = res1[1] * len(m1) + res2[1] * len(m2)                           
    if total_mse < min_total_mse:                                               
        min_total_mse = total_mse                                               
        best_t = t                                                              
                                                                                
print(f"Best threshold: {best_t}")                                              
                                                                                
# Final fit with best threshold                                                 
m1 = transitions[transitions[:, 0] < best_t]                                    
m2 = transitions[transitions[:, 0] >= best_t]                                   
c1, mse1 = fit_mode(m1)                                                         
c2, mse2 = fit_mode(m2)                                                         
                                                                                
print(f"Mode 1: a21={c1[0]}, a22={c1[1]}, b2={c1[2]}, MSE={mse1}")              
print(f"Mode 2: a21={c2[0]}, a22={c2[1]}, b2={c2[2]}, MSE={mse2}")              
                                                                                
