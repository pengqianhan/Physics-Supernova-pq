data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
state = data['state']                                                           
if state.shape[0] == 2:                                                         
    state = state.T                                                             
                                                                                
x1 = state[:, 0]                                                                
x2 = state[:, 1]                                                                
dt = 0.001                                                                      
dx1_dt = np.diff(x1) / dt                                                       
dx2_dt = np.diff(x2) / dt                                                       
x1_s = x1[:-1]                                                                  
x2_s = x2[:-1]                                                                  
                                                                                
def get_coeffs_and_res(x1_seg, x2_seg, y_seg):                                  
    if len(x1_seg) == 0:                                                        
        return None, np.inf                                                     
    A = np.column_stack((x1_seg, x2_seg, np.ones_like(x1_seg)))                 
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y_seg, rcond=None)          
    res = residuals[0] if len(residuals) > 0 else np.sum((A @ coeffs -          
y_seg)**2)                                                                      
    return coeffs, res                                                          
                                                                                
# Search for the optimal x1 threshold around the suggested -0.4955              
# We'll test x1 values in the trajectory as potential thresholds                
search_range = (x1_s > -0.52) & (x1_s < -0.48)                                  
candidates = np.sort(x1_s[search_range])                                        
                                                                                
best_th = -0.5                                                                  
min_total_res = np.inf                                                          
                                                                                
for th in candidates:                                                           
    mask1 = x1_s < th                                                           
    mask2 = ~mask1                                                              
    if np.sum(mask1) < 20 or np.sum(mask2) < 20:                                
        continue                                                                
                                                                                
    _, r1 = get_coeffs_and_res(x1_s[mask1], x2_s[mask1], dx2_dt[mask1])         
    _, r2 = get_coeffs_and_res(x1_s[mask2], x2_s[mask2], dx2_dt[mask2])         
                                                                                
    if r1 + r2 < min_total_res:                                                 
        min_total_res = r1 + r2                                                 
        best_th = th                                                            
                                                                                
print(f"Optimal x1 threshold found: {best_th}")                                 
                                                                                
# Split and fit                                                                 
