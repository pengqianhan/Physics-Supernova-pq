import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the first data file to inspect the structure                             
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
print("Keys in npz file:", data.files)                                          
                                                                                
# Extract time and state trajectories                                           
t = data['t']                                                                   
x = data['x']  # Assuming x is a matrix where columns or rows are x1, x2        
# Let's check the shape                                                         
print("Shape of t:", t.shape)                                                   
print("Shape of x:", x.shape)                                                   
                                                                                
# Based on typical formats, x is likely (N, 2)                                  
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
# Compute numerical derivatives                                                 
dt = t[1] - t[0]                                                                
dx1_dt = np.gradient(x1, dt)                                                    
dx2_dt = np.gradient(x2, dt)                                                    
                                                                                
# Identify switching point                                                      
# We look for a significant change in the dynamics.                             
# One way is to look at the second derivative or residuals of a local linear    
fit.                                                                            
# Let's try to find a point where the behavior changes abruptly.                
# A common switch in these problems is based on a state variable reaching a     
value.                                                                          
# Let's look at the acceleration or the change in the relationship.             
                                                                                
# Let's calculate the "acceleration" to find the switch                         
d2x1_dt2 = np.gradient(dx1_dt, dt)                                              
d2x2_dt2 = np.gradient(dx2_dt, dt)                                              
accel_mag = np.sqrt(d2x1_dt2**2 + d2x2_dt2**2)                                  
switch_idx = np.argmax(np.abs(np.diff(accel_mag))) + 1                          
print("Detected switching index:", switch_idx)                                  
print("Switching time:", t[switch_idx])                                         
print("State at switch:", x1[switch_idx], x2[switch_idx])                       
                                                                                
# Split the data                                                                
idx = switch_idx                                                                
mode1_x = x[:idx]                                                               
mode1_dx = np.column_stack((dx1_dt[:idx], dx2_dt[:idx]))                        
                                                                                
mode2_x = x[idx:]                                                               
mode2_dx = np.column_stack((dx1_dt[idx:], dx2_dt[idx:]))                        
                                                                                
def fit_mode(X, Y):                                                             
    model = LinearRegression()                                                  
    model.fit(X, Y)                                                             
