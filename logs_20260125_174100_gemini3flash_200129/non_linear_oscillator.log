import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/oscillator/sample_0.npz')                   
state = data['state']                                                           
x1 = state[:, 0]                                                                
x2 = state[:, 1]                                                                
dt = 0.001                                                                      
                                                                                
dx1 = (x1[1:] - x1[:-1]) / dt                                                   
dx2 = (x2[1:] - x2[:-1]) / dt                                                   
x1_k = x1[:-1]                                                                  
x2_k = x2[:-1]                                                                  
ones = np.ones_like(x1_k)                                                       
                                                                                
# Check range of x1                                                             
print(f"x1 range: {np.min(x1_k)} to {np.max(x1_k)}")                            
                                                                                
# Try a simpler split: Look for where a single linear model fails most          
X = np.column_stack([x1_k, x2_k, ones])                                         
coeffs_full, residuals_full, rank, s = np.linalg.lstsq(X, dx2, rcond=None)      
errors = (dx2 - X @ coeffs_full)**2                                             
                                                                                
# If there is a switch, the errors might be clustered or have a peak            
# Let's try to find the transition index by finding the point that maximizes the
difference                                                                      
# in error between two segments                                                 
n = len(x1_k)                                                                   
best_idx = -1                                                                   
min_total_error = float('inf')                                                  
                                                                                
# Sampling indices to find the split point in time                              
for i in range(int(0.05 * n), int(0.95 * n), 50):                               
    A1, y1 = X[:i], dx2[:i]                                                     
    A2, y2 = X[i:], dx2[i:]                                                     
                                                                                
    res1 = np.linalg.lstsq(A1, y1, rcond=None)                                  
    res2 = np.linalg.lstsq(A2, y2, rcond=None)                                  
                                                                                
    err1 = res1[1][0] if len(res1[1]) > 0 else np.sum((y1 - A1 @ res1[0])**2)   
    err2 = res2[1][0] if len(res2[1]) > 0 else np.sum((y2 - A2 @ res2[0])**2)   
                                                                                
    if (err1 + err2) < min_total_error:                                         
        min_total_error = err1 + err2                                           
        best_idx = i                                                            
                                                                                
print(f"Best transition index: {best_idx}")                                     
print(f"Transition time: {best_idx * dt}")                                      
print(f"x1 at transition: {x1_k[best_idx]}")                                    
                                                                                
# Now define modes based on the value of x1 at the transition                   
guard_val = x1_k[best_idx]                                                      
mask1 = x1_k < guard_val                                                        
mask2 = x1_k >= guard_val                                                       
                                                                                
# Re-run regressions to get cleaner coefficients                                
A1, y1 = X[mask1], dx2[mask1]                                                   
res1 = np.linalg.lstsq(A1, y1, rcond=None)[0]                                   
A2, y2 = X[mask2], dx2[mask2]                                                   
res2 = np.linalg.lstsq(A2, y2, rcond=None)[0]                                   
                                                                                
