for f in DATA_FILE_PATHS:                                                       
    data = np.load(f)                                                           
    x = data['state'][0]                                                        
    # Use np.gradient for numerical differentiation                             
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
                                                                                
