def analyze_sample(idx, data_path):                                             
    data = np.load(data_path)                                                   
    state = data['state']                                                       
    dt = 0.001                                                                  
    x1 = state[0]                                                               
                                                                                
    # Calculate derivatives                                                     
    dx1 = np.diff(x1) / dt                                                      
    x1_mid = x1[:-1]                                                            
                                                                                
    d2x1 = np.diff(dx1) / dt                                                    
    x1_mid2 = x1_mid[:-1]                                                       
    dx1_mid2 = dx1[:-1]                                                         
                                                                                
    print(f"\n--- Sample {idx} Analysis ---")                                   
    print(f"x1 range: [{np.min(x1):.4f}, {np.max(x1):.4f}]")                    
    print(f"dx1 range: [{np.min(dx1):.4f}, {np.max(dx1):.4f}], std:             
{np.std(dx1):.6f}")                                                             
    print(f"d2x1 range: [{np.min(d2x1):.4f}, {np.max(d2x1):.4f}], std:          
{np.std(d2x1):.6f}")                                                            
                                                                                
    # Check for constant first derivative                                       
    if np.std(dx1) < 1e-4:                                                      
        print("dx1 is constant.")                                               
