import numpy as np                                                              
from scipy.optimize import curve_fit                                            
                                                                                
dt = 0.001                                                                      
                                                                                
# Define candidate functions                                                    
def model1(x, a, b): return a * np.sin(x) + b                                   
def model2(x, a, b): return a * np.cos(x) + b                                   
def model3(x, a, b): return a * np.exp(-b * x)                                  
def model4(x, a, b): return a / (x + b)                                         
def model5(x, a, b): return a * x**b                                            
                                                                                
for i, path in enumerate(DATA_FILE_PATHS):                                      
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0]                                                               
    dx1 = np.gradient(x1, dt)                                                   
                                                                                
    print(f"Sample {i} Analysis:")                                              
    for func in [model1, model2, model3, model4, model5]:                       
        try:                                                                    
            popt, pcov = curve_fit(func, x1, dx1)                               
            # Calculate R-squared or residual                                   
            residuals = dx1 - func(x1, *popt)                                   
            ss_res = np.sum(residuals**2)                                       
            print(f"  {func.__name__}: residual={ss_res}, params={popt}")       
        except:                                                                 
            print(f"  {func.__name__}: failed")                                 
                                                                                
