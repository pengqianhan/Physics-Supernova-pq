A = np.concatenate(A_list)                                                      
                                                                                
# Define library of candidate functions                                         
library = {                                                                     
    '1': np.ones_like(X),                                                       
    'x': X,                                                                     
    'v': V,                                                                     
    'x^2': X**2,                                                                
    'xv': X*V,                                                                  
    'v^2': V**2,                                                                
    'sin(x)': np.sin(X),                                                        
