import numpy as np                                                              
                                                                                
def analyze_sample(sample_path):                                                
    data = np.load(sample_path)                                                 
    state = data['state']                                                       
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    # Estimate dt and g                                                         
    # dx2 = -g * dt                                                             
    # dx1 = x2 * dt                                                             
    # Let's use the first few steps before a jump                               
    dt_est = dx1[0] / x2[0]                                                     
    g_est = -dx2[0] / dt_est                                                    
                                                                                
    # Identify jump indices                                                     
    # Jumps are where dx2 is significantly different from -g*dt                 
    jumps = np.where(np.abs(dx2 + 0.0098) > 0.001)[0]                           
                                                                                
    jump_data = []                                                              
    for idx in jumps:                                                           
        jump_info = {                                                           
            'x1_pre': x1[idx],                                                  
            'x1_post': x1[idx+1],                                               
            'x2_pre': x2[idx],                                                  
            'x2_post': x2[idx+1]                                                
        }                                                                       
        jump_data.append(jump_info)                                             
                                                                                
    return dt_est, g_est, jump_data                                             
                                                                                
