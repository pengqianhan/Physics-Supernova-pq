      if e - s < 5: continue # skip small segments                              
      Y = d2x2[s:e]                                                             
      X = np.vstack([dx2[s:e], x2[s:e], u1[s:e], np.ones_like(u1[s:e])]).T      
      coeffs, residuals, rank, s_vals = np.linalg.lstsq(X, Y, rcond=None)       
      results.append({'segment': i, 'coeffs': coeffs, 'range': (s, e)})         
      print(f"Coeffs for segment {i}: a={coeffs[0]}, b={coeffs[1]},             
  c={coeffs[2]}, d={coeffs[3]}")                                                
                                                                                
  # Check for resets at transitions                                             
  for i in range(len(segments) - 1):                                            
