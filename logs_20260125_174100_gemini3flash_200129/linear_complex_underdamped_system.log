    print(f"Reset at x1=5: dx2 before={dx2[idx]}, after={dx2[idx+1]},           
diff={dx2[idx+1]-dx2[idx]}")                                                    
                                                                                
# Transition 2: Mode 2 to Mode 3 (x1 ~ 10)                                      
idx_t2 = np.where(np.diff((x1 >= 10.0).astype(int)) > 0)[0]                     
if len(idx_t2) > 0:                                                             
    idx = idx_t2[0]                                                             
    # In mode 3 it starts decreasing, so look at the point where gradient       
changes sign                                                                    
    idx_start_m3 = mode3_indices[0]                                             
    print(f"Reset at x1=10: x2 before={x2[idx_start_m3-1]},                     
