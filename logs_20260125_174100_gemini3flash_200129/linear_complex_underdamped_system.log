        'x2_jump': x2_post - x2_pre,                                            
        'dx2_jump': dx2_post - dx2_pre,                                         
        'u1': u1[0]                                                             
    }                                                                           
                                                                                
print("Mode 1&2 Coefficients [a, b, c, d]:", model_results[1])                  
