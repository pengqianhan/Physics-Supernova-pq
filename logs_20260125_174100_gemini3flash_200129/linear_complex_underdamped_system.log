import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load all data                                                                 
all_x = []                                                                      
all_u = []                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # Assuming keys are 'x' for states and 'u' for inputs based on typical      
naming                                                                          
    all_x.append(data['x'])                                                     
    all_u.append(data['u'])                                                     
                                                                                
# Combine trajectories                                                          
# x shape is (N, T, dim_x), u shape is (N, T, dim_u)                            
X = np.concatenate(all_x, axis=0)                                               
U = np.concatenate(all_u, axis=0)                                               
                                                                                
num_trajs, seq_len, dim_x = X.shape                                             
dim_u = U.shape[2]                                                              
                                                                                
results = {}                                                                    
                                                                                
def get_mode(x1):                                                               
    if x1 < 5.0: return 1                                                       
    if 5.0 <= x1 < 10.0: return 2                                               
    return 3                                                                    
                                                                                
# Collect transitions for regression                                            
# Equation: x2[k+2] = a*x2[k+1] + b*x2[k] + c*u1[k] + d                         
# Mode is determined by x1[k]                                                   
mode_data = {1: [], 2: [], 3: []}                                               
x1_diffs = {1: [], 2: [], 3: []}                                                
                                                                                
for i in range(num_trajs):                                                      
    for k in range(seq_len - 2):                                                
        x_curr = X[i, k]                                                        
        x_next = X[i, k+1]                                                      
        x_next2 = X[i, k+2]                                                     
        u_curr = U[i, k]                                                        
                                                                                
        m = get_mode(x_curr[0])                                                 
        m_next = get_mode(x_next[0])                                            
        m_next2 = get_mode(x_next2[0])                                          
                                                                                
        # Check if the mode is consistent during the transition for ODE         
estimation                                                                      
        if m == m_next == m_next2:                                              
            # target: x2[k+2], features: x2[k+1], x2[k], u1[k], 1               
            mode_data[m].append([x_next[1], x_curr[1], u_curr[0], 1.0,          
x_next2[1]])                                                                    
                                                                                
        # Track x1 dynamics: x1[k+1] - x1[k]                                    
        x1_diffs[m].append(x_next[0] - x_curr[0])                               
                                                                                
# Regression per mode                                                           
coeffs = {}                                                                     
for m in [1, 2, 3]:                                                             
    data = np.array(mode_data[m])                                               
    if len(data) > 0:                                                           
        reg = LinearRegression(fit_intercept=False).fit(data[:, :4], data[:, 4])
        coeffs[m] = reg.coef_                                                   
    else:                                                                       
        coeffs[m] = None                                                        
                                                                                
# Check x1 dynamics                                                             
x1_stats = {}                                                                   
for m in [1, 2, 3]:                                                             
    if x1_diffs[m]:                                                             
        x1_stats[m] = np.mean(x1_diffs[m])                                      
    else:                                                                       
        x1_stats[m] = None                                                      
                                                                                
# Check for resets at transitions                                               
resets = []                                                                     
for i in range(num_trajs):                                                      
    for k in range(seq_len - 1):                                                
        m_curr = get_mode(X[i, k, 0])                                           
        m_next = get_mode(X[i, k+1, 0])                                         
        if m_curr != m_next:                                                    
            # Record jump in x2                                                 
            resets.append({                                                     
                'from': m_curr, 'to': m_next,                                   
                'x2_jump': X[i, k+1, 1] - X[i, k, 1],                           
                'x1': X[i, k, 0], 'x1_next': X[i, k+1, 0]                       
            })                                                                  
                                                                                
print("Coefficients (a, b, c, d):", coeffs)                                     
print("x1 dynamics (avg diff):", x1_stats)                                      
print("Resets sample:", resets[:3] if resets else "None")                       
                                                                                
