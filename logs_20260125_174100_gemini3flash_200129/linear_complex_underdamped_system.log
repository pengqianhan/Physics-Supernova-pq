<code>                                                                          
import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/linear/complex_underdamped_system/sample_0.npz')       
state = data['state']                                                           
u = data['input']                                                               
dt = 0.001                                                                      
N = state.shape[1]                                                              
time = np.arange(N) * dt                                                        
                                                                                
x1 = state[0]                                                                   
x2 = state[1]                                                                   
u1 = u[0]                                                                       
                                                                                
# Calculate derivatives                                                         
dx1 = np.gradient(x1, dt)                                                       
dx2 = np.gradient(x2, dt)                                                       
ddx2 = np.gradient(dx2, dt)                                                     
                                                                                
# Identify transitions                                                          
# Mode 1 to 2 around t=5                                                        
t1_idx = int(5.0 / dt)                                                          
# We look for where x1 slope changes from +1 to -1 for Mode 2 to 3              
# Mode 1/2: dx1 approx 1. Mode 3: dx1 approx -1.                                
dx1_smooth = np.convolve(dx1, np.ones(100)/100, mode='same')                    
t2_idx = np.where((dx1_smooth < 0) & (time > 6))[0][0]                          
                                                                                
x1_trans1 = x1[t1_idx]                                                          
x1_trans2 = x1[t2_idx]                                                          
                                                                                
print(f"Transition 1 at t={time[t1_idx]}, x1={x1_trans1}")                      
print(f"Transition 2 at t={time[t2_idx]}, x1={x1_trans2}")                      
                                                                                
# Define mode indices                                                           
m1_indices = np.arange(0, t1_idx - 100) # Buffer to avoid transition artifacts  
m2_indices = np.arange(t1_idx + 100, t2_idx - 100)                              
m3_indices = np.arange(t2_idx + 100, N - 100)                                   
                                                                                
def fit_mode(idx):                                                              
    # x1[1] = k                                                                 
    k = np.mean(dx1[idx])                                                       
    # x2[2] = a * x2[1] + b * x2[0] + c * u1 + d                                
    Y = ddx2[idx]                                                               
    X = np.column_stack([dx2[idx], x2[idx], u1[idx], np.ones_like(idx)])        
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return k, coeffs                                                            
                                                                                
m1_k, m1_coeffs = fit_mode(m1_indices)                                          
m2_k, m2_coeffs = fit_mode(m2_indices)                                          
m3_k, m3_coeffs = fit_mode(m3_indices)                                          
                                                                                
print(f"Mode 1: dx1={m1_k}, coeffs={m1_coeffs}")                                
print(f"Mode 2: dx1={m2_k}, coeffs={m2_coeffs}")                                
print(f"Mode 3: dx1={m3_k}, coeffs={m3_coeffs}")                                
                                                                                
# Check resets                                                                  
# Reset 1 (1 -> 2)                                                              
# Compare state at t1_idx                                                       
print(f"Reset 1 -> 2: x1 shift={x1[t1_idx+1]-x1[t1_idx]}, x2                    
