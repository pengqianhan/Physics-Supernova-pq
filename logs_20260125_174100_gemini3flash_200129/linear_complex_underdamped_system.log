    u = data['input'].T                                                         
                                                                                
    x1 = state[:, 0]                                                            
    x2 = state[:, 1]                                                            
    u1 = u[:, 0]                                                                
                                                                                
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
    # Mode 2: 5 <= x1 < 10 and dx1 > 0                                          
    m2_mask = (x1 >= 5.0) & (x1 < 10.0) & (dx1 > 0.5)                           
                                                                                
    if np.sum(m2_mask) > 0:                                                     
        all_m2_dx2.append(dx2[m2_mask])                                         
        all_m2_x2.append(x2[m2_mask])                                           
        all_m2_u1.append(u1[m2_mask])                                           
        all_m2_d2x2.append(d2x2[m2_mask])                                       
                                                                                
    # Check for reset at x1 = 5.0                                               
    cross_5 = np.where((x1[:-1] < 5.0) & (x1[1:] >= 5.0))[0]                    
    for idx in cross_5:                                                         
        # We need to be careful with numerical gradients at the jump.           
