import numpy as np                                                              
from scipy.optimize import least_squares                                        
                                                                                
dt = 0.001                                                                      
                                                                                
def analyze_file(file_path):                                                    
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    u = data['input']                                                           
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    u1 = u[0, :]                                                                
                                                                                
    # Calculate derivatives                                                     
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
    return x1, x2, u1, dx1, dx2, d2x2                                           
                                                                                
x1, x2, u1, dx1, dx2, d2x2 = analyze_file(DATA_FILE_PATHS[2])                   
                                                                                
# Identify indices for modes in File 2                                          
m1_idx = np.where(x1 < 5.0)[0]                                                  
# For Mode 2, we want x1 between 5 and 10 while it's increasing                 
increasing = np.gradient(x1) > 0                                                
m2_idx = np.where((x1 >= 5.0) & (x1 < 10.0) & increasing)[0]                    
# For Mode 3, x1 starts decreasing                                              
m3_idx = np.where(~increasing)[0]                                               
                                                                                
def estimate_params(idx, x2, dx2, d2x2, u1):                                    
    if len(idx) < 10: return None                                               
                                                                                
    # Try models:                                                               
    # 1. d2x2 = -b*dx2 - k*x2 + g*u1                                            
    # 2. d2x2 = -b*dx2 - k*x2 + c                                               
                                                                                
    # Model 1                                                                   
    A = np.column_stack([-dx2[idx], -x2[idx], u1[idx]])                         
    b_vec = d2x2[idx]                                                           
    params1, _, _, _ = np.linalg.lstsq(A, b_vec, rcond=None)                    
    res1 = np.sum((b_vec - A @ params1)**2)                                     
                                                                                
    # Model 2                                                                   
    A2 = np.column_stack([-dx2[idx], -x2[idx], np.ones(len(idx))])              
    params2, _, _, _ = np.linalg.lstsq(A2, b_vec, rcond=None)                   
    res2 = np.sum((b_vec - A2 @ params2)**2)                                    
                                                                                
    if res1 < res2:                                                             
        return {'type': 'u1', 'params': params1, 'res': res1}                   
    else:                                                                       
