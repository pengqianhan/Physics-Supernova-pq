import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def fit_mode(mode_id):                                                          
    X = []                                                                      
    Y = []                                                                      
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x1 = data['state'][0, :]                                                
        x2 = data['state'][1, :]                                                
        u1 = data['input'][0, :]                                                
                                                                                
        # Determine mode                                                        
        dx1_raw = np.diff(x1)                                                   
        dx1 = np.append(dx1_raw, dx1_raw[-1])                                   
                                                                                
        # Central difference for x2' and x2''                                   
        # To avoid index issues, we'll iterate from 1 to len-2                  
        for i in range(1, len(x1) - 1):                                         
            if dx1[i] > 0.5:                                                    
                if x1[i] < 4.999:                                               
                    curr = 1                                                    
                elif x1[i] < 9.999:                                             
                    curr = 2                                                    
                else:                                                           
                    curr = 3                                                    
            else:                                                               
                curr = 3                                                        
                                                                                
            if curr == mode_id:                                                 
                v = (x2[i+1] - x2[i-1]) / (2 * dt)                              
                a = (x2[i+1] - 2*x2[i] + x2[i-1]) / (dt**2)                     
                X.append([v, x2[i], u1[i], 1.0])                                
                Y.append(a)                                                     
                                                                                
    if not X: return None                                                       
    X = np.array(X)                                                             
    Y = np.array(Y)                                                             
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
for m in [1, 2, 3]:                                                             
    print(f"Mode {m} nice fit: {fit_mode(m)}")                                  
                                                                                
