def fit_mode2(sample_idx):                                                      
    data = np.load(DATA_FILE_PATHS[sample_idx])                                 
    state = data['state']                                                       
    u = data['input'][0, :]                                                     
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dt = 0.001                                                                  
    x2_dot = np.gradient(x2, dt)                                                
    x2_ddot = np.gradient(x2_dot, dt)                                           
                                                                                
    mask = x1 > 5.1                                                             
    if np.sum(mask) < 100:                                                      
        return None                                                             
                                                                                
    # Try x2_ddot = a*x2_dot + b*x2 + k*u + c                                   
    A = np.vstack([x2_dot[mask], x2[mask], u[mask], np.ones(np.sum(mask))]).T   
    coeffs, _, _, _ = np.linalg.lstsq(A, x2_ddot[mask], rcond=None)             
    return coeffs                                                               
                                                                                
for i in range(3):                                                              
    print(f"Sample {i} Mode 2 [a, b, k, c]: {fit_mode2(i)}")                    
                                                                                
