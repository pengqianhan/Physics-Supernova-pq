  all_m2 = []                                                                   
  all_m3 = []                                                                   
                                                                                
  def get_derivatives(x, dt):                                                   
      dx = np.gradient(x, dt)                                                   
      ddx = np.gradient(dx, dt)                                                 
      return dx, ddx                                                            
                                                                                
  for s in samples:                                                             
      x1, x2 = s['state'][0], s['state'][1]                                     
      u1 = s['input'][0]                                                        
      dx1, _ = get_derivatives(x1, dt)                                          
      dx2, ddx2 = get_derivatives(x2, dt)                                       
                                                                                
      for i in range(2, len(x1)-2):                                             
          v1, p1 = dx1[i], x1[i]                                                
          feat = [dx2[i], x2[i], u1[i], 1.0, ddx2[i]]                           
          if v1 > 0.5:                                                          
              if p1 < 4.9: all_m1.append(feat)                                  
              elif p1 > 5.1 and p1 < 9.9: all_m2.append(feat)                   
          elif v1 < -0.5:                                                       
              if p1 < 9.9: all_m3.append(feat)                                  
                                                                                
  def fit(data):                                                                
      if not data: return None                                                  
      arr = np.array(data)                                                      
      X, y = arr[:, :4], arr[:, 4]                                              
      c, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                            
      return c                                                                  
                                                                                
  c1 = fit(all_m1)                                                              
  c2 = fit(all_m2)                                                              
  c3 = fit(all_m3)                                                              
                                                                                
