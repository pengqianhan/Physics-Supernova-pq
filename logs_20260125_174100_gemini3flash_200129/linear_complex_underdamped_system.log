          x1 = data['state'][0, :]                                              
          x2 = data['state'][1, :]                                              
          u = data['input'][0, :]                                               
                                                                                
          diffs = np.diff(x1)                                                   
          increasing = np.where(diffs > 0)[0]                                   
          mask_a = (x1 < 5.0)                                                   
          idx_a = []                                                            
          for idx in increasing:                                                
              if mask_a[idx]:                                                   
                  idx_a.append(idx)                                             
                                                                                
          if len(idx_a) < 10: continue                                          
          idx_a = np.array(idx_a)[1:-1]                                         
                                                                                
          x2_val = x2[idx_a]                                                    
          u_val = u[idx_a]                                                      
          dx2_val = (x2[idx_a+1] - x2[idx_a-1]) / (2 * dt)                      
          ddx2_val = (x2[idx_a+1] - 2*x2[idx_a] + x2[idx_a-1]) / (dt**2)        
                                                                                
          X = np.stack([dx2_val, x2_val, u_val, np.ones_like(u_val)], axis=1)   
          y = ddx2_val                                                          
          coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                   
          print(f"Sample {i} Mode A Coeffs: {coeffs}")                          
                                                                                
  check_mode_A_per_sample()                                                     
