import numpy as np                                                              
                                                                                
def analyze_sample(sample_idx):                                                 
    data =                                                                      
np.load(f'data_all/linear/complex_underdamped_system/sample_{sample_idx}.npz')  
    state = data['state']                                                       
    u = data['input']                                                           
    x1 = state[0]                                                               
    x2 = state[1]                                                               
    u1 = u[0]                                                                   
                                                                                
    # Estimate dt from x1                                                       
    dt = np.median(np.diff(x1))                                                 
                                                                                
    # Compute derivatives                                                       
    v2 = np.gradient(x2, dt)                                                    
    a2 = np.gradient(v2, dt)                                                    
                                                                                
    return x1, x2, v2, a2, u1, dt                                               
                                                                                
x1, x2, v2, a2, u1, dt = analyze_sample(0)                                      
                                                                                
def get_params(indices):                                                        
    if len(indices) < 20: return None                                           
    # Model: a2 = a*v2 + b*x2 + c*u1 + d                                        
    # We must exclude the points near transitions to avoid gradient artifacts   
    # Excluding 5 points from each end                                          
    idx = indices[10:-10]                                                       
    Y = a2[idx]                                                                 
    X = np.column_stack([v2[idx], x2[idx], u1[idx], np.ones_like(idx)])         
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
mode1_idx = np.where(x1 < 4.9)[0]                                               
mode2_idx = np.where((x1 > 5.1) & (x1 < 9.9))[0]                                
                                                                                
params1 = get_params(mode1_idx)                                                 
params2 = get_params(mode2_idx)                                                 
                                                                                
print("Mode 1 params (a, b, c, d):", params1)                                   
print("Mode 2 params (a, b, c, d):", params2)                                   
                                                                                
