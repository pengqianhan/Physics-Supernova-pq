import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def estimate_coefficients(x2, u1, dt):                                          
    # Calculate derivatives using central differences                           
    dx2 = (x2[2:] - x2[:-2]) / (2 * dt)                                         
    ddx2 = (x2[2:] - 2 * x2[1:-1] + x2[:-2]) / (dt ** 2)                        
                                                                                
    # Trim x2 and u1 to match the size of derivatives                           
    x2_mid = x2[1:-1]                                                           
    u1_mid = u1[1:-1]                                                           
                                                                                
    # Regression: ddx2 = a * dx2 + b * x2_mid + c * u1_mid + d                  
    A = np.column_stack([dx2, x2_mid, u1_mid, np.ones_like(dx2)])               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, ddx2, rcond=None)           
    return coeffs                                                               
                                                                                
data = np.load(DATA_FILE_PATH)                                                  
