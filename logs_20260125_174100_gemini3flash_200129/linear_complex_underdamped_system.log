import numpy as np                                                              
                                                                                
def fit_extended(x2, u, x1, mask):                                              
    if np.sum(mask) < 20: return None                                           
    indices = np.where(mask)[0]                                                 
    valid = [i for i in indices if i > 0 and i < len(x2)-1 and mask[i-1] and    
mask[i+1]]                                                                      
    if len(valid) < 10: return None                                             
    valid = np.array(valid)                                                     
                                                                                
    # Target: x2_ddot approximation                                             
    dt = 0.01                                                                   
    Y = (x2[valid+1] - 2*x2[valid] + x2[valid-1]) / (dt**2)                     
    # Features: x2_dot, x2, u, 1, x1                                            
    x2dot = (x2[valid] - x2[valid-1]) / dt                                      
    Feat = np.stack([x2dot, x2[valid], u[valid], np.ones(len(valid)),           
x1[valid]], axis=1)                                                             
                                                                                
    theta, _, _, _ = np.linalg.lstsq(Feat, Y, rcond=None)                       
    y_pred = np.dot(Feat, theta)                                                
    r2 = 1 - (np.sum((Y - y_pred)**2) / np.sum((Y - np.mean(Y))**2))            
    return theta, r2                                                            
                                                                                
for i in range(3):                                                              
    data = np.load(f'data_all/linear/complex_underdamped_system/sample_{i}.npz')
    x2, x1, u = data['state'][1], data['state'][0], data['input'][0]            
    print(f"Sample {i} Mode 2 (Extended):")                                     
    res = fit_extended(x2, u, x1, (x1 >= 5) & (x1 < 10))                        
    if res:                                                                     
        theta, r2 = res                                                         
        print(f"  Coeffs: {theta}, R2={r2:.4f}")                                
                                                                                
