    x1_val = state[0, :-2]                                                      
    x2_val = state[1, :-2]                                                      
    u_val = u[0, :-2]                                                           
                                                                                
    dx2 = (state[1, 1:-1] - state[1, :-2]) / dt                                 
    ddx2 = (state[1, 2:] - 2*state[1, 1:-1] + state[1, :-2]) / (dt**2)          
                                                                                
