def estimate_coeffs(x2, u1, dt):                                                
    dx2 = (x2[2:] - x2[:-2]) / (2 * dt)                                         
    ddx2 = (x2[2:] - 2 * x2[1:-1] + x2[:-2]) / (dt ** 2)                        
    A = np.column_stack([dx2, x2[1:-1], u1[1:-1], np.ones(len(dx2))])           
    coeffs, _, _, _ = np.linalg.lstsq(A, ddx2, rcond=None)                      
    return coeffs                                                               
                                                                                
