data = np.load('data_all/linear/complex_underdamped_system/sample_0.npz')       
X = data['X']                                                                   
U = data['U']                                                                   
t = data['t']                                                                   
                                                                                
# Assuming X structure based on the prompt's indexing:                          
# X[:, 0] is x1, X[:, 1] is x1_dot                                              
# X[:, 2] is x2, X[:, 3] is x2_dot                                              
# x2[2] likely refers to x2_ddot, which we calculate via finite differences or  
find in data                                                                    
dt = t[1] - t[0]                                                                
x1 = X[:, 0]                                                                    
x1_dot = X[:, 1]                                                                
x2 = X[:, 2]                                                                    
x2_dot = X[:, 3]                                                                
u1 = U[:, 0]                                                                    
x2_ddot = np.gradient(x2_dot, dt)                                               
                                                                                
# Identify modes                                                                
m1_mask = x1 < 5                                                                
m2_mask = (x1 >= 5) & (x1 < 10)                                                 
m3_mask = x1 >= 10                                                              
                                                                                
def analyze_mode(mask):                                                         
    if not np.any(mask): return None                                            
    u1_val = np.mean(u1[mask])                                                  
    x1_dot_val = np.mean(x1_dot[mask])                                          
                                                                                
    # ODE: x2_ddot = a*x2_dot + b*x2 + c*u1 + d                                 
    Y = x2_ddot[mask]                                                           
    A = np.stack([x2_dot[mask], x2[mask], u1[mask], np.ones_like(u1[mask])],    
axis=1)                                                                         
    reg = LinearRegression().fit(A, Y)                                          
    return u1_val, x1_dot_val, reg.coef_, reg.intercept_                        
                                                                                
results = {                                                                     
    "Mode 1": analyze_mode(m1_mask),                                            
    "Mode 2": analyze_mode(m2_mask),                                            
    "Mode 3": analyze_mode(m3_mask)                                             
}                                                                               
                                                                                
# Check for resets                                                              
# Find transitions                                                              
idx5 = np.where(np.diff((x1 >= 5).astype(int)) > 0)[0]                          
idx10 = np.where(np.diff((x1 >= 10).astype(int)) > 0)[0]                        
                                                                                
resets = []                                                                     
for idx in list(idx5) + list(idx10):                                            
    dx2 = x2[idx+1] - x2[idx]                                                   
    dx2dot = x2_dot[idx+1] - x2_dot[idx]                                        
    resets.append((x1[idx], dx2, dx2dot))                                       
                                                                                
print("Results:", results)                                                      
print("Resets:", resets)                                                        
                                                                                
