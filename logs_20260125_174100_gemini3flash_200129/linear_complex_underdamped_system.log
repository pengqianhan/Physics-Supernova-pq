def get_derivatives(x, dt):                                                     
    dx = np.zeros_like(x)                                                       
    dx[:, 1:-1] = (x[:, 2:] - x[:, :-2]) / (2 * dt)                             
    dx[:, 0] = (x[:, 1] - x[:, 0]) / dt                                         
