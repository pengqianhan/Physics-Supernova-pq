dt = 0.001                                                                      
                                                                                
def get_derivatives(x, dt):                                                     
    # Use central differences or simple differences                             
    dx = np.diff(x) / dt                                                        
    # x_dot is at midpoints                                                     
    # For second derivative                                                     
    ddx = np.diff(dx) / dt                                                      
    return dx, ddx                                                              
                                                                                
