import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the first data file                                                      
data = np.load('data_all/linear/complex_underdamped_system/sample_0.npz')       
t = data['t']                                                                   
X = data['X'] # Assuming X contains [x1, x2]                                    
U = data['U'] # Assuming U contains [u1]                                        
                                                                                
print(f"Shapes: t: {t.shape}, X: {X.shape}, U: {U.shape}")                      
                                                                                
# Calculate derivatives                                                         
dt = t[1] - t[0]                                                                
x1 = X[:, 0]                                                                    
x2 = X[:, 1]                                                                    
u1 = U[:, 0]                                                                    
                                                                                
x1_dot = np.gradient(x1, dt)                                                    
x2_dot = np.gradient(x2, dt)                                                    
x2_ddot = np.gradient(x2_dot, dt)                                               
                                                                                
# Identify modes                                                                
mode1_idx = (x1 < 5.0) & (x1_dot > 0)                                           
mode2_idx = (x1 >= 5.0) & (x1 < 10.0) & (x1_dot > 0)                            
mode3_idx = (x1 >= 10.0) | (x1_dot < 0)                                         
                                                                                
def fit_mode(idx, mode_name):                                                   
    if not np.any(idx):                                                         
        print(f"No data for {mode_name}")                                       
        return None                                                             
                                                                                
    Y = x2_ddot[idx]                                                            
    # Features: x2_dot, x2, u1, constant                                        
    X_feat = np.column_stack([x2_dot[idx], x2[idx], u1[idx],                    
np.ones(np.sum(idx))])                                                          
                                                                                
    # Solve least squares: Y = X_feat * [A, B, C, D]                            
    coeffs, residuals, rank, s = np.linalg.lstsq(X_feat, Y, rcond=None)         
    A, B, C, D = coeffs                                                         
                                                                                
    avg_x1_dot = np.mean(x1_dot[idx])                                           
                                                                                
    print(f"--- {mode_name} ---")                                               
    print(f"A: {A:.4f}, B: {B:.4f}, C: {C:.4f}, D: {D:.4f}")                    
    print(f"Average x1': {avg_x1_dot:.4f}")                                     
    return coeffs, avg_x1_dot                                                   
                                                                                
fit_mode(mode1_idx, "Mode 1")                                                   
fit_mode(mode2_idx, "Mode 2")                                                   
fit_mode(mode3_idx, "Mode 3")                                                   
                                                                                
# Jump checks                                                                   
# Transition 1->2 (x1 approx 5.0)                                               
# Find index where x1 crosses 5.0 upwards                                       
crossings_5 = np.where(np.diff((x1 >= 5.0).astype(int)) > 0)[0]                 
for idx in crossings_5:                                                         
    print(f"\nJump at x1=5.0 (index {idx}):")                                   
    print(f"Before: x1={x1[idx]:.4f}, x2={x2[idx]:.4f}, x2'={x2_dot[idx]:.4f}") 
    print(f"After:  x1={x1[idx+1]:.4f}, x2={x2[idx+1]:.4f},                     
x2'={x2_dot[idx+1]:.4f}")                                                       
                                                                                
# Transition 2->3 (x1 approx 10.0)                                              
crossings_10 = np.where(np.diff((x1 >= 10.0).astype(int)) > 0)[0]               
for idx in crossings_10:                                                        
    print(f"\nJump at x1=10.0 (index {idx}):")                                  
    print(f"Before: x1={x1[idx]:.4f}, x2={x2[idx]:.4f}, x2'={x2_dot[idx]:.4f}") 
