from scipy.linalg import lstsq                                                  
                                                                                
def get_coefficients(sample_data, dt=0.001):                                    
    state = sample_data['state']                                                
    u1 = sample_data['input'][0]                                                
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    # Mode definitions                                                          
    # Mode 1: x1 < 5, x1 increasing                                             
    # Mode 2: 5 <= x1 < 10, x1 increasing                                       
    # Mode 3: x1 decreasing                                                     
                                                                                
    # x1 increasing: x1[k+1] > x1[k]                                            
    # We use np.diff for this.                                                  
    diff_x1 = np.diff(x1)                                                       
    increasing = diff_x1 > 0                                                    
    decreasing = diff_x1 < 0                                                    
                                                                                
    # Mode indices (for step k)                                                 
    mode1_idx = np.where((x1[:-1] < 5) & increasing)[0]                         
    mode2_idx = np.where((x1[:-1] >= 5) & (x1[:-1] < 10) & increasing)[0]       
    mode3_idx = np.where(decreasing)[0]                                         
                                                                                
    # Regression for Mode 2: x2[k+2] = a*x2[k+1] + b*x2[k] + c*u1[k] + d        
    # We need k, k+1, k+2 to be in Mode 2?                                      
    # Let's just find k such that k, k+1, k+2 are available and k is in Mode 2. 
    # Actually, the task says "Focus on Mode 2 (5 <= x1 < 10, x1 increasing) for
Samples 0 and 1."                                                               
    # Let's find valid triplets (k, k+1, k+2) where all are in Mode 2.          
                                                                                
    valid_k = []                                                                
    for k in mode2_idx:                                                         
        if k+2 < len(x2):                                                       
            # Check if k+1 is also in mode2_idx                                 
            if (k+1) in mode2_idx:                                              
                valid_k.append(k)                                               
                                                                                
    valid_k = np.array(valid_k)                                                 
                                                                                
    if len(valid_k) > 0:                                                        
        Y = x2[valid_k + 2]                                                     
        X = np.column_stack([                                                   
            x2[valid_k + 1],                                                    
            x2[valid_k],                                                        
            u1[valid_k],                                                        
            np.ones_like(valid_k, dtype=float)                                  
        ])                                                                      
                                                                                
        coeffs, residues, rank, s = lstsq(X, Y)                                 
        a, b, c, d = coeffs                                                     
    else:                                                                       
        a, b, c, d = None, None, None, None                                     
                                                                                
    # Verification for Mode 1 and 3: check if -3.0 and -25.0 are perfect        
    # The continuous model: dx2/dt = -p*x2 - q*x1 + u                           
    # Discretized: (x2[k+1] - x2[k])/dt = -3*x2[k] - 25*x1[k] + u1[k]           
    # Check residual of: x2[k+1] - x2[k] - dt*(-3*x2[k] - 25*x1[k] + u1[k])     
                                                                                
    def check_mode(indices):                                                    
        if len(indices) == 0: return None                                       
        # Use simple Euler for verification                                     
        target = (x2[indices+1] - x2[indices]) / dt                             
        model = -3.0 * x2[indices] - 25.0 * x1[indices] + u1[indices]           
        error = np.abs(target - model).mean()                                   
        return error                                                            
                                                                                
    err1 = check_mode(mode1_idx)                                                
    err3 = check_mode(mode3_idx)                                                
                                                                                
    return (a, b, c, d), err1, err3                                             
                                                                                
