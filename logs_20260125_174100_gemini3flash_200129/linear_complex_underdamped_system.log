def get_stats(file_idx):                                                        
    data = np.load(DATA_FILE_PATHS[file_idx])                                   
    state = data['state']                                                       
    u = data['input']                                                           
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    u1 = u[0, :]                                                                
    dt = 0.001                                                                  
                                                                                
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
