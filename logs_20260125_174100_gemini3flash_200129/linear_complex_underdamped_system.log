             'data_all/linear/complex_underdamped_system/sample_2.npz']:        
    all_data.append(analyze_sample(path))                                       
                                                                                
# Combine all data for fitting                                                  
def fit_mode(mode_idx):                                                         
    X = []                                                                      
    Y = []                                                                      
    DX1 = []                                                                    
    for (x1, x2, u, dx1, dx2, ddx2), (m1, m2, m3) in all_data:                  
        m = [m1, m2, m3][mode_idx]                                              
        if np.sum(m) > 0:                                                       
            # ddx2 = a*dx2 + b*x2 + c*u + d                                     
            # x2_dot is dx2                                                     
            X.append(np.column_stack([dx2[m], x2[m], u[m], np.ones(np.sum(m))]))
            Y.append(ddx2[m])                                                   
            DX1.append(dx1[m])                                                  
                                                                                
    if not X: return None, None                                                 
    X = np.vstack(X)                                                            
    Y = np.concatenate(Y)                                                       
    coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    avg_dx1 = np.mean(np.concatenate(DX1))                                      
    return coeffs, avg_dx1                                                      
                                                                                
