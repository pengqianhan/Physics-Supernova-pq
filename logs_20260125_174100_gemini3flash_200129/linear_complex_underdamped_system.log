import numpy as np                                                              
import pandas as pd                                                             
from scipy.stats import linregress                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    t = data['t']                                                               
    x = data['x']                                                               
    u = data['u']                                                               
                                                                                
    x1 = x[:, 0]                                                                
    x2 = x[:, 1]                                                                
    u1 = u[:, 0]                                                                
                                                                                
    # Calculate derivatives of x2                                               
    dx2_dt = np.gradient(x2, t)                                                 
    d2x2_dt2 = np.gradient(dx2_dt, t)                                           
                                                                                
    # Find segments                                                             
    dx1_dt = np.gradient(x1, t)                                                 
                                                                                
    mode2_mask = (x1 >= 5) & (x1 < 10) & (dx1_dt > 0)                           
    mode1_mask = (x1 < 5) & (dx1_dt > 0)                                        
    mode3_mask = (dx1_dt < 0)                                                   
                                                                                
    def get_coeffs(mask):                                                       
        if np.sum(mask) < 10: return None                                       
        Y = d2x2_dt2[mask]                                                      
        X = np.column_stack([dx2_dt[mask], x2[mask], u1[mask],                  
np.ones(np.sum(mask))])                                                         
        coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)          
        return coeffs                                                           
                                                                                
    coeffs_m2 = get_coeffs(mode2_mask)                                          
    coeffs_m1 = get_coeffs(mode1_mask)                                          
    coeffs_m3 = get_coeffs(mode3_mask)                                          
                                                                                
    return coeffs_m1, coeffs_m2, coeffs_m3                                      
                                                                                
results = []                                                                    
for path in DATA_FILE_PATHS:                                                    
    results.append(analyze_sample(path))                                        
                                                                                
