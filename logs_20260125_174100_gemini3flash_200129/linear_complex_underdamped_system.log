# Load the trajectory data from the NPZ files                                   
data_0 = np.load('data_all/linear/complex_underdamped_system/sample_0.npz')     
data_1 = np.load('data_all/linear/complex_underdamped_system/sample_1.npz')     
data_2 = np.load('data_all/linear/complex_underdamped_system/sample_2.npz')     
                                                                                
samples = [data_0, data_1, data_2]                                              
dt = 0.002  # Time step identified from dx1 values                              
                                                                                
all_mode_data = {1: [], 2: [], 3: []}                                           
                                                                                
for sample in samples:                                                          
    x1, x2 = sample['state'][0], sample['state'][1]                             
    u1 = sample['input'][0]                                                     
                                                                                
    # Calculate derivatives                                                     
    dx1 = (x1[1:] - x1[:-1]) / dt                                               
    dx2 = (x2[1:] - x2[:-1]) / dt                                               
    ddx2 = (dx2[1:] - dx2[:-1]) / dt                                            
                                                                                
    # Organize data by mode based on x1 and its trend                           
    for i in range(len(ddx2)):                                                  
        # x1[i+1] and x1[i] define dx1[i], use x1[i] for threshold              
        val_x1 = x1[i]                                                          
        val_dx1 = dx1[i]                                                        
                                                                                
        if val_dx1 > 0.5:                                                       
            if val_x1 < 4.999:                                                  
                mode = 1                                                        
            else:                                                               
                mode = 2                                                        
        elif val_dx1 < -0.5:                                                    
            mode = 3                                                            
        else:                                                                   
            continue                                                            
                                                                                
        # Store features for second-order ODE: x2[2] = a*x2[1] + b*x2[0] + c*u1 
+ d                                                                             
        all_mode_data[mode].append([dx2[i], x2[i], u1[i], 1.0, ddx2[i]])        
                                                                                
# Fit models for each mode                                                      
model_results = {}                                                              
for mode in [1, 2, 3]:                                                          
    arr = np.array(all_mode_data[mode])                                         
    X = arr[:, :4]                                                              
    y = arr[:, 4]                                                               
    beta, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)                
    model_results[mode] = beta                                                  
                                                                                
# Check for resets at transitions                                               
# Transition 1->2 (x1 crosses 5)                                                
# Transition 2->3 (x1 reaches 10)                                               
                                                                                
def get_transition_jump(sample, target_x1, mode_change):                        
    x1, x2 = sample['state'][0], sample['state'][1]                             
    u1 = sample['input'][0]                                                     
                                                                                
    if mode_change == '1to2':                                                   
        idx = np.where(x1 >= target_x1 - 1e-7)[0][0]                            
    else: # 2to3 at peak                                                        
        idx = np.argmax(x1)                                                     
                                                                                
    # State before transition (last point of previous mode)                     
    x1_pre, x2_pre = x1[idx], x2[idx]                                           
    dx1_pre = (x1[idx] - x1[idx-1]) / dt                                        
    dx2_pre = (x2[idx] - x2[idx-1]) / dt                                        
                                                                                
    # State after transition (first point of next mode)                         
    x1_post, x2_post = x1[idx+1], x2[idx+1]                                     
    dx1_post = (x1[idx+1] - x1[idx]) / dt                                       
    dx2_post = (x2[idx+2] - x2[idx+1]) / dt # use idx+1 to idx+2 for post-jump  
velocity                                                                        
                                                                                
    return {                                                                    
