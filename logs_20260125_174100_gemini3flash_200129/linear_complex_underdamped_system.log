    if len(indices) > 0:                                                        
        # Find segments                                                         
        diff_indices = np.diff(indices)                                         
        breaks = np.where(diff_indices > 1)[0]                                  
        segment_ranges = []                                                     
        last_break = -1                                                         
        for b in breaks:                                                        
            segment_ranges.append(indices[last_break+1 : b+1])                  
            last_break = b                                                      
        segment_ranges.append(indices[last_break+1 :])                          
                                                                                
        for seg in segment_ranges:                                              
            if len(seg) < 5: continue                                           
