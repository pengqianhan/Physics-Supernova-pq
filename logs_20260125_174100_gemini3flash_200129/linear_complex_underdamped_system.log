import numpy as np                                                              
from scipy import stats                                                         
import pandas as pd                                                             
                                                                                
def process_sample(file_path, dt=0.01):                                         
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    u = data['input'][0]                                                        
                                                                                
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    # Calculate derivatives                                                     
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
    d2x2 = np.diff(dx2) / dt                                                    
                                                                                
    # Align lengths                                                             
    x1_aligned = x1[:-1]                                                        
    dx1_aligned = dx1                                                           
                                                                                
    x2_0 = x2[:-2]                                                              
    x2_1 = dx2[:-1]                                                             
    x2_2 = d2x2                                                                 
    u_aligned = u[:-2]                                                          
    x1_for_x2 = x1[:-2]                                                         
    dx1_for_x2 = dx1[:-1]                                                       
                                                                                
    # Identify modes                                                            
    # Mode 1: x1 < 5 and dx1 > 0                                                
    # Mode 2: 5 <= x1 < 10 and dx1 > 0                                          
    # Mode 3: dx1 < 0                                                           
                                                                                
    # Use dx1_aligned to find regions                                           
    m1_indices = np.where((x1_aligned < 5) & (dx1_aligned > 0.001))[0]          
    m2_indices = np.where((x1_aligned >= 5) & (x1_aligned < 10) & (dx1_aligned >
0.001))[0]                                                                      
                                                                                
    # For Mode 3, we look for where x1 starts decreasing after reaching near 10 
    peak_idx = np.argmax(x1)                                                    
    m3_indices_full = np.where((np.arange(len(x1_aligned)) > peak_idx) &        
(dx1_aligned < -0.001))[0]                                                      
                                                                                
    results = {}                                                                
                                                                                
    for mode_name, idxs in [("Mode 1", m1_indices), ("Mode 2", m2_indices),     
("Mode 3", m3_indices_full)]:                                                   
        if len(idxs) < 10:                                                      
            continue                                                            
                                                                                
        # x1 dynamics: dx1 = slope                                              
        slope = np.mean(dx1_aligned[idxs])                                      
                                                                                
        # x2 dynamics: d2x2 = a*dx2 + b*x2 + c*u + d                            
        # We need to filter indices to match the length of x2_2 (N-2)           
        idxs_x2 = [i for i in idxs if i < len(x2_2)]                            
        if len(idxs_x2) < 10:                                                   
            continue                                                            
                                                                                
        Y = x2_2[idxs_x2]                                                       
        X = np.column_stack([x2_1[idxs_x2], x2_0[idxs_x2], u_aligned[idxs_x2],  
np.ones(len(idxs_x2))])                                                         
                                                                                
        # Solve least squares                                                   
        coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)          
        a, b, c, d = coeffs                                                     
                                                                                
        results[mode_name] = {                                                  
            'slope': slope,                                                     
            'a': a, 'b': b, 'c': c, 'd': d,                                     
            'interval': (idxs[0]*dt, idxs[-1]*dt)                               
        }                                                                       
    return results                                                              
                                                                                
all_results = []                                                                
dt = 0.01                                                                       
for i in range(3):                                                              
    path = f'data_all/linear/complex_underdamped_system/sample_{i}.npz'         
    all_results.append(process_sample(path, dt))                                
                                                                                
# Average coefficients across samples                                           
