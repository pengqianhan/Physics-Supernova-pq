import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    u = data['input']                                                           
                                                                                
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    u1 = u[0, :]                                                                
                                                                                
    # Identify modes                                                            
    # Mode 1: 0 <= x1 < 5                                                       
    # Mode 2: 5 <= x1 < 10                                                      
    # Mode 3: x1 >= 10 or decreasing                                            
                                                                                
    # Find indices for each mode                                                
    # To handle "or when x1 starts decreasing", let's find the peak of x1       
    peak_idx = np.argmax(x1)                                                    
                                                                                
    mode1_indices = np.where((x1 >= 0) & (x1 < 5) & (np.arange(len(x1)) <       
peak_idx))[0]                                                                   
    mode2_indices = np.where((x1 >= 5) & (x1 < 10) & (np.arange(len(x1)) <      
peak_idx))[0]                                                                   
    mode3_indices = np.where((x1 >= 10) | (np.arange(len(x1)) >= peak_idx))[0]  
                                                                                
    results = {}                                                                
                                                                                
    for mode_name, indices in zip(['Mode 1', 'Mode 2', 'Mode 3'],               
[mode1_indices, mode2_indices, mode3_indices]):                                 
        if len(indices) < 10:                                                   
            continue                                                            
                                                                                
        # x1 slope (discrete difference)                                        
        dx1 = np.diff(x1[indices])                                              
        avg_slope = np.mean(dx1)                                                
                                                                                
        # x2 second order fit: x2[k+2] = a*x2[k+1] + b*x2[k] + c*u[k] + d       
        # Prepare regression matrix                                             
        # indices are contiguous? Let's assume they are within the mode         
        # We need k, k+1, k+2 to be in the same mode                            
        valid_k = []                                                            
        for i in range(len(indices) - 2):                                       
            if indices[i+2] == indices[i] + 2:                                  
                valid_k.append(indices[i])                                      
                                                                                
        if len(valid_k) > 10:                                                   
            valid_k = np.array(valid_k)                                         
            Y = x2[valid_k + 2]                                                 
            X = np.column_stack([                                               
                x2[valid_k + 1],                                                
                x2[valid_k],                                                    
                u1[valid_k],                                                    
                np.ones(len(valid_k))                                           
            ])                                                                  
                                                                                
            # Solve least squares                                               
            coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)      
            a, b, c, d = coeffs                                                 
        else:                                                                   
            a, b, c, d = (None, None, None, None)                               
                                                                                
        results[mode_name] = {                                                  
            'x1_slope': avg_slope,                                              
            'a': a, 'b': b, 'c': c, 'd': d,                                     
            'x1_range': (np.min(x1[indices]), np.max(x1[indices]))              
        }                                                                       
                                                                                
    # Check resets/discontinuities at boundaries                                
    # Boundary 1: x1 crosses 5                                                  
    # Boundary 2: x1 crosses 10                                                 
                                                                                
    return results                                                              
                                                                                
# Process all files and average results                                         
all_results = []                                                                
for path in DATA_FILE_PATHS:                                                    
    all_results.append(analyze_sample(path))                                    
                                                                                
print(all_results[0])                                                           
                                                                                
