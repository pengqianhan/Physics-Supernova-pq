import numpy as np                                                              
                                                                                
def get_derivatives(y, dt):                                                     
    dy = np.diff(y) / dt                                                        
    return dy                                                                   
                                                                                
def solve_x2_dynamics(d2x2, dx2, x2, u, indices):                               
    if len(indices) < 10:                                                       
        return None                                                             
                                                                                
    # Model: d2x2 = a*dx2 + b*x2 + c*u + d                                      
    Y = d2x2[indices]                                                           
    X = np.column_stack([dx2[indices], x2[indices], u[indices],                 
np.ones_like(indices)])                                                         
                                                                                
    try:                                                                        
        coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                     
        return coeffs # [a, b, c, d]                                            
    except:                                                                     
        return None                                                             
                                                                                
dt = 0.01                                                                       
all_sample_results = []                                                         
                                                                                
for i in range(3):                                                              
    data = np.load(f'data_all/linear/complex_underdamped_system/sample_{i}.npz')
    state = data['state']                                                       
    u1 = data['input'][0]                                                       
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    dx1 = get_derivatives(x1, dt)                                               
    dx2 = get_derivatives(x2, dt)                                               
    d2x2 = get_derivatives(dx2, dt)                                             
                                                                                
    # Align arrays for regression (length N-2)                                  
    x1_eval = x1[:-2]                                                           
    dx1_eval = dx1[:-1]                                                         
    dx2_eval = dx2[:-1]                                                         
    x2_eval = x2[:-2]                                                           
    u1_eval = u1[:-2]                                                           
                                                                                
    # Mode identification indices (N-2)                                         
    # Mode 1: x1 < 5 and increasing                                             
    # Mode 2: 5 <= x1 < 10 and increasing                                       
    # Mode 3: x1 decreasing                                                     
                                                                                
    m1_idx = np.where((x1_eval < 5) & (dx1_eval > 1e-4))[0]                     
    m2_idx = np.where((x1_eval >= 5) & (x1_eval < 10) & (dx1_eval > 1e-4))[0]   
    m3_idx = np.where(dx1_eval < -1e-4)[0]                                      
                                                                                
    sample_res = {}                                                             
    for m_name, idxs in [("Mode 1", m1_idx), ("Mode 2", m2_idx), ("Mode 3",     
m3_idx)]:                                                                       
        if len(idxs) > 0:                                                       
            slope = np.mean(dx1_eval[idxs])                                     
            coeffs = solve_x2_dynamics(d2x2, dx2_eval, x2_eval, u1_eval, idxs)  
            interval = (idxs[0]*dt, idxs[-1]*dt)                                
            sample_res[m_name] = {'slope': slope, 'coeffs': coeffs, 'interval': 
interval}                                                                       
                                                                                
    all_sample_results.append(sample_res)                                       
                                                                                
# Aggregation                                                                   
final_summary = {}                                                              
for m_name in ["Mode 1", "Mode 2", "Mode 3"]:                                   
    slopes = [s[m_name]['slope'] for s in all_sample_results if m_name in s]    
    coeffs_list = [s[m_name]['coeffs'] for s in all_sample_results if m_name in 
s and s[m_name]['coeffs'] is not None]                                          
                                                                                
    if slopes:                                                                  
        avg_slope = np.mean(slopes)                                             
        avg_coeffs = np.mean(coeffs_list, axis=0) if coeffs_list else None      
                                                                                
        # Get intervals from samples that have the mode                         
        intervals = [s[m_name]['interval'] for s in all_sample_results if m_name
in s]                                                                           
                                                                                
        final_summary[m_name] = {                                               
            'slope': avg_slope,                                                 
            'coeffs': avg_coeffs,                                               
            'intervals': intervals                                              
        }                                                                       
                                                                                
# Print results for formatting                                                  
for m, data in final_summary.items():                                           
    print(f"--- {m} ---")                                                       
    print(f"Slope: {data['slope']:.4f}")                                        
    if data['coeffs'] is not None:                                              
        print(f"Coeffs (a,b,c,d): {data['coeffs']}")                            
    print(f"Intervals: {data['intervals']}")                                    
                                                                                
# Build the final answer string                                                 
detailed_version = "Analysis of system dynamics across 3 samples:\n\n"          
for m_name in ["Mode 1", "Mode 2", "Mode 3"]:                                   
    if m_name in final_summary:                                                 
        res = final_summary[m_name]                                             
        c = res['coeffs']                                                       
        detailed_version += f"### {m_name}\n"                                   
        detailed_version += f"- **Time Intervals**: " + ",                      
".join([f"[{start:.2f}s, {end:.2f}s]" for start, end in res['intervals']]) +    
