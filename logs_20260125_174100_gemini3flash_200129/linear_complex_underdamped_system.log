derivative of x1 (x2)                                                           
                                                                                
def get_coeffs_final(mask):                                                     
    if np.sum(mask) == 0: return [0,0,0,0]                                      
    X = np.column_stack([x2_dot_val[mask], x2_val[mask], u1_val[mask],          
np.ones(np.sum(mask))])                                                         
    Y = y[mask]                                                                 
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
c1 = get_coeffs_final(m1)                                                       
c2 = get_coeffs_final(m2)                                                       
c3 = get_coeffs_final(m3)                                                       
                                                                                
