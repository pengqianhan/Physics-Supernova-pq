    x1 = x[:, 0]                                                                
    x2 = x[:, 1]                                                                
    u1 = u[:, 0]                                                                
                                                                                
    # Finite differences                                                        
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
    # Segment modes                                                             
    # We use a simple threshold for dx1 to distinguish between increasing and   
decreasing x1                                                                   
    for i in range(len(t)):                                                     
        # Determine mode                                                        
