        # Modes                                                                 
        modes = np.zeros(len(x1), dtype=int)                                    
        decreasing = False                                                      
        for j in range(len(x1)):                                                
            if j > 0 and x1[j] < x1[j-1]: decreasing = True                     
            if x1[j] >= 10 or decreasing: modes[j] = 3                          
            elif x1[j] >= 5: modes[j] = 2                                       
            else: modes[j] = 1                                                  
                                                                                
