def analyze_continuous_params(theta, T):                                        
    alpha, beta, gamma, delta = theta                                           
    # beta = -(1 + A*T)                                                         
    A = -(1 + beta) / T                                                         
    # alpha = 2 + A*T + B*T^2                                                   
    # B*T^2 = alpha - 2 - A*T = alpha - 2 + (1 + beta) = alpha + beta - 1       
    B = (alpha + beta - 1) / (T**2)                                             
    # gamma = C * T^2                                                           
    C = gamma / (T**2)                                                          
    # delta = D * T^2                                                           
    D = delta / (T**2)                                                          
    return A, B, C, D                                                           
                                                                                
