import numpy as np                                                              
                                                                                
def get_clean_coeffs(data_path, x1_range=None, x1_increasing=True):             
    data = np.load(data_path)                                                   
    x1 = data['state'][0, :]                                                    
    x2 = data['state'][1, :]                                                    
    u1 = data['input'][0, :]                                                    
    dt = 0.001                                                                  
                                                                                
    idx_max = np.argmax(x1)                                                     
    if x1_increasing:                                                           
        mask = (np.arange(len(x1)) < idx_max)                                   
    else:                                                                       
        mask = (np.arange(len(x1)) > idx_max)                                   
                                                                                
    if x1_range:                                                                
        mask &= (x1 >= x1_range[0]) & (x1 < x1_range[1])                        
                                                                                
    indices = np.where(mask)[0]                                                 
    if len(indices) < 10: return None                                           
                                                                                
    # Use central diff on the masked segment                                    
    s, e = indices[0], indices[-1]                                              
    x2_seg = x2[s:e+1]                                                          
    u1_seg = u1[s:e+1]                                                          
                                                                                
    dx2 = (x2_seg[2:] - x2_seg[:-2]) / (2 * dt)                                 
    ddx2 = (x2_seg[2:] - 2 * x2_seg[1:-1] + x2_seg[:-2]) / (dt ** 2)            
    A = np.column_stack([dx2, x2_seg[1:-1], u1_seg[1:-1], np.ones(len(dx2))])   
    coeffs, _, _, _ = np.linalg.lstsq(A, ddx2, rcond=None)                      
    return coeffs                                                               
                                                                                
