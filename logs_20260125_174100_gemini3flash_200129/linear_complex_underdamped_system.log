import numpy as np                                                              
                                                                                
def fit_ode_clean(x, u, dt, mask):                                              
    if np.sum(mask) < 20: return None                                           
    # Find contiguous segments of the mask                                      
    indices = np.where(mask)[0]                                                 
    segments = []                                                               
    if len(indices) == 0: return None                                           
                                                                                
    current_seg = [indices[0]]                                                  
    for i in range(1, len(indices)):                                            
        if indices[i] == indices[i-1] + 1:                                      
            current_seg.append(indices[i])                                      
        else:                                                                   
            segments.append(current_seg)                                        
            current_seg = [indices[i]]                                          
    segments.append(current_seg)                                                
                                                                                
    all_Y = []                                                                  
    all_Feat = []                                                               
                                                                                
    for seg in segments:                                                        
        if len(seg) < 10: continue                                              
        # Use only interior points for derivatives                              
        s = np.array(seg)                                                       
        # x2_ddot[k] = (x2[k+1] - 2*x2[k] + x2[k-1]) / dt^2                     
        # Use indices from s[1:-1]                                              
        idx = s[1:-1]                                                           
        Y = (x[1, idx+1] - 2*x[1, idx] + x[1, idx-1]) / (dt**2)                 
        x2dot = (x[1, idx+1] - x[1, idx-1]) / (2*dt)                            
        Feat = np.stack([x2dot, x[1, idx], u[0, idx], np.ones(len(idx))],       
axis=1)                                                                         
        all_Y.append(Y)                                                         
        all_Feat.append(Feat)                                                   
                                                                                
    if not all_Y: return None                                                   
                                                                                
    Y = np.concatenate(all_Y)                                                   
    Feat = np.concatenate(all_Feat)                                             
                                                                                
    theta, _, _, _ = np.linalg.lstsq(Feat, Y, rcond=None)                       
    y_pred = np.dot(Feat, theta)                                                
    r2 = 1 - (np.sum((Y - y_pred)**2) / np.sum((Y - np.mean(Y))**2))            
    return theta, r2                                                            
                                                                                
