import numpy as np                                                              
                                                                                
def fit_discrete(x2, u, mask):                                                  
    # x2[k+1] = a*x2[k] + b*x2[k-1] + c*u[k] + d                                
    if np.sum(mask) < 20: return None                                           
                                                                                
    indices = np.where(mask)[0]                                                 
    # Filter indices to ensure we have k, k-1, k+1 within the same mask         
    valid = []                                                                  
    for i in indices:                                                           
        if i > 0 and i < len(x2)-1 and mask[i-1] and mask[i+1]:                 
            valid.append(i)                                                     
                                                                                
    if len(valid) < 10: return None                                             
                                                                                
    valid = np.array(valid)                                                     
    Y = x2[valid + 1]                                                           
    Feat = np.stack([x2[valid], x2[valid-1], u[valid], np.ones(len(valid))],    
axis=1)                                                                         
                                                                                
    theta, _, _, _ = np.linalg.lstsq(Feat, Y, rcond=None)                       
    y_pred = np.dot(Feat, theta)                                                
    r2 = 1 - (np.sum((Y - y_pred)**2) / np.sum((Y - np.mean(Y))**2))            
    return theta, r2                                                            
                                                                                
for i in range(3):                                                              
