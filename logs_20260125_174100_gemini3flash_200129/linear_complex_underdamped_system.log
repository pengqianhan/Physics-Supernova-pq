  import numpy as np                                                            
  import pandas as pd                                                           
                                                                                
  # Load data                                                                   
  data0 = np.load('data_all/linear/complex_underdamped_system/sample_0.npz')    
  data1 = np.load('data_all/linear/complex_underdamped_system/sample_1.npz')    
                                                                                
  dt = 0.01                                                                     
                                                                                
  def process_detailed(s, u):                                                   
      x1, x2 = s[0, :], s[1, :]                                                 
      u1_vals = u[0, :]                                                         
      x1_dot = np.gradient(x1, dt)                                              
      x2_dot = np.gradient(x2, dt)                                              
      x2_ddot = np.gradient(x2_dot, dt)                                         
                                                                                
      modes = np.zeros(len(x1))                                                 
      for i in range(len(x1)):                                                  
          inc = x1_dot[i] > 1e-3                                                
          val = x1[i]                                                           
          if inc and val < 5.0: modes[i] = 1                                    
          elif inc and 5.0 <= val < 10.0: modes[i] = 2                          
          else: modes[i] = 3                                                    
                                                                                
      return pd.DataFrame({                                                     
          'x1': x1, 'x2': x2, 'u1': u1_vals,                                    
          'x1_dot': x1_dot, 'x2_dot': x2_dot, 'x2_ddot': x2_ddot,               
          'mode': modes                                                         
      })                                                                        
                                                                                
  df0 = process_detailed(data0['state'], data0['input'])                        
  df1 = process_detailed(data1['state'], data1['input'])                        
                                                                                
  def get_trans_info(df):                                                       
      trans = []                                                                
      for i in range(len(df)-1):                                                
          if df.iloc[i]['mode'] != df.iloc[i+1]['mode']:                        
              trans.append({                                                    
                  'from': int(df.iloc[i]['mode']),                              
                  'to': int(df.iloc[i+1]['mode']),                              
                  'x2_pre': df.iloc[i]['x2'],                                   
                  'x2_post': df.iloc[i+1]['x2'],                                
                  'x2_dot_pre': df.iloc[i]['x2_dot'],                           
                  'x2_dot_post': df.iloc[i+1]['x2_dot']                         
              })                                                                
      return trans                                                              
                                                                                
  print("Trans 0:", get_trans_info(df0))                                        
  print("Trans 1:", get_trans_info(df1))                                        
