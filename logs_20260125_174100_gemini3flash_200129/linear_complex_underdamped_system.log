import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the primary data file                                                    
data = np.load(DATA_FILE_PATH)                                                  
print("Keys in the NPZ file:", data.files)                                      
                                                                                
# Extract relevant fields                                                       
t = data['t']                                                                   
x = data['x']  # Assuming x has columns for x1, x2                              
u = data['u']  # Assuming u contains u1                                         
                                                                                
# Determine dt and total_time                                                   
dt = t[1] - t[0]                                                                
total_time = t[-1] - t[0]                                                       
print(f"dt: {dt}, total_time: {total_time}")                                    
                                                                                
# Extract x1, x2, and u1                                                        
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
u1 = u[:, 0]                                                                    
                                                                                
# Calculate derivatives for x2 using finite differences                         
dx2 = np.gradient(x2, dt)                                                       
ddx2 = np.gradient(dx2, dt)                                                     
                                                                                
# Identify modes                                                                
# Mode 1: x1 < 5                                                                
# Mode 2: 5 <= x1 < 10                                                          
# Mode 3: x1 starts decreasing after 10                                         
mode1_indices = np.where(x1 < 4.999)[0]                                         
mode2_indices = np.where((x1 >= 5.0) & (x1 < 9.999) & (np.gradient(x1) > 0))[0] 
mode3_indices = np.where(np.gradient(x1) < -0.01)[0]                            
                                                                                
# Helper function to solve for (a, b, c, d) using least squares                 
def solve_dynamics(indices, x2, dx2, ddx2, u1):                                 
    if len(indices) < 5:                                                        
        return None                                                             
    A = np.column_stack([dx2[indices], x2[indices], u1[indices],                
np.ones_like(indices)])                                                         
    y = ddx2[indices]                                                           
    params, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    return params                                                               
                                                                                
# Calculate parameters for each mode                                            
params_m1 = solve_dynamics(mode1_indices, x2, dx2, ddx2, u1)                    
params_m2 = solve_dynamics(mode2_indices, x2, dx2, ddx2, u1)                    
params_m3 = solve_dynamics(mode3_indices, x2, dx2, ddx2, u1)                    
                                                                                
print("Mode 1 (a, b, c, d):", params_m1)                                        
print("Mode 2 (a, b, c, d):", params_m2)                                        
print("Mode 3 (a, b, c, d):", params_m3)                                        
                                                                                
# Check x1 dynamics                                                             
dx1_m1 = np.mean(np.gradient(x1[mode1_indices], dt))                            
dx1_m2 = np.mean(np.gradient(x1[mode2_indices], dt))                            
dx1_m3 = np.mean(np.gradient(x1[mode3_indices], dt))                            
print(f"x1' in Mode 1: {dx1_m1}, Mode 2: {dx1_m2}, Mode 3: {dx1_m3}")           
                                                                                
# Check for resets at transitions                                               
# Transition 1: Mode 1 to Mode 2 (x1 ~ 5)                                       
idx_t1 = np.where(np.diff((x1 >= 5.0).astype(int)) > 0)[0]                      
if len(idx_t1) > 0:                                                             
    idx = idx_t1[0]                                                             
    print(f"Reset at x1=5: x2 before={x2[idx]}, after={x2[idx+1]},              
