        x1 = data['state'][0]                                                   
        x2 = data['state'][1]                                                   
        u1 = data['input'][0]                                                   
        dx1 = np.diff(x1)                                                       
                                                                                
        if mode_id == 1:                                                        
            indices = np.where((x1[:-2] < 5) & (dx1[:-1] > 0))[0]               
        elif mode_id == 2:                                                      
            indices = np.where((x1[:-2] >= 5) & (x1[:-2] < 10) & (dx1[:-1] >    
0))[0]                                                                          
        elif mode_id == 3:                                                      
            indices = np.where(dx1[:-1] < 0)[0]                                 
                                                                                
        if len(indices) < 5:                                                    
            continue                                                            
                                                                                
        dx2 = np.diff(x2) / dt                                                  
        ddx2 = np.diff(dx2) / dt                                                
                                                                                
        # Using centered or forward?                                            
        # ddx2[i] = (x2[i+2] - 2*x2[i+1] + x2[i]) / dt^2                        
        # This is the acceleration at t[i+1]                                    
        # x2_dot at t[i+1] is roughly (x2[i+2]-x2[i])/(2*dt)                    
        for idx in indices:                                                     
