      all_trajs.append({'x': data['state'], 'u': data['input']})                
                                                                                
  # Analysis of x1 to see its range and behavior                                
  x1_min = 100                                                                  
  x1_max = -100                                                                 
  for traj in all_trajs:                                                        
      x1_min = min(x1_min, np.min(traj['x'][0, :]))                             
      x1_max = max(x1_max, np.max(traj['x'][0, :]))                             
                                                                                
  print(f"x1 range: {x1_min} to {x1_max}")                                      
                                                                                
  # Redefine modes and gather samples                                           
  # Mode 1: x1 < 5.0                                                            
  # Mode 2: 5.0 <= x1 < 10.0                                                    
  # Mode 3: x1 >= 10.0 OR has reached 10.0 (let's check if it turns back)       
                                                                                
  def analyze_trajectory(x, u):                                                 
      T = x.shape[1]                                                            
      modes = np.zeros(T)                                                       
      has_reached_10 = False                                                    
      for k in range(T):                                                        
          x1 = x[0, k]                                                          
          if not has_reached_10:                                                
              if x1 < 5.0:                                                      
                  modes[k] = 1                                                  
              elif x1 < 10.0:                                                   
                  modes[k] = 2                                                  
              else:                                                             
                  modes[k] = 3                                                  
                  has_reached_10 = True                                         
          else:                                                                 
              modes[k] = 3                                                      
      return modes                                                              
                                                                                
  all_mode_samples = {1: [], 2: [], 3: []}                                      
  all_x1_diffs = {1: [], 2: [], 3: []}                                          
  all_resets = []                                                               
                                                                                
  for traj in all_trajs:                                                        
      x = traj['x']                                                             
      u = traj['u']                                                             
      T = x.shape[1]                                                            
      modes = analyze_trajectory(x, u)                                          
                                                                                
      for k in range(T - 2):                                                    
          m_k = modes[k]                                                        
          m_k1 = modes[k+1]                                                     
          m_k2 = modes[k+2]                                                     
                                                                                
          # x1 dynamics                                                         
          all_x1_diffs[m_k].append(x[0, k+1] - x[0, k])                         
                                                                                
          # x2 ODE samples                                                      
          if m_k == m_k1 == m_k2:                                               
              all_mode_samples[m_k].append([x[1, k+1], x[1, k], u[0, k], 1.0,   
  x[1, k+2]])                                                                   
                                                                                
          # Transitions                                                         
          if m_k != m_k1:                                                       
              all_resets.append({                                               
                  'from': m_k, 'to': m_k1,                                      
                  'x1_jump': x[0, k+1] - x[0, k],                               
                  'x2_jump': x[1, k+1] - x[1, k],                               
                  'x2_dot_jump': (x[1, k+2] - x[1, k+1]) - (x[1, k+1] - x[1,    
  k])                                                                           
              })                                                                
                                                                                
  # Final Results                                                               
  coeffs = {}                                                                   
  for m in [1, 2, 3]:                                                           
      data = np.array(all_mode_samples[m])                                      
      if len(data) > 0:                                                         
          A = data[:, :4]                                                       
          B = data[:, 4]                                                        
          sol, _, _, _ = np.linalg.lstsq(A, B, rcond=None)                      
          coeffs[m] = sol                                                       
      else:                                                                     
          coeffs[m] = "No data"                                                 
                                                                                
  x1_vel = {m: np.mean(all_x1_diffs[m]) if all_x1_diffs[m] else "No data" for   
  m in [1, 2, 3]}                                                               
                                                                                
  print("Coefficients:", coeffs)                                                
  print("x1 velocities:", x1_vel)                                               
  print("Resets count:", len(all_resets))                                       
  if all_resets:                                                                
      import collections                                                        
      summary = collections.defaultdict(list)                                   
      for r in all_resets:                                                      
          summary[(r['from'], r['to'])].append(r['x2_jump'])                    
      for k, v in summary.items():                                              
          print(f"Transition {k}: avg x2 jump = {np.mean(v)}")                  
                                                                                
  # Check x1[1] = 1.0 or -1.0 claim                                             
  # Assuming dt = 0.001                                                         
  for m in [1, 2, 3]:                                                           
      if isinstance(x1_vel[m], (float, np.float64)):                            
          print(f"Mode {m} dot{x1} approx: {x1_vel[m] / 0.001}")                
