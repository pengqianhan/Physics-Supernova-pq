import numpy as np                                                              
                                                                                
def get_derivatives(x, dt):                                                     
    dx = np.zeros_like(x)                                                       
    dx[:, 1:-1] = (x[:, 2:] - x[:, :-2]) / (2 * dt)                             
    dx[:, 0] = (x[:, 1] - x[:, 0]) / dt                                         
    dx[:, -1] = (x[:, -1] - x[:, -2]) / dt                                      
    ddx = np.zeros_like(x)                                                      
    ddx[:, 1:-1] = (x[:, 2:] - 2 * x[:, 1:-1] + x[:, :-2]) / (dt**2)            
    ddx[:, 0] = ddx[:, 1]                                                       
    ddx[:, -1] = ddx[:, -2]                                                     
    return dx, ddx                                                              
                                                                                
dt = 0.01                                                                       
                                                                                
def fit_ode(X2, X2dot, X2ddot, U, mask):                                        
    if np.sum(mask) < 20: return None                                           
    Y = X2ddot[mask]                                                            
    Feat = np.stack([X2dot[mask], X2[mask], U[mask], np.ones(np.sum(mask))],    
axis=1)                                                                         
    theta, _, _, _ = np.linalg.lstsq(Feat, Y, rcond=None)                       
    y_pred = np.dot(Feat, theta)                                                
    r2 = 1 - (np.sum((Y - y_pred)**2) / np.sum((Y - np.mean(Y))**2))            
    return theta, r2                                                            
                                                                                
all_res = []                                                                    
                                                                                
for i in range(3):                                                              
