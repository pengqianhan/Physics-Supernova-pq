import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
def process_data():                                                             
    all_data = []                                                               
    dt = 0.001                                                                  
                                                                                
    for i, path in enumerate(DATA_FILE_PATHS):                                  
        data = np.load(path)                                                    
        states = data['state'] # (2, 10001)                                     
        u1 = data['input'][0]   # (10001,)                                      
        x1 = states[0]                                                          
        x2 = states[1]                                                          
        t = np.arange(len(x1)) * dt                                             
                                                                                
        # Derivatives                                                           
        dx1 = np.gradient(x1, dt)                                               
        dx2 = np.gradient(x2, dt)                                               
        ddx2 = np.gradient(dx2, dt)                                             
                                                                                
        # Identify mode                                                         
        # Mode 1: x1 < 5.0 and increasing                                       
        # Mode 2: 5.0 <= x1 < 10.0 and increasing                               
        # Mode 3: x1 >= 10.0 or decreasing                                      
                                                                                
        modes = np.zeros(len(x1), dtype=int)                                    
        has_reached_10 = False                                                  
        for j in range(len(x1)):                                                
            if x1[j] >= 10.0:                                                   
                has_reached_10 = True                                           
                                                                                
            if has_reached_10:                                                  
                modes[j] = 3                                                    
            elif x1[j] < 5.0:                                                   
                modes[j] = 1                                                    
            elif 5.0 <= x1[j] < 10.0:                                           
                modes[j] = 2                                                    
                                                                                
        df = pd.DataFrame({                                                     
            'sample': i, 't': t, 'x1': x1, 'x2': x2, 'u1': u1,                  
            'dx1': dx1, 'dx2': dx2, 'ddx2': ddx2, 'mode': modes,                
            'x2_sq': x2**2, 'x1x2': x1*x2                                       
        })                                                                      
        all_data.append(df)                                                     
                                                                                
    full_df = pd.concat(all_data)                                               
                                                                                
    results = {}                                                                
    for m in [1, 2, 3]:                                                         
        m_df = full_df[full_df['mode'] == m]                                    
                                                                                
        # Regression for x1                                                     
        b1 = m_df['dx1'].mean()                                                 
                                                                                
        # Regression for x2: ddx2 = a*dx2 + b*x2 + c*u1 + d                     
        X = m_df[['dx2', 'x2', 'u1']]                                           
        y = m_df['ddx2']                                                        
        reg = LinearRegression().fit(X, y)                                      
        a, b, c = reg.coef_                                                     
        d = reg.intercept_                                                      
                                                                                
        # Nonlinear check                                                       
        X_nl = m_df[['dx2', 'x2', 'u1', 'x2_sq', 'x1x2']]                       
        reg_nl = LinearRegression().fit(X_nl, y)                                
                                                                                
        results[m] = {                                                          
            'b1': b1, 'a': a, 'b': b, 'c': c, 'd': d,                           
            'nl_coefs': reg_nl.coef_[-2:]                                       
        }                                                                       
                                                                                
    # Reset analysis (Transition points in sample 0)                            
    s0 = all_data[0]                                                            
    # Transition 1: Mode 1 to 2                                                 
    idx1 = s0[s0['mode'] == 1].index[-1]                                        
    t1_left = s0.loc[idx1]                                                      
    t1_right = s0.loc[idx1+1]                                                   
                                                                                
    # Transition 2: Mode 2 to 3                                                 
    idx2 = s0[s0['mode'] == 2].index[-1]                                        
    t2_left = s0.loc[idx2]                                                      
    t2_right = s0.loc[idx2+1]                                                   
                                                                                
    return results, (t1_left, t1_right, t2_left, t2_right)                      
                                                                                
