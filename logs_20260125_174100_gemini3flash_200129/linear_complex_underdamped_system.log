        data = np.load(path)                                                    
        x = data['state'].T                                                     
        xd = np.diff(x, axis=0) / dt                                            
        for i in range(len(x)-1):                                               
            # Transition 1 -> 2 (x1 crosses 5)                                  
            if x[i, 0] < 5 <= x[i+1, 0]:                                        
                resets.append({"type": "1->2", "dx2": x[i+1, 1] - x[i, 1],      
"dxd2": xd[i, 1] - (xd[i-1, 1] if i>0 else xd[i, 1])})                          
            # Transition 2 -> 3 (x1 crosses 10 or x1 starts decreasing)         
            if x[i, 0] < 10 <= x[i+1, 0]:                                       
                resets.append({"type": "2->3", "dx2": x[i+1, 1] - x[i, 1],      
"dxd2": xd[i, 1] - xd[i-1, 1]})                                                 
                                                                                
    return results, resets                                                      
                                                                                
results, resets = analyze_fixed()                                               
