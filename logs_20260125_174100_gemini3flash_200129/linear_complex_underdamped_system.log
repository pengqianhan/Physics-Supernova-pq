│         "input": "u1",                                                       │
│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[2\] = x1[1\] + x1[0\] + x1[0\] ** 2 + u1"          │
│             }                                                                │
│         ],                                                                   │
│         "edge": []                                                           │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.001,                                                         │
│         "total_time": 10.0,                                                  │
│         "order": 2,                                                          │
│         "need_reset": false,                                                 │
│         "non_linear_items": "x1[?\] ** 2"                                    │
│     }                                                                        │
│ }                                                                            │
│ ```                                                                          │
│                                                                              │
│ **Two-mode switching:**                                                      │
│ ```json                                                                      │
