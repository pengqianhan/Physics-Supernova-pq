import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data files                                                           
files = ['data_all/linear/complex_underdamped_system/sample_0.npz',             
         'data_all/linear/complex_underdamped_system/sample_1.npz',             
         'data_all/linear/complex_underdamped_system/sample_2.npz']             
                                                                                
all_data = []                                                                   
                                                                                
for file in files:                                                              
    data = np.load(file)                                                        
    t = data['t']                                                               
    x = data['x']  # Assuming x has shape (N, 2)                                
    u = data['u']  # Assuming u has shape (N, 1)                                
                                                                                
    # Create a DataFrame for easier manipulation                                
    df = pd.DataFrame({                                                         
        't': t.flatten(),                                                       
        'x1': x[:, 0],                                                          
        'x2': x[:, 1],                                                          
        'u1': u[:, 0]                                                           
    })                                                                          
                                                                                
    # Identify modes                                                            
    # Mode 1: x1 < 5                                                            
    # Mode 2: 5 <= x1 < 10                                                      
    # Mode 3: x1 decreases after reaching 10                                    
                                                                                
    # Calculate dx1/dt to help identify Mode 3                                  
    df['dx1'] = df['x1'].diff() / 0.001                                         
                                                                                
    # Determine the index where x1 reaches 10 for the first time                
    idx_max = df['x1'].idxmax()                                                 
    val_max = df['x1'].max()                                                    
                                                                                
    conditions = [                                                              
        (df['x1'] < 5) & (df.index < idx_max),                                  
        (df['x1'] >= 5) & (df['x1'] < 10) & (df.index < idx_max),               
        (df.index >= idx_max) | (df['x1'] >= 10)                                
    ]                                                                           
    choices = [1, 2, 3]                                                         
    df['mode'] = np.select(conditions, choices, default=0)                      
                                                                                
    # Calculate derivatives for x2                                              
    df['dx2'] = df['x2'].diff() / 0.001                                         
    df['d2x2'] = df['dx2'].diff() / 0.001                                       
                                                                                
    # Drop rows with NaN from differentiation                                   
    df = df.dropna()                                                            
    all_data.append(df)                                                         
                                                                                
# Combine all data                                                              
df_total = pd.concat(all_data, ignore_index=True)                               
                                                                                
# Fit dynamics for each mode                                                    
results = {}                                                                    
for m in [1, 2, 3]:                                                             
    mode_df = df_total[df_total['mode'] == m]                                   
    if len(mode_df) < 10:                                                       
        continue                                                                
                                                                                
    X = mode_df[['dx2', 'x2', 'u1']]                                            
    y = mode_df['d2x2']                                                         
                                                                                
    reg = LinearRegression().fit(X, y)                                          
    a, b, c = reg.coef_                                                         
    d = reg.intercept_                                                          
                                                                                
    # Verify x1'                                                                
    avg_dx1 = mode_df['dx1'].mean()                                             
                                                                                
    results[m] = {'a': a, 'b': b, 'c': c, 'd': d, 'dx1_avg': avg_dx1}           
                                                                                
print(results)                                                                  
                                                                                
