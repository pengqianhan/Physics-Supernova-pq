import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def solve_regression(X, Y):                                                     
    # Solve X * beta = Y                                                        
    beta, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)                
    # Calculate R2                                                              
    y_mean = np.mean(Y)                                                         
    ss_tot = np.sum((Y - y_mean)**2)                                            
    ss_res = np.sum((Y - X @ beta)**2)                                          
    r2 = 1 - (ss_res / ss_tot)                                                  
    return beta, r2                                                             
                                                                                
