        data = np.load(path)                                                    
        x1 = data['state'][0]                                                   
        x2 = data['state'][1]                                                   
        u1 = data['input'][0]                                                   
        dx1 = np.diff(x1)                                                       
                                                                                
        # Mode 1: x1 < 5, dx1 > 0                                               
