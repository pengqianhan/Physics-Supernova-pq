import numpy as np                                                              
                                                                                
def analyze_fixed():                                                            
    file_paths = ['data_all/linear/complex_underdamped_system/sample_0.npz',    
                  'data_all/linear/complex_underdamped_system/sample_1.npz',    
                  'data_all/linear/complex_underdamped_system/sample_2.npz']    
                                                                                
    dt = 0.001 # Retesting dt based on x1 values.                               
    # If x1 goes from 0 to 10 in 10000 steps, dt=0.001 means x1_dot approx 1.   
                                                                                
    all_X = []                                                                  
    all_XD = []                                                                 
    all_XDD = []                                                                
    all_U = []                                                                  
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        # Transpose to get (N, dim)                                             
        x = data['state'].T                                                     
        u = data['input'].T                                                     
                                                                                
        # Inferred x1_dot                                                       
        xd = np.diff(x, axis=0) / dt                                            
        xdd = np.diff(xd, axis=0) / dt                                          
                                                                                
        xd_mid = (xd[:-1] + xd[1:]) / 2.0                                       
        x_mid = x[1:-1]                                                         
        u_mid = u[1:-1]                                                         
                                                                                
        all_X.append(x_mid)                                                     
        all_XD.append(xd_mid)                                                   
        all_XDD.append(xdd)                                                     
        all_U.append(u_mid)                                                     
                                                                                
    X = np.concatenate(all_X)                                                   
    XD = np.concatenate(all_XD)                                                 
    XDD = np.concatenate(all_XDD)                                               
    U = np.concatenate(all_U)                                                   
                                                                                
    print("X1 Range:", np.min(X[:, 0]), np.max(X[:, 0]))                        
    print("X1_dot Range:", np.min(XD[:, 0]), np.max(XD[:, 0]))                  
                                                                                
    # Modes:                                                                    
    m1_mask = (X[:, 0] < 5) & (XD[:, 0] > 0.5)                                  
    m2_mask = (X[:, 0] >= 5) & (X[:, 0] < 10) & (XD[:, 0] > 0.5)                
    m3_mask = (XD[:, 0] < -0.5)                                                 
                                                                                
    results = {}                                                                
    for i, mask in enumerate([m1_mask, m2_mask, m3_mask], 1):                   
        if np.sum(mask) > 10:                                                   
            A = np.column_stack([XD[mask, 1], X[mask, 1], U[mask, 0],           
np.ones(np.sum(mask))])                                                         
            b = XDD[mask, 1]                                                    
            coeffs, _, _, _ = np.linalg.lstsq(A, b, rcond=None)                 
            results[f"Mode {i}"] = {"x2_coeffs (a,b,c,d)": coeffs, "x1_dot":    
np.mean(XD[mask, 0])}                                                           
                                                                                
    # Reset detection                                                           
    resets = []                                                                 
