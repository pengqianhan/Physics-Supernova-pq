import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def get_derivatives(x, dt):                                                     
    # Use central differences for smoother derivatives                          
    x_dot = np.zeros_like(x)                                                    
    x_dot[1:-1] = (x[2:] - x[:-2]) / (2 * dt)                                   
    x_dot[0] = (x[1] - x[0]) / dt                                               
    x_dot[-1] = (x[-1] - x[-2]) / dt                                            
                                                                                
    x_ddot = np.zeros_like(x)                                                   
    x_ddot[1:-1] = (x[2:] - 2*x[1:-1] + x[:-2]) / (dt**2)                       
    x_ddot[0] = (x[2] - 2*x[1] + x[0]) / (dt**2)                                
    x_ddot[-1] = (x[-1] - 2*x[-2] + x[-3]) / (dt**2)                            
    return x_dot, x_ddot                                                        
                                                                                
dt = 0.001                                                                      
data_files = ['data_all/linear/complex_underdamped_system/sample_0.npz',        
              'data_all/linear/complex_underdamped_system/sample_1.npz',        
              'data_all/linear/complex_underdamped_system/sample_2.npz']        
                                                                                
modes_data = {1: {'x1_dot': [], 'x2_ddot': [], 'x2_dot': [], 'x2': [], 'u1': [],
'x2_sq': [], 'x1x2': []},                                                       
              2: {'x1_dot': [], 'x2_ddot': [], 'x2_dot': [], 'x2': [], 'u1': [],
'x2_sq': [], 'x1x2': []},                                                       
              3: {'x1_dot': [], 'x2_ddot': [], 'x2_dot': [], 'x2': [], 'u1': [],
'x2_sq': [], 'x1x2': []}}                                                       
                                                                                
transition_info = []                                                            
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    u = data['input']                                                           
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    u1 = u[0, :]                                                                
                                                                                
    x1_dot, _ = get_derivatives(x1, dt)                                         
    x2_dot, x2_ddot = get_derivatives(x2, dt)                                   
                                                                                
    n = len(x1)                                                                 
    modes = np.zeros(n)                                                         
    peak_reached = False                                                        
                                                                                
    for i in range(n):                                                          
        if x1[i] >= 10.0:                                                       
            peak_reached = True                                                 
        if i > 0 and x1[i] < x1[i-1]:                                           
            peak_reached = True                                                 
                                                                                
        if peak_reached:                                                        
            modes[i] = 3                                                        
        elif x1[i] < 5.0:                                                       
            modes[i] = 1                                                        
        elif 5.0 <= x1[i] < 10.0:                                               
            modes[i] = 2                                                        
                                                                                
    # Regression collection (exclude boundaries for derivative stability)       
    for i in range(2, n-2):                                                     
        m = int(modes[i])                                                       
        modes_data[m]['x1_dot'].append(x1_dot[i])                               
        modes_data[m]['x2_ddot'].append(x2_ddot[i])                             
        modes_data[m]['x2_dot'].append(x2_dot[i])                               
        modes_data[m]['x2'].append(x2[i])                                       
        modes_data[m]['u1'].append(u1[i])                                       
        modes_data[m]['x2_sq'].append(x2[i]**2)                                 
        modes_data[m]['x1x2'].append(x1[i]*x2[i])                               
                                                                                
    # Transition tracking                                                       
    for i in range(n-1):                                                        
        if modes[i] == 1 and modes[i+1] == 2:                                   
            transition_info.append({'type': 1, 'left': (x1[i], x2[i],           
x2_dot[i]), 'right': (x1[i+1], x2[i+1], x2_dot[i+1])})                          
        if modes[i] == 2 and modes[i+1] == 3:                                   
            transition_info.append({'type': 2, 'left': (x1[i], x2[i],           
x2_dot[i]), 'right': (x1[i+1], x2[i+1], x2_dot[i+1])})                          
                                                                                
# Solve regressions                                                             
results = {}                                                                    
for m in [1, 2, 3]:                                                             
    # x1 regression                                                             
    b1 = np.mean(modes_data[m]['x1_dot'])                                       
                                                                                
    # x2 regression: x2_ddot = a*x2_dot + b*x2 + c*u1 + d                       
    X = np.column_stack([modes_data[m]['x2_dot'], modes_data[m]['x2'],          
modes_data[m]['u1']])                                                           
    y = np.array(modes_data[m]['x2_ddot'])                                      
    reg = LinearRegression().fit(X, y)                                          
    a, b, c = reg.coef_                                                         
    d = reg.intercept_                                                          
                                                                                
    # Nonlinearity check                                                        
    X_nl = np.column_stack([modes_data[m]['x2_dot'], modes_data[m]['x2'],       
modes_data[m]['u1'], modes_data[m]['x2_sq'], modes_data[m]['x1x2']])            
    reg_nl = LinearRegression().fit(X_nl, y)                                    
    score_diff = reg_nl.score(X_nl, y) - reg.score(X, y)                        
                                                                                
    results[m] = {'b1': b1, 'coeffs': (a, b, c, d), 'nl_impact': score_diff}    
                                                                                
