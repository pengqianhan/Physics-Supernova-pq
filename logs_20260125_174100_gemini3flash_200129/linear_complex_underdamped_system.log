import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def analyze_sample(i):                                                          
    data = np.load(f'data_all/linear/complex_underdamped_system/sample_{i}.npz')
    x1 = data['state'][0]                                                       
    x2 = data['state'][1]                                                       
    u1 = data['input'][0]                                                       
                                                                                
    # Calculate derivatives using finite differences                            
    v1 = np.diff(x1) / dt                                                       
    v2 = np.diff(x2) / dt                                                       
    a2 = np.diff(v2) / dt                                                       
                                                                                
    # Identify transitions                                                      
    t12 = np.where(x1 >= 5)[0][0] if np.any(x1 >= 5) else None                  
    t23 = np.where(x1 >= 10)[0][0] if np.any(x1 >= 10) else None                
                                                                                
    return x1, x2, u1, v1, v2, a2, t12, t23                                     
                                                                                
# Perform check for resets and transition times                                 
for i in range(3):                                                              
    x1, x2, u1, v1, v2, a2, t12, t23 = analyze_sample(i)                        
    print(f"Sample {i}:")                                                       
    if t12 is not None:                                                         
        print(f"  x1=5 at index {t12}, time {t12*dt:.3f}")                      
        print(f"  State jump at x1=5 (after - before):")                        
        print(f"    x1: {x1[t12] - x1[t12-1]:.4f}, v1: {v1[t12] -               
v1[t12-1]:.4f}")                                                                
        print(f"    x2: {x2[t12] - x2[t12-1]:.4f}, v2: {v2[t12] -               
v2[t12-1]:.4f}")                                                                
    if t23 is not None:                                                         
        print(f"  x1=10 at index {t23}, time {t23*dt:.3f}")                     
        print(f"  State jump at x1=10 (after - before):")                       
        print(f"    x1: {x1[t23] - x1[t23-1]:.4f}, v1: {v1[t23] -               
v1[t23-1]:.4f}")                                                                
        print(f"    x2: {x2[t23] - x2[t23-1]:.4f}, v2: {v2[t23] -               
v2[t23-1]:.4f}")                                                                
        if t23+1 < len(v1):                                                     
            print(f"    v1 after x1=10: {v1[t23+1]:.4f}")                       
                                                                                
# Gather data for ODE fitting                                                   
def get_mode_data(mode, samples):                                               
    X, Y = [], []                                                               
    for i in samples:                                                           
        x1, x2, u1, v1, v2, a2, t12, t23 = analyze_sample(i)                    
                                                                                
        # Mode definitions                                                      
        if mode == 1:                                                           
            indices = np.arange(0, t12-1) if t12 is not None else               
np.arange(len(a2))                                                              
        elif mode == 2:                                                         
            if t12 is not None:                                                 
                start = t12                                                     
                end = t23-1 if t23 is not None else len(a2)                     
                indices = np.arange(start, end)                                 
            else:                                                               
                indices = np.array([], dtype=int)                               
        elif mode == 3:                                                         
            if t23 is not None:                                                 
                indices = np.arange(t23, len(a2))                               
            else:                                                               
                indices = np.array([], dtype=int)                               
                                                                                
        for idx in indices:                                                     
            # ODE: x2'' = a*x2' + b*x2 + c + d*u1                               
            # Features: [v2[idx], x2[idx], 1, u1[idx]]                          
            X.append([v2[idx], x2[idx], 1.0, u1[idx]])                          
            Y.append(a2[idx])                                                   
                                                                                
    return np.array(X), np.array(Y)                                             
                                                                                
