```python                                                                       
import numpy as np                                                              
                                                                                
def estimate_mode_params(states, inputs, dt=0.001):                             
    # states: (2, N), inputs: (1, N)                                            
    x1 = states[0, :]                                                           
    x2 = states[1, :]                                                           
    u1 = inputs[0, :]                                                           
                                                                                
    # Modes                                                                     
    m1_idx = np.where(x1 < 5.0)[0]                                              
    m2_idx = np.where((x1 >= 5.0) & (x1 < 10.0))[0]                             
    m3_idx = np.where(x1 >= 10.0)[0]                                            
                                                                                
    def fit_ode(idx_range):                                                     
        if len(idx_range) < 10: return None                                     
        # Use central differences for derivatives                               
        idx = idx_range[2:-2]                                                   
        dx2 = (x2[idx+1] - x2[idx-1]) / (2*dt)                                  
        ddx2 = (x2[idx+2] - 2*x2[idx] + x2[idx-2]) / (dt**2)                    
                                                                                
        # ODE: ddx2 = -b*dx2 - k*x2 + g*u1 + c                                  
        A = np.column_stack([-dx2, -x2[idx], u1[idx], np.ones_like(idx)])       
        try:                                                                    
            params, _, _, _ = np.linalg.lstsq(A, ddx2, rcond=None)              
            return params # b, k, gain, constant                                
        except:                                                                 
            return None                                                         
                                                                                
    p1 = fit_ode(m1_idx)                                                        
    p2 = fit_ode(m2_idx)                                                        
    p3 = fit_ode(m3_idx)                                                        
                                                                                
    # x1 slope                                                                  
    v1 = np.mean(np.diff(x1[m1_idx])) / dt if len(m1_idx) > 1 else 0            
    v2 = np.mean(np.diff(x1[m2_idx])) / dt if len(m2_idx) > 1 else 0            
    v3 = np.mean(np.diff(x1[m3_idx])) / dt if len(m3_idx) > 1 else 0            
                                                                                
    return (v1, v2, v3), (p1, p2, p3)                                           
                                                                                
# Load data                                                                     
data0 = np.load('data_all/linear/complex_underdamped_system/sample_0.npz')      
data1 = np.load('data_all/linear/complex_underdamped_system/sample_1.npz')      
data2 = np.load('data_all/linear/complex_underdamped_system/sample_2.npz')      
                                                                                
# Combine or analyze one by one (they might be parts of a single trajectory or  
different ones)                                                                 
