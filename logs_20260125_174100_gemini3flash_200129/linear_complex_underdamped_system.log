D                                                                               
# x2[2] -> x2_ddot, x2[1] -> x2_dot, x2[0] -> x2                                
y = (x2[2:] - 2*x2[1:-1] + x2[:-2]) / (dt**2)                                   
x2_dot_val = (x2[1:-1] - x2[:-2]) / dt                                          
x2_val = x2[:-2]                                                                
u1_val = u1[:-2]                                                                
x1_val = x1[:-2]                                                                
                                                                                
