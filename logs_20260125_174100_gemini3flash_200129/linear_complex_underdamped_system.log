import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
def analyze_system(file_paths):                                                 
    all_mode1_data = []                                                         
    all_mode2_data = []                                                         
    all_mode3_data = []                                                         
                                                                                
    resets = []                                                                 
                                                                                
    for file_path in file_paths:                                                
        data = np.load(file_path)                                               
        t = data['t']                                                           
        x = data['x']  # Assuming x is (N, 2)                                   
        u = data['u']  # Assuming u is (N, 1) or (N,)                           
                                                                                
        dt = np.mean(np.diff(t))                                                
                                                                                
        x1 = x[:, 0]                                                            
        x2 = x[:, 1]                                                            
        u1 = u.flatten()                                                        
                                                                                
        # Derivatives                                                           
        x1_dot = np.gradient(x1, t)                                             
        x2_dot = np.gradient(x2, t)                                             
        x2_ddot = np.gradient(x2_dot, t)                                        
                                                                                
        # Mode Identification                                                   
        # Mode 1: x1 < 5.0 and x1 increasing                                    
        mode1_idx = (x1 < 5.0) & (x1_dot > 0.01)                                
        # Mode 2: 5.0 <= x1 < 10.0 and x1 increasing                            
        mode2_idx = (x1 >= 5.0) & (x1 < 10.0) & (x1_dot > 0.01)                 
        # Mode 3: x1 decreasing after 10.0                                      
        # Find peak of x1                                                       
        peak_idx = np.argmax(x1)                                                
        mode3_idx = (np.arange(len(x1)) > peak_idx) & (x1_dot < -0.01)          
                                                                                
        def collect_data(idx):                                                  
            if np.any(idx):                                                     
                return np.column_stack([x2_ddot[idx], x2_dot[idx], x2[idx],     
u1[idx], x1_dot[idx]])                                                          
            return None                                                         
                                                                                
        m1 = collect_data(mode1_idx)                                            
        m2 = collect_data(mode2_idx)                                            
        m3 = collect_data(mode3_idx)                                            
                                                                                
        if m1 is not None: all_mode1_data.append(m1)                            
        if m2 is not None: all_mode2_data.append(m2)                            
        if m3 is not None: all_mode3_data.append(m3)                            
                                                                                
        # Check resets                                                          
        # Transition 1 -> 2: around x1=5                                        
        idx_5 = np.where(np.diff((x1 >= 5).astype(int)) > 0)[0]                 
        for i in idx_5:                                                         
            resets.append({'at': 'x1=5', 'x1_diff': x1[i+1]-x1[i], 'x2_diff':   
x2[i+1]-x2[i]})                                                                 
        # Transition 2 -> 3: around x1=10                                       
        idx_10 = np.where(np.diff((x1 >= 10).astype(int)) > 0)[0]               
        for i in idx_10:                                                        
             resets.append({'at': 'x1=10', 'x1_diff': x1[i+1]-x1[i], 'x2_diff': 
x2[i+1]-x2[i]})                                                                 
                                                                                
    def solve_mode(data_list):                                                  
        if not data_list: return None                                           
        data = np.vstack(data_list)                                             
        Y = data[:, 0] # x2_ddot                                                
        X = data[:, 1:4] # x2_dot, x2, u1                                       
        X = np.column_stack([X, np.ones(len(X))]) # for d                       
                                                                                
        coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)          
        x1_dot_mean = np.mean(data[:, 4])                                       
        return coeffs, x1_dot_mean                                              
                                                                                
    results = {}                                                                
    results['Mode 1'] = solve_mode(all_mode1_data)                              
    results['Mode 2'] = solve_mode(all_mode2_data)                              
    results['Mode 3'] = solve_mode(all_mode3_data)                              
    results['Resets'] = resets                                                  
                                                                                
    return results                                                              
                                                                                
# Assuming DATA_FILE_PATHS is defined in the environment                        
results = analyze_system(DATA_FILE_PATHS)                                       
print(results)                                                                  
                                                                                
