def analyze_modes_fixed():                                                      
    dt = 0.001                                                                  
                                                                                
    # We'll define 3 modes:                                                     
    # A: x1 < 5, dx1 > 0                                                        
    # B: 5 <= x1 < 10, dx1 > 0                                                  
    # C: dx1 < 0                                                                
                                                                                
    all_data = {                                                                
        'A': {'x1': [], 'x2': [], 'dx2': [], 'ddx2': [], 'u': [], 'dx1': []},   
        'B': {'x1': [], 'x2': [], 'dx2': [], 'ddx2': [], 'u': [], 'dx1': []},   
        'C': {'x1': [], 'x2': [], 'dx2': [], 'ddx2': [], 'u': [], 'dx1': []}    
    }                                                                           
                                                                                
    for i in range(3):                                                          
        data = np.load(DATA_FILE_PATHS[i])                                      
        state = data['state']                                                   
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
        u = data['input'][0, :]                                                 
                                                                                
        # Central derivatives                                                   
        # To avoid issues at the turn, let's split the data at the turn         
        diffs = np.diff(x1)                                                     
        turn_indices = np.where(diffs < 0)[0]                                   
                                                                                
        if len(turn_indices) > 0:                                               
            turn_pt = turn_indices[0]                                           
            # Part 1: increasing                                                
            x1_p1 = x1[:turn_pt+1]                                              
            x2_p1 = x2[:turn_pt+1]                                              
            u_p1 = u[:turn_pt+1]                                                
            # Part 2: decreasing                                                
            x1_p2 = x1[turn_pt:]                                                
            x2_p2 = x2[turn_pt:]                                                
            u_p2 = u[turn_pt:]                                                  
        else:                                                                   
            x1_p1, x2_p1, u_p1 = x1, x2, u                                      
            x1_p2, x2_p2, u_p2 = [], [], []                                     
                                                                                
        def process_part(x1_v, x2_v, u_v, is_decreasing):                       
            if len(x1_v) < 3: return                                            
            dx1 = np.diff(x1_v) / dt                                            
            dx2 = np.diff(x2_v) / dt                                            
            ddx2 = np.diff(dx2) / dt                                            
                                                                                
            x1_val = x1_v[1:-1]                                                 
            x2_val = x2_v[1:-1]                                                 
            u_val = u_v[1:-1]                                                   
            dx2_val = (x2_v[2:] - x2_v[:-2]) / (2 * dt)                         
            dx1_val = (x1_v[2:] - x1_v[:-2]) / (2 * dt)                         
            ddx2_val = ddx2                                                     
                                                                                
            if not is_decreasing:                                               
                mask_a = x1_val < 5.0                                           
                mask_b = (x1_val >= 5.0)                                        
                                                                                
                all_data['A']['x1'].extend(x1_val[mask_a])                      
                all_data['A']['x2'].extend(x2_val[mask_a])                      
                all_data['A']['dx2'].extend(dx2_val[mask_a])                    
                all_data['A']['ddx2'].extend(ddx2_val[mask_a])                  
                all_data['A']['u'].extend(u_val[mask_a])                        
                all_data['A']['dx1'].extend(dx1_val[mask_a])                    
                                                                                
                all_data['B']['x1'].extend(x1_val[mask_b])                      
                all_data['B']['x2'].extend(x2_val[mask_b])                      
                all_data['B']['dx2'].extend(dx2_val[mask_b])                    
                all_data['B']['ddx2'].extend(ddx2_val[mask_b])                  
                all_data['B']['u'].extend(u_val[mask_b])                        
                all_data['B']['dx1'].extend(dx1_val[mask_b])                    
            else:                                                               
                all_data['C']['x1'].extend(x1_val)                              
                all_data['C']['x2'].extend(x2_val)                              
                all_data['C']['dx2'].extend(dx2_val)                            
                all_data['C']['ddx2'].extend(ddx2_val)                          
                all_data['C']['u'].extend(u_val)                                
                all_data['C']['dx1'].extend(dx1_val)                            
                                                                                
        process_part(x1_p1, x2_p1, u_p1, False)                                 
        if len(x1_p2) > 0:                                                      
            process_part(x1_p2, x2_p2, u_p2, True)                              
                                                                                
    for mode in ['A', 'B', 'C']:                                                
        print(f"\n--- Mode {mode} ---")                                         
        d = all_data[mode]                                                      
        if len(d['x2']) == 0:                                                   
            print("No data")                                                    
            continue                                                            
                                                                                
        print(f"Mean dx1: {np.mean(d['dx1'])}")                                 
                                                                                
        # Fit ddx2 = a*dx2 + b*x2 + c*u + d                                     
        X2 = np.stack([d['dx2'], d['x2'], d['u'], np.ones_like(d['u'])], axis=1)
        y2 = np.array(d['ddx2'])                                                
        coeffs2, _, _, _ = np.linalg.lstsq(X2, y2, rcond=None)                  
        print(f"ddx2 Coeffs (a, b, c, d): {coeffs2}")                           
                                                                                
