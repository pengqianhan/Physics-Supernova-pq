        for idx in indices:                                                     
            if idx+1 < len(x2) - 1:                                             
                x2_val = x2[idx+1]                                              
                x2_dot = (x2[idx+2] - x2[idx]) / (2*dt)                         
                acc = (x2[idx+2] - 2*x2[idx+1] + x2[idx]) / (dt**2)             
                                                                                
                # Try fitting A=-3, B=-25, then check if acc - (-3*x2_dot -     
25*x2) is proportional to u1                                                    
                resid = acc - (-3.0 * x2_dot - 25.0 * x2_val)                   
                X_list.append(u1[idx+1])                                        
                Y_list.append(resid)                                            
                                                                                
    X = np.array(X_list).reshape(-1, 1)                                         
    Y = np.array(Y_list)                                                        
    C_fit, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                          
                                                                                
    # Calculate R2 for the residuals vs u1                                      
    preds = X * C_fit                                                           
    y_mean = np.mean(Y)                                                         
    r2 = 1 - np.sum((Y - preds)**2) / np.sum((Y - y_mean)**2)                   
                                                                                
    print(f"Mode 1 fit for resid = C*u1: C={C_fit[0]:.4f}, R2={r2:.4f}")        
                                                                                
