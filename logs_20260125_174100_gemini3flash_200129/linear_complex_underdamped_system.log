def analyze_data():                                                             
    file_paths = ['data_all/linear/complex_underdamped_system/sample_0.npz',    
                  'data_all/linear/complex_underdamped_system/sample_1.npz',    
                  'data_all/linear/complex_underdamped_system/sample_2.npz']    
                                                                                
    all_x = []                                                                  
    all_xd = []                                                                 
    all_xdd = []                                                                
    all_u = []                                                                  
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        t = data['t']                                                           
        x = data['x']                                                           
        u = data['u']                                                           
                                                                                
        dt = np.diff(t)                                                         
        xd = np.diff(x, axis=0) / dt[:, np.newaxis]                             
                                                                                
        # Second derivative                                                     
        xdd = np.diff(xd, axis=0) / dt[:-1, np.newaxis]                         
                                                                                
        # Align arrays for regression (using middle points for derivatives)     
        # xdd[i] corresponds to x[i+1], xd_mid[i], u[i+1]                       
        xd_mid = (xd[:-1] + xd[1:]) / 2.0                                       
        x_mid = x[1:-1]                                                         
        u_mid = u[1:-1]                                                         
                                                                                
        all_x.append(x_mid)                                                     
