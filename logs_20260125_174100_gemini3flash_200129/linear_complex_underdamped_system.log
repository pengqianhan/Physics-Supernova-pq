    ddx[:, 1:-1] = (x[:, 2:] - 2 * x[:, 1:-1] + x[:, :-2]) / (dt**2)            
    ddx[:, 0] = ddx[:, 1]                                                       
    ddx[:, -1] = ddx[:, -2]                                                     
    return dx, ddx                                                              
                                                                                
