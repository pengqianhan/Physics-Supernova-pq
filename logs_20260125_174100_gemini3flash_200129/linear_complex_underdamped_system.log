        dx2_before = (x2[idx] - x2[idx-1]) / dt                                 
        dx2_after = (x2[idx+1] - x2[idx]) / dt                                  
        print(f"File {path}: at x1={x1[idx]:.4f}, dx2 jump = {dx2_after -       
dx2_before:.4f}")                                                               
                                                                                
    # Mode 3 transition: x1 starts decreasing                                   
    # Find the peak of x1                                                       
    peak_idx = np.argmax(x1)                                                    
    print(f"File {path}: x1 peak at {x1[peak_idx]:.6f}, index {peak_idx}")      
                                                                                
# Perform Regression for Mode 2                                                 
if all_m2_dx2:                                                                  
    m2_dx2 = np.concatenate(all_m2_dx2)                                         
    m2_x2 = np.concatenate(all_m2_x2)                                           
    m2_u1 = np.concatenate(all_m2_u1)                                           
    m2_d2x2 = np.concatenate(all_m2_d2x2)                                       
                                                                                
    X_m2 = np.stack([m2_dx2, m2_x2, m2_u1, np.ones_like(m2_dx2)], axis=1)       
    beta, _, _, _ = np.linalg.lstsq(X_m2, m2_d2x2, rcond=None)                  
