import numpy as np                                                              
                                                                                
def check_mode1_u(s_idx):                                                       
    data = np.load(DATA_FILE_PATHS[s_idx])                                      
    x1 = data['state'][0]                                                       
    x2 = data['state'][1]                                                       
    u = data['input'][0]                                                        
    dt = 0.001                                                                  
    x2_dot = np.gradient(x2, dt)                                                
    x2_ddot = np.gradient(x2_dot, dt)                                           
                                                                                
    mask = (x1 > x1[0]+10*dt) & (x1 < 4.95)                                     
    if np.sum(mask) < 100: return                                               
                                                                                
    A = np.vstack([x2_dot[mask], x2[mask], u[mask], np.ones(np.sum(mask))]).T   
    coeffs, _, _, _ = np.linalg.lstsq(A, x2_ddot[mask], rcond=None)             
    print(f"Sample {s_idx} Mode 1 a, b, k, c:", coeffs)                         
                                                                                
for i in [0, 1, 2]:                                                             
    check_mode1_u(i)                                                            
                                                                                
