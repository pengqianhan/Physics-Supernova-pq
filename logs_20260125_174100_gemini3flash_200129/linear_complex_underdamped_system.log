def fit_mode(x1, x2, u, x1_next, x2_next):                                      
    """Fits the linear model for a mode."""                                     
    # Build design matrix for least squares: [x1, x2, u, 1]                     
    A = np.column_stack([x1, x2, u, np.ones_like(x1)])                          
                                                                                
    # Solve for coefficients for x1_next                                        
    coef1, _, _, _ = np.linalg.lstsq(A, x1_next, rcond=None)                    
    # Solve for coefficients for x2_next                                        
    coef2, _, _, _ = np.linalg.lstsq(A, x2_next, rcond=None)                    
                                                                                
    return coef1, coef2                                                         
                                                                                
