import numpy as np                                                              
                                                                                
# Load all available samples                                                    
samples = [np.load(path) for path in DATA_FILE_PATHS]                           
dt = 0.001  # Time step identified from data structure                          
                                                                                
def get_derivatives(x, dt):                                                     
    # Use central differences for smoother derivatives where possible           
    dx = np.gradient(x, dt)                                                     
    ddx = np.gradient(dx, dt)                                                   
    return dx, ddx                                                              
                                                                                
all_mode_data = {1: [], 2: [], 3: []}                                           
                                                                                
for s in samples:                                                               
    x1, x2 = s['state'][0], s['state'][1]                                       
    u1 = s['input'][0]                                                          
                                                                                
    dx1, _ = get_derivatives(x1, dt)                                            
    dx2, ddx2 = get_derivatives(x2, dt)                                         
                                                                                
    for i in range(1, len(x1) - 1):                                             
        # Determine mode                                                        
        # Mode 1: x1 increasing and x1 < 5                                      
        # Mode 2: x1 increasing and 5 <= x1 < 10                                
        # Mode 3: x1 reaches 10 and then decreases                              
                                                                                
        # Determine dx1 trend                                                   
        v1 = dx1[i]                                                             
        p1 = x1[i]                                                              
                                                                                
        if v1 > 0.5:                                                            
            if p1 < 5.0:                                                        
                mode = 1                                                        
            elif p1 < 10.0:                                                     
                mode = 2                                                        
            else:                                                               
                continue                                                        
        elif v1 < -0.5:                                                         
            mode = 3                                                            
        else:                                                                   
            continue                                                            
                                                                                
        # Fit ddx2 = a*dx2 + b*x2 + c*u1 + d                                    
        all_mode_data[mode].append([dx2[i], x2[i], u1[i], 1.0, ddx2[i]])        
                                                                                
# Model Fitting                                                                 
model_params = {}                                                               
for mode in [1, 2, 3]:                                                          
    data = np.array(all_mode_data[mode])                                        
    X = data[:, :4]                                                             
    y = data[:, 4]                                                              
    coef, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                           
    model_params[mode] = coef                                                   
                                                                                
print("Second-order ODE coefficients [a, b, c, d] for x2:")                     
for mode, coef in model_params.items():                                         
    print(f"Mode {mode}: {coef}")                                               
                                                                                
