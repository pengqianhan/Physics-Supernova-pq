import numpy as np                                                              
from scipy.linalg import lstsq, expm                                            
                                                                                
def solve():                                                                    
    dt = 0.001                                                                  
                                                                                
    # Pre-calculate theoretical coefficients for p=3, q=25 system:              
    # dx1/dt = x2                                                               
    # dx2/dt = -25*x1 - 3*x2 + u                                                
    A = np.array([[0, 1], [-25, -3]])                                           
    Phi = expm(A * dt)                                                          
    # The characteristic equation for Phi is det(lambda*I - Phi) = lambda^2 -   
tr(Phi)*lambda + det(Phi) = 0                                                   
    # So x[k+2] - tr(Phi)*x[k+1] + det(Phi)*x[k] = Bu...                        
    a_th = np.trace(Phi)                                                        
    b_th = -np.linalg.det(Phi)                                                  
                                                                                
    results = {}                                                                
                                                                                
    for i in [0, 1]:                                                            
        data =                                                                  
np.load(f'data_all/linear/complex_underdamped_system/sample_{i}.npz')           
        state = data['state']                                                   
        u = data['input'][0]                                                    
        x1 = state[0]                                                           
        x2 = state[1]                                                           
                                                                                
        diff_x1 = np.diff(x1)                                                   
        increasing = diff_x1 > 0                                                
        decreasing = diff_x1 < 0                                                
                                                                                
        # Modes                                                                 
        m1_idx = np.where((x1[:-1] < 5) & increasing)[0]                        
        m2_idx = np.where((x1[:-1] >= 5) & (x1[:-1] < 10) & increasing)[0]      
        m3_idx = np.where(decreasing)[0]                                        
                                                                                
        # Mode 2 Regression                                                     
        valid_k = []                                                            
        for k in m2_idx:                                                        
            if (k+1) in m2_idx and (k+2) < len(x2):                             
                valid_k.append(k)                                               
        valid_k = np.array(valid_k)                                             
                                                                                
        if len(valid_k) > 0:                                                    
            Y = x2[valid_k + 2]                                                 
            X = np.column_stack([x2[valid_k + 1], x2[valid_k], u[valid_k],      
np.ones_like(valid_k, dtype=float)])                                            
            coeffs, _, _, _ = lstsq(X, Y)                                       
            a, b, c, d = coeffs                                                 
        else:                                                                   
            a, b, c, d = None, None, None, None                                 
                                                                                
        # Verify Mode 1 and 3                                                   
        # Check discrete-time consistency with p=3, q=25                        
        # We check if x2[k+1] = Phi_21*x1[k] + Phi_22*x2[k] + Gamma_2*u[k]      
        # First, find Gamma                                                     
        Gamma = np.linalg.solve(A, (Phi - np.eye(2)) @ np.array([0, 1]))        
                                                                                
        def check_perfection(idx):                                              
            if len(idx) == 0: return "N/A"                                      
            # Target x2[k+1]                                                    
            target = x2[idx+1]                                                  
            # Model x2[k+1] = Phi_21*x1[k] + Phi_22*x2[k] + Gamma_2*u[k]        
            model = Phi[1,0]*x1[idx] + Phi[1,1]*x2[idx] + Gamma[1]*u[idx]       
            mae = np.abs(target - model).mean()                                 
            return mae                                                          
                                                                                
        mae1 = check_perfection(m1_idx)                                         
        mae3 = check_perfection(m3_idx)                                         
                                                                                
        results[i] = {                                                          
            'a': a, 'b': b, 'c': c, 'd': d,                                     
            'mae1': mae1,                                                       
            'mae3': mae3                                                        
        }                                                                       
                                                                                
    return results, a_th, b_th                                                  
                                                                                
res, a_th, b_th = solve()                                                       
