import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def solve_full_regression(mode_id):                                             
    X_list = []                                                                 
    Y_list = []                                                                 
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x1 = data['state'][0]                                                   
        x2 = data['state'][1]                                                   
        u1 = data['input'][0]                                                   
        dx1 = np.diff(x1)                                                       
                                                                                
        if mode_id == 1:                                                        
            indices = np.where((x1[:-2] < 5) & (dx1[:-1] > 0))[0]               
        elif mode_id == 2:                                                      
            indices = np.where((x1[:-2] >= 5) & (x1[:-2] < 10) & (dx1[:-1] >    
0))[0]                                                                          
        elif mode_id == 3:                                                      
            indices = np.where(dx1[:-1] < 0)[0]                                 
                                                                                
        for idx in indices:                                                     
            if idx+1 < len(x2) - 1:                                             
                x2_val = x2[idx+1]                                              
                x2_dot = (x2[idx+2] - x2[idx]) / (2*dt)                         
                u_val = u1[idx+1]                                               
                acc = (x2[idx+2] - 2*x2[idx+1] + x2[idx]) / (dt**2)             
                X_list.append([x2_dot, x2_val, u_val, 1.0])                     
                Y_list.append(acc)                                              
                                                                                
    X = np.array(X_list)                                                        
    Y = np.array(Y_list)                                                        
    beta, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                           
                                                                                
    # R2                                                                        
    preds = np.zeros(len(Y))                                                    
    for i in range(len(Y)):                                                     
        for j in range(len(beta)):                                              
            preds[i] += X[i, j] * beta[j]                                       
    r2 = 1 - np.sum((Y - preds)**2) / np.sum((Y - np.mean(Y))**2)               
    return beta, r2                                                             
                                                                                
for m in [1, 2, 3]:                                                             
