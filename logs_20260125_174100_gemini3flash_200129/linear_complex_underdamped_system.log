# Parameters to store results                                                   
results = {}                                                                    
                                                                                
def get_derivatives(x, dt):                                                     
    # x is (2, N)                                                               
    x1 = x[0, :]                                                                
    x2 = x[1, :]                                                                
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
    ddx2 = np.diff(dx2) / dt                                                    
    return dx1, dx2, ddx2                                                       
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    u = data['input']                                                           
                                                                                
    # Check x1 increments                                                       
    dx1_raw = np.diff(state[0, :])                                              
    # Assume dt is such that dx1/dt is a nice constant.                         
    # Let's see the most common increment.                                      
    common_inc = np.median(dx1_raw)                                             
    # If dt = common_inc, then dx1/dt = 1. Let's assume dt = 0.01 for now and   
see.                                                                            
    # Actually, if we don't know dt, we can't get 'a, b, c, d' absolutely,      
