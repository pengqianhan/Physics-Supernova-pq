dt = 0.001                                                                      
X_all = []                                                                      
Y_all = []                                                                      
                                                                                
resets_5 = []                                                                   
resets_10 = []                                                                  
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x1 = data['state'][0, :]                                                    
    x2 = data['state'][1, :]                                                    
    u1 = data['input'][0, :]                                                    
                                                                                
