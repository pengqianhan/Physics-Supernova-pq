          # Based on previous observation, state shape is (1, 10001)            
          x1 = data['state'][0, :]                                              
          dx = np.diff(x1)                                                      
                                                                                
          for i in range(len(dx)):                                              
              if dx[i] > 0:                                                     
                  mode1_curr.append(x1[i])                                      
                  mode1_next.append(x1[i+1])                                    
              elif dx[i] < 0:                                                   
                  mode2_curr.append(x1[i])                                      
                  mode2_next.append(x1[i+1])                                    
                                                                                
          # Detect switches                                                     
          for i in range(len(dx) - 1):                                          
              if dx[i] > 0 and dx[i+1] < 0:                                     
                  switches_1_2.append(x1[i+1])                                  
              elif dx[i] < 0 and dx[i+1] > 0:                                   
                  switches_2_1.append(x1[i+1])                                  
                                                                                
      # Fits                                                                    
      a1, b1 = np.polyfit(mode1_curr, mode1_next, 1)                            
      a2, b2 = np.polyfit(mode2_curr, mode2_next, 1)                            
                                                                                
      # Calculate R^2 or some error metric to check "sufficient"                
      def get_r2(curr, next_val, a, b):                                         
          curr = np.array(curr)                                                 
          next_val = np.array(next_val)                                         
          pred = a * curr + b                                                   
          res = next_val - pred                                                 
          return 1 - np.var(res) / np.var(next_val)                             
                                                                                
      r2_1 = get_r2(mode1_curr, mode1_next, a1, b1)                             
      r2_2 = get_r2(mode2_curr, mode2_next, a2, b2)                             
                                                                                
      print(f"Mode 1: a={a1}, b={b1}, R^2={r2_1}")                              
      print(f"Mode 2: a={a2}, b={b2}, R^2={r2_2}")                              
      if switches_1_2:                                                          
          print(f"Switches 1->2 (Heating to Cooling):                           
  min={np.min(switches_1_2)}, max={np.max(switches_1_2)}")                      
      if switches_2_1:                                                          
          print(f"Switches 2->1 (Cooling to Heating):                           
  min={np.min(switches_2_1)}, max={np.max(switches_2_1)}")                      
                                                                                
      # Check sample 0                                                          
      data0 = np.load(DATA_FILE_PATHS[0])                                       
      x0 = data0['state'][0, :]                                                 
      print(f"Sample 0 start: x1={x0[0]}, dx[0]={x0[1]-x0[0]}")                 
                                                                                
  analyze()                                                                     
