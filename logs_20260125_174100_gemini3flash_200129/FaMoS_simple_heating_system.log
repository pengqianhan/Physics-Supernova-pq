│   "properties": {                                                            │
│     "automaton": {                                                           │
│       "type": "object",                                                      │
│       "description": "The hybrid automaton definition with variables, modes, │
│ and transitions",                                                            │
│       "required": [                                                          │
│         "var",                                                               │
│         "mode",                                                              │
│         "edge"                                                               │
│       \],                                                                    │
│       "properties": {                                                        │
