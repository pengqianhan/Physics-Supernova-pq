Defaulting to 200 based on previous context if not found                        
    n = len(x1)                                                                 
    t = np.linspace(0, total_time, n)                                           
    dt = t[1] - t[0]                                                            
                                                                                
    # Compute derivative                                                        
    dx1 = np.diff(x1) / dt                                                      
    x1_mid = x1[:-1] # Corresponding x1 values for the derivative points        
                                                                                
    # Threshold for separating modes                                            
    threshold = 1e-4                                                            
                                                                                
    # Mode 1: Heating (dx1/dt > threshold)                                      
    idx1 = dx1 > threshold                                                      
    m1_x = x1_mid[idx1]                                                         
    m1_dx = dx1[idx1]                                                           
                                                                                
    # Mode 2: Cooling (dx1/dt < -threshold)                                     
    idx2 = dx1 < -threshold                                                     
    m2_x = x1_mid[idx2]                                                         
    m2_dx = dx1[idx2]                                                           
                                                                                
    results = {}                                                                
                                                                                
    # Linear Regression for Mode 1                                              
    if len(m1_x) > 1:                                                           
        slope1, intercept1, r_val1, _, _ = stats.linregress(m1_x, m1_dx)        
        results['mode1'] = {'a': slope1, 'b': intercept1, 'r2': r_val1**2}      
                                                                                
    # Linear Regression for Mode 2                                              
    if len(m2_x) > 1:                                                           
        slope2, intercept2, r_val2, _, _ = stats.linregress(m2_x, m2_dx)        
        results['mode2'] = {'a': slope2, 'b': intercept2, 'r2': r_val2**2}      
                                                                                
    # Switching points and resets                                               
    # Identify mode sequence                                                    
    modes = np.zeros(len(dx1))                                                  
    modes[idx1] = 1                                                             
    modes[idx2] = 2                                                             
                                                                                
    transitions = []                                                            
    resets = []                                                                 
    for i in range(len(modes) - 1):                                             
        if modes[i] != modes[i+1] and modes[i] != 0 and modes[i+1] != 0:        
            # Transition detected                                               
            trans_type = f"{int(modes[i])}->{int(modes[i+1])}"                  
            # x1 value at switch                                                
            x_switch = x1_mid[i]                                                
            # Reset check: x1 difference across the jump in the original array  
            # The indices in modes correspond to (i, i+1) in x1_mid, which are  
(i, i+1) in x1                                                                  
            jump = x1[i+1] - x1[i]                                              
            transitions.append((trans_type, x_switch))                          
            resets.append(jump)                                                 
                                                                                
    results['transitions'] = transitions                                        
    results['max_reset'] = np.max(np.abs(resets)) if resets else 0              
    return results                                                              
                                                                                
