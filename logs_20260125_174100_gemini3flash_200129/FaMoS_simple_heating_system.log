all_resets = [res for r in results for res in r['resets']]                      
avg_reset = np.mean(all_resets) if all_resets else 0                            
                                                                                
print(f"a1: {a1}, b1: {b1}, a2: {a2}, b2: {b2}")                                
print(f"Guard High: {guard_high}, Guard Low: {guard_low}")                      
