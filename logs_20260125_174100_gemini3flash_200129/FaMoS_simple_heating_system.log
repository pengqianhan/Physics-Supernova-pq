    all_heating_dx.extend(dx[heating_indices])                                  
    all_cooling_x.extend(x_mid[cooling_indices])                                
    all_cooling_dx.extend(dx[cooling_indices])                                  
                                                                                
    # Thresholds                                                                
    transitions_up = [] # Heating to Cooling                                    
    transitions_down = [] # Cooling to Heating                                  
                                                                                
