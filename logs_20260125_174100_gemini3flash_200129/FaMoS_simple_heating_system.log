import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def analyze_sample(sample_idx):                                                 
    data =                                                                      
np.load(f'data_all/FaMoS/simple_heating_system/sample_{sample_idx}.npz')        
    x = data['state'][0]                                                        
    dx = np.diff(x)                                                             
    x_mid = x[:-1]                                                              
                                                                                
    # Identify modes based on derivative sign                                   
    # Mode 1: increasing (dx > 0), Mode 2: decreasing (dx < 0)                  
    mode1_mask = dx > 0                                                         
    mode2_mask = dx < 0                                                         
                                                                                
    # Linear regression for Mode 1: dx = a1 * x + b1                            
    res1 = stats.linregress(x_mid[mode1_mask], dx[mode1_mask])                  
    # Linear regression for Mode 2: dx = a2 * x + b2                            
    res2 = stats.linregress(x_mid[mode2_mask], dx[mode2_mask])                  
                                                                                
    # Identify mode changes to find thresholds                                  
    modes = np.where(dx > 0, 1, 2)                                              
    mode_changes = np.where(modes[:-1] != modes[1:])[0]                         
                                                                                
    thresholds_to_2 = x[mode_changes[modes[mode_changes] == 1] + 1] # Switch    
from 1 to 2 happens at upper threshold                                          
    thresholds_to_1 = x[mode_changes[modes[mode_changes] == 2] + 1] # Switch    
from 2 to 1 happens at lower threshold                                          
                                                                                
    initial_mode = 1 if dx[0] > 0 else 2                                        
                                                                                
    return {                                                                    
        'initial_mode': initial_mode,                                           
        'mode1_reg': (res1.slope, res1.intercept, res1.rvalue**2),              
        'mode2_reg': (res2.slope, res2.intercept, res2.rvalue**2),              
        'upper_thresholds': thresholds_to_2,                                    
        'lower_thresholds': thresholds_to_1,                                    
        'segments': mode_changes                                                
    }                                                                           
                                                                                
results = []                                                                    
for i in range(3):                                                              
    res = analyze_sample(i)                                                     
    results.append(res)                                                         
    print(f"--- Sample {i} ---")                                                
    print(f"Initial Mode: {res['initial_mode']}")                               
    print(f"Mode 1 (Increasing): dx/dt = {res['mode1_reg'][0]:.6f} * x +        
{res['mode1_reg'][1]:.6f} (R^2={res['mode1_reg'][2]:.6f})")                     
    print(f"Mode 2 (Decreasing): dx/dt = {res['mode2_reg'][0]:.6f} * x +        
{res['mode2_reg'][1]:.6f} (R^2={res['mode2_reg'][2]:.6f})")                     
    print(f"Upper thresholds (avg): {np.mean(res['upper_thresholds']):.4f}")    
    print(f"Lower thresholds (avg): {np.mean(res['lower_thresholds']):.4f}")    
                                                                                
