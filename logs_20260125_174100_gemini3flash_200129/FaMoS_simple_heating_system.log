import numpy as np                                                              
from scipy import stats                                                         
                                                                                
data0 = np.load(DATA_FILE_PATHS[0])                                             
state = data0['state'][0]                                                       
diffs = state[1:] - state[:-1]                                                  
x_k = state[:-1]                                                                
x_kp1 = state[1:]                                                               
                                                                                
# Separate modes based on whether the temperature is rising or falling          
mode1_mask = diffs > 0                                                          
mode2_mask = diffs < 0                                                          
                                                                                
if np.any(mode1_mask):                                                          
    m1_x = x_k[mode1_mask]                                                      
    m1_y = x_kp1[mode1_mask]                                                    
    slope1, intercept1, r_value1, p_value1, std_err1 = stats.linregress(m1_x,   
m1_y)                                                                           
    print(f"Mode 1 (Heating): x[k+1] = {slope1} * x[k] + {intercept1}")         
    print(f"Mode 1 R-squared: {r_value1**2}")                                   
                                                                                
if np.any(mode2_mask):                                                          
    m2_x = x_k[mode2_mask]                                                      
    m2_y = x_kp1[mode2_mask]                                                    
    slope2, intercept2, r_value2, p_value2, std_err2 = stats.linregress(m2_x,   
m2_y)                                                                           
    print(f"Mode 2 (Cooling): x[k+1] = {slope2} * x[k] + {intercept2}")         
    print(f"Mode 2 R-squared: {r_value2**2}")                                   
                                                                                
# Check transitions                                                             
