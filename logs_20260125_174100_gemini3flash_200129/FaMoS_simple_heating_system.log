# Switches: [1719, 2166, 2594, ...]                                             
# Mode 1: heating (dx1 > 0)                                                     
# Mode 2: cooling (dx1 < 0)                                                     
increasing = dx1 > 0                                                            
switches = np.where(np.diff(increasing.astype(int)) != 0)[0]                    
                                                                                
def analyze_mode(indices, x, dx):                                               
    res = linregress(x[indices], dx[indices])                                   
    return res                                                                  
                                                                                
# Analyze first heating phase (until index 1719)                                
heat_indices = np.where(increasing[:switches[0]])[0]                            
res_heat = analyze_mode(heat_indices, x1, dx1)                                  
print(f"Heating mode (x1[k+1]-x1[k] = a*x1[k] + b): a={res_heat.slope},         
b={res_heat.intercept}, r^2={res_heat.rvalue**2}")                              
                                                                                
# Analyze first cooling phase (from 1719 to 2166)                               
cool_indices = np.where(~increasing[switches[0]+1:switches[1]])[0] + switches[0]
+ 1                                                                             
res_cool = analyze_mode(cool_indices, x1, dx1)                                  
print(f"Cooling mode (x1[k+1]-x1[k] = a*x1[k] + b): a={res_cool.slope},         
