  modes = np.sign(diffs) # 1 for heating (increasing), -1 for cooling           
  (decreasing)                                                                  
                                                                                
  peak_idx = -1                                                                 
  valley_idx = -1                                                               
                                                                                
  for i in range(1, len(modes)):                                                
      if modes[i-1] == 1 and modes[i] == -1:                                    
          peak_idx = i                                                          
          break                                                                 
                                                                                
  if peak_idx != -1:                                                            
      print(f"\nFirst Peak at index {peak_idx}:")                               
      for i in range(peak_idx - 2, peak_idx + 3):                               
          print(f"t={t[i]:.3f}, x1={x1[i]:.6f}")                                
                                                                                
  for i in range(peak_idx + 1, len(modes)):                                     
      if modes[i-1] == -1 and modes[i] == 1:                                    
          valley_idx = i                                                        
          break                                                                 
                                                                                
  if valley_idx != -1:                                                          
      print(f"\nFirst Valley at index {valley_idx}:")                           
      for i in range(valley_idx - 2, valley_idx + 3):                           
          print(f"t={t[i]:.3f}, x1={x1[i]:.6f}")                                
                                                                                
  # 3. Slopes at x1=15, 20, 25                                                  
  # We need to find when x1 is close to these values in both heating and        
  cooling modes.                                                                
  def get_slope_at_x(target_x, mode_val):                                       
      # mode_val: 1 for heating, -1 for cooling                                 
      # Find indices where state is in the correct mode                         
      indices = np.where(modes == mode_val)[0]                                  
      # Find the index in these where x1 is closest to target_x                 
      if len(indices) == 0: return None                                         
                                                                                
      # Let's find all crossings or closest points                              
      # We'll look for the first occurrence in the full array where mode is     
  correct and x1 crosses target_x                                               
      found_idx = -1                                                            
      for i in indices:                                                         
          if (x1[i] <= target_x <= x1[i+1]) or (x1[i] >= target_x >= x1[i+1]):  
              found_idx = i                                                     
              break                                                             
                                                                                
      if found_idx != -1:                                                       
          slope = (x1[found_idx+1] - x1[found_idx]) / 0.001                     
          return slope, t[found_idx], x1[found_idx]                             
      return None                                                               
                                                                                
  targets = [15, 20, 25]                                                        
  print("\nSlopes (dx1/dt):")                                                   
  for target in targets:                                                        
      h_res = get_slope_at_x(target, 1)                                         
      c_res = get_slope_at_x(target, -1)                                        
      if h_res:                                                                 
          print(f"Heating at x1={target}: slope={h_res[0]:.4f} (at              
  t={h_res[1]:.3f}, x1={h_res[2]:.4f})")                                        
      if c_res:                                                                 
          print(f"Cooling at x1={target}: slope={c_res[0]:.4f} (at              
  t={c_res[1]:.3f}, x1={c_res[2]:.4f})")                                        
