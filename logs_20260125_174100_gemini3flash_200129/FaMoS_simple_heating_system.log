      r2 = ssreg / sstot if sstot != 0 else 0                                   
      return coeffs[0], coeffs[1], r2                                           
                                                                                
  a_a, b_a, r2_a = get_fit(all_x1[mask_a], all_dx1[mask_a])                     
  a_b, b_b, r2_b = get_fit(all_x1[mask_b], all_dx1[mask_b])                     
                                                                                
  print(f"Mode A: a={a_a:.10f}, b={b_a:.10f}, R2={r2_a:.4f}")                   
  print(f"Mode B: a={a_b:.10f}, b={b_b:.10f}, R2={r2_b:.4f}")                   
                                                                                
  # Refine Thresholds                                                           
  thresholds_up = [] # B -> A (minima)                                          
  thresholds_down = [] # A -> B (maxima)                                        
  for i in range(3):                                                            
      x = results[f"sample_{i}"]["x1"]                                          
      for j in range(1, len(x)-1):                                              
          if x[j] < x[j-1] and x[j] < x[j+1]: # Min                             
              thresholds_up.append(x[j])                                        
          if x[j] > x[j-1] and x[j] > x[j+1]: # Max                             
              thresholds_down.append(x[j])                                      
                                                                                
  print(f"Upper thresholds (A->B) avg: {np.mean(thresholds_down) if             
  thresholds_down else 'N/A'}")                                                 
  print(f"Lower thresholds (B->A) avg: {np.mean(thresholds_up) if               
  thresholds_up else 'N/A'}")                                                   
  for i in range(3):                                                            
      print(f"Sample {i} start: {results[f'sample_{i}']['initial_mode']}")      
