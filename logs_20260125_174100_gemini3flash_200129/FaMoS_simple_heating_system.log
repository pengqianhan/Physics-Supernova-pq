  data = np.load(DATA_FILE_PATHS[0])                                            
  state = data['state'][0]                                                      
  dx = np.diff(state)                                                           
  modes = np.sign(dx)                                                           
                                                                                
  # Group segments                                                              
  mode_segments = []                                                            
  if len(modes) > 0:                                                            
      curr_m = modes[0]                                                         
      start_i = 0                                                               
      for i in range(1, len(modes)):                                            
          if modes[i] != curr_m:                                                
              mode_segments.append((curr_m, start_i, i))                        
              curr_m = modes[i]                                                 
              start_i = i                                                       
      mode_segments.append((curr_m, start_i, len(modes)))                       
                                                                                
  # Analyze switching conditions more closely                                   
  switches_up_to_down = [] # Heating to Cooling (sign 1 to -1)                  
  switches_down_to_up = [] # Cooling to Heating (sign -1 to 1)                  
                                                                                
  for i in range(len(mode_segments) - 1):                                       
      m_curr, start_curr, end_curr = mode_segments[i]                           
      m_next, start_next, end_next = mode_segments[i+1]                         
                                                                                
      switch_val = state[end_curr] # This is state[start_next]                  
                                                                                
      if m_curr == 1 and m_next == -1:                                          
          switches_up_to_down.append(switch_val)                                
      elif m_curr == -1 and m_next == 1:                                        
          switches_down_to_up.append(switch_val)                                
                                                                                
  print(f"Mean Switch Heating->Cooling: {np.mean(switches_up_to_down) if        
  switches_up_to_down else 'N/A'}")                                             
  print(f"Mean Switch Cooling->Heating: {np.mean(switches_down_to_up) if        
  switches_down_to_up else 'N/A'}")                                             
                                                                                
  # Check for resets again.                                                     
  # A reset would mean that the value of state[i+1] is not just state[i] +      
  dx_dt * dt                                                                    
  # But in a discrete-time sequence, dx is defined as state[i+1] - state[i].    
  # If there was a jump "between" steps, it might look like a very large dx.    
  # However, the linear regression R2=1.0 suggests every single dx fits the     
  linear model perfectly.                                                       
  # If there was a jump, the dx at that point wouldn't fit the dx = a*x + b     
  model.                                                                        
  # Let's check the residuals of the regression at the switching points.        
                                                                                
  regression_results = {}                                                       
  for m in [1.0, -1.0]:                                                         
      mask = (modes == m)                                                       
      X = state[:-1][mask]                                                      
      Y = dx[mask]                                                              
      A = np.vstack([X, np.ones(len(X))]).T                                     
      coeffs, _, _, _ = np.linalg.lstsq(A, Y, rcond=None)                       
      regression_results[m] = coeffs                                            
                                                                                
  # Check residuals specifically at transition points                           
  for i in range(len(mode_segments) - 1):                                       
      end_idx = mode_segments[i][2] # The index where the mode changes          
      # The last transition of mode i is from state[end_idx-1] to               
  state[end_idx]                                                                
      # The first transition of mode i+1 is from state[end_idx] to              
  state[end_idx+1]                                                              
                                                                                
      m_curr = mode_segments[i][0]                                              
      m_next = mode_segments[i+1][0]                                            
                                                                                
      # Calculate predicted dx for the last step of m_curr                      
      a_c, b_c = regression_results[m_curr]                                     
      pred_dx_c = a_c * state[end_idx-1] + b_c                                  
      actual_dx_c = state[end_idx] - state[end_idx-1]                           
                                                                                
      # Calculate predicted dx for the first step of m_next                     
      a_n, b_n = regression_results[m_next]                                     
      pred_dx_n = a_n * state[end_idx] + b_n                                    
      actual_dx_n = state[end_idx+1] - state[end_idx]                           
                                                                                
      if abs(pred_dx_c - actual_dx_c) > 1e-7 or abs(pred_dx_n - actual_dx_n) >  
  1e-7:                                                                         
          print(f"Possible reset/anomaly at index {end_idx}")                   
