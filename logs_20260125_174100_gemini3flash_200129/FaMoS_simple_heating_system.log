import numpy as np                                                              
from scipy.stats import linregress                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    # state shape is (1, 10001)                                                 
    x1 = data['state'][0]                                                       
    dt = 1.0 # Assuming unit time step as no time vector is provided            
                                                                                
    # Compute derivative                                                        
    dx1_dt = np.gradient(x1, dt)                                                
                                                                                
    # Identify modes based on derivative                                        
    # Mode 1: heating (x1 increasing), Mode 2: cooling (x1 decreasing)          
    # Since it's a thermostat, it's likely x1 increases then decreases.         
    # Let's use a small threshold to avoid noise if any                         
    mode1_indices = np.where(dx1_dt > 0)[0]                                     
    mode2_indices = np.where(dx1_dt < 0)[0]                                     
                                                                                
    # Fit dx1_dt = a*x1 + b for each mode                                       
    # Mode 1                                                                    
    if len(mode1_indices) > 1:                                                  
        slope1, intercept1, _, _, _ = linregress(x1[mode1_indices],             
dx1_dt[mode1_indices])                                                          
    else:                                                                       
        slope1, intercept1 = 0, 0                                               
                                                                                
    # Mode 2                                                                    
    if len(mode2_indices) > 1:                                                  
        slope2, intercept2, _, _, _ = linregress(x1[mode2_indices],             
dx1_dt[mode2_indices])                                                          
    else:                                                                       
        slope2, intercept2 = 0, 0                                               
                                                                                
    # Identify switching thresholds (guards)                                    
    # Mode 1 -> Mode 2: local maximum                                           
    # Mode 2 -> Mode 1: local minimum                                           
    switches_1_to_2 = []                                                        
    switches_2_to_1 = []                                                        
    resets = []                                                                 
                                                                                
    for i in range(len(x1) - 1):                                                
        # Detect mode change                                                    
        # Mode 1 to Mode 2                                                      
        if dx1_dt[i] > 0 and dx1_dt[i+1] < 0:                                   
            switches_1_to_2.append(x1[i])                                       
            resets.append(x1[i+1] - x1[i])                                      
        # Mode 2 to Mode 1                                                      
        elif dx1_dt[i] < 0 and dx1_dt[i+1] > 0:                                 
            switches_2_to_1.append(x1[i])                                       
            resets.append(x1[i+1] - x1[i])                                      
                                                                                
    # Initial mode                                                              
    initial_mode = 1 if dx1_dt[0] > 0 else 2                                    
                                                                                
    return {                                                                    
        'a1': slope1, 'b1': intercept1,                                         
        'a2': slope2, 'b2': intercept2,                                         
        'guard_high': np.mean(switches_1_to_2) if switches_1_to_2 else None,    
        'guard_low': np.mean(switches_2_to_1) if switches_2_to_1 else None,     
        'resets': resets,                                                       
        'initial_mode': initial_mode                                            
    }                                                                           
                                                                                
results = []                                                                    
for path in ['data_all/FaMoS/simple_heating_system/sample_0.npz',               
            'data_all/FaMoS/simple_heating_system/sample_1.npz',                
            'data_all/FaMoS/simple_heating_system/sample_2.npz']:               
    results.append(analyze_sample(path))                                        
                                                                                
# Average across samples                                                        
a1 = np.mean([r['a1'] for r in results])                                        
b1 = np.mean([r['b1'] for r in results])                                        
a2 = np.mean([r['a2'] for r in results])                                        
b2 = np.mean([r['b2'] for r in results])                                        
guard_high = np.mean([r['guard_high'] for r in results if r['guard_high'] is not
None])                                                                          
