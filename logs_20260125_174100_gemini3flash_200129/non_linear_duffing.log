      # Sort transitions by error magnitude and take top 18                     
      transitions = sorted(transitions, key=lambda idx: error[idx],             
  reverse=True)[:18]                                                            
      transitions.sort()                                                        
                                                                                
      # Fit each segment                                                        
      boundaries = [0] + transitions + [len(x)]                                 
      segment_coeffs = []                                                       
      for i in range(len(boundaries) - 1):                                      
          s, e = boundaries[i], boundaries[i+1]                                 
          if e - s < 5: continue                                                
          c_seg, _, _, _ = np.linalg.lstsq(X[s:e], a[s:e], rcond=None)          
          segment_coeffs.append(c_seg)                                          
                                                                                
      segment_coeffs = np.array(segment_coeffs)                                 
                                                                                
      # Determine unique modes (by rounding or clustering)                      
      # Here we round to find common dynamics                                   
      rounded = np.round(segment_coeffs, 2)                                     
      unique_modes, mode_counts = np.unique(rounded, axis=0,                    
  return_counts=True)                                                           
                                                                                
      # Analyze transition guards (displacement thresholds)                     
      x_at_trans = x[transitions]                                               
      v_at_trans = v[transitions]                                               
                                                                                
      return transitions, segment_coeffs, unique_modes, x_at_trans, v_at_trans  
                                                                                
  trans, coeffs, modes, x_t, v_t = analyze()                                    
  print(f"Transitions: {trans}")                                                
  print(f"Modes: {modes}")                                                      
