def fit_discrete(path):                                                         
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    # x[i+1] = b1*x[i] + b2*x[i-1] + b3*x[i]**3 + b4*u[i] + b5                  
    Y = x[2:]                                                                   
    X = np.stack([x[1:-1], x[:-2], x[1:-1]**3, u[1:-1], np.ones_like(x[1:-1])], 
axis=1)                                                                         
                                                                                
    c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                              
    return c                                                                    
                                                                                
