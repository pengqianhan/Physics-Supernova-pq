import matplotlib.pyplot as plt                                                 
                                                                                
# Load the first data file                                                      
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
state = data['state']                                                           
u = data['input']                                                               
                                                                                
# Correct indexing: state is (1, 10001)                                         
x1 = state[0, :]                                                                
u1 = u[0, :]                                                                    
                                                                                
# Assume dt = 0.1 if not provided, or try to infer it.                          
# Usually, for 10001 points, dt might be 0.01 or 0.1.                           
# Let's check the magnitude of derivatives.                                     
dt = 0.1                                                                        
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Let's search for the number of modes by looking at the consistency of the ODE.
# ODE: x1_ddot = c1*x1_dot + c2*x1 + c3*x1**3 + c4*u1 + bias                    
                                                                                
def get_ode_error(s, v, a, inp):                                                
    A = np.column_stack([v, s, s**3, inp, np.ones_like(s)])                     
    coeffs, residuals, rank, s_vals = np.linalg.lstsq(A, a, rcond=None)         
    error = np.mean((a - A @ coeffs)**2)                                        
    return error, coeffs                                                        
                                                                                
# Rolling window fit to detect switches                                         
window_size = 50                                                                
errors = []                                                                     
for i in range(len(x1) - window_size):                                          
    s_win = x1[i:i+window_size]                                                 
    v_win = x1_dot[i:i+window_size]                                             
    a_win = x1_ddot[i:i+window_size]                                            
    u_win = u1[i:i+window_size]                                                 
    err, _ = get_ode_error(s_win, v_win, a_win, u_win)                          
    errors.append(err)                                                          
                                                                                
plt.figure(figsize=(10, 4))                                                     
plt.plot(errors)                                                                
plt.yscale('log')                                                               
