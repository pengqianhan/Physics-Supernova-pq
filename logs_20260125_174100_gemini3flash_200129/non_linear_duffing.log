def find_change_points(x, v, u, a):                                             
    n = len(a)                                                                  
    window = 100                                                                
    all_coeffs = []                                                             
    for i in range(n - window):                                                 
        xt, vt, ut, at = x[i:i+window], v[i:i+window], u[i:i+window],           
a[i:i+window]                                                                   
        X = np.column_stack([vt, xt, xt**3, ut, np.ones_like(xt)])              
        c, _, _, _ = np.linalg.lstsq(X, at, rcond=None)                         
        all_coeffs.append(c)                                                    
                                                                                
    all_coeffs = np.array(all_coeffs)                                           
    diffs = np.linalg.norm(np.diff(all_coeffs, axis=0), axis=1)                 
                                                                                
    # Large diffs indicate change points                                        
    change_indices = np.where(diffs > 0.1 * np.mean(diffs))[0] # This threshold 
might need tuning                                                               
    # Filter to get only the start of a change                                  
    if len(change_indices) == 0: return []                                      
                                                                                
    real_changes = [change_indices[0]]                                          
    for idx in change_indices[1:]:                                              
        if idx > real_changes[-1] + window:                                     
            real_changes.append(idx)                                            
    return real_changes                                                         
                                                                                
