import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    dt = 0.01 # Assumption                                                      
                                                                                
    # Calculate derivatives                                                     
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
                                                                                
    # Prepare features: v, x, x^3, u, 1                                         
    features = np.column_stack([v, x, x**3, u, np.ones_like(x)])                
                                                                                
    # Let's use a sliding window of size 500 to see if coefficients change      
    window_size = 500                                                           
    coeffs = []                                                                 
    for i in range(0, len(x) - window_size, 100):                               
        X_win = features[i:i+window_size]                                       
        y_win = a[i:i+window_size]                                              
        model = LinearRegression().fit(X_win, y_win)                            
        coeffs.append(model.coef_[:4].tolist() + [model.intercept_])            
                                                                                
    return np.array(coeffs)                                                     
                                                                                
coeffs = analyze_sample(DATA_FILE_PATHS[0])                                     
