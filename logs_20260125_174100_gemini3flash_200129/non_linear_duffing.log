import numpy as np                                                              
                                                                                
def analyze_duffing(file_path):                                                 
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    dt = 0.01 # Standard dt                                                     
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    X = np.column_stack([v, x, x**3, u, np.ones_like(x)])                       
                                                                                
    # Global fit to find transitions                                            
    c_glob, _, _, _ = np.linalg.lstsq(X, a, rcond=None)                         
    error = np.abs(a - np.dot(X, c_glob))                                       
                                                                                
    # Find local error peaks                                                    
    peaks = []                                                                  
    win = 50                                                                    
    for i in range(win, len(error)-win):                                        
        if error[i] == np.max(error[i-win:i+win]) and error[i] >                
np.percentile(error, 95):                                                       
            peaks.append(i)                                                     
                                                                                
    # Top 18 peaks                                                              
    if len(peaks) > 18:                                                         
        peaks = sorted(peaks, key=lambda i: error[i], reverse=True)[:18]        
    peaks.sort()                                                                
                                                                                
    boundaries = [0] + peaks + [len(x)]                                         
    segment_coeffs = []                                                         
    for i in range(len(boundaries)-1):                                          
        s, e = boundaries[i], boundaries[i+1]                                   
        if e - s < 20: continue                                                 
        c, _, _, _ = np.linalg.lstsq(X[s:e], a[s:e], rcond=None)                
        segment_coeffs.append(c)                                                
                                                                                
    return np.array(segment_coeffs), x[peaks], v[peaks]                         
                                                                                
# Collect from sample 0                                                         
coeffs, x_peaks, v_peaks =                                                      
analyze_duffing('data_all/non_linear/duffing/sample_0.npz')                     
                                                                                
print("Fitted Coefficients per segment:")                                       
for c in coeffs:                                                                
    print(np.round(c, 4))                                                       
                                                                                
print("\nGuards (x at transitions):")                                           
print(np.sort(np.unique(np.round(x_peaks, 2))))                                 
                                                                                
