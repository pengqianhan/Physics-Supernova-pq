Thought: I will load the data from the first sample, calculate the first and    
second derivatives of the state variable $x1$, and inspect the input $u1$. I    
will assume a time step $dt=0.001$ based on the 10-second duration and 10001    
data points. Then, I will compute the terms for the regression model and look   
for discontinuities or changes in the relationship between $x1''$ and the other 
variables to identify mode transitions.                                         
                                                                                
<code>                                                                          
import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load sample 0                                                                 
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
x1 = data['state'][0]                                                           
u1 = data['input'][0]                                                           
dt = 0.001                                                                      
t = np.linspace(0, 10, len(x1))                                                 
                                                                                
# Calculate derivatives                                                         
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Let's plot u1 to see its behavior                                             
print("u1 unique values count:", len(np.unique(u1)))                            
print("u1 range:", np.min(u1), np.max(u1))                                      
                                                                                
# Let's see if we can find where the dynamics change.                           
# We can use a rolling window regression or just look for spikes in the error of
a global fit.                                                                   
# Equation: x1_ddot = c1*x1_dot + c2*x1 + c3*(x1**3) + c4*u1 + c5               
                                                                                
# Construct the feature matrix                                                  
X = np.column_stack([x1_dot, x1, x1**3, u1, np.ones_like(x1)])                  
y = x1_ddot                                                                     
                                                                                
# Global regression to see the residuals                                        
coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)                  
y_pred = X @ coeffs                                                             
error = np.abs(y - y_pred)                                                      
                                                                                
# Detect change points by looking at error peaks                                
# or maybe the input u1 changes at specific times?                              
plt.figure(figsize=(12, 6))                                                     
plt.plot(t, error)                                                              
plt.title("Error of global regression")                                         
plt.xlabel("Time (s)")                                                          
plt.ylabel("Absolute error")                                                    
plt.savefig("error_plot.png")                                                   
                                                                                
# Also look at u1                                                               
plt.figure(figsize=(12, 6))                                                     
plt.plot(t, u1)                                                                 
plt.title("Input u1")                                                           
plt.xlabel("Time (s)")                                                          
plt.savefig("u1_plot.png")                                                      
                                                                                
print("Error mean:", np.mean(error))                                            
print("Error max:", np.max(error))                                              
                                                                                
