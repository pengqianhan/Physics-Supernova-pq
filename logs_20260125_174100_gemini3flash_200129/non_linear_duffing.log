def get_data(path, dt=0.1):                                                     
    d = np.load(path)                                                           
    x = d['state'][0]                                                           
    u = d['input'][0]                                                           
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return x, v, a, u                                                           
                                                                                
