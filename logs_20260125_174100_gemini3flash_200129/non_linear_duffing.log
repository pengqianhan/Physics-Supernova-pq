    # Model: x1[2] = a*x1[1] + b*x1[0] + c*x1[0]**3 + d*u1 + e                  
    X_reg = np.stack([                                                          
        x1_1[idx],                                                              
        x1_0[idx],                                                              
        x1_0[idx]**3,                                                           
        u1[idx],                                                                
        np.ones_like(x1_0[idx])                                                 
    ], axis=1)                                                                  
    y_reg = x1_2[idx]                                                           
                                                                                
    try:                                                                        
        model = LinearRegression().fit(X_reg, y_reg)                            
        coeffs = model.coef_                                                    
        # LinearRegression.coef_ returns [a, b, c, d, 0] if intercept is False, 
        # but here I included a column of ones, so the last coeff is e.         
        # Actually, let's use fit_intercept=True and remove the ones column.    
                                                                                
        X_reg_clean = X_reg[:, :-1]                                             
        model = LinearRegression(fit_intercept=True).fit(X_reg_clean, y_reg)    
        coeffs = np.append(model.coef_, model.intercept_)                       
                                                                                
        pred = model.predict(X_reg_clean)                                       
        mse = np.mean((y_reg - pred)**2)                                        
                                                                                
        coeffs_list.append(coeffs)                                              
        errors.append(mse)                                                      
        indices.append(i + window_size // 2)                                    
    except:                                                                     
        continue                                                                
                                                                                
coeffs_arr = np.array(coeffs_list)                                              
errors_arr = np.array(errors)                                                   
                                                                                
# Identify change points where error spikes or coeffs change significantly      
# Check for significant changes in coefficients                                 
coeff_diffs = np.linalg.norm(np.diff(coeffs_arr, axis=0), axis=1)               
change_point_indices = np.where(coeff_diffs > np.percentile(coeff_diffs, 95))[0]
                                                                                
# Clustering the segments to find modes                                         
# Use the coefficient trajectories for clustering                               
kmeans = KMeans(n_clusters=2, random_state=42).fit(coeffs_arr)                  
labels = kmeans.labels_                                                         
centers = kmeans.cluster_centers_                                               
                                                                                
print("Cluster Centers (a, b, c, d, e):")                                       
print(centers)                                                                  
                                                                                
# Final output preparation                                                      
print("Change points found at indices:", [indices[i] for i in                   
change_point_indices])                                                          
                                                                                
