import numpy as np                                                              
from scipy.signal import find_peaks                                             
                                                                                
# Function to load and prepare data                                             
def prepare_data(file_path, dt=0.1):                                            
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return x, v, a, u                                                           
                                                                                
# Load Sample 0                                                                 
dt = 0.1                                                                        
x, v, a, u = prepare_data('data_all/non_linear/duffing/sample_0.npz', dt)       
                                                                                
# Feature matrix: [v, x, x^3, u, 1]                                             
X = np.column_stack([v, x, x**3, u, np.ones_like(x)])                           
                                                                                
# Global fit                                                                    
coeffs_global, residuals, rank, s = np.linalg.lstsq(X, a, rcond=None)           
pred_a_global = X @ coeffs_global                                               
error = np.abs(a - pred_a_global)                                               
                                                                                
# Identify peaks in error as transitions                                        
# We expect about 18 transitions.                                               
peaks, _ = find_peaks(error, height=np.percentile(error, 90), distance=50)      
print(f"Number of transitions detected in sample_0: {len(peaks)}")              
print(f"Transition indices: {peaks}")                                           
                                                                                
# If we have 18 transitions, we have 19 segments.                               
segments = []                                                                   
start_idx = 0                                                                   
for p in peaks:                                                                 
    segments.append((start_idx, p))                                             
    start_idx = p                                                               
segments.append((start_idx, len(x)))                                            
                                                                                
# Fit each segment and collect coefficients                                     
segment_coeffs = []                                                             
for start, end in segments:                                                     
    if end - start < 10: continue # Skip too small segments                     
    X_seg = X[start:end]                                                        
    a_seg = a[start:end]                                                        
    c, _, _, _ = np.linalg.lstsq(X_seg, a_seg, rcond=None)                      
    segment_coeffs.append(c)                                                    
                                                                                
segment_coeffs = np.array(segment_coeffs)                                       
print("Shape of segment_coeffs:", segment_coeffs.shape)                         
                                                                                
# Let's see if coefficients cluster into modes                                  
