        current_mode = 1 if abs(x1[0]) > (t12 + t21) / 2 else 2                 
                                                                                
        for k in range(len(x1) - 2):                                            
            # We are at k, looking at transition at k+1 to predict k+2          
            x1_k = x1[k]                                                        
            x1_k1 = x1[k+1]                                                     
            x1_k2 = x1[k+2]                                                     
            u1_k = u1[k]                                                        
                                                                                
            # Transition logic (Hysteresis)                                     
            if current_mode == 1:                                               
                if abs(x1_k1) < t12:                                            
                    current_mode = 2                                            
            else:                                                               
                if abs(x1_k1) > t21:                                            
                    current_mode = 1                                            
                                                                                
            # Feature vector: [x1[k+1], x1[k], x1[k]^3, u1[k], 1]               
            features = [x1_k1, x1_k, x1_k**3, u1_k, 1.0]                        
            target = x1_k2                                                      
                                                                                
            if current_mode == 1:                                               
                m1_X.append(features)                                           
                m1_Y.append(target)                                             
            else:                                                               
                m2_X.append(features)                                           
                m2_Y.append(target)                                             
                                                                                
    def fit(X_list, Y_list):                                                    
        if not X_list: return None, 0, 0                                        
        X = np.array(X_list)                                                    
        Y = np.array(Y_list)                                                    
        beta, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)            
        sse = np.sum((Y - X @ beta)**2)                                         
        return beta, sse, len(Y)                                                
                                                                                
    res1 = fit(m1_X, m1_Y)                                                      
    res2 = fit(m2_X, m2_Y)                                                      
                                                                                
    total_sse = res1[1] + res2[1]                                               
    total_n = res1[2] + res2[2]                                                 
    mse = total_sse / total_n                                                   
                                                                                
    return mse, res1[0], res2[0], res1[2], res2[2]                              
                                                                                
