def check_periodicity(sample_idx):                                              
    data = np.load(f'data_all/non_linear/duffing/sample_{sample_idx}.npz')      
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    Y = x[2:] - 2*x[1:-1] + x[:-2]                                              
    dx = x[1:-1] - x[:-2]                                                       
    x_val = x[:-2]                                                              
    x3_val = x[:-2]**3                                                          
    u_val = u[:-2]                                                              
    features = np.column_stack([dx, x_val, x3_val, u_val, np.ones_like(x_val)]) 
                                                                                
    # Fit on first 1000 points                                                  
    c, _, _, _ = np.linalg.lstsq(features[:1000], Y[:1000], rcond=None)         
    pred = np.dot(features, c)                                                  
    error = np.abs(Y - pred)                                                    
    return error                                                                
                                                                                
error0 = check_periodicity(0)                                                   
# Find where error is large                                                     
