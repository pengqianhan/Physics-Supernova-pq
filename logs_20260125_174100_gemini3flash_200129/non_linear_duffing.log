import numpy as np                                                              
                                                                                
def analyze_sample(file_path, dt=0.01):                                         
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    # Derivatives                                                               
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
                                                                                
    # Feature matrix: [v, x, x**3, u, 1]                                        
    X = np.column_stack([v, x, x**3, u, np.ones_like(x)])                       
                                                                                
    # Use global fit to find transitions                                        
    c_glob, _, _, _ = np.linalg.lstsq(X, a, rcond=None)                         
    pred_a = np.dot(X, c_glob)                                                  
    error = np.abs(a - pred_a)                                                  
                                                                                
    # 18 transitions means 19 segments.                                         
    # We find peaks in the error                                                
    # Instead of scipy.signal.find_peaks (which might fail or be restricted),   
    # let's look for local maxima above a threshold.                            
                                                                                
    transitions = []                                                            
    window = 50                                                                 
    for i in range(window, len(error) - window):                                
        if error[i] == np.max(error[i-window:i+window]) and error[i] >          
np.mean(error)*2:                                                               
            transitions.append(i)                                               
                                                                                
    # Filter to get exactly the top 18 if many are found                        
    if len(transitions) > 18:                                                   
        transitions.sort(key=lambda idx: error[idx], reverse=True)              
        transitions = sorted(transitions[:18])                                  
                                                                                
    # Fit segments                                                              
    boundaries = [0] + transitions + [len(x)]                                   
    coeffs = []                                                                 
    for i in range(len(boundaries)-1):                                          
        s, e = boundaries[i], boundaries[i+1]                                   
        if e - s < 10: continue                                                 
        X_seg = X[s:e]                                                          
        a_seg = a[s:e]                                                          
        c, _, _, _ = np.linalg.lstsq(X_seg, a_seg, rcond=None)                  
        coeffs.append(c)                                                        
                                                                                
    return transitions, np.array(coeffs), x, v                                  
                                                                                
