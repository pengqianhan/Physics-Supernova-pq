    A = np.stack([x1_1[idx], x1_0[idx], x1_0[idx]**3, u1[idx],                  
np.ones(window_size)], axis=1)                                                  
    b = x1_2[idx]                                                               
                                                                                
    # Use lstsq to solve the linear system                                      
    sol, resid, rank, s = np.linalg.lstsq(A, b, rcond=None)                     
    coeffs_list.append(sol)                                                     
                                                                                
    # Error calculation                                                         
    pred = A @ sol                                                              
    mse = np.mean((b - pred)**2)                                                
    errors_list.append(mse)                                                     
    mid_indices.append(i + window_size // 2)                                    
                                                                                
