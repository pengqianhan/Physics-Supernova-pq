mode2 = np.array([-0.02, 0.01, -0.005, 0.01, 0])                                
                                                                                
def classify_modes(file_path):                                                  
    d = np.load(file_path)                                                      
    state_vals = d['state'][0]                                                  
    input_vals = d['input'][0]                                                  
                                                                                
    x_p = state_vals[1:-1]                                                      
    v_p = (state_vals[2:] - state_vals[:-2]) / (2 * delta_t)                    
