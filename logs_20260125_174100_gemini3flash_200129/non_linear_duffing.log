                "bias": coeffs_pos[4]                                           
            }                                                                   
        },                                                                      
        "Guard Conditions": "Transitions trigger when sign(x) changes           
(zero-crossing).",                                                              
        "Resets": "None detected (trajectories are continuous in x and dx).",   
