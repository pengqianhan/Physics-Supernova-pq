import pandas as pd                                                             
                                                                                
# Let's try dt = 0.01                                                           
dt = 0.01                                                                       
                                                                                
def process_file(path, dt):                                                     
    data = np.load(path)                                                        
    x1 = data['state'][0]                                                       
    u1 = data['input'][0]                                                       
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
    return pd.DataFrame({                                                       
        'x1': x1, 'x1_dot': x1_dot, 'x1_ddot': x1_ddot, 'u1': u1, 'abs_x1':     
np.abs(x1)                                                                      
    })                                                                          
                                                                                
dfs = [process_file(p, dt) for p in ['data_all/non_linear/duffing/sample_0.npz',
'data_all/non_linear/duffing/sample_1.npz',                                     
'data_all/non_linear/duffing/sample_2.npz']]                                    
full_df = pd.concat(dfs, ignore_index=True)                                     
                                                                                
def get_error(df_subset, coeffs):                                               
    if len(df_subset) == 0: return 0                                            
    X = np.column_stack([                                                       
        df_subset['x1_dot'].values,                                             
        df_subset['x1'].values,                                                 
        df_subset['x1'].values**3,                                              
        df_subset['u1'].values,                                                 
        np.ones(len(df_subset))                                                 
    ])                                                                          
    preds = np.dot(X, coeffs)                                                   
    return np.mean(np.abs(df_subset['x1_ddot'].values - preds))                 
                                                                                
# Find modes using hysteresis                                                   
# We need to assign each point to a mode.                                       
def assign_modes(df, t_up, t_down):                                             
    modes = np.zeros(len(df))                                                   
    current_mode = 1 # Start in Mode 1                                          
    abs_x = df['abs_x1'].values                                                 
    for i in range(len(df)):                                                    
        if current_mode == 1:                                                   
            if abs_x[i] > t_up:                                                 
                current_mode = 2                                                
        else:                                                                   
            if abs_x[i] < t_down:                                               
                current_mode = 1                                                
        modes[i] = current_mode                                                 
    return modes                                                                
                                                                                
# Search for best hysteresis thresholds                                         
best_err = float('inf')                                                         
best_params = (0, 0)                                                            
best_coeffs = (None, None)                                                      
                                                                                
