import numpy as np                                                              
from scipy import stats                                                         
                                                                                
# 1. Load Data                                                                  
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
x = data['state'][0]                                                            
u = data['input'][0]                                                            
                                                                                
# 2. Compute Derivatives (assume dt = 1.0)                                      
dx = np.gradient(x)                                                             
ddx = np.gradient(dx)                                                           
                                                                                
# 3. Model Regression                                                           
# The model is ddx = c1*dx + c2*x + c3*x^3 + c4*u + bias                        
# Mode Identification: Based on x sign (common in Duffing hybrid systems)       
mode_neg = (x < 0)                                                              
mode_pos = (x >= 0)                                                             
                                                                                
def fit_mode(mask):                                                             
    X = x[mask]                                                                 
    DX = dx[mask]                                                               
    DDX = ddx[mask]                                                             
    U = u[mask]                                                                 
    X3 = X**3                                                                   
                                                                                
    # Construct regression matrix                                               
    A = np.column_stack([DX, X, X3, U, np.ones_like(X)])                        
    coeffs, residuals, rank, s = np.linalg.lstsq(A, DDX, rcond=None)            
    return coeffs                                                               
                                                                                
coeffs_neg = fit_mode(mode_neg)                                                 
coeffs_pos = fit_mode(mode_pos)                                                 
                                                                                
# 4. Results Preparation                                                        
# Transitions occur when x crosses 0                                            
transitions = np.where(np.diff(np.signbit(x)))[0]                               
                                                                                
# Check for resets                                                              
# Resets would appear as discontinuities in x or dx at transition points.       
# We check the difference in state across transitions.                          
resets_found = False                                                            
for t in transitions:                                                           
    if abs(x[t+1] - x[t]) > 1e-2 or abs(dx[t+1] - dx[t]) > 1e-2:                
        resets_found = True                                                     
        break                                                                   
                                                                                
# Format output                                                                 
