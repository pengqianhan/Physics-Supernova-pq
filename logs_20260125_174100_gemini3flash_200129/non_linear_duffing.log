    print(f"Transitions count: {len(transitions)}")                             
                                                                                
    # Fit modes                                                                 
    A = np.column_stack([x1_1, x1_0, x1_0**3, u1, np.ones_like(x1_0)])          
    model_params = {}                                                           
    for m in np.unique(labels):                                                 
        mask = (labels == m)                                                    
        if np.sum(mask) > 10:                                                   
            c, _, _, _ = np.linalg.lstsq(A[mask], x1_2[mask], rcond=None)       
            model_params[m] = c                                                 
