    err, c1, c2 = get_error(mask, X_features, acc)                              
    if err < best_err:                                                          
        best_err, best_thresh, best_type, best_coefs = err, t, 'abs(x) > t',    
(c1, c2)                                                                        
                                                                                
print(f"Best Type: {best_type}")                                                
print(f"Best Threshold: {best_thresh}")                                         
print(f"Mode 1 Coefs (a, b, c, d, e): {best_coefs[0]}")                         
print(f"Mode 2 Coefs (a, b, c, d, e): {best_coefs[1]}")                         
                                                                                
