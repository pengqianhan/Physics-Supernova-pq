<code>                                                                          
import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
                                                                                
def fit_mode_all_samples(threshold_mask_func):                                  
    all_X, all_y = [], []                                                       
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x1 = data['state'][0]                                                   
        u1 = data['input'][0]                                                   
        mask = threshold_mask_func(x1)                                          
        idx = np.where(mask[:-2] & mask[1:-1] & mask[2:])[0]                    
        if len(idx) > 0:                                                        
            X = np.column_stack([x1[idx+1], x1[idx], x1[idx]**3, u1[idx],       
np.ones_like(idx)])                                                             
            all_X.append(X)                                                     
            all_y.append(x1[idx+2])                                             
                                                                                
    X_total = np.concatenate(all_X)                                             
    y_total = np.concatenate(all_y)                                             
    c, _, _, _ = np.linalg.lstsq(X_total, y_total, rcond=None)                  
                                                                                
    a = (c[0] - 2) / dt                                                         
    b = (c[1] + 1 + a * dt) / (dt**2)                                           
    c_ode = c[2] / (dt**2)                                                      
    d = c[3] / (dt**2)                                                          
    e = c[4] / (dt**2)                                                          
    return a, b, c_ode, d, e                                                    
                                                                                
print("Mode 1 (|x1| <= 1.2):")                                                  
print(fit_mode_all_samples(lambda x: np.abs(x) <= 1.2))                         
print("\nMode 2 (|x1| > 1.2):")                                                 
print(fit_mode_all_samples(lambda x: np.abs(x) > 1.2))                          
                                                                                
