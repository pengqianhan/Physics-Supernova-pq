from sklearn.linear_model import LinearRegression                               
                                                                                
# List of files                                                                 
files = ['data_all/non_linear/duffing/sample_0.npz',                            
'data_all/non_linear/duffing/sample_1.npz',                                     
'data_all/non_linear/duffing/sample_2.npz']                                     
                                                                                
data_mode1 = []                                                                 
data_mode2 = []                                                                 
                                                                                
def process_file(filepath):                                                     
    data = np.load(filepath)                                                    
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    n = len(x)                                                                  
                                                                                
    # Determine initial mode                                                    
    # Start with a search for the first point that clearly defines the mode     
    current_mode = None                                                         
    for val in x:                                                               
        if abs(val) > 1.2:                                                      
            current_mode = 1                                                    
            break                                                               
        elif abs(val) < 0.8:                                                    
            current_mode = 2                                                    
            break                                                               
                                                                                
    # If no point is outside [0.8, 1.2], which is unlikely for Duffing, default 
to 1 or 2                                                                       
    if current_mode is None:                                                    
        current_mode = 1 if abs(x[0]) > 1.0 else 2                              
                                                                                
    # Iterate and track mode                                                    
    for k in range(n - 2):                                                      
        # Update mode based on current state x[k]                               
        if current_mode == 1 and abs(x[k]) < 0.8:                               
            current_mode = 2                                                    
        elif current_mode == 2 and abs(x[k]) > 1.2:                             
            current_mode = 1                                                    
                                                                                
        # Feature vector: [x1[k+1], x1[k], x1[k]**3, u1[k], 1]                  
        # Target: x1[k+2]                                                       
        features = [x[k+1], x[k], x[k]**3, u[k]]                                
        target = x[k+2]                                                         
                                                                                
        if current_mode == 1:                                                   
            data_mode1.append(features + [target])                              
        else:                                                                   
            data_mode2.append(features + [target])                              
                                                                                
for f in files:                                                                 
    process_file(f)                                                             
                                                                                
# Convert to numpy arrays                                                       
data_mode1 = np.array(data_mode1)                                               
data_mode2 = np.array(data_mode2)                                               
                                                                                
def fit_mode(data_arr):                                                         
    X = data_arr[:, :4]                                                         
    y = data_arr[:, 4]                                                          
    reg = LinearRegression().fit(X, y)                                          
    return reg.coef_, reg.intercept_                                            
                                                                                
coef1, intercept1 = fit_mode(data_mode1)                                        
coef2, intercept2 = fit_mode(data_mode2)                                        
                                                                                
print("Mode 1 (Outer):")                                                        
