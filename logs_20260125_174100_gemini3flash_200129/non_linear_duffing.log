import numpy as np                                                              
                                                                                
def evaluate_dt(dt):                                                            
    all_x, all_dx, all_ddx, all_u = [], [], [], []                              
    for i in range(3):                                                          
        data = np.load(DATA_FILE_PATHS[i])                                      
        x = data['state'][0]                                                    
        u = data['input'][0]                                                    
        dx = np.gradient(x, dt)                                                 
        ddx = np.gradient(dx, dt)                                               
        all_x.append(x)                                                         
        all_dx.append(dx)                                                       
        all_ddx.append(ddx)                                                     
        all_u.append(u)                                                         
    X = np.concatenate(all_x)                                                   
    DX = np.concatenate(all_dx)                                                 
    DDX = np.concatenate(all_ddx)                                               
    U = np.concatenate(all_u)                                                   
                                                                                
    # Simple split                                                              
    m1 = X > 0                                                                  
    p1 = fit_least_squares(X[m1], DX[m1], DDX[m1], U[m1])                       
    p2 = fit_least_squares(X[~m1], DX[~m1], DDX[~m1], U[~m1])                   
                                                                                
    # Calculate MSE                                                             
    A = np.column_stack([DX, X, X**3, U, np.ones_like(X)])                      
    mse1 = np.mean((DDX[m1] - np.dot(A[m1], p1))**2)                            
    mse2 = np.mean((DDX[~m1] - np.dot(A[~m1], p2))**2)                          
    return (mse1 + mse2) / 2, p1, p2                                            
                                                                                
for dt_val in [0.01, 0.02, 0.05, 0.1]:                                          
    mse, p1, p2 = evaluate_dt(dt_val)                                           
    print(f"dt={dt_val}, MSE={mse:.8f}")                                        
    print(f"  P1: {p1}")                                                        
    print(f"  P2: {p2}")                                                        
                                                                                
