import numpy as np                                                              
                                                                                
def analyze_error_all():                                                        
    all_x, all_u, all_dx, all_Y = [], [], [], []                                
    for i in range(3):                                                          
        data = np.load(f'data_all/non_linear/duffing/sample_{i}.npz')           
        x = data['state'][0]                                                    
        u = data['input'][0]                                                    
        all_x.append(x[:-2])                                                    
        all_u.append(u[:-2])                                                    
        all_dx.append(x[1:-1] - x[:-2])                                         
        all_Y.append(x[2:] - 2*x[1:-1] + x[:-2])                                
                                                                                
    x = np.concatenate(all_x)                                                   
    u = np.concatenate(all_u)                                                   
    dx = np.concatenate(all_dx)                                                 
    Y = np.concatenate(all_Y)                                                   
                                                                                
    # Fit Mode 1 (assuming it's the one for large x)                            
    mask1 = np.abs(x) > 2.0                                                     
    features = np.column_stack([dx, x, x**3, u, np.ones_like(x)])               
    c1, _, _, _ = np.linalg.lstsq(features[mask1], Y[mask1], rcond=None)        
                                                                                
    error = np.abs(Y - np.dot(features, c1))                                    
    return x, dx, u, error                                                      
                                                                                
x, dx, u, error = analyze_error_all()                                           
high_error = error > 1e-4                                                       
                                                                                
# Analyze what characterizes high_error points                                  
