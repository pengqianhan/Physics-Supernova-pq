    for m in np.unique(labels):                                                 
        mask = (labels == m)                                                    
        if np.sum(mask) > 10:                                                   
            c, _, _, _ = np.linalg.lstsq(A[mask], x1_acc[mask], rcond=None)     
            coeffs[m] = c                                                       
            print(f"Mode {m} coeffs: {c}")                                      
                                                                                
    # 5. Switching conditions                                                   
    # Check if switches happen at specific values of x1_pos, x1_vel, or u1      
    trans_states = feats[transitions]                                           
    print("States at transitions (x1, v, a, u):")                               
    print(trans_states[:5])                                                     
                                                                                
    # 6. Check for resets                                                       
    # Discontinuity in x1_pos or x1_vel at switching points                     
    print("Reset check (jumps at transitions):")                                
    for i in transitions[:5]:                                                   
        dx = x1_pos[i+1] - x1_pos[i]                                            
        dv = x1_vel[i+1] - x1_vel[i]                                            
        print(f"t={t[i]:.3f}: dx={dx:.6f}, dv={dv:.6f}")                        
                                                                                
    # Check if u1 switches at these points                                      
    print("Input u1 at transitions:")                                           
    for i in transitions[:5]:                                                   
        print(f"t={t[i]:.3f}: u1={u1[i]:.4f}")                                  
                                                                                
