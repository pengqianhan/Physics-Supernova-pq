    data = np.load(p)                                                           
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    # dt might be 0.1                                                           
    dt = 0.1                                                                    
    dx = np.gradient(x, dt)                                                     
    ddx = np.gradient(dx, dt)                                                   
                                                                                
    for i in range(0, len(x) - segment_size, segment_size):                     
        xs = x[i:i+segment_size]                                                
        dxs = dx[i:i+segment_size]                                              
        ddxs = ddx[i:i+segment_size]                                            
        us = u[i:i+segment_size]                                                
                                                                                
        A = np.column_stack([dxs, xs, xs**3, us, np.ones_like(xs)])             
        c, _, _, _ = np.linalg.lstsq(A, ddxs, rcond=None)                       
        coeffs_list.append(c)                                                   
                                                                                
coeffs_list = np.array(coeffs_list)                                             
