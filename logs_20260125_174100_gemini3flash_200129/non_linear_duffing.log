import numpy as np                                                              
from scipy import linalg                                                        
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
x = data['state'][0]                                                            
u = data['input'][0]                                                            
dt = 0.01  # Standard dt for these benchmarks                                   
                                                                                
# Compute derivatives                                                           
v = np.diff(x) / dt                                                             
a = np.diff(v) / dt                                                             
                                                                                
# Synchronize indices                                                           
# x[i], v[i], a[i], u[i]                                                        
x_val = x[:-2]                                                                  
v_val = v[:-1]                                                                  
u_val = u[:-2]                                                                  
a_val = a                                                                       
x3_val = x_val**3                                                               
ones = np.ones_like(x_val)                                                      
                                                                                
# Combine features                                                              
X = np.column_stack([v_val, x_val, x3_val, u_val, ones])                        
                                                                                
# Detect mode changes by checking local fits or jumps                           
# Let's check for jumps in a or x                                               
jumps_x = np.where(np.abs(np.diff(x)) > 0.5)[0]                                 
jumps_v = np.where(np.abs(np.diff(v)) > 5.0)[0]                                 
print("Jumps in x:", jumps_x)                                                   
print("Jumps in v:", jumps_v)                                                   
                                                                                
# If there are no jumps, maybe the coefficients change                          
# Try to find segments. Let's look at a plot-like analysis of residuals         
def fit_segment(X_seg, y_seg):                                                  
    try:                                                                        
        coeffs, _, _, _ = np.linalg.lstsq(X_seg, y_seg, rcond=None)             
        return coeffs                                                           
    except:                                                                     
        return None                                                             
                                                                                
# Check the whole range for switches                                            
n = len(a_val)                                                                  
segment_ends = []                                                               
current_start = 0                                                               
window_size = 100                                                               
                                                                                
for i in range(window_size, n - window_size, window_size):                      
    # Fit left and right windows                                                
    c_left = fit_segment(X[i-window_size:i], a_val[i-window_size:i])            
    c_right = fit_segment(X[i:i+window_size], a_val[i:i+window_size])           
    if c_left is not None and c_right is not None:                              
        if np.linalg.norm(c_left - c_right) > 0.1 * np.linalg.norm(c_left):     
            # Potential change point                                            
            segment_ends.append(i)                                              
                                                                                
print("Potential segment ends:", segment_ends)                                  
                                                                                
