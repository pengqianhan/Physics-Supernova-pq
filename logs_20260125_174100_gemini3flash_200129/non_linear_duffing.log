import numpy as np                                                              
                                                                                
def find_switches(dt=0.1):                                                      
    data = np.load(DATA_FILE_PATHS[0])                                          
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    x_m, v, acc, u_m = get_derivatives(x, u, dt=dt)                             
                                                                                
    # Global fit                                                                
    X = np.stack([v, x_m, x_m**3, u_m, np.ones_like(x_m)], axis=1)              
    c, _, _, _ = np.linalg.lstsq(X, acc, rcond=None)                            
    pred = c[0]*v + c[1]*x_m + c[2]*(x_m**3) + c[3]*u_m + c[4]                  
    errors = np.abs(acc - pred)                                                 
                                                                                
    # Indices where error is significantly higher than median                   
    threshold = 5 * np.median(errors)                                           
    switches = np.where(errors > threshold)[0]                                  
    return switches, errors                                                     
                                                                                
