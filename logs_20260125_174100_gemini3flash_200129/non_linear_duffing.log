import numpy as np                                                              
                                                                                
# Load data files                                                               
data_files = ['data_all/non_linear/duffing/sample_0.npz',                       
'data_all/non_linear/duffing/sample_1.npz',                                     
'data_all/non_linear/duffing/sample_2.npz']                                     
                                                                                
all_x = []                                                                      
all_u = []                                                                      
                                                                                
for file in data_files:                                                         
    data = np.load(file)                                                        
    # Check shape again                                                         
    s = data['state']                                                           
    if s.ndim == 2 and s.shape[0] > 1:                                          
        # Maybe it's [x, v]                                                     
        all_x.append(s[0])                                                      
    else:                                                                       
        all_x.append(s.flatten())                                               
    all_u.append(data['input'].flatten())                                       
                                                                                
def get_refined_coeffs(dt):                                                     
    X_reg = []                                                                  
    V_reg = []                                                                  
    A_reg = []                                                                  
    U_reg = []                                                                  
                                                                                
    for x, u in zip(all_x, all_u):                                              
        # Central differences                                                   
        v = (x[2:] - x[:-2]) / (2 * dt)                                         
        a = (x[2:] - 2*x[1:-1] + x[:-2]) / (dt**2)                              
        X_reg.append(x[1:-1])                                                   
        V_reg.append(v)                                                         
        A_reg.append(a)                                                         
        U_reg.append(u[1:-1])                                                   
                                                                                
    X_reg = np.concatenate(X_reg)                                               
    V_reg = np.concatenate(V_reg)                                               
    A_reg = np.concatenate(A_reg)                                               
    U_reg = np.concatenate(U_reg)                                               
                                                                                
    mask1 = np.abs(X_reg) <= 1.2                                                
    mask2 = np.abs(X_reg) > 1.2                                                 
                                                                                
    def regress(m):                                                             
        if np.sum(m) < 10: return None                                          
        # Features: [v, x, x**3, u, 1]                                          
        Feat = np.column_stack([V_reg[m], X_reg[m], X_reg[m]**3, U_reg[m],      
np.ones(np.sum(m))])                                                            
        c, _, _, _ = np.linalg.lstsq(Feat, A_reg[m], rcond=None)                
        return c                                                                
                                                                                
    return regress(mask1), regress(mask2)                                       
                                                                                
# Try dt values around 0.001                                                    
for dt in [0.001, 1.0/1000.0, 0.00104]:                                         
    c1, c2 = get_refined_coeffs(dt)                                             
    print(f"dt={dt}")                                                           
    print(f"  Mode1: {c1}")                                                     
    print(f"  Mode2: {c2}")                                                     
                                                                                
# If we get very close to integers, we found it.                                
                                                                                
