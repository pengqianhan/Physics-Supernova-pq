import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
import matplotlib.pyplot as plt                                                 
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
state = data['state']                                                           
u = data['u']                                                                   
t = data['t'].flatten()                                                         
                                                                                
dt = t[1] - t[0]                                                                
x = state[0, :]                                                                 
                                                                                
# Calculate derivatives using central differences                               
# x_dot = (x[i+1] - x[i-1]) / (2*dt)                                            
# x_ddot = (x[i+1] - 2*x[i] + x[i-1]) / (dt**2)                                 
x_dot = np.gradient(x, dt)                                                      
x_ddot = np.gradient(x_dot, dt)                                                 
                                                                                
# Prepare features: x1[1] (v), x1[0] (x), x1[0]**3 (x^3), u1 (u)                
# The prompt says x1[2] = f(x1[1], x1[0], x1[0]**3, u1)                         
# Note: x is state[0, :]. state[1, :] might already be velocity. Let's check.   
if state.shape[0] > 1:                                                          
    v_state = state[1, :]                                                       
    print("State has second component, likely velocity.")                       
else:                                                                           
    v_state = x_dot                                                             
                                                                                
# Let's use x_dot and x_ddot for consistency with the prompt's instruction to   
use finite differences                                                          
# Truncate ends if necessary, but gradient handles it.                          
features = np.vstack([x_dot, x, x**3, u.flatten()]).T                           
target = x_ddot                                                                 
                                                                                
# Fit a global model to see if there are modes                                  
reg = LinearRegression().fit(features, target)                                  
score = reg.score(features, target)                                             
residuals = target - reg.predict(features)                                      
                                                                                
print(f"Global R^2 score: {score}")                                             
                                                                                
# Analyze residuals to find shifts                                              
plt.figure(figsize=(10, 5))                                                     
plt.plot(t, residuals)                                                          
plt.title("Residuals of Global Linear Model")                                   
plt.savefig("residuals.png")                                                    
                                                                                
# Check for discontinuities or shifts                                           
# Maybe modes depend on the sign of x or x_dot?                                 
# Let's look at the residual vs state                                           
plt.figure(figsize=(10, 5))                                                     
plt.scatter(x, residuals, alpha=0.5)                                            
plt.xlabel("x")                                                                 
plt.ylabel("Residual")                                                          
plt.savefig("resid_vs_x.png")                                                   
                                                                                
