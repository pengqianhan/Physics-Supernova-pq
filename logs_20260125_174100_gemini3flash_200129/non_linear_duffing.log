dt = 0.001                                                                      
                                                                                
def check_resets(path):                                                         
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    v = np.diff(x) / dt                                                         
    # If there is no reset, v[i] should be close to (x[i+1]-x[i])/dt            
    # A reset in x would show up as a huge spike in v.                          
    # A reset in v would show up as a huge spike in a.                          
    a = np.diff(v) / dt                                                         
    return v, a                                                                 
                                                                                
