    y_w = y[i:i+window_size]                                                    
    c, _, _, _ = np.linalg.lstsq(X_w, y_w, rcond=None)                          
    coeffs_list.append(c)                                                       
    times_list.append(t[i + window_size // 2])                                  
                                                                                
