import matplotlib.pyplot as plt                                                 
                                                                                
def solve():                                                                    
    data = np.load('data_all/non_linear/duffing/sample_0.npz')                  
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    dt = 0.01                                                                   
                                                                                
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
                                                                                
    # Check for resets (jumps in x or v)                                        
    dx = np.diff(x)                                                             
    dv = np.diff(v)                                                             
                                                                                
    # We suspect a hybrid system. Let's look for jumps.                         
    # A jump in v with no jump in x is an impact.                               
    # Let's see if there are any indices with large dv.                         
    threshold_v = np.std(dv) * 10                                               
    jump_indices = np.where(np.abs(dv) > threshold_v)[0]                        
    print(f"Indices with large dv: {jump_indices}")                             
                                                                                
    # Sliding window to find coefficients                                       
    win_size = 200                                                              
    all_c = []                                                                  
    all_idx = []                                                                
    for i in range(0, len(x) - win_size, 50):                                   
        xs, vs, as_, us = x[i:i+win_size], v[i:i+win_size], a[i:i+win_size],    
u[i:i+win_size]                                                                 
        A = np.column_stack([vs, xs, xs**3, us, np.ones_like(xs)])              
        c, _, _, _ = np.linalg.lstsq(A, as_, rcond=None)                        
        all_c.append(c)                                                         
        all_idx.append(i + win_size // 2)                                       
                                                                                
    all_c = np.array(all_c)                                                     
                                                                                
    # Plotting coefficients to see modes                                        
    plt.figure(figsize=(10, 8))                                                 
    labels = ['c1 (v)', 'c2 (x)', 'c3 (x^3)', 'c4 (u)', 'bias']                 
    for i in range(5):                                                          
        plt.subplot(5, 1, i+1)                                                  
        plt.plot(all_idx, all_c[:, i], label=labels[i])                         
        plt.legend()                                                            
    plt.savefig('coeffs_evolution.png')                                         
                                                                                
    # Based on the plot (mental check), find where c change.                    
    # If coefficients are constant, there's only one mode.                      
    # Let's check the variance of coefficients.                                 
    c_std = np.std(all_c, axis=0)                                               
    print(f"Coefficients std: {c_std}")                                         
                                                                                
    # If c_std is low, maybe there's one mode.                                  
    # But if there are jumps in v, it's a hybrid system with resets.            
                                                                                
    # Let's fit Mode 1 (before jump) and Mode 2 (after jump) if a jump exists.  
    if len(jump_indices) > 0:                                                   
        # For simplicity, let's take the first significant jump as a mode       
boundary                                                                        
        split = jump_indices[0]                                                 
        # Actually, in a hybrid automaton, the mode might be the same but a     
reset occurred.                                                                 
        # Or modes might change.                                                
                                                                                
        # Fit Mode 1: 0 to split                                                
        A1 = np.column_stack([v[:split], x[:split], x[:split]**3, u[:split],    
np.ones(split)])                                                                
        c1, _, _, _ = np.linalg.lstsq(A1, a[:split], rcond=None)                
                                                                                
        # Fit Mode 2: split+1 to end                                            
        A2 = np.column_stack([v[split+1:], x[split+1:], x[split+1:]**3,         
u[split+1:], np.ones(len(x)-split-1)])                                          
        c2, _, _, _ = np.linalg.lstsq(A2, a[split+1:], rcond=None)              
                                                                                
        print(f"Mode 1 coeffs: {c1}")                                           
        print(f"Mode 2 coeffs: {c2}")                                           
        print(f"Jump index: {split}, Time: {split*dt}")                         
        print(f"State at jump: x={x[split]}, v_before={v[split]},               
v_after={v[split+1]}")                                                          
    else:                                                                       
        # Fit single mode                                                       
        A = np.column_stack([v, x, x**3, u, np.ones_like(x)])                   
        c, _, _, _ = np.linalg.lstsq(A, a, rcond=None)                          
        print(f"Single mode coeffs: {c}")                                       
                                                                                
solve()                                                                         
                                                                                
