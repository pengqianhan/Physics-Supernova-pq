    start, end = segments[i], segments[i+1]                                     
    if end - start < 5: continue                                                
                                                                                
    x_seg = x1[start:end]                                                       
    u_seg = u1[start:end]                                                       
    v = np.diff(x_seg) / dt                                                     
    a = np.diff(v) / dt                                                         
    x_m = x_seg[1:-1]                                                           
    v_m = v[:-1]                                                                
    u_m = u_seg[1:-1]                                                           
                                                                                
    data_points = np.column_stack([v_m, x_m, x_m**3, u_m, np.ones_like(x_m), a])
    if i in group_A_segs:                                                       
        mode_A_data.append(data_points)                                         
    else:                                                                       
        mode_B_data.append(data_points)                                         
                                                                                
def fit_mode(data_list):                                                        
    all_data = np.vstack(data_list)                                             
    X = all_data[:, :5]                                                         
    y = all_data[:, 5]                                                          
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    return coeffs                                                               
                                                                                
coeffs_A = fit_mode(mode_A_data)                                                
