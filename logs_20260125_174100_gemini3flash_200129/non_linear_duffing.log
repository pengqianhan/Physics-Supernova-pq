import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
x1 = data['state'][0]                                                           
u1 = data['input'][0]                                                           
dt = 0.01                                                                       
                                                                                
# Derivatives                                                                   
v1 = np.gradient(x1, dt)                                                        
a1 = np.gradient(v1, dt)                                                        
                                                                                
# ODE: a1 = c1*v1 + c2*x1 + c3*x1**3 + c4*u1 + bias                             
def fit(s, v, a, u):                                                            
    A = np.column_stack([v, s, s**3, u, np.ones_like(s)])                       
    try:                                                                        
        c, _, _, _ = np.linalg.lstsq(A, a, rcond=None)                          
        return c                                                                
    except:                                                                     
        return np.zeros(5)                                                      
                                                                                
