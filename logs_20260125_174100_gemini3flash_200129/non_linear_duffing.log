        print("Keys in npz:", list(data.keys()))                                
                                                                                
    # Typically x is (N, state_dim), dx is (N, state_dim), u is (N, input_dim)  
    all_x.append(data['X'])                                                     
    all_dx.append(data['dX'])                                                   
    all_u.append(data['U'])                                                     
                                                                                
# Concatenate all data                                                          
X = np.concatenate(all_x, axis=0)                                               
dX = np.concatenate(all_dx, axis=0)                                             
