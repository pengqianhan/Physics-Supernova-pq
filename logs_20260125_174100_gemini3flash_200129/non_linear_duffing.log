import numpy as np                                                              
                                                                                
def final_check():                                                              
    data = np.load('data_all/non_linear/duffing/sample_0.npz')                  
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    dt = 0.1                                                                    
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
                                                                                
    # Check for switches using very small windows                               
    win_size = 50                                                               
    errors = []                                                                 
    for i in range(len(x) - win_size):                                          
        xs, vs, as_, us = x[i:i+win_size], v[i:i+win_size], a[i:i+win_size],    
u[i:i+win_size]                                                                 
        A = np.column_stack([vs, xs, xs**3, us, np.ones_like(xs)])              
        c, _, _, _ = np.linalg.lstsq(A, as_, rcond=None)                        
        err = np.mean((as_ - np.dot(A, c))**2)                                  
        errors.append(err)                                                      
                                                                                
    # Find indices where error is significantly higher than median              
    errors = np.array(errors)                                                   
    median_err = np.median(errors)                                              
    spike_indices = np.where(errors > 100 * median_err)[0]                      
    print(f"Indices of error spikes: {spike_indices}")                          
                                                                                
    # If no spikes, it's a single mode.                                         
    # Let's get the average coefficients across all samples with dt=0.1         
    all_c = []                                                                  
    for i in range(3):                                                          
        d = np.load(f'data_all/non_linear/duffing/sample_{i}.npz')              
        xi = d['state'][0]                                                      
        ui = d['input'][0]                                                      
        vi = np.gradient(xi, dt)                                                
        ai = np.gradient(vi, dt)                                                
        A = np.column_stack([vi, xi, xi**3, ui, np.ones_like(xi)])              
        c, _, _, _ = np.linalg.lstsq(A, ai, rcond=None)                         
        all_c.append(c)                                                         
                                                                                
    avg_c = np.mean(all_c, axis=0)                                              
    print(f"Average coefficients (dt=0.1): {avg_c}")                            
                                                                                
final_check()                                                                   
                                                                                
