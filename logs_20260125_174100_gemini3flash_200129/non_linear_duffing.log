def detect_switches_discrete(x, u):                                             
    n = len(x) - 2                                                              
    x_k2 = x[2:]                                                                
    x_k1 = x[1:-1]                                                              
    x_k0 = x[:-2]                                                               
    u_k = u[:-2]                                                                
    X = np.column_stack([x_k1, x_k0, x_k0**3, u_k, np.ones_like(u_k)])          
                                                                                
    window = 200                                                                
    errors = []                                                                 
    for i in range(n - window):                                                 
        Xw = X[i:i+window]                                                      
        yw = x_k2[i:i+window]                                                   
        coeffs, _, _, _ = np.linalg.lstsq(Xw, yw, rcond=None)                   
        pred = np.dot(Xw, coeffs)                                               
        errors.append(np.mean((yw - pred)**2))                                  
                                                                                
    return errors                                                               
                                                                                
