import numpy as np                                                              
                                                                                
def get_derivatives(x, dt=0.01):                                                
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return v, a                                                                 
                                                                                
def get_features(x, v, u):                                                      
    return np.column_stack([v, x, x**3, u, np.ones_like(x)])                    
                                                                                
dt = 0.01                                                                       
all_features = []                                                               
all_a = []                                                                      
all_modes = []                                                                  
                                                                                
for i in range(len(DATA_FILE_PATHS)):                                           
    data = np.load(DATA_FILE_PATHS[i])                                          
    xi = data['state'][0]                                                       
    ui = data['input'][0]                                                       
    vi, ai = get_derivatives(xi, dt)                                            
    fi = get_features(xi, vi, ui)                                               
                                                                                
    # Use the candidates to label                                               
    c1_ideal = np.array([-0.05, 0.01, -0.015, 0.01, 0.0])                       
    c2_ideal = np.array([-0.02, 0.01, -0.005, 0.01, 0.0])                       
    e1 = np.abs(ai - np.dot(fi, c1_ideal))                                      
    e2 = np.abs(ai - np.dot(fi, c2_ideal))                                      
    mi = np.where(e1 < e2, 1, 2)                                                
                                                                                
    all_features.append(fi)                                                     
    all_a.append(ai)                                                            
    all_modes.append(mi)                                                        
                                                                                
features_concat = np.vstack(all_features)                                       
a_concat = np.concatenate(all_a)                                                
modes_concat = np.concatenate(all_modes)                                        
                                                                                
# Refined fit for each mode                                                     
feat1 = features_concat[modes_concat == 1]                                      
a1 = a_concat[modes_concat == 1]                                                
c1_final, _, _, _ = np.linalg.lstsq(feat1, a1, rcond=None)                      
                                                                                
feat2 = features_concat[modes_concat == 2]                                      
a2 = a_concat[modes_concat == 2]                                                
c2_final, _, _, _ = np.linalg.lstsq(feat2, a2, rcond=None)                      
                                                                                
print("Final Coeffs Mode 1:", c1_final)                                         
print("Final Coeffs Mode 2:", c2_final)                                         
                                                                                
# Re-examine transition conditions                                              
