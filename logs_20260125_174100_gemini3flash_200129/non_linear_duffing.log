import numpy as np                                                              
                                                                                
# List of all available NPZ file paths                                          
data_files = ['data_all/non_linear/duffing/sample_0.npz',                       
              'data_all/non_linear/duffing/sample_1.npz',                       
              'data_all/non_linear/duffing/sample_2.npz']                       
                                                                                
dt = 0.001                                                                      
                                                                                
all_v = []                                                                      
all_x1 = []                                                                     
all_u1 = []                                                                     
all_a = []                                                                      
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    input_data = data['input']                                                  
                                                                                
    # Extract x1 and u1                                                         
    x1 = state[0, :]                                                            
    u1 = input_data[0, :]                                                       
                                                                                
    # Calculate derivatives                                                     
    v = np.gradient(x1, dt)                                                     
    a = np.gradient(v, dt)                                                      
                                                                                
    all_x1.append(x1)                                                           
    all_u1.append(u1)                                                           
    all_v.append(v)                                                             
    all_a.append(a)                                                             
                                                                                
# Concatenate all data                                                          
x1_all = np.concatenate(all_x1)                                                 
u1_all = np.concatenate(all_u1)                                                 
v_all = np.concatenate(all_v)                                                   
a_all = np.concatenate(all_a)                                                   
                                                                                
# Segmentation                                                                  
mask1 = np.abs(x1_all) > 1.0                                                    
mask2 = np.abs(x1_all) <= 1.0                                                   
                                                                                
def solve_system(mask):                                                         
    if np.sum(mask) < 10:                                                       
        return None                                                             
                                                                                
    # Target: x1'' (acceleration)                                               
    Y = a_all[mask]                                                             
                                                                                
    # Design matrix: [v, x1, x1^3, u1, 1]                                       
    X_mat = np.column_stack([                                                   
        v_all[mask],                                                            
        x1_all[mask],                                                           
        x1_all[mask]**3,                                                        
        u1_all[mask],                                                           
        np.ones(np.sum(mask))                                                   
    ])                                                                          
                                                                                
    coeffs, _, _, _ = np.linalg.lstsq(X_mat, Y, rcond=None)                     
    return coeffs                                                               
                                                                                
c_mode1 = solve_system(mask1)                                                   
c_mode2 = solve_system(mask2)                                                   
                                                                                
print("Aggregated Results:")                                                    
print("Mode 1 (abs(x1) > 1.0) coeffs [c1, c2, c3, c4, c5]:", c_mode1)           
print("Mode 2 (abs(x1) <= 1.0) coeffs [c1, c2, c3, c4, c5]:", c_mode2)          
                                                                                
