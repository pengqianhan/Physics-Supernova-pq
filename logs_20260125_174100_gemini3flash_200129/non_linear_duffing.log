import numpy as np                                                              
from scipy.signal import savgol_filter                                          
                                                                                
def get_smooth_derivs(x, dt):                                                   
    x_dot = savgol_filter(x, 11, 3, deriv=1, delta=dt)                          
    x_ddot = savgol_filter(x, 11, 3, deriv=2, delta=dt)                         
    return x_dot, x_ddot                                                        
                                                                                
def get_X(x, x_dot, u):                                                         
    return np.vstack([x_dot, x, x**3, u, np.ones_like(x)]).T                    
                                                                                
def fit_model(X, y):                                                            
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    return coeffs                                                               
                                                                                
# Aggregate data                                                                
all_x1, all_x1_dot, all_x1_ddot, all_u1 = [], [], [], []                        
dt = 0.001                                                                      
                                                                                
for path in ['data_all/non_linear/duffing/sample_0.npz',                        
'data_all/non_linear/duffing/sample_1.npz',                                     
'data_all/non_linear/duffing/sample_2.npz']:                                    
    data = np.load(path)                                                        
    x = data['state'].flatten()                                                 
    u = data['input'].flatten()                                                 
    x_dot, x_ddot = get_smooth_derivs(x, dt)                                    
    all_x1.append(x)                                                            
    all_x1_dot.append(x_dot)                                                    
    all_x1_ddot.append(x_ddot)                                                  
    all_u1.append(u)                                                            
                                                                                
x1 = np.concatenate(all_x1)                                                     
x1_dot = np.concatenate(all_x1_dot)                                             
x1_ddot = np.concatenate(all_x1_ddot)                                           
u1 = np.concatenate(all_u1)                                                     
                                                                                
