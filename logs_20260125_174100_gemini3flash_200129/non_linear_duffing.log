X_inner = get_X(x1[mask_inner], x1_dot[mask_inner], u1[mask_inner])             
y_inner = x1_ddot[mask_inner]                                                   
coeffs_inner = fit_model(X_inner, y_inner)                                      
                                                                                
mask_outer = ~mask_inner                                                        
X_outer = get_X(x1[mask_outer], x1_dot[mask_outer], u1[mask_outer])             
y_outer = x1_ddot[mask_outer]                                                   
coeffs_outer = fit_model(X_outer, y_outer)                                      
                                                                                
print(f"Inner Mode (|x1| <= 1) Coeffs: {coeffs_inner}")                         
print(f"Outer Mode (|x1| > 1) Coeffs: {coeffs_outer}")                          
                                                                                
# Define the model results                                                      
results = {                                                                     
    "Mode 1": {"condition": "|x1| <= 1", "coeffs": coeffs_inner},               
    "Mode 2": {"condition": "|x1| > 1", "coeffs": coeffs_outer}                 
}                                                                               
                                                                                
