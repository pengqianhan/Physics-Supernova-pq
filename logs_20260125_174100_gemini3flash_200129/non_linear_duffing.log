import numpy as np                                                              
                                                                                
def get_derivatives(x, dt=0.01):                                                
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return v, a                                                                 
                                                                                
def get_features(x, v, u):                                                      
    return np.column_stack([v, x, x**3, u, np.ones_like(x)])                    
                                                                                
# Load data                                                                     
data = np.load(DATA_FILE_PATHS[0])                                              
x = data['state'][0]                                                            
u = data['input'][0]                                                            
dt = 0.01                                                                       
v, a = get_derivatives(x, dt)                                                   
features = get_features(x, v, u)                                                
                                                                                
# Fit first half and second half                                                
half = len(x) // 2                                                              
c1, _, _, _ = np.linalg.lstsq(features[:half], a[:half], rcond=None)            
c2, _, _, _ = np.linalg.lstsq(features[half:], a[half:], rcond=None)            
                                                                                
print("Coeffs first half:", c1)                                                 
print("Coeffs second half:", c2)                                                
                                                                                
# If coeffs are significantly different, there's a switch.                      
# Let's find the switch point by scanning a window.                             
window_size = 500                                                               
n = len(x)                                                                      
coeffs_list = []                                                                
for i in range(0, n - window_size, window_size):                                
    c, _, _, _ = np.linalg.lstsq(features[i:i+window_size], a[i:i+window_size], 
rcond=None)                                                                     
    coeffs_list.append(c)                                                       
                                                                                
coeffs_array = np.array(coeffs_list)                                            
print("Variation of coefficients:")                                             
print(coeffs_array)                                                             
                                                                                
import matplotlib.pyplot as plt                                                 
plt.plot(coeffs_array)                                                          
plt.legend(['c1(v)', 'c2(x)', 'c3(x^3)', 'c4(u)', 'bias'])                      
plt.show()                                                                      
                                                                                
