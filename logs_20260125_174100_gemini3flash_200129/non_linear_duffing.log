def fit_range_v_sign(x_min, x_max, x, v, u, a):                                 
    mask_pos = (x >= x_min) & (x < x_max) & (v > 0)                             
    mask_neg = (x >= x_min) & (x < x_max) & (v <= 0)                            
                                                                                
    res = {}                                                                    
    for name, m in [("v > 0", mask_pos), ("v <= 0", mask_neg)]:                 
        if np.sum(m) > 100:                                                     
            xm, vm, um, am = x[m], v[m], u[m], a[m]                             
            X = np.column_stack([vm, xm, xm**3, um, np.ones_like(xm)])          
            c, _, _, _ = np.linalg.lstsq(X, am, rcond=None)                     
            mse = np.mean((am - np.dot(X, c))**2)                               
            res[name] = (c, mse)                                                
        else:                                                                   
            res[name] = None                                                    
    return res                                                                  
                                                                                
