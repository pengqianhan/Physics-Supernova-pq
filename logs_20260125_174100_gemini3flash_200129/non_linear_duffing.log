    # Global fit to find transitions                                            
    coeffs_global, _, _, _ = np.linalg.lstsq(X, a, rcond=None)                  
    pred_a = np.dot(X, coeffs_global)                                           
    error = np.abs(a - pred_a)                                                  
                                                                                
