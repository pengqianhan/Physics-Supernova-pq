import numpy as np                                                              
                                                                                
def fit_in_regions(dt=0.01):                                                    
    data = np.load(DATA_FILE_PATHS[0])                                          
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    x_m, v, acc, u_m = get_derivatives(x, u, dt=dt)                             
                                                                                
    regions = [                                                                 
        (x_m < -1.0),                                                           
        (x_m >= -1.0) & (x_m <= 1.0),                                           
        (x_m > 1.0)                                                             
    ]                                                                           
                                                                                
    names = ["x < -1", "-1 <= x <= 1", "x > 1"]                                 
                                                                                
    for i, mask in enumerate(regions):                                          
        if np.sum(mask) > 10:                                                   
            xm_r = x_m[mask]                                                    
            v_r = v[mask]                                                       
            acc_r = acc[mask]                                                   
            u_r = u_m[mask]                                                     
            X = np.stack([v_r, xm_r, xm_r**3, u_r, np.ones_like(xm_r)], axis=1) 
            c, _, _, _ = np.linalg.lstsq(X, acc_r, rcond=None)                  
            pred = c[0]*v_r + c[1]*xm_r + c[2]*(xm_r**3) + c[3]*u_r + c[4]      
            err = np.mean(np.abs(acc_r - pred))                                 
            print(f"Region {names[i]}, coeffs: {c}, err: {err}")                
                                                                                
