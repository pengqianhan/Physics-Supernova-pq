import numpy as np                                                              
                                                                                
def identify_modes(X, V, A, U):                                                 
    # We suspect 2 modes with hysteresis on |x|                                 
    # Thresholds around 0.8 and 1.2                                             
                                                                                
    # Let's try to label points based on the best fit first                     
    # and then check if the hysteresis logic holds.                             
    # To get clean coefficients, let's use points that are clearly in one mode. 
    # Mode 1: |x| > 1.3                                                         
    # Mode 2: |x| < 0.7                                                         
                                                                                
    mask1 = np.abs(X) > 1.3                                                     
    mask2 = np.abs(X) < 0.7                                                     
                                                                                
    feat = np.stack([V, X, X**3, U, np.ones_like(X)], axis=1)                   
                                                                                
    c1, _, _, _ = np.linalg.lstsq(feat[mask1], A[mask1], rcond=None)            
    c2, _, _, _ = np.linalg.lstsq(feat[mask2], A[mask2], rcond=None)            
                                                                                
    return c1, c2                                                               
                                                                                
