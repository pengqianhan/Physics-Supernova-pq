import numpy as np                                                              
from scipy.signal import find_peaks                                             
                                                                                
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
x1 = data['state'][0, :]                                                        
u1 = data['input'][0, :]                                                        
dt = 0.01                                                                       
                                                                                
def get_residuals(x, u, dt):                                                    
    v = np.diff(x) / dt                                                         
    a = np.diff(v) / dt                                                         
    x_mid = x[1:-1]                                                             
    v_mid = v[:-1]                                                              
    u_mid = u[1:-1]                                                             
    X = np.column_stack([v_mid, x_mid, x_mid**3, u_mid, np.ones_like(x_mid)])   
    y = a                                                                       
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    y_pred = np.dot(X, coeffs)                                                  
    return np.abs(y - y_pred)                                                   
                                                                                
res = get_residuals(x1, u1, dt)                                                 
# Find top 18 peaks                                                             
peaks, props = find_peaks(res, prominence=0, distance=50)                       
top_18_idx = np.argsort(props['prominences'])[-18:]                             
peaks = np.sort(peaks[top_18_idx])                                              
                                                                                
print("Indices of 18 transitions:", peaks)                                      
                                                                                
# Record values at these indices                                                
for p in peaks:                                                                 
    # Adjust index for original array                                           
    idx = p + 1                                                                 
    print(f"Index {idx}: t={idx*dt:.2f}, x1={x1[idx]:.4f}, u1={u1[idx]:.4f}")   
                                                                                
