import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
                                                                                
def get_derivatives(x, dt):                                                     
    dx = np.gradient(x, dt)                                                     
    ddx = np.gradient(dx, dt)                                                   
    return dx, ddx                                                              
                                                                                
all_x1, all_dx, all_ddx, all_u1 = [], [], [], []                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x1 = data['state'][0]                                                       
    u1 = data['input'][0]                                                       
    dx, ddx = get_derivatives(x1, dt)                                           
    all_x1.append(x1)                                                           
    all_dx.append(dx)                                                           
    all_ddx.append(ddx)                                                         
    all_u1.append(u1)                                                           
                                                                                
X1 = np.concatenate(all_x1)                                                     
DX = np.concatenate(all_dx)                                                     
DDX = np.concatenate(all_ddx)                                                   
U1 = np.concatenate(all_u1)                                                     
                                                                                
threshold = 1.1                                                                 
mask1 = np.abs(X1) <= threshold                                                 
mask2 = np.abs(X1) > threshold                                                  
                                                                                
def fit(mask, label):                                                           
    if not np.any(mask): return                                                 
    X = np.column_stack([DX[mask], X1[mask], X1[mask]**3, U1[mask],             
np.ones_like(X1[mask])])                                                        
    c, _, _, _ = np.linalg.lstsq(X, DDX[mask], rcond=None)                      
    err = DDX[mask] - np.dot(X, c)                                              
    print(f"{label} coeffs: {c}")                                               
    print(f"{label} max err: {np.max(np.abs(err))}")                            
    return c                                                                    
                                                                                
print(f"Trying threshold {threshold}")                                          
c1 = fit(mask1, "Mode 1")                                                       
c2 = fit(mask2, "Mode 2")                                                       
                                                                                
