import numpy as np                                                              
                                                                                
def analyze_transitions(path):                                                  
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    xk2 = x[2:]                                                                 
    xk1 = x[1:-1]                                                               
    xk = x[:-2]                                                                 
    uk = u[:-2]                                                                 
                                                                                
    # Use the global model from Sample 0 as reference for Mode 1                
    data0 = np.load(DATA_FILE_PATHS[0])                                         
    x0, u0 = data0['state'][0], data0['input'][0]                               
    A0 = np.column_stack([x0[1:-1], x0[:-2], x0[:-2]**3, u0[:-2],               
np.ones(len(x0)-2)])                                                            
    c1, _, _, _ = np.linalg.lstsq(A0, x0[2:], rcond=None)                       
                                                                                
    # Calculate residuals on the current sample                                 
    A = np.column_stack([xk1, xk, xk**3, uk, np.ones_like(xk)])                 
    errs = np.abs(xk2 - np.dot(A, c1))                                          
                                                                                
    # Identify Mode 2 regions (where residuals are high)                        
    mode2_indices = np.where(errs > 1e-5)[0]                                    
    if len(mode2_indices) > 0:                                                  
        start, end = mode2_indices[0], mode2_indices[-1]                        
        print(f"Sample {path}: Mode 2 from index {start} to {end}")             
        print(f"  x at start: {xk1[start]}, u at start: {uk[start]}")           
        print(f"  x at end: {xk1[end]}, u at end: {uk[end]}")                   
                                                                                
        # Check for resets at start                                             
        # A reset in x would be a jump in x[k]                                  
        # A reset in dx would be a jump in (x[k+1]-x[k])                        
        jump_x = x[start+1] - x[start]                                          
        jump_dx = (x[start+1]-x[start]) - (x[start]-x[start-1])                 
        print(f"  Jump in x: {jump_x}, Jump in dx: {jump_dx}")                  
                                                                                
        # Fit Mode 2                                                            
        A2 = A[start:end]                                                       
        c2, _, _, _ = np.linalg.lstsq(A2, xk2[start:end], rcond=None)           
        return c1, c2, (start, end, xk1[start], uk[start])                      
    return c1, None, None                                                       
                                                                                
c1, c2, trans = analyze_transitions(DATA_FILE_PATHS[1])                         
_, c2_s2, trans_s2 = analyze_transitions(DATA_FILE_PATHS[2])                    
                                                                                
print("\nFinal Coefficients:")                                                  
print("Mode 1:", c1)                                                            
print("Mode 2 (Sample 1):", c2)                                                 
print("Mode 2 (Sample 2):", c2_s2)                                              
                                                                                
