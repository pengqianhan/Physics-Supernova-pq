u_val = data['input'][0, :]                                                     
t = np.linspace(0, 10, len(x_pos))                                              
dt = t[1] - t[0]                                                                
x_vel = np.gradient(x_pos, dt)                                                  
x_acc = np.gradient(x_vel, dt)                                                  
                                                                                
def count_trans(m):                                                             
    return np.sum(np.diff(m.astype(int)) != 0)                                  
                                                                                
# Features: x_vel, x_pos, x_pos**3, u_val, 1                                    
