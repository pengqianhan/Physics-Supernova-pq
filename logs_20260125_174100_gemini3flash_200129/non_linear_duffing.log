import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
def analyze_file(file_path):                                                    
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    dt = 0.01                                                                   
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return x, v, a, u                                                           
                                                                                
x, v, a, u = analyze_file(DATA_FILE_PATHS[0])                                   
                                                                                
# To identify modes, let's look at the residual of a global fit.                
# If there are multiple modes, a single global fit will have high errors in some
regions.                                                                        
# x1[2] = c1 * x1[1] + c2 * x1[0] + c3 * x1[0]**3 + c4 * u1 + bias              
                                                                                
# Construct the feature matrix                                                  
# Column 0: x1[1] (v)                                                           
# Column 1: x1[0] (x)                                                           
# Column 2: x1[0]**3                                                            
# Column 3: u                                                                   
# Column 4: bias (1s)                                                           
features = np.column_stack([v, x, x**3, u, np.ones_like(x)])                    
                                                                                
# Let's try to see if there's a clear change in the "parameters" over time.     
# We can use a sliding window fit or just look at the error of a global fit.    
from sklearn.linear_model import LinearRegression                               
                                                                                
model = LinearRegression()                                                      
model.fit(features, a)                                                          
a_pred = model.predict(features)                                                
error = a - a_pred                                                              
                                                                                
plt.figure(figsize=(10, 5))                                                     
plt.subplot(2, 1, 1)                                                            
plt.plot(error)                                                                 
plt.title("Error of a global linear fit")                                       
plt.subplot(2, 1, 2)                                                            
plt.plot(x)                                                                     
plt.title("Position x")                                                         
plt.show()                                                                      
                                                                                
# Print error statistics to see if they are large                               
print("Mean squared error of global fit:", np.mean(error**2))                   
                                                                                
