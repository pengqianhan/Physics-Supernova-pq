        if td > tu: continue                                                    
        # Apply thresholds to each trajectory separately                        
        df0_modes = assign_modes(dfs[0], tu, td)                                
        df1_modes = assign_modes(dfs[1], tu, td)                                
        df2_modes = assign_modes(dfs[2], tu, td)                                
                                                                                
        dfs[0]['mode'] = df0_modes                                              
        dfs[1]['mode'] = df1_modes                                              
        dfs[2]['mode'] = df2_modes                                              
                                                                                
        combined = pd.concat(dfs)                                               
        m1_data = combined[combined['mode'] == 1]                               
        m2_data = combined[combined['mode'] == 2]                               
                                                                                
        c1 = fit_coeffs(m1_data)                                                
        c2 = fit_coeffs(m2_data)                                                
                                                                                
        if c1 is not None and c2 is not None:                                   
            err1 = get_error(m1_data, c1)                                       
            err2 = get_error(m2_data, c2)                                       
            total_err = (err1 * len(m1_data) + err2 * len(m2_data)) /           
len(combined)                                                                   
            if total_err < best_err:                                            
                best_err = total_err                                            
                best_params = (tu, td)                                          
                best_coeffs = (c1, c2)                                          
                                                                                
print(f"Best Hysteresis Up: {best_params[0]}, Down: {best_params[1]}, Error:    
