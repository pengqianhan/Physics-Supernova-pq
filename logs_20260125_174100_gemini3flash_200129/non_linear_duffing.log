│                 "eq": "x1[2\] = x1[1\] + x1[0\] + u1"                        │
│             }                                                                │
│         ],                                                                   │
│         "edge": []                                                           │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.001,                                                         │
│         "total_time": 10.0,                                                  │
│         "order": 2,                                                          │
│         "need_reset": false,                                                 │
│         "non_linear_items": ""                                               │
│     }                                                                        │
│ }                                                                            │
│ ```                                                                          │
