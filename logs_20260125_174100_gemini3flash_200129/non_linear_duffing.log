    data = np.load(path)                                                        
    all_t.append(data['t'])                                                     
    all_x.append(data['x'])                                                     
    all_u.append(data['u'])                                                     
                                                                                
# Concatenate data for analysis                                                 
t = np.concatenate(all_t)                                                       
x = np.concatenate(all_x)                                                       
u = np.concatenate(all_u)                                                       
                                                                                
# Assuming x[:, 0] is x1, and we need derivatives.                              
# Check if x already contains derivatives or if we need to compute them.        
# x usually has shape (N, dim). Let's check dimensions.                         
