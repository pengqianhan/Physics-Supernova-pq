import numpy as np                                                              
                                                                                
def analyze_sample(filename):                                                   
    data = np.load(filename)                                                    
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    dt = 0.01                                                                   
                                                                                
    v = np.diff(x) / dt                                                         
    a = np.diff(v) / dt                                                         
                                                                                
    x_val = x[:-2]                                                              
    v_val = v[:-1]                                                              
    u_val = u[:-2]                                                              
    a_val = a                                                                   
    x3_val = x_val**3                                                           
    ones = np.ones_like(x_val)                                                  
                                                                                
    X = np.column_stack([v_val, x_val, x3_val, u_val, ones])                    
    coeffs, residuals, rank, s = np.linalg.lstsq(X, a_val, rcond=None)          
                                                                                
    mse = np.mean((a_val - X @ coeffs)**2)                                      
    return coeffs, mse                                                          
                                                                                
for i in range(3):                                                              
    fname = f'data_all/non_linear/duffing/sample_{i}.npz'                       
    c, error = analyze_sample(fname)                                            
    print(f"Sample {i} coefficients: {c}")                                      
    print(f"Sample {i} MSE: {error}")                                           
                                                                                
