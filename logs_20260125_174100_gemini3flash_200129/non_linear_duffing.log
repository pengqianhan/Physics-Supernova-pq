import numpy as np                                                              
                                                                                
def fit_with_dt(path, dt=0.001):                                                
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    x_m, v, acc, u_m = get_derivatives(x, u, dt=dt)                             
                                                                                
    # Let's try to fit 3 modes again with this dt                               
    regions = [                                                                 
        (x_m < -1.0),                                                           
        (x_m >= -1.0) & (x_m <= 1.0),                                           
        (x_m > 1.0)                                                             
    ]                                                                           
    names = ["x < -1", "-1 <= x <= 1", "x > 1"]                                 
    results = {}                                                                
    for i, mask in enumerate(regions):                                          
        if np.sum(mask) > 10:                                                   
            xm_r, v_r, acc_r, u_r = x_m[mask], v[mask], acc[mask], u_m[mask]    
            X = np.stack([v_r, xm_r, xm_r**3, u_r, np.ones_like(xm_r)], axis=1) 
            c, _, _, _ = np.linalg.lstsq(X, acc_r, rcond=None)                  
            results[names[i]] = c                                               
            print(f"Mode {names[i]}: {c}")                                      
    return results                                                              
                                                                                
print("Results for dt=0.001:")                                                  
