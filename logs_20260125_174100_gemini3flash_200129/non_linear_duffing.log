<code>                                                                          
import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
x1 = data['state'][0, :]                                                        
u1 = data['input'][0, :]                                                        
dt = 0.1 # Let's try different dt. If the data has 10001 points and covers a    
typical trajectory, dt might be 0.1 or 0.01.                                    
                                                                                
# Try to estimate dt from u1 if it's cos(omega * t)                             
# But u1 frequency is unknown. Let's stick with dt = 0.1 for now.               
# Wait, if u1 has 4 sign changes in 10000 steps, and it's cos(omega * t),       
# then 2 periods = 10000 steps => 1 period = 5000 steps.                        
# If omega = 1, period = 2*pi approx 6.28. 5000 steps = 6.28 => dt approx       
0.0012.                                                                         
# Let's try dt = 0.1 first. The actual value of dt doesn't change the *location*
of peaks in residuals.                                                          
                                                                                
def get_residuals(x, u, dt):                                                    
    v = np.diff(x) / dt                                                         
    a = np.diff(v) / dt                                                         
    x_mid = x[1:-1]                                                             
    v_mid = v[:-1]                                                              
    u_mid = u[1:-1]                                                             
                                                                                
    # Model: a = c0*v + c1*x + c2*x^3 + c3*u + c4                               
    X = np.column_stack([v_mid, x_mid, x_mid**3, u_mid, np.ones_like(x_mid)])   
    y = a                                                                       
                                                                                
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    y_pred = np.dot(X, coeffs)                                                  
    return np.abs(y - y_pred), coeffs                                           
                                                                                
res, coeffs = get_residuals(x1, u1, 0.1)                                        
                                                                                
plt.figure(figsize=(12, 6))                                                     
plt.plot(res)                                                                   
plt.title("Residuals of 2nd order model")                                       
plt.savefig("residuals_2nd.png")                                                
                                                                                
from scipy.signal import find_peaks                                             
peaks, props = find_peaks(res, prominence=np.percentile(res, 95), distance=100) 
print("Detected peaks:", peaks)                                                 
print("Number of peaks:", len(peaks))                                           
                                                                                
