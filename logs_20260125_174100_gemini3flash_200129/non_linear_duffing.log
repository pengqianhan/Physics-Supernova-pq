indices = []                                                                    
errors_list = []                                                                
                                                                                
for i in range(0, n_points - window_size, step):                                
    idx = slice(i, i + window_size)                                             
    # Define features                                                           
    X = np.stack([x1_1[idx], x1_0[idx], x1_0[idx]**3, u1[idx],                  
np.ones(window_size)], axis=1)                                                  
    y = x1_2[idx]                                                               
                                                                                
    # Solve linear system                                                       
    sol, resid, rank, s = np.linalg.lstsq(X, y, rcond=None)                     
    coeffs_list.append(sol)                                                     
                                                                                
    # Compute local error                                                       
    pred = X @ sol                                                              
    mse = np.mean((y - pred)**2)                                                
    errors_list.append(mse)                                                     
    indices.append(i + window_size // 2)                                        
                                                                                
coeffs_arr = np.array(coeffs_list)                                              
                                                                                
# 3. Identify Change Points                                                     
# Analyze coefficient shifts by calculating distances between adjacent window   
solutions                                                                       
coeff_diffs = np.linalg.norm(np.diff(coeffs_arr, axis=0), axis=1)               
# Threshold for significant change                                              
threshold = np.mean(coeff_diffs) + 2 * np.std(coeff_diffs)                      
change_indices = np.where(coeff_diffs > threshold)[0]                           
                                                                                
cp_points = []                                                                  
for idx in change_indices:                                                      
    # Use the index in the original time series                                 
    actual_idx = indices[idx]                                                   
    cp_points.append({                                                          
        "index": actual_idx,                                                    
        "x1": x1_0[actual_idx],                                                 
        "x1_dot": x1_1[actual_idx]                                              
    })                                                                          
                                                                                
# 4. Cluster segments into modes (Manual K-means approach)                      
def simple_kmeans(data, k=2, max_iters=20):                                     
    # Initialize centroids randomly from the data                               
    centroids = data[np.random.choice(data.shape[0], k, replace=False)]         
    for _ in range(max_iters):                                                  
        # Assign clusters                                                       
        dists = np.linalg.norm(data[:, np.newaxis] - centroids, axis=2)         
        labels = np.argmin(dists, axis=1)                                       
        # Update centroids                                                      
        new_centroids = np.array([data[labels == i].mean(axis=0) if             
np.any(labels == i) else centroids[i] for i in range(k)])                       
        if np.allclose(centroids, new_centroids):                               
            break                                                               
        centroids = new_centroids                                               
    return centroids, labels                                                    
                                                                                
