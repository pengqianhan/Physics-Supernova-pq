import numpy as np                                                              
                                                                                
def fit_four_modes(dt=0.001):                                                   
    modes = [                                                                   
        ("x < -1", lambda x: x < -1.0),                                         
        ("-1 <= x < 0", lambda x: (x >= -1.0) & (x < 0.0)),                     
        ("0 <= x <= 1", lambda x: (x >= 0.0) & (x <= 1.0)),                     
        ("x > 1", lambda x: x > 1.0)                                            
    ]                                                                           
    results = {}                                                                
    for name, condition in modes:                                               
        X_all = []                                                              
        acc_all = []                                                            
        for path in DATA_FILE_PATHS:                                            
            data = np.load(path)                                                
            x = data['state'][0]                                                
            u = data['input'][0]                                                
            x_m, v, acc, u_m = get_derivatives(x, u, dt=dt)                     
            mask = condition(x_m)                                               
            if np.sum(mask) > 50:                                               
                X = np.stack([v[mask], x_m[mask], x_m[mask]**3, u_m[mask],      
np.ones(np.sum(mask))], axis=1)                                                 
                X_all.append(X)                                                 
                acc_all.append(acc[mask])                                       
                                                                                
        if X_all:                                                               
            X_all = np.concatenate(X_all)                                       
            acc_all = np.concatenate(acc_all)                                   
            c, _, _, _ = np.linalg.lstsq(X_all, acc_all, rcond=None)            
            results[name] = c                                                   
            print(f"Mode {name}: {c}")                                          
    return results                                                              
                                                                                
fit_four_modes()                                                                
                                                                                
