        # Print indices where error is large                                    
        switch_indices = np.where(errors > 1e-3)[0]                             
        print(f"Switching indices count: {len(switch_indices)}")                
    else:                                                                       
        print(f"File {i} seems to have consistent dynamics.")                   
                                                                                
                                                                                
