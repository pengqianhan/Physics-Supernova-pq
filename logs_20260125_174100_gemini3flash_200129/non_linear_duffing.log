    print("Values at transitions:")                                             
    for i in transitions:                                                       
        print(f"t={t[i]:.3f}: x1={x1_0[i]:.4f}, v={x1_1[i]:.4f}, u={u1[i]:.4f}, 
labels={labels[i]}->{labels[i+1]}")                                             
                                                                                
    # Reset analysis                                                            
    print("Resets check:")                                                      
    for i in transitions:                                                       
        jump_x = x1_0[i+1] - x1_0[i]                                            
        jump_v = x1_1[i+1] - x1_1[i]                                            
        print(f"t={t[i]:.3f}: jump_x={jump_x:.6f}, jump_v={jump_v:.6f}")        
                                                                                
