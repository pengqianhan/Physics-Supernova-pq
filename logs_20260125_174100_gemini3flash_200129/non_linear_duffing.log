def get_smooth_derivs(x, dt):                                                   
    # Apply a Savitzky-Golay filter to smooth and differentiate                 
    # window_length must be odd.                                                
    x_smooth = savgol_filter(x, 11, 3)                                          
    x_dot = savgol_filter(x, 11, 3, deriv=1, delta=dt)                          
    x_ddot = savgol_filter(x, 11, 3, deriv=2, delta=dt)                         
    return x_smooth, x_dot, x_ddot                                              
                                                                                
