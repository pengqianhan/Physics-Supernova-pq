from scipy.signal import find_peaks                                             
                                                                                
def load_and_preprocess(file_path, dt=0.1):                                     
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    v = np.gradient(x, dt)                                                      
