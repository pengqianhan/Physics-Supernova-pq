  import numpy as np                                                            
  import pandas as pd                                                           
                                                                                
  def process_file(path, dt=0.1):                                               
      data = np.load(path)                                                      
      x1 = data['state'][0]                                                     
      u1 = data['input'][0]                                                     
      x1_dot = np.gradient(x1, dt)                                              
      x1_ddot = np.gradient(x1_dot, dt)                                         
      return pd.DataFrame({'x1': x1, 'x1_dot': x1_dot, 'x1_ddot': x1_ddot,      
  'u1': u1, 'abs_x1': np.abs(x1)})                                              
                                                                                
  dt = 0.1                                                                      
  df0 = process_file('data_all/non_linear/duffing/sample_0.npz', dt)            
  df1 = process_file('data_all/non_linear/duffing/sample_1.npz', dt)            
  df2 = process_file('data_all/non_linear/duffing/sample_2.npz', dt)            
                                                                                
  def get_coeffs(df):                                                           
      Y = df['x1_ddot'].values                                                  
      X = np.column_stack([df['x1_dot'], df['x1'], df['x1']**3, df['u1'],       
  np.ones(len(df))])                                                            
      c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                            
      return c                                                                  
                                                                                
  # Mode 1 from Sample 0 (it never exceeds 4.0)                                 
  c1 = get_coeffs(df0)                                                          
                                                                                
  # Check residuals on Sample 1                                                 
  X1_mat = np.column_stack([df1['x1_dot'], df1['x1'], df1['x1']**3, df1['u1'],  
  np.ones(len(df1))])                                                           
  df1['resid_m1'] = np.abs(df1['x1_ddot'] - np.dot(X1_mat, c1))                 
                                                                                
  # Identify Mode 2: where resid_m1 is high (e.g., > 0.01)                      
  mode2_segment = df1[df1['resid_m1'] > 0.05]                                   
  if len(mode2_segment) > 0:                                                    
      c2 = get_coeffs(mode2_segment)                                            
                                                                                
      # Re-calculate residuals for both                                         
      X1_mat = np.column_stack([df1['x1_dot'], df1['x1'], df1['x1']**3,         
  df1['u1'], np.ones(len(df1))])                                                
      res1 = np.abs(df1['x1_ddot'] - np.dot(X1_mat, c1))                        
      res2 = np.abs(df1['x1_ddot'] - np.dot(X1_mat, c2))                        
                                                                                
      # Determine mode based on lower residual                                  
      df1['best_mode'] = np.where(res1 < res2, 1, 2)                            
                                                                                
      # Find thresholds                                                         
      # Mode 1 to 2 happens when abs_x1 is increasing and crosses tu            
      # Mode 2 to 1 happens when abs_x1 is decreasing and crosses td            
                                                                                
      transitions = df1['best_mode'].diff().fillna(0)                           
      up_idx = df1.index[transitions == 1].tolist()                             
      down_idx = df1.index[transitions == -1].tolist()                          
                                                                                
      tu = df1.loc[up_idx, 'abs_x1'].mean() if up_idx else None                 
      td = df1.loc[down_idx, 'abs_x1'].mean() if down_idx else None             
                                                                                
      print(f"Mode 1 Coeffs: {c1}")                                             
      print(f"Mode 2 Coeffs: {c2}")                                             
      print(f"Approx Thresholds: Up={tu}, Down={td}")                           
  else:                                                                         
      print("Could not identify Mode 2 segment.")                               
