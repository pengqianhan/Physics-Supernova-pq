mode0_mask = modes == 0                                                         
mode1_mask = modes == 1                                                         
                                                                                
reg0 = LinearRegression().fit(features[mode0_mask], x1_ddot[mode0_mask])        
reg1 = LinearRegression().fit(features[mode1_mask], x1_ddot[mode1_mask])        
                                                                                
print("Mode 0 Coefficients:", reg0.coef_, reg0.intercept_)                      
