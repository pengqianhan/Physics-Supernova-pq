import numpy as np                                                              
from scipy.cluster.vq import kmeans2                                            
                                                                                
def solve():                                                                    
    data = np.load('data_all/non_linear/duffing/sample_0.npz')                  
    state = data['state']                                                       
    u = data['input']                                                           
                                                                                
    # State extraction                                                          
    if state.ndim == 2:                                                         
        x1_0 = state[:, 0]                                                      
        if state.shape[1] > 1:                                                  
            x1_1_data = state[:, 1]                                             
        else:                                                                   
            x1_1_data = None                                                    
    else:                                                                       
        x1_0 = state.flatten()                                                  
        x1_1_data = None                                                        
                                                                                
    N = len(x1_0)                                                               
    dt = 10.0 / (N - 1)                                                         
    t = np.linspace(0, 10, N)                                                   
                                                                                
    # Derivatives                                                               
    x1_1 = np.gradient(x1_0, dt)                                                
    x1_2 = np.gradient(x1_1, dt)                                                
    u1 = u.flatten()                                                            
                                                                                
    # Clustering                                                                
    # The switching might be in the coefficients of the ODE.                    
    # Often, clustering on (x1_0, x1_1, x1_2, u1) works.                        
    feats = np.column_stack([x1_0, x1_1, x1_2, u1])                             
    feats_norm = (feats - feats.mean(0)) / (feats.std(0) + 1e-8)                
                                                                                
