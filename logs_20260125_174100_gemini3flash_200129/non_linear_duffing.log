import numpy as np                                                              
                                                                                
def find_error_spikes(sample_idx):                                              
    data = np.load(f'data_all/non_linear/duffing/sample_{sample_idx}.npz')      
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    # Use a fixed model (Mode 1) from the first few points                      
    # Y = x[i+2] - 2*x[i+1] + x[i]                                              
    Y = x[2:] - 2*x[1:-1] + x[:-2]                                              
    dx = x[1:-1] - x[:-2]                                                       
    x_val = x[:-2]                                                              
    x3_val = x[:-2]**3                                                          
    u_val = u[:-2]                                                              
    ones = np.ones_like(x_val)                                                  
    features = np.column_stack([dx, x_val, x3_val, u_val, ones])                
                                                                                
    # Fit on the first 100 points                                               
    c1, _, _, _ = np.linalg.lstsq(features[:100], Y[:100], rcond=None)          
                                                                                
    # Compute error                                                             
    pred = features @ c1                                                        
    error = np.abs(Y - pred)                                                    
                                                                                
    return error, x, dx, u                                                      
                                                                                
