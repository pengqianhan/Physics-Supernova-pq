import numpy as np                                                              
                                                                                
def fit_with_threshold(threshold):                                              
    all_Y_1, all_feat_1 = [], []                                                
    all_Y_2, all_feat_2 = [], []                                                
                                                                                
    for i in range(3):                                                          
        data = np.load(f'data_all/non_linear/duffing/sample_{i}.npz')           
        x = data['state'][0]                                                    
        u = data['input'][0]                                                    
        Y = x[2:] - 2*x[1:-1] + x[:-2]                                          
        dx = x[1:-1] - x[:-2]                                                   
        x_val = x[:-2]                                                          
        x3_val = x[:-2]**3                                                      
        u_val = u[:-2]                                                          
        features = np.column_stack([dx, x_val, x3_val, u_val,                   
np.ones_like(x_val)])                                                           
                                                                                
        # Condition: abs(x) > threshold                                         
        mask1 = np.abs(x_val) > threshold                                       
        mask2 = np.abs(x_val) <= threshold                                      
                                                                                
        all_Y_1.append(Y[mask1])                                                
        all_feat_1.append(features[mask1])                                      
        all_Y_2.append(Y[mask2])                                                
        all_feat_2.append(features[mask2])                                      
                                                                                
    Y1 = np.concatenate(all_Y_1)                                                
    F1 = np.concatenate(all_feat_1)                                             
    Y2 = np.concatenate(all_Y_2)                                                
    F2 = np.concatenate(all_feat_2)                                             
                                                                                
    c1, res1, _, _ = np.linalg.lstsq(F1, Y1, rcond=None)                        
    c2, res2, _, _ = np.linalg.lstsq(F2, Y2, rcond=None)                        
                                                                                
    return c1, np.mean(res1), c2, np.mean(res2)                                 
                                                                                
for t in [0.5, 0.8, 1.0, 1.2, 1.5, 2.0]:                                        
    c1, e1, c2, e2 = fit_with_threshold(t)                                      
    print(f"Threshold {t}: Error1={e1:.2e}, Error2={e2:.2e}")                   
                                                                                
