  th4*u[i] + th5                                                                
      Y = x[2:] - 2*x[1:-1] + x[:-2]                                            
      dx = x[1:-1] - x[:-2]                                                     
      x_val = x[:-2]                                                            
      x3_val = x[:-2]**3                                                        
      u_val = u[:-2]                                                            
      ones = np.ones_like(x_val)                                                
                                                                                
      features = np.column_stack([dx, x_val, x3_val, u_val, ones])              
                                                                                
