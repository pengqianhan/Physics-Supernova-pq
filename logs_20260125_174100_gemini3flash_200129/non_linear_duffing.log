    if abs(x_vals[0]) > T:                                                      
        modes[0] = 1 # Large                                                    
    else:                                                                       
        modes[0] = 2 # Small                                                    
                                                                                
    transitions = 0                                                             
    for i in range(1, len(x_vals)):                                             
        current_x = abs(x_vals[i])                                              
        prev_mode = modes[i-1]                                                  
        if prev_mode == 1: # Large                                              
            if current_x < T - H:                                               
                modes[i] = 2                                                    
                transitions += 1                                                
            else:                                                               
                modes[i] = 1                                                    
        else: # Small                                                           
            if current_x > T + H:                                               
                modes[i] = 1                                                    
                transitions += 1                                                
            else:                                                               
                modes[i] = 2                                                    
    return transitions, modes                                                   
                                                                                
# Search for T around 1.0 and H to get 18 transitions                           
best_T, best_H = 1.0, 0.0                                                       
found = False                                                                   
for t_val in np.linspace(0.8, 1.2, 41):                                         
    for h_val in np.linspace(0.0, 0.1, 21):                                     
        count, _ = count_transitions(x_reg, t_val, h_val)                       
        if count == 18:                                                         
            best_T, best_H = t_val, h_val                                       
            found = True                                                        
            break                                                               
    if found: break                                                             
                                                                                
print(f"Optimal T: {best_T}, H: {best_H}")                                      
                                                                                
# Get modes for the optimal T, H                                                
_, modes = count_transitions(x_reg, best_T, best_H)                             
                                                                                
# Prepare features for regression                                               
# target = a_reg                                                                
# features = [v_reg, x_reg, x_reg^3, u_reg, 1]                                  
def fit_mode(idx_list):                                                         
    if len(idx_list) == 0: return None                                          
    X = np.column_stack([v_reg[idx_list], x_reg[idx_list], x_reg[idx_list]**3,  
u_reg[idx_list]])                                                               
    y = a_reg[idx_list]                                                         
    model = LinearRegression().fit(X, y)                                        
    return np.append(model.coef_, model.intercept_)                             
                                                                                
coefs_m1 = fit_mode(np.where(modes == 1)[0])                                    
coefs_m2 = fit_mode(np.where(modes == 2)[0])                                    
                                                                                
print("Mode 1 Coefs:", coefs_m1)                                                
print("Mode 2 Coefs:", coefs_m2)                                                
                                                                                
final_answer({                                                                  
