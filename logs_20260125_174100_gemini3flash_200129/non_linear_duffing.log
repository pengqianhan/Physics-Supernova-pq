import numpy as np                                                              
import pandas as pd                                                             
from scipy.linalg import lstsq                                                  
                                                                                
def process_file(file_path):                                                    
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    dt = 0.001                                                                  
                                                                                
    # Calculate derivatives using central differences for internal points       
    # x1[1] = dx/dt                                                             
    # x1[2] = d2x/dt2                                                           
    x_dot = (x[2:] - x[:-2]) / (2 * dt)                                         
    x_ddot = (x[2:] - 2 * x[1:-1] + x[:-2]) / (dt**2)                           
                                                                                
    # Align x, u with the derivatives (which are at indices 1 to N-2)           
    x_aligned = x[1:-1]                                                         
    u_aligned = u[1:-1]                                                         
                                                                                
    return x_aligned, x_dot, x_ddot, u_aligned                                  
                                                                                
# Load and combine all samples                                                  
