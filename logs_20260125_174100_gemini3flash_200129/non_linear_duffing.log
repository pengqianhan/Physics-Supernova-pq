# Fit global model                                                              
coeffs_global, _, _, _ = np.linalg.lstsq(X, a, rcond=None)                      
pred_a_global = np.dot(X, coeffs_global)                                        
error = np.abs(a - pred_a_global)                                               
                                                                                
