import numpy as np                                                              
                                                                                
def analyze_sample(sample_idx):                                                 
    data = np.load(f'data_all/non_linear/duffing/sample_{sample_idx}.npz')      
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    n = len(x)                                                                  
                                                                                
    # Prepare features for regression                                           
    # x[i+2] - 2x[i+1] + x[i] = th1*(x[i+1]-x[i]) + th2*x[i] + th3*x[i]**3 +    
th4*u[i] + th5                                                                  
    Y = x[2:] - 2*x[1:-1] + x[:-2]                                              
    dx = x[1:-1] - x[:-2]                                                       
    x_val = x[:-2]                                                              
    x3_val = x[:-2]**3                                                          
    u_val = u[:-2]                                                              
    ones = np.ones_like(x_val)                                                  
                                                                                
    features = np.column_stack([dx, x_val, x3_val, u_val, ones])                
                                                                                
    # Sliding window to find change points                                      
    window_size = 100                                                           
    coefs = []                                                                  
    for i in range(0, len(Y) - window_size, 50):                                
        feat_win = features[i:i+window_size]                                    
        Y_win = Y[i:i+window_size]                                              
        # Solve least squares                                                   
        try:                                                                    
            c, _, _, _ = np.linalg.lstsq(feat_win, Y_win, rcond=None)           
            coefs.append((i, c))                                                
