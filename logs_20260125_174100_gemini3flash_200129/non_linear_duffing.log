import numpy as np                                                              
import pandas as pd                                                             
from scipy.signal import savgol_filter                                          
                                                                                
# Load the first data file                                                      
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
t = data['t']                                                                   
x = data['x']  # Assuming x has shape (N, 1) or (N,)                            
u = data['u']  # Assuming u has shape (N, 1) or (N,)                            
dt = 0.001                                                                      
                                                                                
x1 = x[:, 0]                                                                    
u1 = u[:, 0]                                                                    
                                                                                
# Calculate derivatives                                                         
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Look for transitions. A Hybrid Automaton might change behavior based on x1 or 
x1_dot.                                                                         
# Let's try to fit a model and see the error.                                   
# Equation: x1_ddot = c1*x1_dot + c2*x1 + c3*x1**3 + c4*u1 + bias               
                                                                                
def get_features(x_val, x_dot_val, u_val):                                      
    return np.vstack([x_dot_val, x_val, x_val**3, u_val, np.ones_like(x_val)]).T
                                                                                
features = get_features(x1, x1_dot, u1)                                         
                                                                                
# Try global regression first to see if there are multiple modes                
from sklearn.linear_model import LinearRegression                               
model = LinearRegression()                                                      
model.fit(features, x1_ddot)                                                    
preds = model.predict(features)                                                 
errors = np.abs(x1_ddot - preds)                                                
                                                                                
print(f"Global mean error: {np.mean(errors)}")                                  
                                                                                
# Check for modes by looking at the error distribution or x values              
# A common hybrid system is a piece-wise linear or non-linear one.              
# Let's check if the error is high in certain regions.                          
import matplotlib.pyplot as plt                                                 
# We'll use a threshold to see if there's a clear split                         
# Or check if x1 has a specific range.                                          
mask = x1 > 0                                                                   
features_pos = features[mask]                                                   
target_pos = x1_ddot[mask]                                                      
features_neg = features[~mask]                                                  
target_neg = x1_ddot[~mask]                                                     
                                                                                
model_pos = LinearRegression().fit(features_pos, target_pos)                    
model_neg = LinearRegression().fit(features_neg, target_neg)                    
                                                                                
print(f"Pos mode coeffs: {model_pos.coef_}, intercept: {model_pos.intercept_}") 
print(f"Neg mode coeffs: {model_neg.coef_}, intercept: {model_neg.intercept_}") 
print(f"Pos error: {np.mean(np.abs(target_pos -                                 
model_pos.predict(features_pos)))}")                                            
print(f"Neg error: {np.mean(np.abs(target_neg -                                 
model_neg.predict(features_neg)))}")                                            
                                                                                
