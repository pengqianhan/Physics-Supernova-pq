from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data                                                                 
data0 = np.load('data_all/non_linear/duffing/sample_0.npz')                     
t = data0['t']                                                                  
x = data0['x'] # Shape (N, 2)?                                                  
u = data0['u'] # Shape (N, 1)?                                                  
                                                                                
print(f"Shapes: t {t.shape}, x {x.shape}, u {u.shape}")                         
                                                                                
# Based on task description:                                                    
# x1 is x[:, 0], x1_dot is x[:, 1], x1_ddot is calculated.                      
# Or maybe x[0] is position, x[1] is velocity.                                  
# Let's check.                                                                  
dt = t[1] - t[0]                                                                
x_pos = x[:, 0]                                                                 
x_vel = x[:, 1]                                                                 
# Numerical derivative of velocity to get acceleration                          
x_accel = np.gradient(x_vel, dt)                                                
                                                                                
# We are looking for x_accel = c1*x_vel + c2*x_pos + c3*x_pos**3 + c4*u + c5    
# Identify modes using a sliding window or residuals of a global fit.           
# Since we expect 2 modes and 18 transitions, we can try to cluster the data    
points                                                                          
# or look for jumps in the error of a single model fit.                         
                                                                                
features = np.column_stack([x_vel, x_pos, x_pos**3, u.flatten()])               
reg = LinearRegression().fit(features, x_accel)                                 
residuals = np.abs(x_accel - reg.predict(features))                             
                                                                                
# Identify modes based on the residual pattern or by clustering the local       
relation                                                                        
# Given the "2 modes" hint, let's use a simple heuristic or K-Means on local    
coefficients if needed.                                                         
# But usually, hybrid systems like this have a sign-based switch.               
# Let's look at the sign of x_pos or x_vel.                                     
                                                                                
# Let's try to fit two models based on a suspected guard.                       
# Common guards are sign of position or velocity.                               
mask = x_pos > 0                                                                
# Mode 1                                                                        
reg1 = LinearRegression().fit(features[mask], x_accel[mask])                    
# Mode 2                                                                        
reg2 = LinearRegression().fit(features[~mask], x_accel[~mask])                  
                                                                                
print(f"Mode 1 coeffs: {reg1.coef_}, intercept: {reg1.intercept_}")             
print(f"Mode 2 coeffs: {reg2.coef_}, intercept: {reg2.intercept_}")             
print(f"Score 1: {reg1.score(features[mask], x_accel[mask])}")                  
print(f"Score 2: {reg2.score(features[~mask], x_accel[~mask])}")                
                                                                                
