import numpy as np                                                              
                                                                                
def get_derivatives(x, dt=0.01):                                                
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return v, a                                                                 
                                                                                
def get_features(x, v, u):                                                      
    return np.column_stack([v, x, x**3, u, np.ones_like(x)])                    
                                                                                
# Load data                                                                     
data = np.load(DATA_FILE_PATHS[0])                                              
x = data['state'][0]                                                            
u = data['input'][0]                                                            
dt = 0.01                                                                       
v, a = get_derivatives(x, dt)                                                   
features = get_features(x, v, u)                                                
                                                                                
# Let's try to fit the first 1000 points and see where the error jumps          
n_total = len(x)                                                                
n_start = 1000                                                                  
feat_start = features[:n_start]                                                 
a_start = a[:n_start]                                                           
                                                                                
coeffs_start, _, _, _ = np.linalg.lstsq(feat_start, a_start, rcond=None)        
a_pred_all = np.dot(features, coeffs_start)                                     
error_all = a - a_pred_all                                                      
                                                                                
# Print error at different segments                                             
print("MSE first 1000:", np.mean(error_all[:1000]**2))                          
print("MSE last 1000:", np.mean(error_all[-1000:]**2))                          
                                                                                
# Find the switching point by finding where the error exceeds a threshold       
# Use a smoothed error to avoid noise                                           
smooth_error = np.convolve(np.abs(error_all), np.ones(100)/100, mode='same')    
threshold = 1.0 # arbitrary, let's see the plot/values                          
                                                                                
switching_indices = np.where(smooth_error > threshold)[0]                       
if len(switching_indices) > 0:                                                  
    switch_idx = switching_indices[0]                                           
    print(f"Switch detected around index: {switch_idx}")                        
else:                                                                           
    print("No switch detected with current threshold.")                         
                                                                                
# Let's inspect the error to find the exact switch point                        
