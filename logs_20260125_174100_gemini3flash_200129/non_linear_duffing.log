import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
                                                                                
def get_derivatives(x, dt):                                                     
    dx = np.gradient(x, dt)                                                     
    ddx = np.gradient(dx, dt)                                                   
    return dx, ddx                                                              
                                                                                
def fit_clean(X1, DX, DDX, U1, mask):                                           
    # Filter points near transitions to avoid gradient artifacts                
    # Shift mask to find points where mask is true for i-1, i, i+1              
    stable_mask = mask & np.roll(mask, 1) & np.roll(mask, -1)                   
    stable_mask[0] = stable_mask[-1] = False                                    
                                                                                
    X = np.column_stack([DX[stable_mask], X1[stable_mask], X1[stable_mask]**3,  
U1[stable_mask], np.ones_like(X1[stable_mask])])                                
    c, _, _, _ = np.linalg.lstsq(X, DDX[stable_mask], rcond=None)               
    return c                                                                    
                                                                                
all_x1, all_dx, all_ddx, all_u1 = [], [], [], []                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x1 = data['state'][0]                                                       
    u1 = data['input'][0]                                                       
    dx, ddx = get_derivatives(x1, dt)                                           
    all_x1.append(x1)                                                           
    all_dx.append(dx)                                                           
    all_ddx.append(ddx)                                                         
    all_u1.append(u1)                                                           
                                                                                
X1 = np.concatenate(all_x1)                                                     
DX = np.concatenate(all_dx)                                                     
DDX = np.concatenate(all_ddx)                                                   
U1 = np.concatenate(all_u1)                                                     
                                                                                
c1 = fit_clean(X1, DX, DDX, U1, np.abs(X1) <= 1.2)                              
c2 = fit_clean(X1, DX, DDX, U1, np.abs(X1) > 1.2)                               
                                                                                
print("Final Mode 1 Coeffs (a, b, c, d, e):", c1)                               
print("Final Mode 2 Coeffs (a, b, c, d, e):", c2)                               
                                                                                
