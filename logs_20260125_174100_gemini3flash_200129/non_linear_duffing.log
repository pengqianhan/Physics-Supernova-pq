import numpy as np                                                              
                                                                                
def try_dt(dt):                                                                 
    data = np.load(DATA_FILE_PATHS[0])                                          
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    x_m, v, acc, u_m = get_derivatives(x, u, dt=dt)                             
                                                                                
    # Try fitting on the whole trajectory                                       
    X = np.stack([v, x_m, x_m**3, u_m, np.ones_like(x_m)], axis=1)              
    c, resid, _, _ = np.linalg.lstsq(X, acc, rcond=None)                        
    return c, np.sqrt(np.mean((acc - (X @ c))**2)) # Oops, no @                 
                                                                                
def try_dt_fixed(dt):                                                           
    data = np.load(DATA_FILE_PATHS[0])                                          
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    x_m, v, acc, u_m = get_derivatives(x, u, dt=dt)                             
                                                                                
    X = np.stack([v, x_m, x_m**3, u_m, np.ones_like(x_m)], axis=1)              
    c, _, _, _ = np.linalg.lstsq(X, acc, rcond=None)                            
    pred = c[0]*v + c[1]*x_m + c[2]*(x_m**3) + c[3]*u_m + c[4]                  
    err = np.mean(np.abs(acc - pred))                                           
    return c, err                                                               
                                                                                
for dt in [0.01, 0.02, 0.05, 0.1]:                                              
    c, err = try_dt_fixed(dt)                                                   
