for path in data_paths:                                                         
    data = np.load(path)                                                        
    data_all.append({'x': data['x'], 'u': data['u']})                           
                                                                                
def evaluate_thresholds(t12, t21):                                              
    m1_X, m1_Y = [], []                                                         
    m2_X, m2_Y = [], []                                                         
                                                                                
    for sample in data_all:                                                     
        x = sample['x']                                                         
        u = sample['u']                                                         
                                                                                
        # Determine initial mode                                                
        # Mode 1: |x1| > threshold, Mode 2: |x1| < threshold                    
        # Using the average of thresholds as a starting boundary                
        current_mode = 1 if abs(x[0, 0]) > (t12 + t21) / 2 else 2               
                                                                                
        for k in range(len(x) - 2):                                             
            # The mode for the transition from k+1 to k+2 is determined by the  
state at k+1                                                                    
            x_next = x[k+1, 0]                                                  
                                                                                
            # Hybrid transition logic                                           
            if current_mode == 1:                                               
                if abs(x_next) < t12:                                           
                    current_mode = 2                                            
            else:                                                               
                if abs(x_next) > t21:                                           
                    current_mode = 1                                            
                                                                                
            # Model features: x1[k+1], x1[k], x1[k]^3, u[k], 1                  
            features = [x[k+1, 0], x[k, 0], x[k, 0]**3, u[k, 0], 1.0]           
            target = x[k+2, 0]                                                  
                                                                                
            if current_mode == 1:                                               
                m1_X.append(features)                                           
                m1_Y.append(target)                                             
            else:                                                               
                m2_X.append(features)                                           
                m2_Y.append(target)                                             
                                                                                
    def fit(X_list, Y_list):                                                    
        if not X_list:                                                          
            return None, 0, 0                                                   
        X = np.array(X_list)                                                    
        Y = np.array(Y_list)                                                    
        beta, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)            
        # Calculate sum of squared errors                                       
        sse = np.sum((Y - X @ beta)**2)                                         
        return beta, sse, len(Y)                                                
                                                                                
    params1, sse1, n1 = fit(m1_X, m1_Y)                                         
    params2, sse2, n2 = fit(m2_X, m2_Y)                                         
                                                                                
    total_mse = (sse1 + sse2) / (n1 + n2)                                       
    return total_mse, params1, params2, n1, n2                                  
                                                                                
