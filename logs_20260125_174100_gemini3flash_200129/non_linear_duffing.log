def get_error(mask, X, y):                                                      
    if np.sum(mask) < 10 or np.sum(~mask) < 10:                                 
        return np.inf                                                           
                                                                                
    # Mode 1                                                                    
    reg1 = LinearRegression(fit_intercept=False).fit(X[mask], y[mask])          
    pred1 = reg1.predict(X[mask])                                               
    err1 = np.sum((y[mask] - pred1)**2)                                         
                                                                                
    # Mode 2                                                                    
    reg2 = LinearRegression(fit_intercept=False).fit(X[~mask], y[~mask])        
    pred2 = reg2.predict(X[~mask])                                              
    err2 = np.sum((y[~mask] - pred2)**2)                                        
                                                                                
    return err1 + err2, reg1.coef_, reg2.coef_                                  
                                                                                
# Search for threshold in x                                                     
best_err = np.inf                                                               
best_thresh = None                                                              
best_type = None                                                                
best_coefs = None                                                               
                                                                                
thresholds = np.linspace(np.min(x), np.max(x), 50)                              
for t in thresholds:                                                            
    mask = x > t                                                                
    err, c1, c2 = get_error(mask, X_features, acc)                              
    if err < best_err:                                                          
        best_err, best_thresh, best_type, best_coefs = err, t, 'x > t', (c1, c2)
                                                                                
# Search for threshold in |x|                                                   
abs_x = np.abs(x)                                                               
thresholds_abs = np.linspace(np.min(abs_x), np.max(abs_x), 50)                  
for t in thresholds_abs:                                                        
