import numpy as np                                                              
                                                                                
# Load Sample 0                                                                 
data = np.load('data_all/non_linear/duffing/sample_0.npz')                      
x_pos = data['state'][0, :]                                                     
u_val = data['input'][0, :]                                                     
t = np.linspace(0, 10, len(x_pos))                                              
dt = t[1] - t[0]                                                                
x_vel = np.gradient(x_pos, dt)                                                  
x_acc = np.gradient(x_vel, dt)                                                  
                                                                                
# Features: x_vel, x_pos, x_pos**3, u_val, 1                                    
X = np.column_stack([x_vel, x_pos, x_pos**3, u_val, np.ones_like(x_pos)])       
y = x_acc                                                                       
                                                                                
# EM-like clustering for two linear models                                      
# Use a more stable initialization                                              
mask = x_vel > 0                                                                
for _ in range(10):                                                             
    c1, _, _, _ = np.linalg.lstsq(X[mask], y[mask], rcond=None)                 
    c2, _, _, _ = np.linalg.lstsq(X[~mask], y[~mask], rcond=None)               
                                                                                
    # Manual prediction                                                         
    p1 = np.zeros_like(y)                                                       
    p2 = np.zeros_like(y)                                                       
    for i in range(5):                                                          
        p1 += X[:, i] * c1[i]                                                   
        p2 += X[:, i] * c2[i]                                                   
                                                                                
    err1 = np.abs(y - p1)                                                       
    err2 = np.abs(y - p2)                                                       
    new_mask = err1 < err2                                                      
    if np.array_equal(mask, new_mask):                                          
        break                                                                   
    mask = new_mask                                                             
                                                                                
# Now find transitions                                                          
trans_indices = np.where(np.diff(mask.astype(int)) != 0)[0]                     
num_trans = len(trans_indices)                                                  
                                                                                
# Check the guard correlation                                                   
# Is it something like |u| > 0.5?                                               
best_guard = "Unknown"                                                          
best_acc = 0                                                                    
for name, val in [('x1', x_pos), ('v1', x_vel), ('u1', u_val)]:                 
    thrs = np.linspace(np.min(val), np.max(val), 100)                           
    for th in thrs:                                                             
        acc = np.mean((val > th) == mask)                                       
        if max(acc, 1-acc) > best_acc:                                          
            best_acc = max(acc, 1-acc)                                          
            best_guard = f"{name} > {th:.4f}"                                   
                                                                                
print(f"Num Transitions: {num_trans}")                                          
print(f"Mode 1 Coefficients: {c1}")                                             
print(f"Mode 2 Coefficients: {c2}")                                             
print(f"Best Guard Candidate: {best_guard} (Acc: {best_acc})")                  
                                                                                
# Final attempt at identifying coefficients for a clean output                  
                                                                                
