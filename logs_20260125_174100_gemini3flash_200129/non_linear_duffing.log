        x_pos[mask]**3,                                                         
        u_input[mask],                                                          
        np.ones(np.sum(mask))                                                   
    ])                                                                          
    y = x_accel[mask]                                                           
                                                                                
    # Use lstsq to find coefficients                                            
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    return coeffs                                                               
                                                                                
coeffs_mode1 = solve_regression(mask_mode1)                                     
