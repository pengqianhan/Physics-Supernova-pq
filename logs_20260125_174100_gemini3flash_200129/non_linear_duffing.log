        "Estimated Coefficients (assuming dt=1)": {                             
            "Mode 1 (x < 0)": {                                                 
                "c1 (dx)": coeffs_neg[0],                                       
                "c2 (x)": coeffs_neg[1],                                        
                "c3 (x^3)": coeffs_neg[2],                                      
                "c4 (u)": coeffs_neg[3],                                        
                "bias": coeffs_neg[4]                                           
            },                                                                  
            "Mode 2 (x >= 0)": {                                                
                "c1 (dx)": coeffs_pos[0],                                       
