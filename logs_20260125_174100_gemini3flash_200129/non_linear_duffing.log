        x_aligned = x[1:-1]                                                     
        v_aligned = (x[2:] - x[:-2]) / (2*dt)                                   
        u_aligned = u[1:-1]                                                     
        a_aligned = (x[2:] - 2*x[1:-1] + x[:-2]) / (dt**2)                      
                                                                                
        features = np.column_stack([v_aligned, x_aligned, x_aligned**3,         
u_aligned, np.ones_like(x_aligned)])                                            
        target = a_aligned                                                      
                                                                                
        window_size = 100                                                       
        for i in range(0, len(target) - window_size, 100):                      
            X_win = features[i:i+window_size]                                   
            y_win = target[i:i+window_size]                                     
            # Only keep windows with very low residual to ensure we are in a    
