def analyze_dynamics(path, dt=0.01, window_size=100):                           
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    x_m, v, acc, u_m = get_derivatives(x, u, dt=dt)                             
                                                                                
    num_samples = len(x_m)                                                      
    local_coeffs = []                                                           
                                                                                
    for start in range(0, num_samples - window_size, window_size):              
        end = start + window_size                                               
        xs = x_m[start:end]                                                     
        vs = v[start:end]                                                       
        as_ = acc[start:end]                                                    
        us = u_m[start:end]                                                     
                                                                                
        X = np.stack([vs, xs, xs**3, us, np.ones_like(xs)], axis=1)             
        c, _, _, _ = np.linalg.lstsq(X, as_, rcond=None)                        
        local_coeffs.append(c)                                                  
                                                                                
    return np.array(local_coeffs)                                               
                                                                                
