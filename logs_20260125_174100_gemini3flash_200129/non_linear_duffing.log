import numpy as np                                                              
                                                                                
def fit_regions_per_file(dt=0.001):                                             
    results = {}                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x = data['state'][0]                                                    
        u = data['input'][0]                                                    
        x_m, v, acc, u_m = get_derivatives(x, u, dt=dt)                         
                                                                                
        results[path] = {}                                                      
        for name, mask in [("x < -1", x_m < -1), ("|x| <= 1", np.abs(x_m) <= 1),
("x > 1", x_m > 1)]:                                                            
            if np.sum(mask) > 100:                                              
                xm_r, v_r, acc_r, u_r = x_m[mask], v[mask], acc[mask], u_m[mask]
                X = np.stack([v_r, xm_r, xm_r**3, u_r, np.ones_like(xm_r)],     
axis=1)                                                                         
                c, _, _, _ = np.linalg.lstsq(X, acc_r, rcond=None)              
                results[path][name] = c                                         
                print(f"{path} {name}: {c}")                                    
    return results                                                              
                                                                                
fit_regions_per_file()                                                          
                                                                                
