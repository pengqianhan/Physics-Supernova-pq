        for i in range(1, len(labels)-1):                                       
            if labels[i-1] == labels[i+1]:                                      
                labels[i] = labels[i-1]                                         
                                                                                
    transitions = np.where(labels[1:] != labels[:-1])[0]                        
    print(f"Transitions count: {len(transitions)}")                             
                                                                                
    # 4. Fit ODE for each mode                                                  
    # x1_acc = c1*x1_vel + c2*x1_pos + c3*x1_pos**3 + c4*u1 + bias              
    A = np.column_stack([x1_vel, x1_pos, x1_pos**3, u1, np.ones_like(x1_pos)])  
                                                                                
