import numpy as np                                                              
                                                                                
def fit_discrete_segment(x, u, start, end):                                     
    n = end - start - 2                                                         
    if n < 10: return None                                                      
    xs = x[start:end]                                                           
    us = u[start:end]                                                           
    x_next2 = xs[2:]                                                            
    x_next1 = xs[1:-1]                                                          
    x_curr = xs[:-2]                                                            
    u_curr = us[:-2]                                                            
    feat = np.column_stack([x_next1, x_curr, x_curr**3, u_curr, np.ones(n)])    
    k, _, _, _ = np.linalg.lstsq(feat, x_next2, rcond=None)                     
    return k                                                                    
                                                                                
