        Y_m = Y[mask]                                                           
        # Solve X_m * c = Y_m                                                   
        coeffs, residuals, rank, s = np.linalg.lstsq(X_m, Y_m, rcond=None)      
        print(f"Mode {m} coeffs: {coeffs}")                                     
