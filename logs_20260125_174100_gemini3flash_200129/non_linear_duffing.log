import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
dt = 0.01                                                                       
                                                                                
def get_derivatives(x, dt):                                                     
    # Higher order derivative approximation                                     
    dx = np.gradient(x, dt)                                                     
    ddx = np.gradient(dx, dt)                                                   
    return dx, ddx                                                              
                                                                                
all_x1 = []                                                                     
all_x1_dot = []                                                                 
all_x1_ddot = []                                                                
all_u1 = []                                                                     
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x1 = data['state'][0]                                                       
    u = data['input'][0]                                                        
    dx, ddx = get_derivatives(x1, dt)                                           
                                                                                
    all_x1.append(x1)                                                           
    all_x1_dot.append(dx)                                                       
    all_x1_ddot.append(ddx)                                                     
    all_u1.append(u)                                                            
                                                                                
# Concatenate for global analysis                                               
X1 = np.concatenate(all_x1)                                                     
X1_dot = np.concatenate(all_x1_dot)                                             
X1_ddot = np.concatenate(all_x1_ddot)                                           
U1 = np.concatenate(all_u1)                                                     
                                                                                
# Fit a global model: x1_ddot = a*x1_dot + b*x1 + c*x1**3 + d*u1 + e            
features = np.column_stack([X1_dot, X1, X1**3, U1, np.ones_like(X1)])           
coeffs, residuals, rank, s = np.linalg.lstsq(features, X1_ddot, rcond=None)     
                                                                                
# Calculate global residuals                                                    
predicted_ddot = np.dot(features, coeffs)                                       
error = X1_ddot - predicted_ddot                                                
                                                                                
plt.figure(figsize=(10, 5))                                                     
plt.plot(error)                                                                 
plt.title("Global Fit Residuals")                                               
plt.savefig("residuals.png")                                                    
                                                                                
print("Global coeffs (a, b, c, d, e):", coeffs)                                 
print("Max residual:", np.max(np.abs(error)))                                   
print("Mean squared error:", np.mean(error**2))                                 
                                                                                
