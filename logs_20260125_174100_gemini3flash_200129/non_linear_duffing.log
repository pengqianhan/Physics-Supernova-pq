all_states = []                                                                 
all_inputs = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
    all_inputs.append(data['input'])                                            
                                                                                
# Concatenate data                                                              
state = np.concatenate(all_states, axis=0)                                      
u_raw = np.concatenate(all_inputs, axis=0)                                      
                                                                                
# x1 is displacement                                                            
x1 = state[:, 0]                                                                
dt = 0.001                                                                      
                                                                                
# Compute velocity and acceleration using finite differences                    
# v[i] = (x[i+1] - x[i]) / dt                                                   
# a[i] = (v[i+1] - v[i]) / dt = (x[i+2] - 2*x[i+1] + x[i]) / dt^2               
v = np.diff(x1) / dt                                                            
a = np.diff(v) / dt                                                             
                                                                                
# Align variables for regression: a[i] uses x[i], v[i], u[i]                    
# a has length N-2                                                              
# v should be v[:-1] (length N-2)                                               
# x should be x[:-2] (length N-2)                                               
# u should be u[:-2] (length N-2)                                               
x_reg = x1[:-2]                                                                 
v_reg = v[:-1]                                                                  
u_reg = u_raw[:-2, 0]                                                           
a_reg = a                                                                       
                                                                                
# Mode transition counting function with hysteresis                             
def count_transitions(x_vals, T, H):                                            
    modes = np.zeros(len(x_vals), dtype=int)                                    
