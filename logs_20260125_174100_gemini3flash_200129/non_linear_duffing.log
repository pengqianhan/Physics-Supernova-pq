import numpy as np                                                              
                                                                                
def get_modes(x):                                                               
    modes = np.zeros(len(x), dtype=int)                                         
    # Determine initial mode: try to find the first definitive mode             
    curr = 1                                                                    
    for val in x:                                                               
        if abs(val) > 1.15:                                                     
            curr = 1                                                            
            break                                                               
        if abs(val) < 0.85:                                                     
            curr = 2                                                            
            break                                                               
                                                                                
    for i in range(len(x)):                                                     
        if curr == 1 and abs(x[i]) < 0.85:                                      
            curr = 2                                                            
        elif curr == 2 and abs(x[i]) > 1.15:                                    
            curr = 1                                                            
        modes[i] = curr                                                         
    return modes                                                                
                                                                                
data_files = ['data_all/non_linear/duffing/sample_0.npz',                       
'data_all/non_linear/duffing/sample_1.npz',                                     
'data_all/non_linear/duffing/sample_2.npz']                                     
                                                                                
def fit_with_input(input_index_offset):                                         
    mode_features = {1: [], 2: []}                                              
    mode_targets = {1: [], 2: []}                                               
                                                                                
    for file_path in data_files:                                                
        data = np.load(file_path)                                               
        x = data['state'][0]                                                    
        u = data['input'][0]                                                    
        modes = get_modes(x)                                                    
                                                                                
        # Equation: x[k+2] = c1*x[k+1] + c2*x[k] + c3*x[k]**3 + c4*u[k+offset] +
bias                                                                            
        # We assign the mode based on the state at k+1 (the state from which the
transition happens)                                                             
        for k in range(len(x) - 2):                                             
            m = modes[k+1]                                                      
            if k + input_index_offset < len(u):                                 
                feat = [x[k+1], x[k], x[k]**3, u[k + input_index_offset], 1.0]  
                target = x[k+2]                                                 
                mode_features[m].append(feat)                                   
                mode_targets[m].append(target)                                  
                                                                                
    results = {}                                                                
    total_r2 = 0                                                                
    for m in [1, 2]:                                                            
        A = np.array(mode_features[m])                                          
        B = np.array(mode_targets[m])                                           
        coeffs, _, _, _ = np.linalg.lstsq(A, B, rcond=None)                     
                                                                                
        y_mean = np.mean(B)                                                     
        ss_tot = np.sum((B - y_mean)**2)                                        
        ss_res = np.sum((B - np.dot(A, coeffs))**2)                             
        r2 = 1 - (ss_res / ss_tot)                                              
        results[m] = (coeffs, r2)                                               
        total_r2 += r2                                                          
    return results, total_r2                                                    
                                                                                
