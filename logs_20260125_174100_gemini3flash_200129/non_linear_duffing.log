import numpy as np                                                              
                                                                                
def solve_task():                                                               
    # File paths                                                                
    file_paths = [                                                              
        'data_all/non_linear/duffing/sample_0.npz',                             
        'data_all/non_linear/duffing/sample_1.npz',                             
        'data_all/non_linear/duffing/sample_2.npz'                              
    ]                                                                           
                                                                                
    # We need to assume a dt. Standard for these datasets is often 0.1.         
    # Note: The MSE comparison for different T is independent of the dt scaling.
    dt = 0.1                                                                    
                                                                                
    all_x1_sync = []                                                            
    all_x1_dot_sync = []                                                        
    all_x1_ddot = []                                                            
    all_u1_sync = []                                                            
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        x1_raw = data['state'][0]                                               
        u1_raw = data['input'][0]                                               
                                                                                
        # Step 2: Compute derivatives                                           
        x1_dot = (x1_raw[1:] - x1_raw[:-1]) / dt                                
        x1_ddot = (x1_dot[1:] - x1_dot[:-1]) / dt                               
                                                                                
        # Step 3: Synchronize                                                   
        # x1_ddot[i] is centered at index i+1                                   
        # Synchronize x1 and u1 with x1_ddot using indices [1:-1]               
        x1_sync = x1_raw[1:-1]                                                  
        u1_sync = u1_raw[1:-1]                                                  
        # For x1_dot, use the average (centered) value at index i+1             
        x1_dot_sync = (x1_dot[:-1] + x1_dot[1:]) / 2.0                          
                                                                                
        all_x1_sync.append(x1_sync)                                             
        all_x1_dot_sync.append(x1_dot_sync)                                     
        all_x1_ddot.append(x1_ddot)                                             
        all_u1_sync.append(u1_sync)                                             
                                                                                
    X1 = np.concatenate(all_x1_sync)                                            
    V1 = np.concatenate(all_x1_dot_sync)                                        
    A1 = np.concatenate(all_x1_ddot)                                            
    U1 = np.concatenate(all_u1_sync)                                            
                                                                                
    def evaluate_threshold(T):                                                  
        # Step 4: Define modes                                                  
        mask1 = np.abs(X1) > T                                                  
        mask2 = np.abs(X1) <= T                                                 
                                                                                
        results = {}                                                            
        total_sq_error = 0                                                      
        total_points = len(X1)                                                  
                                                                                
        for mode_name, mask in [("Mode 1", mask1), ("Mode 2", mask2)]:          
            if np.sum(mask) < 10:                                               
                results[mode_name] = None                                       
                continue                                                        
                                                                                
            # Features for regression: x1_dot, x1, x1^3, u1, 1                  
            # ODE: x1_ddot = c1*x1_dot + c2*x1 + c3*x1**3 + c4*u1 + c5          
            features = np.column_stack([                                        
                V1[mask],                                                       
                X1[mask],                                                       
                X1[mask]**3,                                                    
                U1[mask],                                                       
                np.ones(np.sum(mask))                                           
            ])                                                                  
            targets = A1[mask]                                                  
                                                                                
            # Linear regression using lstsq                                     
            coeffs, residuals, rank, s = np.linalg.lstsq(features, targets,     
rcond=None)                                                                     
                                                                                
            # Calculate MSE                                                     
            predictions = np.dot(features, coeffs)                              
            errors = targets - predictions                                      
            mse = np.mean(errors**2)                                            
                                                                                
            results[mode_name] = {                                              
                'coeffs': coeffs,                                               
                'mse': mse,                                                     
                'count': np.sum(mask)                                           
            }                                                                   
            total_sq_error += np.sum(errors**2)                                 
                                                                                
        overall_mse = total_sq_error / total_points                             
        return results, overall_mse                                             
                                                                                
    # Evaluate different thresholds                                             
    res_1_0, mse_1_0 = evaluate_threshold(1.0)                                  
    res_0_8, mse_0_8 = evaluate_threshold(0.8)                                  
    res_1_2, mse_1_2 = evaluate_threshold(1.2)                                  
                                                                                
    return {                                                                    
        "1.0": (res_1_0, mse_1_0),                                              
        "0.8": (res_0_8, mse_0_8),                                              
        "1.2": (res_1_2, mse_1_2)                                               
    }                                                                           
                                                                                
