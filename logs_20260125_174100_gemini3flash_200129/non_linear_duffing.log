import numpy as np                                                              
                                                                                
# Load data files                                                               
data_files = ['data_all/non_linear/duffing/sample_0.npz',                       
'data_all/non_linear/duffing/sample_1.npz',                                     
'data_all/non_linear/duffing/sample_2.npz']                                     
                                                                                
all_x = []                                                                      
all_u = []                                                                      
                                                                                
for file in data_files:                                                         
    data = np.load(file)                                                        
    all_x.append(data['state'].flatten())                                       
    all_u.append(data['input'].flatten())                                       
                                                                                
x_t = np.concatenate(all_x)                                                     
u_t = np.concatenate(all_u)                                                     
                                                                                
def perform_regression(dt):                                                     
    # Calculate v and a for this dt                                             
    all_v = []                                                                  
    all_a = []                                                                  
    for x in all_x:                                                             
        v = np.gradient(x, dt)                                                  
        a = np.gradient(v, dt)                                                  
        all_v.append(v)                                                         
        all_a.append(a)                                                         
                                                                                
    v_t = np.concatenate(all_v)                                                 
    a_t = np.concatenate(all_a)                                                 
                                                                                
    results = {}                                                                
    for mode_name, mask in [("Mode1", np.abs(x_t) <= 1.2), ("Mode2", np.abs(x_t)
> 1.2)]:                                                                        
        if np.sum(mask) > 10:                                                   
            # Regress a ~ [v, x, x**3, u, 1]                                    
            A = np.column_stack([v_t[mask], x_t[mask], x_t[mask]**3, u_t[mask], 
np.ones(np.sum(mask))])                                                         
            y = a_t[mask]                                                       
            coeffs, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                 
            results[mode_name] = coeffs                                         
    return results                                                              
                                                                                
# Test a few dt values                                                          
for dt in [0.001, 0.002, 0.005, 0.01]:                                          
    res = perform_regression(dt)                                                
    print(f"--- dt = {dt} ---")                                                 
    for mode, coeffs in res.items():                                            
        print(f"{mode}: {coeffs}")                                              
                                                                                
