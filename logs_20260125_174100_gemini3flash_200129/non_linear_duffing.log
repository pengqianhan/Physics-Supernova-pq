import numpy as np                                                              
                                                                                
def analyze_sample(file_path, dt=0.01):                                         
    data = np.load(file_path)                                                   
    x1 = data['state'][0]                                                       
    u1 = data['input'][0]                                                       
                                                                                
    # Use finite difference for better precision at boundaries                  
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    # Prepare regression: x1_ddot = a*x1_dot + b*x1 + c*x1**3 + d*u1 + e        
    X = np.column_stack([x1_dot, x1, x1**3, u1, np.ones_like(x1)])              
    coeffs, residuals, rank, s = np.linalg.lstsq(X, x1_ddot, rcond=None)        
                                                                                
    error = x1_ddot - X @ coeffs                                                
    return coeffs, error                                                        
                                                                                
for i, path in enumerate(DATA_FILE_PATHS):                                      
    coeffs, error = analyze_sample(path)                                        
    print(f"Sample {i} coefficients: {coeffs}")                                 
    print(f"Sample {i} max error: {np.max(np.abs(error))}")                     
                                                                                
