import numpy as np                                                              
                                                                                
# Load the first data file                                                      
data = np.load(DATA_FILE_PATH)                                                  
t = data['t']                                                                   
x = data['x']                                                                   
u = data['u']                                                                   
                                                                                
print(f"Keys in npz: {list(data.keys())}")                                      
print(f"Shapes: t={t.shape}, x={x.shape}, u={u.shape}")                         
                                                                                
# Assume x[:, 0] is x1                                                          
x1 = x[:, 0]                                                                    
dt = t[1] - t[0]                                                                
                                                                                
# Calculate derivatives                                                         
# x1[1] is first derivative, x1[2] is second derivative                         
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# We want to fit: x1_ddot = c1*x1_dot + c2*x1 + c3*x1**3 + c4*u + c5            
# Construct the feature matrix                                                  
# Note: u might be (N, 1) or (N,)                                               
u_flat = u.flatten()                                                            
features = np.column_stack([x1_dot, x1, x1**3, u_flat, np.ones_like(x1)])       
                                                                                
# Let's try to find where the relationship breaks.                              
# Global least squares                                                          
coeffs_global, residuals_global, rank, s = np.linalg.lstsq(features, x1_ddot,   
rcond=None)                                                                     
prediction_global = features @ coeffs_global                                    
error_global = np.abs(x1_ddot - prediction_global)                              
                                                                                
print(f"Global coefficients: {coeffs_global}")                                  
print(f"Mean absolute error (global): {np.mean(error_global)}")                 
                                                                                
# Search for switches.                                                          
# Since we expect 18 transitions, let's look at the error peaks or sliding      
window error.                                                                   
# Alternatively, maybe the mode depends on the sign of something.               
# Let's plot or analyze the error.                                              
import matplotlib.pyplot as plt                                                 
# We can't show plots but we can analyze the error.                             
# Let's find segments where the error is low.                                   
                                                                                
# Another approach: Maybe the modes are based on a simple condition like sign of
x1 or x1_dot.                                                                   
# Duffing oscillator often has non-linearities, but hybrid might mean piece-wise
linear or different coefficients.                                               
# Let's try splitting by sign of x1 or x1_dot.                                  
                                                                                
def get_coeffs(mask):                                                           
    if np.sum(mask) < 10: return None                                           
    c, _, _, _ = np.linalg.lstsq(features[mask], x1_ddot[mask], rcond=None)     
    return c                                                                    
                                                                                
# Try splitting by various conditions                                           
masks = {                                                                       
    "x1 > 0": x1 > 0,                                                           
    "x1_dot > 0": x1_dot > 0,                                                   
    "u > 0": u_flat > 0                                                         
}                                                                               
                                                                                
for name, mask in masks.items():                                                
    c1 = get_coeffs(mask)                                                       
    c2 = get_coeffs(~mask)                                                      
    if c1 is not None and c2 is not None:                                       
        err1 = np.mean(np.abs(x1_ddot[mask] - features[mask] @ c1))             
