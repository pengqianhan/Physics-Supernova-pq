import numpy as np                                                              
                                                                                
def manual_kmeans(data, k, max_iters=50):                                       
    n, d = data.shape                                                           
    # Initialize centroids by picking k random points                           
    np.random.seed(42)                                                          
    indices = np.random.choice(n, k, replace=False)                             
    centroids = data[indices]                                                   
                                                                                
    for _ in range(max_iters):                                                  
        # Compute squared Euclidean distances manually using broadcasting       
        # (n, 1, d) - (1, k, d) -> (n, k, d)                                    
        diff = data[:, np.newaxis, :] - centroids[np.newaxis, :, :]             
        dist_sq = np.sum(diff**2, axis=2)                                       
        labels = np.argmin(dist_sq, axis=1)                                     
                                                                                
        # Update centroids                                                      
        new_centroids = np.zeros((k, d))                                        
        for i in range(k):                                                      
            mask = (labels == i)                                                
            if np.any(mask):                                                    
                new_centroids[i] = data[mask].mean(axis=0)                      
            else:                                                               
                # If a cluster is empty, re-initialize its centroid             
                new_centroids[i] = data[np.random.choice(n)]                    
                                                                                
        if np.allclose(centroids, new_centroids):                               
            break                                                               
        centroids = new_centroids                                               
    return labels, centroids                                                    
                                                                                
