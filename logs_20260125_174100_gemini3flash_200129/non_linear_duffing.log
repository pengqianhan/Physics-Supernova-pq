import numpy as np                                                              
                                                                                
def find_crossings(sample_idx, threshold=2.0):                                  
    data = np.load(f'data_all/non_linear/duffing/sample_{sample_idx}.npz')      
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    crossings = []                                                              
    for i in range(len(x)-1):                                                   
        if (x[i] >= threshold and x[i+1] < threshold) or (x[i] <= threshold and 
x[i+1] > threshold):                                                            
            crossings.append(i)                                                 
    return crossings, x, u                                                      
                                                                                
crossings0, x0, u0 = find_crossings(0, 2.0)                                     
print("Crossings of x=2.0 in sample 0:", crossings0[:10])                       
                                                                                
# Let's check the dynamics in each region                                       
# Region 1: x > 2                                                               
# Region 2: x < 2                                                               
                                                                                
def get_region_data(x, u, threshold=2.0):                                       
    idx1 = np.where(x > threshold)[0]                                           
    idx2 = np.where(x < threshold)[0]                                           
    # Filter indices to have room for derivatives                               
    idx1 = idx1[(idx1 > 0) & (idx1 < len(x)-2)]                                 
    idx2 = idx2[(idx2 > 0) & (idx2 < len(x)-2)]                                 
    return idx1, idx2                                                           
                                                                                
idx1, idx2 = get_region_data(x0, u0, 2.0)                                       
                                                                                
def fit_region(x, u, idx):                                                      
    # Y = x[i+2] - 2*x[i+1] + x[i]                                              
    # feat = [x[i+1]-x[i], x[i], x[i]**3, u[i], 1]                              
    Y = x[idx+2] - 2*x[idx+1] + x[idx]                                          
    dx = x[idx+1] - x[idx]                                                      
    x_val = x[idx]                                                              
    x3_val = x[idx]**3                                                          
    u_val = u[idx]                                                              
    ones = np.ones_like(x_val)                                                  
    features = np.column_stack([dx, x_val, x3_val, u_val, ones])                
    c, _, _, _ = np.linalg.lstsq(features, Y, rcond=None)                       
    return c                                                                    
                                                                                
if len(idx1) > 100:                                                             
