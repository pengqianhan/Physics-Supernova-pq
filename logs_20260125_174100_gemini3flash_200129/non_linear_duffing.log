import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
                                                                                
def find_switches_and_vals(path):                                               
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    v = np.diff(x) / dt                                                         
    a = np.diff(v) / dt                                                         
    da = np.diff(a)                                                             
    threshold = 5 * np.std(da)                                                  
    sw = np.where(np.abs(da) > threshold)[0]                                    
    # Filter sw to get unique transition points (take first of the pair)        
    if len(sw) == 0: return [], [], []                                          
    unique_sw = [sw[0]]                                                         
    for i in range(1, len(sw)):                                                 
        if sw[i] > sw[i-1] + 5:                                                 
            unique_sw.append(sw[i])                                             
                                                                                
    vals = []                                                                   
    for s in unique_sw:                                                         
        vals.append((x[s], v[s], u[s]))                                         
    return unique_sw, vals                                                      
                                                                                
for i, path in enumerate(DATA_FILE_PATHS):                                      
    sw, vals = find_switches_and_vals(path)                                     
    print(f"Sample {i} unique switches: {sw}")                                  
    print(f"Sample {i} vals (x, v, u) at switches: {vals}")                     
                                                                                
