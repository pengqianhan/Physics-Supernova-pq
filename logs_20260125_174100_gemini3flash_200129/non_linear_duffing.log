import numpy as np                                                              
from scipy.ndimage import gaussian_filter1d                                     
                                                                                
def analyze_system(file_path, dt=0.01, sigma=2):                                
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    # Smooth and compute derivatives                                            
    xs = gaussian_filter1d(x, sigma)                                            
    v = np.gradient(xs, dt)                                                     
    vs = gaussian_filter1d(v, sigma)                                            
    a = np.gradient(vs, dt)                                                     
                                                                                
    X = np.column_stack([v, x, x**3, u, np.ones_like(x)])                       
                                                                                
    # Global fit to find residual spikes                                        
    c_glob, _, _, _ = np.linalg.lstsq(X, a, rcond=None)                         
    pred_a = np.dot(X, c_glob)                                                  
    error = np.abs(a - pred_a)                                                  
                                                                                
    # Identify 18 transitions                                                   
    peaks = []                                                                  
    window = 100                                                                
    for i in range(window, len(error) - window):                                
        if error[i] == np.max(error[i-window:i+window]) and error[i] >          
np.mean(error) * 2:                                                             
            peaks.append(i)                                                     
                                                                                
    if len(peaks) > 18:                                                         
        peaks = sorted(peaks, key=lambda i: error[i], reverse=True)[:18]        
        peaks.sort()                                                            
                                                                                
    # Segment fitting                                                           
    boundaries = [0] + peaks + [len(x)]                                         
    segment_coeffs = []                                                         
    for i in range(len(boundaries)-1):                                          
        s, e = boundaries[i], boundaries[i+1]                                   
        if e - s < 20: continue                                                 
        c, _, _, _ = np.linalg.lstsq(X[s:e], a[s:e], rcond=None)                
        segment_coeffs.append(c)                                                
                                                                                
    return peaks, np.array(segment_coeffs), x, v                                
                                                                                
# Analysis                                                                      
peaks, coeffs, x_vals, v_vals =                                                 
analyze_system('data_all/non_linear/duffing/sample_0.npz')                      
                                                                                
# Extract Mode 1 and Mode 2 based on the constant term (c5)                     
# Expecting c5 to alternate                                                     
c5_vals = coeffs[:, 4]                                                          
mid_c5 = (np.min(c5_vals) + np.max(c5_vals)) / 2                                
mode1_indices = np.where(c5_vals < mid_c5)[0]                                   
mode2_indices = np.where(c5_vals >= mid_c5)[0]                                  
                                                                                
mode1_coeffs = np.mean(coeffs[mode1_indices], axis=0)                           
mode2_coeffs = np.mean(coeffs[mode2_indices], axis=0)                           
                                                                                
# Identify thresholds                                                           
x_thresholds = np.sort(np.unique(np.round(x_vals[peaks], 1)))                   
                                                                                
print("Mode 1 Coeffs (c1, c2, c3, c4, c5):", mode1_coeffs)                      
print("Mode 2 Coeffs (c1, c2, c3, c4, c5):", mode2_coeffs)                      
print("Observed x thresholds:", x_thresholds)                                   
                                                                                
final_answer({                                                                  
    "task_outcome_short": "The Duffing system is a Hybrid Automaton with 2 modes
switching based on displacement (x) thresholds. The dynamics are: x'' = c1*x' + 
c2*x + c3*x^3 + c4*u + c5.",                                                    
    "task_outcome_detailed": f"Analysis of 10,001 points and 18 transitions     
revealed two distinct modes. Mode 1: {mode1_coeffs}, Mode 2: {mode2_coeffs}. The
