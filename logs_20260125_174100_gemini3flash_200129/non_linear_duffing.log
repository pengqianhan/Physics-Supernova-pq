def get_mode_sequence(x_vals):                                                  
    n = len(x_vals)                                                             
    modes = np.zeros(n, dtype=int)                                              
    # Determine initial mode                                                    
    if abs(x_vals[0]) > 1.15:                                                   
        current_mode = 1                                                        
    elif abs(x_vals[0]) < 0.85:                                                 
        current_mode = 2                                                        
    else:                                                                       
        # Default if in the hysteresis zone                                     
        current_mode = 1                                                        
        for v in x_vals:                                                        
            if abs(v) > 1.15:                                                   
                current_mode = 1                                                
                break                                                           
            if abs(v) < 0.85:                                                   
                current_mode = 2                                                
                break                                                           
                                                                                
    for i in range(n):                                                          
        if current_mode == 1:                                                   
            if abs(x_vals[i]) < 0.85:                                           
                current_mode = 2                                                
        elif current_mode == 2:                                                 
            if abs(x_vals[i]) > 1.15:                                           
                current_mode = 1                                                
        modes[i] = current_mode                                                 
    return modes                                                                
                                                                                
# Storage for features and targets for each mode                                
mode_data = {1: {'X': [], 'Y': []}, 2: {'X': [], 'Y': []}}                      
                                                                                
for file_path in files:                                                         
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    modes = get_mode_sequence(x)                                                
                                                                                
    # Dynamics: x[i+2] = c1*x[i+1] + c2*x[i] + c3*x[i]**3 + c4*u[i] + bias      
    # We use the mode at step i to define which dynamics are active for the     
transition i -> i+2                                                             
    # Or maybe mode at i+1? Usually the mode active when the transition is      
computed.                                                                       
    # Let's use the mode at step i+1 as the determining mode for the step to    
i+2.                                                                            
    for i in range(len(x) - 2):                                                 
        m = modes[i+1] # Mode active at the state from which we compute the next
step                                                                            
        target = x[i+2]                                                         
        features = [x[i+1], x[i], x[i]**3, u[i]] # u[i] or u[i+1]? Let's stick  
to u[i]                                                                         
        mode_data[m]['X'].append(features)                                      
        mode_data[m]['Y'].append(target)                                        
                                                                                
results = {}                                                                    
for m in [1, 2]:                                                                
    X = np.array(mode_data[m]['X'])                                             
    Y = np.array(mode_data[m]['Y'])                                             
    reg = LinearRegression().fit(X, Y)                                          
    c1, c2, c3, c4 = reg.coef_                                                  
    bias = reg.intercept_                                                       
    results[m] = (c1, c2, c3, c4, bias)                                         
    score = reg.score(X, Y)                                                     
    print(f"Mode {m} fit score: {score}")                                       
                                                                                
print("Results:", results)                                                      
                                                                                
