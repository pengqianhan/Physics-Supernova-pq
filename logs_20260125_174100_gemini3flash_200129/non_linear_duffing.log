import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    # Use diff to avoid smoothing of np.gradient for jump detection             
    dx = np.diff(x)                                                             
    ddx = np.diff(dx)                                                           
                                                                                
    # We need to align them                                                     
    # x_f: x[0...N-3], dx_f: dx[0...N-3], u_f: u[0...N-3] -> ddx_f: ddx[0...N-3]
    # But ddx[i] = x[i+2] - 2x[i+1] + x[i]                                      
    x_f = x[:-2]                                                                
    dx_f = x[1:-1] - x[:-2]                                                     
    u_f = u[:-2]                                                                
    ddx_f = x[2:] - 2*x[1:-1] + x[:-2]                                          
                                                                                
    return x_f, dx_f, ddx_f, u_f                                                
                                                                                
all_data = [analyze_sample(p) for p in DATA_FILE_PATHS]                         
X_f = np.concatenate([d[0] for d in all_data])                                  
DX_f = np.concatenate([d[1] for d in all_data])                                 
DDX_f = np.concatenate([d[2] for d in all_data])                                
U_f = np.concatenate([d[3] for d in all_data])                                  
                                                                                
# Fit ddx = a*dx + b*x + c*x^3 + d*u + e                                        
A = np.column_stack([DX_f, X_f, X_f**3, U_f, np.ones_like(X_f)])                
coeffs, _, _, _ = np.linalg.lstsq(A, DDX_f, rcond=None)                         
print("Global Discrete Coeffs:", coeffs)                                        
                                                                                
# Let's check residuals to see where the model fails                            
errors = np.abs(DDX_f - np.dot(A, coeffs))                                      
print("Max Error:", np.max(errors))                                             
print("Mean Error:", np.mean(errors))                                           
                                                                                
# Find indices where error is large                                             
large_err = np.where(errors > 5 * np.mean(errors))[0]                           
if len(large_err) > 0:                                                          
    print("Indices with large error (first 10):", large_err[:10])               
    # Check if there's a jump in x or dx at these points                        
    # ddx[i] = (x[i+2]-x[i+1]) - (x[i+1]-x[i])                                  
    # A jump in x at i+1 would make ddx[i] and ddx[i+1] very large (opposite    
signs)                                                                          
    # A jump in dx at i+1 would make ddx[i] large                               
                                                                                
# Try clustering coefficients using a rolling window                            
window = 100                                                                    
step = 50                                                                       
rolling_coeffs = []                                                             
for d in all_data:                                                              
    xf, dxf, ddxf, uf = d                                                       
    for i in range(0, len(xf) - window, step):                                  
        Aw = np.column_stack([dxf[i:i+window], xf[i:i+window],                  
xf[i:i+window]**3, uf[i:i+window], np.ones(window)])                            
        cw, _, _, _ = np.linalg.lstsq(Aw, ddxf[i:i+window], rcond=None)         
        rolling_coeffs.append(cw)                                               
                                                                                
rolling_coeffs = np.array(rolling_coeffs)                                       
print("Rolling Coeffs Mean:", np.mean(rolling_coeffs, axis=0))                  
print("Rolling Coeffs Std:", np.std(rolling_coeffs, axis=0))                    
                                                                                
# If Std is high, there are multiple modes.                                     
# Let's look at the distribution of the 5th coefficient (e) or 2nd (b)          
if np.std(rolling_coeffs[:, 1]) > 1e-6: # Just a threshold                      
    print("Likely multiple modes detected.")                                    
                                                                                
