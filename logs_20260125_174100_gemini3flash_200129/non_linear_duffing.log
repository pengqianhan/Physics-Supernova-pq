import numpy as np                                                              
                                                                                
def analyze_data(dt=0.1):                                                       
    all_x = []                                                                  
    all_v = []                                                                  
    all_a = []                                                                  
    all_u = []                                                                  
                                                                                
    for i in range(3):                                                          
        data = np.load(f'data_all/non_linear/duffing/sample_{i}.npz')           
        x = data['state'][0]                                                    
        u = data['input'][0]                                                    
                                                                                
        v = np.diff(x) / dt                                                     
        a = np.diff(v) / dt                                                     
                                                                                
        # Align lengths: x, u, v, a                                             
        # x: 10001                                                              
        # v: 10000 (diff)                                                       
        # a: 9999 (diff of diff)                                                
        # We'll use the first 9999 points for x, u, v                           
        all_x.append(x[:9999])                                                  
        all_v.append(v[:9999])                                                  
        all_u.append(u[:9999])                                                  
        all_a.append(a)                                                         
                                                                                
    X = np.concatenate(all_x)                                                   
    V = np.concatenate(all_v)                                                   
    U = np.concatenate(all_u)                                                   
    A = np.concatenate(all_a)                                                   
                                                                                
    # Feature matrix: [v, x, x^3, u, 1]                                         
    phi = np.column_stack([V, X, X**3, U, np.ones_like(X)])                     
                                                                                
    # Solve phi * theta = A                                                     
    theta, residuals, rank, s = np.linalg.lstsq(phi, A, rcond=None)             
                                                                                
    # Check residuals locally                                                   
    local_errors = A - phi @ theta                                              
                                                                                
    return theta, local_errors, X, V, A                                         
                                                                                
# Let's try dt = 0.1 first                                                      
theta, errors, X, V, A = analyze_data(dt=0.1)                                   
