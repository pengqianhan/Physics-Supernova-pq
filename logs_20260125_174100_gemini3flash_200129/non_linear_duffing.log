import numpy as np                                                              
                                                                                
def test_t(t):                                                                  
    all_Y_1, all_feat_1 = [], []                                                
    all_Y_2, all_feat_2 = [], []                                                
    for i in range(3):                                                          
        data = np.load(f'data_all/non_linear/duffing/sample_{i}.npz')           
        x = data['state'][0]                                                    
        u = data['input'][0]                                                    
        Y = x[2:] - 2*x[1:-1] + x[:-2]                                          
        dx = x[1:-1] - x[:-2]                                                   
        x_val = x[:-2]                                                          
        x3_val = x[:-2]**3                                                      
        u_val = u[:-2]                                                          
        features = np.column_stack([dx, x_val, x3_val, u_val,                   
np.ones_like(x_val)])                                                           
        mask1 = np.abs(x_val) > t                                               
        mask2 = np.abs(x_val) <= t                                              
        if np.any(mask1):                                                       
            all_Y_1.append(Y[mask1]); all_feat_1.append(features[mask1])        
        if np.any(mask2):                                                       
            all_Y_2.append(Y[mask2]); all_feat_2.append(features[mask2])        
                                                                                
    c1, res1, _, _ = np.linalg.lstsq(np.concatenate(all_feat_1),                
np.concatenate(all_Y_1), rcond=None)                                            
    c2, res2, _, _ = np.linalg.lstsq(np.concatenate(all_feat_2),                
np.concatenate(all_Y_2), rcond=None)                                            
    return np.sum(res1) + np.sum(res2)                                          
                                                                                
thresholds = np.linspace(0.95, 1.05, 11)                                        
results = [test_t(t) for t in thresholds]                                       
for t, res in zip(thresholds, results):                                         
    print(f"Threshold {t:.3f}: Total Residual {res:.4e}")                       
                                                                                
