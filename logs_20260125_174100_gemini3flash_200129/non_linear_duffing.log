import numpy as np                                                              
                                                                                
def direct_discrete_fit(path):                                                  
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    # x[k+2] = a*x[k+1] + b*x[k] + c*x[k]**3 + d*u[k] + e                       
    X_k2 = x[2:]                                                                
    X_k1 = x[1:-1]                                                              
    X_k = x[:-2]                                                                
    U_k = u[:-2]                                                                
                                                                                
    A = np.column_stack([X_k1, X_k, X_k**3, U_k, np.ones_like(X_k)])            
    c, _, _, _ = np.linalg.lstsq(A, X_k2, rcond=None)                           
    return c, np.max(np.abs(X_k2 - np.dot(A, c)))                               
                                                                                
for p in DATA_FILE_PATHS:                                                       
    c, err = direct_discrete_fit(p)                                             
    print(f"Direct Fit {p}: Coeffs {c}, Max Err {err}")                         
                                                                                
