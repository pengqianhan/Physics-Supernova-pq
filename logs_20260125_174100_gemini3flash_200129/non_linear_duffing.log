  u = data['u']                                                                 
                                                                                
  print("Shapes - t:", t.shape, "x:", x.shape, "u:", u.shape)                   
                                                                                
  # Based on the task, x1[0] is position, x1[1] is velocity, x1[2] is           
  acceleration.                                                                 
  # If x has multiple columns, let's see.                                       
  # Usually in these datasets, x[:, 0] is the primary state.                    
  pos = x[:, 0]                                                                 
  dt = t[1] - t[0]                                                              
                                                                                
  # Central differences for velocity and acceleration                           
  vel = np.zeros_like(pos)                                                      
  acc = np.zeros_like(pos)                                                      
                                                                                
  # Velocity: (x[i+1] - x[i-1]) / (2*dt)                                        
  vel[1:-1] = (pos[2:] - pos[:-2]) / (2 * dt)                                   
  # End points                                                                  
  vel[0] = (pos[1] - pos[0]) / dt                                               
  vel[-1] = (pos[-1] - pos[-2]) / dt                                            
                                                                                
  # Acceleration: (v[i+1] - v[i-1]) / (2*dt)                                    
  acc[1:-1] = (vel[2:] - vel[:-2]) / (2 * dt)                                   
  acc[0] = (vel[1] - vel[0]) / dt                                               
  acc[-1] = (vel[-1] - vel[-2]) / dt                                            
                                                                                
  # We need to find modes. I'll use a sliding window regression error.          
  # The model: acc = a*vel + b*pos + c*pos**3 + d*u + e                         
  # Let's define the features                                                   
  X_features = np.column_stack([vel, pos, pos**3, u.flatten(),                  
  np.ones_like(pos)])                                                           
  y_target = acc                                                                
                                                                                
  print("Feature matrix shape:", X_features.shape)                              
