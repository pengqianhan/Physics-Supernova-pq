import numpy as np                                                              
                                                                                
def get_derivatives(x, u, dt=0.1):                                              
    v = (x[2:] - x[:-2]) / (2 * dt)                                             
    a = (x[2:] - 2 * x[1:-1] + x[:-2]) / (dt**2)                                
    x_mid = x[1:-1]                                                             
    u_mid = u[1:-1]                                                             
    return x_mid, v, a, u_mid                                                   
                                                                                
def fit_ode(x, v, a, u):                                                        
    X = np.stack([v, x, x**3, u, np.ones_like(x)], axis=1)                      
    coeffs, residuals, rank, s = np.linalg.lstsq(X, a, rcond=None)              
    return coeffs, residuals                                                    
                                                                                
for i in range(len(DATA_FILE_PATHS)):                                           
    data = np.load(DATA_FILE_PATHS[i])                                          
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
                                                                                
    x_m, v, acc, u_m = get_derivatives(x, u, dt=0.1)                            
    coeffs, res = fit_ode(x_m, v, acc, u_m)                                     
    print(f"File {i} coefficients (dt=0.1): {coeffs}")                          
    print(f"File {i} mean residual: {np.mean(res) if res.size > 0 else 'N/A'}") 
                                                                                
    # Check for large local errors to find switches                             
    X = np.stack([v, x_m, x_m**3, u_m, np.ones_like(x_m)], axis=1)              
    errors = np.abs(acc - X @ coeffs)                                           
    if np.any(errors > 1e-3):                                                   
