    sample0_x1_dot = None                                                       
                                                                                
    for i, path in enumerate(DATA_FILE_PATHS):                                  
        data = np.load(path)                                                    
        # Assuming state is (1, N) or (N, 1) or (N,)                            
        s = data['state'].squeeze()                                             
        u = data['input'].squeeze()                                             
        dt = 0.001                                                              
                                                                                
        # Central difference derivatives                                        
        x1_dot = np.gradient(s, dt)                                             
        x1_ddot = np.gradient(x1_dot, dt)                                       
                                                                                
        all_x1.append(s)                                                        
        all_x1_dot.append(x1_dot)                                               
        all_u1.append(u)                                                        
        all_x1_ddot.append(x1_ddot)                                             
                                                                                
        if i == 0:                                                              
            sample0_x1 = s                                                      
            sample0_x1_dot = x1_dot                                             
                                                                                
    X = np.concatenate(all_x1)                                                  
    Xd = np.concatenate(all_x1_dot)                                             
    Xdd = np.concatenate(all_x1_ddot)                                           
    U = np.concatenate(all_u1)                                                  
                                                                                
    # Mode definitions                                                          
    mask1 = np.abs(X) <= 1.0                                                    
    mask2 = np.abs(X) > 1.0                                                     
                                                                                
    def fit(m):                                                                 
        if np.sum(m) == 0: return None                                          
        # y = [Xd, X, X**3, U, 1] * beta                                        
        A = np.column_stack([Xd[m], X[m], X[m]**3, U[m], np.ones(np.sum(m))])   
        y = Xdd[m]                                                              
        beta, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                       
        return beta                                                             
                                                                                
    c1 = fit(mask1)                                                             
    c2 = fit(mask2)                                                             
                                                                                
    # Transitions for Sample 0                                                  
    m0 = (np.abs(sample0_x1) > 1.0).astype(int)                                 
    trans = np.sum(np.abs(np.diff(m0)))                                         
                                                                                
    trans_pts = np.where(np.diff(m0) != 0)[0]                                   
    jumps_x1 = []                                                               
    jumps_xd = []                                                               
    for p in trans_pts:                                                         
        jumps_x1.append(np.abs(sample0_x1[p+1] - sample0_x1[p]))                
        jumps_xd.append(np.abs(sample0_x1_dot[p+1] - sample0_x1_dot[p]))        
                                                                                
    return c1, c2, trans, jumps_x1, jumps_xd                                    
                                                                                
