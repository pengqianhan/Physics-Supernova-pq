import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
def plot_residuals(filename, sample_id):                                        
    data = np.load(filename)                                                    
    x = data['state'][0]                                                        
    u = data['input'][0]                                                        
    dt = 0.01                                                                   
                                                                                
    v = np.diff(x) / dt                                                         
    a = np.diff(v) / dt                                                         
                                                                                
    x_val = x[:-2]                                                              
    v_val = v[:-1]                                                              
    u_val = u[:-2]                                                              
    a_val = a                                                                   
    x3_val = x_val**3                                                           
    ones = np.ones_like(x_val)                                                  
                                                                                
    X = np.column_stack([v_val, x_val, x3_val, u_val, ones])                    
    coeffs, _, _, _ = np.linalg.lstsq(X, a_val, rcond=None)                     
                                                                                
    predicted_a = np.dot(X, coeffs)                                             
    residuals = np.abs(a_val - predicted_a)                                     
                                                                                
    plt.figure(figsize=(10, 4))                                                 
    plt.plot(residuals)                                                         
    plt.title(f'Residuals Sample {sample_id}')                                  
    plt.savefig(f'residuals_{sample_id}.png')                                   
                                                                                
    print(f"Sample {sample_id} x range: {np.min(x)}, {np.max(x)}")              
    return residuals                                                            
                                                                                
