import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the primary data file                                                    
data = np.load('data_all/linear/underdamped_system/sample_0.npz')               
print("Keys in npz file:", list(data.keys()))                                   
                                                                                
t = data['t']                                                                   
x = data['x']                                                                   
                                                                                
# Assuming x contains x1 and x2                                                 
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
print(f"Shapes: t {t.shape}, x1 {x1.shape}, x2 {x2.shape}")                     
                                                                                
# Calculate derivatives for x1 and x2                                           
dt = t[1] - t[0]                                                                
dx1 = np.gradient(x1, dt)                                                       
dx2 = np.gradient(x2, dt)                                                       
d2x2 = np.gradient(dx2, dt)                                                     
                                                                                
# Identify modes: Mode 1 (x1 increasing), Mode 2 (x1 decreasing)                
# Using a threshold for velocity to avoid noise issues                          
mode = np.where(dx1 > 0, 1, 2)                                                  
                                                                                
# Find transition indices                                                       
transitions = np.where(mode[:-1] != mode[1:])[0]                                
print(f"Transitions at indices: {transitions}")                                 
print(f"x1 values at transitions: {x1[transitions]}")                           
print(f"x1 velocities before and after transitions: {dx1[transitions]},         
{dx1[transitions+1]}")                                                          
                                                                                
# Function to fit x2'' + a*x2' + b*x2 = c                                       
def fit_ode(m_indices, x2, dx2, d2x2):                                          
    # Solve [dx2, x2, 1] * [-a, -b, c]^T = d2x2                                 
    # Rearranged: d2x2 = -a*dx2 - b*x2 + c                                      
    A = np.column_stack([-dx2[m_indices], -x2[m_indices],                       
np.ones(len(m_indices))])                                                       
    y = d2x2[m_indices]                                                         
    params, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                         
    return params                                                               
                                                                                
# Perform fitting for each mode                                                 
params_m1 = fit_ode(np.where(mode == 1)[0], x2, dx2, d2x2)                      
params_m2 = fit_ode(np.where(mode == 2)[0], x2, dx2, d2x2)                      
                                                                                
print(f"Mode 1 params (a, b, c): {params_m1}")                                  
print(f"Mode 2 params (a, b, c): {params_m2}")                                  
                                                                                
# Calculate average velocity of x1 in each mode                                 
v1_m1 = np.mean(dx1[mode == 1])                                                 
v1_m2 = np.mean(dx1[mode == 2])                                                 
print(f"Average x1 velocity Mode 1: {v1_m1}")                                   
print(f"Average x1 velocity Mode 2: {v1_m2}")                                   
                                                                                
