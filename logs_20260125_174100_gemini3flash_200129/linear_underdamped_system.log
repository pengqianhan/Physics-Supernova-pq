  import numpy as np                                                            
                                                                                
  def analyze_sample(file_path):                                                
      data = np.load(file_path)                                                 
      state = data['state']                                                     
      x1 = state[0, :]                                                          
      x2 = state[1, :]                                                          
      dt = 0.01  # Inferred from previous step                                  
                                                                                
      dx1 = np.diff(x1) / dt                                                    
      mode = np.where(dx1 > 0, 1, 2)                                            
                                                                                
      dx2 = np.gradient(x2, dt)                                                 
      d2x2 = np.gradient(dx2, dt)                                               
                                                                                
      def fit(m_val):                                                           
          idx = np.where(mode == m_val)[0]                                      
          if len(idx) < 10: return None                                         
          # Solve d2x2 = -a*dx2 - b*x2 + c                                      
          A = np.column_stack([-dx2[idx], -x2[idx], np.ones(len(idx))])         
          y = d2x2[idx]                                                         
          return np.linalg.lstsq(A, y, rcond=None)[0]                           
                                                                                
      p1 = fit(1)                                                               
      p2 = fit(2)                                                               
      v1_m1 = np.mean(dx1[mode == 1])                                           
      v1_m2 = np.mean(dx1[mode == 2])                                           
                                                                                
      trans_idx = np.where(mode[:-1] != mode[1:])[0]                            
      x1_switch = x1[trans_idx[0]] if len(trans_idx) > 0 else None              
                                                                                
      return p1, p2, v1_m1, v1_m2, x1_switch                                    
                                                                                
  # Analyze all available samples                                               
  results = []                                                                  
  for path in DATA_FILE_PATHS:                                                  
      results.append(analyze_sample(path))                                      
                                                                                
  for i, res in enumerate(results):                                             
      print(f"Sample {i}: Mode1 {res[0]}, Mode2 {res[1]}, v1_m1 {res[2]:.2f},   
  v1_m2 {res[3]:.2f}, Switch {res[4]}")                                         
