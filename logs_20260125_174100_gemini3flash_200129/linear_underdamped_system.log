import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dt = 0.01                                                                   
                                                                                
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
    d2x2 = np.gradient(dx2, dt)                                                 
                                                                                
    # Mode identification based on sign of dx1                                  
    # Use a small epsilon to handle numerical noise                             
    modes = np.zeros_like(dx1)                                                  
    modes[dx1 > 0] = 1                                                          
    modes[dx1 < 0] = 2                                                          
                                                                                
    # Identify mode change points                                               
    changes = np.where(np.diff(modes) != 0)[0]                                  
                                                                                
    # Fit ODE: x2'' + a*x2' + b*x2 = c                                          
    def fit_params(mask):                                                       
        if np.sum(mask) < 50: return None                                       
        # Trim to avoid boundary effects of gradient                            
        indices = np.where(mask)[0][10:-10]                                     
        # Y = d2x2, A = [-dx2, -x2, 1]                                          
        A = np.column_stack([-dx2[indices], -x2[indices],                       
np.ones_like(indices)])                                                         
        Y = d2x2[indices]                                                       
        sol, _, _, _ = np.linalg.lstsq(A, Y, rcond=None)                        
        return sol # a, b, c                                                    
                                                                                
    p1 = fit_params(modes == 1)                                                 
    p2 = fit_params(modes == 2)                                                 
                                                                                
    v1_1 = np.mean(dx1[modes == 1])                                             
    v1_2 = np.mean(dx1[modes == 2])                                             
                                                                                
    return {                                                                    
        'x1_range': (np.min(x1), np.max(x1)),                                   
        'switches': x1[changes],                                                
        'p1': p1,                                                               
        'p2': p2,                                                               
        'v1_1': v1_1,                                                           
        'v1_2': v1_2,                                                           
        'changes': changes,                                                     
        'x2': x2,                                                               
        'dx2': dx2                                                              
    }                                                                           
                                                                                
res0 = analyze_sample('data_all/linear/underdamped_system/sample_0.npz')        
print(f"Sample 0: x1 range {res0['x1_range']}")                                 
print(f"Sample 0: x1 at switches {res0['switches']}")                           
