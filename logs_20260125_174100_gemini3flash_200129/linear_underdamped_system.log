import numpy as np                                                              
import pandas as pd                                                             
from scipy.signal import savgol_filter                                          
                                                                                
# Load the first data file                                                      
data = np.load('data_all/linear/underdamped_system/sample_0.npz')               
t = data['t']                                                                   
x = data['x']  # Assuming x has columns for x1 and x2                           
# Let's check the shape and content                                             
print(f"Keys: {list(data.keys())}")                                             
print(f"x shape: {x.shape}")                                                    
print(f"t shape: {t.shape}")                                                    
                                                                                
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
# Calculate numerical derivatives                                               
dt = t[1] - t[0]                                                                
dx1 = np.gradient(x1, dt)                                                       
dx2 = np.gradient(x2, dt)                                                       
d2x2 = np.gradient(dx2, dt)                                                     
                                                                                
# Identify modes                                                                
# Mode 1: x1 increasing (dx1 > 0)                                               
# Mode 2: x1 decreasing (dx1 < 0)                                               
modes = np.where(dx1 > 0, 1, 2)                                                 
                                                                                
# Analyze transitions                                                           
transitions = np.where(np.diff(modes) != 0)[0]                                  
print(f"Transitions indices: {transitions}")                                    
print(f"x1 values at transitions: {x1[transitions]}")                           
                                                                                
# Function to fit ODE: x2'' = -a*x2' - b*x2 + c                                 
def fit_ode(x2_seg, dx2_seg, d2x2_seg):                                         
    # System of equations: d2x2 = [dx2, x2, 1] * [-a, -b, c]^T                  
    A = np.column_stack([-dx2_seg, -x2_seg, np.ones_like(x2_seg)])              
    params, residuals, rank, s = np.linalg.lstsq(A, d2x2_seg, rcond=None)       
    return params # a, b, c                                                     
                                                                                
# Fit for each mode                                                             
results = {}                                                                    
for m in [1, 2]:                                                                
    mask = (modes == m)                                                         
    # Exclude boundary points to avoid gradient artifacts                       
    mask_indices = np.where(mask)[0]                                            
    if len(mask_indices) > 20:                                                  
        # Trim edges                                                            
        mask_indices = mask_indices[5:-5]                                       
        a, b, c = fit_ode(x2[mask_indices], dx2[mask_indices],                  
d2x2[mask_indices])                                                             
        v1 = np.mean(dx1[mask_indices])                                         
        results[m] = {'a': a, 'b': b, 'c': c, 'v1': v1}                         
                                                                                
print("Results per mode:")                                                      
for m, res in results.items():                                                  
    print(f"Mode {m}: a={res['a']:.4f}, b={res['b']:.4f}, c={res['c']:.4f},     
v1={res['v1']:.4f}")                                                            
                                                                                
# Check for resets                                                              
# Look at the state right before and after transitions                          
for trans_idx in transitions[:2]:                                               
    print(f"Transition at index {trans_idx}:")                                  
    print(f"Before: x1={x1[trans_idx]:.4f}, x2={x2[trans_idx]:.4f},             
dx1={dx1[trans_idx]:.4f}")                                                      
    print(f"After: x1={x1[trans_idx+1]:.4f}, x2={x2[trans_idx+1]:.4f},          
dx1={dx1[trans_idx+1]:.4f}")                                                    
                                                                                
