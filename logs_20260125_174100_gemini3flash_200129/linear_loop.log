    samples.append({'x1': state[0, :], 'x2': state[1, :]})                      
                                                                                
# Analyze Sample 0 to find the best threshold                                   
x1_0 = samples[0]['x1']                                                         
x2_0 = samples[0]['x2']                                                         
v2_0, a2_0 = get_ode_data(x2_0, dt)                                             
                                                                                
best_th = 0                                                                     
min_total_error = float('inf')                                                  
# Search for threshold in x1                                                    
for th in np.linspace(x1_0[500], x1_0[-501], 20):                               
    mask1 = x1_0 < th                                                           
    mask2 = x1_0 >= th                                                          
    if np.sum(mask1) > 100 and np.sum(mask2) > 100:                             
        p1, e1 = fit_ode(x2_0[mask1], v2_0[mask1], a2_0[mask1])                 
        p2, e2 = fit_ode(x2_0[mask2], v2_0[mask2], a2_0[mask2])                 
        if e1 + e2 < min_total_error:                                           
            min_total_error = e1 + e2                                           
            best_th = th                                                        
                                                                                
# Refine threshold                                                              
