import numpy as np                                                              
                                                                                
def get_ode_data(y, dt):                                                        
    v = np.gradient(y, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return v, a                                                                 
                                                                                
def fit_ode(y, v, a):                                                           
    # a_accel = -a*v - b*y + c                                                  
    # Y = [a_accel], X = [-v, -y, 1]                                            
    Y = a[10:-10]                                                               
    X = np.column_stack([-v[10:-10], -y[10:-10], np.ones_like(Y)])              
    params, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    mse = residuals[0] / len(Y) if len(residuals) > 0 else np.mean((Y - X @     
params)**2)                                                                     
    return params, mse                                                          
                                                                                
