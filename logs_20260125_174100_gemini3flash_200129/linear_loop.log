import numpy as np                                                              
                                                                                
def fit_all_samples(mask_func):                                                 
    A_list = []                                                                 
    Y1_list = []                                                                
    Y2_list = []                                                                
    for i in range(3):                                                          
        data = np.load(f'data_all/linear/loop/sample_{i}.npz')                  
        state = data['state']                                                   
        x1, x2 = state[0], state[1]                                             
        dt = 0.001                                                              
        dx1 = np.diff(x1) / dt                                                  
        dx2 = np.diff(x2) / dt                                                  
                                                                                
        m = mask_func(x1[:-1], x2[:-1])                                         
        if np.any(m):                                                           
            A_list.append(np.column_stack([x1[:-1][m], x2[:-1][m],              
np.ones(np.sum(m))]))                                                           
            Y1_list.append(dx1[m])                                              
            Y2_list.append(dx2[m])                                              
                                                                                
    A = np.vstack(A_list)                                                       
    Y1 = np.concatenate(Y1_list)                                                
    Y2 = np.concatenate(Y2_list)                                                
                                                                                
    coeffs1, _, _, _ = np.linalg.lstsq(A, Y1, rcond=None)                       
    coeffs2, _, _, _ = np.linalg.lstsq(A, Y2, rcond=None)                       
                                                                                
    return coeffs1, coeffs2                                                     
                                                                                
# Let's try to see if there's a switch at x1 = 5                                
