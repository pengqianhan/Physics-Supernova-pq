print(f"dx1/dt = {c1[0]:.2f}*x1 + {c1[1]:.2f}*x2 + {c1[2]:.2f}")                
print(f"dx2/dt = {c2[0]:.2f}*x1 + {c2[1]:.2f}*x2 + {c2[2]:.2f}")                
                                                                                
print("\nMode 2 (x1 > 5):")                                                     
