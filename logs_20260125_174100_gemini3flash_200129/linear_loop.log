print(f"Is state[:, 0] monotonically increasing? {is_increasing}")              
                                                                                
# If so, define t, x1, x2                                                       
t = state0[:, 0]                                                                
x1 = state0[:, 1]                                                               
x2 = state0[:, 2]                                                               
                                                                                
