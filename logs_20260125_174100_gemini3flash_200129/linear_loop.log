import numpy as np                                                              
                                                                                
def fit_ode_lstsq(x1, x2):                                                      
    dt = 0.001                                                                  
    dx2 = (x2[1:] - x2[:-1]) / dt                                               
    # Target: dx2 = a*x1 + b*x2 + c                                             
    A = np.column_stack([x1[:-1], x2[:-1], np.ones_like(x1[:-1])])              
    # Solve A @ [a, b, c].T = dx2                                               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, dx2, rcond=None)            
                                                                                
    # Calculate R-squared manually                                              
    y_mean = np.mean(dx2)                                                       
    ss_tot = np.sum((dx2 - y_mean)**2)                                          
    pred = np.dot(A, coeffs)                                                    
    ss_res = np.sum((dx2 - pred)**2)                                            
    r_squared = 1 - (ss_res / ss_tot)                                           
                                                                                
    return coeffs, r_squared, pred                                              
                                                                                
