import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
def analyze_file(path):                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    print(f"\nAnalyzing {path}:")                                               
    print(f"State shape: {state.shape}")                                        
                                                                                
    # Plotting                                                                  
    plt.figure(figsize=(12, 4))                                                 
    plt.subplot(1, 2, 1)                                                        
    plt.plot(state[0], label='x1' if state.shape[0] >= 1 else 'N/A')            
    plt.plot(state[1], label='x2' if state.shape[0] >= 2 else 'N/A')            
    plt.title(f'Trajectories in {path}')                                        
    plt.legend()                                                                
                                                                                
    plt.subplot(1, 2, 2)                                                        
    plt.plot(state[0], state[1])                                                
    plt.xlabel('x1')                                                            
    plt.ylabel('x2')                                                            
    plt.title('Phase Plot')                                                     
    plt.show()                                                                  
    plt.savefig(f"{path.replace('/', '_')}.png")                                
                                                                                
for path in ['data_all/linear/loop/sample_0.npz',                               
'data_all/linear/loop/sample_1.npz', 'data_all/linear/loop/sample_2.npz']:      
    analyze_file(path)                                                          
                                                                                
