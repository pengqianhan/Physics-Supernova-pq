import numpy as np                                                              
                                                                                
def fit_first_order(x1, x2, mask):                                              
    dt = 0.001                                                                  
    dx2 = np.diff(x2) / dt                                                      
    A = np.column_stack([x1[:-1][mask[:-1]], x2[:-1][mask[:-1]],                
np.ones_like(x1[:-1][mask[:-1]])])                                              
    Y = dx2[mask[:-1]]                                                          
    coeffs, residuals, rank, s = np.linalg.lstsq(A, Y, rcond=None)              
    y_mean = np.mean(Y)                                                         
    ss_tot = np.sum((Y - y_mean)**2)                                            
    ss_res = np.sum((Y - np.dot(A, coeffs))**2)                                 
    r_squared = 1 - (ss_res / ss_tot)                                           
    return coeffs, r_squared                                                    
                                                                                
data = np.load('data_all/linear/loop/sample_0.npz')                             
state = data['state']                                                           
x1, x2 = state[0], state[1]                                                     
                                                                                
print("Fit for x1 < 5:")                                                        
print(fit_first_order(x1, x2, x1 < 5))                                          
print("Fit for x1 > 6:")                                                        
print(fit_first_order(x1, x2, x1 > 6))                                          
                                                                                
