import numpy as np                                                              
                                                                                
def fit_segment(x1, x2, mask):                                                  
    dt = 0.001                                                                  
    x1_seg = x1[mask]                                                           
    x2_seg = x2[mask]                                                           
    if len(x1_seg) < 10: return None                                            
    dx2 = (x2_seg[1:] - x2_seg[:-1]) / dt                                       
    A = np.column_stack([x1_seg[:-1], x2_seg[:-1], np.ones_like(x1_seg[:-1])])  
    coeffs, residuals, rank, s = np.linalg.lstsq(A, dx2, rcond=None)            
    y_mean = np.mean(dx2)                                                       
    ss_tot = np.sum((dx2 - y_mean)**2)                                          
    pred = np.dot(A, coeffs)                                                    
    ss_res = np.sum((dx2 - pred)**2)                                            
    r_squared = 1 - (ss_res / ss_tot)                                           
    return coeffs, r_squared                                                    
                                                                                
data = np.load('data_all/linear/loop/sample_0.npz')                             
state = data['state']                                                           
x1, x2 = state[0], state[1]                                                     
                                                                                
print("Fitting Sample 0 for x1 < 5:")                                           
print(fit_segment(x1, x2, x1 < 5))                                              
print("Fitting Sample 0 for x1 > 6:")                                           
print(fit_segment(x1, x2, x1 > 6))                                              
                                                                                
