x2={x2[trans_idx]}")                                                            
    print(f"Mode change: {input0[trans_idx]} -> {input0[trans_idx+1]}")         
                                                                                
# 4. Determine ODE parameters for x2                                            
# x2'' + a*x2' + b*x2 = c                                                       
# We need x2, x2', x2''                                                         
def estimate_ode_params(t_segment, x2_segment):                                 
    if len(t_segment) < 10: return None                                         
    dt = t_segment[1] - t_segment[0]                                            
    v2 = np.gradient(x2_segment, dt)                                            
    a2 = np.gradient(v2, dt)                                                    
                                                                                
    # x2'' = -a*x2' - b*x2 + c                                                  
    # Y = [a2], X = [-v2, -x2, 1]                                               
    Y = a2[2:-2]                                                                
    X = np.column_stack([-v2[2:-2], -x2_segment[2:-2], np.ones_like(Y)])        
                                                                                
    params, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    return params # a, b, c                                                     
                                                                                
# Split sample 0 into modes                                                     
if len(transitions) > 0:                                                        
