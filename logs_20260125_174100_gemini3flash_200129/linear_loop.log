import numpy as np                                                              
                                                                                
def get_ode_data(y, dt):                                                        
    v = np.gradient(y, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return v, a                                                                 
                                                                                
def fit_ode(y, v, a):                                                           
    # a_accel = -a*v - b*y + c                                                  
    Y = a[20:-20]                                                               
    X = np.column_stack([-v[20:-20], -y[20:-20], np.ones_like(Y)])              
    params, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    return params                                                               
                                                                                
dt = 0.001                                                                      
samples = []                                                                    
for i in range(3):                                                              
    data = np.load(f'data_all/linear/loop/sample_{i}.npz')                      
    state = data['state']                                                       
    samples.append({'x1': state[0, :], 'x2': state[1, :]})                      
                                                                                
# Assume threshold x1 = 5.0                                                     
threshold = 5.0                                                                 
                                                                                
# Aggregate data for better fitting                                             
x2_m1, v2_m1, a2_m1 = [], [], []                                                
x2_m2, v2_m2, a2_m2 = [], [], []                                                
                                                                                
for s in samples:                                                               
    x1, x2 = s['x1'], s['x2']                                                   
    v2, a2 = get_ode_data(x2, dt)                                               
                                                                                
    mask1 = x1 < threshold                                                      
    mask2 = x1 >= threshold                                                     
                                                                                
    x2_m1.extend(x2[mask1])                                                     
    v2_m1.extend(v2[mask1])                                                     
    a2_m1.extend(a2[mask1])                                                     
                                                                                
    x2_m2.extend(x2[mask2])                                                     
    v2_m2.extend(v2[mask2])                                                     
    a2_m2.extend(a2[mask2])                                                     
                                                                                
p1 = fit_ode(np.array(x2_m1), np.array(v2_m1), np.array(a2_m1))                 
p2 = fit_ode(np.array(x2_m2), np.array(v2_m2), np.array(a2_m2))                 
                                                                                
print(f"Mode 1 params: {p1}")                                                   
print(f"Mode 2 params: {p2}")                                                   
                                                                                
for i, s in enumerate(samples):                                                 
    x1 = s['x1']                                                                
    trans_idx = np.where(x1 >= threshold)[0][0]                                 
    print(f"Sample {i}: Transition at index {trans_idx}, t={trans_idx*dt:.3f},  
x1={x1[trans_idx]:.3f}")                                                        
                                                                                
