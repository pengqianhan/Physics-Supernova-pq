import numpy as np                                                              
                                                                                
def fit_ode_lstsq(x1, x2):                                                      
    dt = 0.001                                                                  
    dx2 = np.diff(x2) / dt                                                      
    # Target: dx2 = a*x1 + b*x2 + c                                             
    A = np.column_stack([x1[:-1], x2[:-1], np.ones_like(x1[:-1])])              
    # Solve A @ [a, b, c].T = dx2                                               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, dx2, rcond=None)            
                                                                                
    # Calculate R-squared manually                                              
    y_mean = np.mean(dx2)                                                       
    ss_tot = np.sum((dx2 - y_mean)**2)                                          
    ss_res = np.sum((dx2 - A @ coeffs)**2)                                      
    r_squared = 1 - (ss_res / ss_tot)                                           
                                                                                
    return coeffs, r_squared, A @ coeffs                                        
                                                                                
for i in range(3):                                                              
    data = np.load(f'data_all/linear/loop/sample_{i}.npz')                      
    state = data['state']                                                       
    x1, x2 = state[0], state[1]                                                 
    coeffs, r2, pred = fit_ode_lstsq(x1, x2)                                    
    print(f"Sample {i}: Coeffs (a, b, c)={coeffs}, R^2={r2}")                   
                                                                                
    # Check residuals across time                                               
    dt = 0.001                                                                  
    dx2 = np.diff(x2) / dt                                                      
    residuals = dx2 - pred                                                      
    # If R^2 is low or residuals are structured, there might be multiple modes. 
    # Plotting residuals (conceptually)                                         
    max_res = np.max(np.abs(residuals))                                         
    print(f"Sample {i}: Max absolute residual={max_res}")                       
                                                                                
# Let's check if the coefficients are similar across samples                    
                                                                                
