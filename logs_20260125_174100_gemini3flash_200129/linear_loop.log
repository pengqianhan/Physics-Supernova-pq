    # Mode 2: after transition                                                  
    params2 = estimate_ode_params(t[trans_idx+1:], x2[trans_idx+1:])            
    print(f"Mode 1 params (a, b, c): {params1}")                                
    print(f"Mode 2 params (a, b, c): {params2}")                                
                                                                                
