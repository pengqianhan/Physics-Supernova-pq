import numpy as np                                                              
from sklearn.cluster import KMeans                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load all files                                                                
all_states = []                                                                 
for path in ['data_all/FaMoS/buck_converter/sample_0.npz',                      
'data_all/FaMoS/buck_converter/sample_1.npz',                                   
'data_all/FaMoS/buck_converter/sample_2.npz']:                                  
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
dt = 0.001                                                                      
all_x = []                                                                      
all_dx = []                                                                     
                                                                                
for state in all_states:                                                        
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Calculate derivatives using finite differences                            
    dx1 = (x1[1:] - x1[:-1]) / dt                                               
    dx2 = (x2[1:] - x2[:-1]) / dt                                               
                                                                                
    # Align states with derivatives (use the state at the beginning of the      
interval)                                                                       
    all_x.append(state[:, :-1].T)                                               
    all_dx.append(np.vstack((dx1, dx2)).T)                                      
                                                                                
X = np.concatenate(all_x, axis=0)                                               
DX = np.concatenate(all_dx, axis=0)                                             
                                                                                
print(f"Total points: {X.shape[0]}")                                            
                                                                                
# Use K-means to identify 2 modes based on derivatives as suggested             
# Derivatives often characterize the modes well in switching systems            
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)                       
labels = kmeans.fit_predict(DX)                                                 
                                                                                
# Check the distribution                                                        
unique, counts = np.unique(labels, return_counts=True)                          
print(f"Clusters: {dict(zip(unique, counts))}")                                 
                                                                                
# Identify which cluster is which                                               
# In buck converters, one mode usually has higher dx1/dt (switch ON) and one    
lower (switch OFF)                                                              
centers = kmeans.cluster_centers_                                               
print(f"Cluster centers (dx1/dt, dx2/dt):\n{centers}")                          
                                                                                
# Store results for each mode                                                   
mode_results = {}                                                               
                                                                                
for mode_id in unique:                                                          
    mask = labels == mode_id                                                    
    X_mode = X[mask]                                                            
    DX_mode = DX[mask]                                                          
                                                                                
    # Fit dx1/dt = a11*x1 + a12*x2 + b1                                         
    reg1 = LinearRegression().fit(X_mode, DX_mode[:, 0])                        
    a11, a12 = reg1.coef_                                                       
    b1 = reg1.intercept_                                                        
                                                                                
    # Fit dx2/dt = a21*x1 + a22*x2 + b2                                         
    reg2 = LinearRegression().fit(X_mode, DX_mode[:, 1])                        
    a21, a22 = reg2.coef_                                                       
    b2 = reg2.intercept_                                                        
                                                                                
    mode_results[mode_id] = {                                                   
        'coeffs': [[a11, a12, b1], [a21, a22, b2]],                             
        'mean_x': np.mean(X_mode, axis=0),                                      
        'score1': reg1.score(X_mode, DX_mode[:, 0]),                            
        'score2': reg2.score(X_mode, DX_mode[:, 1])                             
    }                                                                           
                                                                                
for mode_id, res in mode_results.items():                                       
