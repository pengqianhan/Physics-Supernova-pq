for s in states:                                                                
    dx = (s[1:] - s[:-1]) / dt                                                  
    X_all.append(s[:-1])                                                        
    dX_all.append(dx)                                                           
                                                                                
X = np.vstack(X_all)                                                            
dX = np.vstack(dX_all)                                                          
                                                                                
