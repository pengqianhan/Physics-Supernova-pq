import numpy as np                                                              
import pandas as pd                                                             
from scipy.optimize import curve_fit                                            
                                                                                
# Load the first NPZ file                                                       
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
state = data['state'] # (2, 10001)                                              
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Since dt is not provided, I'll assume dt=1 for the derivative estimation      
# as the coefficients will be scaled by 1/dt anyway.                            
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
x1_mid = x1[:-1]                                                                
x2_mid = x2[:-1]                                                                
                                                                                
# Identify modes based on the sign of dx1                                       
# Mode 1: Rising (dx1 > 0), Mode 2: Falling (dx1 < 0)                           
modes = np.zeros(len(dx1))                                                      
modes[dx1 > 0] = 1                                                              
modes[dx1 < 0] = 2                                                              
                                                                                
# Filter indices for each mode                                                  
idx1 = np.where(modes == 1)[0]                                                  
idx2 = np.where(modes == 2)[0]                                                  
                                                                                
def fit_model(x_mid, y_mid, dot_val):                                           
    # Model: dot = a1*x + a2*y + b                                              
    A = np.vstack([x_mid, y_mid, np.ones(len(x_mid))]).T                        
    coeffs, residuals, rank, s = np.linalg.lstsq(A, dot_val, rcond=None)        
    return coeffs                                                               
                                                                                
# Fit Mode 1                                                                    
coeffs1_x1 = fit_model(x1_mid[idx1], x2_mid[idx1], dx1[idx1])                   
coeffs1_x2 = fit_model(x1_mid[idx1], x2_mid[idx1], dx2[idx1])                   
                                                                                
# Fit Mode 2                                                                    
coeffs2_x1 = fit_model(x1_mid[idx2], x2_mid[idx2], dx1[idx2])                   
coeffs2_x2 = fit_model(x1_mid[idx2], x2_mid[idx2], dx2[idx2])                   
                                                                                
# Identify Guard Conditions                                                     
# Transition 1->2 occurs at peaks of x1                                         
# Transition 2->1 occurs at valleys of x1                                       
peaks = []                                                                      
valleys = []                                                                    
for i in range(1, len(modes)):                                                  
    if modes[i-1] == 1 and modes[i] == 2:                                       
        peaks.append(x1[i])                                                     
    elif modes[i-1] == 2 and modes[i] == 1:                                     
        valleys.append(x1[i])                                                   
                                                                                
guard_1_to_2 = np.mean(peaks) if peaks else None                                
guard_2_to_1 = np.mean(valleys) if valleys else None                            
                                                                                
print("Mode 1 (Rising) x1_dot coeffs:", coeffs1_x1)                             
print("Mode 1 (Rising) x2_dot coeffs:", coeffs1_x2)                             
print("Mode 2 (Falling) x1_dot coeffs:", coeffs2_x1)                            
print("Mode 2 (Falling) x2_dot coeffs:", coeffs2_x2)                            
print("Guard 1->2 (x1 upper limit):", guard_1_to_2)                             
print("Guard 2->1 (x1 lower limit):", guard_2_to_1)                             
                                                                                
