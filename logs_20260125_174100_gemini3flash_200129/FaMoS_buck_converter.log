│     "automaton": {                                                           │
│         "var": "x1, x2",                                                     │
│         "input": "",                                                         │
│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[1\] = -0.5 * x1[0\] + x2[0\], x2[1\] = -0.5 *      │
│ x2[0\]"                                                                      │
│             }                                                                │
│         ],                                                                   │
│         "edge": []                                                           │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.001,                                                         │
│         "total_time": 10.0,                                                  │
│         "order": 1,                                                          │
│         "need_reset": false,                                                 │
│         "non_linear_items": ""                                               │
│     }                                                                        │
│ }                                                                            │
│ ```                                                                          │
