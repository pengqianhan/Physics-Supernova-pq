import numpy as np                                                              
import pandas as pd                                                             
from sklearn.cluster import KMeans                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data from all NPZ files                                                  
all_states = []                                                                 
dt = 0.001                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    if 'state' in data:                                                         
        all_states.append(data['state'])                                        
                                                                                
# Concatenate all trajectory segments                                           
# Assuming state shape is (N, 2)                                                
states = np.vstack(all_states)                                                  
                                                                                
# Calculate derivatives (finite differences)                                    
# dx/dt = (x[t+1] - x[t]) / dt                                                  
# We lose the last point of each sequence if we do it per file,                 
# or we can do it globally if segments are continuous.                          
# Better to do it per segment to avoid artifacts at jumps.                      
derivatives = []                                                                
valid_states = []                                                               
                                                                                
for s in all_states:                                                            
    dx = (s[1:] - s[:-1]) / dt                                                  
    derivatives.append(dx)                                                      
    valid_states.append(s[:-1])                                                 
                                                                                
X_dot = np.vstack(derivatives)                                                  
X = np.vstack(valid_states)                                                     
                                                                                
# Cluster derivatives to identify modes                                         
# Usually buck converters have 2 (ON, OFF) or 3 (if DCM) modes.                 
# Let's try 2 clusters first as requested.                                      
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)                       
labels = kmeans.fit_predict(X_dot)                                              
                                                                                
# Store results for each mode                                                   
modes_results = {}                                                              
                                                                                
for mode in np.unique(labels):                                                  
    mask = (labels == mode)                                                     
    X_mode = X[mask]                                                            
    X_dot_mode = X_dot[mask]                                                    
                                                                                
    # Fit linear models: x_dot = A*x + b                                        
    # x1_dot = a11*x1 + a12*x2 + b1                                             
    # x2_dot = a21*x1 + a22*x2 + b2                                             
                                                                                
    reg1 = LinearRegression().fit(X_mode, X_dot_mode[:, 0])                     
    reg2 = LinearRegression().fit(X_mode, X_dot_mode[:, 1])                     
                                                                                
    modes_results[mode] = {                                                     
        'A': [reg1.coef_, reg2.coef_],                                          
        'B': [reg1.intercept_, reg2.intercept_],                                
        'count': np.sum(mask)                                                   
    }                                                                           
                                                                                
# Guard conditions: find points where label changes                             
guards = []                                                                     
for s_idx, s_data in enumerate(all_states):                                     
    # Re-calculate labels for this segment                                      
    dx_seg = (s_data[1:] - s_data[:-1]) / dt                                    
    labels_seg = kmeans.predict(dx_seg)                                         
                                                                                
    for i in range(len(labels_seg) - 1):                                        
        if labels_seg[i] != labels_seg[i+1]:                                    
            # Transition occurred at state s_data[i+1]                          
            guards.append({                                                     
                'from': labels_seg[i],                                          
                'to': labels_seg[i+1],                                          
                'state': s_data[i+1]                                            
            })                                                                  
                                                                                
# Print findings                                                                
print("Mode coefficients:")                                                     
for m, res in modes_results.items():                                            
    print(f"Mode {m}: A={res['A']}, B={res['B']}")                              
                                                                                
if guards:                                                                      
    guards_df = pd.DataFrame([{'from': g['from'], 'to': g['to'], 'x1':          
g['state'][0], 'x2': g['state'][1]} for g in guards])                           
    print("\nGuard summaries:")                                                 
    print(guards_df.groupby(['from', 'to']).mean())                             
else:                                                                           
    print("\nNo transitions found.")                                            
                                                                                
final_answer({                                                                  
    "modes": modes_results,                                                     
    "guards": guards[:10] if guards else "None found"                           
})                                                                              
                                                                                
