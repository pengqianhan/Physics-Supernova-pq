import numpy as np                                                              
                                                                                
all_x1 = []                                                                     
all_x2 = []                                                                     
all_dx1 = []                                                                    
all_dx2 = []                                                                    
                                                                                
dt = 0.001                                                                      
                                                                                
for path in ['data_all/FaMoS/buck_converter/sample_0.npz',                      
             'data_all/FaMoS/buck_converter/sample_1.npz',                      
             'data_all/FaMoS/buck_converter/sample_2.npz']:                     
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1_val = state[0, :]                                                        
    x2_val = state[1, :]                                                        
                                                                                
    dx1_val = np.diff(x1_val) / dt                                              
    dx2_val = np.diff(x2_val) / dt                                              
                                                                                
    all_x1.append(x1_val[:-1])                                                  
    all_x2.append(x2_val[:-1])                                                  
    all_dx1.append(dx1_val)                                                     
    all_dx2.append(dx2_val)                                                     
                                                                                
x1 = np.concatenate(all_x1)                                                     
x2 = np.concatenate(all_x2)                                                     
dx1 = np.concatenate(all_dx1)                                                   
dx2 = np.concatenate(all_dx2)                                                   
                                                                                
# Identify modes based on derivative sign                                       
# Mode 1: switch ON -> x1 increasing                                            
# Mode 2: switch OFF -> x1 decreasing                                           
mode1_mask = dx1 > 0                                                            
mode2_mask = dx1 < 0                                                            
                                                                                
# Filter middle part to avoid bias: use x1 between -2 and 5.5                   
middle_mask = (x1 > -2) & (x1 < 5.5)                                            
                                                                                
m1_indices = mode1_mask & middle_mask                                           
m2_indices = mode2_mask & middle_mask                                           
                                                                                
def solve_ols(mask):                                                            
    X_reg = np.column_stack([x1[mask], x2[mask], np.ones(np.sum(mask))])        
    Y1 = dx1[mask]                                                              
    Y2 = dx2[mask]                                                              
                                                                                
    sol1 = np.linalg.lstsq(X_reg, Y1, rcond=None)[0]                            
    sol2 = np.linalg.lstsq(X_reg, Y2, rcond=None)[0]                            
    return sol1, sol2                                                           
                                                                                
