import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the first sample to inspect                                              
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
t = data['t']                                                                   
x = data['x'] # Assuming x is of shape (N, 2)                                   
dt = 0.001                                                                      
                                                                                
# Load all data                                                                 
all_x = []                                                                      
all_dx = []                                                                     
                                                                                
for path in ['data_all/FaMoS/buck_converter/sample_0.npz',                      
'data_all/FaMoS/buck_converter/sample_1.npz',                                   
'data_all/FaMoS/buck_converter/sample_2.npz']:                                  
    d = np.load(path)                                                           
    x_val = d['x']                                                              
    # Calculate derivatives: (x[i+1] - x[i]) / dt                               
    dx = np.diff(x_val, axis=0) / dt                                            
    all_x.append(x_val[:-1])                                                    
    all_dx.append(dx)                                                           
                                                                                
X = np.vstack(all_x)                                                            
dX = np.vstack(all_dx)                                                          
                                                                                
# X contains [x1, x2], dX contains [dx1/dt, dx2/dt]                             
# Identify modes.                                                               
# In a buck converter, dx1/dt (di/dt) is usually L*di/dt = Vin - vC (Mode 1) or 
-vC (Mode 2)                                                                    
# Let's check the distribution of dx1 + x2/L? Since L is unknown, let's look at 
dx1 vs x2                                                                       
# dx1 = a11*x1 + a12*x2 + b1. Usually a11=0, a12=-1/L.                          
# So dx1 + (1/L)x2 = b1. b1 is Vin/L or 0.                                      
                                                                                
# Clustering modes based on (dx1, x1, x2)                                       
# A simple way to see the modes is to look at dx1 + some_const * x2             
# Let's try to find the constant by looking at the correlation.                 
# Or just use a simple thresholding if we can see two groups.                   
                                                                                
import matplotlib.pyplot as plt                                                 
# We can't see the plot but we can print some stats                             
print(f"Shape of X: {X.shape}")                                                 
print(f"Min/Max x1: {np.min(X[:,0])}, {np.max(X[:,0])}")                        
                                                                                
# Let's calculate a feature: dx1_plus_x2 = dX[:,0] + x2_term.                   
# If we don't know the term, let's look at dX[:,0] and X[:,1]                   
# For a buck converter, dx1/dt is roughly (V - x2)/L.                           
# So L*dx1 + x2 = V.                                                            
# Let's fit dx1 ~ x2 for segments.                                              
from sklearn.cluster import KMeans                                              
# Usually 2 modes (ON/OFF) or 3 (DCM). Let's try to cluster dX[:,0] and X[:,1]  
features = np.column_stack([dX[:,0], X[:,1]])                                   
kmeans = KMeans(n_clusters=2, random_state=0).fit(features)                     
labels = kmeans.labels_                                                         
                                                                                
print(f"Cluster counts: {np.bincount(labels)}")                                 
                                                                                
# Fit regression for each mode                                                  
def fit_mode(idx):                                                              
    Xi = X[idx]                                                                 
    dXi = dX[idx]                                                               
    reg1 = LinearRegression().fit(Xi, dXi[:,0])                                 
    reg2 = LinearRegression().fit(Xi, dXi[:,1])                                 
    return reg1.coef_, reg1.intercept_, reg2.coef_, reg2.intercept_             
                                                                                
for m in range(2):                                                              
    c1, i1, c2, i2 = fit_mode(labels == m)                                      
    print(f"Mode {m}:")                                                         
    print(f"  dx1/dt = {c1[0]:.4f}*x1 + {c1[1]:.4f}*x2 + {i1:.4f}")             
    print(f"  dx2/dt = {c2[0]:.4f}*x1 + {c2[1]:.4f}*x2 + {i2:.4f}")             
                                                                                
# Transition check: x1 condition?                                               
# Look at the values of X when labels change.                                   
transitions = np.where(labels[:-1] != labels[1:])[0]                            
print(f"Transition points (first 5): {transitions[:5]}")                        
if len(transitions) > 0:                                                        
    print(f"X at transitions: {X[transitions[:5]]}")                            
                                                                                
