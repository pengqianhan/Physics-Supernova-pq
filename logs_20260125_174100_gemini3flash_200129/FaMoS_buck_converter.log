def fit_mode(indices):                                                          
    if len(indices) == 0: return None                                           
    # X = [x1[k], x2[k], 1]                                                     
    # Y1 = x1[k+1], Y2 = x2[k+1]                                                
    X_mat = np.column_stack([x1[indices], x2[indices], np.ones(len(indices))])  
    Y1 = x1[indices+1]                                                          
    Y2 = x2[indices+1]                                                          
                                                                                
    # Solve for x1                                                              
