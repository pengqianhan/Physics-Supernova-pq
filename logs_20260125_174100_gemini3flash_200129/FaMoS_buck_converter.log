import numpy as np                                                              
                                                                                
all_x1 = []                                                                     
all_x2 = []                                                                     
all_dx1 = []                                                                    
all_dx2 = []                                                                    
                                                                                
dt = 0.001                                                                      
                                                                                
for path in ['data_all/FaMoS/buck_converter/sample_0.npz',                      
             'data_all/FaMoS/buck_converter/sample_1.npz',                      
             'data_all/FaMoS/buck_converter/sample_2.npz']:                     
