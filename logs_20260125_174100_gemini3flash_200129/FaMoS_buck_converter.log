import numpy as np                                                              
                                                                                
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1 = state[0, :-1]                                                              
x2 = state[1, :-1]                                                              
dx1 = np.diff(state[0, :])                                                      
                                                                                
# Modes                                                                         
modes = np.zeros(len(dx1))                                                      
modes[dx1 > 1e-3] = 1                                                           
modes[dx1 < -1e-3] = 2                                                          
modes[np.abs(dx1) <= 1e-3] = 3                                                  
                                                                                
transitions = np.where(np.diff(modes) != 0)[0]                                  
                                                                                
for m_from, m_to in [(1, 2), (2, 3), (3, 1)]:                                   
    vals_x1 = []                                                                
    vals_x2 = []                                                                
    for i in transitions:                                                       
        if modes[i] == m_from and modes[i+1] == m_to:                           
            vals_x1.append(x1[i]) # Value in from_mode that triggered the change
            vals_x2.append(x2[i])                                               
    if vals_x1:                                                                 
        print(f"Transition {m_from} -> {m_to}: x1_last = {np.mean(vals_x1):.4f},
x2_last = {np.mean(vals_x2):.4f}")                                              
                                                                                
                                                                                
