import numpy as np                                                              
                                                                                
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    all_states.append(np.load(path)['state'])                                   
states = np.hstack(all_states)                                                  
x1 = states[0, :]                                                               
x2 = states[1, :]                                                               
dx1 = np.diff(x1)                                                               
                                                                                
on_to_off_points = []                                                           
off_to_on_points = []                                                           
                                                                                
for t in range(len(dx1)-1):                                                     
    if dx1[t] > 1e-5 and dx1[t+1] < -1e-5: # Direct ON -> OFF transition        
        on_to_off_points.append((x1[t+1], x2[t+1]))                             
    elif dx1[t] <= 1e-5 and dx1[t+1] > 1e-5: # OFF (or DCM) -> ON transition    
        off_to_on_points.append((x1[t+1], x2[t+1]))                             
                                                                                
on_to_off_points = np.array(on_to_off_points)                                   
off_to_on_points = np.array(off_to_on_points)                                   
                                                                                
print(f"ON->OFF points: {len(on_to_off_points)}")                               
print(f"OFF->ON points: {len(off_to_on_points)}")                               
                                                                                
def fit_guard(pts):                                                             
    if len(pts) == 0: return None                                               
    # Fit line c1*x1 + c2*x2 + c3 = 0                                           
    # Use SVD to find the null space of [x1 x2 1]                               
    A = np.column_stack([pts, np.ones(len(pts))])                               
    u, s, vh = np.linalg.svd(A)                                                 
    return vh[-1, :]                                                            
                                                                                
g_off = fit_guard(on_to_off_points)                                             
g_on = fit_guard(off_to_on_points)                                              
                                                                                
print(f"Guard ON->OFF: {g_off[0]:.4f}*x1 + {g_off[1]:.4f}*x2 + {g_off[2]:.4f} = 
0")                                                                             
print(f"Guard OFF->ON: {g_on[0]:.4f}*x1 + {g_on[1]:.4f}*x2 + {g_on[2]:.4f} = 0")
                                                                                
