import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
dx1 = x1[1:] - x1[:-1]                                                          
dx2 = x2[1:] - x2[:-1]                                                          
x1_k = x1[:-1]                                                                  
x2_k = x2[:-1]                                                                  
                                                                                
# Heuristic labels                                                              
labels = np.zeros_like(dx1, dtype=int)                                          
labels[dx1 > 1.0] = 0  # Charge                                                 
labels[dx1 < -1.0] = 2 # Discharge                                              
labels[np.abs(dx1) <= 1.0] = 1 # Constant                                       
                                                                                
results = []                                                                    
for i in [0, 1, 2]:                                                             
    mask = (labels == i)                                                        
    if np.sum(mask) < 2: continue                                               
                                                                                
    X = np.stack([x1_k[mask], x2_k[mask], np.ones(np.sum(mask))], axis=1)       
    coeffs1, _, _, _ = np.linalg.lstsq(X, dx1[mask], rcond=None)                
    coeffs2, _, _, _ = np.linalg.lstsq(X, dx2[mask], rcond=None)                
                                                                                
    results.append({                                                            
        'mode': i,                                                              
        'A': np.array([coeffs1[:2], coeffs2[:2]]),                              
        'b': np.array([coeffs1[2], coeffs2[2]]),                                
        'points': np.sum(mask),                                                 
        'x1_range': (np.min(x1_k[mask]), np.max(x1_k[mask])),                   
        'x2_range': (np.min(x2_k[mask]), np.max(x2_k[mask]))                    
    })                                                                          
                                                                                
for res in results:                                                             
    name = ["Charge", "Constant", "Discharge"][res['mode']]                     
    print(f"Mode {res['mode']} ({name}):")                                      
    print(f"  A:\n{res['A']}")                                                  
    print(f"  b: {res['b']}")                                                   
    print(f"  x1 range: {res['x1_range']}")                                     
    print(f"  x2 range: {res['x2_range']}")                                     
                                                                                
# Now find the guards.                                                          
# Guard 0->2: When does it stop charging?                                       
# Guard 2->1: When does it stop discharging and go constant?                    
# Guard 1->0: When does it start charging again?                                
                                                                                
# Let's find transitions                                                        
for i in range(len(labels)-1):                                                  
    m_from = labels[i]                                                          
    m_to = labels[i+1]                                                          
    if m_from != m_to:                                                          
        # Check the state at transition                                         
        pass # We will collect these                                            
                                                                                
# Actually, buck converter switches at fixed frequency usually.                 
# But guards are often conditions on states.                                    
# For example, 2->1 (Discharge to Constant) happens when current reaches a      
limit.                                                                          
# 1->0 (Constant to Charge) happens at the next clock cycle.                    
# 0->2 (Charge to Discharge) happens when a control condition is met.           
                                                                                
# Let's collect transition states                                               
trans_states = []                                                               
for i in range(len(labels)-1):                                                  
    if labels[i] != labels[i+1]:                                                
        trans_states.append({'from': labels[i], 'to': labels[i+1], 'x':         
[x1_k[i], x2_k[i]]})                                                            
                                                                                
# Group transitions                                                             
trans_groups = {}                                                               
for ts in trans_states:                                                         
    key = (ts['from'], ts['to'])                                                
    if key not in trans_groups: trans_groups[key] = []                          
    trans_groups[key].append(ts['x'])                                           
                                                                                
for key, pts in trans_groups.items():                                           
    pts = np.array(pts)                                                         
    print(f"Transition {key}: {len(pts)} events")                               
    print(f"  Mean x: {np.mean(pts, axis=0)}")                                  
    print(f"  Std x: {np.std(pts, axis=0)}")                                    
    print(f"  x1 range: [{np.min(pts[:,0])}, {np.max(pts[:,0])}]")              
    print(f"  x2 range: [{np.min(pts[:,1])}, {np.max(pts[:,1])}]")              
                                                                                
                                                                                
