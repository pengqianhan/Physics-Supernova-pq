import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
dx1 = x1[1:] - x1[:-1]                                                          
dx2 = x2[1:] - x2[:-1]                                                          
                                                                                
# Manually implement K-means for 3 clusters on (dx1, dx2)                       
features = np.stack([dx1, dx2], axis=1)                                         
n_samples = features.shape[0]                                                   
n_clusters = 3                                                                  
                                                                                
# Initialize centroids randomly                                                 
np.random.seed(42)                                                              
centroids = features[np.random.choice(n_samples, n_clusters, replace=False)]    
                                                                                
for _ in range(20):                                                             
    # Assign points to nearest centroid                                         
    distances = np.sqrt(((features[:, np.newaxis, :] - centroids[np.newaxis, :, 
:])**2).sum(axis=2))                                                            
    labels = np.argmin(distances, axis=1)                                       
                                                                                
    # Update centroids                                                          
    new_centroids = np.array([features[labels == i].mean(axis=0) if             
np.sum(labels == i) > 0 else centroids[i] for i in range(n_clusters)])          
    if np.allclose(centroids, new_centroids):                                   
        break                                                                   
    centroids = new_centroids                                                   
                                                                                
# Fit models                                                                    
x1_k = x1[:-1]                                                                  
x2_k = x2[:-1]                                                                  
results = []                                                                    
for i in range(3):                                                              
    mask = (labels == i)                                                        
    if np.sum(mask) < 2: continue                                               
                                                                                
    X = np.stack([x1_k[mask], x2_k[mask], np.ones(np.sum(mask))], axis=1)       
    coeffs1, _, _, _ = np.linalg.lstsq(X, dx1[mask], rcond=None)                
    coeffs2, _, _, _ = np.linalg.lstsq(X, dx2[mask], rcond=None)                
                                                                                
    A = np.array([coeffs1[:2], coeffs2[:2]])                                    
    b = np.array([coeffs1[2], coeffs2[2]])                                      
                                                                                
    results.append({'mode': i, 'A': A, 'b': b, 'points': np.sum(mask),          
                    'x1_range': (np.min(x1_k[mask]), np.max(x1_k[mask])),       
                    'x2_range': (np.min(x2_k[mask]), np.max(x2_k[mask])),       
                    'dx1_mean': np.mean(dx1[mask])})                            
                                                                                
# Sort results by dx1_mean to identify Charge (highest), Discharge (middle/low),
and DCM (near zero)                                                             
results.sort(key=lambda x: x['dx1_mean'], reverse=True)                         
                                                                                
for i, res in enumerate(results):                                               
    print(f"Cluster {i} (original {res['mode']}): {res['points']} points")      
    print(f"  dx1 mean: {res['dx1_mean']}")                                     
    print(f"  A:\n{res['A']}")                                                  
    print(f"  b: {res['b']}")                                                   
    print(f"  x1 range: {res['x1_range']}")                                     
    print(f"  x2 range: {res['x2_range']}")                                     
                                                                                
# Look for switching conditions                                                 
# Mode changes happen when labels change. Let's see the transitions.            
transitions = []                                                                
for k in range(len(labels) - 1):                                                
    if labels[k] != labels[k+1]:                                                
        transitions.append((k, labels[k], labels[k+1], x1_k[k], x2_k[k],        
x1_k[k+1], x2_k[k+1]))                                                          
                                                                                
print(f"Number of transitions: {len(transitions)}")                             
print("Sample transitions:")                                                    
for t in transitions[:10]:                                                      
    print(t)                                                                    
                                                                                
