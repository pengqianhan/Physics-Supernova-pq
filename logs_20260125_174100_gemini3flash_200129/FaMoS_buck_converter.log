import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# 1. Load Sample 0 data                                                         
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
t = data['t']                                                                   
x = data['x']  # Assuming x has shape (N, 2)                                    
# dt is assumed constant                                                        
dt = t[1] - t[0]                                                                
                                                                                
# 2. Calculate derivatives: (x[t+1] - x[t]) / dt                                
# Using x[:-1] as the state and dx as the derivative                            
dx = (x[1:] - x[:-1]) / dt                                                      
x_prev = x[:-1]                                                                 
                                                                                
# 3. Identify discrete modes                                                    
# In a buck converter, the switch is either on or off, leading to abrupt changes
in dx1/dt.                                                                      
# Let's visualize or analyze the distribution of dx1/dt to find a threshold.    
dx1 = dx[:, 0]                                                                  
threshold = (np.max(dx1) + np.min(dx1)) / 2                                     
modes = (dx1 > threshold).astype(int) + 1 # Mode 1 and Mode 2                   
                                                                                
# 4. Fit linear models for each mode                                            
results = {}                                                                    
for m in [1, 2]:                                                                
    idx = np.where(modes == m)[0]                                               
    X_train = x_prev[idx] # [x1, x2]                                            
    Y_train = dx[idx]     # [dx1, dx2]                                          
                                                                                
    # x1_dot = a1*x1 + b1*x2 + c1                                               
    # x2_dot = a2*x1 + b2*x2 + c2                                               
    reg1 = LinearRegression().fit(X_train, Y_train[:, 0])                       
    reg2 = LinearRegression().fit(X_train, Y_train[:, 1])                       
                                                                                
    results[f"Mode {m}"] = {                                                    
        "a1": reg1.coef_[0], "b1": reg1.coef_[1], "c1": reg1.intercept_,        
        "a2": reg2.coef_[0], "b2": reg2.coef_[1], "c2": reg2.intercept_         
    }                                                                           
                                                                                
# 5. Identify switching thresholds                                              
# Find transitions in the 'modes' array                                         
transitions_1_to_2 = []                                                         
transitions_2_to_1 = []                                                         
                                                                                
for i in range(len(modes) - 1):                                                 
    if modes[i] == 1 and modes[i+1] == 2:                                       
        transitions_1_to_2.append(x_prev[i+1, 0])                               
    elif modes[i] == 2 and modes[i+1] == 1:                                     
        transitions_2_to_1.append(x_prev[i+1, 0])                               
                                                                                
threshold_1_to_2 = np.mean(transitions_1_to_2) if transitions_1_to_2 else None  
threshold_2_to_1 = np.mean(transitions_2_to_1) if transitions_2_to_1 else None  
                                                                                
print("Model Parameters:", results)                                             
print("Switching Thresholds:", {"1->2": threshold_1_to_2, "2->1":               
threshold_2_to_1})                                                              
                                                                                
