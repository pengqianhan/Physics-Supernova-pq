import numpy as np                                                              
import scipy.linalg                                                             
                                                                                
# 1. Load data                                                                  
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
# Concatenate all trajectories                                                  
states = np.concatenate(all_states, axis=0)                                     
x1 = states[:, 0]                                                               
x2 = states[:, 1]                                                               
dt = 0.001                                                                      
                                                                                
# 2. Calculate derivatives                                                      
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
derivatives = np.column_stack((dx1, dx2))                                       
                                                                                
# 3. Manual KMeans Clustering for 2 modes                                       
def manual_kmeans(data, k=2, max_iters=100):                                    
    # Initialize centroids randomly from data                                   
    np.random.seed(42)                                                          
    indices = np.random.choice(len(data), k, replace=False)                     
    centroids = data[indices]                                                   
                                                                                
    for _ in range(max_iters):                                                  
        # Assign clusters                                                       
        distances = np.linalg.norm(data[:, np.newaxis] - centroids, axis=2)     
        labels = np.argmin(distances, axis=1)                                   
                                                                                
        # Update centroids                                                      
        new_centroids = np.array([data[labels == i].mean(axis=0) for i in       
range(k)])                                                                      
        if np.allclose(centroids, new_centroids):                               
            break                                                               
        centroids = new_centroids                                               
    return labels, centroids                                                    
                                                                                
labels = manual_kmeans(derivatives, k=2)[0]                                     
                                                                                
# 4. Fit linear models for each mode                                            
# Model: x_next = A * x_curr + B                                                
# Using x[1] = a11*x1[0] + a12*x2[0] + b1 etc.                                  
# X_curr = [x1, x2, 1], Y = [x1_next, x2_next]                                  
X_curr = np.column_stack((states[:-1], np.ones(len(states)-1)))                 
X_next = states[1:]                                                             
                                                                                
results = {}                                                                    
for i in range(2):                                                              
    mask = labels == i                                                          
    if np.sum(mask) < 2:                                                        
        continue                                                                
                                                                                
    X_m = X_curr[mask]                                                          
    Y_m = X_next[mask]                                                          
                                                                                
    # Solve X_m * Beta = Y_m                                                    
    # Beta has shape (3, 2)                                                     
    beta, _, _, _ = np.linalg.lstsq(X_m, Y_m, rcond=None)                       
                                                                                
    results[f"Mode {i}"] = {                                                    
        "a11": beta[0, 0], "a12": beta[1, 0], "b1": beta[2, 0],                 
        "a21": beta[0, 1], "a22": beta[1, 1], "b2": beta[2, 1]                  
    }                                                                           
                                                                                
# 5. Determine guard conditions                                                 
# Transitions occur where labels change                                         
transitions = np.where(labels[:-1] != labels[1:])[0]                            
guard_states = states[transitions]                                              
                                                                                
# Characterize guards (e.g., mean value of x1 or x2 at transition)              
if len(guard_states) > 0:                                                       
    mean_guard = np.mean(guard_states, axis=0)                                  
    std_guard = np.std(guard_states, axis=0)                                    
else:                                                                           
    mean_guard = "N/A"                                                          
    std_guard = "N/A"                                                           
                                                                                
print("Results per Mode:")                                                      
for mode, params in results.items():                                            
    print(f"{mode}: {params}")                                                  
print(f"Mean Transition State (Guard): {mean_guard}")                           
print(f"Transition State Std Dev: {std_guard}")                                 
                                                                                
