m0_to_m1_indices = np.where(transitions == 1)[0]                                
m1_to_m0_indices = np.where(transitions == -1)[0]                               
                                                                                
# Use x1 at the moment of transition                                            
m0_to_m1_vals = x1_t[1:][m0_to_m1_indices]                                      
m1_to_m0_vals = x1_t[1:][m1_to_m0_indices]                                      
                                                                                
results['thresholds'] = {                                                       
    'low_to_high_x1': np.mean(m0_to_m1_vals) if len(m0_to_m1_vals) > 0 else     
None,                                                                           
    'high_to_low_x1': np.mean(m1_to_m0_vals) if len(m1_to_m0_vals) > 0 else None
}                                                                               
                                                                                
print("Results identification:")                                                
for mode, params in results.items():                                            
    if mode.startswith('mode'):                                                 
        print(f"\n{mode.upper()}:")                                             
        print(f"  dx1/dt = {params['a1']:.6f}*x1 + {params['b1']:.6f}*x2 +      
{params['c1']:.6f}")                                                            
        print(f"  dx2/dt = {params['a2']:.6f}*x1 + {params['b2']:.6f}*x2 +      
{params['c2']:.6f}")                                                            
                                                                                
print("\nHYSTERETIC THRESHOLDS (x1):")                                          
print(f"  Mode 0 -> Mode 1 (Lower Threshold):                                   
{results['thresholds']['low_to_high_x1']}")                                     
print(f"  Mode 1 -> Mode 0 (Upper Threshold):                                   
{results['thresholds']['high_to_low_x1']}")                                     
                                                                                
# Print raw values for verification                                             
print("\nRaw Thresholds count:")                                                
print(f"  0->1 transitions: {len(m0_to_m1_vals)}")                              
print(f"  1->0 transitions: {len(m1_to_m0_vals)}")                              
                                                                                
