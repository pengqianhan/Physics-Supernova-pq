import numpy as np                                                              
from sklearn.cluster import KMeans                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the first sample to inspect                                              
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Assume a small dt for buck converter simulations if not provided.             
# Typical buck converter frequencies are kHz, so dt might be in microseconds.   
# Since no 't' is provided, I'll use dt=1e-5 as a placeholder for numerical     
differentiation.                                                                
dt = 1e-5                                                                       
                                                                                
# Compute derivatives                                                           
x1_dot = np.gradient(x1, dt)                                                    
x2_dot = np.gradient(x2, dt)                                                    
                                                                                
# Prepare data for clustering: [x1, x2, x1_dot, x2_dot]                         
features = np.vstack([x1, x2, x1_dot, x2_dot]).T                                
                                                                                
# Buck converters typically have 2 or 3 modes. Let's try 2 first.               
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)                       
labels = kmeans.fit_predict(features)                                           
                                                                                
print(f"Cluster counts: {np.bincount(labels)}")                                 
                                                                                
# Fit linear ODE for each mode                                                  
modes = {}                                                                      
for i in range(2):                                                              
    mask = (labels == i)                                                        
    X = np.vstack([x1[mask], x2[mask]]).T                                       
    y1 = x1_dot[mask]                                                           
    y2 = x2_dot[mask]                                                           
                                                                                
    reg1 = LinearRegression().fit(X, y1)                                        
    reg2 = LinearRegression().fit(X, y2)                                        
                                                                                
    modes[i] = {                                                                
        'a11': reg1.coef_[0], 'a12': reg1.coef_[1], 'b1': reg1.intercept_,      
        'a21': reg2.coef_[0], 'a22': reg2.coef_[1], 'b2': reg2.intercept_       
    }                                                                           
                                                                                
print("Mode Parameters:")                                                       
for i, params in modes.items():                                                 
    print(f"Mode {i}: {params}")                                                
                                                                                
# Identify guards - check where labels change                                   
# This is a simplified check for guard conditions                               
guards = []                                                                     
for i in range(len(labels)-1):                                                  
    if labels[i] != labels[i+1]:                                                
        guards.append(features[i, :2])                                          
                                                                                
guards = np.array(guards)                                                       
if len(guards) > 0:                                                             
    print(f"Mean guard state (x1, x2): {np.mean(guards, axis=0)}")              
                                                                                
