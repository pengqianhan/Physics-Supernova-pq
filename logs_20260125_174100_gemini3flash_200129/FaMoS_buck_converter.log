import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
x = data['state']                                                               
x1 = x[0, :]                                                                    
x2 = x[1, :]                                                                    
n = len(x1)                                                                     
dt = 1.0 # Default time step if not provided                                    
                                                                                
# Compute differences                                                           
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
                                                                                
# Identify modes                                                                
modes = np.zeros(n, dtype=int)                                                  
# We have n-1 differences.                                                      
# Let's use a small epsilon for "zero"                                          
eps = 1e-6                                                                      
min_x1 = np.min(x1)                                                             
                                                                                
for i in range(n-1):                                                            
    if x1[i] <= min_x1 + eps:                                                   
        modes[i] = 3                                                            
    elif dx1[i] > eps:                                                          
        modes[i] = 1                                                            
    elif dx1[i] < -eps:                                                         
        modes[i] = 2                                                            
    else:                                                                       
        # If dx1 is 0 but x1 is not min, it might be a peak or something.       
        # But in a buck converter, it's usually increasing or decreasing.       
        modes[i] = modes[i-1] if i > 0 else 1                                   
                                                                                
modes[n-1] = modes[n-2]                                                         
                                                                                
# Let's print the counts of each mode to see if it makes sense                  
unique, counts = np.unique(modes, return_counts=True)                           
print("Mode counts:", dict(zip(unique, counts)))                                
                                                                                
# Now for each mode, collect data for fitting                                   
# dx = A*x + B                                                                  
# [dx1; dx2] = [a1 a2; b1 b2] * [x1; x2] + [a3; b3]                             
                                                                                
def fit_ode(idx_list, x1, x2, dx1, dx2):                                        
    if len(idx_list) < 3:                                                       
        return None                                                             
    # Target vectors                                                            
    Y1 = dx1[idx_list]                                                          
    Y2 = dx2[idx_list]                                                          
    # Feature matrix: [x1, x2, 1]                                               
    X = np.column_stack((x1[idx_list], x2[idx_list], np.ones(len(idx_list))))   
                                                                                
    # Solve X * beta = Y                                                        
    try:                                                                        
        beta1, _, _, _ = np.linalg.lstsq(X, Y1, rcond=None)                     
        beta2, _, _, _ = np.linalg.lstsq(X, Y2, rcond=None)                     
        return beta1, beta2                                                     
    except:                                                                     
        return None                                                             
                                                                                
# We need to match dx[i] with x[i]                                              
# dx1[i] = x1[i+1] - x1[i]                                                      
# So indices for x1, x2 should be 0 to n-2                                      
                                                                                
results = {}                                                                    
for m in [1, 2, 3]:                                                             
    # Find indices where mode is m (limited to n-1)                             
    idx = [i for i in range(n-1) if modes[i] == m]                              
    res = fit_ode(idx, x1, x2, dx1, dx2)                                        
    results[m] = res                                                            
    if res:                                                                     
        print(f"Mode {m} fit:")                                                 
        print(f"  dx1/dt = {res[0][0]:.4f}*x1 + {res[0][1]:.4f}*x2 +            
{res[0][2]:.4f}")                                                               
        print(f"  dx2/dt = {res[1][0]:.4f}*x1 + {res[1][1]:.4f}*x2 +            
{res[1][2]:.4f}")                                                               
                                                                                
# Find transitions                                                              
transitions = []                                                                
for i in range(n-1):                                                            
    if modes[i] != modes[i+1]:                                                  
        transitions.append((i, modes[i], modes[i+1], x1[i], x2[i]))             
                                                                                
print("First few transitions (index, from, to, x1, x2):")                       
for t in transitions[:10]:                                                      
    print(t)                                                                    
                                                                                
