import numpy as np                                                              
                                                                                
# Load Data                                                                     
dt = 0.001                                                                      
all_states = []                                                                 
all_derivs = []                                                                 
trajectories = []                                                               
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    # state is (2, 10001)                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Numerical derivatives (forward difference)                                
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    # Pair states with their derivatives                                        
    X = state[:, :-1].T # (10000, 2)                                            
    dX = np.vstack([dx1, dx2]).T # (10000, 2)                                   
                                                                                
    all_states.append(X)                                                        
    all_derivs.append(dX)                                                       
    trajectories.append((X, dX))                                                
                                                                                
X_all = np.concatenate(all_states, axis=0)                                      
dX_all = np.concatenate(all_derivs, axis=0)                                     
                                                                                
# Clustering - Manual KMeans                                                    
def manual_kmeans(data, k=2, max_iters=20):                                     
    # Initialize centroids using simple min/max of dx1 to ensure separation of  
ON/OFF                                                                          
    c1 = data[np.argmin(data[:, 0])]                                            
    c2 = data[np.argmax(data[:, 0])]                                            
    centroids = np.array([c1, c2])                                              
                                                                                
    for _ in range(max_iters):                                                  
        # Distance to centroids                                                 
        dist = np.linalg.norm(data[:, np.newaxis] - centroids, axis=2)          
        labels = np.argmin(dist, axis=1)                                        
        # Update                                                                
        new_centroids = np.array([data[labels == i].mean(axis=0) for i in       
range(k)])                                                                      
        if np.allclose(centroids, new_centroids):                               
            break                                                               
        centroids = new_centroids                                               
    return labels, centroids                                                    
                                                                                
labels_all, centroids = manual_kmeans(dX_all)                                   
                                                                                
# Fitting ODEs                                                                  
def fit_mode(X, dX):                                                            
    # dXi = [x1, x2, 1] * [a_i1, a_i2, b_i]^T                                   
    A_mat = np.column_stack([X, np.ones(X.shape[0])])                           
    params1, _, _, _ = np.linalg.lstsq(A_mat, dX[:, 0], rcond=None)             
    params2, _, _, _ = np.linalg.lstsq(A_mat, dX[:, 1], rcond=None)             
    return params1, params2                                                     
                                                                                
results = {}                                                                    
for m in range(2):                                                              
    mask = (labels_all == m)                                                    
    p1, p2 = fit_mode(X_all[mask], dX_all[mask])                                
    results[m] = {                                                              
        'a11': p1[0], 'a12': p1[1], 'b1': p1[2],                                
        'a21': p2[0], 'a22': p2[1], 'b2': p2[2]                                 
    }                                                                           
                                                                                
# Identifying Guards                                                            
guards = []                                                                     
for X_traj, dX_traj in trajectories:                                            
    # Use the centroids found globally to label trajectories                    
    dist = np.linalg.norm(dX_traj[:, np.newaxis] - centroids, axis=2)           
    traj_labels = np.argmin(dist, axis=1)                                       
                                                                                
    transitions = np.where(np.diff(traj_labels) != 0)[0]                        
    for idx in transitions:                                                     
        guards.append({                                                         
            'from': traj_labels[idx],                                           
            'to': traj_labels[idx+1],                                           
            'state': X_traj[idx]                                                
        })                                                                      
                                                                                
# Summarizing guards                                                            
guard_stats = {}                                                                
for g in guards:                                                                
    key = (g['from'], g['to'])                                                  
    if key not in guard_stats: guard_stats[key] = []                            
    guard_stats[key].append(g['state'])                                         
                                                                                
final_guards = {}                                                               
for key, vals in guard_stats.items():                                           
    vals = np.array(vals)                                                       
    final_guards[f"{key[0]} to {key[1]}"] = {                                   
        'mean_x1': np.mean(vals[:, 0]),                                         
        'mean_x2': np.mean(vals[:, 1]),                                         
        'std_x1': np.std(vals[:, 0]),                                           
        'std_x2': np.std(vals[:, 1])                                            
    }                                                                           
                                                                                
# Identify which mode is ON (higher b1 usually)                                 
on_mode = 1 if results[1]['b1'] > results[0]['b1'] else 0                       
off_mode = 1 - on_mode                                                          
