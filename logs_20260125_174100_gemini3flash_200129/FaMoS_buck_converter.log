  import numpy as np                                                            
                                                                                
  # Load data and prepare variables                                             
  dt = 0.001                                                                    
  states = []                                                                   
  for i in range(3):                                                            
      data = np.load(f'data_all/FaMoS/buck_converter/sample_{i}.npz')           
      states.append(data['state'].T)                                            
                                                                                
  X_all = []                                                                    
  dX_all = []                                                                   
  for s in states:                                                              
      dx = (s[1:] - s[:-1]) / dt                                                
      X_all.append(s[:-1])                                                      
      dX_all.append(dx)                                                         
                                                                                
  X = np.vstack(X_all)                                                          
  dX = np.vstack(dX_all)                                                        
                                                                                
  # Identify Modes based on dx1 (current derivative)                            
  dx1 = dX[:, 0]                                                                
  x1 = X[:, 0]                                                                  
  x2 = X[:, 1]                                                                  
                                                                                
  # Mode 1: Increasing current                                                  
  mode1_mask = dx1 > 100                                                        
  # Mode 2: Decreasing current                                                  
  mode2_mask = dx1 < -100                                                       
  # Mode 3: Near-zero current derivative (steady state/DCM)                     
  mode3_mask = np.abs(dx1) <= 100                                               
                                                                                
  def get_coeffs(mask):                                                         
      if np.sum(mask) < 2: return [0, 0, 0], [0, 0, 0]                          
      # Solve dx = A*x + B                                                      
      # x is [x1, x2, 1]                                                        
      A_mat = np.column_stack([X[mask], np.ones(np.sum(mask))])                 
      coeffs1 = np.linalg.lstsq(A_mat, dX[mask, 0], rcond=None)[0]              
      coeffs2 = np.linalg.lstsq(A_mat, dX[mask, 1], rcond=None)[0]              
      return coeffs1, coeffs2                                                   
                                                                                
  m1_c1, m1_c2 = get_coeffs(mode1_mask)                                         
  m2_c1, m2_c2 = get_coeffs(mode2_mask)                                         
  m3_c1, m3_c2 = get_coeffs(mode3_mask)                                         
                                                                                
  print("Mode 1 Coeffs x1:", m1_c1)                                             
  print("Mode 1 Coeffs x2:", m1_c2)                                             
  print("Mode 2 Coeffs x1:", m2_c1)                                             
  print("Mode 2 Coeffs x2:", m2_c2)                                             
  print("Mode 3 Coeffs x1:", m3_c1)                                             
  print("Mode 3 Coeffs x2:", m3_c2)                                             
                                                                                
  # Guard identification: 1->2 (peak x1), 2->3 (min x1), 3->1 (min x2)          
  # Let's find the values at transition points                                  
  guards = {"1->2": [], "2->3": [], "3->1": []}                                 
                                                                                
