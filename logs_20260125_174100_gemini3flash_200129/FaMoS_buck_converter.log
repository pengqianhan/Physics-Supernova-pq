# Mode 2 (OFF): dx1 = (-x2 - R*x1)/L, dx2 = (x1 - x2/R_load)/C                  
# Mode 3 (DCM): dx1 = 0, dx2 = -x2/(R_load * C) if x1=0                         
                                                                                
