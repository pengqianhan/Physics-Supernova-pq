x2 = state[:, 1]                                                                
dt = 0.001                                                                      
                                                                                
# Calculate derivatives                                                         
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
                                                                                
# Synchronize data                                                              
x1_f = x1[:-1]                                                                  
x2_f = x2[:-1]                                                                  
features = np.column_stack((x1_f, x2_f, dx1, dx2))                              
                                                                                
# Normalize features for better clustering                                      
mean = features.mean(axis=0)                                                    
std = features.std(axis=0)                                                      
features_scaled = (features - mean) / std                                       
                                                                                
# Cluster with k=2 and k=3                                                      
centroids2, labels2 = simple_kmeans(features_scaled, 2)                         
centroids3, labels3 = simple_kmeans(features_scaled, 3)                         
                                                                                
print(f"Cluster 2 counts: {np.bincount(labels2)}")                              
print(f"Cluster 3 counts: {np.bincount(labels3)}")                              
                                                                                
def fit_linear_model(X, DX, labels, k):                                         
    models = []                                                                 
    for i in range(k):                                                          
        mask = (labels == i)                                                    
        if np.sum(mask) < 5:                                                    
            models.append(None)                                                 
            continue                                                            
                                                                                
        # Solve dx = [x1, x2, 1] @ [a, b, c]^T                                  
        A_mat = np.column_stack((X[mask], np.ones(np.sum(mask))))               
                                                                                
