import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
x1_mid = x1[:-1]                                                                
x2_mid = x2[:-1]                                                                
                                                                                
# Redefine modes with simple thresholding                                       
mean_dx2 = np.mean(dx2)                                                         
mode_mask = dx2 > mean_dx2                                                      
                                                                                
def get_stats(mask, name):                                                      
    # Lengths of continuous segments                                            
    changes = np.diff(mask.astype(int))                                         
    idx_changes = np.where(changes != 0)[0]                                     
    durations = np.diff(np.concatenate(([0], idx_changes, [len(mask)])))        
    return durations                                                            
                                                                                
durations = get_stats(mode_mask, "Modes")                                       
print("Mode durations (indices):", durations[:10])                              
                                                                                
# Average duration for each mode                                                
mode_0_durations = []                                                           
mode_1_durations = []                                                           
current_mode = mode_mask[0]                                                     
count = 0                                                                       
for m in mode_mask:                                                             
    if m == current_mode:                                                       
        count += 1                                                              
    else:                                                                       
        if current_mode:                                                        
            mode_1_durations.append(count)                                      
        else:                                                                   
            mode_0_durations.append(count)                                      
        current_mode = m                                                        
        count = 1                                                               
                                                                                
print("Avg duration Mode 0:", np.mean(mode_0_durations) if mode_0_durations else
0)                                                                              
print("Avg duration Mode 1:", np.mean(mode_1_durations) if mode_1_durations else
0)                                                                              
                                                                                
# Re-fit and check residuals                                                    
def fit_and_error(X, y):                                                        
    A = np.column_stack([X, np.ones(len(X))])                                   
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    mse = np.mean((y - (A @ coeffs))**2)                                        
    return coeffs, mse                                                          
                                                                                
X_all = np.column_stack((x1_mid, x2_mid))                                       
c0_1, e0_1 = fit_and_error(X_all[~mode_mask], dx1[~mode_mask])                  
