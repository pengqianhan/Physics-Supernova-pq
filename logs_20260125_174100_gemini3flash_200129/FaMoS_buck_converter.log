a21, a22, b2 = sol2_m1                                                          
c11, c12, d1 = sol1_m2                                                          
c21, c22, d2 = sol2_m2                                                          
                                                                                
# Steady state calculation: A x + B = 0 => x = -inv(A) * B                      
A1 = np.array([[a11, a12], [a21, a22]])                                         
B1 = np.array([b1, b2])                                                         
x_ss1 = -np.linalg.inv(A1) @ B1                                                 
                                                                                
