import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def get_data_and_modes(states):                                                 
    X = []                                                                      
    dX = []                                                                     
    modes = []                                                                  
                                                                                
    for s in states:                                                            
        x = s[:, :-1]                                                           
        dx = s[:, 1:] - s[:, :-1]                                               
        X.append(x.T)                                                           
        dX.append(dx.T)                                                         
                                                                                
        # Determine modes                                                       
        m = np.zeros(x.shape[1], dtype=int)                                     
        for k in range(x.shape[1]):                                             
            # If x1 increases -> Mode 1                                         
            if dx[0, k] > 1e-5:                                                 
                m[k] = 1                                                        
            # If x1 decreases -> Mode 2                                         
            elif dx[0, k] < -1e-5:                                              
                m[k] = 2                                                        
            # If x1 stays constant -> Mode 3                                    
            else:                                                               
                m[k] = 3                                                        
        modes.append(m)                                                         
                                                                                
    return np.vstack(X), np.vstack(dX), np.concatenate(modes)                   
                                                                                
