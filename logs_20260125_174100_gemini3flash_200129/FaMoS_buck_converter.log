import numpy as np                                                              
                                                                                
def fit_ode(idx_list, x1, x2, dx1, dx2):                                        
    if len(idx_list) < 5: # Need enough points for a good fit                   
        return None                                                             
    Y1 = dx1[idx_list]                                                          
    Y2 = dx2[idx_list]                                                          
    X = np.column_stack((x1[idx_list], x2[idx_list], np.ones(len(idx_list))))   
    beta1, _, _, _ = np.linalg.lstsq(X, Y1, rcond=None)                         
    beta2, _, _, _ = np.linalg.lstsq(X, Y2, rcond=None)                         
    return beta1, beta2                                                         
                                                                                
