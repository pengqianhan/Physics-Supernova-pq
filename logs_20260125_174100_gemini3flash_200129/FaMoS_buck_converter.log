      current_mode = None                                                       
      for j in range(len(s_dx1)):                                               
          d = s_dx1[j]                                                          
          if d > 100: new_mode = 1                                              
          elif d < -100: new_mode = 2                                           
          else: new_mode = 3                                                    
                                                                                
          if current_mode is not None and new_mode != current_mode:             
              # Transition occurred                                             
              if current_mode == 1 and new_mode == 2:                           
                  guards["1->2"].append(s_x1[j])                                
              elif current_mode == 2 and new_mode == 3:                         
                  guards["2->3"].append(s_x1[j])                                
              elif current_mode == 3 and new_mode == 1:                         
                  guards["3->1"].append(s_x2[j])                                
          current_mode = new_mode                                               
                                                                                
  print("1->2 x1 transition values:", np.mean(guards["1->2"]) if                
  guards["1->2"] else None)                                                     
  print("2->3 x1 transition values:", np.mean(guards["2->3"]) if                
