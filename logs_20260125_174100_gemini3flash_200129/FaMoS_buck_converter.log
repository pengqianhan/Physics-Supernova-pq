import numpy as np                                                              
                                                                                
# Load the data                                                                 
file_path = 'data_all/FaMoS/buck_converter/sample_0.npz'                        
data = np.load(file_path)                                                       
t = data['t']                                                                   
x = data['x']  # Assuming x is (N, 2)                                           
dt = t[1] - t[0]                                                                
                                                                                
# Extract state variables                                                       
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
# Calculate derivatives (dx/dt)                                                 
dx1_dt = (x1[1:] - x1[:-1]) / dt                                                
dx2_dt = (x2[1:] - x2[:-1]) / dt                                                
                                                                                
# State variables at time t (to match derivatives)                              
x1_t = x1[:-1]                                                                  
x2_t = x2[:-1]                                                                  
                                                                                
# Identify modes based on dx1/dt                                                
# Buck converter: dx1/dt switches between (Vin - Vout)/L and -Vout/L            
mid_point = (np.max(dx1_dt) + np.min(dx1_dt)) / 2                               
# Mode 1: dx1_dt > mid_point (Charging)                                         
# Mode 0: dx1_dt <= mid_point (Discharging)                                     
modes = (dx1_dt > mid_point).astype(int)                                        
                                                                                
def fit_linear_model(x1_vals, x2_vals, target_vals):                            
    # Fit Y = a*x1 + b*x2 + c                                                   
    A = np.column_stack([x1_vals, x2_vals, np.ones_like(x1_vals)])              
    params, _, _, _ = np.linalg.lstsq(A, target_vals, rcond=None)               
    return params                                                               
                                                                                
results = {}                                                                    
for m in [0, 1]:                                                                
    mask = (modes == m)                                                         
    if np.any(mask):                                                            
        p1 = fit_linear_model(x1_t[mask], x2_t[mask], dx1_dt[mask])             
        p2 = fit_linear_model(x1_t[mask], x2_t[mask], dx2_dt[mask])             
        results[f'mode_{m}'] = {                                                
            'a1': p1[0], 'b1': p1[1], 'c1': p1[2],                              
            'a2': p2[0], 'b2': p2[1], 'c2': p2[2]                               
        }                                                                       
                                                                                
# Hysteretic switching thresholds for x1                                        
# Transitions: Mode 0 -> Mode 1 and Mode 1 -> Mode 0                            
transitions = modes[1:] - modes[:-1]                                            
