  # Load the first sample                                                       
  data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                  
  state = data['state'].T # Transpose to (10001, 2)                             
  print(f"Corrected State shape: {state.shape}")                                
                                                                                
  dt = 0.001                                                                    
  x1 = state[:, 0]                                                              
  x2 = state[:, 1]                                                              
                                                                                
  # Compute time derivatives                                                    
  x1_dot = np.zeros_like(x1)                                                    
  x2_dot = np.zeros_like(x2)                                                    
  x1_dot[1:-1] = (x1[2:] - x1[:-2]) / (2 * dt)                                  
  x2_dot[1:-1] = (x2[2:] - x2[:-2]) / (2 * dt)                                  
  x1_dot[0] = (x1[1] - x1[0]) / dt                                              
  x1_dot[-1] = (x1[-1] - x1[-2]) / dt                                           
  x2_dot[0] = (x2[1] - x2[0]) / dt                                              
  x2_dot[-1] = (x2[-1] - x2[-2]) / dt                                           
                                                                                
  # Clustering (manual K-means)                                                 
  def manual_kmeans_robust(X, k, max_iters=100):                                
      n_samples = X.shape[0]                                                    
      indices = np.random.choice(n_samples, k, replace=False)                   
      centroids = X[indices]                                                    
      for _ in range(max_iters):                                                
          distances = np.sqrt(((X[:, np.newaxis, :] - centroids) **             
  2).sum(axis=2))                                                               
          labels = np.argmin(distances, axis=1)                                 
          new_centroids = np.array([X[labels == i].mean(axis=0) if              
  np.any(labels == i) else X[np.random.randint(n_samples)] for i in range(k)])  
          if np.allclose(centroids, new_centroids): break                       
          centroids = new_centroids                                             
      return labels, centroids                                                  
                                                                                
  features = np.column_stack([x1, x2, x1_dot, x2_dot])                          
  labels, centroids = manual_kmeans_robust(features, 3)                         
                                                                                
  # Mapping Modes                                                               
  # Mode 1: Charging (high x1_dot)                                              
  # Mode 2: Discharging (negative x1_dot)                                       
  # Mode 3: Discontinuous (x1_dot near zero)                                    
  mean_x1_dot = [features[labels == i, 2].mean() for i in range(3)]             
  sorted_modes = np.argsort(mean_x1_dot)                                        
  # sorted_modes: [negative, near-zero, positive] or [negative, positive,       
  near-zero]                                                                    
  # Actually, if DCM exists, x1_dot is 0. If not, it just fluctuates.           
  # Let's map based on mean x1_dot:                                             
  # highest -> Mode 1                                                           
  # lowest -> Mode 2                                                            
  # middle -> Mode 3                                                            
  final_labels = np.zeros_like(labels)                                          
  final_labels[labels == sorted_modes[2]] = 1                                   
  final_labels[labels == sorted_modes[0]] = 2                                   
  final_labels[labels == sorted_modes[1]] = 3                                   
                                                                                
  # Regression                                                                  
  def get_regression(X_data, y_data):                                           
      A = np.column_stack([X_data, np.ones(X_data.shape[0])])                   
      return np.linalg.lstsq(A, y_data, rcond=None)[0]                          
                                                                                
  regs = {}                                                                     
  for m in [1, 2, 3]:                                                           
      idx = final_labels == m                                                   
      if np.sum(idx) > 2:                                                       
          c1 = get_regression(state[idx], x1_dot[idx])                          
          c2 = get_regression(state[idx], x2_dot[idx])                          
          regs[m] = {'a11': c1[0], 'a12': c1[1], 'b1': c1[2], 'a21': c2[0],     
  'a22': c2[1], 'b2': c2[2]}                                                    
                                                                                
  # Transitions                                                                 
  transitions = []                                                              
  for i in range(len(final_labels)-1):                                          
      if final_labels[i] != final_labels[i+1]:                                  
          transitions.append({'from': final_labels[i], 'to':                    
  final_labels[i+1], 'x1': x1[i], 'x2': x2[i], 'i': i})                         
                                                                                
  # Guard identification                                                        
  guards = {}                                                                   
  for target in [(1, 2), (2, 3), (3, 1)]:                                       
      vals = [ [t['x1'], t['x2']] for t in transitions if (t['from'], t['to'])  
  == target ]                                                                   
      if vals:                                                                  
          guards[target] = np.mean(vals, axis=0)                                
                                                                                
  # Reset check                                                                 
  resets = []                                                                   
  for t in transitions:                                                         
      i = t['i']                                                                
      dx1 = x1[i+1] - x1[i]                                                     
      dx2 = x2[i+1] - x2[i]                                                     
      if abs(dx1) > 0.1 or abs(dx2) > 0.1:                                      
          resets.append({'from': t['from'], 'to': t['to'], 'dx1': dx1, 'dx2':   
  dx2})                                                                         
                                                                                
  print("Regression Results:", regs)                                            
  print("Guards:", guards)                                                      
  print("Resets:", resets[:5])                                                  
  print("Sample Transitions:", transitions[:5])                                 
