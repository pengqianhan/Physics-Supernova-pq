import numpy as np                                                              
from sklearn.cluster import KMeans                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Assume dt = 1 for now (derivatives will be scaled)                            
dt = 1.0                                                                        
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
x1_mid = x1[:-1]                                                                
x2_mid = x2[:-1]                                                                
                                                                                
# Feature vector for clustering: [dx1, dx2]                                     
features = np.vstack((dx1, dx2)).T                                              
                                                                                
# Most buck converters have 2 or 3 modes (ON, OFF, and maybe discontinuous      
conduction mode)                                                                
# Let's try clustering with 2 modes first.                                      
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10).fit(features)         
labels = kmeans.labels_                                                         
                                                                                
# Fit linear model for each mode: dx = A*x + B                                  
# dx1 = a1*x1 + b1*x2 + c1                                                      
# dx2 = a2*x1 + b2*x2 + c2                                                      
def fit_linear(X, y):                                                           
    # X: (N, 2) containing x1, x2                                               
    # y: (N,) containing dx                                                     
    A_mat = np.column_stack((X[:, 0], X[:, 1], np.ones(len(X))))                
    coeffs, _, _, _ = np.linalg.lstsq(A_mat, y, rcond=None)                     
    return coeffs                                                               
                                                                                
models = {}                                                                     
for mode in np.unique(labels):                                                  
    mask = labels == mode                                                       
    X_mode = np.column_stack((x1_mid[mask], x2_mid[mask]))                      
    y1_mode = dx1[mask]                                                         
    y2_mode = dx2[mask]                                                         
                                                                                
    coeffs1 = fit_linear(X_mode, y1_mode)                                       
    coeffs2 = fit_linear(X_mode, y2_mode)                                       
    models[mode] = {'dx1': coeffs1, 'dx2': coeffs2}                             
                                                                                
# Transitions                                                                   
transitions = []                                                                
for i in range(len(labels) - 1):                                                
    if labels[i] != labels[i+1]:                                                
        transitions.append({                                                    
            'from': labels[i],                                                  
            'to': labels[i+1],                                                  
            'x1': x1_mid[i],                                                    
            'x2': x2_mid[i],                                                    
            'index': i                                                          
        })                                                                      
                                                                                
print("Models:", models)                                                        
print("Number of transitions:", len(transitions))                               
print("First few transitions:", transitions[:3])                                
                                                                                
