<code>                                                                          
import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# 1. Load data                                                                  
all_states = []                                                                 
dt = 0.001                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    if 'state' in data:                                                         
        all_states.append(data['state'])                                        
                                                                                
# 2. Calculate derivatives and prepare data for clustering and regression       
all_derivs = []                                                                 
all_x_t = []                                                                    
all_x_next = []                                                                 
                                                                                
for s in all_states:                                                            
    # Derivative: (x[t+1] - x[t]) / dt                                          
    dx = (s[1:] - s[:-1]) / dt                                                  
    all_derivs.append(dx)                                                       
    all_x_t.append(s[:-1])                                                      
    all_x_next.append(s[1:])                                                    
                                                                                
X_dot = np.vstack(all_derivs)                                                   
X_t = np.vstack(all_x_t)                                                        
X_next = np.vstack(all_x_next)                                                  
                                                                                
# 3. Manual KMeans Clustering on X_dot                                          
def simple_kmeans(data, k, max_iters=100):                                      
    # Initialize centroids randomly from data                                   
    np.random.seed(42)                                                          
    indices = np.random.choice(data.shape[0], k, replace=False)                 
    centroids = data[indices]                                                   
                                                                                
    for _ in range(max_iters):                                                  
        # Assign clusters                                                       
        distances = np.linalg.norm(data[:, np.newaxis] - centroids, axis=2)     
        labels = np.argmin(distances, axis=1)                                   
                                                                                
        # Update centroids                                                      
        new_centroids = np.array([data[labels == i].mean(axis=0) if             
np.any(labels == i) else centroids[i] for i in range(k)])                       
        if np.allclose(centroids, new_centroids):                               
            break                                                               
        centroids = new_centroids                                               
    return labels, centroids                                                    
                                                                                
# Using 2 modes as typical for buck converters (Switch ON/OFF)                  
labels, centroids = simple_kmeans(X_dot, 2)                                     
                                                                                
# 4. Fit linear ODE model for each mode                                         
# Model: x_next = A * x_t + B                                                   
# Which is x1[1] = a11*x1[0] + a12*x2[0] + b1                                   
#          x2[1] = a21*x1[0] + a22*x2[0] + b2                                   
                                                                                
modes_models = {}                                                               
for mode in range(2):                                                           
    mask = (labels == mode)                                                     
    X_t_m = X_t[mask]                                                           
    X_next_m = X_next[mask]                                                     
                                                                                
    # Prepare Design Matrix [x1, x2, 1]                                         
    ones = np.ones((X_t_m.shape[0], 1))                                         
    A_matrix = np.hstack([X_t_m, ones])                                         
                                                                                
    # Solve for x1[1]                                                           
    coeffs1, _, _, _ = np.linalg.lstsq(A_matrix, X_next_m[:, 0], rcond=None)    
    # Solve for x2[1]                                                           
    coeffs2, _, _, _ = np.linalg.lstsq(A_matrix, X_next_m[:, 1], rcond=None)    
                                                                                
    modes_models[mode] = {                                                      
        'a11': coeffs1[0], 'a12': coeffs1[1], 'b1': coeffs1[2],                 
        'a21': coeffs2[0], 'a22': coeffs2[1], 'b2': coeffs2[2]                  
    }                                                                           
                                                                                
# 5. Guard conditions                                                           
# Observe state values at change points                                         
guards = []                                                                     
current_pos = 0                                                                 
for s in all_states:                                                            
    num_pts = len(s) - 1                                                        
    seg_labels = labels[current_pos : current_pos + num_pts]                    
    for i in range(len(seg_labels) - 1):                                        
        if seg_labels[i] != seg_labels[i+1]:                                    
            # Transition point                                                  
            guards.append({                                                     
                'from': seg_labels[i],                                          
                'to': seg_labels[i+1],                                          
                'x1': s[i+1, 0],                                                
                'x2': s[i+1, 1]                                                 
            })                                                                  
    current_pos += num_pts                                                      
                                                                                
# Summarize guards                                                              
guards_df = pd.DataFrame(guards)                                                
guard_summary = guards_df.groupby(['from', 'to']).agg(['mean',                  
'std']).reset_index()                                                           
                                                                                
print("Mode Models:")                                                           
for m, params in modes_models.items():                                          
    print(f"Mode {m}: {params}")                                                
                                                                                
print("\nGuard Summary:")                                                       
print(guard_summary)                                                            
                                                                                
final_answer({                                                                  
    "ode_models": modes_models,                                                 
    "guard_conditions": guard_summary.to_dict()                                 
})                                                                              
                                                                                
