<code>                                                                          
import numpy as np                                                              
                                                                                
# Load Sample 0 for detailed analysis                                           
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate derivatives (assuming dt=1 as t is not available and coefficients   
are per-step)                                                                   
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
                                                                                
# Identify modes based on the abrupt change in dx1                              
# A buck converter switches Vin on/off, so dx1 + x2/L is either Vin/L or 0.     
# From initial fits, I found L=96, so I use that to cluster.                    
val = dx1 + (1/96) * x2[:-1]                                                    
modes = (val > 0.125).astype(int) # 0.125 is halfway between 0 and 0.25         
                                                                                
# Prepare data for regression                                                   
def fit_mode(m):                                                                
    idx = np.where(modes == m)[0]                                               
    Y = np.stack([dx1[idx], dx2[idx]], axis=1)                                  
    X = np.stack([x1[idx], x2[idx], np.ones(len(idx))], axis=1)                 
    beta = np.linalg.lstsq(X, Y, rcond=None)[0]                                 
    return beta                                                                 
                                                                                
beta_on = fit_mode(1)                                                           
beta_off = fit_mode(0)                                                          
                                                                                
# Detect transition points                                                      
trans_to_off_idx = np.where((modes[:-1] == 1) & (modes[1:] == 0))[0]            
trans_to_on_idx = np.where((modes[:-1] == 0) & (modes[1:] == 1))[0]             
x1_to_off = np.mean(x1[trans_to_off_idx + 1])                                   
x1_to_on = np.mean(x1[trans_to_on_idx + 1])                                     
                                                                                
# Output results                                                                
results = {                                                                     
    "mode_on": beta_on.tolist(),                                                
    "mode_off": beta_off.tolist(),                                              
    "guard_off": x1_to_off,                                                     
    "guard_on": x1_to_on                                                        
}                                                                               
                                                                                
