import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    mode_signal = data['input'].flatten()                                       
                                                                                
    x1 = state[:, 0]                                                            
    x2 = state[:, 1]                                                            
                                                                                
    dt = 0.001                                                                  
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    x1_mid = x1[:-1]                                                            
    x2_mid = x2[:-1]                                                            
    mode_mid = mode_signal[:-1]                                                 
                                                                                
    unique_modes = np.unique(mode_mid)                                          
                                                                                
    mode_results = {}                                                           
    for m in unique_modes:                                                      
        mask = (mode_mid == m)                                                  
        if np.sum(mask) < 10:                                                   
            continue                                                            
                                                                                
        # Design matrix for a*x1 + b*x2 + c                                     
        X = np.column_stack([x1_mid[mask], x2_mid[mask], np.ones(np.sum(mask))])
                                                                                
        # Fit dx1/dt                                                            
        coeffs1, _, _, _ = np.linalg.lstsq(X, dx1[mask], rcond=None)            
        # Fit dx2/dt                                                            
        coeffs2, _, _, _ = np.linalg.lstsq(X, dx2[mask], rcond=None)            
                                                                                
        mode_results[m] = {                                                     
            'dx1': coeffs1,                                                     
            'dx2': coeffs2                                                      
        }                                                                       
                                                                                
    # Thresholds                                                                
    transitions = np.where(np.diff(mode_mid) != 0)[0]                           
    threshold_data = {                                                          
        'x1': x1_mid[transitions],                                              
        'x2': x2_mid[transitions],                                              
        'from_mode': mode_mid[transitions],                                     
        'to_mode': mode_mid[transitions + 1]                                    
    }                                                                           
                                                                                
    return mode_results, threshold_data                                         
                                                                                
