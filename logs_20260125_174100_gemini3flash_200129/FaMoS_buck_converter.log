x2 = state[1, :]                                                                
                                                                                
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
x1_mid = x1[:-1]                                                                
x2_mid = x2[:-1]                                                                
                                                                                
# Mode identification: based on inductor current derivative dx2                 
mean_dx2 = np.mean(dx2)                                                         
mode_mask = dx2 > mean_dx2 # Mode 1: switch ON (increasing current), Mode 0:    
switch OFF                                                                      
                                                                                
def fit_linear_model(X, y):                                                     
    # y = a*x1 + b*x2 + c                                                       
    A = np.column_stack([X, np.ones(len(X))])                                   
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    # Use np.dot instead of @                                                   
    preds = np.dot(A, coeffs)                                                   
    mse = np.mean((y - preds)**2)                                               
    return coeffs, mse                                                          
                                                                                
X_all = np.column_stack((x1_mid, x2_mid))                                       
                                                                                
