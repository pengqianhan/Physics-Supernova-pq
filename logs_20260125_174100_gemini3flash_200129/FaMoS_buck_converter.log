import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
dt = 0.001                                                                      
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
                                                                                
# Identify modes based on dx1/dt                                                
# Threshold for zero                                                            
tol = 1e-5                                                                      
modes = np.zeros_like(dx1)                                                      
modes[dx1 > tol] = 1   # Increasing current                                     
modes[dx1 < -tol] = 2  # Decreasing current                                     
modes[np.abs(dx1) <= tol] = 0 # Discontinuous conduction or similar (current is 
0)                                                                              
                                                                                
x1_mid = x1[:-1]                                                                
x2_mid = x2[:-1]                                                                
                                                                                
# Fit for each mode                                                             
results = {}                                                                    
for m in [0, 1, 2]:                                                             
    mask = (modes == m)                                                         
    if np.sum(mask) < 2:                                                        
        continue                                                                
                                                                                
    # Design matrix [x1, x2, 1]                                                 
    X = np.column_stack([x1_mid[mask], x2_mid[mask], np.ones(np.sum(mask))])    
                                                                                
    # Fit dx1/dt                                                                
    c1, _, _, _ = np.linalg.lstsq(X, dx1[mask], rcond=None)                     
    # Fit dx2/dt                                                                
    c2, _, _, _ = np.linalg.lstsq(X, dx2[mask], rcond=None)                     
                                                                                
    results[m] = {'dx1': c1, 'dx2': c2}                                         
                                                                                
print("Mode Equation Results:")                                                 
for m in results:                                                               
    c1 = results[m]['dx1']                                                      
    c2 = results[m]['dx2']                                                      
    print(f"Mode {m}:")                                                         
    print(f"  dx1/dt = {c1[0]:.4f}*x1 + {c1[1]:.4f}*x2 + {c1[2]:.4f}")          
    print(f"  dx2/dt = {c2[0]:.4f}*x1 + {c2[1]:.4f}*x2 + {c2[2]:.4f}")          
                                                                                
# Guard conditions / switching thresholds                                       
transitions = np.where(np.diff(modes) != 0)[0]                                  
for i in range(min(20, len(transitions))):                                      
