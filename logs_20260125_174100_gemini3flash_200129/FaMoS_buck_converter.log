all_x2 = []                                                                     
all_dx1 = []                                                                    
all_dx2 = []                                                                    
                                                                                
dt = 0.001                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    # state should be (2, N) or (N, 2)                                          
    if state.shape[0] == 2:                                                     
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
    else:                                                                       
        x1 = state[:, 0]                                                        
        x2 = state[:, 1]                                                        
                                                                                
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    all_x1.append(x1[:-1])                                                      
    all_x2.append(x2[:-1])                                                      
    all_dx1.append(dx1)                                                         
    all_dx2.append(dx2)                                                         
                                                                                
# Concatenate all data points                                                   
X1 = np.concatenate(all_x1)                                                     
X2 = np.concatenate(all_x2)                                                     
DX1 = np.concatenate(all_dx1)                                                   
DX2 = np.concatenate(all_dx2)                                                   
                                                                                
# Feature matrix for clustering: (x1, x2, dx1, dx2)                             
features = np.column_stack([X1, X2, DX1, DX2])                                  
                                                                                
# Try clustering into 2 or 3 modes (buck converter usually has 2-3 modes: ON,   
OFF, possibly DCM)                                                              
# Let's start with 2 as requested "at least two discrete modes"                 
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10).fit(features)         
labels = kmeans.labels_                                                         
                                                                                
print("Cluster sizes:", np.bincount(labels))                                    
                                                                                
# Fit linear models for each mode                                               
# Model: dx = A*x + b (or x[k+1] = F*x[k] + g)                                  
# Since the prompt asks for x1[1] = a1*x1[0] + a2*x2[0] + b1, it is looking for 
the discrete time update.                                                       
# Note that x[k+1] = x[k] + dt * dx/dt                                          
# So we can fit the dx/dt or the next state directly.                           
                                                                                
X_next1 = X1 + dt * DX1                                                         
X_next2 = X2 + dt * DX2                                                         
                                                                                
for i in range(2):                                                              
    mask = (labels == i)                                                        
    X_train = np.column_stack([X1[mask], X2[mask]])                             
                                                                                
    # Fit for x1_next                                                           
    reg1 = LinearRegression().fit(X_train, X_next1[mask])                       
    # Fit for x2_next                                                           
    reg2 = LinearRegression().fit(X_train, X_next2[mask])                       
                                                                                
    print(f"Mode {i}:")                                                         
    print(f"  x1_next = {reg1.coef_[0]:.6f}*x1 + {reg1.coef_[1]:.6f}*x2 +       
{reg1.intercept_:.6f}")                                                         
    print(f"  x2_next = {reg2.coef_[0]:.6f}*x1 + {reg2.coef_[1]:.6f}*x2 +       
{reg2.intercept_:.6f}")                                                         
                                                                                
