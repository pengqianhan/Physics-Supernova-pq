    min_x1_m1, max_x1_m1 = np.min(x1_m1), np.max(x1_m1)                         
    if max_x1_m0 < min_x1_m1:                                                   
        guard = f"x1 > {(max_x1_m0 + min_x1_m1)/2:.4f}"                         
    else:                                                                       
        guard = f"x1 < {(max_x1_m1 + min_x1_m0)/2:.4f}"                         
                                                                                
print(results)                                                                  
print("Guard condition:", guard)                                                
                                                                                
