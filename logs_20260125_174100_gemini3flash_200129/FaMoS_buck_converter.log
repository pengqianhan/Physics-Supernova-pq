def analyze_modes(states):                                                      
    X_list = []                                                                 
    dX_list = []                                                                
    modes_list = []                                                             
                                                                                
    for s in states:                                                            
        x = s[:, :-1]                                                           
        dx = s[:, 1:] - s[:, :-1]                                               
        X_list.append(x.T)                                                      
        dX_list.append(dx.T)                                                    
                                                                                
        m = np.zeros(x.shape[1], dtype=int)                                     
        for k in range(x.shape[1]):                                             
            # Heuristic for buck converter:                                     
            # Mode 1: x1 increasing                                             
            # Mode 2: x1 decreasing                                             
            # Mode 3: x1 constant (DCM)                                         
            if dx[0, k] > 1e-4:                                                 
                m[k] = 1                                                        
            elif dx[0, k] < -1e-4:                                              
                m[k] = 2                                                        
            else:                                                               
                m[k] = 3                                                        
        modes_list.append(m)                                                    
                                                                                
    X_all = np.vstack(X_list)                                                   
    dX_all = np.vstack(dX_list)                                                 
    modes_all = np.concatenate(modes_list)                                      
                                                                                
    results = {}                                                                
    for mode in [1, 2, 3]:                                                      
        idx = (modes_all == mode)                                               
        if np.sum(idx) > 0:                                                     
            X_m = X_all[idx]                                                    
            dX_m = dX_all[idx]                                                  
            # Solve dx = [x1 x2 1] * [A11 A21; A12 A22; B1 B2]                  
            # Design matrix M = [X_m, ones]                                     
            M = np.hstack([X_m, np.ones((X_m.shape[0], 1))])                    
            # Sol = (M^T M)^-1 M^T dX_m                                         
            sol, resid, rank, s = np.linalg.lstsq(M, dX_m, rcond=None)          
            A = sol[:2, :].T                                                    
            B = sol[2, :]                                                       
            results[mode] = {'A': A, 'B': B, 'error': resid}                    
            print(f"Mode {mode}:")                                              
            print(f"  A:\n{A}")                                                 
            print(f"  B: {B}")                                                  
                                                                                
    return results, modes_list                                                  
                                                                                
