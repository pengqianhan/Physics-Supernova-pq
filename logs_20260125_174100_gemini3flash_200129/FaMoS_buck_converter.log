<code>                                                                          
import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
from sklearn.cluster import KMeans                                              
                                                                                
# Load all data                                                                 
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
# Combine states for analysis                                                   
# state shape is (2, 10001)                                                     
# We want (N, 2)                                                                
X_list = []                                                                     
Y_list = []                                                                     
                                                                                
for state in all_states:                                                        
    # x(k)                                                                      
    X_curr = state[:, :-1].T                                                    
    # x(k+1)                                                                    
    X_next = state[:, 1:].T                                                     
    X_list.append(X_curr)                                                       
    Y_list.append(X_next)                                                       
                                                                                
X = np.vstack(X_list)                                                           
Y = np.vstack(Y_list)                                                           
                                                                                
# To identify modes, let's look at the differences (approx derivatives)         
# Or better, look at the transition map X_next = f(X_curr)                      
# Diff = X_next - X_curr                                                        
Diff = Y - X                                                                    
                                                                                
# Buck converters typically have a few discrete modes.                          
# Let's try to cluster the (X_curr, Diff) or just Diff to find modes.           
# Actually, modes in a buck converter are defined by the derivatives.           
# Let's use KMeans on the derivatives to see if modes separate.                 
from sklearn.preprocessing import StandardScaler                                
scaler = StandardScaler()                                                       
diff_scaled = scaler.fit_transform(Diff)                                        
                                                                                
# Let's try 3 modes (On, Off, maybe DCM)                                        
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)                       
labels = kmeans.fit_predict(diff_scaled)                                        
                                                                                
print("Cluster sizes:", np.bincount(labels))                                    
                                                                                
# Now for each cluster, perform linear regression                               
models = {}                                                                     
for i in range(3):                                                              
    mask = (labels == i)                                                        
    if np.sum(mask) < 10: continue                                              
                                                                                
    X_mode = X[mask]                                                            
    Y_mode = Y[mask]                                                            
                                                                                
    # x1_next = a11*x1 + a12*x2 + b1                                            
    # x2_next = a21*x1 + a22*x2 + b2                                            
    reg1 = LinearRegression().fit(X_mode, Y_mode[:, 0])                         
    reg2 = LinearRegression().fit(X_mode, Y_mode[:, 1])                         
                                                                                
    models[i] = {                                                               
        'a11': reg1.coef_[0], 'a12': reg1.coef_[1], 'b1': reg1.intercept_,      
        'a21': reg2.coef_[0], 'a22': reg2.coef_[1], 'b2': reg2.intercept_,      
        'score1': reg1.score(X_mode, Y_mode[:, 0]),                             
        'score2': reg2.score(X_mode, Y_mode[:, 1])                              
    }                                                                           
                                                                                
print("Models identified:", models)                                             
                                                                                
# Check for switching conditions (guards)                                       
# Transitions occur when labels[k] != labels[k+1]                               
transitions = []                                                                
for state in all_states:                                                        
    X_s = state[:, :-1].T                                                       
    D_s = state[:, 1:].T - X_s                                                  
    D_scaled = scaler.transform(D_s)                                            
    L = kmeans.predict(D_scaled)                                                
                                                                                
    for k in range(len(L)-1):                                                   
        if L[k] != L[k+1]:                                                      
            transitions.append({                                                
                'from': L[k],                                                   
                'to': L[k+1],                                                   
                'state': X_s[k+1], # State at transition                        
                'next_state': state[:, k+2] if k+2 < state.shape[1] else None   
            })                                                                  
                                                                                
print("Number of transitions detected:", len(transitions))                      
                                                                                
