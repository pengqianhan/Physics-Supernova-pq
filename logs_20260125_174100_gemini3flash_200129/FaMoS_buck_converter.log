    all_x.append(x_val[:-1])                                                    
    all_dx.append(dx)                                                           
                                                                                
X = np.vstack(all_x)                                                            
dX = np.vstack(all_dx)                                                          
                                                                                
# Simple KMeans implementation for clustering modes                             
def simple_kmeans(data, k, iters=10):                                           
    centers = data[np.random.choice(data.shape[0], k, replace=False)]           
    for _ in range(iters):                                                      
        dists = np.linalg.norm(data[:, np.newaxis] - centers, axis=2)           
        labels = np.argmin(dists, axis=1)                                       
        for i in range(k):                                                      
            if np.any(labels == i):                                             
                centers[i] = data[labels == i].mean(axis=0)                     
    return labels                                                               
                                                                                
# Feature for clustering: dx1/dt depends on Vin and x2.                         
# In a buck converter, L*dx1/dt + x2 + R*x1 is either Vin or 0.                 
# We'll use (dx1, x1, x2) as features.                                          
features = np.column_stack([dX[:, 0], X])                                       
labels = simple_kmeans(features, 2)                                             
                                                                                
def fit_linear_model(X_sub, Y_sub):                                             
    # Add bias term                                                             
    A_ext = np.column_stack([X_sub, np.ones(X_sub.shape[0])])                   
    # Solve (A_ext^T * A_ext) * beta = A_ext^T * Y_sub                          
    beta, residuals, rank, s = np.linalg.lstsq(A_ext, Y_sub, rcond=None)        
    return beta[:2], beta[2]                                                    
                                                                                
# Fit for each mode                                                             
modes_params = []                                                               
for m in range(2):                                                              
    mask = (labels == m)                                                        
    X_m = X[mask]                                                               
    dX1_m = dX[mask, 0]                                                         
    dX2_m = dX[mask, 1]                                                         
                                                                                
    a1, b1 = fit_linear_model(X_m, dX1_m)                                       
    a2, b2 = fit_linear_model(X_m, dX2_m)                                       
                                                                                
    # Identify mode by its constant input (b1)                                  
    # Mode 1: PWM ON (Vin/L > 0), Mode 2: PWM OFF (0)                           
    modes_params.append({                                                       
        'id': m,                                                                
        'A': np.array([a1, a2]),                                                
        'B': np.array([b1, b2])                                                 
    })                                                                          
                                                                                
# Check for a 3rd mode (DCM: x1 = 0)                                            
dcm_mask = (X[:, 0] < 1e-3) & (np.abs(dX[:, 0]) < 1e-2)                         
if np.sum(dcm_mask) > 0.05 * len(X):                                            
    num_modes = 3                                                               
else:                                                                           
    num_modes = 2                                                               
                                                                                
# Sort modes by b1 (Mode 1 is ON, Mode 2 is OFF)                                
modes_params.sort(key=lambda x: x['B'][0], reverse=True)                        
                                                                                
# Transition logic analysis                                                     
# Usually transitions occur at specific duty cycles or state boundaries.        
# For a standard buck converter, the controller switches ON/OFF to regulate.    
# If DCM, Mode 3 starts when x1 hits 0.                                         
guard = "Transitions are likely governed by a PWM duty cycle (time-based) or a  
hysteresis controller on x2."                                                   
if num_modes == 3:                                                              
    guard += " Mode 3 (DCM) is active when current x1 reaches 0."               
                                                                                
# Prepare output                                                                
results = []                                                                    
for i, m in enumerate(modes_params):                                            
    results.append(f"Mode {i+1} (PWM {'ON' if i==0 else 'OFF'}):")              
    results.append(f"  A = {m['A'].tolist()}")                                  
    results.append(f"  B = {m['B'].tolist()}")                                  
                                                                                
final_answer(                                                                   
    f"### 1. Task outcome (short version):\n"                                   
