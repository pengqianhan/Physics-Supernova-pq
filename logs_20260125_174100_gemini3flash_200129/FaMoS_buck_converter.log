  import numpy as np                                                            
  import pandas as pd                                                           
  from sklearn.linear_model import LinearRegression                             
                                                                                
  # Load data                                                                   
  data_0 = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                
  x = data_0['x'] # Shape usually (N, 2)                                        
  dt = 0.001                                                                    
                                                                                
  # Calculate derivatives using central difference or forward difference        
  # Given the task description, forward difference is usually sufficient for    
  trajectory analysis                                                           
  x1 = x[:, 0]                                                                  
  x2 = x[:, 1]                                                                  
  x1_dot = np.gradient(x1, dt)                                                  
  x2_dot = np.gradient(x2, dt)                                                  
                                                                                
  # Identify Modes                                                              
  # Mode 1: Switch ON (x1 increasing) -> x1_dot > threshold                     
  # Mode 2: Switch OFF (x1 decreasing) -> x1_dot < -threshold                   
  # Mode 3: DCM (x1 ~ 0)                                                        
  # Let's refine the thresholds based on the data                               
  modes = np.zeros(len(x1))                                                     
  for i in range(len(x1)):                                                      
      if abs(x1[i]) < 0.1 and abs(x1_dot[i]) < 5: # DCM                         
          modes[i] = 3                                                          
      elif x1_dot[i] > 0:                                                       
          modes[i] = 1                                                          
      else:                                                                     
          modes[i] = 2                                                          
                                                                                
  # Fit linear dynamics for each mode                                           
  results = {}                                                                  
  for m in [1, 2, 3]:                                                           
      mask = (modes == m)                                                       
      if np.sum(mask) > 10:                                                     
          X = np.column_stack([x1[mask], x2[mask]])                             
          y1 = x1_dot[mask]                                                     
          y2 = x2_dot[mask]                                                     
                                                                                
          reg1 = LinearRegression().fit(X, y1)                                  
          reg2 = LinearRegression().fit(X, y2)                                  
                                                                                
          results[m] = {                                                        
              'a1': reg1.coef_[0], 'a2': reg1.coef_[1], 'bias_a':               
  reg1.intercept_,                                                              
              'b1': reg2.coef_[0], 'b2': reg2.coef_[1], 'bias_b':               
  reg2.intercept_                                                               
          }                                                                     
                                                                                
  # Determine Guard Conditions                                                  
  # 1 -> 2: Switch ON to OFF (Peak x1)                                          
  # 2 -> 3: Switch OFF to DCM (x1 hits 0 or lower bound)                        
  # 3 -> 1: DCM back to ON                                                      
  guards = {}                                                                   
  # Transition 1->2 occurs when mode changes from 1 to 2                        
  idx_1to2 = np.where((modes[:-1] == 1) & (modes[1:] == 2))[0]                  
  if len(idx_1to2) > 0:                                                         
      guards['1->2'] = np.mean(x1[idx_1to2])                                    
                                                                                
  idx_2to3 = np.where((modes[:-1] == 2) & (modes[1:] == 3))[0]                  
  if len(idx_2to3) > 0:                                                         
      guards['2->3'] = np.mean(x1[idx_2to3])                                    
                                                                                
  idx_3to1 = np.where((modes[:-1] == 3) & (modes[1:] == 1))[0]                  
  if len(idx_3to1) > 0:                                                         
      guards['3->1'] = np.mean(x2[idx_3to1])                                    
                                                                                
  print("Results:", results)                                                    
  print("Guards:", guards)                                                      
