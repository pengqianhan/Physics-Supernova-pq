```python                                                                       
import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    x = data['state']                                                           
    x1 = x[0, :]                                                                
    x2 = x[1, :]                                                                
    n = len(x1)                                                                 
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    # Identify modes more robustly                                              
    # Mode 1: dx1 > threshold                                                   
    # Mode 2: dx1 < -threshold                                                  
    # Mode 3: dx1 approx 0 and x1 is small                                      
                                                                                
    # Let's use a threshold based on the distribution of dx1                    
    std_dx1 = np.std(dx1)                                                       
    threshold = 0.1 * std_dx1                                                   
                                                                                
    modes = np.zeros(n, dtype=int)                                              
    for i in range(n-1):                                                        
        if abs(dx1[i]) < threshold:                                             
            modes[i] = 3                                                        
        elif dx1[i] > 0:                                                        
            modes[i] = 1                                                        
        else:                                                                   
            modes[i] = 2                                                        
    modes[n-1] = modes[n-2]                                                     
    return x1, x2, dx1, dx2, modes                                              
                                                                                
# Use sample 0                                                                  
x1, x2, dx1, dx2, modes =                                                       
analyze_sample('data_all/FaMoS/buck_converter/sample_0.npz')                    
                                                                                
# Fit models                                                                    
# ... (same as before)                                                          
