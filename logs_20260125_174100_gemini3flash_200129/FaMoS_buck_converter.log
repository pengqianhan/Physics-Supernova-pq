    state = data['state']                                                       
    x1_val = state[0, :]                                                        
    x2_val = state[1, :]                                                        
                                                                                
    dx1_val = np.diff(x1_val) / dt                                              
    dx2_val = np.diff(x2_val) / dt                                              
                                                                                
    # Identify segments                                                         
    mode = np.zeros(len(dx1_val))                                               
    mode[dx1_val > 0] = 1                                                       
    mode[dx1_val < 0] = 2                                                       
                                                                                
    # Find transitions                                                          
    changes = np.where(np.diff(mode) != 0)[0]                                   
    start = 0                                                                   
    for change in changes:                                                      
        end = change                                                            
        if mode[start] != 0:                                                    
            m = mode[start]                                                     
            segment_x1 = x1_val[start:end]                                      
            segment_x2 = x2_val[start:end]                                      
            segment_dx1 = dx1_val[start:end]                                    
            segment_dx2 = dx2_val[start:end]                                    
                                                                                
            # Keep middle 60%                                                   
            n = len(segment_x1)                                                 
            if n > 5:                                                           
                s, e = int(0.2*n), int(0.8*n)                                   
