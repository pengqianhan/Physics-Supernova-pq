def fit_ode(mask, x1, x2, dx1, dx2):                                            
    if np.sum(mask) == 0:                                                       
        return None                                                             
    X = np.column_stack([x1[mask], x2[mask], np.ones(np.sum(mask))])            
                                                                                
    # Solve dx1 = X * coeffs1                                                   
    coeffs1, _, _, _ = np.linalg.lstsq(X, dx1[mask], rcond=None)                
    # Solve dx2 = X * coeffs2                                                   
    coeffs2, _, _, _ = np.linalg.lstsq(X, dx2[mask], rcond=None)                
                                                                                
    return coeffs1, coeffs2                                                     
                                                                                
