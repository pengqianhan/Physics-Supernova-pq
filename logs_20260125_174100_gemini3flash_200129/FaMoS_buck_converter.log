  import numpy as np                                                            
  from sklearn.cluster import KMeans                                            
  from sklearn.linear_model import LinearRegression                             
                                                                                
  # 1. Load data                                                                
  dt = 0.001                                                                    
  all_x = []                                                                    
  all_dx = []                                                                   
  trajectories = []                                                             
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      state = data['state']                                                     
      x1 = state[0, :]                                                          
      x2 = state[1, :]                                                          
                                                                                
      # Calculate derivatives                                                   
      dx1 = np.diff(x1) / dt                                                    
      dx2 = np.diff(x2) / dt                                                    
                                                                                
      # States corresponding to the derivatives                                 
      x1_in = x1[:-1]                                                           
      x2_in = x2[:-1]                                                           
                                                                                
      X = np.stack([x1_in, x2_in], axis=1)                                      
      dX = np.stack([dx1, dx2], axis=1)                                         
                                                                                
      all_x.append(X)                                                           
      all_dx.append(dX)                                                         
      trajectories.append((X, dX))                                              
                                                                                
  # Combine for clustering                                                      
  X_all = np.concatenate(all_x, axis=0)                                         
  dX_all = np.concatenate(all_dx, axis=0)                                       
                                                                                
  # 2. Identify modes by clustering derivative data                             
  # Typically buck converters have 2 main modes (ON/OFF)                        
  kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)                     
  labels_all = kmeans.fit_predict(dX_all)                                       
                                                                                
  # 3. Fit linear ODE models for each mode                                      
  modes_info = {}                                                               
  for mode in range(2):                                                         
      mask = (labels_all == mode)                                               
      X_mode = X_all[mask]                                                      
      dX_mode = dX_all[mask]                                                    
                                                                                
      # Fit dx1 = a11*x1 + a12*x2 + b1                                          
      reg1 = LinearRegression().fit(X_mode, dX_mode[:, 0])                      
      # Fit dx2 = a21*x1 + a22*x2 + b2                                          
      reg2 = LinearRegression().fit(X_mode, dX_mode[:, 1])                      
                                                                                
      modes_info[mode] = {                                                      
          'a11': reg1.coef_[0], 'a12': reg1.coef_[1], 'b1': reg1.intercept_,    
          'a21': reg2.coef_[0], 'a22': reg2.coef_[1], 'b2': reg2.intercept_     
      }                                                                         
                                                                                
  # 4. Determine guard conditions                                               
  # Look at the transitions in individual trajectories                          
  guards = []                                                                   
  for i, (X_traj, dX_traj) in enumerate(trajectories):                          
      labels_traj = kmeans.predict(dX_traj)                                     
      diff_labels = np.diff(labels_traj)                                        
      change_indices = np.where(diff_labels != 0)[0]                            
                                                                                
      for idx in change_indices:                                                
          guards.append({                                                       
              'from_mode': labels_traj[idx],                                    
              'to_mode': labels_traj[idx+1],                                    
              'x1': X_traj[idx, 0],                                             
              'x2': X_traj[idx, 1]                                              
          })                                                                    
                                                                                
  # Summarize guards                                                            
  # Often buck converters switch based on a clock (time) or a threshold on      
  voltage/current.                                                              
  # Let's see the range of values for guards.                                   
  x1_guards = [g['x1'] for g in guards]                                         
  x2_guards = [g['x2'] for g in guards]                                         
                                                                                
  print("Mode Parameters:")                                                     
  for m, params in modes_info.items():                                          
      print(f"Mode {m}: {params}")                                              
                                                                                
  print(f"Guard X1 range: {min(x1_guards):.4f} to {max(x1_guards):.4f}")        
