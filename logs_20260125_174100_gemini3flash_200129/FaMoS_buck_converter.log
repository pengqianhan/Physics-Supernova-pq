import numpy as np                                                              
                                                                                
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
state = data['state']                                                           
x1 = state[0, :-1]                                                              
x2 = state[1, :-1]                                                              
dx1 = np.diff(state[0, :])                                                      
dx2 = np.diff(state[1, :])                                                      
                                                                                
# Try to find k such that dx2 + k*x1 is piecewise constant                      
# We can minimize the variance within clusters for a given k.                   
best_k = 0                                                                      
min_var = float('inf')                                                          
                                                                                
for k in np.linspace(0, 1, 100):                                                
    val = dx2 + k*x1                                                            
    # We expect two modes. Let's use the variance of two clusters.              
    # Simple way: sort and find the split point that minimizes sum of variances.
    sorted_val = np.sort(val)                                                   
    # This is a bit slow. Let's just use a few split points.                    
    n = len(sorted_val)                                                         
    vars = []                                                                   
    for split in [n//4, n//2, 3*n//4]:                                          
        vars.append(np.var(sorted_val[:split]) + np.var(sorted_val[split:]))    
    total_var = np.min(vars)                                                    
    if total_var < min_var:                                                     
        min_var = total_var                                                     
        best_k = k                                                              
                                                                                
print("Best k (1/L):", best_k)                                                  
                                                                                
# Now with best_k, let's look at the distribution of dx2 + best_k * x1          
