import numpy as np                                                              
from scipy.cluster.vq import kmeans2                                            
                                                                                
# Load the data                                                                 
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate differences                                                         
dx1 = x1[1:] - x1[:-1]                                                          
dx2 = x2[1:] - x2[:-1]                                                          
x1_k = x1[:-1]                                                                  
x2_k = x2[:-1]                                                                  
                                                                                
# Feature vector for clustering: (dx1, dx2)                                     
# Often the derivatives are the most telling for the mode                       
features = np.stack([dx1, dx2], axis=1)                                         
# Normalize features for better clustering                                      
feat_mean = np.mean(features, axis=0)                                           
feat_std = np.std(features, axis=0)                                             
features_norm = (features - feat_mean) / feat_std                               
                                                                                
# We expect 3 modes                                                             
centroids, labels = kmeans2(features_norm, 3, iter=20, minit='points', seed=42) 
                                                                                
# Analyze each cluster                                                          
results = []                                                                    
for i in range(3):                                                              
    mask = (labels == i)                                                        
    X = np.stack([x1_k[mask], x2_k[mask], np.ones(np.sum(mask))], axis=1)       
                                                                                
    # Fit dx1 = a11*x1 + a12*x2 + b1                                            
    # Fit dx2 = a21*x1 + a22*x2 + b2                                            
    coeffs1, resid1, _, _ = np.linalg.lstsq(X, dx1[mask], rcond=None)           
    coeffs2, resid2, _, _ = np.linalg.lstsq(X, dx2[mask], rcond=None)           
                                                                                
    A = np.array([coeffs1[:2], coeffs2[:2]])                                    
    b = np.array([coeffs1[2], coeffs2[2]])                                      
    results.append({'mode': i, 'A': A, 'b': b, 'points': np.sum(mask),          
                    'x1_min': np.min(x1_k[mask]), 'x1_max': np.max(x1_k[mask]), 
                    'x2_min': np.min(x2_k[mask]), 'x2_max': np.max(x2_k[mask])})
                                                                                
for res in results:                                                             
    print(f"Mode {res['mode']}: {res['points']} points")                        
    print(f"  A:\n{res['A']}")                                                  
    print(f"  b: {res['b']}")                                                   
    print(f"  x1 range: [{res['x1_min']}, {res['x1_max']}]")                    
    print(f"  x2 range: [{res['x2_min']}, {res['x2_max']}]")                    
                                                                                
# Check time sequence of labels to see switching                                
print(f"First 50 labels: {labels[:50]}")                                        
                                                                                
