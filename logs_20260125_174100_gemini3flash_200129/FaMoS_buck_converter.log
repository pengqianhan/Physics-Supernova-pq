import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load all samples                                                              
samples = []                                                                    
for i in range(3):                                                              
    data = np.load(f'data_all/FaMoS/buck_converter/sample_{i}.npz')             
    samples.append(data['state'])                                               
                                                                                
# Combine all samples for analysis                                              
# states: [2, 10001]                                                            
# We'll compute derivatives dx/dt. Since dt is not given, we'll use step=1 and  
check.                                                                          
