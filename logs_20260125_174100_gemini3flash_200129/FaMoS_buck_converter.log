  from scipy import stats                                                       
                                                                                
  # 1. Load the data from the NPZ files                                         
  all_x = []                                                                    
  all_dx = []                                                                   
  dt = 0.001                                                                    
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      x = data['X']  # Assuming X has shape (N, 2)                              
      # 2. Estimate derivatives dx1/dt and dx2/dt                               
      dx = (x[1:] - x[:-1]) / dt                                                
      all_x.append(x[:-1])                                                      
      all_dx.append(dx)                                                         
                                                                                
  X_data = np.vstack(all_x)                                                     
  dX_data = np.vstack(all_dx)                                                   
                                                                                
  # 3. Use clustering on the derivatives to identify the two operating modes    
  # Implementing a simple K-means from scratch since sklearn is not available   
  def simple_kmeans(data, k=2, max_iters=100):                                  
      # Initialize centroids randomly from data points                          
      centroids = data[np.random.choice(data.shape[0], k, replace=False)]       
      for _ in range(max_iters):                                                
          # Assign clusters                                                     
          distances = np.linalg.norm(data[:, np.newaxis] - centroids, axis=2)   
          labels = np.argmin(distances, axis=1)                                 
          # Update centroids                                                    
          new_centroids = np.array([data[labels == i].mean(axis=0) for i in     
  range(k)])                                                                    
          if np.all(centroids == new_centroids):                                
              break                                                             
          centroids = new_centroids                                             
      return labels, centroids                                                  
                                                                                
  labels, centroids = simple_kmeans(dX_data)                                    
                                                                                
  # 4. For each mode, perform linear regression                                 
  results = {}                                                                  
  for mode in range(2):                                                         
      mask = (labels == mode)                                                   
      X_m = X_data[mask]                                                        
      dX_m = dX_data[mask]                                                      
                                                                                
      # Prepare design matrix [x1, x2, 1] for linear regression                 
      A = np.column_stack([X_m, np.ones(X_m.shape[0])])                         
                                                                                
      # Solve dx1/dt = a11*x1 + a12*x2 + b1                                     
      params1, _, _, _ = np.linalg.lstsq(A, dX_m[:, 0], rcond=None)             
      # Solve dx2/dt = a21*x1 + a22*x2 + b2                                     
      params2, _, _, _ = np.linalg.lstsq(A, dX_m[:, 1], rcond=None)             
                                                                                
      results[mode] = {                                                         
          'a11': params1[0], 'a12': params1[1], 'b1': params1[2],               
          'a21': params2[0], 'a22': params2[1], 'b2': params2[2],               
          'X_mean': np.mean(X_m, axis=0)                                        
      }                                                                         
                                                                                
  # 5. Identify the exact guard conditions                                      
  # Check if x1 or x2 can separate the modes                                    
  x1_m0 = X_data[labels == 0, 0]                                                
  x1_m1 = X_data[labels == 1, 0]                                                
  x2_m0 = X_data[labels == 0, 1]                                                
  x2_m1 = X_data[labels == 1, 1]                                                
                                                                                
  # Let's find a simple threshold on x1 or x2 if possible                       
  # Checking overlap                                                            
  min_x2_m0, max_x2_m0 = np.min(x2_m0), np.max(x2_m0)                           
  min_x2_m1, max_x2_m1 = np.min(x2_m1), np.max(x2_m1)                           
                                                                                
  # In buck converters, often the switching is based on a reference voltage or  
  current.                                                                      
