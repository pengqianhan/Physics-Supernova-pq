fig, axs = plt.subplots(2, 2, figsize=(12, 10))                                 
                                                                                
for i, x in enumerate(samples):                                                 
    x1 = x[0, :]                                                                
    x2 = x[1, :]                                                                
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    axs[0, 0].plot(x1, label=f'Sample {i}')                                     
    axs[0, 1].plot(x2, label=f'Sample {i}')                                     
    axs[1, 0].plot(dx1, label=f'Sample {i}')                                    
