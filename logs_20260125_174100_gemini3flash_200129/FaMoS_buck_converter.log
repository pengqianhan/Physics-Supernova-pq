    # Solve dx = A*x + B                                                        
    # x is [x1, x2, 1]                                                          
    A_mat = np.column_stack([X[mask], np.ones(np.sum(mask))])                   
    coeffs1 = np.linalg.lstsq(A_mat, dX[mask, 0], rcond=None)[0]                
    coeffs2 = np.linalg.lstsq(A_mat, dX[mask, 1], rcond=None)[0]                
    return coeffs1, coeffs2                                                     
                                                                                
