# I need to do this for both modes. Let's refactor.                             
def get_cleaned_data(m_target):                                                 
    X1, X2, DX1, DX2 = [], [], [], []                                           
    for path in ['data_all/FaMoS/buck_converter/sample_0.npz',                  
                 'data_all/FaMoS/buck_converter/sample_1.npz',                  
                 'data_all/FaMoS/buck_converter/sample_2.npz']:                 
        data = np.load(path)                                                    
        state = data['state']                                                   
        x1_v, x2_v = state[0, :], state[1, :]                                   
        dx1_v, dx2_v = np.diff(x1_v)/dt, np.diff(x2_v)/dt                       
        mode = np.zeros(len(dx1_v))                                             
        mode[dx1_v > 0] = 1                                                     
        mode[dx1_v < 0] = 2                                                     
        changes = np.where(np.diff(mode) != 0)[0]                               
        st = 0                                                                  
        for ch in changes:                                                      
            en = ch                                                             
            if mode[st] == m_target:                                            
                n = en - st                                                     
                if n > 5:                                                       
                    for i in range(st + int(0.2*n), st + int(0.8*n)):           
                        X1.append(x1_v[i]); X2.append(x2_v[i])                  
                        DX1.append(dx1_v[i]); DX2.append(dx2_v[i])              
            st = ch + 1                                                         
    return np.array(X1), np.array(X2), np.array(DX1), np.array(DX2)             
                                                                                
x1_m1, x2_m1, dx1_m1, dx2_m1 = get_cleaned_data(1)                              
x1_m2, x2_m2, dx1_m2, dx2_m2 = get_cleaned_data(2)                              
                                                                                
def solve(x1, x2, dx1, dx2):                                                    
    M = np.column_stack([x1, x2, np.ones(len(x1))])                             
    s1 = np.linalg.lstsq(M, dx1, rcond=None)[0]                                 
    s2 = np.linalg.lstsq(M, dx2, rcond=None)[0]                                 
    return s1, s2                                                               
                                                                                
s1_m1, s2_m1 = solve(x1_m1, x2_m1, dx1_m1, dx2_m1)                              
s1_m2, s2_m2 = solve(x1_m2, x2_m2, dx1_m2, dx2_m2)                              
                                                                                
print(f"M1: {s1_m1}, {s2_m1}")                                                  
