import numpy as np                                                              
from scipy.linalg import lstsq                                                  
                                                                                
def solve_regression(x1_vals, x2_vals, x1_next, x2_next):                       
    # Solve for a, b, c, d, e, f                                                
    # x1_next = a*x1 + b*x2 + c                                                 
    # x2_next = d*x1 + e*x2 + f                                                 
    A = np.column_stack([x1_vals, x2_vals, np.ones_like(x1_vals)])              
    sol1, _, _, _ = lstsq(A, x1_next)                                           
    sol2, _, _, _ = lstsq(A, x2_next)                                           
    return sol1, sol2                                                           
                                                                                
