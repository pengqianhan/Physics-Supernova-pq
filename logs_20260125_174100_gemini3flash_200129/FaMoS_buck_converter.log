def fit_linear_model(x1_vals, x2_vals, target):                                 
    # target = a*x1 + b*x2 + c                                                  
    A = np.column_stack([x1_vals, x2_vals, np.ones_like(x1_vals)])              
    coeffs, residuals, rank, s = np.linalg.lstsq(A, target, rcond=None)         
    return coeffs                                                               
                                                                                
# Mode 0 (mask False)                                                           
