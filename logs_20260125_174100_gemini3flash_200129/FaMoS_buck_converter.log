import numpy as np                                                              
from sklearn.cluster import KMeans                                              
                                                                                
# Load the data                                                                 
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate differences                                                         
dx1 = x1[1:] - x1[:-1]                                                          
dx2 = x2[1:] - x2[:-1]                                                          
x1_k = x1[:-1]                                                                  
x2_k = x2[:-1]                                                                  
                                                                                
# Feature vector for clustering: (x1, x2, dx1, dx2)                             
# Standardize features for clustering                                           
features = np.stack([x1_k, x2_k, dx1, dx2], axis=1)                             
                                                                                
# We expect 3 modes                                                             
kmeans = KMeans(n_clusters=3, random_state=42)                                  
labels = kmeans.fit_predict(features)                                           
                                                                                
# Analyze each cluster                                                          
for i in range(3):                                                              
    mask = (labels == i)                                                        
    print(f"Mode {i}: {np.sum(mask)} points")                                   
                                                                                
    # Fit dx = A*x + b for each mode                                            
    # [dx1; dx2] = [a11 a12; a21 a22] * [x1; x2] + [b1; b2]                     
    X = np.stack([x1_k[mask], x2_k[mask], np.ones(np.sum(mask))], axis=1)       
                                                                                
    # dx1 = a11*x1 + a12*x2 + b1                                                
    # dx2 = a21*x1 + a22*x2 + b2                                                
    coeffs1, resid1, rank1, s1 = np.linalg.lstsq(X, dx1[mask], rcond=None)      
    coeffs2, resid2, rank2, s2 = np.linalg.lstsq(X, dx2[mask], rcond=None)      
                                                                                
    print(f"  Mode {i} dx1 coeffs: {coeffs1}")                                  
    print(f"  Mode {i} dx2 coeffs: {coeffs2}")                                  
                                                                                
# Identify guards                                                               
# Usually guards are based on x1 and some external signal (time or PWM)         
# or state boundaries.                                                          
# Let's see the range of states in each mode                                    
for i in range(3):                                                              
    mask = (labels == i)                                                        
    print(f"Mode {i} x1 range: [{np.min(x1_k[mask])}, {np.max(x1_k[mask])}]")   
    print(f"Mode {i} x2 range: [{np.min(x2_k[mask])}, {np.max(x2_k[mask])}]")   
                                                                                
