    dx_points = dx.T # (10000, 2)                                               
                                                                                
    all_x.append(x_points)                                                      
    all_dx.append(dx_points)                                                    
    trajectories.append((x_points, dx_points))                                  
                                                                                
X_combined = np.vstack(all_x)                                                   
DX_combined = np.vstack(all_dx)                                                 
                                                                                
# 2. Identify modes using manual KMeans clustering on derivative data           
def manual_kmeans_2(data):                                                      
    # Initialize centroids using min and max of the first derivative            
    # (Separates the charging and discharging slopes of inductor current)       
    c0 = data[np.argmin(data[:, 0])].copy()                                     
    c1 = data[np.argmax(data[:, 0])].copy()                                     
    centroids = [c0, c1]                                                        
                                                                                
    labels = np.zeros(len(data), dtype=int)                                     
    for _ in range(10):                                                         
        # Distance to each centroid                                             
        d0 = np.sum((data - centroids[0])**2, axis=1)                           
        d1 = np.sum((data - centroids[1])**2, axis=1)                           
        new_labels = (d1 < d0).astype(int)                                      
                                                                                
        if np.array_equal(labels, new_labels):                                  
            break                                                               
        labels = new_labels                                                     
                                                                                
        # Update centroids                                                      
        if np.any(labels == 0):                                                 
            centroids[0] = data[labels == 0].mean(axis=0)                       
        if np.any(labels == 1):                                                 
            centroids[1] = data[labels == 1].mean(axis=0)                       
                                                                                
    return labels, np.array(centroids)                                          
                                                                                
labels_all, final_centroids = manual_kmeans_2(DX_combined)                      
                                                                                
# 3. Fit linear ODE models for each mode                                        
def fit_linear_model(X, DX):                                                    
    # dx = A*x + b -> DX = [X, 1] * [A.T; b.T]                                  
    X_aug = np.column_stack([X, np.ones(len(X))])                               
    # Solve the least squares problem for both components of DX                 
    params, _, _, _ = np.linalg.lstsq(X_aug, DX, rcond=None)                    
    # params is (3, 2). params[:, 0] are coeffs for dx1, params[:, 1] for dx2   
    return {                                                                    
        'a11': params[0, 0], 'a12': params[1, 0], 'b1': params[2, 0],           
        'a21': params[0, 1], 'a22': params[1, 1], 'b2': params[2, 1]            
    }                                                                           
                                                                                
modes_info = []                                                                 
for m in range(2):                                                              
    mask = (labels_all == m)                                                    
    modes_info.append(fit_linear_model(X_combined[mask], DX_combined[mask]))    
                                                                                
# 4. Determine guard conditions                                                 
all_guards = []                                                                 
for traj_x, traj_dx in trajectories:                                            
    # Use global centroids to label this trajectory                             
    dist0 = np.sum((traj_dx - final_centroids[0])**2, axis=1)                   
    dist1 = np.sum((traj_dx - final_centroids[1])**2, axis=1)                   
    traj_labels = (dist1 < dist0).astype(int)                                   
                                                                                
    # Identify transitions                                                      
    switches = np.where(np.diff(traj_labels) != 0)[0]                           
    for idx in switches:                                                        
        all_guards.append({                                                     
            'from': traj_labels[idx],                                           
            'to': traj_labels[idx+1],                                           
            'state': traj_x[idx]                                                
        })                                                                      
                                                                                
# Group guards by transition type                                               
guard_summary = {}                                                              
for g in all_guards:                                                            
    key = f"Mode {g['from']} -> Mode {g['to']}"                                 
    if key not in guard_summary:                                                
        guard_summary[key] = []                                                 
    guard_summary[key].append(g['state'])                                       
                                                                                
# Final Answer formulation                                                      
print("MODE RESULTS")                                                           
for i, info in enumerate(modes_info):                                           
    m_name = "Switch ON (Charging)" if info['b1'] > 2000 else "Switch OFF       
(Discharging)"                                                                  
    print(f"Mode {i} ({m_name}):")                                              
    print(f"  dx1 = {info['a11']:.4f}*x1 + {info['a12']:.4f}*x2 +               
{info['b1']:.4f}")                                                              
    print(f"  dx2 = {info['a21']:.4f}*x1 + {info['a22']:.4f}*x2 +               
{info['b2']:.4f}")                                                              
                                                                                
