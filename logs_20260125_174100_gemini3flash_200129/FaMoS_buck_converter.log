# Simple manual K-means for 3 clusters (common for buck converters: ON, OFF,    
DCM)                                                                            
def kmeans_manual(data, k=3, max_iters=50):                                     
    # Standardize data for clustering                                           
    mean = np.mean(data, axis=0)                                                
    std = np.std(data, axis=0)                                                  
    data_norm = (data - mean) / (std + 1e-8)                                    
                                                                                
    # Initialize centroids                                                      
    indices = np.linspace(0, len(data_norm) - 1, k).astype(int)                 
    centroids = data_norm[indices]                                              
                                                                                
    for _ in range(max_iters):                                                  
        # Assign clusters                                                       
        dist = np.linalg.norm(data_norm[:, np.newaxis] - centroids, axis=2)     
        labels = np.argmin(dist, axis=1)                                        
        # Update centroids                                                      
        new_centroids = []                                                      
        for i in range(k):                                                      
            mask = (labels == i)                                                
            if np.any(mask):                                                    
                new_centroids.append(data_norm[mask].mean(axis=0))              
            else:                                                               
                new_centroids.append(centroids[i])                              
        new_centroids = np.array(new_centroids)                                 
        if np.allclose(centroids, new_centroids):                               
            break                                                               
        centroids = new_centroids                                               
    return labels                                                               
                                                                                
