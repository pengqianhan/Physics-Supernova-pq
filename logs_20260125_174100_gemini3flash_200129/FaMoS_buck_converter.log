    print(f"Switch {modes[idx]} -> {modes[idx+1]} at x1={x1_mid[idx]:.3f},      
x2={x2_mid[idx]:.3f}")                                                          
                                                                                
# Group thresholds by transition type                                           
trans_dict = {}                                                                 
for i in range(len(transitions)):                                               
    idx = transitions[i]                                                        
    key = (modes[idx], modes[idx+1])                                            
    if key not in trans_dict:                                                   
        trans_dict[key] = []                                                    
    trans_dict[key].append([x1_mid[idx], x2_mid[idx]])                          
                                                                                
print("\nGuard condition analysis:")                                            
for key, vals in trans_dict.items():                                            
    vals = np.array(vals)                                                       
    print(f"Transition {key[0]} -> {key[1]}:")                                  
    print(f"  x1 mean={np.mean(vals[:,0]):.3f} (std={np.std(vals[:,0]):.3f})")  
    print(f"  x2 mean={np.mean(vals[:,1]):.3f} (std={np.std(vals[:,1]):.3f})")  
                                                                                
