import numpy as np                                                              
                                                                                
# Load data                                                                     
samples = []                                                                    
for i in range(3):                                                              
    data = np.load(f'data_all/FaMoS/buck_converter/sample_{i}.npz')             
    samples.append(data['state'])                                               
                                                                                
# To identify modes, let's look at the distribution of derivatives              
# buck converter usually has a PWM signal (input) that switches.                
# In this dataset, 'input' is empty (shape (0, 10001)), so the switching might  
be autonomous or internal.                                                      
                                                                                
# Let's stack all data for derivative analysis                                  
all_x1 = np.concatenate([s[0, :-1] for s in samples])                           
all_x2 = np.concatenate([s[1, :-1] for s in samples])                           
all_dx1 = np.concatenate([np.diff(s[0, :]) for s in samples])                   
all_dx2 = np.concatenate([np.diff(s[1, :]) for s in samples])                   
                                                                                
# Mode identification: buck converter typically has 2 or 3 modes (ON, OFF, maybe
Discontinuous Conduction Mode)                                                  
# Let's look at dx1 and dx2 values.                                             
# x1 is usually inductor current, x2 is capacitor voltage.                      
# dx1/dt = (Vin*u - Vout)/L - R*i/L                                             
# dx2/dt = (i - Vout/R_load)/C                                                  
                                                                                
# Let's try to cluster (dx1, dx2) values or look at their histograms            
# Actually, since it's a linear ODE per mode, dx depends on x.                  
# dx = (A-I)x + B                                                               
# Let's look at dx1 as a function of x1 and x2.                                 
                                                                                
import matplotlib.pyplot as plt                                                 
                                                                                
plt.figure(figsize=(10, 5))                                                     
plt.scatter(all_x1, all_dx1, s=1, alpha=0.1)                                    
plt.xlabel('x1')                                                                
plt.ylabel('dx1')                                                               
plt.title('dx1 vs x1')                                                          
plt.savefig('dx1_vs_x1.png')                                                    
                                                                                
plt.figure(figsize=(10, 5))                                                     
plt.scatter(all_x2, all_dx1, s=1, alpha=0.1)                                    
plt.xlabel('x2')                                                                
plt.ylabel('dx1')                                                               
plt.title('dx1 vs x2')                                                          
plt.savefig('dx1_vs_x2.png')                                                    
                                                                                
# Let's check for discontinuous transitions in dx1 or dx2 over time for Sample 0
s0 = samples[0]                                                                 
dx1_s0 = np.diff(s0[0, :])                                                      
plt.figure(figsize=(12, 4))                                                     
plt.plot(dx1_s0)                                                                
plt.title('dx1 for sample 0 over time')                                         
plt.savefig('dx1_time.png')                                                     
                                                                                
# Print some dx1 values to see if they switch between distinct behaviors        
print("First 50 dx1 values of sample 0:", dx1_s0[:50])                          
                                                                                
