import numpy as np                                                              
from sklearn.cluster import KMeans                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
# Concatenate all trajectories                                                  
states = np.concatenate(all_states, axis=0)                                     
x1 = states[:, 0]                                                               
x2 = states[:, 1]                                                               
dt = 0.001                                                                      
                                                                                
# Calculate derivatives                                                         
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
derivatives = np.column_stack((dx1, dx2))                                       
                                                                                
# Identify discrete modes using KMeans                                          
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10).fit(derivatives)      
labels = kmeans.labels_                                                         
                                                                                
# Prepare data for ODE fitting (x[k+1] = A*x[k] + B)                            
# Note: Task asks for x[1] = ... x[0] etc, which implies a discrete step or     
derivative.                                                                     
# Given the phrasing, I'll fit the next state based on current state.           
X_curr = states[:-1]                                                            
X_next = states[1:]                                                             
                                                                                
results = {}                                                                    
for i in range(2):                                                              
    mask = labels == i                                                          
    if np.sum(mask) < 2: continue                                               
                                                                                
    # Fit x1_next                                                               
    reg1 = LinearRegression().fit(X_curr[mask], X_next[mask, 0])                
    # Fit x2_next                                                               
    reg2 = LinearRegression().fit(X_curr[mask], X_next[mask, 1])                
                                                                                
    results[f"Mode {i}"] = {                                                    
        "a11": reg1.coef_[0], "a12": reg1.coef_[1], "b1": reg1.intercept_,      
        "a21": reg2.coef_[0], "a22": reg2.coef_[1], "b2": reg2.intercept_       
    }                                                                           
                                                                                
# Identify guard conditions                                                     
# Look for transition points in labels                                          
transitions = np.where(labels[:-1] != labels[1:])[0]                            
guard_states = states[transitions]                                              
                                                                                
print("Linear Model Results:", results)                                         
print("Guard Condition (mean transition states):", np.mean(guard_states, axis=0)
if len(guard_states) > 0 else "N/A")                                            
                                                                                
