import numpy as np                                                              
import pandas as pd                                                             
                                                                                
def process_file(path):                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    df = pd.DataFrame({                                                         
        'x1_k': x1[:-1],                                                        
        'x2_k': x2[:-1],                                                        
        'x1_next': x1[1:],                                                      
        'x2_next': x2[1:]                                                       
    })                                                                          
    return df                                                                   
                                                                                
# Load and combine all data                                                     
dfs = [process_file(p) for p in ['data_all/FaMoS/buck_converter/sample_0.npz',  
                                'data_all/FaMoS/buck_converter/sample_1.npz',   
                                'data_all/FaMoS/buck_converter/sample_2.npz']]  
df_all = pd.concat(dfs, ignore_index=True)                                      
                                                                                
# 1. Mode Identification                                                        
# In a buck converter, the mode (ON/OFF) is often distinguishable by the        
derivative of x1.                                                               
dx1 = df_all['x1_next'] - df_all['x1_k']                                        
threshold = (dx1.max() + dx1.min()) / 2                                         
# Mode 0: Switch ON (Charging, higher dx1), Mode 1: Switch OFF (Discharging,    
lower dx1)                                                                      
df_all['mode'] = (dx1 < threshold).astype(int)                                  
                                                                                
# 2. Fit Linear ODEs (Difference Equations)                                     
def fit_linear(df, target_col):                                                 
    X = np.stack([df['x1_k'], df['x2_k'], np.ones(len(df))], axis=1)            
    y = df[target_col].values                                                   
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    return coeffs                                                               
                                                                                
results = {}                                                                    
for m in [0, 1]:                                                                
    sub = df_all[df_all['mode'] == m]                                           
    c1 = fit_linear(sub, 'x1_next')                                             
    c2 = fit_linear(sub, 'x2_next')                                             
    results[m] = {                                                              
        'a': c1[0], 'b': c1[1], 'c': c1[2],                                     
        'd': c2[0], 'e': c2[1], 'f': c2[2],                                     
        'avg_x1': sub['x1_k'].mean(),                                           
        'avg_x2': sub['x2_k'].mean()                                            
    }                                                                           
                                                                                
# 3. Determine Switching Conditions (Guards)                                    
transitions = []                                                                
for df in dfs:                                                                  
    df_dx1 = df['x1_next'] - df['x1_k']                                         
    df['mode'] = (df_dx1 < threshold).astype(int)                               
    for i in range(len(df) - 1):                                                
        if df.iloc[i]['mode'] != df.iloc[i+1]['mode']:                          
            transitions.append({                                                
                'from': df.iloc[i]['mode'],                                     
                'to': df.iloc[i+1]['mode'],                                     
                'x1_pre': df.iloc[i]['x1_next'],                                
                'x2_pre': df.iloc[i]['x2_next'],                                
                'x1_post': df.iloc[i+1]['x1_k'],                                
                'x2_post': df.iloc[i+1]['x2_k']                                 
            })                                                                  
                                                                                
trans_df = pd.DataFrame(transitions)                                            
guards = trans_df.groupby(['from', 'to'])[['x1_pre', 'x2_pre']].mean()          
                                                                                
# 4. Check for State Resets                                                     
# Resets are indicated by jumps at transition points: ||x_post - x_pre||        
if not trans_df.empty:                                                          
    jumps = np.sqrt((trans_df['x1_post'] - trans_df['x1_pre'])**2 +             
                    (trans_df['x2_post'] - trans_df['x2_pre'])**2)              
    max_jump = jumps.max()                                                      
else:                                                                           
    max_jump = 0                                                                
                                                                                
print("Linear Model Coefficients and Averages:")                                
for m, res in results.items():                                                  
    print(f"Mode {m}: a={res['a']:.6f}, b={res['b']:.6f}, c={res['c']:.6f},     
d={res['d']:.6f}, e={res['e']:.6f}, f={res['f']:.6f}")                          
    print(f"        avg_x1={res['avg_x1']:.4f}, avg_x2={res['avg_x2']:.4f}")    
                                                                                
print("\nGuards (Switching Conditions):")                                       
print(guards)                                                                   
print(f"\nMax state jump at transitions: {max_jump:.2e}")                       
                                                                                
