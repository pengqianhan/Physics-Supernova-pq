    if key not in guards: guards[key] = []                                      
    guards[key].append(t['state'])                                              
                                                                                
guard_stats = {k: np.mean(v, axis=0) for k, v in guards.items()}                
resets = {k: np.mean([t['jump'] for t in transitions if (t['from'], t['to']) == 
k]) for k in guards.keys()}                                                     
                                                                                
print("Mode params:", mode_results)                                             
print("Guards mean state:", guard_stats)                                        
