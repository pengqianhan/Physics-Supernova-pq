        coeffs1, _, _, _ = lstsq(A_mat, DX[mask, 0])                            
        # For dx2                                                               
        coeffs2, _, _, _ = lstsq(A_mat, DX[mask, 1])                            
                                                                                
        models.append((coeffs1, coeffs2))                                       
    return models                                                               
                                                                                
