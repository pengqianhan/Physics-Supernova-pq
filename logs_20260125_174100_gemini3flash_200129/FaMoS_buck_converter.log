# Manual K-Means                                                                
def simple_kmeans(data, k, max_iters=100):                                      
    # Standardize data for clustering                                           
    mean = np.mean(data, axis=0)                                                
    std = np.std(data, axis=0)                                                  
    data_scaled = (data - mean) / std                                           
                                                                                
    # Randomly initialize centroids                                             
    np.random.seed(42)                                                          
    centroids = data_scaled[np.random.choice(data_scaled.shape[0], k,           
replace=False)]                                                                 
                                                                                
    for _ in range(max_iters):                                                  
        # Assign clusters                                                       
        distances = np.linalg.norm(data_scaled[:, np.newaxis] - centroids,      
axis=2)                                                                         
        labels = np.argmin(distances, axis=1)                                   
                                                                                
        # Update centroids                                                      
        new_centroids = np.array([data_scaled[labels == i].mean(axis=0) if      
np.any(labels == i) else centroids[i] for i in range(k)])                       
        if np.allclose(centroids, new_centroids):                               
            break                                                               
        centroids = new_centroids                                               
    return labels                                                               
                                                                                
