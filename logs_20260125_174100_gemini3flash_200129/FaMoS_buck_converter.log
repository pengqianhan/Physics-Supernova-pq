from sklearn.linear_model import LinearRegression                               
                                                                                
# Load all data                                                                 
all_x1 = []                                                                     
all_x2 = []                                                                     
all_dx1 = []                                                                    
all_dx2 = []                                                                    
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0, :-1]                                                          
    x2 = state[1, :-1]                                                          
    dx1 = np.diff(state[0, :])                                                  
    dx2 = np.diff(state[1, :])                                                  
    all_x1.append(x1)                                                           
    all_x2.append(x2)                                                           
    all_dx1.append(dx1)                                                         
    all_dx2.append(dx2)                                                         
                                                                                
x1 = np.concatenate(all_x1)                                                     
x2 = np.concatenate(all_x2)                                                     
dx1 = np.concatenate(all_dx1)                                                   
dx2 = np.concatenate(all_dx2)                                                   
                                                                                
# Identify modes based on the sign of dx1                                       
# In a buck converter, the inductor current (x1) increases when ON and decreases
when OFF.                                                                       
mode_mask = dx1 > 0                                                             
X_all = np.column_stack([x1, x2])                                               
                                                                                
# Mode 1 (ON): dx1 > 0                                                          
X1 = X_all[mode_mask]                                                           
y1_dx1 = dx1[mode_mask]                                                         
y1_dx2 = dx2[mode_mask]                                                         
                                                                                
model1_dx1 = LinearRegression().fit(X1, y1_dx1)                                 
model1_dx2 = LinearRegression().fit(X1, y1_dx2)                                 
                                                                                
# Mode 2 (OFF): dx1 <= 0                                                        
X2 = X_all[~mode_mask]                                                          
y2_dx1 = dx1[~mode_mask]                                                        
y2_dx2 = dx2[~mode_mask]                                                        
                                                                                
model2_dx1 = LinearRegression().fit(X2, y2_dx1)                                 
model2_dx2 = LinearRegression().fit(X2, y2_dx2)                                 
                                                                                
# Results                                                                       
print("Mode 1 (ON):")                                                           
print(f"  dx1/dt = {model1_dx1.coef_[0]:.4f}*x1 + {model1_dx1.coef_[1]:.4f}*x2 +
{model1_dx1.intercept_:.4f}")                                                   
print(f"  dx2/dt = {model1_dx2.coef_[0]:.4f}*x1 + {model1_dx2.coef_[1]:.4f}*x2 +
