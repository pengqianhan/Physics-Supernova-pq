│                 "condition": "x1 <= 0",                                      │
│                 "reset": {                                                   │
│                     "x1": [0\],                                              │
│                     "x2": ["-0.1 * x1[0\]"]                                  │
│                 }                                                            │
│             }                                                                │
│         ]                                                                    │
│     },                                                                       │
│     "config": {                                                              │
