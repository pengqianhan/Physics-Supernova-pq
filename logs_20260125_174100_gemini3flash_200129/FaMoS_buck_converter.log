def fit_mode(X, Y):                                                             
    # Add bias term                                                             
    X_bias = np.hstack([X, np.ones((X.shape[0], 1))])                           
    # Solve (X_bias^T * X_bias) * Theta = X_bias^T * Y                          
    # Theta is (3, 2)                                                           
    Theta, _, _, _ = np.linalg.lstsq(X_bias, Y, rcond=None)                     
    return Theta                                                                
                                                                                
modes = np.unique(mode_idx)                                                     
models = {}                                                                     
for m in modes:                                                                 
    mask = (mode_idx == m)                                                      
    models[m] = fit_mode(X_curr[mask], X_next[mask])                            
    print(f"Mode {m} model (A and B): \n{models[m]}")                           
                                                                                
# Transition conditions:                                                        
# Check where mode_idx changes                                                  
transitions = []                                                                
for i in range(len(mode_idx)-1):                                                
    if mode_idx[i] != mode_idx[i+1]:                                            
        transitions.append((mode_idx[i], mode_idx[i+1], X_curr[i]))             
                                                                                
print(f"Number of transitions found: {len(transitions)}")                       
                                                                                
