def fit_linear(X_in, X_out):                                                    
    # Add bias term                                                             
    X_bias = np.hstack([X_in, np.ones((X_in.shape[0], 1))])                     
    # Solve (X_bias^T * X_bias) * [A; B]^T = X_bias^T * X_out                   
