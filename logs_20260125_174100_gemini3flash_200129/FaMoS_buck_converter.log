import numpy as np                                                              
import pandas as pd                                                             
                                                                                
def process_file(path):                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    # Create a DataFrame with k and k+1 values                                  
    df = pd.DataFrame({                                                         
        'x1_k': x1[:-1],                                                        
        'x2_k': x2[:-1],                                                        
        'x1_next': x1[1:],                                                      
        'x2_next': x2[1:]                                                       
    })                                                                          
    return df                                                                   
                                                                                
# Load all data                                                                 
dfs = [process_file(p) for p in ['data_all/FaMoS/buck_converter/sample_0.npz',  
                                'data_all/FaMoS/buck_converter/sample_1.npz',   
                                'data_all/FaMoS/buck_converter/sample_2.npz']]  
df_all = pd.concat(dfs, ignore_index=True)                                      
                                                                                
# Identify modes based on change in x1                                          
# In a buck converter, x1 increases when the switch is ON and decreases when    
OFF.                                                                            
dx1 = df_all['x1_next'] - df_all['x1_k']                                        
# Use the sign of dx1 to distinguish modes initially                            
# Mode 0: Switch ON (dx1 typically positive or higher)                          
# Mode 1: Switch OFF (dx1 typically negative or lower)                          
threshold = (dx1.max() + dx1.min()) / 2                                         
df_all['mode'] = (dx1 < threshold).astype(int)                                  
                                                                                
def fit_linear(df, target_col):                                                 
    # Fits target = a*x1 + b*x2 + c                                             
    X = np.stack([df['x1_k'], df['x2_k'], np.ones(len(df))], axis=1)            
    y = df[target_col].values                                                   
    coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)              
    return coeffs                                                               
                                                                                
results = {}                                                                    
for m in [0, 1]:                                                                
    sub = df_all[df_all['mode'] == m]                                           
    if len(sub) < 3: continue                                                   
                                                                                
    c1 = fit_linear(sub, 'x1_next')                                             
    c2 = fit_linear(sub, 'x2_next')                                             
                                                                                
    results[m] = {                                                              
        'a': c1[0], 'b': c1[1], 'c': c1[2],                                     
        'd': c2[0], 'e': c2[1], 'f': c2[2],                                     
        'avg_x1': sub['x1_k'].mean(),                                           
        'avg_x2': sub['x2_k'].mean(),                                           
        'min_x2': sub['x2_k'].min(),                                            
        'max_x2': sub['x2_k'].max()                                             
    }                                                                           
                                                                                
# Analyze transitions                                                           
transitions = []                                                                
for df in dfs:                                                                  
    # Mode identification for each file                                         
    df_dx1 = df['x1_next'] - df['x1_k']                                         
    df['mode'] = (df_dx1 < threshold).astype(int)                               
                                                                                
    for i in range(len(df) - 1):                                                
        if df.iloc[i]['mode'] != df.iloc[i+1]['mode']:                          
            transitions.append({                                                
                'from': df.iloc[i]['mode'],                                     
                'to': df.iloc[i+1]['mode'],                                     
                'x1': df.iloc[i]['x1_next'],                                    
                'x2': df.iloc[i]['x2_next']                                     
            })                                                                  
                                                                                
trans_df = pd.DataFrame(transitions)                                            
guards = trans_df.groupby(['from', 'to'])[['x1', 'x2']].mean() if not           
trans_df.empty else "No transitions found"                                      
                                                                                
print("Results:", results)                                                      
print("Guards:", guards)                                                        
                                                                                
