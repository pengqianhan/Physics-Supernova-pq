def simple_kmeans(data, k, max_iters=50):                                       
    np.random.seed(42)                                                          
    # Use points with max/min dx1/dt to initialize for better convergence       
    idx_min = np.argmin(data[:, 0])                                             
    idx_max = np.argmax(data[:, 0])                                             
    centroids = data[[idx_min, idx_max]]                                        
                                                                                
    for _ in range(max_iters):                                                  
