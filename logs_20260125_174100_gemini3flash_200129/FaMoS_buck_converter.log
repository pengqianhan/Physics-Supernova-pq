import numpy as np                                                              
from sklearn.cluster import KMeans                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
state = data['state'] # shape (2, 10001)                                        
                                                                                
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate differences                                                         
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
                                                                                
# We want to find modes where [dx1, dx2] depends linearly on [x1, x2]           
# Let's look at the relationship: dx = (A*x + b) * dt                           
# To find modes, we can look at residuals of a single linear model or cluster   
directly if features are distinct.                                              
# However, for buck converters, the modes are usually determined by a PWM signal
or the state of a diode.                                                        
# Often, we can cluster the points [x1[:-1], x2[:-1], dx1, dx2] or use a more   
sophisticated method.                                                           
                                                                                
# Let's try to visualize or check the number of modes.                          
# A simple way is to look at the 'input' if it was provided, but it's empty.    
# Another way: the derivative dx2 (inductor current change) is usually the most 
telling.                                                                        
# dx2 ~ (V_switch - x1)/L. V_switch is either Vin or 0 (or 0 if x2=0).          
                                                                                
# Let's look at the distribution of dx2 + (some constant)*x1.                   
# Or just cluster [dx1, dx2, x1[:-1], x2[:-1]]                                  
from sklearn.cluster import KMeans                                              
                                                                                
# Prepare features for clustering: [x1, x2, dx1, dx2]                           
X_features = np.column_stack([x1[:-1], x2[:-1], dx1, dx2])                      
                                                                                
# Try KMeans with 2 and 3 clusters                                              
for n_clusters in [2, 3]:                                                       
    kmeans = KMeans(n_clusters=n_clusters, random_state=42).fit(X_features)     
    print(f"Clusters {n_clusters}, inertia: {kmeans.inertia_}")                 
                                                                                
# Also check the values of x1 and x2 to see which is which.                     
print("Mean x1:", np.mean(x1), "Range x1:", np.min(x1), np.max(x1))             
print("Mean x2:", np.mean(x2), "Range x2:", np.min(x2), np.max(x2))             
                                                                                
# Let's check for any 0 values in the states which might indicate DCM.          
print("Min x2:", np.min(x2))                                                    
                                                                                
