{res['coeffs'][1][1]:.4f}*x2 + {res['coeffs'][1][2]:.4f}")                      
    print(f"  Mean x1: {res['mean_x'][0]:.4f}, Mean x2: {res['mean_x'][1]:.4f}")
    print(f"  R^2 scores: {res['score1']:.4f}, {res['score2']:.4f}")            
                                                                                
# Transition analysis                                                           
# Look at the sequence of labels in one sample                                  
sample_labels = labels[:10000]                                                  
transitions = []                                                                
for i in range(len(sample_labels) - 1):                                         
    if sample_labels[i] != sample_labels[i+1]:                                  
        # Transition from sample_labels[i] to sample_labels[i+1]                
        # Check the state at the transition                                     
