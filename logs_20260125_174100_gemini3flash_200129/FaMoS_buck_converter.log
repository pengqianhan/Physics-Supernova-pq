  import numpy as np                                                            
  from scipy import optimize                                                    
                                                                                
  # Correct data loading                                                        
  all_x = []                                                                    
  all_dx = []                                                                   
  dt = 0.001                                                                    
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      # Correct shape handling: state is (2, 10001), transpose it to (10001,    
  2)                                                                            
      x = data['state'].T                                                       
      dx = (x[1:] - x[:-1]) / dt                                                
      all_x.append(x[:-1])                                                      
      all_dx.append(dx)                                                         
                                                                                
  X = np.vstack(all_x)                                                          
  DX = np.vstack(all_dx)                                                        
                                                                                
  # Simple manual K-means for 2 clusters                                        
  def get_labels(data, k=2):                                                    
      mean = np.mean(data, axis=0)                                              
      std = np.std(data, axis=0)                                                
      data_norm = (data - mean) / (std + 1e-8)                                  
      indices = np.linspace(0, len(data_norm) - 1, k).astype(int)               
      centroids = data_norm[indices]                                            
      for _ in range(50):                                                       
          dist = np.linalg.norm(data_norm[:, np.newaxis] - centroids, axis=2)   
          labels = np.argmin(dist, axis=1)                                      
          new_centroids = np.array([data_norm[labels == i].mean(axis=0) if      
  np.any(labels == i) else centroids[i] for i in range(k)])                     
          if np.allclose(centroids, new_centroids): break                       
          centroids = new_centroids                                             
      return labels                                                             
                                                                                
  labels = get_labels(DX, k=2)                                                  
                                                                                
  # Linear fit per mode                                                         
  def fit_linear_model(X_m, DX_m):                                              
      A_aug = np.column_stack([X_m, np.ones(len(X_m))])                         
      params1, _, _, _ = np.linalg.lstsq(A_aug, DX_m[:, 0], rcond=None)         
      params2, _, _, _ = np.linalg.lstsq(A_aug, DX_m[:, 1], rcond=None)         
      return params1, params2                                                   
                                                                                
  mode_results = {}                                                             
  for m in np.unique(labels):                                                   
      mask = (labels == m)                                                      
      p1, p2 = fit_linear_model(X[mask], DX[mask])                              
      mode_results[m] = {                                                       
          'a11': p1[0], 'a12': p1[1], 'b1': p1[2],                              
          'a21': p2[0], 'a22': p2[1], 'b2': p2[2]                               
      }                                                                         
                                                                                
  # Transitions                                                                 
  transitions = []                                                              
  curr = 0                                                                      
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      x = data['state'].T                                                       
      n = len(x) - 1                                                            
      m_path = labels[curr:curr+n]                                              
      curr += n                                                                 
      for i in range(len(m_path) - 1):                                          
          if m_path[i] != m_path[i+1]:                                          
              # Transition at step i+1                                          
              transitions.append({                                              
                  'from': m_path[i], 'to': m_path[i+1],                         
                  'state_pre': x[i], 'state_at': x[i+1], 'state_post': x[i+2]   
              })                                                                
                                                                                
  # Analyze guards and resets                                                   
  guards = {}                                                                   
  resets = {}                                                                   
  for t in transitions:                                                         
      k = (t['from'], t['to'])                                                  
      if k not in guards:                                                       
          guards[k] = []                                                        
          resets[k] = []                                                        
      guards[k].append(t['state_at'])                                           
      resets[k].append(np.linalg.norm(t['state_post'] - t['state_at']))         
                                                                                
  guard_summary = {k: np.mean(v, axis=0) for k, v in guards.items()}            
  reset_summary = {k: np.mean(v) for k, v in resets.items()}                    
                                                                                
  print("Mode params:", mode_results)                                           
  print("Guard centers:", guard_summary)                                        
  print("Avg reset jump:", reset_summary)                                       
