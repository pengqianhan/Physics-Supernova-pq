import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the data                                                                 
data0 = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                   
s0 = data0['state']                                                             
                                                                                
# Use index 1000 to 1200 as requested (t from 0.1 to 0.2, assuming dt=0.0001)   
# Note: Since 't' is not in the file, I'll use index window.                    
start, end = 1000, 1200                                                         
x_curr = s0[:, start:end-1]                                                     
x_next = s0[:, start+1:end]                                                     
                                                                                
# Prepare data for fitting: x1_next = a*x1 + b*x2 + c, x2_next = d*x1 + e*x2 + f
X = np.vstack([x_curr, np.ones(x_curr.shape[1])]).T # (N, 3)                    
Y1 = x_next[0, :] # x1_next                                                     
Y2 = x_next[1, :] # x2_next                                                     
                                                                                
# Let's see the transitions by looking at the change                            
dx1 = Y1 - x_curr[0, :]                                                         
dx2 = Y2 - x_curr[1, :]                                                         
                                                                                
# Use clustering on (x1, x2, dx1, dx2) to identify modes                        
from sklearn.cluster import DBSCAN                                              
from sklearn.preprocessing import StandardScaler                                
                                                                                
features = np.vstack([x_curr, dx1, dx2]).T                                      
scaler = StandardScaler()                                                       
features_scaled = scaler.fit_transform(features)                                
                                                                                
db = DBSCAN(eps=0.2, min_samples=5).fit(features_scaled)                        
labels = db.labels_                                                             
                                                                                
print("Unique labels found in window:", np.unique(labels))                      
                                                                                
# For each label, fit a linear model                                            
for label in np.unique(labels):                                                 
    if label == -1: continue                                                    
    mask = (labels == label)                                                    
    X_sub = X[mask]                                                             
    Y1_sub = Y1[mask]                                                           
    Y2_sub = Y2[mask]                                                           
                                                                                
    # Solve linear systems                                                      
    params1, _, _, _ = np.linalg.lstsq(X_sub, Y1_sub, rcond=None)               
    params2, _, _, _ = np.linalg.lstsq(X_sub, Y2_sub, rcond=None)               
                                                                                
    print(f"\nMode {label} parameters:")                                        
    print(f"  x1_next = {params1[0]:.6f}*x1 + {params1[1]:.6f}*x2 +             
{params1[2]:.6f}")                                                              
    print(f"  x2_next = {params2[0]:.6f}*x1 + {params2[1]:.6f}*x2 +             
{params2[2]:.6f}")                                                              
                                                                                
# Let's also check if there are resets (discontinuities)                        
# We can do this by checking if the end of one mode segment and start of next   
are far                                                                         
                                                                                
