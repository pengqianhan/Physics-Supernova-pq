import numpy as np                                                              
from sklearn.cluster import KMeans                                              
                                                                                
# Buck converter states: x1 (current), x2 (voltage)                             
# Transitions usually happen when x1 hits 0 or at fixed intervals (PWM).        
# Let's check for x1 = 0                                                        
x1_is_zero = np.abs(X_curr[:, 0]) < 1e-6                                        
print(f"Percentage of points where x1 is zero: {np.mean(x1_is_zero)*100:.2f}%") 
                                                                                
# Let's group points by looking at the derivative/difference                    
# Compute a 'signature' for each point based on (Delta_X)                       
# and try to cluster these signatures or look at the residuals of a global fit. 
                                                                                
# Let's try to identify points where Delta_X[0] is constant (like 0) vs others  
mode_idx = np.zeros(X_curr.shape[0])                                            
mode_idx[x1_is_zero] = 2 # Mode 2: DCM (x1=0)                                   
                                                                                
# For the rest, we might have Mode 0 (ON) and Mode 1 (OFF)                      
# Let's look at the remaining points                                            
remaining_mask = ~x1_is_zero                                                    
X_rem = X_curr[remaining_mask]                                                  
Y_rem = X_next[remaining_mask]                                                  
                                                                                
# For a buck converter:                                                         
# Mode ON: dx1/dt = (Vin - Vout)/L, dx2/dt = (x1 - Vout/R)/C                    
# Mode OFF: dx1/dt = -Vout/L, dx2/dt = (x1 - Vout/R)/C                          
# In discrete time: x1[k+1] - x1[k] depends on Vin and x2[k]                    
                                                                                
# Let's try to fit 2 clusters on the remaining points using (Delta_X)           
from sklearn.cluster import KMeans                                              
if np.sum(remaining_mask) > 0:                                                  
    kmeans = KMeans(n_clusters=2, random_state=42,                              
n_init=10).fit(Delta_X[remaining_mask])                                         
    mode_idx[remaining_mask] = kmeans.labels_                                   
                                                                                
print(f"Counts per mode: {np.unique(mode_idx, return_counts=True)}")            
                                                                                
