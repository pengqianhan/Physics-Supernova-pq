import numpy as np                                                              
import pandas as pd                                                             
from scipy.optimize import curve_fit                                            
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/buck_converter/sample_0.npz')                    
t = data['t']                                                                   
x = data['x']  # Assuming x has shape (N, 2)                                    
                                                                                
# Separate x1 and x2                                                            
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
# Calculate derivatives                                                         
dt = np.diff(t)                                                                 
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
t_mid = t[:-1] + dt / 2                                                         
x1_mid = x1[:-1] + np.diff(x1) / 2                                              
x2_mid = x2[:-1] + np.diff(x2) / 2                                              
                                                                                
# To identify modes, look at the derivative of dx2/dt or dx1/dt                 
# Buck converters typically have two modes: switch ON and switch OFF            
# Let's plot or analyze the jump in derivatives.                                
# For simplicity, we can use a threshold or clustering on the derivatives       
from sklearn.cluster import KMeans                                              
                                                                                
derivs = np.vstack((dx1, dx2)).T                                                
kmeans = KMeans(n_clusters=2, random_state=0).fit(derivs)                       
labels = kmeans.labels_                                                         
                                                                                
# Fit linear models for each mode                                               
def fit_linear(X, y):                                                           
    # y = A*x1 + B*x2 + C                                                       
    # Solve [x1, x2, 1] * [A, B, C]^T = y                                       
    A_mat = np.column_stack((X[:, 0], X[:, 1], np.ones(len(X))))                
    coeffs, residuals, rank, s = np.linalg.lstsq(A_mat, y, rcond=None)          
    return coeffs                                                               
                                                                                
results = {}                                                                    
for mode in np.unique(labels):                                                  
    mask = labels == mode                                                       
    X_mode = np.column_stack((x1_mid[mask], x2_mid[mask]))                      
    y1_mode = dx1[mask]                                                         
    y2_mode = dx2[mask]                                                         
                                                                                
    c1 = fit_linear(X_mode, y1_mode)                                            
    c2 = fit_linear(X_mode, y2_mode)                                            
    results[mode] = {'dx1': c1, 'dx2': c2}                                      
                                                                                
# Guard conditions                                                              
# Check state values when labels change                                         
transitions = np.where(labels[:-1] != labels[1:])[0]                            
guard_states = []                                                               
for idx in transitions:                                                         
    guard_states.append({'from': labels[idx], 'to': labels[idx+1], 'x1':        
x1_mid[idx], 'x2': x2_mid[idx]})                                                
                                                                                
print("Results:", results)                                                      
print("Transitions:", guard_states[:5])                                         
                                                                                
