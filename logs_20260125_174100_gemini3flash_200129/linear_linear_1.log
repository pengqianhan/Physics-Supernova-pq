def detect_modes(dx, threshold=0.001):                                          
    # This is a very simple change point detection                              
    changes = []                                                                
    for i in range(1, len(dx)):                                                 
        if abs(dx[i] - dx[i-1]) > threshold:                                    
            changes.append(i)                                                   
    return changes                                                              
                                                                                
