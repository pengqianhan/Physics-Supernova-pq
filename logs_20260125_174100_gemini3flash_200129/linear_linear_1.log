import numpy as np                                                              
                                                                                
def analyze_sample(path):                                                       
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    n_points = state.shape[1]                                                   
                                                                                
    # Estimate dt by looking at x1_dot = x2 (common in many physical systems)   
    # or just assume a standard dt. Let's look at dx1 / x2.                     
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    # Let's try to fit dx/dt = Ax + b                                           
    # Since we don't know dt, we analyze dx = (Ax + b) * dt                     
    return x1, x2, dx1, dx2, n_points                                           
                                                                                
