import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load sample 0                                                                 
data = np.load('data_all/FaMoS/complex_tank/sample_0.npz')                      
state = data['state']                                                           
# I'll assume dt=0.01 or similar, let's try to find dt from the plot if 0.1     
looked too coarse                                                               
# Actually, the state shape is 10001, so if t spans say 100s, dt=0.01.          
# Let's check if there's a 't' or similar. Wait, the previous run said no 't'.  
# Usually these datasets have dt=0.01 or 0.1.                                   
dt = 0.01 # Guessing dt=0.01 for now.                                           
dx = np.diff(state, axis=1) / dt                                                
                                                                                
plt.figure(figsize=(12, 12))                                                    
for i in range(3):                                                              
    plt.subplot(3, 1, i+1)                                                      
    plt.plot(dx[i, :], label=f'dx{i+1}/dt')                                     
    plt.legend()                                                                
plt.savefig('derivatives.png')                                                  
plt.close()                                                                     
                                                                                
# Let's find intervals where dx[0] is negative and dx[1] is consistent          
# Draining mode: dx1 = -a*x1, dx2 = a*x1 - b*x2, dx3 = b*x2 - c*x3              
# Let's look at the values of dx.                                               
print("dx1 range:", np.min(dx[0, :]), np.max(dx[0, :]))                         
print("dx2 range:", np.min(dx[1, :]), np.max(dx[1, :]))                         
print("dx3 range:", np.min(dx[2, :]), np.max(dx[2, :]))                         
                                                                                
# Identifying refilling: large positive derivative.                             
refilling_x1 = dx[0, :] > 0                                                     
refilling_x2 = dx[1, :] > 1 # x2 has a positive term from x1 even when not      
refilling                                                                       
refilling_x3 = dx[2, :] > 1                                                     
                                                                                
# Let's find a purely draining period (all False)                               
draining_mask = ~(refilling_x1 | refilling_x2 | refilling_x3)                   
print("Number of draining points:", np.sum(draining_mask))                      
                                                                                
if np.sum(draining_mask) > 0:                                                   
    # Use least squares to find a, b, c                                         
    # dx1 = -a*x1                                                               
    x1 = state[0, :-1][draining_mask]                                           
    dx1 = dx[0, :][draining_mask]                                               
    a = -np.mean(dx1 / x1)                                                      
    print(f"Estimated a: {a}")                                                  
                                                                                
    # dx2 = a*x1 - b*x2 => b*x2 = a*x1 - dx2 => b = (a*x1 - dx2) / x2           
    x2 = state[1, :-1][draining_mask]                                           
    dx2 = dx[1, :][draining_mask]                                               
    b = np.mean((a * x1 - dx2) / x2)                                            
    print(f"Estimated b: {b}")                                                  
                                                                                
    # dx3 = b*x2 - c*x3 => c = (b*x2 - dx3) / x3                                
    x3 = state[2, :-1][draining_mask]                                           
    dx3 = dx[2, :][draining_mask]                                               
    c = np.mean((b * x2 - dx3) / x3)                                            
    print(f"Estimated c: {c}")                                                  
                                                                                
# Now estimate F1, F2, F3                                                       
