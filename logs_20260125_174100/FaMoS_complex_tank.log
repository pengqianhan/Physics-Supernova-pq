def get_pure_decay_periods(states, k1, k2, k3, C1, C2, C3, dt):                 
    x1, x2, x3 = states                                                         
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
    dx3 = np.diff(x3) / dt                                                      
                                                                                
    r1 = get_masks(x1)[:-1]                                                     
    r2 = get_masks(x2)[:-1]                                                     
    r3 = get_masks(x3)[:-1]                                                     
                                                                                
    pure_decay = ~(r1 | r2 | r3)                                                
                                                                                
    # Identify contiguous periods                                               
    periods = []                                                                
    if len(pure_decay) == 0: return periods                                     
                                                                                
    start = -1                                                                  
    for i in range(len(pure_decay)):                                            
        if pure_decay[i] and start == -1:                                       
            start = i                                                           
        elif not pure_decay[i] and start != -1:                                 
            periods.append((start * dt, i * dt))                                
            start = -1                                                          
    if start != -1:                                                             
        periods.append((start * dt, len(pure_decay) * dt))                      
    return periods                                                              
                                                                                
