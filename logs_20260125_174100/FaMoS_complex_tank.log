    r1, r2, r3, res1, res2, res3 = find_recharge_segments(states, k1, k2, k3)   
    if np.any(r1): c1_vals.append(np.mean(res1[r1]))                            
    if np.any(r2): c2_vals.append(np.mean(res2[r2]))                            
    if np.any(r3): c3_vals.append(np.mean(res3[r3]))                            
                                                                                
C1 = np.mean(c1_vals) if c1_vals else 0                                         
C2 = np.mean(c2_vals) if c2_vals else 0                                         
C3 = np.mean(c3_vals) if c3_vals else 0                                         
                                                                                
print(f"Final C estimates: C1={C1}, C2={C2}, C3={C3}")                          
                                                                                
