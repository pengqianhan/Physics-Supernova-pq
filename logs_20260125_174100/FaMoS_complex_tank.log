            if s_dx[idx] < 0 and s_dx[idx+1] > 0:                               
                mins.append(s_x[idx+1])                                         
            elif s_dx[idx] > 0 and s_dx[idx+1] < 0:                             
                maxs.append(s_x[idx+1])                                         
                                                                                
    if mins: print(f"{name} Lower Threshold (approx): {np.mean(mins):.4f}")     
    if maxs: print(f"{name} Upper Threshold (approx): {np.mean(maxs):.4f}")     
                                                                                
