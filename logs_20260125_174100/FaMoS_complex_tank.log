import numpy as np                                                              
                                                                                
# Load Sample 0 and Sample 1                                                    
data0 = np.load('data_all/FaMoS/complex_tank/sample_0.npz')                     
data1 = np.load('data_all/FaMoS/complex_tank/sample_1.npz')                     
                                                                                
X0 = data0['state']                                                             
X1 = data1['state']                                                             
dt = 0.001                                                                      
                                                                                
# 1. Fit k1, k2, k3 using the first 2 seconds of Sample 0 (indices 0 to 2000)   
idx_decay = np.arange(0, 2000)                                                  
x1_d, x2_d, x3_d = X0[0, idx_decay], X0[1, idx_decay], X0[2, idx_decay]         
dx1_d = (X0[0, 1:2001] - X0[0, 0:2000]) / dt                                    
dx2_d = (X0[1, 1:2001] - X0[1, 0:2000]) / dt                                    
dx3_d = (X0[2, 1:2001] - X0[2, 0:2000]) / dt                                    
                                                                                
k1 = -np.mean(dx1_d / x1_d)                                                     
k2 = np.mean((k1 * x1_d - dx2_d) / x2_d)                                        
k3 = np.mean((k2 * x2_d - dx3_d) / x3_d)                                        
                                                                                
# 2. R1 in Sample 0 around t=5.5s                                               
idx_r1 = np.arange(5400, 5600)                                                  
x1_r1 = X0[0, idx_r1]                                                           
dx1_r1 = (X0[0, 5401:5601] - X0[0, 5400:5600]) / dt                             
R1 = np.mean(dx1_r1 + k1 * x1_r1)                                               
                                                                                
# 3. R2 in Sample 0 around t=7.5s                                               
idx_r2 = np.arange(7400, 7600)                                                  
x1_r2, x2_r2 = X0[0, idx_r2], X0[1, idx_r2]                                     
dx2_r2 = (X0[1, 7401:7601] - X0[1, 7400:7600]) / dt                             
R2 = np.mean(dx2_r2 - k1 * x1_r2 + k2 * x2_r2)                                  
                                                                                
# 4. R3 in Sample 1 around t=0.5s                                               
idx_r3 = np.arange(400, 600)                                                    
x2_r3, x3_r3 = X1[1, idx_r3], X1[2, idx_r3]                                     
dx3_r3 = (X1[2, 401:601] - X1[2, 400:600]) / dt                                 
R3 = np.mean(dx3_r3 - k2 * x2_r3 + k3 * x3_r3)                                  
                                                                                
# 5. Switching thresholds check for x1 in Sample 0                              
res1 = (X0[0, 1:] - X0[0, :-1]) / dt + k1 * X0[0, :-1]                          
r1_active = res1 > (R1 / 2)                                                     
trans1 = np.where(np.diff(r1_active.astype(int)) != 0)[0]                       
th1_on = X0[0, trans1[0]]                                                       
th1_off = X0[0, trans1[1]]                                                      
                                                                                
# Print results                                                                 
print(f"k1: {k1:.4f}, k2: {k2:.4f}, k3: {k3:.4f}")                              
print(f"R1: {R1:.4f}, R2: {R2:.4f}, R3: {R3:.4f}")                              
print(f"x1 Thresholds - ON: {th1_on:.2f}, OFF: {th1_off:.2f}")                  
                                                                                
final_answer({                                                                  
