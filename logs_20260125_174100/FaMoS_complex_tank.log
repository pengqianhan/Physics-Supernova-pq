def fit_segment_mask(x_vals, dx_vals):                                          
    A = np.vstack([x_vals, np.ones(len(x_vals))]).T                             
    sol, residuals, rank, s = np.linalg.lstsq(A, dx_vals, rcond=None)           
    a, b = sol                                                                  
