import numpy as np                                                              
                                                                                
def fit_segment(x_segment):                                                     
    dx = np.diff(x_segment)                                                     
    x_prev = x_segment[:-1]                                                     
    A = np.vstack([x_prev, np.ones(len(x_prev))]).T                             
    sol, residuals, rank, s = np.linalg.lstsq(A, dx, rcond=None)                
    a, b = sol                                                                  
    rmse = np.sqrt(np.mean((dx - (a * x_prev + b))**2))                         
    return a, b, rmse                                                           
                                                                                
data = np.load('data_all/FaMoS/complex_tank/sample_0.npz')                      
x1 = data['state'][0]                                                           
# Segment 1: 0 to 5342 (decreasing)                                             
a1, b1, rmse1 = fit_segment(x1[0:5343])                                         
print(f"x1 dec: dx = {a1:.8f}*x + {b1:.8f} (RMSE: {rmse1:.2e})")                
                                                                                
# Segment 2: 5343 to 5864 (increasing)                                          
a2, b2, rmse2 = fit_segment(x1[5343:5865])                                      
print(f"x1 inc: dx = {a2:.8f}*x + {b2:.8f} (RMSE: {rmse2:.2e})")                
                                                                                
# Segment 3: 5865 to 9466 (decreasing)                                          
