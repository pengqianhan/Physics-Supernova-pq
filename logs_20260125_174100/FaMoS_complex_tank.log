# Fi is likely a large positive value when active, and 0 otherwise.             
                                                                                
# Let's detect fill segments for each                                           
fill_x1 = dx1 > 0                                                               
fill_x2 = dx2 > 0.1 # Using a heuristic for now                                 
fill_x3 = dx3 > 0.1                                                             
                                                                                
# Estimate k1 from segments where x1 is draining                                
k1_est = np.median(-dx1[~fill_x1] / x1[~fill_x1])                               
                                                                                
