u1_all = diffs[0] + a * all_states[0, :-1]                                      
u2_all = diffs[1] - a * all_states[0, :-1] + b * all_states[1, :-1]             
u3_all = diffs[2] - b * all_states[1, :-1] + c * all_states[2, :-1]             
                                                                                
# Identify when each tank is refilling (u > some threshold)                     
# Let's check the max of these u values.                                        
print(f"Max u1: {np.max(u1_all)}, Max u2: {np.max(u2_all)}, Max u3:             
{np.max(u3_all)}")                                                              
                                                                                
# Based on typical values, let's pick a threshold to identify refilling         
refill1 = u1_all > 0.01                                                         
refill2 = u2_all > 0.01                                                         
refill3 = u3_all > 0.01                                                         
                                                                                
# Calculate u constants                                                         
if np.any(refill1): print(f"u1 rate: {np.mean(u1_all[refill1])}")               
if np.any(refill2): print(f"u2 rate: {np.mean(u2_all[refill2])}")               
if np.any(refill3): print(f"u3 rate: {np.mean(u3_all[refill3])}")               
                                                                                
# Find thresholds                                                               
# Start refill: value of x_i when refill_i becomes True                         
# Stop refill: value of x_i when refill_i becomes False                         
