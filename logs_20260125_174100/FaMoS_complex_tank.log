# Load and concatenate all data                                                 
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # Transpose so shape is (steps, 3)                                          
    all_states.append(data['state'].T)                                          
                                                                                
states = np.concatenate(all_states, axis=0)                                     
diffs = states[1:] - states[:-1]                                                
states_prev = states[:-1]                                                       
                                                                                
# To identify when a tank is charging, we need to find periods where xi is      
increasing                                                                      
# or where the dynamics deviate from pure decay.                                
# Thresholds 15.0 and 20.0 are mentioned.                                       
# Let's check the range of the states.                                          
print("Min states:", np.min(states, axis=0))                                    
print("Max states:", np.max(states, axis=0))                                    
                                                                                
# Try to find 'decay only' steps.                                               
# In decay, x1[t+1] - x1[t] = -k1 * x1[t]. So x1[t+1] - x1[t] < 0.              
# If xi is charging, xi[t+1] - xi[t] will likely be positive.                   
# Let's find indices where all diffs are small or negative.                     
is_charging = np.zeros(diffs.shape, dtype=bool)                                 
                                                                                
# Since we don't know the k's yet, let's use the threshold logic.               
# If xi starts charging at 15.0 and stops at 20.0, we can detect it.            
# However, let's first look at the distribution of differences.                 
print("Mean diffs:", np.mean(diffs, axis=0))                                    
print("Std diffs:", np.std(diffs, axis=0))                                      
                                                                                
