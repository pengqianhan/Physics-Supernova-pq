# x2' = a*x1 - b*x2 => b = (a*x1 - x2') / x2                                    
b = np.mean((a * S[0, :-1] - D[1]) / S[1, :-1])                                 
print(f"Estimated b: {b}")                                                      
                                                                                
# x3' = b*x2 - c*x3 => c = (b*x2 - x3') / x3                                    
c = np.mean((b * S[1, :-1] - D[2]) / S[2, :-1])                                 
print(f"Estimated c: {c}")                                                      
                                                                                
