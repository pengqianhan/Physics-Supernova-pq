def get_params(var_idx, samples):                                               
    all_dx = []                                                                 
    all_x = []                                                                  
                                                                                
    # Pool all data to find a and b                                             
    for state in samples:                                                       
        x = state[var_idx, :-1]                                                 
        dx = np.diff(state[var_idx, :])                                         
        all_x.extend(x)                                                         
        all_dx.extend(dx)                                                       
                                                                                
    all_x = np.array(all_x)                                                     
    all_dx = np.array(all_dx)                                                   
                                                                                
    # Identify modes.                                                           
    # Use a_est from previous iteration or estimate again                       
    # a ~ 0.00008, 0.00007, 0.00005                                             
    # Let's use a very small threshold for dx + a*x to separate b               
    # Actually, we can just look at the distribution of dx/x                    
    ratios = all_dx / all_x                                                     
    # The most negative cluster is -a.                                          
    a_val = -np.percentile(ratios, 10)                                          
                                                                                
    # Separate modes                                                            
    # b_vals = dx + a*x. In decay, b_vals ~ 0. In recharge, b_vals ~ b.         
    b_vals = all_dx + a_val * all_x                                             
    b_val = np.max(b_vals)                                                      
                                                                                
    # Let's classify each point                                                 
    is_recharge = b_vals > b_val * 0.5                                          
                                                                                
    # Re-estimate a and b more accurately                                       
    a_final = -np.mean(all_dx[~is_recharge] / all_x[~is_recharge])              
    b_final = np.mean(all_dx[is_recharge] + a_final * all_x[is_recharge])       
                                                                                
    # Find thresholds by looking at transitions in each sample                  
    min_thresholds = []                                                         
    max_thresholds = []                                                         
                                                                                
    for s_idx, state in enumerate(samples):                                     
        x = state[var_idx, :-1]                                                 
        dx = np.diff(state[var_idx, :])                                         
        b_v = dx + a_final * x                                                  
        recharge = b_v > b_final * 0.5                                          
                                                                                
        switches = np.diff(recharge.astype(int))                                
        # switch == 1: decay -> recharge (at min)                               
        # switch == -1: recharge -> decay (at max)                              
                                                                                
        for idx in np.where(switches == 1)[0]:                                  
            min_thresholds.append(state[:, idx])                                
        for idx in np.where(switches == -1)[0]:                                 
            max_thresholds.append(state[:, idx])                                
                                                                                
    return a_final, b_final, np.array(min_thresholds), np.array(max_thresholds) 
                                                                                
