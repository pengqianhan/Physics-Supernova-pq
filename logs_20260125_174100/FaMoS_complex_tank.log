dx2_full = np.concatenate(all_dx2)                                              
dx3_full = np.concatenate(all_dx3)                                              
                                                                                
def check_dynamics(x, dx, name):                                                
    inc = dx > 0                                                                
    dec = dx < 0                                                                
                                                                                
    print(f"--- {name} Analysis ---")                                           
    if np.any(inc):                                                             
        x_inc = x[inc]                                                          
        dx_inc = dx[inc]                                                        
        coeffs = np.polyfit(x_inc, dx_inc, 1)                                   
        print(f"Increasing: dx/dt = {coeffs[0]:.6f}*x + {coeffs[1]:.6f}")       
        # Correlation check                                                     
        corr = np.corrcoef(x_inc, dx_inc)[0,1]                                  
        print(f"Correlation (Inc): {corr:.6f}")                                 
                                                                                
    if np.any(dec):                                                             
        x_dec = x[dec]                                                          
        dx_dec = dx[dec]                                                        
        coeffs = np.polyfit(x_dec, dx_dec, 1)                                   
        print(f"Decreasing: dx/dt = {coeffs[0]:.6f}*x + {coeffs[1]:.6f}")       
        corr = np.corrcoef(x_dec, dx_dec)[0,1]                                  
        print(f"Correlation (Dec): {corr:.6f}")                                 
                                                                                
    # Thresholds: look at where sign changes                                    
    # A sign change from - to + happens at the lower threshold                  
    # A sign change from + to - happens at the upper threshold                  
    # Since we have multiple samples, let's look at the extrema in each         
    mins = []                                                                   
    maxs = []                                                                   
    for s_x in all_x1 if name == "x1" else (all_x2 if name == "x2" else all_x3):
        # Local minima and maxima can be found by looking at where dx changes   
sign                                                                            
        s_dx = np.diff(s_x)                                                     
        # Sign change indices                                                   
        sign_changes = np.where(np.diff(np.sign(s_dx)))[0]                      
