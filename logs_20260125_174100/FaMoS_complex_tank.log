def get_masks(x, start_thresh=15.0, stop_thresh=20.0):                          
    recharging = np.zeros(len(x), dtype=bool)                                   
    current_state = False # start in decay (usually)                            
    if x[0] < start_thresh: # Actually check initial                            
        current_state = True                                                    
                                                                                
    for i in range(len(x)):                                                     
        if not current_state and x[i] <= start_thresh:                          
            current_state = True                                                
        elif current_state and x[i] >= stop_thresh:                             
            current_state = False                                               
        recharging[i] = current_state                                           
    return recharging                                                           
                                                                                
