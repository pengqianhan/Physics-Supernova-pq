    # Now find b2                                                               
    # b2 = dx2 - k1*x1 + k2*x2                                                  
    b2_vals = dx2 - k1 * x1 + k2 * x2                                           
    mask_refill2 = b2_vals > 0.1                                                
    b2 = np.median(b2_vals[mask_refill2])                                       
                                                                                
    # K3 and B3                                                                 
    # dx3 = k2*x2 - k3*x3 + b3                                                  
