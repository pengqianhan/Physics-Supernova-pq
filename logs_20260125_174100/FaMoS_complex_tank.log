import numpy as np                                                              
                                                                                
def fit_linear_model(X, y):                                                     
    A = np.column_stack([X, np.ones(X.shape[0])])                               
    p, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)                   
    return p                                                                    
                                                                                
all_states = []                                                                 
for s_idx in range(3):                                                          
    data = np.load(f'data_all/FaMoS/complex_tank/sample_{s_idx}.npz')           
    all_states.append(data['state'].T)                                          
                                                                                
dx2_data, x2_data, x1_ref_data = [], [], []                                     
dx3_data, x3_data, x2_ref_data = [], [], []                                     
                                                                                
for s in all_states:                                                            
    dx2 = np.diff(s[:, 1])                                                      
    dx3 = np.diff(s[:, 2])                                                      
    for t in range(len(dx2)):                                                   
        if dx2[t] < 0:                                                          
            dx2_data.append(dx2[t])                                             
            x2_data.append(s[t, 1])                                             
            x1_ref_data.append(s[t, 0])                                         
        if dx3[t] < 0:                                                          
            dx3_data.append(dx3[t])                                             
            x3_data.append(s[t, 2])                                             
            x2_ref_data.append(s[t, 1])                                         
                                                                                
p2 = fit_linear_model(np.column_stack([x2_data, x1_ref_data]),                  
np.array(dx2_data))                                                             
p3 = fit_linear_model(np.column_stack([x3_data, x2_ref_data]),                  
np.array(dx3_data))                                                             
                                                                                
print(f"dx2 = {p2[0]:.10f}*x2 + {p2[1]:.10f}*x1 + {p2[2]:.10f}")                
print(f"dx3 = {p3[0]:.10f}*x3 + {p3[1]:.10f}*x2 + {p3[2]:.10f}")                
                                                                                
# Compare with model without x_prev                                             
