  def analyze_variable(states, var_idx):                                        
      x = states[var_idx, :-1]                                                  
      dx = np.diff(states[var_idx, :])                                          
                                                                                
      # Let's use the ratio dx/x to identify modes.                             
      # For decay: dx/x = -a                                                    
      # For recharge: dx/x = -a + b/x                                           
                                                                                
      # Since we have many points, we can look at the distribution of dx/x      
      ratios = dx / x                                                           
                                                                                
      # In decay mode, ratios should be constant (-a).                          
      # In recharge mode, ratios should be (-a + b/x).                          
      # Usually b is positive and a is positive.                                
      # So ratios in recharge mode will be greater than -a.                     
                                                                                
      # Estimate 'a' from the minimum ratios (most negative, which correspond   
  to decay)                                                                     
      # Actually, we should look for a cluster of values.                       
      a_est = -np.percentile(ratios, 5) # Use a low percentile to find the      
  decay ratio                                                                   
                                                                                
      # Separate points into decay and recharge                                 
      # Let's use a small threshold.                                            
      decay_mask = ratios < (-a_est + 1e-6) # Allowing some noise               
      recharge_mask = ~decay_mask                                               
                                                                                
      # Refine a_est using only decay points                                    
      if np.any(decay_mask):                                                    
          a_val = -np.mean(ratios[decay_mask])                                  
      else:                                                                     
          a_val = 0                                                             
                                                                                
      # Find b                                                                  
      # dx = -a*x + b  =>  b = dx + a*x                                         
      if np.any(recharge_mask):                                                 
          b_vals = dx[recharge_mask] + a_val * x[recharge_mask]                 
          b_val = np.mean(b_vals)                                               
                                                                                
          # Find thresholds                                                     
          # x_min: value where it switches from decay to recharge.              
          # This occurs at the end of a decay sequence.                         
          # x_max: value where it switches from recharge to decay.              
          # This occurs at the end of a recharge sequence.                      
                                                                                
          # Identify transitions                                                
          # mode: 0 for decay, 1 for recharge                                   
          modes = recharge_mask.astype(int)                                     
          mode_diff = np.diff(modes)                                            
                                                                                
          # switch from decay to recharge: mode_diff == 1                       
          # at index t, it's 0, at t+1 it's 1. x[t] is the minimum.             
          x_min_candidates = x[np.where(mode_diff == 1)[0]]                     
          x_min = np.mean(x_min_candidates) if len(x_min_candidates) > 0 else   
  np.min(x)                                                                     
                                                                                
          # switch from recharge to decay: mode_diff == -1                      
          x_max_candidates = x[np.where(mode_diff == -1)[0]]                    
          x_max = np.mean(x_max_candidates) if len(x_max_candidates) > 0 else   
  np.max(x)                                                                     
                                                                                
      else:                                                                     
          b_val = 0                                                             
          x_min = np.min(x)                                                     
          x_max = np.max(x)                                                     
                                                                                
      return a_val, b_val, x_min, x_max                                         
                                                                                
  samples = []                                                                  
  for i in range(3):                                                            
