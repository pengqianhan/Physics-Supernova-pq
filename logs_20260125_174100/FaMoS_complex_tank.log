drain_x1_idx = np.where(dx1 < 0)[0]                                             
if len(drain_x1_idx) > 0:                                                       
    k1_vals = -dx1[drain_x1_idx] / x1[drain_x1_idx]                             
    k1_est = np.median(k1_vals)                                                 
    print(f"Estimated k1 (if dt=1): {k1_est}")                                  
                                                                                
