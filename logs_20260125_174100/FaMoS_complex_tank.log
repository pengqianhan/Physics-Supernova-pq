      DX1 = []                                                                  
      X2 = []                                                                   
      DX2 = []                                                                  
      X3 = []                                                                   
      DX3 = []                                                                  
                                                                                
      for states in all_states:                                                 
          x1, x2, x3 = states[:, :1000]                                         
          dx1 = np.diff(x1) / dt                                                
          dx2 = np.diff(x2) / dt                                                
          dx3 = np.diff(x3) / dt                                                
                                                                                
          X1.append(x1[:-1])                                                    
          DX1.append(dx1)                                                       
          X2.append(x2[:-1])                                                    
          DX2.append(dx2)                                                       
          X3.append(x3[:-1])                                                    
          DX3.append(dx3)                                                       
                                                                                
      X1 = np.concatenate(X1)                                                   
      DX1 = np.concatenate(DX1)                                                 
      X2 = np.concatenate(X2)                                                   
      DX2 = np.concatenate(DX2)                                                 
      X3 = np.concatenate(X3)                                                   
      DX3 = np.concatenate(DX3)                                                 
                                                                                
      # x1_dot = -k1 * x1 => k1 = -sum(dx1 * x1) / sum(x1^2)                    
      k1 = -np.sum(DX1 * X1) / np.sum(X1**2)                                    
                                                                                
      # x2_dot = k1 * x1 - k2 * x2 => k2 * x2 = k1 * x1 - x2_dot                
      # k2 = sum((k1*x1 - dx2) * x2) / sum(x2^2)                                
      k2 = np.sum((k1 * X1 - DX2) * X2) / np.sum(X2**2)                         
                                                                                
      # x3_dot = k2 * x2 - k3 * x3 => k3 * x3 = k2 * x2 - x3_dot                
      k3 = np.sum((k2 * X2 - DX3) * X3) / np.sum(X3**2)                         
                                                                                
      return k1, k2, k3                                                         
                                                                                
  k1, k2, k3 = estimate_ks(all_states)                                          
  print(f"Final k estimates: k1={k1}, k2={k2}, k3={k3}")                        
                                                                                
  # Now find C's.                                                               
  # Detect recharging segments for each variable                                
  def find_recharge_segments(states, k1, k2, k3, dt=0.01):                      
      x1, x2, x3 = states                                                       
      dx1 = np.diff(x1) / dt                                                    
      dx2 = np.diff(x2) / dt                                                    
      dx3 = np.diff(x3) / dt                                                    
                                                                                
      res1 = dx1 + k1 * x1[:-1]                                                 
      res2 = dx2 - (k1 * x1[:-1] - k2 * x2[:-1])                                
      res3 = dx3 - (k2 * x2[:-1] - k3 * x3[:-1])                                
                                                                                
      # Use a threshold to find recharging periods                              
      recharge1 = np.abs(res1) > 0.1                                            
      recharge2 = np.abs(res2) > 0.1                                            
      recharge3 = np.abs(res3) > 0.1                                            
                                                                                
      return recharge1, recharge2, recharge3, res1, res2, res3                  
                                                                                
  # Find C1, C2, C3                                                             
  c1_vals = []                                                                  
  c2_vals = []                                                                  
  c3_vals = []                                                                  
                                                                                
  for states in all_states:                                                     
      r1, r2, r3, res1, res2, res3 = find_recharge_segments(states, k1, k2,     
  k3)                                                                           
      if np.any(r1): c1_vals.append(np.mean(res1[r1]))                          
      if np.any(r2): c2_vals.append(np.mean(res2[r2]))                          
      if np.any(r3): c3_vals.append(np.mean(res3[r3]))                          
                                                                                
  C1 = np.mean(c1_vals) if c1_vals else 0                                       
  C2 = np.mean(c2_vals) if c2_vals else 0                                       
  C3 = np.mean(c3_vals) if c3_vals else 0                                       
                                                                                
  print(f"Final C estimates: C1={C1}, C2={C2}, C3={C3}")                        
