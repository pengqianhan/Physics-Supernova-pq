# Detect recharging segments for each variable                                  
def find_recharge_segments(states, k1, k2, k3, dt=0.01):                        
    x1, x2, x3 = states                                                         
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
    dx3 = np.diff(x3) / dt                                                      
                                                                                
    res1 = dx1 + k1 * x1[:-1]                                                   
    res2 = dx2 - (k1 * x1[:-1] - k2 * x2[:-1])                                  
    res3 = dx3 - (k2 * x2[:-1] - k3 * x3[:-1])                                  
                                                                                
    # Use a threshold to find recharging periods                                
    recharge1 = np.abs(res1) > 0.1                                              
    recharge2 = np.abs(res2) > 0.1                                              
    recharge3 = np.abs(res3) > 0.1                                              
                                                                                
    return recharge1, recharge2, recharge3, res1, res2, res3                    
                                                                                
# Find C1, C2, C3                                                               
