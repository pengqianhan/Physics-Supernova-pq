# Let's identify the modes at each time step                                    
def get_modes(path):                                                            
    data = np.load(path)                                                        
    state = data['state']                                                       
    dx = np.diff(state, axis=1)                                                 
    # 0 if draining, 1 if refilling                                             
    modes = (dx > 0).astype(int)                                                
    # Unique mode combinations                                                  
    unique_modes = np.unique(modes, axis=1)                                     
    return modes, unique_modes, state                                           
                                                                                
all_modes = []                                                                  
