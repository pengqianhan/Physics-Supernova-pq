import numpy as np                                                              
                                                                                
# Use linear regression to find k values more accurately                        
# dx1 = -k1 * x1                                                                
# dx2 = k1 * x1 - k2 * x2                                                       
# dx3 = k2 * x2 - k3 * x3                                                       
                                                                                
all_x1, all_x2, all_x3 = [], [], []                                             
all_dx1, all_dx2, all_dx3 = [], [], []                                          
                                                                                
for i in range(3):                                                              
    data = np.load(f'data_all/FaMoS/complex_tank/sample_{i}.npz')['state']      
    x1, x2, x3 = data                                                           
    dx1, dx2, dx3 = np.diff(x1), np.diff(x2), np.diff(x3)                       
                                                                                
    # Filter for no refill                                                      
    no_ref = (dx1 < 0) & (dx2 < 0) & (dx3 < 0)                                  
    all_x1.extend(x1[:-1][no_ref])                                              
    all_x2.extend(x2[:-1][no_ref])                                              
    all_x3.extend(x3[:-1][no_ref])                                              
    all_dx1.extend(dx1[no_ref])                                                 
    all_dx2.extend(dx2[no_ref])                                                 
    all_dx3.extend(dx3[no_ref])                                                 
                                                                                
all_x1, all_x2, all_x3 = np.array(all_x1), np.array(all_x2), np.array(all_x3)   
all_dx1, all_dx2, all_dx3 = np.array(all_dx1), np.array(all_dx2),               
np.array(all_dx3)                                                               
                                                                                
# k1: dx1 = -k1 * x1                                                            
k1 = - np.sum(all_dx1 * all_x1) / np.sum(all_x1**2)                             
                                                                                
# k2: dx2 = k1 * x1 - k2 * x2 => dx2 - k1 * x1 = -k2 * x2                       
k2 = - np.sum((all_dx2 - k1 * all_x1) * all_x2) / np.sum(all_x2**2)             
                                                                                
# k3: dx3 = k2 * x2 - k3 * x3 => dx3 - k2 * x2 = -k3 * x3                       
k3 = - np.sum((all_dx3 - k2 * all_x2) * all_x3) / np.sum(all_x3**2)             
                                                                                
print(f"Refined k: k1={k1:.8f}, k2={k2:.8f}, k3={k3:.8f}")                      
                                                                                
# Now find q values                                                             
all_q1, all_q2, all_q3 = [], [], []                                             
for i in range(3):                                                              
    data = np.load(f'data_all/FaMoS/complex_tank/sample_{i}.npz')['state']      
    x1, x2, x3 = data                                                           
    dx1, dx2, dx3 = np.diff(x1), np.diff(x2), np.diff(x3)                       
                                                                                
    q1_vals = dx1[dx1 > 0.001] + k1 * x1[:-1][dx1 > 0.001]                      
    if len(q1_vals) > 0: all_q1.extend(q1_vals)                                 
                                                                                
    q2_vals = dx2[dx2 > 0.001] - k1 * x1[:-1][dx2 > 0.001] + k2 * x2[:-1][dx2 > 
0.001]                                                                          
    if len(q2_vals) > 0: all_q2.extend(q2_vals)                                 
                                                                                
    q3_vals = dx3[dx3 > 0.001] - k2 * x2[:-1][dx3 > 0.001] + k3 * x3[:-1][dx3 > 
0.001]                                                                          
    if len(q3_vals) > 0: all_q3.extend(q3_vals)                                 
                                                                                
print(f"Refined q: q1={np.mean(all_q1):.6f}, q2={np.mean(all_q2):.6f},          
q3={np.mean(all_q3):.6f}")                                                      
                                                                                
