import numpy as np                                                              
                                                                                
# Load data                                                                     
data_0 = np.load('data_all/FaMoS/complex_tank/sample_0.npz')                    
x = data_0['state']                                                             
dt = 0.1 # Assumed time step from common simulation defaults                    
                                                                                
# x has shape (3, 10001)                                                        
x1, x2, x3 = x[0], x[1], x[2]                                                   
                                                                                
# Compute numerical derivatives                                                 
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
dx3 = np.diff(x3) / dt                                                          
x1_mid = x1[:-1]                                                                
x2_mid = x2[:-1]                                                                
x3_mid = x3[:-1]                                                                
                                                                                
# Estimate Decay Coefficients (k1, k2, k3)                                      
# We look for regions where x is decreasing (decaying) and not recharging       
# Decay-only indices for x1: when x1 is between 16 and 20 and decreasing        
# (avoiding the exact threshold points)                                         
decay_mask1 = (x1_mid > 16) & (x1_mid < 19) & (dx1 < 0)                         
k1 = -np.mean(dx1[decay_mask1] / x1_mid[decay_mask1])                           
                                                                                
decay_mask2 = (x2_mid > 16) & (x2_mid < 19) & (dx2 < k1 * x1_mid - 0.05) # dx2  
should be ~ k1*x1 - k2*x2                                                       
k2 = np.mean((k1 * x1_mid[decay_mask2] - dx2[decay_mask2]) /                    
x2_mid[decay_mask2])                                                            
                                                                                
decay_mask3 = (x3_mid > 16) & (x3_mid < 19) & (dx3 < k2 * x2_mid - 0.05)        
k3 = np.mean((k2 * x2_mid[decay_mask3] - dx3[decay_mask3]) /                    
x3_mid[decay_mask3])                                                            
                                                                                
# Identify Recharge Rates (R1, R2, R3)                                          
# When recharging, dx1 = -k1*x1 + R1 => R1 = dx1 + k1*x1                        
recharge_mask1 = dx1 > 0                                                        
R1 = np.mean(dx1[recharge_mask1] + k1 * x1_mid[recharge_mask1])                 
                                                                                
recharge_mask2 = dx2 > (k1 * x1_mid - k2 * x2_mid + 0.5)                        
R2 = np.mean(dx2[recharge_mask2] - (k1 * x1_mid[recharge_mask2] - k2 *          
x2_mid[recharge_mask2]))                                                        
                                                                                
recharge_mask3 = dx3 > (k2 * x2_mid - k3 * x3_mid + 0.5)                        
R3 = np.mean(dx3[recharge_mask3] - (k2 * x2_mid[recharge_mask3] - k3 *          
x3_mid[recharge_mask3]))                                                        
                                                                                
# Identify Precise Thresholds                                                   
low_th1, high_th1 = np.min(x1[recharge_mask1]), np.max(x1[recharge_mask1])      
low_th2, high_th2 = np.min(x2[recharge_mask2]), np.max(x2[recharge_mask2])      
low_th3, high_th3 = np.min(x3[recharge_mask3]), np.max(x3[recharge_mask3])      
                                                                                
# Analyze Mode Combinations                                                     
mode_1 = recharge_mask1.astype(int)                                             
mode_2 = recharge_mask2.astype(int)                                             
mode_3 = recharge_mask3.astype(int)                                             
modes = np.column_stack((mode_1, mode_2, mode_3))                               
unique_modes = np.unique(modes, axis=0)                                         
                                                                                
final_answer(f"""### 1. Task outcome (short version):                           
The system follows a coupled tank model with decay constants k1 ≈ {k1:.3f}, k2 ≈
{k2:.3f}, k3 ≈ {k3:.3f}.                                                        
Recharge rates are R1 ≈ {R1:.1f}, R2 ≈ {R2:.1f}, R3 ≈ {R3:.1f}.                 
Switching thresholds are approximately 15.0 (low) and 20.0 (high) for all       
variables.                                                                      
The system exhibits {len(unique_modes)} unique recharging modes.                
                                                                                
### 2. Task outcome (extremely detailed version):                               
**Decay Dynamics:**                                                             
The dynamics during the decay phase (where R=0) match the model:                
- dx1/dt = -k1 * x1                                                             
- dx2/dt = k1 * x1 - k2 * x2                                                    
- dx3/dt = k2 * x2 - k3 * x3                                                    
Estimated parameters (assuming dt=0.1):                                         
- k1 = {k1:.4f}                                                                 
- k2 = {k2:.4f}                                                                 
- k3 = {k3:.4f}                                                                 
                                                                                
**Recharge Dynamics:**                                                          
When a variable recharges, a constant rate R is added to its derivative:        
- R1 = {R1:.2f}                                                                 
- R2 = {R2:.2f}                                                                 
- R3 = {R3:.2f}                                                                 
                                                                                
**Threshold Analysis:**                                                         
The hysteresis-like switching occurs at:                                        
