# For each tank, find when b starts and ends                                    
def find_thresholds(tank_idx, k_prev, k_curr, b_curr):                          
    thresholds = []                                                             
    for i in range(3):                                                          
        data = np.load(f'data_all/FaMoS/complex_tank/sample_{i}.npz')['state']  
        x = data[tank_idx]                                                      
        dx = np.diff(x) / dt                                                    
        if tank_idx == 0:                                                       
            source = 0                                                          
        elif tank_idx == 1:                                                     
            source = k_prev * data[0, :-1]                                      
        else:                                                                   
            source = k_prev * data[1, :-1]                                      
                                                                                
        b_calc = dx - source + k_curr * x[:-1]                                  
        active = b_calc > b_curr * 0.5                                          
        # Find transition points                                                
        for j in range(1, len(active)):                                         
            if active[j] != active[j-1]:                                        
                thresholds.append(x[j])                                         
    return thresholds                                                           
                                                                                
