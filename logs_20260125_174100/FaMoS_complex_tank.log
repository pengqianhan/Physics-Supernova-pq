k2_vals = (k1_est * x1[drain_x2_idx] - dx2[drain_x2_idx]) / x2[drain_x2_idx]    
k2_est = np.median(k2_vals)                                                     
                                                                                
# Estimate k3 from segments where x3 is draining (and we know k2)               
# dx3 = k2*x2 - k3*x3 => k3 = (k2*x2 - dx3) / x3                                
drain_x3_idx = np.where(dx3 < 0)[0]                                             
k3_vals = (k2_est * x2[drain_x3_idx] - dx3[drain_x3_idx]) / x3[drain_x3_idx]    
k3_est = np.median(k3_vals)                                                     
                                                                                
print(f"k1: {k1_est}, k2: {k2_est}, k3: {k3_est}")                              
                                                                                
# Now find Fill rates Fi                                                        
# dx1 = -k1*x1 + F1 => F1 = dx1 + k1*x1                                         
# F1 should be ~0 when not filling, and F1_val when filling.                    
f1_all = dx1 + k1_est * x1[:-1]                                                 
f1_fill = f1_all[fill_x1]                                                       
f1_est = np.median(f1_fill) if len(f1_fill) > 0 else 0                          
                                                                                
f2_all = dx2 - k1_est * x1[:-1] + k2_est * x2[:-1]                              
# For x2, fill is when dx2 > k1*x1 - k2*x2                                      
f2_fill_idx = np.where(f2_all > 0.1)[0]                                         
f2_est = np.median(f2_all[f2_fill_idx]) if len(f2_fill_idx) > 0 else 0          
                                                                                
f3_all = dx3 - k2_est * x2[:-1] + k3_est * x3[:-1]                              
f3_fill_idx = np.where(f3_all > 0.1)[0]                                         
f3_est = np.median(f3_all[f3_fill_idx]) if len(f3_fill_idx) > 0 else 0          
                                                                                
print(f"F1: {f1_est}, F2: {f2_est}, F3: {f3_est}")                              
                                                                                
# Thresholds                                                                    
# x1 starts filling when it hits low_threshold, stops at high_threshold.        
# Find points where fill starts (dx1 switches from <=0 to >0)                   
start_fill_x1 = np.where((dx1[:-1] <= 0) & (dx1[1:] > 0))[0] + 1                
stop_fill_x1 = np.where((dx1[:-1] > 0) & (dx1[1:] <= 0))[0] + 1                 
                                                                                
low1 = np.mean(x1[start_fill_x1])                                               
high1 = np.mean(x1[stop_fill_x1])                                               
                                                                                
# Same for x2 and x3                                                            
