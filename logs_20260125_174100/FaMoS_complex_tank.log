  x1, x2, x3 = x[0], x[1], x[2]                                                 
  dx1 = np.diff(x1) / dt                                                        
  dx2 = np.diff(x2) / dt                                                        
  dx3 = np.diff(x3) / dt                                                        
  x1_m, x2_m, x3_m = x1[:-1], x2[:-1], x3[:-1]                                  
                                                                                
  # Identify recharge masks based on the derivative increase                    
  # For x1: dx1 = -k1*x1 + R1*I1. If I1=0, dx1/x1 = -k1.                        
  # Usually, k is small, so dx1/x1 will be around -0.1. If it's positive, it's  
  recharging.                                                                   
  recharge_mask1 = dx1 > 0                                                      
  # For x2 and x3, we can use the derivative relative to the previous tank's    
  flow.                                                                         
  # However, the prompt says recharge starts around 15 and stops around 20.     
  # Let's detect the sharp jumps in the derivative.                             
  recharge_mask1 = dx1 > 0                                                      
  recharge_mask2 = dx2 > 0.5 # Heuristic: if derivative is positive and large   
  recharge_mask3 = dx3 > 0.5                                                    
                                                                                
  # Refine masks using the 15-20 threshold hint                                 
  # A variable is recharging if it's below 20 and was recently below 15, or if  
  it's increasing.                                                              
  # Let's use the derivative being significantly higher than expected.          
  # We'll solve for k1 first using the most certain decay periods for x1 (high  
  values, negative derivative)                                                  
  mask_decay1 = (x1_m > 21) & (dx1 < 0)                                         
  k1 = -np.mean(dx1[mask_decay1] / x1_m[mask_decay1])                           
                                                                                
  # Now use k1 to find recharge periods for x1                                  
  # dx1 + k1*x1 = R1 * I1                                                       
  res1 = dx1 + k1 * x1_m                                                        
  # R1 should be the value of res1 when I1=1. We can use a threshold.           
  R1 = np.mean(res1[res1 > 1.0])                                                
  recharge_mask1 = res1 > 1.0                                                   
                                                                                
  # Now for x2: dx2 = k1*x1 - k2*x2 + R2*I2                                     
  # When I2=0, dx2 - k1*x1 = -k2*x2                                             
  res2_decay = dx2 - k1 * x1_m                                                  
  mask_decay2 = (x2_m > 21) & (res2_decay < -0.1)                               
  k2 = -np.mean(res2_decay[mask_decay2] / x2_m[mask_decay2])                    
                                                                                
  # Recharge x2                                                                 
  res2 = dx2 - (k1 * x1_m - k2 * x2_m)                                          
  R2 = np.mean(res2[res2 > 1.0])                                                
  recharge_mask2 = res2 > 1.0                                                   
                                                                                
  # Now for x3: dx3 = k2*x2 - k3*x3 + R3*I3                                     
  res3_decay = dx3 - k2 * x2_m                                                  
  mask_decay3 = (x3_m > 21) & (res3_decay < -0.1)                               
  k3 = -np.mean(res3_decay[mask_decay3] / x3_m[mask_decay3])                    
                                                                                
  # Recharge x3                                                                 
  res3 = dx3 - (k2 * x2_m - k3 * x3_m)                                          
  R3 = np.mean(res3[res3 > 1.0])                                                
  recharge_mask3 = res3 > 1.0                                                   
                                                                                
  # Thresholds: find x values at the start and end of recharge                  
  # Start of recharge: I_i goes from 0 to 1                                     
  # End of recharge: I_i goes from 1 to 0                                       
  def get_thresholds(x_val, mask):                                              
      starts = np.where(np.diff(mask.astype(int)) == 1)[0]                      
      stops = np.where(np.diff(mask.astype(int)) == -1)[0]                      
      low = np.mean(x_val[starts]) if len(starts) > 0 else 15.0                 
      high = np.mean(x_val[stops]) if len(stops) > 0 else 20.0                  
      return low, high                                                          
                                                                                
  th1_low, th1_high = get_thresholds(x1_m, recharge_mask1)                      
  th2_low, th2_high = get_thresholds(x2_m, recharge_mask2)                      
  th3_low, th3_high = get_thresholds(x3_m, recharge_mask3)                      
                                                                                
  # Mode combinations                                                           
  modes = np.column_stack((recharge_mask1.astype(int),                          
  recharge_mask2.astype(int), recharge_mask3.astype(int)))                      
  unique_modes = np.unique(modes, axis=0)                                       
                                                                                
  print(f"k: {k1}, {k2}, {k3}")                                                 
  print(f"R: {R1}, {R2}, {R3}")                                                 
  print(f"Th: {th1_low}-{th1_high}, {th2_low}-{th2_high},                       
  {th3_low}-{th3_high}")                                                        
  print(f"Unique modes: {unique_modes.tolist()}")                               
                                                                                
  final_answer({                                                                
      "k1": k1, "k2": k2, "k3": k3,                                             
      "R1": R1, "R2": R2, "R3": R3,                                             
