import numpy as np                                                              
from scipy.optimize import minimize                                             
                                                                                
dt = 0.01                                                                       
                                                                                
def solve_for_all():                                                            
    all_x = []                                                                  
    all_dx = []                                                                 
    for i in range(3):                                                          
        data = np.load(f'data_all/FaMoS/complex_tank/sample_{i}.npz')['state']  
        all_x.append(data[:, :-1])                                              
        all_dx.append(np.diff(data) / dt)                                       
                                                                                
    x = np.concatenate(all_x, axis=1)                                           
    dx = np.concatenate(all_dx, axis=1)                                         
                                                                                
    x1, x2, x3 = x                                                              
    dx1, dx2, dx3 = dx                                                          
                                                                                
    # Identify modes for each point                                             
    # Mode 1 (x1 refill): b1 active                                             
    # Mode 2 (x2 refill): b2 active                                             
    # Mode 3 (x3 refill): b3 active                                             
    # We can use the 15-20 logic.                                               
                                                                                
    modes = np.zeros(x.shape[1])                                                
    for i in range(3):                                                          
        data = np.load(f'data_all/FaMoS/complex_tank/sample_{i}.npz')['state']  
        sample_modes = np.zeros(data.shape[1]-1)                                
        refilling_tank = 0 # 0: none, 1: x1, 2: x2, 3: x3                       
                                                                                
        # State tracking for hysteresis                                         
        for t in range(data.shape[1]-1):                                        
            vals = data[:, t]                                                   
            if refilling_tank == 0:                                             
                if vals[0] < 15: refilling_tank = 1                             
                elif vals[1] < 15: refilling_tank = 2                           
                elif vals[2] < 15: refilling_tank = 3                           
            else:                                                               
                if data[refilling_tank-1, t] > 20:                              
                    refilling_tank = 0                                          
                    # Check again for other tanks immediately?                  
                    # Let's see if another tank is already below 15             
                    if vals[0] < 15: refilling_tank = 1                         
                    elif vals[1] < 15: refilling_tank = 2                       
                    elif vals[2] < 15: refilling_tank = 3                       
                                                                                
            sample_modes[t] = refilling_tank                                    
                                                                                
        # Start index in the concatenated array                                 
        start = i * 10000                                                       
        modes[start:start+10000] = sample_modes                                 
                                                                                
    # Now we have modes. Let's solve the equations.                             
    # Tank 1: dx1 = -k1*x1 + b1_val                                             
    # b1_val = B1 if mode == 1 else 0                                           
    def resid1(params):                                                         
        k1, B1 = params                                                         
        b1_vec = np.where(modes == 1, B1, 0)                                    
        return np.sum((dx1 + k1*x1 - b1_vec)**2)                                
                                                                                
    res1 = minimize(resid1, [0.008, 1.1])                                       
    k1, B1 = res1.x                                                             
                                                                                
    def resid2(params):                                                         
        k2, B2 = params                                                         
        b2_vec = np.where(modes == 2, B2, 0)                                    
        return np.sum((dx2 - k1*x1 + k2*x2 - b2_vec)**2)                        
                                                                                
    res2 = minimize(resid2, [0.015, 1.0])                                       
    k2, B2 = res2.x                                                             
                                                                                
    def resid3(params):                                                         
        k3, B3 = params                                                         
        b3_vec = np.where(modes == 3, B3, 0)                                    
        return np.sum((dx3 - k2*x2 + k3*x3 - b3_vec)**2)                        
                                                                                
    res3 = minimize(resid3, [0.018, 0.87])                                      
    k3, B3 = res3.x                                                             
                                                                                
    return k1, k2, k3, B1, B2, B3                                               
                                                                                
k1, k2, k3, B1, B2, B3 = solve_for_all()                                        
print(f"Final results: k1={k1:.5f}, k2={k2:.5f}, k3={k3:.5f}")                  
print(f"Final results: B1={B1:.5f}, B2={B2:.5f}, B3={B3:.5f}")                  
                                                                                
