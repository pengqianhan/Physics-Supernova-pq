    data = np.load(f'data_all/FaMoS/complex_tank/sample_{s_idx}.npz')           
    state = data['state']                                                       
    x1, x2, x3 = state                                                          
    dx2 = np.diff(x2)                                                           
    # Fit dx2 = a2*x2 + c*x1 + b                                                
    A = np.vstack([x2[:-1], x1[:-1], np.ones(len(x1)-1)]).T                     
    sol, residuals, rank, s = np.linalg.lstsq(A, dx2, rcond=None)               
    print(f"Sample {s_idx}, x2 fit: dx2 = {sol[0]:.8f}*x2 + {sol[1]:.8f}*x1 +   
{sol[2]:.8f}")                                                                  
                                                                                
    dx3 = np.diff(x3)                                                           
    A = np.vstack([x3[:-1], x2[:-1], np.ones(len(x2)-1)]).T                     
    sol, residuals, rank, s = np.linalg.lstsq(A, dx3, rcond=None)               
    print(f"Sample {s_idx}, x3 fit: dx3 = {sol[0]:.8f}*x3 + {sol[1]:.8f}*x2 +   
{sol[2]:.8f}")                                                                  
                                                                                
check_coupling(0)                                                               
                                                                                
