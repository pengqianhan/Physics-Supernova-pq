  C2 = np.median(res2[res2 > 0.5 * np.max(res2)])                               
  C3 = np.median(res3[res3 > 0.5 * np.max(res3)])                               
                                                                                
  # 3. Determine switching thresholds                                           
  def get_thresholds(x, res, C):                                                
      is_charging = res > 0.5 * C                                               
      starts = x[1:][is_charging[1:] & (~is_charging[:-1])]                     
      ends = x[1:][(~is_charging[1:]) & is_charging[:-1]]                       
      return np.mean(starts), np.mean(ends)                                     
                                                                                
  th1 = get_thresholds(all_x1, res1, C1)                                        
  th2 = get_thresholds(all_x2, res2, C2)                                        
