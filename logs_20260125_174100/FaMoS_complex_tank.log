# states[i] has shape (3, 10001)                                                
all_states = np.concatenate(states, axis=1) # shape (3, 30003)                  
                                                                                
x1 = all_states[0]                                                              
x2 = all_states[1]                                                              
x3 = all_states[2]                                                              
                                                                                
# Compute differences                                                           
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
dx3 = np.diff(x3)                                                               
                                                                                
# Find segments where variables are draining vs filling                         
# We assume x_i is draining if dx_i < 0 and filling if dx_i > 0                 
# However, the dynamics are dx1/dt = -k1*x1 + Fill1.                            
# In draining mode, Fill1 = 0, so dx1/dt = -k1*x1 < 0.                          
