import numpy as np                                                              
                                                                                
def get_data_from_all():                                                        
    all_states = []                                                             
    for i in range(3):                                                          
        data = np.load(f'data_all/FaMoS/complex_tank/sample_{i}.npz')           
        all_states.append(data['state'])                                        
    return all_states                                                           
                                                                                
all_states = get_data_from_all()                                                
dt = 0.01                                                                       
                                                                                
# Improved estimation using more points from the beginning                      
def estimate_ks(all_states, dt=0.01):                                           
    # Take first 1000 points of each sample (assuming no recharge yet)          
    # Check if they are actually in decay                                       
    X1 = []                                                                     
    DX1 = []                                                                    
    X2 = []                                                                     
    DX2 = []                                                                    
    X3 = []                                                                     
    DX3 = []                                                                    
                                                                                
    for states in all_states:                                                   
        x1, x2, x3 = states[:, :1000]                                           
        dx1 = np.diff(x1) / dt                                                  
        dx2 = np.diff(x2) / dt                                                  
        dx3 = np.diff(x3) / dt                                                  
                                                                                
        X1.append(x1[:-1])                                                      
        DX1.append(dx1)                                                         
        X2.append(x2[:-1])                                                      
        DX2.append(dx2)                                                         
        X3.append(x3[:-1])                                                      
        DX3.append(dx3)                                                         
                                                                                
    X1 = np.concatenate(X1)                                                     
    DX1 = np.concatenate(DX1)                                                   
    X2 = np.concatenate(X2)                                                     
    DX2 = np.concatenate(DX2)                                                   
    X3 = np.concatenate(X3)                                                     
    DX3 = np.concatenate(DX3)                                                   
                                                                                
    # x1_dot = -k1 * x1 => k1 = -sum(dx1 * x1) / sum(x1^2)                      
    k1 = -np.sum(DX1 * X1) / np.sum(X1**2)                                      
                                                                                
    # x2_dot = k1 * x1 - k2 * x2 => k2 * x2 = k1 * x1 - x2_dot                  
    # k2 = sum((k1*x1 - dx2) * x2) / sum(x2^2)                                  
    k2 = np.sum((k1 * X1 - DX2) * X2) / np.sum(X2**2)                           
                                                                                
    # x3_dot = k2 * x2 - k3 * x3 => k3 * x3 = k2 * x2 - x3_dot                  
    k3 = np.sum((k2 * X2 - DX3) * X3) / np.sum(X3**2)                           
                                                                                
    return k1, k2, k3                                                           
                                                                                
k1, k2, k3 = estimate_ks(all_states)                                            
print(f"Final k estimates: k1={k1}, k2={k2}, k3={k3}")                          
                                                                                
