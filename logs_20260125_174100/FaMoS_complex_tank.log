def analyze_data():                                                             
    all_x1, all_x2, all_x3 = [], [], []                                         
    all_dx1, all_dx2, all_dx3 = [], [], []                                      
                                                                                
    dt = 0.01                                                                   
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        state = data['state']                                                   
