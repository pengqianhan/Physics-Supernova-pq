stop_fill_x3 = np.where(is_filling_x3[:-1] & ~is_filling_x3[1:])[0] + 1         
low3 = np.mean(x3[start_fill_x3])                                               
high3 = np.mean(x3[stop_fill_x3])                                               
                                                                                
print(f"x1: [{low1}, {high1}], x2: [{low2}, {high2}], x3: [{low3}, {high3}]")   
                                                                                
# Check if refill rates are constant                                            
