def estimate_params_v3():                                                       
    all_states = []                                                             
    all_dx = []                                                                 
    for i in range(3):                                                          
        data = np.load(f'data_all/FaMoS/complex_tank/sample_{i}.npz')['state']  
        all_states.append(data[:, :-1])                                         
        all_dx.append(np.diff(data) / dt)                                       
                                                                                
    states = np.concatenate(all_states, axis=1)                                 
    dxs = np.concatenate(all_dx, axis=1)                                        
                                                                                
    x1, x2, x3 = states                                                         
    dx1, dx2, dx3 = dxs                                                         
                                                                                
    # K1 and B1                                                                 
    # Mode 1: b1 = 0. Mode 2: b1 > 0.                                           
    # x1 is always either decreasing (b1=0) or increasing (b1>0)                
    # Actually, let's find the segments where it's clearly draining             
    mask_drain1 = dx1 < -0.01                                                   
    k1 = np.median(-dx1[mask_drain1] / x1[mask_drain1])                         
                                                                                
    mask_refill1 = dx1 > 0.01                                                   
    b1 = np.median(dx1[mask_refill1] + k1 * x1[mask_refill1])                   
                                                                                
    # K2 and B2                                                                 
    # dx2 = k1*x1 - k2*x2 + b2                                                  
