import numpy as np                                                              
                                                                                
for s in range(3):                                                              
    data = np.load(f'data_all/FaMoS/complex_tank/sample_{s}.npz')               
    state = data['state']                                                       
    print(f"\nSample {s} Analysis:")                                            
    for i in range(3):                                                          
        x = state[i]                                                            
        dx = np.diff(x)                                                         
                                                                                
        # Check for sign changes in dx                                          
        pos_dx = np.where(dx > 0)[0]                                            
        neg_dx = np.where(dx < 0)[0]                                            
                                                                                
        print(f"  x{i+1}: pos_dx count: {len(pos_dx)}, neg_dx count:            
{len(neg_dx)}")                                                                 
        if len(pos_dx) > 0 and len(neg_dx) > 0:                                 
            print(f"  x{i+1} has both increasing and decreasing segments.")     
                                                                                
        # Check if dx is constant                                               
        # Let's see if dx correlates with x                                     
        # dx = a*x + b                                                          
        if len(dx) > 1:                                                         
            # Linear regression: dx ~ a*x[:-1] + b                              
            A = np.vstack([x[:-1], np.ones(len(x)-1)]).T                        
            a, b = np.linalg.lstsq(A, dx, rcond=None)[0]                        
            residuals = dx - (a * x[:-1] + b)                                   
            rmse = np.sqrt(np.mean(residuals**2))                               
            print(f"  x{i+1} fit: dx = {a:.6f}*x + {b:.6f} (RMSE: {rmse:.6e})") 
                                                                                
            # Check constant fit: dx = c                                        
            c = np.mean(dx)                                                     
            residuals_c = dx - c                                                
            rmse_c = np.sqrt(np.mean(residuals_c**2))                           
            print(f"  x{i+1} fit: dx = {c:.6f} (RMSE: {rmse_c:.6e})")           
                                                                                
# Check the values at the beginning and end of samples                          
