import numpy as np                                                              
                                                                                
# Load all data                                                                 
data0 = np.load('data_all/FaMoS/complex_tank/sample_0.npz')['state']            
data1 = np.load('data_all/FaMoS/complex_tank/sample_1.npz')['state']            
data2 = np.load('data_all/FaMoS/complex_tank/sample_2.npz')['state']            
                                                                                
samples = [data0, data1, data2]                                                 
dt = 0.01                                                                       
                                                                                
def analyze_variable(idx, prev_state=None):                                     
    # For x1: dx1/dt = -k1*x1 + u1*C1                                           
    # For x2: dx2/dt = k1*x1 - k2*x2 + u2*C2                                    
    # For x3: dx3/dt = k2*x2 - k3*x3 + u3*C3                                    
                                                                                
    X_vals = []                                                                 
    dX_dt_vals = []                                                             
    Prev_X_vals = []                                                            
                                                                                
    for s in samples:                                                           
        x = s[idx, :]                                                           
        dx = np.diff(x) / dt                                                    
        X_vals.append(x[:-1])                                                   
        dX_dt_vals.append(dx)                                                   
        if prev_state is not None:                                              
            Prev_X_vals.append(s[prev_state, :-1])                              
                                                                                
    X = np.concatenate(X_vals)                                                  
    dX_dt = np.concatenate(dX_dt_vals)                                          
    if prev_state is not None:                                                  
        Prev_X = np.concatenate(Prev_X_vals)                                    
                                                                                
    # Simple heuristic to identify charging: derivatives will be significantly  
higher                                                                          
    # Let's find the jump in dX/dt for the same X                               
    # Actually, we can just look at the distribution of dX/dt + k_prev*X_prev - 
k*X                                                                             
    # For x1, it's simpler: dX1/dt + k1*x1 = u1*C1.                             
    return X, dX_dt, Prev_X if prev_state is not None else None                 
                                                                                
# Estimate k1 from the 'falling' parts of x1                                    
# We know when it's falling (dx1/dt < 0), u1=0 usually.                         
x1_all, dx1_all, _ = analyze_variable(0)                                        
falling1 = dx1_all < -0.1 # Threshold to be safe                                
k1 = -np.mean(dx1_all[falling1] / x1_all[falling1])                             
                                                                                
# Now find C1. When not falling, u1=1.                                          
rising1 = dx1_all > 0.1                                                         
C1 = np.mean(dx1_all[rising1] + k1 * x1_all[rising1])                           
                                                                                
# Thresholds for x1                                                             
L1 = np.min(x1_all[rising1])                                                    
H1 = np.max(x1_all[rising1])                                                    
                                                                                
# Estimate k2                                                                   
x2_all, dx2_all, x1_prev_all = analyze_variable(1, 0)                           
# dx2/dt = k1*x1 - k2*x2 + u2*C2                                                
# When u2=0, (dx2/dt - k1*x1) = -k2*x2                                          
val2 = dx2_all - k1 * x1_prev_all                                               
falling2 = val2 < -0.1                                                          
k2 = -np.mean(val2[falling2] / x2_all[falling2])                                
rising2 = val2 > 0.1                                                            
C2 = np.mean(val2[rising2] + k2 * x2_all[rising2])                              
L2 = np.min(x2_all[rising2])                                                    
H2 = np.max(x2_all[rising2])                                                    
                                                                                
# Estimate k3                                                                   
x3_all, dx3_all, x2_prev_all = analyze_variable(2, 1)                           
val3 = dx3_all - k2 * x2_prev_all                                               
falling3 = val3 < -0.1                                                          
k3 = -np.mean(val3[falling3] / x3_all[falling3])                                
rising3 = val3 > 0.1                                                            
C3 = np.mean(val3[rising3] + k3 * x3_all[rising3])                              
L3 = np.min(x3_all[rising3])                                                    
H3 = np.max(x3_all[rising3])                                                    
                                                                                
# Identify initial states                                                       
def get_initial_states():                                                       
    results = []                                                                
    for i, s in enumerate(samples):                                             
        sample_states = []                                                      
        # Check x1                                                              
        v1 = (s[0, 1] - s[0, 0])/dt + k1 * s[0, 0]                              
        u1 = 1 if v1 > C1/2 else 0                                              
        # Check x2                                                              
        v2 = (s[1, 1] - s[1, 0])/dt - k1 * s[0, 0] + k2 * s[1, 0]               
        u2 = 1 if v2 > C2/2 else 0                                              
        # Check x3                                                              
        v3 = (s[2, 1] - s[2, 0])/dt - k2 * s[1, 0] + k3 * s[2, 0]               
        u3 = 1 if v3 > C3/2 else 0                                              
        results.append((u1 == 1, u2 == 1, u3 == 1))                             
    return results                                                              
                                                                                
initial_charging = get_initial_states()                                         
                                                                                
