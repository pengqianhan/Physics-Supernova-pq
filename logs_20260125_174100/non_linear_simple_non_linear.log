switches = np.where(v_sign[:-1] != v_sign[1:])[0]                               
                                                                                
# Extract reset ratios (v_after / v_before)                                     
# Switch at ~125 (Mode 1 to Mode 2)                                             
ratio_125 = []                                                                  
# Switch at ~10 (Mode 2 to Mode 1)                                              
ratio_10 = []                                                                   
                                                                                
