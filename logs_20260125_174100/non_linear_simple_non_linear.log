  x1_dot = np.gradient(x1_pos, dt)                                              
  x1_ddot = np.gradient(x1_dot, dt)                                             
                                                                                
  # Segment the data based on velocity                                          
  mode1_mask = x1_dot > 0                                                       
  mode2_mask = x1_dot < 0                                                       
                                                                                
  def fit_model(mask):                                                          
      p = x1_pos[mask]                                                          
      v = x1_dot[mask]                                                          
      a = x1_ddot[mask]                                                         
      # accel = a_coeff * vel + b_coeff * pos + c_coeff + d_coeff * pos**2      
      A = np.vstack([v, p, np.ones_like(p), p**2]).T                            
      coeffs, _, _, _ = np.linalg.lstsq(A, a, rcond=None)                       
      return coeffs                                                             
                                                                                
