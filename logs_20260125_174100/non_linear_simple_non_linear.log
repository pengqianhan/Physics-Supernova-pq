        x1[indices],                                                            
        x1[indices]**2,                                                         
        np.ones_like(indices) # bias term                                       
    ])                                                                          
                                                                                
    model = LinearRegression().fit(X, Y)                                        
    return model.coef_, model.intercept_                                        
                                                                                
# Group data by sign of x1_dot                                                  
# Note: we should avoid the transition points                                   
buffer = 5                                                                      
mode_inc_indices = []                                                           
mode_dec_indices = []                                                           
                                                                                
