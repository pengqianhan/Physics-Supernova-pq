import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/simple_non_linear/sample_0.npz')            
t = data['t']                                                                   
x = data['x']  # Assuming x is the state [x1, x1_dot]                           
dx = data['dx'] # Assuming dx is the derivative [x1_dot, x1_ddot]               
                                                                                
# Extract x1 and its derivative                                                 
x1 = x[:, 0]                                                                    
x1_dot = x[:, 1]                                                                
x1_ddot = dx[:, 1]                                                              
                                                                                
# Mode identification: Mode 1 (x1_dot > 0), Mode 2 (x1_dot < 0)                 
modes = np.zeros(len(x1_dot), dtype=int)                                        
modes[x1_dot > 0] = 1                                                           
modes[x1_dot < 0] = 2                                                           
                                                                                
# Identify switching times                                                      
switches = []                                                                   
for i in range(1, len(modes)):                                                  
    if modes[i] != modes[i-1] and modes[i] != 0 and modes[i-1] != 0:            
        switches.append({                                                       
            'index': i,                                                         
            'time': t[i],                                                       
            'from': modes[i-1],                                                 
            'to': modes[i],                                                     
            'x1_guard': x1[i],                                                  
            'x1_dot_before': x1_dot[i-1],                                       
            'x1_dot_after': x1_dot[i]                                           
        })                                                                      
                                                                                
print(f"Initial mode: {modes[0]}")                                              
print(f"Initial state: x1={x1[0]}, x1_dot={x1_dot[0]}")                         
print(f"Number of switches found: {len(switches)}")                             
for s in switches:                                                              
    print(s)                                                                    
                                                                                
# Group data by mode for fitting                                                
# ODE: x1_ddot = a*x1_dot + b*x1 + c*x1**2 + d                                  
def fit_mode(m):                                                                
    mask = (modes == m)                                                         
    target = x1_ddot[mask]                                                      
    features = np.column_stack([x1_dot[mask], x1[mask], x1[mask]**2,            
np.ones(np.sum(mask))])                                                         
    params, residuals, rank, s = np.linalg.lstsq(features, target, rcond=None)  
    return params                                                               
                                                                                
params_mode1 = fit_mode(1)                                                      
params_mode2 = fit_mode(2)                                                      
                                                                                
print("\nMode 1 parameters (a, b, c, d):", params_mode1)                        
print("Mode 2 parameters (a, b, c, d):", params_mode2)                          
                                                                                
