from sklearn.linear_model import LinearRegression                               
                                                                                
def fit_ode(x0, x1, x2):                                                        
    # Prepare features: x1[1], x1[0], bias, x1[0]**2                            
    # In my code: x1_dot, x1, 1, x1**2                                          
    X = np.stack([x1, x0, np.ones_like(x0), x0**2], axis=1)                     
    model = LinearRegression(fit_intercept=False)                               
    model.fit(X, x2)                                                            
    return model.coef_                                                          
                                                                                
