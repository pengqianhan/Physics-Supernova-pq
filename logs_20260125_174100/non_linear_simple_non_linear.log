  x1_dot_val = x1_dot[:-1] # x1_dot values corresponding to x1_ddot             
                                                                                
  # Masks for modes                                                             
  inc_mask = (x1_dot_val > 0) & fit_mask                                        
  dec_mask = (x1_dot_val < 0) & fit_mask                                        
                                                                                
  def fit_model(mask, x_ddot, x_dot, x):                                        
      if np.sum(mask) < 10:                                                     
          return None                                                           
      y = x_ddot[mask]                                                          
      X = np.column_stack([x_dot[mask], x[mask], x[mask]**2,                    
  np.ones_like(x[mask])])                                                       
      coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                       
      return coeffs                                                             
                                                                                
  coeffs_inc = fit_model(inc_mask, x1_ddot, x1_dot_val, x1_val)                 
  coeffs_dec = fit_model(dec_mask, x1_ddot, x1_dot_val, x1_val)                 
                                                                                
  print("Refined Coefficients Increasing (A, B, C, D):", coeffs_inc)            
  print("Refined Coefficients Decreasing (A, B, C, D):", coeffs_dec)            
                                                                                
  # Analyze resets                                                              
  resets_inc_to_dec = []                                                        
  resets_dec_to_inc = []                                                        
                                                                                
  for idx in switches:                                                          
      v_before = x1_dot[idx]                                                    
      v_after = x1_dot[idx+1]                                                   
      pos = x1[idx+1]                                                           
      ratio = v_after / v_before                                                
      if v_before > 0: # Inc to Dec                                             
          resets_inc_to_dec.append(ratio)                                       
          print(f"Inc -> Dec at x1={pos:.2f}: ratio={ratio:.4f}")               
      else: # Dec to Inc                                                        
          resets_dec_to_inc.append(ratio)                                       
          print(f"Dec -> Inc at x1={pos:.2f}: ratio={ratio:.4f}")               
                                                                                
  print(f"Avg ratio Inc -> Dec: {np.mean(resets_inc_to_dec):.4f}")              
  print(f"Avg ratio Dec -> Inc: {np.mean(resets_dec_to_inc):.4f}")              
