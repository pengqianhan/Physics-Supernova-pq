  import numpy as np                                                            
  from sklearn.linear_model import LinearRegression                             
                                                                                
  def analyze_trajectories(paths):                                              
      all_mode1_data = [] # Rising                                              
      all_mode2_data = [] # Falling                                             
      guards_1to2 = []                                                          
      guards_2to1 = []                                                          
      resets_1to2 = []                                                          
      resets_2to1 = []                                                          
                                                                                
      for path in paths:                                                        
          data = np.load(path)                                                  
          x = data['state'][0]                                                  
          v = np.gradient(x)                                                    
          a = np.gradient(v)                                                    
                                                                                
          # Identify modes                                                      
          # Mode 1: Rising (v > 0)                                              
          # Mode 2: Falling (v < 0)                                             
                                                                                
          # Find switching points                                               
          v_sign = np.sign(v)                                                   
          switches = np.where(v_sign[:-1] != v_sign[1:])[0]                     
                                                                                
          for i in range(len(switches)):                                        
              idx = switches[i]                                                 
              # Transition 1 -> 2 (Rising to Falling): v goes from + to -       
              if v[idx] >= 0 and v[idx+1] < 0:                                  
                  guards_1to2.append(x[idx])                                    
                  resets_1to2.append(v[idx+1] - v[idx])                         
              # Transition 2 -> 1 (Falling to Rising): v goes from - to +       
              elif v[idx] <= 0 and v[idx+1] > 0:                                
                  guards_2to1.append(x[idx])                                    
                  resets_2to1.append(v[idx+1] - v[idx])                         
                                                                                
          # Collect mode data                                                   
          # We'll use a mask for each mode                                      
          mode1_mask = (v > 0)                                                  
          mode2_mask = (v < 0)                                                  
                                                                                
          # ODE: a[t] = c1*v[t] + c2*x[t] + c3 + c4*x[t]^2                      
          # Mode 1                                                              
          X1 = np.column_stack([v[mode1_mask], x[mode1_mask],                   
  np.ones(np.sum(mode1_mask)), x[mode1_mask]**2])                               
          y1 = a[mode1_mask]                                                    
          all_mode1_data.append((X1, y1))                                       
                                                                                
          # Mode 2                                                              
          X2 = np.column_stack([v[mode2_mask], x[mode2_mask],                   
  np.ones(np.sum(mode2_mask)), x[mode2_mask]**2])                               
          y2 = a[mode2_mask]                                                    
          all_mode2_data.append((X2, y2))                                       
                                                                                
      return all_mode1_data, all_mode2_data, guards_1to2, guards_2to1,          
  resets_1to2, resets_2to1                                                      
                                                                                
  all_mode1, all_mode2, guards_1to2, guards_2to1, resets_1to2, resets_2to1 =    
  analyze_trajectories(DATA_FILE_PATHS)                                         
                                                                                
  # Combine and Fit                                                             
  def fit_ode(mode_data):                                                       
      X = np.vstack([d[0] for d in mode_data])                                  
      y = np.concatenate([d[1] for d in mode_data])                             
      model = LinearRegression(fit_intercept=False).fit(X, y)                   
      return model.coef_                                                        
                                                                                
  coeffs_m1 = fit_ode(all_mode1)                                                
  coeffs_m2 = fit_ode(all_mode2)                                                
                                                                                
  print(f"Mode 1 coeffs (v, x, 1, x^2): {coeffs_m1}")                           
  print(f"Mode 2 coeffs (v, x, 1, x^2): {coeffs_m2}")                           
  print(f"Guard 1->2 (avg x): {np.mean(guards_1to2)}")                          
  print(f"Guard 2->1 (avg x): {np.mean(guards_2to1)}")                          
  print(f"Reset 1->2 (avg dv): {np.mean(resets_1to2)}")                         
  print(f"Reset 2->1 (avg dv): {np.mean(resets_2to1)}")                         
