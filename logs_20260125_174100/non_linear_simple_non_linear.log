```python                                                                       
import numpy as np                                                              
                                                                                
def analyze():                                                                  
    # Load data                                                                 
    data = np.load(DATA_FILE_PATHS[0])                                          
    x = data['state'][0]                                                        
                                                                                
    # Jumps                                                                     
    diffs = np.diff(x)                                                          
    jumps = np.where(np.abs(diffs) > 10)[0]                                     
                                                                                
    # Modes Analysis                                                            
    start = 0                                                                   
    all_coeffs = []                                                             
    all_resets = []                                                             
                                                                                
    for i, end in enumerate(list(jumps) + [len(x)-1]):                          
        seg = x[start:end+1]                                                    
        if len(seg) > 20:                                                       
            # Model: x[k+2] = a*x[k+1] + b*x[k] + c + d*x[k]^2                  
            X = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2),      
seg[:-2]**2])                                                                   
            Y = seg[2:]                                                         
            c, res, _, _ = np.linalg.lstsq(X, Y, rcond=None)                    
            all_coeffs.append(c)                                                
                                                                                
            # Print for the first few                                           
            if i < 3:                                                           
                print(f"Seg {i} (len {len(seg)}): a={c[0]:.6f}, b={c[1]:.6f},   
c={c[2]:.6f}, d={c[3]:.6f}, res={np.mean(res) if res.size > 0 else 0:.2e}")     
                                                                                
        if end < len(x)-1:                                                      
            # Transition                                                        
            all_resets.append((x[end], x[end+1], x[end+2]))                     
        start = end + 1                                                         
                                                                                
    # Compare coefficients                                                      
    all_coeffs = np.array(all_coeffs)                                           
    print("\nMean Coeffs across all segments:")                                 
    print(np.mean(all_coeffs, axis=0))                                          
    print("Std Coeffs across all segments:")                                    
    print(np.std(all_coeffs, axis=0))                                           
                                                                                
    # Guards and Resets                                                         
    all_resets = np.array(all_resets)                                           
    print("\nResets (x_before, x_after_0, x_after_1):")                         
    for r in all_resets[:5]:                                                    
        print(f"  Before: {r[0]:.4f} -> After: {r[1]:.4f}, {r[2]:.4f}")         
                                                                                
    # Check if there are different types of jumps                               
    # e.g., one near 125 and one near 10                                        
    jumps_at_125 = all_resets[all_resets[:, 0] > 100]                           
    jumps_at_10 = all_resets[all_resets[:, 0] < 20]                             
                                                                                
    if len(jumps_at_125) > 0:                                                   
        print(f"\nGuards near 125: Count={len(jumps_at_125)}, Avg               
Before={np.mean(jumps_at_125[:, 0]):.4f}, Range=[{np.min(jumps_at_125[:,        
0]):.4f}, {np.max(jumps_at_125[:, 0]):.4f}]")                                   
        print(f"  Reset to: {np.mean(jumps_at_125[:, 1]):.4f},                  
{np.mean(jumps_at_125[:, 2]):.4f}")                                             
                                                                                
    if len(jumps_at_10) > 0:                                                    
        print(f"Guards near 10: Count={len(jumps_at_10)}, Avg                   
Before={np.mean(jumps_at_10[:, 0]):.4f}, Range=[{np.min(jumps_at_10[:, 0]):.4f},
{np.max(jumps_at_10[:, 0]):.4f}]")                                              
        print(f"  Reset to: {np.mean(jumps_at_10[:, 1]):.4f},                   
{np.mean(jumps_at_10[:, 2]):.4f}")                                              
                                                                                
analyze()                                                                       
```                                                                             
                                                                                
