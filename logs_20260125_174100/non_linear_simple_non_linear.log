import numpy as np                                                              
                                                                                
def get_segments(path):                                                         
    x = np.load(path)['state'][0]                                               
    dx = np.diff(x)                                                             
    sign_changes = np.where(np.diff(np.sign(dx)))[0]                            
                                                                                
    inc_segments = []                                                           
    dec_segments = []                                                           
                                                                                
    indices = [0] + list(sign_changes + 1) + [len(x)]                           
    for i in range(len(indices)-1):                                             
        start, end = indices[i], indices[i+1]                                   
        if end - start < 10: continue                                           
        segment = x[start:end]                                                  
        if segment[1] > segment[0]:                                             
            inc_segments.append(segment)                                        
        else:                                                                   
            dec_segments.append(segment)                                        
    return inc_segments, dec_segments                                           
                                                                                
all_inc = []                                                                    
all_dec = []                                                                    
for path in DATA_FILE_PATHS:                                                    
    inc, dec = get_segments(path)                                               
    all_inc.extend(inc)                                                         
    all_dec.extend(dec)                                                         
                                                                                
def fit_multiple(segments):                                                     
    X_list = []                                                                 
    Y_list = []                                                                 
    for seg in segments:                                                        
        Y_list.append(seg[2:])                                                  
        X_list.append(np.column_stack([seg[1:-1], seg[:-2],                     
np.ones(len(seg)-2)]))                                                          
                                                                                
    X = np.vstack(X_list)                                                       
    Y = np.concatenate(Y_list)                                                  
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
inc_coeffs = fit_multiple(all_inc)                                              
dec_coeffs = fit_multiple(all_dec)                                              
                                                                                
print("Combined Increasing Coeffs (alpha, beta, gamma):", inc_coeffs)           
print("Combined Decreasing Coeffs (alpha, beta, gamma):", dec_coeffs)           
                                                                                
