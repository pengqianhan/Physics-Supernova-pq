```python                                                                       
import numpy as np                                                              
                                                                                
def analyze():                                                                  
    all_data = []                                                               
    for path in DATA_FILE_PATHS:                                                
        all_data.append(np.load(path)['state'][0])                              
                                                                                
    for idx, x in enumerate(all_data):                                          
        print(f"--- Analyzing Sample {idx} ---")                                
        diffs = np.abs(np.diff(x))                                              
        jumps = np.where(diffs > 10)[0]                                         
        print(f"Jumps at: {jumps}")                                             
                                                                                
        # Transitions                                                           
        for j in jumps:                                                         
            print(f"Jump at {j}: x[j-1]={x[j-1]:.2f}, x[j]={x[j]:.2f} ->        
x[j+1]={x[j+1]:.2f}, x[j+2]={x[j+2]:.2f}")                                      
                                                                                
        # Segments                                                              
        start = 0                                                               
        for i, j in enumerate(list(jumps) + [len(x)-1]):                        
            seg = x[start:j+1]                                                  
            if len(seg) > 10:                                                   
                # Fit 2nd order ODE                                             
                # Model: x_{k+2} = a*x_{k+1} + b*x_k + c + d*x_k^2 + e*x_{k+1}^2
+ f*x_k*x_{k+1}                                                                 
                X = []                                                          
                Y = []                                                          
                for k in range(len(seg)-2):                                     
                    X.append([seg[k+1], seg[k], 1, seg[k]**2, seg[k+1]**2,      
seg[k]*seg[k+1]])                                                               
                    Y.append(seg[k+2])                                          
                X = np.array(X)                                                 
                Y = np.array(Y)                                                 
                coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)             
                print(f"Seg {i} (start {start}, len {len(seg)}):")              
                print(f"  Coeffs: a={coeffs[0]:.5f}, b={coeffs[1]:.5f},         
c={coeffs[2]:.5f}")                                                             
                print(f"  Non-linear (x0^2, x1^2, x0x1): {coeffs[3]:.5f},       
{coeffs[4]:.5f}, {coeffs[5]:.5f}")                                              
            start = j + 1                                                       
                                                                                
analyze()                                                                       
```                                                                             
                                                                                
