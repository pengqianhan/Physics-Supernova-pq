import numpy as np                                                              
                                                                                
def find_jumps(data_path):                                                      
    data = np.load(data_path)                                                   
    x = data['state'][0]                                                        
                                                                                
    # Calculate differences                                                     
    dx = np.diff(x)                                                             
                                                                                
    # Threshold for jump detection (e.g., 5 times the median absolute           
difference)                                                                     
    threshold = 5 * np.median(np.abs(dx))                                       
    jump_indices = np.where(np.abs(dx) > threshold)[0]                          
                                                                                
    return jump_indices, x                                                      
                                                                                
