segments = []                                                                   
start_idx = 0                                                                   
for i in range(1, len(v1)):                                                     
    if increasing[i] != increasing[i-1]:                                        
        mode = "increasing" if increasing[i-1] else "decreasing"                
        segments.append((start_idx, i, mode))                                   
        start_idx = i                                                           
segments.append((start_idx, len(v1), "increasing" if increasing[-1] else        
"decreasing"))                                                                  
                                                                                
# Define the ODE model: a1 = a * v1 + b * x1 + c                                
def ode_model(X, a, b, c):                                                      
    v, x = X                                                                    
    return a * v + b * x + c                                                    
                                                                                
results = {"increasing": [], "decreasing": []}                                  
for start, end, mode in segments:                                               
    # Exclude the very beginning/end of segments to avoid boundary effects from 
gradient                                                                        
    if end - start < 20: continue                                               
    s, e = start + 2, end - 2                                                   
    X = (v1[s:e], x1[s:e])                                                      
