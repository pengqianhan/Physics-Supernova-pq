    x_dot_disc = state[1:-1] - state[:-2]                                       
    x_ddot_disc = state[2:] - 2*state[1:-1] + state[:-2]                        
                                                                                
    diffs = np.diff(state)                                                      
    switches = [i+1 for i in range(len(diffs)-1) if np.sign(diffs[i]) !=        
np.sign(diffs[i+1])]                                                            
    mask = np.ones(len(x_pos), dtype=bool)                                      
    for s in switches:                                                          
        for idx in [s-1, s, s+1]: # Slightly different mask for discrete        
            if 0 <= idx < len(mask): mask[idx] = False                          
                                                                                
    m1 = (x_dot_disc > 0) & mask                                                
    m2 = (x_dot_disc < 0) & mask                                                
                                                                                
    def fit(m):                                                                 
        X = np.column_stack([x_dot_disc[m], x_pos[m], np.ones(np.sum(m)),       
x_pos[m]**2])                                                                   
        c, _, _, _ = np.linalg.lstsq(X, x_ddot_disc[m], rcond=None)             
        return c                                                                
                                                                                
    return fit(m1), fit(m2)                                                     
                                                                                
