import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
data = np.load(DATA_FILE_PATH)                                                  
x = data['state'][0]                                                            
dx = np.diff(x)                                                                 
                                                                                
# Segment data into modes                                                       
# Mode 2: Increasing (dx > 0)                                                   
# Mode 1: Decreasing (dx < 0)                                                   
mode2_indices = []                                                              
mode1_indices = []                                                              
                                                                                
# To avoid boundary effects near switches, we'll exclude a few points near the  
jumps                                                                           
jumps = np.where(np.diff(np.sign(dx)) != 0)[0] + 1                              
mask = np.ones(len(dx), dtype=bool)                                             
for j in jumps:                                                                 
    mask[max(0, j-2):min(len(dx), j+3)] = False                                 
                                                                                
for i in range(len(dx)):                                                        
    if mask[i]:                                                                 
        if dx[i] > 0:                                                           
            mode2_indices.append(i)                                             
        else:                                                                   
            mode1_indices.append(i)                                             
                                                                                
def fit_mode(indices, x, dx):                                                   
    # a[i] = (dx[i] - dx[i-1]) / dt^2 is not possible without dt.               
    # Let's assume dt = 1 for now and look at the coefficients.                 
    # Actually, let's use the second difference as 'acceleration'               
    # a_i = x_{i+1} - 2x_i + x_{i-1}                                            
    # v_i = x_i - x_{i-1}                                                       
    # x_i = x_i                                                                 
                                                                                
    # We need at least 3 points for a, v, x.                                    
    # For a given index i in indices, we need x[i], x[i-1], x[i-2] or similar.  
    # Let's use:                                                                
    # y = x[i+1] - 2*x[i] + x[i-1]  (acceleration)                              
    # v = x[i] - x[i-1]             (velocity)                                  
    # p = x[i]                      (position)                                  
                                                                                
    y_list = []                                                                 
    X_list = []                                                                 
                                                                                
    for i in indices:                                                           
        if i > 0 and i < len(dx):                                               
            # i is the index for dx, so dx[i] = x[i+1] - x[i]                   
            # acceleration a[i] = dx[i] - dx[i-1] = x[i+1] - 2*x[i] + x[i-1]    
            accel = dx[i] - dx[i-1]                                             
            vel = dx[i-1]                                                       
            pos = x[i]                                                          
                                                                                
            y_list.append(accel)                                                
            X_list.append([vel, pos, pos**2, 1.0])                              
                                                                                
    y_arr = np.array(y_list)                                                    
    X_arr = np.array(X_list)                                                    
                                                                                
    reg = LinearRegression().fit(X_arr, y_arr)                                  
    return reg.coef_, reg.intercept_, reg.score(X_arr, y_arr)                   
                                                                                
print("Fitting Mode 2 (Increasing):")                                           
coef2, intercept2, score2 = fit_mode(mode2_indices, x, dx)                      
print(f"Coefficients: {coef2}")                                                 
print(f"Intercept: {intercept2}")                                               
print(f"R^2: {score2}")                                                         
                                                                                
print("\nFitting Mode 1 (Decreasing):")                                         
coef1, intercept1, score1 = fit_mode(mode1_indices, x, dx)                      
print(f"Coefficients: {coef1}")                                                 
print(f"Intercept: {intercept1}")                                               
