```python                                                                       
import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load(DATA_FILE_PATHS[0])                                              
x = data['state'][0]                                                            
                                                                                
# Detect jumps                                                                  
jumps = np.where(np.abs(np.diff(x)) > 10)[0]                                    
print(f"Jumps at indices: {jumps}")                                             
                                                                                
# Segment the data                                                              
segments = []                                                                   
start = 0                                                                       
for j in jumps:                                                                 
    segments.append(x[start:j+1])                                               
    start = j + 1                                                               
segments.append(x[start:])                                                      
                                                                                
def fit_ode(seg):                                                               
    if len(seg) < 5: return None                                                
    # x_{k+2} = a*x_{k+1} + b*x_k + c + d*x_k^2                                 
    X = []                                                                      
    Y = []                                                                      
    for i in range(len(seg) - 2):                                               
        x_k = seg[i]                                                            
        x_k1 = seg[i+1]                                                         
        x_k2 = seg[i+2]                                                         
        X.append([x_k1, x_k, 1, x_k**2, x_k1**2, x_k*x_k1])                     
        Y.append(x_k2)                                                          
    X = np.array(X)                                                             
    Y = np.array(Y)                                                             
    coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    return coeffs, residuals                                                    
                                                                                
for i, seg in enumerate(segments):                                              
    res = fit_ode(seg)                                                          
    if res:                                                                     
        coeffs, residuals = res                                                 
        print(f"Segment {i} (len {len(seg)}): coeffs {coeffs}, avg_res          
{np.sqrt(np.mean(residuals)) if residuals.size > 0 else 0}")                    
