print("Guards (x1 values at transitions):", guards)                             
                                                                                
# Mode Fitting                                                                  
# Two modes: one with positive velocity (increasing), one with negative         
(decreasing)                                                                    
# ODE model: x1_ddot = c1 * x1_dot + c2 * x1 + c3 * x1**2 + bias                
                                                                                
def fit_mode(indices):                                                          
