│                 }                                                            │
│             }                                                                │
│         ]                                                                    │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.001,                                                         │
│         "total_time": 10.0,                                                  │
│         "order": 1,                                                          │
│         "need_reset": true,                                                  │
│         "non_linear_items": ""                                               │
│     }                                                                        │
│ }                                                                            │
