import numpy as np                                                              
                                                                                
def analyze_transitions(all_x1, dt=0.01):                                       
    trans_pos_to_neg = []                                                       
    trans_neg_to_pos = []                                                       
                                                                                
    for x1 in all_x1:                                                           
        x1_dot = np.diff(x1) / dt                                               
        for i in range(len(x1_dot)-1):                                          
            v1 = x1_dot[i]                                                      
            v2 = x1_dot[i+1]                                                    
            if v1 > 0 and v2 < 0:                                               
                trans_pos_to_neg.append({'x1': x1[i+1], 'v_before': v1,         
'v_after': v2})                                                                 
            elif v1 < 0 and v2 > 0:                                             
                trans_neg_to_pos.append({'x1': x1[i+1], 'v_before': v1,         
'v_after': v2})                                                                 
                                                                                
    return trans_pos_to_neg, trans_neg_to_pos                                   
                                                                                
def perform_regression(data, include_quadratic=False):                          
    X = np.column_stack([data['x1_dot'], data['x1']])                           
    if include_quadratic:                                                       
        X = np.column_stack([X, np.array(data['x1'])**2])                       
    X = np.column_stack([X, np.ones(len(data['x1']))])                          
                                                                                
    y = np.array(data['x1_ddot'])                                               
                                                                                
    coef, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)                
                                                                                
    y_mean = np.mean(y)                                                         
    ss_tot = np.sum((y - y_mean)**2)                                            
    ss_res = np.sum((y - X @ coef)**2)                                          
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    return coef, r2                                                             
                                                                                
