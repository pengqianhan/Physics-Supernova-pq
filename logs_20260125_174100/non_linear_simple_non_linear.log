```python                                                                       
import numpy as np                                                              
                                                                                
# Load the first data file                                                      
data = np.load(DATA_FILE_PATHS[0])                                              
x = data['state'][0]                                                            
                                                                                
# Detect jumps (switching points)                                               
diffs = np.abs(np.diff(x))                                                      
jumps = np.where(diffs > 10)[0]                                                 
                                                                                
# Fit segments                                                                  
start = 0                                                                       
segments_indices = []                                                           
for j in jumps:                                                                 
    segments_indices.append((start, j+1))                                       
    start = j+1                                                                 
segments_indices.append((start, len(x)))                                        
                                                                                
for idx, (s, e) in enumerate(segments_indices):                                 
    seg = x[s:e]                                                                
    if len(seg) < 10: continue                                                  
                                                                                
    # Try linear model: x[k+2] = a*x[k+1] + b*x[k] + c                          
    X = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2)])             
    Y = seg[2:]                                                                 
    coeffs, residuals, rank, s_val = np.linalg.lstsq(X, Y, rcond=None)          
                                                                                
    # Try non-linear model: x[k+2] = a*x[k+1] + b*x[k] + c + d*x[k]**2          
    X_nl = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2),           
seg[:-2]**2])                                                                   
    coeffs_nl, residuals_nl, rank_nl, s_val_nl = np.linalg.lstsq(X_nl, Y,       
rcond=None)                                                                     
                                                                                
    print(f"Mode at segment {idx} (indices {s}:{e}):")                          
    print(f"  Linear: a={coeffs[0]:.6f}, b={coeffs[1]:.6f}, c={coeffs[2]:.6f},  
res={np.mean(residuals) if residuals.size > 0 else 0:.6e}")                     
    print(f"  Non-linear (with x[k]^2): d={coeffs_nl[3]:.6f},                   
res={np.mean(residuals_nl) if residuals_nl.size > 0 else 0:.6e}")               
                                                                                
    # Check guard and reset                                                     
    if e < len(x):                                                              
        print(f"  Switch at index {e-1}: x[e-1]={x[e-1]:.4f}, x[e]={x[e]:.4f},  
x[e+1]={x[e+1]:.4f}")                                                           
