    DV = []                                                                     
    for seg in segments:                                                        
        v = np.diff(seg) / dt                                                   
        dv = np.diff(v) / dt                                                    
        V_now.append(v[:-1])                                                    
        DV.append(dv)                                                           
                                                                                
    V_now = np.concatenate(V_now)                                               
    DV = np.concatenate(DV)                                                     
                                                                                
    A = np.column_stack([V_now, np.ones(len(V_now))])                           
    a, c = np.linalg.lstsq(A, DV, rcond=None)[0]                                
    return a, c                                                                 
                                                                                
