from sklearn.linear_model import LinearRegression                               
                                                                                
def fit_ode(s_segment, dt=0.01):                                                
    if len(s_segment) < 10: return None                                         
    v = np.diff(s_segment) / dt                                                 
    a = np.diff(v) / dt                                                         
                                                                                
    # x1[2] = a * x1[1] + b * x1[0] + c                                         
    # x1[0] is state, x1[1] is velocity, x1[2] is acceleration                  
    X = np.column_stack([v[:-1], s_segment[:-2], np.ones(len(s_segment)-2)])    
    y = a                                                                       
                                                                                
    model = LinearRegression()                                                  
    model.fit(X, y)                                                             
    return model.coef_, model.intercept_, model.score(X, y)                     
                                                                                
