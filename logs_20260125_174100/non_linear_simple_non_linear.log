    v_after = v1[idx]                                                           
                                                                                
    if mode_before == "increasing": # Peak                                      
        resets["at_peak"].append((x_switch, v_before, v_after))                 
    else: # Valley                                                              
        resets["at_valley"].append((x_switch, v_before, v_after))               
                                                                                
# Print results for summary                                                     
print("Average Coefficients (a, b, c):")                                        
for mode, coeffs in avg_coeffs.items():                                         
    print(f"  {mode}: a={coeffs[0]:.6f}, b={coeffs[1]:.6f}, c={coeffs[2]:.6f}") 
                                                                                
print("\nReset Analysis (Representative samples):")                             
for event, data_pts in resets.items():                                          
    if data_pts:                                                                
        avg_x = np.mean([p[0] for p in data_pts])                               
        avg_v_pre = np.mean([p[1] for p in data_pts])                           
        avg_v_post = np.mean([p[2] for p in data_pts])                          
        print(f"  {event}: avg_x={avg_x:.2f}, avg_v_pre={avg_v_pre:.4f},        
