import numpy as np                                                              
                                                                                
def fit_discrete(sample_idx):                                                   
    state = np.load(DATA_FILE_PATHS[sample_idx])['state'][0]                    
    # x_ddot_discrete = x[k+1] - 2x[k] + x[k-1]                                 
    # x_dot_discrete = x[k] - x[k-1]                                            
