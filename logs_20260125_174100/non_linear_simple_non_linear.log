<code>                                                                          
import numpy as np                                                              
                                                                                
def estimate_params(x, indices):                                                
    # x is the state trajectory                                                 
    # indices are the points in the segment                                     
    # We want to fit ddx = a * dx + b * x + c                                   
    # But since it's discrete, let's use:                                       
    # (x[k+2] - 2*x[k+1] + x[k]) = a * (x[k+1] - x[k]) + b * x[k] + c           
                                                                                
    # Let's collect data                                                        
    X = []                                                                      
    Y = []                                                                      
    for k in indices:                                                           
        if k + 2 >= len(x): continue                                            
        d1 = x[k+1] - x[k]                                                      
        d2 = x[k+2] - 2*x[k+1] + x[k]                                           
        X.append([d1, x[k], 1.0])                                               
        Y.append(d2)                                                            
                                                                                
    X = np.array(X)                                                             
    Y = np.array(Y)                                                             
                                                                                
    # Solve X * [a, b, c]^T = Y                                                 
    params, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    return params                                                               
                                                                                
data = np.load(DATA_FILE_PATHS[0])                                              
x = data['state'][0]                                                            
                                                                                
segments = [                                                                    
    range(0, 951),                                                              
    range(953, 4072),                                                           
    range(4074, 7193),                                                          
    range(7195, 9998)                                                           
]                                                                               
                                                                                
for i, seg in enumerate(segments):                                              
    p = estimate_params(x, seg)                                                 
    print(f"Segment {i+1} parameters: a={p[0]:.6f}, b={p[1]:.6f}, c={p[2]:.6f}")
                                                                                
