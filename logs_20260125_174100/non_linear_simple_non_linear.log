  x_low = np.mean(x1_pos[idx2to1]) if len(idx2to1) > 0 else None                
                                                                                
  m1 = np.mean(x1_dot[idx1to2 + 1] / x1_dot[idx1to2]) if len(idx1to2) > 0 else  
  None                                                                          
  m2 = np.mean(x1_dot[idx2to1 + 1] / x1_dot[idx2to1]) if len(idx2to1) > 0 else  
  None                                                                          
                                                                                
  print(f"Transitions: x_high={x_high}, x_low={x_low}")                         
  print(f"Reset multipliers: m1={m1}, m2={m2}")                                 
