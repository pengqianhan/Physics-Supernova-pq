    v = np.diff(x_traj) / dt                                                    
    a = np.diff(v) / dt                                                         
    x = x_traj[:-2]                                                             
    v = v[:-1]                                                                  
                                                                                
    # Exclude points very close to switches (e.g. 5 points around)              
    switches = np.where(np.diff(np.sign(v)))[0]                                 
    mask = np.ones(len(v), dtype=bool)                                          
    for s in switches:                                                          
        mask[max(0, s-2):min(len(v), s+3)] = False                              
                                                                                
    m1 = (v < -0.1) & mask                                                      
    m2 = (v > 0.1) & mask                                                       
                                                                                
    all_x1.append(x[m1]); all_v1.append(v[m1]); all_a1.append(a[m1])            
    all_x2.append(x[m2]); all_v2.append(v[m2]); all_a2.append(a[m2])            
                                                                                
def fit(x, v, a):                                                               
    X = np.column_stack([v, x, x**2, np.ones_like(x)])                          
    c, _, _, _ = np.linalg.lstsq(X, a, rcond=None)                              
    return c                                                                    
                                                                                
c1 = fit(np.concatenate(all_x1), np.concatenate(all_v1), np.concatenate(all_a1))
