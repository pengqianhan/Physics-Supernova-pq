x1 = data['state'][0, :]                                                        
                                                                                
# Use a standard time step assumption (common in such trajectory analysis tasks)
dt = 0.01                                                                       
                                                                                
# Calculate derivatives                                                         
# x1[0], x1[1], x1[2] ...                                                       
# v[0] = (x1[1]-x1[0])/dt                                                       
# a[0] = (v[1]-v[0])/dt = (x1[2] - 2*x1[1] + x1[0]) / dt^2                      
X = x1[1:-1]                                                                    
V = (x1[2:] - x1[:-2]) / (2 * dt)                                               
A = (x1[2:] - 2 * x1[1:-1] + x1[:-2]) / (dt**2)                                 
                                                                                
# Identify modes based on velocity direction                                    
mode1_mask = V > 0.5  # Increasing x1                                           
mode2_mask = V < -0.5 # Decreasing x1                                           
                                                                                
def fit_dynamics(A_m, V_m, X_m):                                                
    # Fit A = a*V + b*X + c                                                     
    M = np.column_stack([V_m, X_m, np.ones_like(X_m)])                          
    coeffs, residues, rank, s = lstsq(M, A_m)                                   
    return coeffs                                                               
                                                                                
# Identify coefficients for both modes using the first sample                   
