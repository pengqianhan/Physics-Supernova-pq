import numpy as np                                                              
                                                                                
def run_analysis():                                                             
    for p_idx in range(len(DATA_FILE_PATHS)):                                   
        data = np.load(DATA_FILE_PATHS[p_idx])                                  
        x = data['state'][0]                                                    
        print(f"\n--- File {p_idx} (len {len(x)}) ---")                         
                                                                                
        diffs = np.diff(x)                                                      
        # Jumps are where diff is very large                                    
        jumps = np.where(np.abs(diffs) > 10)[0]                                 
        # Normal diffs                                                          
        normal_diffs = diffs[np.abs(diffs) <= 10]                               
        print(f"  Normal diff range: [{np.min(normal_diffs):.6f},               
{np.max(normal_diffs):.6f}]")                                                   
                                                                                
        if len(jumps) > 0:                                                      
            print(f"  First 3 jumps:")                                          
            for j in jumps[:3]:                                                 
                print(f"    At index {j}: x={x[j]:.4f} -> x={x[j+1]:.4f}        
(diff={x[j+1]-x[j]:.2f})")                                                      
                                                                                
        # Fit one segment                                                       
        start = 0                                                               
        if len(jumps) > 0:                                                      
            end = jumps[0]                                                      
        else:                                                                   
            end = len(x) - 1                                                    
                                                                                
        seg = x[start:end+1]                                                    
        if len(seg) > 50:                                                       
            # Model: x[k+2] = a*x[k+1] + b*x[k] + c + d*x[k]^2 + e*x[k+1]^2 +   
f*x[k]*x[k+1]                                                                   
            X = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2),      
                                 seg[:-2]**2, seg[1:-1]**2, seg[:-2]*seg[1:-1]])
            Y = seg[2:]                                                         
            c, res, _, _ = np.linalg.lstsq(X, Y, rcond=None)                    
            print(f"  Coeffs: a={c[0]:.6f}, b={c[1]:.6f}, c={c[2]:.6f}")        
            print(f"  Non-linear: x0^2={c[3]:.8f}, x1^2={c[4]:.8f},             
x0x1={c[5]:.8f}")                                                               
            print(f"  Residual: {np.mean(res) if res.size > 0 else 0:.2e}")     
                                                                                
run_analysis()                                                                  
