# Numerical differentiation                                                     
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Identify modes: x1 oscillates between 10 and 125.                             
# Let's detect jumps in x1_dot which signify switching or resets.               
diff_x1_dot = np.abs(np.diff(x1_dot))                                           
threshold = np.percentile(diff_x1_dot, 99.5)                                    
jump_indices = np.where(diff_x1_dot > threshold)[0]                             
                                                                                
# Group jump indices to find segments                                           
