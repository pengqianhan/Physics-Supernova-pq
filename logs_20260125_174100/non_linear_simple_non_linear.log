import numpy as np                                                              
                                                                                
# Load the first sample                                                         
data = np.load('data_all/non_linear/simple_non_linear/sample_0.npz')            
state = data['state'].flatten()                                                 
dt = 0.001                                                                      
x1 = state                                                                      
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Identify switches                                                             
switches = []                                                                   
for i in range(1, len(x1_dot)):                                                 
    if np.sign(x1_dot[i]) != np.sign(x1_dot[i-1]) and abs(x1_dot[i] -           
x1_dot[i-1]) > 1.0:                                                             
        switches.append(i)                                                      
                                                                                
# Guard and Reset Analysis                                                      
guards = []                                                                     
resets_k = []                                                                   
for s in switches:                                                              
    v_before = x1_dot[s-1]                                                      
    v_after = x1_dot[s]                                                         
    k = -v_after / v_before                                                     
    guards.append(x1[s])                                                        
    resets_k.append(k)                                                          
                                                                                
# Split into two types of guards                                                
# Guard 1 ~ 125, Guard 2 ~ 10                                                   
g1_indices = [i for i, g in enumerate(guards) if g > 100]                       
g2_indices = [i for i, g in enumerate(guards) if g < 50]                        
                                                                                
k1 = np.mean([resets_k[i] for i in g1_indices]) if g1_indices else None         
k2 = np.mean([resets_k[i] for i in g2_indices]) if g2_indices else None         
guard1_val = np.mean([guards[i] for i in g1_indices]) if g1_indices else None   
guard2_val = np.mean([guards[i] for i in g2_indices]) if g2_indices else None   
                                                                                
# Mode Fitting                                                                  
buffer = 15                                                                     
def get_clean_indices(start, end, buff):                                        
    if end - start > 2 * buff:                                                  
        return np.arange(start + buff, end - buff)                              
    return np.array([], dtype=int)                                              
                                                                                
segments = []                                                                   
prev = 0                                                                        
for s in switches:                                                              
    idx_range = get_clean_indices(prev, s, buffer)                              
    if len(idx_range) > 0: segments.append(idx_range)                           
    prev = s                                                                    
idx_range = get_clean_indices(prev, len(x1), buffer)                            
if len(idx_range) > 0: segments.append(idx_range)                               
                                                                                
inc_idx = []                                                                    
dec_idx = []                                                                    
for seg in segments:                                                            
    if np.mean(x1_dot[seg]) > 0: inc_idx.extend(seg)                            
    else: dec_idx.extend(seg)                                                   
                                                                                
def fit_ode(idx):                                                               
    if not idx: return None                                                     
    Y = x1_ddot[idx]                                                            
    X = np.column_stack([x1_dot[idx], x1[idx], x1[idx]**2,                      
np.ones_like(x1[idx])])                                                         
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    # Calculate R2 using np.dot                                                 
    y_hat = np.dot(X, coeffs)                                                   
    ss_res = np.sum((Y - y_hat)**2)                                             
    ss_tot = np.sum((Y - np.mean(Y))**2)                                        
    return coeffs, 1 - (ss_res / ss_tot)                                        
                                                                                
res_inc = fit_ode(inc_idx)                                                      
res_dec = fit_ode(dec_idx)                                                      
                                                                                
print(f"Guard 1: x ≈ {guard1_val}, k ≈ {k1}")                                   
print(f"Guard 2: x ≈ {guard2_val}, k ≈ {k2}")                                   
print(f"Inc Coeffs (c1, c2, c3, bias): {res_inc[0]}, R2: {res_inc[1]}")         
print(f"Dec Coeffs (c1, c2, c3, bias): {res_dec[0]}, R2: {res_dec[1]}")         
                                                                                
