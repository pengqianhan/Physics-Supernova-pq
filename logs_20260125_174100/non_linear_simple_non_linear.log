segments.append((start, len(x1), 1 if v[start] > 0 else 2))                     
                                                                                
def fit_ode(idx_range):                                                         
    # Within a segment, compute derivatives                                     
    s, e = idx_range                                                            
    # Use central differences or just forward for simplicity if dt is small     
    # To be accurate for x1'', we use points i-1, i, i+1                        
    # Thus we use indices from s+1 to e-1                                       
    if e - s < 5: return None                                                   
                                                                                
    sub_x = x1[s:e]                                                             
    # x1' at i: (x1[i+1] - x1[i-1]) / (2*dt)                                    
    # x1'' at i: (x1[i+1] - 2*x1[i] + x1[i-1]) / (dt**2)                        
