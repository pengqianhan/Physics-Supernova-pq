│         "dt": {                                                              │
│           "type": "number",                                                  │
│           "description": "Integration time step in seconds",                 │
│           "exclusiveMinimum": 0,                                             │
│           "examples": [                                                      │
│             0.001,                                                           │
│             0.01                                                             │
│           \]                                                                 │
│         },                                                                   │
│         "total_time": {                                                      │
│           "type": "number",                                                  │
