  import numpy as np                                                            
                                                                                
  def analyze_sample(path):                                                     
      data = np.load(path)                                                      
      x = data['state'][0]                                                      
      dx = np.diff(x)                                                           
                                                                                
      # Identify jumps                                                          
      jumps = np.where(np.diff(np.sign(dx)) != 0)[0] + 1                        
                                                                                
      resets = []                                                               
      for j in jumps:                                                           
          resets.append({                                                       
              'x': x[j],                                                        
              'v_old': dx[j-1],                                                 
              'v_new': dx[j],                                                   
              'ratio': dx[j]/dx[j-1]                                            
          })                                                                    
                                                                                
      # Segment for ODE fitting                                                 
      # Mode 2: Increasing, Mode 1: Decreasing                                  
      mode1_data = {'y': [], 'X': []}                                           
      mode2_data = {'y': [], 'X': []}                                           
                                                                                
      # Exclude 5 points around each jump                                       
      mask = np.ones(len(dx), dtype=bool)                                       
      for j in jumps:                                                           
          mask[max(0, j-5):min(len(dx), j+5)] = False                           
                                                                                
      for i in range(1, len(dx)):                                               
          if mask[i] and mask[i-1]:                                             
              accel = dx[i] - dx[i-1]                                           
              vel = dx[i-1]                                                     
              pos = x[i]                                                        
              features = [vel, pos, pos**2, 1.0]                                
                                                                                
              if dx[i] > 0:                                                     
                  mode2_data['y'].append(accel)                                 
                  mode2_data['X'].append(features)                              
              else:                                                             
                  mode1_data['y'].append(accel)                                 
                  mode1_data['X'].append(features)                              
                                                                                
      return resets, mode1_data, mode2_data                                     
                                                                                
  all_resets = []                                                               
  m1_y, m1_X = [], []                                                           
  m2_y, m2_X = [], []                                                           
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      resets, m1, m2 = analyze_sample(path)                                     
      all_resets.extend(resets)                                                 
      m1_y.extend(m1['y'])                                                      
      m1_X.extend(m1['X'])                                                      
      m2_y.extend(m2['y'])                                                      
      m2_X.extend(m2['X'])                                                      
                                                                                
  # Fit Mode 1                                                                  
