    coeffs, residuals, rank, s = np.linalg.lstsq(A, a_full[mask], rcond=None)   
    y_pred = A @ coeffs                                                         
    r2 = 1 - residuals[0] / (len(a_full[mask]) * np.var(a_full[mask]))          
    return coeffs, r2                                                           
                                                                                
