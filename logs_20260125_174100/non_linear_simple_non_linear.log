import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/simple_non_linear/sample_0.npz')            
print("Keys in npz:", data.files)                                               
                                                                                
state = data['state']                                                           
print("State shape:", state.shape)                                              
                                                                                
# Assuming x1 is the first column                                               
x1 = state[:, 0]                                                                
dt = 0.001                                                                      
                                                                                
# Calculate derivatives                                                         
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Identify modes                                                                
increasing_mask = x1_dot > 0                                                    
decreasing_mask = x1_dot < 0                                                    
                                                                                
# Fitting model: x1_ddot = A * x1_dot + B * x1 + C * x1^2 + D                   
def fit_model(mask):                                                            
    if np.sum(mask) < 4:                                                        
        return None                                                             
    y = x1_ddot[mask]                                                           
    X = np.column_stack([x1_dot[mask], x1[mask], x1[mask]**2,                   
np.ones_like(x1[mask])])                                                        
    # Solve linear least squares                                                
    coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)              
    return coeffs                                                               
                                                                                
coeffs_inc = fit_model(increasing_mask)                                         
coeffs_dec = fit_model(decreasing_mask)                                         
                                                                                
print("Coefficients Increasing (A, B, C, D):", coeffs_inc)                      
print("Coefficients Decreasing (A, B, C, D):", coeffs_dec)                      
                                                                                
# Switching conditions                                                          
# x1_dot changes sign                                                           
sign_changes = np.diff(np.sign(x1_dot))                                         
inc_to_dec_indices = np.where(sign_changes < 0)[0]                              
dec_to_inc_indices = np.where(sign_changes > 0)[0]                              
                                                                                
inc_to_dec_x1 = x1[inc_to_dec_indices]                                          
dec_to_inc_x1 = x1[dec_to_inc_indices]                                          
                                                                                
print("Switch Inc -> Dec x1 values:", inc_to_dec_x1)                            
print("Switch Dec -> Inc x1 values:", dec_to_inc_x1)                            
                                                                                
# Check for resets                                                              
# Compare x1_dot before and after switches                                      
resets = []                                                                     
for idx in np.where(sign_changes != 0)[0]:                                      
    v_before = x1_dot[idx]                                                      
    v_after = x1_dot[idx + 1]                                                   
    resets.append((v_before, v_after))                                          
                                                                                
print("Resets (before, after):", resets[:5])                                    
                                                                                
