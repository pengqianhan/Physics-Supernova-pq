  diff_v = np.diff(sign_v)                                                      
                                                                                
  # Mode 1 to 2: sign goes from +1 to -1 (diff = -2)                            
  idx1to2 = np.where(diff_v == -2)[0]                                           
  # Mode 2 to 1: sign goes from -1 to +1 (diff = 2)                             
  idx2to1 = np.where(diff_v == 2)[0]                                            
                                                                                
