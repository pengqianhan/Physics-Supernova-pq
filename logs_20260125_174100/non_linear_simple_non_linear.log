import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load data                                                                     
data_paths = ['data_all/non_linear/simple_non_linear/sample_0.npz',             
              'data_all/non_linear/simple_non_linear/sample_1.npz',             
              'data_all/non_linear/simple_non_linear/sample_2.npz']             
                                                                                
all_x = []                                                                      
for path in data_paths:                                                         
    data = np.load(path)                                                        
    all_x.append(data['x'])                                                     
                                                                                
# Combine all trajectories                                                      
x_data = np.vstack(all_x) # Shape (3 * 10001, 2)                                
# We focus on x1 (the first component)                                          
x1 = x_data[:, 0]                                                               
dt = 0.001                                                                      
                                                                                
# Calculate derivatives                                                         
v1 = np.gradient(x1, dt)                                                        
a1 = np.gradient(v1, dt)                                                        
                                                                                
# Identify modes                                                                
# Mode 1: increasing x1 (v1 > 0)                                                
# Mode 2: decreasing x1 (v1 < 0)                                                
# Filtering out indices where velocity is near zero to avoid noise at the       
peaks/valleys                                                                   
mask1 = v1 > 0.1                                                                
mask2 = v1 < -0.1                                                               
                                                                                
def fit_ode(x, v, a):                                                           
    # a_val = a*v + b*x + c                                                     
    # Solve A * [a, b, c]^T = Y                                                 
    A = np.stack([v, x, np.ones_like(x)], axis=1)                               
    params, residuals, rank, s = np.linalg.lstsq(A, a, rcond=None)              
    return params                                                               
                                                                                
params1 = fit_ode(x1[mask1], v1[mask1], a1[mask1])                              
