# Segments                                                                      
segments = []                                                                   
start = 1 # Skip the first padded zero                                          
for jump in jumps:                                                              
    segments.append((start, jump))                                              
    start = jump + 1                                                            
segments.append((start, len(x1)-1))                                             
                                                                                
def fit(seg_indices):                                                           
    s, e = seg_indices                                                          
    if e - s < 20: return None                                                  
    # Use middle of the segment to avoid boundary effects from numerical diff   
    sub_s, sub_e = s + 5, e - 5                                                 
    if sub_e <= sub_s: return None                                              
                                                                                
    X = np.column_stack([                                                       
        np.ones(sub_e - sub_s),                                                 
        x1[sub_s:sub_e],                                                        
        x1_dot[sub_s:sub_e],                                                    
        x1[sub_s:sub_e]**2                                                      
    ])                                                                          
    y = x1_ddot[sub_s:sub_e]                                                    
    c, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                              
    return c                                                                    
                                                                                
for i, seg in enumerate(segments):                                              
    c = fit(seg)                                                                
    if c is not None:                                                           
        print(f"Segment {i} ({seg[0]}-{seg[1]}): coeffs {c}")                   
                                                                                
