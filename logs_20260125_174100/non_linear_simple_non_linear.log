import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
                                                                                
def fit_with_dt(indices, x, dx, dt):                                            
    y_list = []                                                                 
    X_list = []                                                                 
    for i in indices:                                                           
        if i > 0 and i < len(dx):                                               
            # v = dx / dt                                                       
            # a = (dx[i] - dx[i-1]) / dt^2                                      
            accel = (dx[i] - dx[i-1]) / (dt**2)                                 
            vel = dx[i-1] / dt                                                  
            pos = x[i]                                                          
            y_list.append(accel)                                                
            X_list.append([vel, pos, pos**2, 1.0])                              
                                                                                
    y_arr = np.array(y_list)                                                    
    X_arr = np.array(X_list)                                                    
    coeffs, _, _, _ = np.linalg.lstsq(X_arr, y_arr, rcond=None)                 
    return coeffs                                                               
                                                                                
# Use all samples to get more data                                              
