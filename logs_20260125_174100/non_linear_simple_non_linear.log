import numpy as np                                                              
                                                                                
# Load the primary data file                                                    
data = np.load(DATA_FILE_PATH)                                                  
state = data['state']                                                           
# Usually 'input' might be control signals, but we focus on 'state'             
print(f"State shape: {state.shape}")                                            
print("First few rows of state:\n", state[:5])                                  
                                                                                
# x1 is variable and order 2, so x1[0] = position, x1[1] = velocity             
x1 = state[:, 0]                                                                
v1 = state[:, 1]                                                                
                                                                                
# Find where the velocity jumps to identify switching points                    
# A jump in velocity indicates a reset                                          
dv = np.abs(np.diff(v1))                                                        
jump_indices = np.where(dv > np.std(dv) * 5)[0]                                 
