    if not indices: return None                                                 
    Y = x1_ddot[indices]                                                        
    X = np.column_stack([                                                       
        x1_dot[indices],                                                        
        x1[indices],                                                            
        x1[indices]**2,                                                         
        np.ones_like(x1[indices])                                               
    ])                                                                          
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
