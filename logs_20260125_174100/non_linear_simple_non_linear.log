import numpy as np                                                              
                                                                                
data = np.load(DATA_FILE_PATHS[0])                                              
x = data['state'][0]                                                            
                                                                                
# Transitions                                                                   
# Index 952: M2 -> M1                                                           
# Index 2617: M1 -> M2                                                          
# Index 4073: M2 -> M1                                                          
# Index 5738: M1 -> M2                                                          
# Index 7194: M2 -> M1                                                          
# Index 8859: M1 -> M2                                                          
                                                                                
def get_params(x, segs):                                                        
    X = []                                                                      
    Y = []                                                                      
    for start, end in segs:                                                     
        for k in range(start, end - 1): # Need k, k+1, k+2                      
            d1 = x[k+1] - x[k]                                                  
            d2 = x[k+2] - 2*x[k+1] + x[k]                                       
            X.append([d1, x[k], 1.0])                                           
            Y.append(d2)                                                        
    X = np.array(X)                                                             
    Y = np.array(Y)                                                             
    params, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return params                                                               
                                                                                
mode1_segs = [(953, 2617), (4074, 5738), (7195, 8859)]                          
mode2_segs = [(0, 952), (2618, 4073), (5739, 7194), (8860, 9998)]               
                                                                                
