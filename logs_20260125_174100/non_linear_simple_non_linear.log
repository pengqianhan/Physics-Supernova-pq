import numpy as np                                                              
                                                                                
def fit_difference_eq(path):                                                    
    x = np.load(path)['state'][0]                                               
    x_k2 = x[2:]                                                                
    x_k1 = x[1:-1]                                                              
    x_k0 = x[:-2]                                                               
                                                                                
    # Modes based on direction                                                  
    v = np.diff(x)                                                              
    m1 = v[:-1] < 0                                                             
    m2 = v[:-1] > 0                                                             
                                                                                
    def fit(k2, k1, k0):                                                        
        X = np.column_stack([k1, k0, k0**2, np.ones_like(k0)])                  
        c, _, _, _ = np.linalg.lstsq(X, k2, rcond=None)                         
        return c                                                                
                                                                                
    c1 = fit(x_k2[m1], x_k1[m1], x_k0[m1])                                      
    c2 = fit(x_k2[m2], x_k1[m2], x_k0[m2])                                      
    return c1, c2                                                               
                                                                                
c1, c2 = fit_difference_eq(DATA_FILE_PATHS[0])                                  
print("Mode 1 (x_k2 = a*x_k1 + b*x_k0 + c*x_k0^2 + d):", c1)                    
print("Mode 2 (x_k2 = a*x_k1 + b*x_k0 + c*x_k0^2 + d):", c2)                    
                                                                                
