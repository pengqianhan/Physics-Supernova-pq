import numpy as np                                                              
                                                                                
def fit_dynamics(x):                                                            
    # We want to fit x[i+2] = alpha * x[i+1] + beta * x[i] + gamma              
    # Create the matrices for linear regression                                 
    n = len(x)                                                                  
    if n < 5: return None                                                       
                                                                                
    Y = x[2:]                                                                   
    X = np.column_stack([x[1:-1], x[:-2], np.ones(n-2)])                        
                                                                                
    # Solve using least squares                                                 
    coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    return coeffs                                                               
                                                                                
# Identify segments in Sample 0                                                 
x = np.load(DATA_FILE_PATHS[0])['state'][0]                                     
dx = np.diff(x)                                                                 
sign_changes = np.where(np.diff(np.sign(dx)))[0]                                
                                                                                
# Add start and end indices                                                     
indices = [0] + list(sign_changes + 1) + [len(x)]                               
                                                                                
for i in range(len(indices)-1):                                                 
    start, end = indices[i], indices[i+1]                                       
    segment = x[start:end]                                                      
    coeffs = fit_dynamics(segment)                                              
    direction = "Increasing" if segment[1] > segment[0] else "Decreasing"       
    print(f"Segment {i} ({direction}), length {len(segment)}: coeffs {coeffs}") 
                                                                                
