│           "minLength": 1,                                                    │
│           "examples": [                                                      │
│             "x1 > 0.5",                                                      │
│             "x1 <= 0 and x2 > 1",                                            │
│             "abs(x1) >= 1.2"                                                 │
│           \]                                                                 │
│         },                                                                   │
│         "reset": {                                                           │
│           "type": "object",                                                  │
│           "description": "Optional state reset map. Keys are variable names, │
