            s, e = starts[i], ends[i]                                           
            if e - s < 20: continue                                             
            seg = x[s:e+1]                                                      
            # Try different models                                              
            # 1. Linear                                                         
            X1 = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2)])    
            Y = seg[2:]                                                         
            c1, res1, _, _ = np.linalg.lstsq(X1, Y, rcond=None)                 
                                                                                
            # 2. x0^2                                                           
            X2 = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2),     
seg[:-2]**2])                                                                   
            c2, res2, _, _ = np.linalg.lstsq(X2, Y, rcond=None)                 
                                                                                
            print(f"  Seg {i} ({s}-{e}):")                                      
            print(f"    Linear: a={c1[0]:.5f}, b={c1[1]:.5f}, c={c1[2]:.5f},    
Res={np.mean(res1) if res1.size > 0 else 0:.2e}")                               
            print(f"    x0^2:   a={c2[0]:.5f}, b={c2[1]:.5f}, c={c2[2]:.5f},    
d={c2[3]:.8f}, Res={np.mean(res2) if res2.size > 0 else 0:.2e}")                
                                                                                
