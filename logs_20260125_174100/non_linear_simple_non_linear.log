def analyze_all():                                                              
    all_resets = []                                                             
    all_coeffs = []                                                             
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x = data['state'][0]                                                    
                                                                                
