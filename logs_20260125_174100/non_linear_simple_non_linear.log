            a = (dx[i] - dx[i-1]) / (dt**2)                                     
            p = x[i]                                                            
            if dx[i] > 0:                                                       
                m2_x.append(p)                                                  
                m2_v.append(v)                                                  
                m2_a.append(a)                                                  
            else:                                                               
                m1_x.append(p)                                                  
                m1_v.append(v)                                                  
                m1_a.append(a)                                                  
    return (m1_x, m1_v, m1_a), (m2_x, m2_v, m2_a)                               
                                                                                
