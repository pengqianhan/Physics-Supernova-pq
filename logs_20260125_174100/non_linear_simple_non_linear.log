for i in range(len(segments) - 1):                                              
    end_of_seg = segments[i][1] - 1                                             
    start_of_next = segments[i+1][0]                                            
    v_before = v1[end_of_seg]                                                   
    v_after = v1[start_of_next]                                                 
    x_switch = x1[end_of_seg]                                                   
    resets.append({'x': x_switch, 'v_before': v_before, 'v_after': v_after})    
                                                                                
print("Reset analysis (sample):", resets[:5])                                   
                                                                                
