    x = data['state'][0]                                                        
    dx = np.diff(x)                                                             
    jumps = np.where(np.diff(np.sign(dx)) != 0)[0] + 1                          
    mask = np.ones(len(dx), dtype=bool)                                         
    for j in jumps:                                                             
        mask[max(0, j-10):min(len(dx), j+10)] = False                           
                                                                                
    m1_x, m1_v, m1_a = [], [], []                                               
    m2_x, m2_v, m2_a = [], [], []                                               
                                                                                
