    v_pre = v[s_idx]                                                            
    v_post = v[s_idx+1]                                                         
    x_s = x1[s_idx+1]                                                           
    if x_s > 100:                                                               
        ratio_125.append(v_post / v_pre)                                        
    else:                                                                       
        ratio_10.append(v_post / v_pre)                                         
                                                                                
avg_ratio_125 = np.mean(ratio_125)                                              
avg_ratio_10 = np.mean(ratio_10)                                                
                                                                                
final_answer({                                                                  
