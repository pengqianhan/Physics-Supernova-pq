import numpy as np                                                              
                                                                                
def analyze_switches():                                                         
    for i in range(3):                                                          
        x = np.load(DATA_FILE_PATHS[i])['state'][0]                             
        # Fit global ODE to see predictions                                     
        Y = x[2:]; X = np.column_stack([x[1:-1], x[:-2], np.ones(len(Y)),       
x[:-2]**2])                                                                     
        c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                          
                                                                                
        preds = c[0]*x[1:-1] + c[1]*x[:-2] + c[2] + c[3]*x[:-2]**2              
        errors = x[2:] - preds                                                  
                                                                                
        # Large errors are switching points!                                    
        switches = np.where(np.abs(errors) > 0.05)[0] + 2                       
                                                                                
        print(f"\n--- File {i} ---")                                            
        for s in switches:                                                      
            print(f"Switch at {s}: x[s-2:s+1]={x[s-2:s+1]},                     
pred={preds[s-2]:.4f}, error={errors[s-2]:.4f}")                                
            # Guard                                                             
            print(f"  Guard: x[s-1]={x[s-1]:.4f}")                              
            # Reset                                                             
            print(f"  Reset state: x1[0]={x[s-1]:.4f}, x1[1]={x[s]:.4f}")       
                                                                                
analyze_switches()                                                              
