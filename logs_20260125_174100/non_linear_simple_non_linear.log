import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/simple_non_linear/sample_0.npz')            
t = data['t']                                                                   
x = data['x']                                                                   
                                                                                
# x[:, 0] is x1, x[:, 1] is x1', x[:, 2] is x1''                                
x1 = x[:, 0]                                                                    
dx1 = x[:, 1]                                                                   
ddx1 = x[:, 2]                                                                  
                                                                                
# Segment the data                                                              
# Mode A: dx1 < 0 (decreasing)                                                  
# Mode B: dx1 > 0 (increasing)                                                  
mask_a = dx1 < -0.1                                                             
mask_b = dx1 > 0.1                                                              
                                                                                
def fit_mode(mask):                                                             
    X = np.column_stack([dx1[mask], x1[mask], x1[mask]**2,                      
np.ones_like(x1[mask])])                                                        
    y = ddx1[mask]                                                              
    model = LinearRegression(fit_intercept=False).fit(X, y)                     
    return model.coef_                                                          
                                                                                
coeffs_a = fit_mode(mask_a)                                                     
coeffs_b = fit_mode(mask_b)                                                     
                                                                                
print("Coefficients Mode A (a, b, c, d):", coeffs_a)                            
print("Coefficients Mode B (a, b, c, d):", coeffs_b)                            
                                                                                
# Identify switching points and resets                                          
# Mode A -> Mode B happens when x1 ~ 10                                         
# Mode B -> Mode A happens when x1 ~ 125                                        
                                                                                
# Finding jumps in dx1                                                          
resets = []                                                                     
for i in range(1, len(dx1)):                                                    
    # Check for sign change in dx1                                              
    if dx1[i-1] < 0 and dx1[i] > 0:                                             
        # A to B transition at x1 ~ 10                                          
        resets.append(('A_to_B', x1[i], dx1[i-1], dx1[i]))                      
