def analyze_sample(path):                                                       
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    dx = np.diff(x)                                                             
                                                                                
    # Identify jumps                                                            
    jumps = np.where(np.diff(np.sign(dx)) != 0)[0] + 1                          
                                                                                
    resets = []                                                                 
    for j in jumps:                                                             
        resets.append({                                                         
            'x': x[j],                                                          
            'v_old': dx[j-1],                                                   
