    results[mode].append(popt)                                                  
                                                                                
# Average coefficients for each mode                                            
avg_coeffs = {}                                                                 
for mode in results:                                                            
    if results[mode]:                                                           
        avg_coeffs[mode] = np.mean(results[mode], axis=0)                       
                                                                                
# Switching conditions and resets                                               
# Peaks are switches from increasing to decreasing                              
# Valleys are switches from decreasing to increasing                            
