import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the data files                                                           
data_samples = []                                                               
for path in DATA_FILE_PATHS:                                                    
    data_samples.append(np.load(path))                                          
                                                                                
# Analyze initial values and slopes                                             
results_initial = []                                                            
for i, data in enumerate(data_samples):                                         
    t = data['t']                                                               
    x1 = data['x'][:, 0]                                                        
    dt = t[1] - t[0]                                                            
    dx1_dt = np.gradient(x1, dt)                                                
    results_initial.append({                                                    
        'sample': i,                                                            
        'x1_0': x1[0],                                                          
        'dx1_dt_0': dx1_dt[0]                                                   
    })                                                                          
                                                                                
print("Initial Values and Slopes:")                                             
print(pd.DataFrame(results_initial))                                            
                                                                                
# Identify modes and switches for the first sample as a representative case     
data = data_samples[0]                                                          
t = data['t']                                                                   
x1 = data['x'][:, 0]                                                            
dt = t[1] - t[0]                                                                
v1 = np.gradient(x1, dt)                                                        
a1 = np.gradient(v1, dt)                                                        
                                                                                
# Identify switches                                                             
peaks = []                                                                      
troughs = []                                                                    
for i in range(1, len(v1) - 1):                                                 
    if v1[i-1] > 0 and v1[i] <= 0: # Peak                                       
        peaks.append((t[i], x1[i], v1[i-1], v1[i+1]))                           
    elif v1[i-1] < 0 and v1[i] >= 0: # Trough                                   
        troughs.append((t[i], x1[i], v1[i-1], v1[i+1]))                         
                                                                                
