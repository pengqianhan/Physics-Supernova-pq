from scipy.optimize import curve_fit                                            
                                                                                
def solve_regression(pos, vel, accel):                                          
    # Model: accel = a*vel + b*pos + c + d*pos**2                               
    # Form: Y = M * Beta                                                        
    # Y = accel                                                                 
    # M = [vel, pos, 1, pos**2]                                                 
    M = np.column_stack([vel, pos, np.ones_like(pos), pos**2])                  
    beta, residuals, rank, s = np.linalg.lstsq(M, accel, rcond=None)            
    return beta                                                                 
                                                                                
