        # Jumps info                                                            
        for j in jumps:                                                         
            all_resets.append({                                                 
                'val_before': x[j],                                             
                'val_after': (x[j+1], x[j+2]),                                  
                'type': 'down' if x[j+1] < x[j] else 'up'                       
            })                                                                  
                                                                                
        # Fit modes                                                             
        starts = [0] + [j+1 for j in jumps]                                     
