│ and transitions",                                                            │
│       "required": [                                                          │
│         "var",                                                               │
│         "mode",                                                              │
│         "edge"                                                               │
│       \],                                                                    │
│       "properties": {                                                        │
│         "var": {                                                             │
│           "type": "string",                                                  │
