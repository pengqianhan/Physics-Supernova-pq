│ x[1\], ...]. Use '' to preserve current value.",                             │
│             "items": {                                                       │
│               "oneOf": [                                                     │
│                 {                                                            │
│                   "type": "string"                                           │
│                 },                                                           │
│                 {                                                            │
│                   "type": "number"                                           │
│                 }                                                            │
│               \]                                                             │
│             }                                                                │
│           },                                                                 │
│           "examples": [                                                      │
│             {                                                                │
│               "x1": [                                                        │
│                 0                                                            │
│               \],                                                            │
│               "x2": [                                                        │
