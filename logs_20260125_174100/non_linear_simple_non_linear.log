import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
def analyze_hybrid_automaton(file_paths):                                       
    all_segments = { 'increasing': [], 'decreasing': [] }                       
    resets = []                                                                 
    dt = 0.01 # Assumed time step based on typical simulation densities         
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        x1 = data['state'][0]                                                   
                                                                                
        # Calculate numerical derivatives                                       
        v = np.diff(x1) / dt                                                    
        a = np.diff(v) / dt                                                     
                                                                                
        # Align lengths                                                         
        x_val = x1[1:-1]                                                        
        v_val = v[:-1]                                                          
        acc_val = a                                                             
                                                                                
        # Segment based on velocity sign                                        
        for i in range(len(v_val)):                                             
            mode = 'increasing' if v_val[i] > 0 else 'decreasing'               
            all_segments[mode].append([acc_val[i], v_val[i], x_val[i],          
x_val[i]**2])                                                                   
                                                                                
        # Check for resets at peaks/troughs                                     
        # Finding indices where velocity changes sign                           
        v_signs = np.sign(v)                                                    
        sign_changes = np.where(v_signs[:-1] != v_signs[1:])[0]                 
        for idx in sign_changes:                                                
            resets.append({                                                     
                'x1': x1[idx+1],                                                
                'v_before': v[idx],                                             
                'v_after': v[idx+1]                                             
            })                                                                  
                                                                                
    # Fit models for each mode                                                  
    results = {}                                                                
    for mode in ['increasing', 'decreasing']:                                   
        data_mode = np.array(all_segments[mode])                                
        Y = data_mode[:, 0]                                                     
        X = data_mode[:, 1:]                                                    
        model = LinearRegression().fit(X, Y)                                    
        results[mode] = {                                                       
            'a': model.coef_[0],                                                
            'b': model.coef_[1],                                                
            'c': model.intercept_,                                              
            'd': model.coef_[2],                                                
            'score': model.score(X, Y)                                          
        }                                                                       
                                                                                
    return results, resets                                                      
                                                                                
results, resets = analyze_hybrid_automaton(DATA_FILE_PATHS)                     
print("Mode Equations Coefficients:")                                           
