import numpy as np                                                              
                                                                                
data = np.load('data_all/non_linear/simple_non_linear/sample_0.npz')            
x1 = data['state'][0, :]                                                        
                                                                                
# Use simple differences for velocity                                           
v = np.diff(x1) # v[i] = x1[i+1] - x1[i]                                        
# acceleration                                                                  
a = np.diff(v)  # a[i] = v[i+1] - v[i] = x1[i+2] - 2*x1[i+1] + x1[i]            
                                                                                
# Align arrays                                                                  
x1_fit = x1[1:-1]                                                               
v_fit = v[:-1]                                                                  
a_fit = a                                                                       
                                                                                
# Identify modes                                                                
# Mode A: v < 0                                                                 
# Mode B: v > 0                                                                 
                                                                                
# Identify switches                                                             
switches = []                                                                   
for i in range(1, len(v)):                                                      
    if v[i-1] * v[i] < 0:                                                       
        switches.append(i)                                                      
                                                                                
print(f"Switches: {switches}")                                                  
                                                                                
for s in switches[:2]:                                                          
    print(f"Switch at index {s}, x1={x1[s]}")                                   
    print(f"v before: {v[s-2:s]}")                                              
    print(f"v after:  {v[s:s+2]}")                                              
                                                                                
# Segment and fit                                                               
mask_A = v_fit < 0                                                              
mask_B = v_fit > 0                                                              
                                                                                
def fit_ode(mask):                                                              
    Y = a_fit[mask]                                                             
    X = np.column_stack([v_fit[mask], x1_fit[mask], x1_fit[mask]**2,            
np.ones(np.sum(mask))])                                                         
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
coeffs_A = fit_ode(mask_A)                                                      
coeffs_B = fit_ode(mask_B)                                                      
                                                                                
print("Coefficients A (a, b, c, d):", coeffs_A)                                 
print("Coefficients B (a, b, c, d):", coeffs_B)                                 
                                                                                
