from sklearn.linear_model import LinearRegression                               
                                                                                
# Re-loading data                                                               
data_0 = np.load(DATA_FILE_PATHS[0])                                            
s0 = data_0['state'][0] # 1D array                                              
                                                                                
# Use a default dt = 0.1 for now, or try to find it.                            
# If the relationship is linear, any dt will show a linear relationship,        
# only the coefficients will change.                                            
dt = 0.1                                                                        
                                                                                
def get_derivatives(x, dt):                                                     
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    return v, a                                                                 
                                                                                
v0, a0 = get_derivatives(s0, dt)                                                
                                                                                
# Find segments                                                                 
# Increasing segment: start to 953                                              
seg1_x = s0[10:940]                                                             
seg1_v = v0[10:940]                                                             
seg1_a = a0[10:940]                                                             
                                                                                
# Regression for seg1: a = a_coeff * v + b_coeff * x + c                        
X1 = np.column_stack((seg1_v, seg1_x))                                          
reg1 = LinearRegression().fit(X1, seg1_a)                                       
print("Seg 1 (Increasing):")                                                    
