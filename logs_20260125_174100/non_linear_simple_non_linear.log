def analyze_segment(x_seg, dt):                                                 
    v_seg = np.diff(x_seg) / dt                                                 
    a_seg = np.diff(v_seg) / dt                                                 
                                                                                
    # Align lengths                                                             
    x_reg = x_seg[1:-1]                                                         
    v_reg = v_seg[:-1] # or (v_seg[:-1] + v_seg[1:]) / 2                        
    a_reg = a_seg                                                               
                                                                                
    # Features: v, x, 1, x^2, v^2                                               
    X = np.column_stack([v_reg, x_reg, np.ones_like(x_reg), x_reg**2, v_reg**2])
    coeffs, residuals, rank, s = np.linalg.lstsq(X, a_reg, rcond=None)          
    return coeffs, residuals                                                    
                                                                                
