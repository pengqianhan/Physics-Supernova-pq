import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
                                                                                
def get_coeffs(x1, x1_dot, x1_ddot, mask):                                      
    if np.sum(mask) < 20: return None                                           
    X = np.column_stack([np.ones(np.sum(mask)), x1[mask], x1_dot[mask],         
x1[mask]**2])                                                                   
    c, _, _, _ = np.linalg.lstsq(X, x1_ddot[mask], rcond=None)                  
    return c                                                                    
                                                                                
for i in range(3):                                                              
    data = np.load(DATA_FILE_PATHS[i])                                          
    x = data['state'][0, :]                                                     
    xd = np.gradient(x, dt)                                                     
    xdd = np.gradient(xd, dt)                                                   
                                                                                
    # Exclude jumps                                                             
    diff_xd = np.abs(np.diff(xd))                                               
    jump_mask = np.zeros_like(x, dtype=bool)                                    
    jumps = np.where(diff_xd > 10)[0]                                           
    for j in jumps:                                                             
        jump_mask[max(0, j-2):min(len(x), j+3)] = True                          
                                                                                
    falling = (xd < -1) & (~jump_mask)                                          
    rising = (xd > 1) & (~jump_mask)                                            
                                                                                
    c_f = get_coeffs(x, xd, xdd, falling)                                       
    c_r = get_coeffs(x, xd, xdd, rising)                                        
                                                                                
    print(f"Sample {i} Falling Coeffs:", c_f)                                   
    print(f"Sample {i} Rising Coeffs:", c_r)                                    
                                                                                
