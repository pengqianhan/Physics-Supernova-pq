    pos = x[1:-1]                                                               
                                                                                
    # Filter jumps                                                              
    jumps = np.where(np.abs(np.diff(dx)) > 0.1)[0]                              
    mask = np.ones(len(a), dtype=bool)                                          
    for j in jumps:                                                             
        mask[max(0, j-10):min(len(a), j+10)] = False                            
                                                                                
    for i in range(len(a)):                                                     
        if mask[i]:                                                             
            if v[i] > 0:                                                        
                all_data_m2.append([v[i], pos[i], pos[i]**2, a[i]])             
