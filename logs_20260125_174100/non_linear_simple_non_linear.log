import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/simple_non_linear/sample_0.npz')            
X = data['X']                                                                   
t = data['t']                                                                   
                                                                                
# Determine dt                                                                  
dt = t[1] - t[0]                                                                
                                                                                
# Extract position and velocity as requested                                    
# x1[0] is position, x1[1] is velocity, x1[2] is acceleration                   
pos = X[0, :]                                                                   
vel = np.diff(pos, prepend=pos[0]) / dt                                         
acc = np.diff(vel, prepend=vel[0]) / dt                                         
                                                                                
# Transition identification                                                     
peaks = [] # 1 -> 2 (pos to neg)                                                
troughs = [] # 2 -> 1 (neg to pos)                                              
                                                                                
for i in range(1, len(vel)):                                                    
    if vel[i-1] > 0 and vel[i] <= 0:                                            
        peaks.append(i)                                                         
    elif vel[i-1] < 0 and vel[i] >= 0:                                          
        troughs.append(i)                                                       
                                                                                
# Calculate ratios                                                              
peak_ratios = []                                                                
for idx in peaks:                                                               
    if idx > 0 and idx < len(vel):                                              
        v_pre = vel[idx-1]                                                      
        v_post = vel[idx]                                                       
        peak_ratios.append(v_post / v_pre)                                      
                                                                                
trough_ratios = []                                                              
for idx in troughs:                                                             
    if idx > 0 and idx < len(vel):                                              
        v_pre = vel[idx-1]                                                      
        v_post = vel[idx]                                                       
        trough_ratios.append(v_post / v_pre)                                    
                                                                                
avg_peak_ratio = np.mean(peak_ratios) if peak_ratios else 0                     
avg_trough_ratio = np.mean(trough_ratios) if trough_ratios else 0               
                                                                                
# Regression: acc = a*vel + b*pos + c*pos**2 + bias                             
def perform_regression(mask):                                                   
    y = acc[mask]                                                               
    x_v = vel[mask]                                                             
    x_p = pos[mask]                                                             
    x_p2 = pos[mask]**2                                                         
                                                                                
    # Design matrix                                                             
    A = np.stack([x_v, x_p, x_p2, np.ones_like(x_v)], axis=-1)                  
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    return coeffs                                                               
                                                                                
mode1_mask = vel > 0                                                            
mode2_mask = vel < 0                                                            
                                                                                
coeffs_m1 = perform_regression(mode1_mask)                                      
coeffs_m2 = perform_regression(mode2_mask)                                      
                                                                                
print(f"Avg Peak Ratio: {avg_peak_ratio}")                                      
print(f"Avg Trough Ratio: {avg_trough_ratio}")                                  
print(f"Mode 1 Coeffs (a, b, c, bias): {coeffs_m1}")                            
