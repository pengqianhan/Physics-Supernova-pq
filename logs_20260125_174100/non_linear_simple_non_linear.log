    current_mode = "increasing" if increasing[0] else "decreasing"              
    start_idx = 0                                                               
    for i in range(1, len(v1)):                                                 
        mode = "increasing" if v1[i] > 0 else "decreasing"                      
        if mode != current_mode:                                                
            segments.append((start_idx, i, current_mode))                       
            start_idx = i                                                       
            current_mode = mode                                                 
    segments.append((start_idx, len(v1), current_mode))                         
                                                                                
print(f"Found {len(segments)} segments.")                                       
                                                                                
