```python                                                                       
import numpy as np                                                              
                                                                                
def analyze():                                                                  
    import numpy as np                                                          
    paths = DATA_FILE_PATHS                                                     
                                                                                
    all_resets = []                                                             
    all_coeffs = []                                                             
                                                                                
    for p_idx, path in enumerate(paths):                                        
        data = np.load(path)                                                    
        x = data['state'][0]                                                    
                                                                                
        diffs = np.diff(x)                                                      
        # We need a robust jump detection. Let's use a large threshold.         
        jumps = np.where(np.abs(diffs) > 10)[0]                                 
                                                                                
        # Segment analysis                                                      
        starts = [0] + [j+1 for j in jumps]                                     
        ends = [j for j in jumps] + [len(x)-1]                                  
                                                                                
        for s, e in zip(starts, ends):                                          
            if e - s > 20:                                                      
                seg = x[s:e+1]                                                  
                # Try a broad non-linear model                                  
                # x[k+2] = a*x[k+1] + b*x[k] + c + d*x[k]^2 + e*x[k+1]^2 +      
f*x[k]*x[k+1]                                                                   
                X = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2),  
                                     seg[:-2]**2, seg[1:-1]**2,                 
seg[:-2]*seg[1:-1]])                                                            
                Y = seg[2:]                                                     
                c, res, _, _ = np.linalg.lstsq(X, Y, rcond=None)                
                all_coeffs.append(c)                                            
                                                                                
        for j in jumps:                                                         
            all_resets.append({                                                 
                'before': x[j],                                                 
                'after': (x[j+1], x[j+2]),                                      
                'direction': 'down' if x[j+1] < x[j] else 'up'                  
            })                                                                  
                                                                                
    # Process coefficients                                                      
    all_coeffs = np.array(all_coeffs)                                           
    mean_c = np.mean(all_coeffs, axis=0)                                        
    std_c = np.std(all_coeffs, axis=0)                                          
                                                                                
    print("Coefficients (a, b, c, x0^2, x1^2, x0x1):")                          
    print("Mean:", mean_c)                                                      
    print("Std: ", std_c)                                                       
                                                                                
    # Process resets                                                            
    jumps_down = [r for r in all_resets if r['direction'] == 'down']            
    jumps_up = [r for r in all_resets if r['direction'] == 'up']                
                                                                                
    print(f"\nJumps Down: {len(jumps_down)}")                                   
    if jumps_down:                                                              
        befores = [r['before'] for r in jumps_down]                             
        afters = [r['after'] for r in jumps_down]                               
        print(f"  Before: avg {np.mean(befores):.4f}, range                     
[{np.min(befores):.4f}, {np.max(befores):.4f}]")                                
        print(f"  Reset to: {np.mean([a[0] for a in afters]):.4f},              
{np.mean([a[1] for a in afters]):.4f}")                                         
                                                                                
    print(f"\nJumps Up: {len(jumps_up)}")                                       
    if jumps_up:                                                                
        befores = [r['before'] for r in jumps_up]                               
        afters = [r['after'] for r in jumps_up]                                 
        print(f"  Before: avg {np.mean(befores):.4f}, range                     
[{np.min(befores):.4f}, {np.max(befores):.4f}]")                                
        print(f"  Reset to: {np.mean([a[0] for a in afters]):.4f},              
{np.mean([a[1] for a in afters]):.4f}")                                         
                                                                                
analyze()                                                                       
