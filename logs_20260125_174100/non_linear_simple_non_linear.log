import numpy as np                                                              
                                                                                
# Load data                                                                     
data_paths = DATA_FILE_PATHS                                                    
dt = 0.001                                                                      
                                                                                
def solve_lstsq(X, Y):                                                          
    return np.linalg.lstsq(X, Y, rcond=None)[0]                                 
                                                                                
def analyze_dynamics(state):                                                    
    v = np.diff(state) / dt                                                     
    # For k in [1, N-2], we can define central diff for v[k] and d2x[k]         
    # v[k] = (state[k+1] - state[k-1]) / (2*dt)                                 
    # d2x[k] = (state[k+1] - 2*state[k] + state[k-1]) / (dt**2)                 
                                                                                
    k_range = np.arange(1, len(state) - 1)                                      
    vk = (state[k_range + 1] - state[k_range - 1]) / (2 * dt)                   
    d2x = (state[k_range + 1] - 2 * state[k_range] + state[k_range - 1]) /      
(dt**2)                                                                         
    xk = state[k_range]                                                         
    xk2 = xk**2                                                                 
    ones = np.ones_like(xk)                                                     
                                                                                
    mask1 = vk > 1e-1 # Mode 1: increasing                                      
    mask2 = vk < -1e-1 # Mode 2: decreasing                                     
                                                                                
    def fit_cont(m):                                                            
        if np.sum(m) < 10: return None                                          
        X = np.column_stack([vk[m], xk[m], xk2[m], ones[m]])                    
        return solve_lstsq(X, d2x[m])                                           
                                                                                
    def fit_disc(m):                                                            
        # x[k+2] = a*x[k+1] + b*x[k] + c*x[k]^2 + d                             
        # Use only points where the whole window [k, k+1, k+2] is in the same   
mode                                                                            
        # Based on vk[k+1] being in the mode                                    
        idx = k_range[m]                                                        
        # We need k+1 in range(1, len(state)-1) so k in range(0, len(state)-2)  
        valid = (idx < len(state) - 2)                                          
        idx = idx[valid]                                                        
        if len(idx) < 10: return None                                           
                                                                                
        Y = state[idx + 2]                                                      
        X = np.column_stack([state[idx+1], state[idx], state[idx]**2,           
np.ones_like(idx, dtype=float)])                                                
        return solve_lstsq(X, Y)                                                
                                                                                
    return fit_cont(mask1), fit_cont(mask2), fit_disc(mask1), fit_disc(mask2)   
                                                                                
