                  X = np.column_stack([seg[1:-1], seg[:-2],                     
  np.ones(len(seg)-2), seg[:-2]**2])                                            
                  Y = seg[2:]                                                   
                  c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                
                  all_coeffs.append(c)                                          
                                                                                
              if end < len(x)-1:                                                
