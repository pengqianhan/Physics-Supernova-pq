    x1_val = sub_x[1:-1]                                                        
    dx1 = (sub_x[2:] - sub_x[:-2]) / (2 * dt)                                   
    ddx1 = (sub_x[2:] - 2 * sub_x[1:-1] + sub_x[:-2]) / (dt**2)                 
                                                                                
    # Model: ddx1 = a * dx1 + b * x1 + c + d * x1^2                             
    # Solve Y = M * Coeffs                                                      
    Y = ddx1                                                                    
    M = np.vstack([dx1, x1_val, np.ones_like(x1_val), x1_val**2]).T             
    coeffs, residuals, rank, s_vals = np.linalg.lstsq(M, Y, rcond=None)         
    return coeffs                                                               
                                                                                
mode1_coeffs = []                                                               
mode2_coeffs = []                                                               
                                                                                
for s, e, mode in segments:                                                     
