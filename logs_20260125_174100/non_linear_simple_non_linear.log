def analyze_modes(s_segment, dt=0.01):                                          
    v = np.diff(s_segment) / dt                                                 
    # Filter out jump points if any                                             
    a = np.diff(v) / dt                                                         
    v_mid = v[:-1]                                                              
    x_mid = s_segment[:-2]                                                      
                                                                                
    # Split by v_mid                                                            
    mask_neg = v_mid < 0                                                        
    mask_pos = v_mid > 0                                                        
                                                                                
    results = {}                                                                
    for name, mask in [("v < 0", mask_neg), ("v > 0", mask_pos)]:               
        if np.sum(mask) > 10:                                                   
            X = np.column_stack([v_mid[mask], x_mid[mask],                      
np.ones(np.sum(mask)),                                                          
                                 x_mid[mask]**2, v_mid[mask]**2])               
            y = a[mask]                                                         
            sol, res, rank, s_val = np.linalg.lstsq(X, y, rcond=None)           
            results[name] = sol                                                 
    return results                                                              
                                                                                
