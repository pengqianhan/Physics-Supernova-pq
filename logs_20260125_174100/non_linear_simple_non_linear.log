import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/simple_non_linear/sample_0.npz')            
state = data['state']                                                           
# Based on the shape (1, 10001), x1 is the first (and only) row                 
x1 = state[0, :]                                                                
dt = 0.001                                                                      
                                                                                
# Calculate derivatives using finite differences                                
# Using simple diff to avoid np.gradient smoothing over jumps if they exist     
x1_dot = np.diff(x1) / dt                                                       
# x1_dot has length N-1. Let's align it.                                        
# For x1_ddot, we diff x1_dot                                                   
x1_ddot = np.diff(x1_dot) / dt                                                  
# Align arrays: x1_ddot (N-2), x1_dot (N-2), x1 (N-2)                           
x1_val = x1[:-2]                                                                
x1_dot_val = x1_dot[:-1]                                                        
x1_ddot_val = x1_ddot                                                           
                                                                                
# Identify modes based on x1_dot                                                
# We use x1_dot_val for masks                                                   
inc_mask = x1_dot_val > 0                                                       
dec_mask = x1_dot_val < 0                                                       
                                                                                
def fit_model(mask, x_ddot, x_dot, x):                                          
    if np.sum(mask) < 4:                                                        
        return None                                                             
    y = x_ddot[mask]                                                            
    # Model: x1_ddot = A * x1_dot + B * x1 + C * x1^2 + D                       
    X = np.column_stack([x_dot[mask], x[mask], x[mask]**2,                      
np.ones_like(x[mask])])                                                         
    coeffs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)                         
    return coeffs                                                               
                                                                                
coeffs_inc = fit_model(inc_mask, x1_ddot_val, x1_dot_val, x1_val)               
coeffs_dec = fit_model(dec_mask, x1_ddot_val, x1_dot_val, x1_val)               
                                                                                
print("Coefficients Increasing (A, B, C, D):", coeffs_inc)                      
print("Coefficients Decreasing (A, B, C, D):", coeffs_dec)                      
                                                                                
# Switching conditions                                                          
