  import numpy as np                                                            
  import pandas as pd                                                           
                                                                                
  # Define a standard dt for estimation                                         
  dt = 0.01                                                                     
                                                                                
  def analyze_system():                                                         
      all_results = []                                                          
                                                                                
      for path in DATA_FILE_PATHS:                                              
          data = np.load(path)                                                  
          x = data['state'][0]                                                  
          v = np.gradient(x, dt)                                                
          a = np.gradient(v, dt)                                                
                                                                                
          # 1. Initial values                                                   
          v0 = (x[1] - x[0]) / dt                                               
          initial_state = {'x0': x[0], 'v0': v0}                                
                                                                                
          # 2. Identify modes and switches                                      
          # We'll use raw differences for switches to get better precision      
          v_raw = np.diff(x) / dt                                               
          peaks = []                                                            
          troughs = []                                                          
                                                                                
          for i in range(1, len(v_raw)):                                        
              # Peak: Increasing -> Decreasing                                  
              if v_raw[i-1] > 0 and v_raw[i] < 0:                               
                  peaks.append({                                                
                      't_idx': i,                                               
                      'x': x[i],                                                
                      'v_before': v_raw[i-1],                                   
                      'v_after': v_raw[i],                                      
                      'ratio': v_raw[i] / v_raw[i-1]                            
                  })                                                            
              # Trough: Decreasing -> Increasing                                
              elif v_raw[i-1] < 0 and v_raw[i] > 0:                             
                  troughs.append({                                              
                      't_idx': i,                                               
                      'x': x[i],                                                
                      'v_before': v_raw[i-1],                                   
                      'v_after': v_raw[i],                                      
                      'ratio': v_raw[i] / v_raw[i-1]                            
                  })                                                            
                                                                                
          # 3. Fit ODE Parameters for each mode                                 
          # Model: a = c1*v + c2*x + c3*x^2 + c4                                
          def fit_mode(mask):                                                   
              if np.sum(mask) < 10: return None                                 
              # Use np.linalg.lstsq                                             
              X = np.column_stack([v[mask], x[mask], x[mask]**2,                
  np.ones(np.sum(mask))])                                                       
              y = a[mask]                                                       
              coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)    
              return coeffs                                                     
                                                                                
          inc_mask = v > 0.5                                                    
          dec_mask = v < -0.5                                                   
                                                                                
          coeffs_inc = fit_mode(inc_mask)                                       
          coeffs_dec = fit_mode(dec_mask)                                       
                                                                                
          all_results.append({                                                  
              'initial': initial_state,                                         
              'peaks': peaks,                                                   
              'troughs': troughs,                                               
              'coeffs_inc': coeffs_inc,                                         
              'coeffs_dec': coeffs_dec                                          
          })                                                                    
                                                                                
      return all_results                                                        
                                                                                
  results = analyze_system()                                                    
                                                                                
  # Summarize for the manager                                                   
  summary = []                                                                  
  for i, res in enumerate(results):                                             
