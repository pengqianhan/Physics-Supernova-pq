        if dx > 0 and dx2 > 0:                                                  
            m1_X.append(feat)                                                   
            m1_Y.append(d2x)                                                    
        elif dx < 0 and dx2 < 0:                                                
            m2_X.append(feat)                                                   
            m2_Y.append(d2x)                                                    
                                                                                
    return m1_X, m1_Y, m2_X, m2_Y                                               
                                                                                
