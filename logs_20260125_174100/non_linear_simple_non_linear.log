import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def fit_modes(all_x1, dt=0.01):                                                 
    data_pos = {'x1': [], 'x1_dot': [], 'x1_ddot': []}                          
    data_neg = {'x1': [], 'x1_dot': [], 'x1_ddot': []}                          
                                                                                
    for x1 in all_x1:                                                           
        x1_dot = np.diff(x1) / dt                                               
        x1_ddot = np.diff(x1_dot) / dt                                          
                                                                                
        # Trim x1 and x1_dot to match x1_ddot length                            
        x1_val = x1[:-2]                                                        
        x1_dot_val = x1_dot[:-1]                                                
                                                                                
        # We must exclude points right at the transitions to avoid outliers in  
acceleration                                                                    
        # because finite difference across a jump is huge.                      
        for i in range(len(x1_ddot)):                                           
            # Check if this point or neighbors involve a transition             
            # Transition happens between i and i+1 or i+1 and i+2 in original x1
            # Which is between i and i+1 in x1_dot.                             
            # So if x1_dot[i] and x1_dot[i+1] have same sign, it's not a jump.  
            if np.sign(x1_dot_val[i]) == np.sign(x1_dot_val[i+1]) ==            
np.sign(x1_dot[i+2]):                                                           
                if x1_dot_val[i] > 0:                                           
                    data_pos['x1'].append(x1_val[i])                            
                    data_pos['x1_dot'].append(x1_dot_val[i])                    
                    data_pos['x1_ddot'].append(x1_ddot[i])                      
                elif x1_dot_val[i] < 0:                                         
                    data_neg['x1'].append(x1_val[i])                            
                    data_neg['x1_dot'].append(x1_dot_val[i])                    
                    data_neg['x1_ddot'].append(x1_ddot[i])                      
                                                                                
    return data_pos, data_neg                                                   
                                                                                
data_pos, data_neg = fit_modes(all_x1)                                          
                                                                                
def perform_regression(data, include_quadratic=False):                          
    X = np.column_stack([data['x1_dot'], data['x1']])                           
    if include_quadratic:                                                       
        X = np.column_stack([X, np.array(data['x1'])**2])                       
    X = np.column_stack([X, np.ones(len(data['x1']))])                          
                                                                                
    y = np.array(data['x1_ddot'])                                               
                                                                                
    coef, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)                
                                                                                
    # Calculate R-squared                                                       
    y_mean = np.mean(y)                                                         
    ss_tot = np.sum((y - y_mean)**2)                                            
    ss_res = np.sum((y - X @ coef)**2)                                          
    r2 = 1 - (ss_res / ss_tot)                                                  
                                                                                
    return coef, r2                                                             
                                                                                
# Linear fits                                                                   
coef_pos, r2_pos = perform_regression(data_pos)                                 
coef_neg, r2_neg = perform_regression(data_neg)                                 
                                                                                
# Quadratic fits                                                                
coef_pos_q, r2_pos_q = perform_regression(data_pos, include_quadratic=True)     
coef_neg_q, r2_neg_q = perform_regression(data_neg, include_quadratic=True)     
                                                                                
print("Mode 1 (x1_dot > 0):")                                                   
print(f"Linear Coef (a, b, c): {coef_pos}, R2: {r2_pos}")                       
print(f"Quadratic Coef (a, b, d, c): {coef_pos_q}, R2: {r2_pos_q}")             
                                                                                
print("\nMode 2 (x1_dot < 0):")                                                 
print(f"Linear Coef (a, b, c): {coef_neg}, R2: {r2_neg}")                       
print(f"Quadratic Coef (a, b, d, c): {coef_neg_q}, R2: {r2_neg_q}")             
                                                                                
