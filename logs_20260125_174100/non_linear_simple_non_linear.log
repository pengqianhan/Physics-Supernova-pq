            seg = x[start:end+1]                                                
            if len(seg) > 10:                                                   
                X = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2),  
seg[:-2]**2])                                                                   
                Y = seg[2:]                                                     
                c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                  
                all_coeffs.append(c)                                            
                                                                                
            if end < len(x)-1:                                                  
                all_resets.append((x[end], x[end+1], x[end+2], x[end] - x[end-1]
if end > 0 else 0))                                                             
            start = end + 1                                                     
                                                                                
    all_coeffs = np.array(all_coeffs)                                           
    all_resets = np.array(all_resets)                                           
                                                                                
    return all_coeffs, all_resets                                               
                                                                                
