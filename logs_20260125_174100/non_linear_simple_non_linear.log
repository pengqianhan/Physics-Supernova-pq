import numpy as np                                                              
                                                                                
dt = 0.1                                                                        
all_data_m1 = []                                                                
all_data_m2 = []                                                                
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    v = np.gradient(x, dt)                                                      
    a = np.gradient(v, dt)                                                      
    dx = np.diff(x)                                                             
    jumps = np.where(np.abs(np.diff(dx)) > 0.1)[0]                              
    mask = np.ones(len(x), dtype=bool)                                          
    for j in jumps:                                                             
        mask[max(0, j-10):min(len(x), j+10)] = False                            
                                                                                
    for i in range(len(x)):                                                     
        if mask[i]:                                                             
            if v[i] > 0:                                                        
                all_data_m2.append([v[i], x[i], x[i]**2, a[i]])                 
            elif v[i] < 0:                                                      
                all_data_m1.append([v[i], x[i], x[i]**2, a[i]])                 
                                                                                
def fit(data):                                                                  
    data = np.array(data)                                                       
    X = data[:, :3]                                                             
    X = np.column_stack([X, np.ones(len(X))])                                   
    Y = data[:, 3]                                                              
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
print("dt = 0.1")                                                               
print("Mode 2:", fit(all_data_m2))                                              
print("Mode 1:", fit(all_data_m1))                                              
                                                                                
