from scipy.linalg import lstsq                                                  
                                                                                
data = np.load(DATA_FILE_PATH)                                                  
state = data['state'].flatten()                                                 
                                                                                
def fit_linear_ode(indices_list):                                               
    X = []                                                                      
    Y = []                                                                      
    for seg_indices in indices_list:                                            
        # We need at least 3 points for x[k], x[k+1], x[k+2]                    
        for i in range(len(seg_indices) - 2):                                   
            idx0 = seg_indices[i]                                               
            idx1 = seg_indices[i+1]                                             
            idx2 = seg_indices[i+2]                                             
            X.append([state[idx1], state[idx0], 1.0])                           
            Y.append(state[idx2])                                               
    X = np.array(X)                                                             
    Y = np.array(Y)                                                             
    beta, residuals, rank, s = lstsq(X, Y)                                      
    return beta # [a, b, c]                                                     
                                                                                
