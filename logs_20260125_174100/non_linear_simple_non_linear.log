  import numpy as np                                                            
                                                                                
  def analyze_sample(file_path):                                                
      data = np.load(file_path)                                                 
      x1 = data['state'][0]                                                     
      v = np.diff(x1)                                                           
      a = np.diff(v)                                                            
                                                                                
      # modes based on velocity v                                               
      # v has 10000 elements. a has 9999.                                       
      # To fit a[i] = f(v[i], x1[i]), we need to align them.                    
      v_fit = v[:-1] # 9999 elements                                            
      x1_fit = x1[:-2] # 9999 elements                                          
      a_fit = a # 9999 elements                                                 
                                                                                
      modes = np.zeros(len(v), dtype=int)                                       
      modes[v > 0] = 1                                                          
      modes[v < 0] = 2                                                          
                                                                                
      switches = []                                                             
      for i in range(len(modes) - 1):                                           
          if modes[i] != modes[i+1] and modes[i] != 0 and modes[i+1] != 0:      
              switches.append({                                                 
                  'idx': i + 1,                                                 
                  'type': f"{modes[i]}->{modes[i+1]}",                          
                  'x1': x1[i+1],                                                
                  'v_before': v[i],                                             
                  'v_after': v[i+1]                                             
              })                                                                
                                                                                
      def fit_params(m):                                                        
          # use modes of v_fit which is modes[:-1]                              
          mask = (modes[:-1] == m)                                              
          if np.sum(mask) == 0: return None                                     
          target = a_fit[mask]                                                  
          feat = np.column_stack([v_fit[mask], x1_fit[mask], x1_fit[mask]**2,   
  np.ones(np.sum(mask))])                                                       
          params, _, _, _ = np.linalg.lstsq(feat, target, rcond=None)           
          return params                                                         
                                                                                
      p1 = fit_params(1)                                                        
      p2 = fit_params(2)                                                        
      return switches, p1, p2, x1[0], v[0], modes[0]                            
                                                                                
