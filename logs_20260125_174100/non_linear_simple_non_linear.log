import numpy as np                                                              
import pandas as pd                                                             
from scipy.optimize import curve_fit                                            
                                                                                
def analyze_data(file_path):                                                    
    data = np.load(file_path)                                                   
    x1 = data['state'][0]                                                       
    dt = 0.01 # Assuming dt=0.01 based on common patterns in such datasets      
                                                                                
    # Derivatives                                                               
    v = np.gradient(x1, dt)                                                     
    a = np.gradient(v, dt)                                                      
                                                                                
    # Identify peaks and troughs                                                
    peaks = []                                                                  
    troughs = []                                                                
    for i in range(1, len(x1) - 1):                                             
        if x1[i] > x1[i-1] and x1[i] > x1[i+1] and x1[i] > 100:                 
            peaks.append(i)                                                     
        if x1[i] < x1[i-1] and x1[i] < x1[i+1] and x1[i] < 20:                  
            troughs.append(i)                                                   
                                                                                
    # Mode separation and regression                                            
    # Mode 1: Decreasing (peak to trough)                                       
    # Mode 2: Increasing (trough to peak)                                       
                                                                                
    def fit_mode(x, v, acc):                                                    
        # target: acc = a*v + b*x + c*x**2 + d                                  
        X = np.stack([v, x, x**2, np.ones_like(x)], axis=-1)                    
        coeffs, _, _, _ = np.linalg.lstsq(X, acc, rcond=None)                   
        return coeffs                                                           
                                                                                
    # Collect segments                                                          
    mode1_data = [] # (x, v, acc)                                               
    mode2_data = []                                                             
                                                                                
    switches = sorted(peaks + troughs)                                          
    for j in range(len(switches)-1):                                            
        idx_start = switches[j]                                                 
        idx_end = switches[j+1]                                                 
        segment_x = x1[idx_start:idx_end]                                       
        segment_v = v[idx_start:idx_end]                                        
        segment_a = a[idx_start:idx_end]                                        
                                                                                
        if x1[idx_start] > x1[idx_end]: # Decreasing                            
            mode1_data.append((segment_x, segment_v, segment_a))                
        else: # Increasing                                                      
            mode2_data.append((segment_x, segment_v, segment_a))                
                                                                                
    return mode1_data, mode2_data, peaks, troughs, x1, v                        
                                                                                
