import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
                                                                                
def fit_clean(sample_idx):                                                      
    data = np.load(DATA_FILE_PATHS[sample_idx])                                 
    x = data['state'][0, :]                                                     
    xd = np.gradient(x, dt)                                                     
    xdd = np.gradient(xd, dt)                                                   
                                                                                
    # Jumps                                                                     
    diff_xd = np.abs(np.diff(xd))                                               
    jumps = np.where(diff_xd > 10)[0]                                           
                                                                                
    # Segments                                                                  
    segments = []                                                               
    start = 5                                                                   
    for j in jumps:                                                             
        if j - start > 100:                                                     
            segments.append((start, j-5))                                       
        start = j + 5                                                           
    if len(x) - start > 100:                                                    
        segments.append((start, len(x)-5))                                      
                                                                                
    all_coeffs = []                                                             
    for s, e in segments:                                                       
        X = np.column_stack([np.ones(e-s), x[s:e], xd[s:e], x[s:e]**2])         
        c, _, _, _ = np.linalg.lstsq(X, xdd[s:e], rcond=None)                   
        all_coeffs.append(c)                                                    
                                                                                
    return all_coeffs                                                           
                                                                                
for i in range(3):                                                              
    print(f"Sample {i} coeffs:", fit_clean(i))                                  
                                                                                
