import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/simple_non_linear/sample_0.npz')            
state = data['state']                                                           
# state shape is (1, 10001), so x1 is the first row                             
x1 = state[0, :]                                                                
dt = 0.001                                                                      
                                                                                
# Calculate derivatives                                                         
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Identify modes                                                                
# Mode 1: Going Up (x1_dot > 0), Mode 2: Going Down (x1_dot < 0)                
modes = np.where(x1_dot >= 0, 1, 2)                                             
mode_changes = np.where(modes[:-1] != modes[1:])[0]                             
                                                                                
def fit_mode_linear(indices):                                                   
    if len(indices) < 10:                                                       
        return None                                                             
    # Model: x1_ddot = a*x1_dot + b*x1 + c + d*(x1**2)                          
    # Target Y: x1_ddot                                                         
    # Features M: [x1_dot, x1, 1, x1**2]                                        
    Y = x1_ddot[indices]                                                        
    M = np.column_stack([                                                       
        x1_dot[indices],                                                        
        x1[indices],                                                            
        np.ones_like(x1[indices]),                                              
        x1[indices]**2                                                          
    ])                                                                          
    # Solve M * P = Y                                                           
    P, residuals, rank, s = np.linalg.lstsq(M, Y, rcond=None)                   
    return P                                                                    
                                                                                
up_indices = np.where(modes == 1)[0]                                            
down_indices = np.where(modes == 2)[0]                                          
                                                                                
coeffs_up = fit_mode_linear(up_indices)                                         
coeffs_down = fit_mode_linear(down_indices)                                     
                                                                                
# Analyze switching thresholds                                                  
# Up to Down: peak                                                              
up_to_down_switches = mode_changes[modes[mode_changes] == 1]                    
# Down to Up: trough                                                            
down_to_up_switches = mode_changes[modes[mode_changes] == 2]                    
                                                                                
x1_up_to_down = x1[up_to_down_switches]                                         
x1_down_to_up = x1[down_to_up_switches]                                         
                                                                                
# State resets at switching points                                              
# Check if x1 or x1_dot changes abruptly                                        
velocity_jumps = []                                                             
for idx in mode_changes:                                                        
    # index idx is the last point of previous mode, idx+1 is first of next      
