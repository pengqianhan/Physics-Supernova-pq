  x1_raw = data['state'][0]                                                     
  dt = 0.01  # Assumed time step based on common practices                      
  t = np.arange(len(x1_raw)) * dt                                               
                                                                                
  # Identify switching points where velocity jumps significantly                
  # We use simple forward difference for velocity to find jumps                 
  dx1_raw = np.diff(x1_raw) / dt                                                
  jumps = np.abs(np.diff(dx1_raw))                                              
  threshold = 10.0                                                              
  switch_indices = np.where(jumps > threshold)[0] + 1                           
                                                                                
  # Segment the data based on switches                                          
  segments = []                                                                 
  start = 0                                                                     
  for idx in switch_indices:                                                    
      segments.append((start, idx))                                             
      start = idx                                                               
  segments.append((start, len(x1_raw)))                                         
                                                                                
  def fit_ode(seg_x, dt):                                                       
      # Use central differences for derivatives to minimize noise               
      # We strip the ends to avoid boundary effects of the difference operator  
      dx = (seg_x[2:] - seg_x[:-2]) / (2 * dt)                                  
      d2x = (seg_x[2:] - 2 * seg_x[1:-1] + seg_x[:-2]) / (dt**2)                
      x = seg_x[1:-1]                                                           
                                                                                
      # Model: d2x = a*dx + b*x + c + d*x^2                                     
      # Design matrix X: [dx, x, 1, x^2]                                        
      X = np.stack([dx, x, np.ones_like(x), x**2], axis=1)                      
      params, residuals, rank, s = np.linalg.lstsq(X, d2x, rcond=None)          
                                                                                
      # Calculate R-squared for quality check                                   
      y_mean = np.mean(d2x)                                                     
      ss_tot = np.sum((d2x - y_mean)**2)                                        
      ss_res = np.sum((d2x - X @ params)**2)                                    
      r2 = 1 - (ss_res / ss_tot)                                                
                                                                                
      return params, r2                                                         
                                                                                
  # Mode analysis                                                               
  all_params = []                                                               
  for i, (s, e) in enumerate(segments):                                         
