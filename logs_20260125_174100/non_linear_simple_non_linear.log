def run_analysis():                                                             
    # Set display precision                                                     
    np.set_printoptions(precision=6, suppress=True)                             
                                                                                
    for p_idx in range(len(DATA_FILE_PATHS)):                                   
        data = np.load(DATA_FILE_PATHS[p_idx])                                  
        x = data['state'][0]                                                    
        print(f"\n--- File {p_idx} ---")                                        
                                                                                
        diffs = np.diff(x)                                                      
        jumps = np.where(np.abs(diffs) > 10)[0]                                 
                                                                                
        # Overall min/max                                                       
        print(f"  Range: [{np.min(x):.4f}, {np.max(x):.4f}]")                   
        print(f"  Normal diff range: [{np.min(diffs[np.abs(diffs)<10]):.6f},    
{np.max(diffs[np.abs(diffs)<10]):.6f}]")                                        
                                                                                
        if len(jumps) > 0:                                                      
            print(f"  Jumps at: {x[jumps]}")                                    
            print(f"  Reset to: {x[jumps+1]}")                                  
            print(f"  Second val after reset: {x[jumps+2]}")                    
                                                                                
        # Segments                                                              
        starts = [0] + [j+1 for j in jumps]                                     
        ends = [j for j in jumps] + [len(x)-1]                                  
                                                                                
