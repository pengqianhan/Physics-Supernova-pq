def fit_v_neg_no_v2(path):                                                      
    s = np.load(path)['state'][0]                                               
    dx = np.diff(s)                                                             
    d2x = np.diff(dx)                                                           
    mask = dx[:-1] < 0                                                          
    indices = np.where(mask[:-1] & mask[1:])[0]                                 
    X = np.column_stack([dx[indices], s[indices], np.ones(len(indices)),        
s[indices]**2])                                                                 
    y = d2x[indices]                                                            
    sol, res, rank, s_val = np.linalg.lstsq(X, y, rcond=None)                   
    return sol, res                                                             
                                                                                
for p in DATA_FILE_PATHS:                                                       
