def fit_v_dynamics(segments, dt=0.01):                                          
    V_next = []                                                                 
    V_now = []                                                                  
    for seg in segments:                                                        
        v = np.diff(seg) / dt                                                   
        V_next.append(v[1:])                                                    
        V_now.append(v[:-1])                                                    
                                                                                
