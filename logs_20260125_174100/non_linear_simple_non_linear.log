import numpy as np                                                              
                                                                                
def run_analysis():                                                             
    for i in range(3):                                                          
        data = np.load(DATA_FILE_PATHS[i])                                      
        x = data['state'][0]                                                    
                                                                                
        # Detect where the 2nd order ODE fails                                  
        # First, fit on a small "clean" segment                                 
        seg = x[100:200]                                                        
        Y_s = seg[2:]; X_s = np.column_stack([seg[1:-1], seg[:-2],              
np.ones(len(Y_s))])                                                             
        c, _, _, _ = np.linalg.lstsq(X_s, Y_s, rcond=None)                      
                                                                                
        # Predict whole file                                                    
        preds = c[0]*x[1:-1] + c[1]*x[:-2] + c[2]                               
        errors = np.abs(x[2:] - preds)                                          
        switches = np.where(errors > 0.1)[0] + 2                                
                                                                                
        print(f"\n--- File {i} ---")                                            
        print(f"Switches: {switches}")                                          
        for s in switches:                                                      
            print(f"  At {s}: x[s-1]={x[s-1]:.4f}, v_before={x[s-1]-x[s-2]:.4f},
v_after={x[s]-x[s-1]:.4f}")                                                     
                                                                                
        # Refined ODE estimation on first segment                               
        if len(switches) > 0:                                                   
            seg = x[50:switches[0]]                                             
        else:                                                                   
            seg = x[50:500]                                                     
                                                                                
        X = np.column_stack([seg[1:-1], seg[:-2], np.ones(len(seg)-2),          
seg[:-2]**2])                                                                   
        Y = seg[2:]                                                             
        c_nl, res_nl, _, _ = np.linalg.lstsq(X, Y, rcond=None)                  
        print(f"  ODE Coeffs (a, b, c, x0^2): {c_nl}")                          
        print(f"  Residual: {np.mean(res_nl) if res_nl.size > 0 else 0:.2e}")   
                                                                                
run_analysis()                                                                  
