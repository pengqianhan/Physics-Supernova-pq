            # Transition point                                                  
            switches.append({                                                   
                'index': i,                                                     
                'x': x[i],                                                      
                'v_before': v[i-1],                                             
                'v_after': v[i+1],                                              
                'type': 'peak' if v[i-1] > 0 else 'trough'                      
