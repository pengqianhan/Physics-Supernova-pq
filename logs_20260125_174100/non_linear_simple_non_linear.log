x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Identify switches and guards                                                  
switches = []                                                                   
for i in range(1, len(x1_dot)):                                                 
    # Sign change in velocity with a significant jump (impact)                  
    if np.sign(x1_dot[i]) != np.sign(x1_dot[i-1]) and abs(x1_dot[i] -           
x1_dot[i-1]) > 1.0:                                                             
        switches.append(i)                                                      
                                                                                
guards = x1[switches]                                                           
print(f"Switches at indices: {switches}")                                       
print(f"Guards (x1 values): {guards}")                                          
                                                                                
# Analyze resets                                                                
resets_k = []                                                                   
for s in switches:                                                              
    v_before = x1_dot[s-1]                                                      
    v_after = x1_dot[s]                                                         
    k = -v_after / v_before                                                     
    resets_k.append(k)                                                          
print(f"Reset factors k: {resets_k}")                                           
                                                                                
# Define segments for modes                                                     
buffer = 20                                                                     
inc_indices = []                                                                
dec_indices = []                                                                
start = 0                                                                       
for s in switches:                                                              
    segment = np.arange(start + buffer, s - buffer)                             
    if len(segment) > 0:                                                        
        if np.mean(x1_dot[segment]) > 0:                                        
            inc_indices.extend(segment)                                         
        else:                                                                   
            dec_indices.extend(segment)                                         
    start = s                                                                   
final_segment = np.arange(start + buffer, len(x1) - buffer)                     
if len(final_segment) > 0:                                                      
    if np.mean(x1_dot[final_segment]) > 0:                                      
        inc_indices.extend(final_segment)                                       
    else:                                                                       
        dec_indices.extend(final_segment)                                       
                                                                                
