import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    x1 = data['state'][0]                                                       
    v = np.diff(x1)                                                             
    a = np.diff(v)                                                              
                                                                                
    modes = np.zeros(len(v), dtype=int)                                         
    modes[v > 0] = 1                                                            
    modes[v < 0] = 2                                                            
                                                                                
    switches = []                                                               
    for i in range(len(modes) - 1):                                             
        if modes[i] != modes[i+1] and modes[i] != 0 and modes[i+1] != 0:        
            switches.append({                                                   
                'idx': i + 1,                                                   
                'type': f"{modes[i]}->{modes[i+1]}",                            
                'x1': x1[i+1],                                                  
                'v_before': v[i],                                               
                'v_after': v[i+1]                                               
            })                                                                  
                                                                                
    def fit_params(m):                                                          
        mask = (modes[:-1] == m)                                                
        target = a[mask]                                                        
        # x1[2] = a*x1[1] + b*x1[0] + c*x1[0]**2 + d                            
        # Using index alignment: a[i] = v[i+1] - v[i], which corresponds to     
ddot{x} at step i                                                               
        # We match it with v[i], x1[i], x1[i]**2                                
        feat = np.column_stack([v[mask], x1[mask], x1[mask]**2,                 
np.ones(np.sum(mask))])                                                         
        params, _, _, _ = np.linalg.lstsq(feat, target, rcond=None)             
        return params                                                           
                                                                                
    p1 = fit_params(1)                                                          
    p2 = fit_params(2)                                                          
    return switches, p1, p2, x1[0], v[0], modes[0]                              
                                                                                
