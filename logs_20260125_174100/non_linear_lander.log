import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def analyze_sample(sample_path):                                                
    data = np.load(sample_path)                                                 
    states = data['state']                                                      
    # states is (4, N)                                                          
    # We want to find x[t+1] = f(x[t])                                          
    X = states[:, :-1].T # (N-1, 4)                                             
    Y = states[:, 1:].T  # (N-1, 4)                                             
                                                                                
    x4 = X[:, 3]                                                                
    mode1_indices = np.where(x4 < 2300)[0]                                      
    mode2_indices = np.where(x4 >= 2300)[0]                                     
                                                                                
    return X, Y, mode1_indices, mode2_indices                                   
                                                                                
def fit_ode(X, Y, indices):                                                     
    if len(indices) == 0:                                                       
        return None                                                             
    X_sub = X[indices]                                                          
    Y_sub = Y[indices]                                                          
                                                                                
    # We want to find A such that Y = X*A + B                                   
    # Since we have 4 variables in Y, we can fit 4 separate regressions         
    coeffs = []                                                                 
    intercepts = []                                                             
    for i in range(4):                                                          
        reg = LinearRegression().fit(X_sub, Y_sub[:, i])                        
        coeffs.append(reg.coef_)                                                
        intercepts.append(reg.intercept_)                                       
                                                                                
    return np.array(coeffs), np.array(intercepts)                               
                                                                                
# Combine data from all samples for better precision                            
all_X = []                                                                      
all_Y = []                                                                      
all_mode1 = []                                                                  
all_mode2 = []                                                                  
                                                                                
offset = 0                                                                      
for i in range(3):                                                              
    X, Y, m1, m2 = analyze_sample(f'data_all/non_linear/lander/sample_{i}.npz') 
    all_X.append(X)                                                             
    all_Y.append(Y)                                                             
    all_mode1.append(m1 + offset)                                               
    all_mode2.append(m2 + offset)                                               
    offset += X.shape[0]                                                        
                                                                                
all_X = np.vstack(all_X)                                                        
all_Y = np.vstack(all_Y)                                                        
all_mode1 = np.concatenate(all_mode1)                                           
all_mode2 = np.concatenate(all_mode2)                                           
                                                                                
params1 = fit_ode(all_X, all_Y, all_mode1)                                      
params2 = fit_ode(all_X, all_Y, all_mode2)                                      
                                                                                
print("Mode 1 (x4 < 2300) Coefficients:")                                       
print(params1[0])                                                               
print("Mode 1 Intercepts:")                                                     
print(params1[1])                                                               
                                                                                
print("\nMode 2 (x4 >= 2300) Coefficients:")                                    
print(params2[0])                                                               
print("Mode 2 Intercepts:")                                                     
print(params2[1])                                                               
                                                                                
# Check for resets at the transition                                            
