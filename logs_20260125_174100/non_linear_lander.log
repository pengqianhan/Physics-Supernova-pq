import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
def solve():                                                                    
    all_data = []                                                               
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        # Assuming the state is stored in a key like 'x' or 'states'            
        # Let's check keys first                                                
        all_data.append(data['x'])                                              
                                                                                
    # Concatenate all trajectories                                              
    # data['x'] shape is usually (T, 4)                                         
    X_full = np.vstack(all_data)                                                
                                                                                
    # Calculate derivatives: (x[t+1] - x[t]) / dt                               
    dt = 0.001                                                                  
    X_t = X_full[:-1]                                                           
    X_next = X_full[1:]                                                         
    X_dot = (X_next - X_t) / dt                                                 
                                                                                
    # Modes                                                                     
    # Mode 1: x4 < 2300                                                         
    # Mode 2: x4 >= 2300                                                        
    mask1 = X_t[:, 3] < 2300                                                    
    mask2 = X_t[:, 3] >= 2300                                                   
                                                                                
    results = {}                                                                
                                                                                
    for mode_idx, mask in enumerate([mask1, mask2], 1):                         
        if np.sum(mask) < 2:                                                    
            results[mode_idx] = "Insufficient data"                             
            continue                                                            
                                                                                
        X_mode = X_t[mask]                                                      
        Y_mode = X_dot[mask]                                                    
                                                                                
        # Linear Regression for each component                                  
        reg = LinearRegression().fit(X_mode, Y_mode)                            
        coefs = reg.coef_                                                       
        intercepts = reg.intercept_                                             
                                                                                
        mode_eqs = []                                                           
        for i in range(4):                                                      
            eq = f"x{i+1}_dot = {coefs[i,0]:.4f}*x1 + {coefs[i,1]:.4f}*x2 +     
{coefs[i,2]:.4f}*x3 + {coefs[i,3]:.4f}*x4 + {intercepts[i]:.4f}"                
            mode_eqs.append(eq)                                                 
        results[mode_idx] = mode_eqs                                            
                                                                                
    print(results)                                                              
                                                                                
solve()                                                                         
                                                                                
