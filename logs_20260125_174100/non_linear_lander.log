def fit_dynamics(dx_part, x_part):                                              
    # Fit dx = A*x + B                                                          
    # x_part shape (4, N)                                                       
    # dx_part shape (4, N)                                                      
    # Add a row of ones for the intercept                                       
    A_aug = np.vstack([x_part, np.ones(x_part.shape[1])]).T                     
    coeffs, residuals, rank, s = np.linalg.lstsq(A_aug, dx_part.T, rcond=None)  
    # coeffs shape (5, 4) -> Each column is for a dx_i                          
    return coeffs                                                               
                                                                                
coeffs_m1 = fit_dynamics(dx[:, :switch_idx], x[:, :switch_idx])                 
