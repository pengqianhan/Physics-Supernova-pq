import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def analyze_mode(dx, x):                                                        
    # dx is the change per step                                                 
    # x is the state at each step                                               
    n_vars = x.shape[0]                                                         
    results = {}                                                                
    for i in range(n_vars):                                                     
        # Try to fit dx[i] = A * x + B                                          
        # Using linear regression for multiple variables                        
        # But first check if it's constant                                      
        mean_dx = np.mean(dx[i])                                                
        std_dx = np.std(dx[i])                                                  
                                                                                
        # Linear regression with each variable                                  
        correlations = []                                                       
        for j in range(n_vars):                                                 
            slope, intercept, r_value, p_value, std_err = stats.linregress(x[j],
dx[i])                                                                          
            correlations.append((j, slope, intercept, r_value))                 
                                                                                
        results[i] = {'mean': mean_dx, 'std': std_dx, 'corrs': correlations}    
    return results                                                              
                                                                                
