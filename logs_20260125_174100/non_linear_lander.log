def evaluate_perm(p, state_data):                                               
    # p is a permutation of (0,1,2,3) representing (x1, x2, x3, x4)             
    x1, x2, x3, x4 = state_data[p[0]], state_data[p[1]], state_data[p[2]],      
state_data[p[3]]                                                                
                                                                                
    # We'll split by x4 = 2300                                                  
    idx = np.where(x4[:-1] < 2300)[0]                                           
    if len(idx) < 10: return float('inf')                                       
                                                                                
    # Eq 1: x1[k+1] = x2[k]                                                     
    err1 = np.mean((x1[idx+1] - x2[idx])**2)                                    
                                                                                
    # Eq 2: x2[k+1] = a*x4[k] + b                                               
    # Solve linear regression                                                   
    X = np.stack([x4[idx], np.ones(len(idx))], axis=1)                          
    Y = x2[idx+1]                                                               
    # Use manual lstsq to avoid MatMult error                                   
    # (X^T X) beta = X^T Y                                                      
    XTX = np.array([[np.sum(X[:,0]**2), np.sum(X[:,0])], [np.sum(X[:,0]),       
len(idx)]])                                                                     
    XTY = np.array([np.sum(X[:,0]*Y), np.sum(Y)])                               
    try:                                                                        
        beta = np.linalg.solve(XTX, XTY)                                        
        err2 = np.mean((Y - (beta[0]*x4[idx] + beta[1]))**2)                    
    except:                                                                     
        err2 = 1e9                                                              
                                                                                
    # Eq 3: x3[k+1] = c*x4[k]                                                   
    c = np.sum(x3[idx+1] * x4[idx]) / np.sum(x4[idx]**2)                        
    err3 = np.mean((x3[idx+1] - c*x4[idx])**2)                                  
                                                                                
    # Eq 4: x4[k+1] = x1[k] + d                                                 
    d = np.mean(x4[idx+1] - x1[idx])                                            
    err4 = np.mean((x4[idx+1] - x1[idx] - d)**2)                                
                                                                                
    return err1 + err2 + err3 + err4                                            
                                                                                
results = []                                                                    
for p in permutations(range(4)):                                                
    err = evaluate_perm(p, s)                                                   
    results.append((p, err))                                                    
                                                                                
best_p, best_err = min(results, key=lambda x: x[1])                             
