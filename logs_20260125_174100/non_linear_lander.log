import numpy as np                                                              
                                                                                
def get_regression_data(file_paths, threshold=2300):                            
    all_X1, all_Y1 = [], []                                                     
    all_X2, all_Y2 = [], []                                                     
    transition_pairs = []                                                       
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        states = data['state'] # (4, N)                                         
        X = states[:, :-1] # (4, N-1)                                           
        Y = states[:, 1:]  # (4, N-1)                                           
                                                                                
        # Guard condition: transition happens when x4 >= threshold              
        # x4 is states[3, :]                                                    
        for t in range(X.shape[1]):                                             
            x_t = X[:, t]                                                       
            y_t = Y[:, t]                                                       
                                                                                
            if x_t[3] < threshold:                                              
                # Potential transition point check                              
                if y_t[3] >= threshold:                                         
                    transition_pairs.append((x_t, y_t))                         
                # Add to Mode 1                                                 
                all_X1.append(x_t)                                              
                all_Y1.append(y_t)                                              
            else:                                                               
                # Add to Mode 2                                                 
                all_X2.append(x_t)                                              
                all_Y2.append(y_t)                                              
                                                                                
    return np.array(all_X1), np.array(all_Y1), np.array(all_X2),                
np.array(all_Y2), transition_pairs                                              
                                                                                
def solve_regression(X, Y):                                                     
    # Augment X with a column of 1s for intercepts                              
    X_aug = np.column_stack([X, np.ones(X.shape[0])])                           
    # Solve (X_aug) * Beta = Y  => Beta = (X_aug^T * X_aug)^-1 * X_aug^T * Y    
    # np.linalg.lstsq returns Beta such that X_aug @ Beta approx Y              
    beta, residuals, rank, s = np.linalg.lstsq(X_aug, Y, rcond=None)            
    # beta is (5, 4). beta[0:4, i] are coeffs for Yi, beta[4, i] is intercept   
for Yi                                                                          
    return beta.T                                                               
                                                                                
DATA_FILE_PATHS = ['data_all/non_linear/lander/sample_0.npz',                   
'data_all/non_linear/lander/sample_1.npz',                                      
'data_all/non_linear/lander/sample_2.npz']                                      
