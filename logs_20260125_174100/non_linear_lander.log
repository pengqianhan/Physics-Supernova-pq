<code>                                                                          
from scipy.linalg import lstsq                                                  
                                                                                
def fit_linear_system(state, dt):                                               
    N = state.shape[0]                                                          
    x_data = state[:-1] # (N-1, 4)                                              
    dx_data = np.diff(state, axis=0) / dt # (N-1, 4)                            
                                                                                
    # We want to fit dx = x * A.T + B                                           
    # Augment x with a column of ones                                           
    X = np.hstack([x_data, np.ones((N-1, 1))])                                  
                                                                                
    # Solve X * M = dx                                                          
    M, res, rank, s = lstsq(X, dx_data)                                         
    # M is (5, 4)                                                               
    A = M[:4, :].T                                                              
    B = M[4, :]                                                                 
    return A, B, res                                                            
                                                                                
data = np.load('data_all/non_linear/lander/sample_0.npz')                       
state = data['state'].T                                                         
dt = 0.001                                                                      
                                                                                
A1, B1, res1 = fit_linear_system(state[:4000], dt)                              
A2, B2, res2 = fit_linear_system(state[4000:], dt)                              
                                                                                
print("Mode 1 A:")                                                              
print(A1)                                                                       
print("Mode 1 B:", B1)                                                          
print("Mode 1 Residuals:", res1)                                                
                                                                                
print("Mode 2 A:")                                                              
print(A2)                                                                       
print("Mode 2 B:", B2)                                                          
print("Mode 2 Residuals:", res2)                                                
                                                                                
