    switch_idx = np.argmax(np.abs(ddx4)) + 1                                    
                                                                                
    def fit_mode(dx_p, x_p):                                                    
        A_aug = np.vstack([x_p, np.ones(x_p.shape[1])]).T                       
        c, _, _, _ = np.linalg.lstsq(A_aug, dx_p.T, rcond=None)                 
        return c                                                                
                                                                                
    c1 = fit_mode(dx[:, :switch_idx], x[:, :switch_idx])                        
    c2 = fit_mode(dx[:, switch_idx:], x[:, switch_idx:])                        
    return c1, c2, state[3, switch_idx]                                         
                                                                                
