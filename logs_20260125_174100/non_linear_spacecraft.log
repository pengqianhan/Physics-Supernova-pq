import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
all_x1 = []                                                                     
all_x2 = []                                                                     
all_x3 = []                                                                     
all_x4 = []                                                                     
all_x3_dot = []                                                                 
all_x4_dot = []                                                                 
