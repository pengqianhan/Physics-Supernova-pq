import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
def process_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    # state shape: (4, 10001)                                                   
    # x1=state[0], x2=state[1], x3=state[2], x4=state[3]                        
                                                                                
    # Estimate dt using x1_dot = x3                                             
    # x1[i+1] - x1[i] = x3[i] * dt                                              
    dt_estimates = []                                                           
    for i in range(100):                                                        
        if abs(state[2, i]) > 1e-5:                                             
            dt_estimates.append((state[0, i+1] - state[0, i]) / state[2, i])    
    dt = np.median(dt_estimates) if dt_estimates else 0.01                      
                                                                                
    # Calculate derivatives x3_dot and x4_dot                                   
