  def calculate_error(rt, all_x1, all_x2, all_x3, all_x4, all_dx3, all_dx4,     
  all_R, p1, p2):                                                               
      err = 0                                                                   
      for f in range(len(all_x1)):                                              
          m1 = all_R[f] >= rt                                                   
          m2 = all_R[f] < rt                                                    
          if np.any(m1):                                                        
              res1_x3 = all_dx3[f][m1] - (p1[0]*all_x1[f][m1] +                 
  p1[1]*all_x3[f][m1] + p1[2])                                                  
              res1_x4 = all_dx4[f][m1] - (p1[0]*all_x2[f][m1] +                 
  p1[1]*all_x4[f][m1] + p1[3])                                                  
              err += np.sum(res1_x3**2 + res1_x4**2)                            
          if np.any(m2):                                                        
              res2_x3 = all_dx3[f][m2] - (p2[0]*all_x1[f][m2] +                 
  p2[1]*all_x3[f][m2])                                                          
              res2_x4 = all_dx4[f][m2] - (p2[0]*all_x2[f][m2] +                 
  p2[1]*all_x4[f][m2])                                                          
              err += np.sum(res2_x3**2 + res2_x4**2)                            
      return err                                                                
                                                                                
  # Coarse search                                                               
  r_coarse = np.linspace(830, 860, 301)                                         
  errs_coarse = [calculate_error(rt, all_x1, all_x2, all_x3, all_x4, all_dx3,   
  all_dx4, all_R, p1_final, p2_final) for rt in r_coarse]                       
  best_R_coarse = r_coarse[np.argmin(errs_coarse)]                              
                                                                                
  # Fine search                                                                 
  r_fine = np.linspace(best_R_coarse - 0.2, best_R_coarse + 0.2, 401)           
  errs_fine = [calculate_error(rt, all_x1, all_x2, all_x3, all_x4, all_dx3,     
  all_dx4, all_R, p1_final, p2_final) for rt in r_fine]                         
  best_R_fine = r_fine[np.argmin(errs_fine)]                                    
                                                                                
