from scipy.optimize import lsq_linear                                           
                                                                                
def solve_coefficients(indices, x1, x2, x3, x4, x3_dot, x4_dot):                
    # Prepare the matrix M and vector Y                                         
    M = []                                                                      
    Y = []                                                                      
    for i in indices:                                                           
        M.append([x1[i], x3[i], 1, 0])                                          
        Y.append(x3_dot[i])                                                     
        M.append([x2[i], x4[i], 0, 1])                                          
        Y.append(x4_dot[i])                                                     
                                                                                
    M = np.array(M)                                                             
    Y = np.array(Y)                                                             
                                                                                
    # Solve using least squares                                                 
    res = np.linalg.lstsq(M, Y, rcond=None)[0]                                  
    return res                                                                  
                                                                                
