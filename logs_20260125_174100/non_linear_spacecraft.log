import numpy as np                                                              
                                                                                
def get_coeffs_per_sample(sample_idx, threshold):                               
    data = np.load(f'data_all/non_linear/spacecraft/sample_{sample_idx}.npz')   
    x1, x2, x3, x4 = data['state']                                              
    dist = np.sqrt(x1**2 + x2**2)                                               
                                                                                
    # Mode 1                                                                    
    m1_idx = np.where(dist > threshold)[0]                                      
    m1_idx = [k for k in m1_idx if k+1 < len(x1) and dist[k+1] > threshold]     
                                                                                
    # Mode 2                                                                    
    m2_idx = np.where(dist <= threshold)[0]                                     
    m2_idx = [k for k in m2_idx if k+1 < len(x1) and dist[k+1] <= threshold]    
                                                                                
    def fit(idx, Y_vals, X_feats, bias=True):                                   
        Y = Y_vals[idx + 1]                                                     
        X = X_feats[idx]                                                        
        if bias:                                                                
            X = np.hstack([X, np.ones((X.shape[0], 1))])                        
        beta, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                       
        return beta                                                             
                                                                                
    X3 = np.stack([x1, x3], axis=1)                                             
    X4 = np.stack([x2, x4], axis=1)                                             
                                                                                
    b3_m1 = fit(np.array(m1_idx), x3, X3, True)                                 
    b4_m1 = fit(np.array(m1_idx), x4, X4, True)                                 
                                                                                
    b3_m2 = fit(np.array(m2_idx), x3, X3, False)                                
    b4_m2 = fit(np.array(m2_idx), x4, X4, False)                                
                                                                                
    return b3_m1, b4_m1, b3_m2, b4_m2                                           
                                                                                
