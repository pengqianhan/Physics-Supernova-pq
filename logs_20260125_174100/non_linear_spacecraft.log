    M[n:, 1] = x4                                                               
    M[n:, 2] = 0.0                                                              
    M[n:, 3] = 1.0                                                              
                                                                                
    coeffs, _, _, _ = np.linalg.lstsq(M, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
