# The switch index in the derivative array                                      
switch_idx_der = np.argmax(jump)                                                
# switch_idx in the original state array                                        
# dx3[i] corresponds to (x3[i+1]-x3[i])/dt                                      
# jump[i] corresponds to |dx3[i+1] - dx3[i]|                                    
# So switch happens at state[switch_idx_der + 1]                                
switch_idx = switch_idx_der + 1                                                 
