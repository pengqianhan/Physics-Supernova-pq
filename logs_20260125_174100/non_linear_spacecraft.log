  # Combine samples                                                             
  X = np.concatenate(all_x, axis=1)                                             
  x1, x2, x3, x4 = X                                                            
  r = np.sqrt(x1**2 + x2**2)                                                    
                                                                                
  # Estimate derivatives (dt = 0.001 based on previous steps)                   
  dt = 0.001                                                                    
  dx3 = np.diff(x3) / dt                                                        
  dx4 = np.diff(x4) / dt                                                        
  r_mid = r[:-1]                                                                
  A = np.vstack([x1[:-1], x2[:-1], x3[:-1], x4[:-1], np.ones_like(x1[:-1])]).T  
                                                                                
  # Let's find the threshold r. We'll test thresholds between min and max r.    
  r_min, r_max = np.min(r), np.max(r)                                           
  print(f"R range: {r_min} to {r_max}")                                         
                                                                                
  # We suspect a transition around 842-850. Let's test precisely.               
  thresholds = np.linspace(r_min + 5, r_max - 5, 20)                            
  results = []                                                                  
                                                                                
  for thr in thresholds:                                                        
      m1 = r_mid >= thr                                                         
      m2 = r_mid < thr                                                          
      if np.sum(m1) > 100 and np.sum(m2) > 100:                                 
          c3_1, res3_1, _, _ = np.linalg.lstsq(A[m1], dx3[m1], rcond=None)      
          c3_2, res3_2, _, _ = np.linalg.lstsq(A[m2], dx3[m2], rcond=None)      
          total_res = np.sum((dx3[m1] - np.dot(A[m1], c3_1))**2) +              
  np.sum((dx3[m2] - np.dot(A[m2], c3_2))**2)                                    
          results.append((thr, total_res, c3_1, c3_2))                          
                                                                                
  best_thr, _, c3_m1, c3_m2 = min(results, key=lambda x: x[1])                  
  print(f"Best threshold r: {best_thr}")                                        
                                                                                
  # Now get final coefficients for x4 as well                                   
  m1 = r_mid >= best_thr                                                        
  m2 = r_mid < best_thr                                                         
  c4_m1 = np.linalg.lstsq(A[m1], dx4[m1], rcond=None)[0]                        
  c4_m2 = np.linalg.lstsq(A[m2], dx4[m2], rcond=None)[0]                        
                                                                                
  print("Mode 1 (r >= R) x3_dot coefs:", c3_m1)                                 
  print("Mode 1 (r >= R) x4_dot coefs:", c4_m1)                                 
  print("Mode 2 (r < R) x3_dot coefs:", c3_m2)                                  
  print("Mode 2 (r < R) x4_dot coefs:", c4_m2)                                  
                                                                                
  # Check for resets                                                            
  for s_arr in all_x:                                                           
      r_s = np.sqrt(s_arr[0]**2 + s_arr[1]**2)                                  
      crossings = np.where(np.diff((r_s >= best_thr).astype(int)) != 0)[0]      
      if len(crossings) > 0:                                                    
          idx = crossings[0]                                                    
          print(f"Jump at r={r_s[idx]:.2f}: {s_arr[:, idx+1] - s_arr[:,         
  idx]}")                                                                       
                                                                                
  # Refine equations based on dominant terms                                    
  def refine(c):                                                                
      return [round(x, 4) if abs(x) > 1e-4 else 0.0 for x in c]                 
                                                                                
  print("Refined Mode 1 x3_dot:", refine(c3_m1))                                
  print("Refined Mode 1 x4_dot:", refine(c4_m1))                                
  print("Refined Mode 2 x3_dot:", refine(c3_m2))                                
  print("Refined Mode 2 x4_dot:", refine(c4_m2))                                
