import numpy as np                                                              
                                                                                
def analyze_trajectories():                                                     
    all_sample_results = []                                                     
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        t = data['t']                                                           
        x = data['x']                                                           
        dt = t[1] - t[0]                                                        
                                                                                
        x1 = x[:, 0]                                                            
        x2 = x[:, 1]                                                            
        x3 = x[:, 2]                                                            
        x4 = x[:, 3]                                                            
                                                                                
        # Calculate derivatives for x3 and x4                                   
        dx3 = np.diff(x3) / dt                                                  
        dx4 = np.diff(x4) / dt                                                  
                                                                                
        # Look for the jump in derivatives to find mode switch time             
        # dx3 has N-1 elements. np.diff(dx3) has N-2 elements.                  
        diff_sum = np.abs(np.diff(dx3)) + np.abs(np.diff(dx4))                  
        jump_idx = np.argmax(diff_sum) + 1                                      
                                                                                
        # Threshold at switch point                                             
        # Using the state at the moment of the switch                           
        l_switch = np.sqrt(x1[jump_idx]**2 + x2[jump_idx]**2)                   
                                                                                
        # Fit coefficients for Mode 1 (0 to jump_idx-1)                         
        def fit(indices, target_dot):                                           
            # Target is dx3 or dx4                                              
            # Features: x1, x2, x3, x4, 1                                       
            A = np.column_stack([x1[indices], x2[indices], x3[indices],         
x4[indices], np.ones(len(indices))])                                            
            b = target_dot[indices]                                             
            coeffs, _, _, _ = np.linalg.lstsq(A, b, rcond=None)                 
            return coeffs                                                       
                                                                                
        m1_indices = np.arange(0, jump_idx)                                     
        m1_coeffs_3 = fit(m1_indices, dx3)                                      
        m1_coeffs_4 = fit(m1_indices, dx4)                                      
                                                                                
        # Fit coefficients for Mode 2 (jump_idx to end)                         
        m2_indices = np.arange(jump_idx, len(dx3))                              
        m2_coeffs_3 = fit(m2_indices, dx3)                                      
        m2_coeffs_4 = fit(m2_indices, dx4)                                      
                                                                                
        all_sample_results.append({                                             
            'm1_3': m1_coeffs_3,                                                
            'm1_4': m1_coeffs_4,                                                
            'm2_3': m2_coeffs_3,                                                
            'm2_4': m2_coeffs_4,                                                
            'threshold': l_switch                                               
        })                                                                      
                                                                                
    # Average results                                                           
    avg_m1_3 = np.mean([res['m1_3'] for res in all_sample_results], axis=0)     
    avg_m1_4 = np.mean([res['m1_4'] for res in all_sample_results], axis=0)     
    avg_m2_3 = np.mean([res['m2_3'] for res in all_sample_results], axis=0)     
    avg_m2_4 = np.mean([res['m2_4'] for res in all_sample_results], axis=0)     
    avg_threshold = np.mean([res['threshold'] for res in all_sample_results])   
                                                                                
    return avg_m1_3, avg_m1_4, avg_m2_3, avg_m2_4, avg_threshold                
                                                                                
