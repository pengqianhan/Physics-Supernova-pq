  import numpy as np                                                            
                                                                                
  dt = 0.001                                                                    
  initial_threshold = 842.8144                                                  
                                                                                
  data_files = ['data_all/non_linear/spacecraft/sample_0.npz',                  
                'data_all/non_linear/spacecraft/sample_1.npz',                  
                'data_all/non_linear/spacecraft/sample_2.npz']                  
                                                                                
  all_X = []                                                                    
  all_dX3 = []                                                                  
  all_dX4 = []                                                                  
  all_R = []                                                                    
                                                                                
  for f in data_files:                                                          
      data = np.load(f)                                                         
      state = data['state']                                                     
                                                                                
      x1, x2, x3, x4 = state[0], state[1], state[2], state[3]                   
      R = np.sqrt(x1**2 + x2**2)                                                
                                                                                
      # Identify crossing                                                       
      cross_idx = []                                                            
      for i in range(len(R)-1):                                                 
          if (R[i] > initial_threshold and R[i+1] <= initial_threshold) or      
  (R[i] <= initial_threshold and R[i+1] > initial_threshold):                   
              cross_idx.append(i)                                               
                                                                                
      print(f"File {f} crosses threshold at indices: {cross_idx}")              
      if cross_idx:                                                             
          print(f"Transition times: {[idx * dt for idx in cross_idx]}")         
                                                                                
      dx3 = np.diff(x3) / dt                                                    
      dx4 = np.diff(x4) / dt                                                    
                                                                                
      X_f = state[:, :-1].T                                                     
                                                                                
      all_X.append(X_f)                                                         
      all_dX3.append(dx3)                                                       
      all_dX4.append(dx4)                                                       
      all_R.append(R[:-1])                                                      
                                                                                
  X_total = np.vstack(all_X)                                                    
  dX3_total = np.concatenate(all_dX3)                                           
  dX4_total = np.concatenate(all_dX4)                                           
  R_total = np.concatenate(all_R)                                               
  targets = np.vstack([dX3_total, dX4_total]).T                                 
  X_with_bias = np.hstack([X_total, np.ones((X_total.shape[0], 1))])            
                                                                                
  def get_regression_np(X, y):                                                  
      coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)            
      return coeffs                                                             
                                                                                
  # Re-evaluating error with np.dot instead of @                                
  def compute_error(t):                                                         
      m1 = R_total > t                                                          
      m2 = R_total <= t                                                         
      if np.sum(m1) < 10 or np.sum(m2) < 10:                                    
          return np.inf                                                         
                                                                                
      c1 = get_regression_np(X_with_bias[m1], targets[m1])                      
      c2 = get_regression_np(X_with_bias[m2], targets[m2])                      
                                                                                
      pred1 = np.dot(X_with_bias[m1], c1)                                       
      pred2 = np.dot(X_with_bias[m2], c2)                                       
                                                                                
      err1 = np.sum((targets[m1] - pred1)**2)                                   
      err2 = np.sum((targets[m2] - pred2)**2)                                   
      return err1 + err2                                                        
                                                                                
  # Refine threshold search                                                     
  thresholds_to_test = np.linspace(initial_threshold - 5, initial_threshold +   
  5, 201)                                                                       
  best_t = initial_threshold                                                    
  min_err = np.inf                                                              
                                                                                
  for t in thresholds_to_test:                                                  
      err = compute_error(t)                                                    
      if err < min_err:                                                         
          min_err = err                                                         
          best_t = t                                                            
                                                                                
  print(f"Refined Best threshold: {best_t}")                                    
                                                                                
  # Final coefficients with best threshold                                      
  mask1 = R_total > best_t                                                      
  mask2 = R_total <= best_t                                                     
                                                                                
  coeffs_m1 = get_regression_np(X_with_bias[mask1], targets[mask1])             
