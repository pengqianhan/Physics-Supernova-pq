x_m2 = x_aligned[split_idx:]                                                    
x_dot_m2 = x_dot[split_idx:]                                                    
                                                                                
def identify_params(X, X_dot):                                                  
    # Equations:                                                                
    # x3_dot = a * x1 + b * x3 + c                                              
    # x4_dot = a * x2 + b * x4 + d                                              
                                                                                
    n = X.shape[0]                                                              
    x1, x2, x3, x4 = X[:, 0], X[:, 1], X[:, 2], X[:, 3]                         
    x3_dot, x4_dot = X_dot[:, 2], X_dot[:, 3]                                   
                                                                                
    # Combined regression:                                                      
