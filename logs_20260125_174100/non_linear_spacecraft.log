import numpy as np                                                              
                                                                                
# Load all data                                                                 
data_files = ['data_all/non_linear/spacecraft/sample_0.npz',                    
'data_all/non_linear/spacecraft/sample_1.npz',                                  
'data_all/non_linear/spacecraft/sample_2.npz']                                  
all_st = [np.load(f)['state'] for f in data_files]                              
dt = 0.1                                                                        
                                                                                
all_x1, all_x2, all_x3, all_x4 = [], [], [], []                                 
all_dx3, all_dx4 = [], []                                                       
                                                                                
for st in all_st:                                                               
    x1, x2, x3, x4 = st[0], st[1], st[2], st[3]                                 
    # Compute derivatives using forward difference                              
    dx3 = (x3[1:] - x3[:-1]) / dt                                               
    dx4 = (x4[1:] - x4[:-1]) / dt                                               
    all_x1.extend(x1[:-1])                                                      
    all_x2.extend(x2[:-1])                                                      
    all_x3.extend(x3[:-1])                                                      
    all_x4.extend(x4[:-1])                                                      
    all_dx3.extend(dx3)                                                         
    all_dx4.extend(dx4)                                                         
                                                                                
X1, X2, X3, X4 = map(np.array, [all_x1, all_x2, all_x3, all_x4])                
DX3, DX4 = map(np.array, [all_dx3, all_dx4])                                    
R = np.sqrt(X1**2 + X2**2)                                                      
                                                                                
def fit_and_get_metrics(x, y, target):                                          
    A = np.stack([x, y, np.ones_like(x)], axis=1)                               
    beta, _, _, _ = np.linalg.lstsq(A, target, rcond=None)                      
    res = target - np.dot(A, beta)                                              
    max_diff = np.max(np.abs(res))                                              
    return beta, max_diff                                                       
                                                                                
def solve_sym(m):                                                               
    # Enforce a1=a2, b1=b2, bias1=bias2 by pooling data                         
    X_pool = np.vstack([np.stack([X1[m], X3[m], np.ones_like(X1[m])], axis=1),  
                        np.stack([X2[m], X4[m], np.ones_like(X2[m])], axis=1)]) 
    Y_pool = np.concatenate([DX3[m], DX4[m]])                                   
    beta, _, _, _ = np.linalg.lstsq(X_pool, Y_pool, rcond=None)                 
    max_diff = np.max(np.abs(Y_pool - np.dot(X_pool, beta)))                    
    return beta, max_diff                                                       
                                                                                
T_values = np.arange(842.80, 842.831, 0.001)                                    
best_T = None                                                                   
min_max_err = float('inf')                                                      
final_results = {}                                                              
                                                                                
for T in T_values:                                                              
    m1 = R > T                                                                  
    m2 = R <= T                                                                 
    if np.sum(m1) < 10 or np.sum(m2) < 10: continue                             
                                                                                
    # Asymmetric model                                                          
    b1_3, e1_3 = fit_and_get_metrics(X1[m1], X3[m1], DX3[m1])                   
    b1_4, e1_4 = fit_and_get_metrics(X2[m1], X4[m1], DX4[m1])                   
    b2_3, e2_3 = fit_and_get_metrics(X1[m2], X3[m2], DX3[m2])                   
    b2_4, e2_4 = fit_and_get_metrics(X2[m2], X4[m2], DX4[m2])                   
                                                                                
    max_err = max(e1_3, e1_4, e2_3, e2_4)                                       
    if max_err < min_max_err:                                                   
        min_max_err = max_err                                                   
        best_T = T                                                              
        final_results = {                                                       
            'm1_3': b1_3, 'm1_4': b1_4,                                         
            'm2_3': b2_3, 'm2_4': b2_4,                                         
            'errs': (e1_3, e1_4, e2_3, e2_4)                                    
        }                                                                       
                                                                                
# Final check of symmetry at best T                                             
m1_best = R > best_T                                                            
m2_best = R <= best_T                                                           
b_sym1, e_sym1 = solve_sym(m1_best)                                             
b_sym2, e_sym2 = solve_sym(m2_best)                                             
                                                                                
print(f"Best T: {best_T:.3f}")                                                  
print(f"Min Max Difference: {min_max_err:.10f}")                                
print(f"Mode 1 Symmetric Max Diff: {e_sym1:.10f} vs Asymmetric:                 
{max(final_results['errs'][0], final_results['errs'][1]):.10f}")                
print(f"Mode 2 Symmetric Max Diff: {e_sym2:.10f} vs Asymmetric:                 
{max(final_results['errs'][2], final_results['errs'][3]):.10f}")                
                                                                                
# Coefficients                                                                  
print("Final Coefficients (Asymmetric):")                                       
print(f"Mode 1 (Outer): a1={final_results['m1_3'][0]:.10f},                     
b1={final_results['m1_3'][1]:.10f}, bias1={final_results['m1_3'][2]:.10f}")     
print(f"Mode 1 (Outer): a2={final_results['m1_4'][0]:.10f},                     
b2={final_results['m1_4'][1]:.10f}, bias2={final_results['m1_4'][2]:.10f}")     
print(f"Mode 2 (Inner): a1={final_results['m2_3'][0]:.10f},                     
b1={final_results['m2_3'][1]:.10f}, bias1={final_results['m2_3'][2]:.10f}")     
