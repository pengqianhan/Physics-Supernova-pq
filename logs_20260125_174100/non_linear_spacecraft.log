        # Mode 1 points                                                         
        for i in range(idx_trans - 10):                                         
            # Equation: x3_dot = k1*x1 + k2*x3 + bias_x3                        
            # Equation: x4_dot = k1*x2 + k2*x4 + bias_x4                        
