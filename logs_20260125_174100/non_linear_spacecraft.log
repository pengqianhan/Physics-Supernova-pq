import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load all samples                                                              
data0 = np.load('data_all/non_linear/spacecraft/sample_0.npz')                  
data1 = np.load('data_all/non_linear/spacecraft/sample_1.npz')                  
data2 = np.load('data_all/non_linear/spacecraft/sample_2.npz')                  
                                                                                
X0 = data0['state']                                                             
X1 = data1['state']                                                             
X2 = data2['state']                                                             
                                                                                
def get_segments(X, threshold=842.8):                                           
    r = np.sqrt(X[0]**2 + X[1]**2)                                              
    mode1_indices = np.where(r > threshold)[0]                                  
    mode2_indices = np.where(r < threshold)[0]                                  
    return mode1_indices, mode2_indices                                         
                                                                                
m1_0, m2_0 = get_segments(X0)                                                   
m1_1, m2_1 = get_segments(X1)                                                   
m1_2, m2_2 = get_segments(X2)                                                   
                                                                                
# Check for resets at the transition in sample 0                                
# Index of switch is 7946 (where r crosses 842.8)                               
# Let's see the state around 7946                                               
print("Transition at sample 0, index 7946:")                                    
print("State at 7946:", X0[:, 7946])                                            
print("State at 7947:", X0[:, 7947])                                            
                                                                                
# Prepare data for fitting Mode 1                                               
# We need x1[k+1] = x3[k], x2[k+1] = x4[k] - wait, the task says:               
# x1[1] = x3[0]                                                                 
# x2[1] = x4[0]                                                                 
# This looks like state indices, but let's check the relationship between X[0,  
k+1] and X[2, k].                                                               
print("Mode 1 check (sample 0):")                                               
print("Mean(X[0, 1:] - X[2, :-1]):", np.mean(X0[0, 1:] - X0[2, :-1]))           
print("Mean(X[1, 1:] - X[3, :-1]):", np.mean(X0[1, 1:] - X0[3, :-1]))           
                                                                                
# Fit x3[k+1] = a*x1[k] + b*x3[k] + bias_x3                                     
# and x4[k+1] = c*x2[k] + d*x4[k] + bias_x4                                     
                                                                                
def fit_mode(X_list, indices_list):                                             
    # Collect all [x1[k], x3[k]] pairs and [x3[k+1]] targets                    
    # and all [x2[k], x4[k]] pairs and [x4[k+1]] targets                        
    data_x3 = []                                                                
    target_x3 = []                                                              
    data_x4 = []                                                                
    target_x4 = []                                                              
                                                                                
    for X, indices in zip(X_list, indices_list):                                
        # We need consecutive indices in the same mode                          
        for i in indices:                                                       
            if i + 1 in indices:                                                
                data_x3.append([X[0, i], X[2, i]])                              
                target_x3.append(X[2, i+1])                                     
                data_x4.append([X[1, i], X[3, i]])                              
                target_x4.append(X[3, i+1])                                     
                                                                                
    reg3 = LinearRegression().fit(data_x3, target_x3)                           
    reg4 = LinearRegression().fit(data_x4, target_x4)                           
                                                                                
    return reg3.coef_, reg3.intercept_, reg4.coef_, reg4.intercept_             
                                                                                
# Fit Mode 1                                                                    
coef3_m1, bias3_m1, coef4_m1, bias4_m1 = fit_mode([X0, X1, X2], [m1_0, m1_1,    
m1_2])                                                                          
print("Mode 1 (r > 842.8):")                                                    
print(f"x3: a={coef3_m1[0]}, b={coef3_m1[1]}, bias={bias3_m1}")                 
print(f"x4: c={coef4_m1[0]}, d={coef4_m1[1]}, bias={bias4_m1}")                 
                                                                                
# Fit Mode 2                                                                    
coef3_m2, bias3_m2, coef4_m2, bias4_m2 = fit_mode([X0, X1, X2], [m2_0, m2_1,    
m2_2])                                                                          
print("Mode 2 (r < 842.8):")                                                    
print(f"x3: a={coef3_m2[0]}, b={coef3_m2[1]}, bias={bias3_m2}")                 
print(f"x4: c={coef4_m2[0]}, d={coef4_m2[1]}, bias={bias4_m2}")                 
                                                                                
# Refine threshold                                                              
def find_precise_threshold(X, indices):                                         
    # The transition happens between index i and i+1                            
    # where r[i] > 842.8 and r[i+1] < 842.8 (or vice versa)                     
    r = np.sqrt(X[0]**2 + X[1]**2)                                              
    thresholds = []                                                             
    for i in range(len(r)-1):                                                   
        if (r[i] > 842.8 and r[i+1] < 842.8) or (r[i] < 842.8 and r[i+1] >      
842.8):                                                                         
            thresholds.append((r[i] + r[i+1]) / 2)                              
    return thresholds                                                           
                                                                                
print("Approximate thresholds found:", find_precise_threshold(X0, None),        
find_precise_threshold(X1, None), find_precise_threshold(X2, None))             
                                                                                
                                                                                
