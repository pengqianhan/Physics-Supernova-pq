# 2. Identify mapping                                                           
dx_obs = (Xn - Xc) / dt                                                         
# Check if dx1_dt = x3 and dx2_dt = x4 (mapping 0,1,2,3)                        
err1 = np.mean(np.abs(dx_obs[:, 0] - Xc[:, 2]))                                 
err2 = np.mean(np.abs(dx_obs[:, 1] - Xc[:, 3]))                                 
# Check if dx3_dt = x1 and dx4_dt = x2 (mapping 2,3,0,1)                        
err3 = np.mean(np.abs(dx_obs[:, 2] - Xc[:, 0]))                                 
err4 = np.mean(np.abs(dx_obs[:, 3] - Xc[:, 1]))                                 
                                                                                
if err1 + err2 < err3 + err4:                                                   
    idx_x1, idx_x2, idx_x3, idx_x4 = 0, 1, 2, 3                                 
else:                                                                           
