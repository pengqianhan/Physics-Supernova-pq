import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
t = data['t']                                                                   
x = data['x']  # x1, x2, x3, x4 are the columns                                 
                                                                                
# Calculate derivatives using finite differences                                
dt = 0.001                                                                      
x_dot = (x[1:] - x[:-1]) / dt                                                   
# Align x with x_dot (take first N-1 points)                                    
x_aligned = x[:-1]                                                              
t_aligned = t[:-1]                                                              
                                                                                
# Identify transition point                                                     
# Manager suggested t around 7.554                                              
split_idx = np.searchsorted(t_aligned, 7.554)                                   
                                                                                
# Split data                                                                    
x_mode1 = x_aligned[:split_idx]                                                 
x_dot_mode1 = x_dot[:split_idx]                                                 
x_mode2 = x_aligned[split_idx:]                                                 
x_dot_mode2 = x_dot[split_idx:]                                                 
                                                                                
# Fit Mode 1:                                                                   
# x3_dot = a1 * x1 + b1 * x3 + c1                                               
# x4_dot = a1 * x2 + b1 * x4 + d1                                               
# Combine target and features to fit a1, b1, c1, d1 simultaneously              
# Targets: x3_dot and x4_dot                                                    
# Features for x3_dot: [x1, x3, 1, 0]                                           
# Features for x4_dot: [x2, x4, 0, 1]                                           
# We can solve them separately but a1 and b1 are shared.                        
# Let's stack them:                                                             
# Y = [x3_dot; x4_dot]                                                          
# M = [[x1, x3, 1, 0]; [x2, x4, 0, 1]]                                          
# Coeffs = [a1, b1, c1, d1]                                                     
                                                                                
def fit_mode(x_vals, x_dot_vals):                                               
    x1, x2, x3, x4 = x_vals[:, 0], x_vals[:, 1], x_vals[:, 2], x_vals[:, 3]     
    x3_dot, x4_dot = x_dot_vals[:, 2], x_dot_vals[:, 3]                         
                                                                                
    # Constructing the system:                                                  
    # [x3_dot] = [x1  x3  1  0] [a]                                             
    # [x4_dot] = [x2  x4  0  1] [b]                                             
    #                           [c]                                             
    #                           [d]                                             
                                                                                
    N = len(x1)                                                                 
    Y = np.concatenate([x3_dot, x4_dot])                                        
    M = np.zeros((2*N, 4))                                                      
                                                                                
    # Top half: x3_dot equations                                                
    M[:N, 0] = x1                                                               
    M[:N, 1] = x3                                                               
    M[:N, 2] = 1.0                                                              
    M[:N, 3] = 0.0                                                              
                                                                                
    # Bottom half: x4_dot equations                                             
    M[N:, 0] = x2                                                               
    M[N:, 1] = x4                                                               
    M[N:, 2] = 0.0                                                              
    M[N:, 3] = 1.0                                                              
                                                                                
    reg = LinearRegression(fit_intercept=False).fit(M, Y)                       
    return reg.coef_                                                            
                                                                                
params1 = fit_mode(x_mode1, x_dot_mode1)                                        
params2 = fit_mode(x_mode2, x_dot_mode2)                                        
                                                                                
# Guard threshold                                                               
x1_switch = x_aligned[split_idx, 0]                                             
x2_switch = x_aligned[split_idx, 1]                                             
threshold = (x1_switch**2 + x2_switch**2)**0.5                                  
                                                                                
print(f"Mode 1 params: a1={params1[0]}, b1={params1[1]}, c1={params1[2]},       
d1={params1[3]}")                                                               
print(f"Mode 2 params: a2={params2[0]}, b2={params2[1]}, c2={params2[2]},       
d2={params2[3]}")                                                               
print(f"Threshold: {threshold}")                                                
                                                                                
