import numpy as np                                                              
                                                                                
def fit_file(i, threshold):                                                     
    data = np.load(f'data_all/non_linear/spacecraft/sample_{i}.npz')            
    state = data['state']                                                       
    x1, x2, x3, x4 = state                                                      
    dt = 0.001                                                                  
    x3_dot = np.gradient(x3, dt)                                                
    x4_dot = np.gradient(x4, dt)                                                
    r = np.sqrt(x1**2 + x2**2)                                                  
                                                                                
    jumps = np.abs(np.diff(x3_dot))                                             
    idx = np.argmax(jumps)                                                      
                                                                                
    mask_high = (r > threshold)                                                 
    mask_low = (r <= threshold)                                                 
                                                                                
    # Exclude transition                                                        
    mask_high[idx-50:idx+50] = False                                            
    mask_low[idx-50:idx+50] = False                                             
                                                                                
    def fit(m):                                                                 
        if np.sum(m) < 10: return None                                          
        N = np.sum(m)                                                           
        A = np.zeros((2*N, 4))                                                  
        A[0::2, 0] = x1[m]                                                      
        A[0::2, 1] = x3[m]                                                      
        A[0::2, 2] = 1                                                          
        A[1::2, 0] = x2[m]                                                      
        A[1::2, 1] = x4[m]                                                      
        A[1::2, 3] = 1                                                          
        y = np.zeros(2*N)                                                       
        y[0::2] = x3_dot[m]                                                     
        y[1::2] = x4_dot[m]                                                     
        c, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                          
        return c                                                                
                                                                                
    return fit(mask_high), fit(mask_low)                                        
                                                                                
for i in range(3):                                                              
    c_high, c_low = fit_file(i, 842.63)                                         
    print(f"File {i} High:", c_high)                                            
    print(f"File {i} Low:", c_low)                                              
                                                                                
