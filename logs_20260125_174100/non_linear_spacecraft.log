    # [x4_dot] = [x2 x4 0 1] [b]                                                
    #                        [c]                                                
    #                        [d]                                                
                                                                                
    Y = np.concatenate([x3_dot, x4_dot])                                        
    M = np.zeros((2 * n, 4))                                                    
                                                                                
