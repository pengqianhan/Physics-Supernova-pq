'data_all/non_linear/spacecraft/sample_2.npz']:                                 
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1, x2, x3, x4 = state                                                      
                                                                                
    # Calculate dots for x3 and x4                                              
    # Simple central difference for interior points                             
    x3_dot = np.zeros_like(x3)                                                  
    x4_dot = np.zeros_like(x4)                                                  
    x3_dot[1:-1] = (x3[2:] - x3[:-2]) / (2 * dt)                                
