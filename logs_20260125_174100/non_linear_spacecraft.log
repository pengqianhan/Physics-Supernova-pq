import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the first trace                                                          
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
t = data['t']                                                                   
x1 = data['x1']                                                                 
x2 = data['x2']                                                                 
x3 = data['x3']                                                                 
x4 = data['x4']                                                                 
                                                                                
dt = 0.001                                                                      
                                                                                
# Estimate derivatives using finite differences                                 
dx3_dt = np.diff(x3) / dt                                                       
dx4_dt = np.diff(x4) / dt                                                       
                                                                                
# Adjust x variables to match the length of derivatives                         
x1_adj = x1[:-1]                                                                
x2_adj = x2[:-1]                                                                
x3_adj = x3[:-1]                                                                
x4_adj = x4[:-1]                                                                
t_adj = t[:-1]                                                                  
                                                                                
# Identify switch point                                                         
switch_t = 7.554                                                                
idx_mode1 = t_adj < switch_t                                                    
idx_mode2 = t_adj > switch_t                                                    
                                                                                
# Mode 1 Fitting                                                                
# dx3/dt = a1 * x1 + b1 * x3 + c1                                               
X1_dx3 = np.column_stack((x1_adj[idx_mode1], x3_adj[idx_mode1]))                
y1_dx3 = dx3_dt[idx_mode1]                                                      
reg1_dx3 = LinearRegression().fit(X1_dx3, y1_dx3)                               
a1, b1 = reg1_dx3.coef_                                                         
c1 = reg1_dx3.intercept_                                                        
                                                                                
# dx4/dt = a1_alt * x2 + b1_alt * x4 + d1                                       
X1_dx4 = np.column_stack((x2_adj[idx_mode1], x4_adj[idx_mode1]))                
y1_dx4 = dx4_dt[idx_mode1]                                                      
reg1_dx4 = LinearRegression().fit(X1_dx4, y1_dx4)                               
a1_alt, b1_alt = reg1_dx4.coef_                                                 
d1 = reg1_dx4.intercept_                                                        
                                                                                
# Mode 2 Fitting                                                                
# dx3/dt = a2 * x1 + b2 * x3 + c2                                               
X2_dx3 = np.column_stack((x1_adj[idx_mode2], x3_adj[idx_mode2]))                
y2_dx3 = dx3_dt[idx_mode2]                                                      
reg2_dx3 = LinearRegression().fit(X2_dx3, y2_dx3)                               
a2, b2 = reg2_dx3.coef_                                                         
c2 = reg2_dx3.intercept_                                                        
                                                                                
# dx4/dt = a2_alt * x2 + b2_alt * x4 + d2                                       
X2_dx4 = np.column_stack((x2_adj[idx_mode2], x4_adj[idx_mode2]))                
y2_dx4 = dx4_dt[idx_mode2]                                                      
reg2_dx4 = LinearRegression().fit(X2_dx4, y2_dx4)                               
a2_alt, b2_alt = reg2_dx4.coef_                                                 
d2 = reg2_dx4.intercept_                                                        
                                                                                
# Switching condition at t ~ 7.554                                              
# Find index closest to 7.554 in original t array                               
idx_switch = np.argmin(np.abs(t - switch_t))                                    
dist_at_switch = np.sqrt(x1[idx_switch]**2 + x2[idx_switch]**2)                 
                                                                                
print(f"Mode 1: a1={a1}, b1={b1}, c1={c1}, a1_alt={a1_alt}, b1_alt={b1_alt},    
d1={d1}")                                                                       
print(f"Mode 2: a2={a2}, b2={b2}, c2={c2}, a2_alt={a2_alt}, b2_alt={b2_alt},    
d2={d2}")                                                                       
print(f"Distance at switch: {dist_at_switch}")                                  
                                                                                
from final_answer import final_answer                                           
                                                                                
final_answer({                                                                  
    "task_outcome_short": "Successfully identified Hybrid Automaton parameters  
