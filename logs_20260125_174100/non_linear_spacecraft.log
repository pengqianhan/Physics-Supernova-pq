import numpy as np                                                              
                                                                                
# Total time is 10s based on previous check and sample size 10001               
dt = 0.001                                                                      
                                                                                
def solve_parameters():                                                         
    all_X1 = [] # Features for Mode 1                                           
    all_Y1 = [] # Target for Mode 1                                             
    all_X2 = [] # Features for Mode 2                                           
    all_Y2 = [] # Target for Mode 2                                             
    transition_radii = []                                                       
    transition_times = []                                                       
                                                                                
    for path in ['data_all/non_linear/spacecraft/sample_0.npz',                 
'data_all/non_linear/spacecraft/sample_1.npz',                                  
'data_all/non_linear/spacecraft/sample_2.npz']:                                 
        data = np.load(path)                                                    
        state = data['state']                                                   
        x1, x2, x3, x4 = state                                                  
                                                                                
        # Calculate derivatives                                                 
        dx3 = np.diff(x3) / dt                                                  
        dx4 = np.diff(x4) / dt                                                  
                                                                                
        # Calculate second derivatives (acceleration jump)                      
        ddx3 = np.abs(np.diff(dx3))                                             
        ddx4 = np.abs(np.diff(dx4))                                             
                                                                                
        # Combined jump metric                                                  
        jump = ddx3 + ddx4                                                      
        # We look around t=7.5s (index 7500)                                    
        search_range = range(7000, 9000)                                        
        idx = np.argmax(jump[7000:9000]) + 7001 # Correcting for slicing and    
double diff                                                                     
                                                                                
        transition_times.append(idx * dt)                                       
        r_trans = np.sqrt(x1[idx]**2 + x2[idx]**2)                              
        transition_radii.append(r_trans)                                        
                                                                                
        # Mode 1 data                                                           
        for j in range(idx - 1):                                                
            all_X1.append([x1[j], x3[j], 1.0])                                  
            all_Y1.append(dx3[j])                                               
            all_X1.append([x2[j], x4[j], 1.0])                                  
            all_Y1.append(dx4[j])                                               
                                                                                
        # Mode 2 data                                                           
        for j in range(idx, len(dx3)):                                          
            all_X2.append([x1[j], x3[j], 1.0])                                  
            all_Y2.append(dx3[j])                                               
            all_X2.append([x2[j], x4[j], 1.0])                                  
            all_Y2.append(dx4[j])                                               
                                                                                
    # Solve for Mode 1 using Least Squares                                      
    X1 = np.array(all_X1)                                                       
    Y1 = np.array(all_Y1)                                                       
    params1, _, _, _ = np.linalg.lstsq(X1, Y1, rcond=None)                      
    k1_1, k2_1, bias_1 = params1                                                
                                                                                
    # Solve for Mode 2                                                          
    X2 = np.array(all_X2)                                                       
    Y2 = np.array(all_Y2)                                                       
    params2, _, _, _ = np.linalg.lstsq(X2, Y2, rcond=None)                      
    k1_2, k2_2, bias_2 = params2                                                
                                                                                
    return (k1_1, k2_1, bias_1), (k1_2, k2_2, bias_2),                          
np.mean(transition_radii), transition_times                                     
                                                                                
(m1_k1, m1_k2, m1_bias), (m2_k1, m2_k2, m2_bias), r_threshold, t_trans =        
solve_parameters()                                                              
                                                                                
print(f"Transition times: {t_trans}")                                           
print(f"Mode 1: k1={m1_k1:.4f}, k2={m1_k2:.4f}, bias={m1_bias:.4f}")            
print(f"Mode 2: k1={m2_k1:.4f}, k2={m2_k2:.4f}, bias={m2_bias:.4f}")            
print(f"Threshold radius r: {r_threshold:.4f}")                                 
                                                                                
