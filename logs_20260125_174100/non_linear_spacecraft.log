  def fit_shared(X1, X2, Y3, Y4, affine=True):                                  
      # Fit Y3 = a*x1 + b*x3 + c                                                
      # Fit Y4 = a*x2 + b*x4 + d                                                
      # Minimize sum of squared errors                                          
