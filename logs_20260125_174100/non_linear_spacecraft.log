Thought: I will load the provided NPZ files to inspect the structure of the data
and verify the variables. Then, I will compute the derivatives of the velocity  
components ($x_3$ and $x_4$) using numerical differentiation. Following the     
manager's instructions, I will segment the data into two modes based on the     
specified time and distance criteria. Finally, I will apply linear regression to
identify the dynamic coefficients and bias terms for each mode, while also      
calculating the exact distance at the mode transition.                          
                                                                                
<code>                                                                          
import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data from NPZ files                                                  
data_files = ['data_all/non_linear/spacecraft/sample_0.npz',                    
'data_all/non_linear/spacecraft/sample_1.npz',                                  
'data_all/non_linear/spacecraft/sample_2.npz']                                  
                                                                                
all_t = []                                                                      
all_x = []                                                                      
all_x_dot = []                                                                  
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    t = data['t']                                                               
    x = data['x']                                                               
                                                                                
    # Calculate derivatives using central differences where possible            
    # For a more precise identification, we can use the derivative of x3 and x4 
    dt = t[1] - t[0]                                                            
    x_dot = np.zeros_like(x)                                                    
    for i in range(x.shape[1]):                                                 
        x_dot[:, i] = np.gradient(x[:, i], dt)                                  
                                                                                
    all_t.append(t)                                                             
    all_x.append(x)                                                             
    all_x_dot.append(x_dot)                                                     
                                                                                
# Concatenate all data                                                          
t_combined = np.concatenate(all_t)                                              
x_combined = np.concatenate(all_x)                                              
x_dot_combined = np.concatenate(all_x_dot)                                      
                                                                                
# Segment the data                                                              
# Mode 1: t < 7.554                                                             
# Mode 2: t >= 7.554                                                            
mask1 = t_combined < 7.554                                                      
mask2 = t_combined >= 7.554                                                     
                                                                                
def perform_regression(X, y):                                                   
    model = LinearRegression()                                                  
    model.fit(X, y)                                                             
    return model.coef_, model.intercept_                                        
                                                                                
# Variables: x1=x[:,0], x2=x[:,1], x3=x[:,2], x4=x[:,3]                         
# Targets: x_dot[:,2] (x3_dot), x_dot[:,3] (x4_dot)                             
                                                                                
results = {}                                                                    
                                                                                
for mode, mask in [("Mode 1", mask1), ("Mode 2", mask2)]:                       
    X = x_combined[mask]                                                        
    y_x3 = x_dot_combined[mask, 2]                                              
    y_x4 = x_dot_combined[mask, 3]                                              
                                                                                
    coef_x3, bias_x3 = perform_regression(X, y_x3)                              
    coef_x4, bias_x4 = perform_regression(X, y_x4)                              
                                                                                
    results[mode] = {                                                           
        "x3_coeffs": coef_x3,                                                   
        "x3_bias": bias_x3,                                                     
        "x4_coeffs": coef_x4,                                                   
        "x4_bias": bias_x4                                                      
    }                                                                           
                                                                                
# Check transition condition                                                    
# Identify the exact point around 7.554                                         
# We can find the closest t to 7.554 in each file or just look at the combined  
idx_transition = np.argmin(np.abs(t_combined - 7.554))                          
x1_trans = x_combined[idx_transition, 0]                                        
x2_trans = x_combined[idx_transition, 1]                                        
dist_trans = np.sqrt(x1_trans**2 + x2_trans**2)                                 
                                                                                
print("Results:", results)                                                      
print("Transition Distance:", dist_trans)                                       
                                                                                
