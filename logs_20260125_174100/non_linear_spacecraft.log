best_rc = None                                                                  
best_p1 = None                                                                  
best_p2 = None                                                                  
                                                                                
def fit_discrete(mask):                                                         
    if np.sum(mask) < 20: return None, 1e18                                     
    y = np.concatenate([x3n[mask], x4n[mask]])                                  
    N = np.sum(mask)                                                            
