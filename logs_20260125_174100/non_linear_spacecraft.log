# Find pairs (child, parent) such that state[child, 1:] == state[parent, :-1]   
pairs = []                                                                      
for i in range(4):                                                              
    for j in range(4):                                                          
        diff = np.max(np.abs(state[i, 1:] - state[j, :-1]))                     
        if diff < 1e-8:                                                         
            pairs.append((i, j))                                                
                                                                                
print(f"Shift pairs found: {pairs}")                                            
                                                                                
# There should be two pairs: (x1, x3) and (x2, x4)                              
# Let's assume the first pair is (x1, x3) and second is (x2, x4)                
# or vice-versa.                                                                
for p1, p2 in [(pairs[0], pairs[1]), (pairs[1], pairs[0])]:                     
    ix1, ix3 = p1                                                               
    ix2, ix4 = p2                                                               
                                                                                
    x1, x2, x3, x4 = state[ix1], state[ix2], state[ix3], state[ix4]             
    R = np.sqrt(x1**2 + x2**2)                                                  
                                                                                
    # Check if x3[t+1] is related to x1[t] and x3[t]                            
    # We look for a mode change.                                                
    # Try fitting a2, b2 on the last 100 points                                 
    T = state.shape[1]                                                          
    last = 100                                                                  
    A = np.column_stack([x1[T-last-1:-1], x3[T-last-1:-1]])                     
    Y = x3[T-last:]                                                             
    coeffs2, _, _, _ = np.linalg.lstsq(A, Y, rcond=None)                        
    a2, b2 = coeffs2                                                            
                                                                                
    # Check error over time                                                     
    preds = a2 * x1[:-1] + b2 * x3[:-1]                                         
