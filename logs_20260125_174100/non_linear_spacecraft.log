  def fast_joint_fit(X, Y):                                                     
      # X: (4, N), Y: (2, N)                                                    
      x1, x2, x3, x4 = X[0], X[1], X[2], X[3]                                   
      y3, y4 = Y[0], Y[1]                                                       
                                                                                
      m11 = np.sum(x1**2 + x2**2)                                               
      m12 = np.sum(x1*x3 + x2*x4)                                               
      m13 = np.sum(x1)                                                          
      m14 = np.sum(x2)                                                          
                                                                                
      m22 = np.sum(x3**2 + x4**2)                                               
      m23 = np.sum(x3)                                                          
      m24 = np.sum(x4)                                                          
                                                                                
      m33 = len(x1)                                                             
      m44 = len(x1)                                                             
                                                                                
      M = np.array([                                                            
          [m11, m12, m13, m14],                                                 
          [m12, m22, m23, m24],                                                 
          [m13, m23, m33, 0],                                                   
          [m14, m24, 0, m44]                                                    
      ])                                                                        
                                                                                
      v1 = np.sum(x1*y3 + x2*y4)                                                
      v2 = np.sum(x3*y3 + x4*y4)                                                
      v3 = np.sum(y3)                                                           
      v4 = np.sum(y4)                                                           
                                                                                
