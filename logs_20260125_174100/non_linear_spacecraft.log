import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
# Constants                                                                     
dt = 0.001                                                                      
threshold = 842.8                                                               
                                                                                
# Load all data files                                                           
states_list = []                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    states_list.append(data['state'])                                           
                                                                                
# Combine all data                                                              
# states_list[0] has shape (4, 10001)                                           
all_states = np.concatenate(states_list, axis=1) # (4, 30003)                   
                                                                                
# Calculate derivatives using central/forward difference                        
# Let's use forward difference for simplicity: (x(t+dt) - x(t)) / dt            
# We need to be careful with concatenations between files.                      
# It's better to compute derivatives for each file separately and then          
concatenate.                                                                    
                                                                                
X = []                                                                          
X_dot = []                                                                      
                                                                                
for s in states_list:                                                           
    # s is (4, 10001)                                                           
    # Forward difference                                                        
    x_dot = (s[:, 1:] - s[:, :-1]) / dt                                         
    x_curr = s[:, :-1]                                                          
                                                                                
    X.append(x_curr.T)                                                          
    X_dot.append(x_dot.T)                                                       
                                                                                
X = np.concatenate(X, axis=0) # (30000, 4)                                      
X_dot = np.concatenate(X_dot, axis=0) # (30000, 4)                              
                                                                                
# Radial distance                                                               
r = np.sqrt(X[:, 0]**2 + X[:, 1]**2)                                            
                                                                                
# Identify modes                                                                
mask_m1 = r > threshold                                                         
mask_m2 = r <= threshold                                                        
                                                                                
print(f"Points in Mode 1: {np.sum(mask_m1)}")                                   
print(f"Points in Mode 2: {np.sum(mask_m2)}")                                   
                                                                                
