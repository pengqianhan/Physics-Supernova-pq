  p1_3, p1_4 = final_fit(R > r_star)                                            
  p2_3, p2_4 = final_fit(R <= r_star)                                           
                                                                                
  print(f"Mode 1 coeffs (> {r_star}):")                                         
  print(f"a-e: {p1_3}")                                                         
  print(f"f-j: {p1_4}")                                                         
  print(f"Mode 2 coeffs (<= {r_star}):")                                        
  print(f"a-e: {p2_3}")                                                         
  print(f"f-j: {p2_4}")                                                         
                                                                                
  # Check for resets at best_r                                                  
  max_jump = 0                                                                  
  for f in data_files:                                                          
      s = np.load(f)['state'].T                                                 
      r = np.sqrt(s[:, 0]**2 + s[:, 1]**2)                                      
      for i in range(len(r)-1):                                                 
          if (r[i] - r_star) * (r[i+1] - r_star) < 0:                           
              jump = np.linalg.norm(s[i+1] - s[i])                              
              if jump > max_jump: max_jump = jump                               
  print(f"Max jump at transition: {max_jump}")                                  
