import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Initialize lists to store data from all samples                               
all_d = []                                                                      
all_x1 = []                                                                     
all_x3 = []                                                                     
all_dx3 = []                                                                    
all_x2 = []                                                                     
all_x4 = []                                                                     
all_dx4 = []                                                                    
                                                                                
# Assuming dt = 0.1 for the sake of calculation; if it's different,             
# it will scale the coefficients but not the threshold identification.          
# Let's check the state transitions to infer dt if possible.                    
# Prompt says x1[1] = x3[0], which means (x1(t+dt) - x1(t))/dt = x3(t) is NOT   
what it says.                                                                   
# It says x1[1] = x3[0], where [1] is the derivative. This implies x1_dot = x3. 
                                                                                
dt = 0.1 # Common value, let's use it for derivatives.                          
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
    # state shape is (4, 10001)                                                 
    x1, x2, x3, x4 = state[0], state[1], state[2], state[3]                     
                                                                                
    # Calculate derivatives using central differences                           
    dx3 = np.gradient(x3, dt)                                                   
    dx4 = np.gradient(x4, dt)                                                   
    d = np.sqrt(x1**2 + x2**2)                                                  
                                                                                
    all_d.extend(d)                                                             
    all_x1.extend(x1)                                                           
    all_x3.extend(x3)                                                           
    all_dx3.extend(dx3)                                                         
    all_x2.extend(x2)                                                           
    all_x4.extend(x4)                                                           
    all_dx4.extend(dx4)                                                         
                                                                                
all_d = np.array(all_d)                                                         
all_x1 = np.array(all_x1)                                                       
all_x3 = np.array(all_x3)                                                       
all_dx3 = np.array(all_dx3)                                                     
all_x2 = np.array(all_x2)                                                       
all_x4 = np.array(all_x4)                                                       
all_dx4 = np.array(all_dx4)                                                     
                                                                                
# Plotting or analyzing the distribution of d to find the switch                
print(f"Min d: {np.min(all_d)}, Max d: {np.max(all_d)}, Mean d:                 
{np.mean(all_d)}")                                                              
                                                                                
# Let's try to find the threshold by checking where the linear model for dx3 =  
a*x1 + b*x3 + c changes.                                                        
# We can try a range of thresholds and see which one minimizes the total        
residual.                                                                       
thresholds = np.linspace(np.min(all_d) + 0.1, np.max(all_d) - 0.1, 20)          
best_threshold = None                                                           
min_residual = float('inf')                                                     
                                                                                
for t in thresholds:                                                            
    mask1 = all_d <= t                                                          
    mask2 = all_d > t                                                           
                                                                                
    if np.sum(mask1) < 10 or np.sum(mask2) < 10:                                
        continue                                                                
                                                                                
    # Fit Mode 1                                                                
    reg1 = LinearRegression().fit(np.column_stack((all_x1[mask1],               
all_x3[mask1])), all_dx3[mask1])                                                
    res1 = np.sum((reg1.predict(np.column_stack((all_x1[mask1], all_x3[mask1])))
- all_dx3[mask1])**2)                                                           
                                                                                
    # Fit Mode 2                                                                
    reg2 = LinearRegression().fit(np.column_stack((all_x1[mask2],               
all_x3[mask2])), all_dx3[mask2])                                                
    res2 = np.sum((reg2.predict(np.column_stack((all_x1[mask2], all_x3[mask2])))
- all_dx3[mask2])**2)                                                           
                                                                                
    if (res1 + res2) < min_residual:                                            
        min_residual = res1 + res2                                              
        best_threshold = t                                                      
                                                                                
print(f"Best threshold found: {best_threshold}")                                
                                                                                
