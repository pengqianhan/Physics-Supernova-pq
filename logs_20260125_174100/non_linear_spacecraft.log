│                 {                                                            │
│                   "type": "string"                                           │
│                 },                                                           │
│                 {                                                            │
│                   "type": "number"                                           │
│                 }                                                            │
│               \]                                                             │
│             }                                                                │
│           },                                                                 │
│           "examples": [                                                      │
