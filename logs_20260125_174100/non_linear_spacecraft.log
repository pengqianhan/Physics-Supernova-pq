    avg_m2_3 = np.mean([r['m2_3'] for r in all_res], axis=0)                    
    avg_m2_4 = np.mean([r['m2_4'] for r in all_res], axis=0)                    
    avg_thr = np.mean([r['threshold'] for r in all_res])                        
                                                                                
