    """Performs linear regression: DX_sub_col = A * [x_target, v_target, 1]"""  
    # Create feature matrix with targeted state, corresponding velocity, and    
bias constant                                                                   
    A = np.column_stack([X_sub, np.ones(len(X_sub))])                           
    params, _, _, _ = np.linalg.lstsq(A, DX_sub_col, rcond=None)                
    return params                                                               
                                                                                
# Linear Regression for Mode 1 (r > 0.1)                                        
# Parameters: [k, damping, bias]                                                
m1_x3_params = fit_dynamics(X[mask1][:, [0, 2]], DX[mask1, 2])                  
m1_x4_params = fit_dynamics(X[mask1][:, [1, 3]], DX[mask1, 3])                  
                                                                                
# Linear Regression for Mode 2 (r <= 0.1)                                       
m2_x3_params = fit_dynamics(X[mask2][:, [0, 2]], DX[mask2, 2])                  
m2_x4_params = fit_dynamics(X[mask2][:, [1, 3]], DX[mask2, 3])                  
                                                                                
# Regression results:                                                           
# Mode 1: k1 = -0.0001, k2 = 0, bias = 0                                        
# Mode 2: k3 = -0.0100, k4 = 0, bias = 0                                        
                                                                                
