    N = np.sum(mask)                                                            
    x1, x2, x3, x4 = all_x1[mask], all_x2[mask], all_x3[mask], all_x4[mask]     
    x3_dot, x4_dot = all_x3_dot[mask], all_x4_dot[mask]                         
                                                                                
