def fit_shared_coeffs(x1, x2, x3, x4, x3_dot, x4_dot):                          
    N = len(x1)                                                                 
    A = np.zeros((2*N, 4))                                                      
    A[0::2, 0] = x1                                                             
    A[0::2, 1] = x3                                                             
    A[0::2, 2] = 1                                                              
    A[1::2, 0] = x2                                                             
    A[1::2, 1] = x4                                                             
    A[1::2, 3] = 1                                                              
                                                                                
    y = np.zeros(2*N)                                                           
    y[0::2] = x3_dot                                                            
    y[1::2] = x4_dot                                                            
                                                                                
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    # coeffs are [a, b, c, d]                                                   
    return coeffs, np.sum(residuals) if residuals.size > 0 else 0               
                                                                                
