import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
state = data['state']                                                           
x1, x2, x3, x4 = state                                                          
                                                                                
# Define indices for regimes                                                    
# Regime 1: 0 to 7550                                                           
# Regime 2: 7550 to 10000                                                       
idx_split = 7550                                                                
                                                                                
# Mode 1 Dynamics Estimation                                                    
# x3[k+1] = a1*x1[k] + b1*x3[k] + bias1_x3                                      
# x4[k+1] = c1*x2[k] + d1*x4[k] + bias1_x4                                      
                                                                                
def estimate_dynamics(x1, x2, x3, x4, start_idx, end_idx, include_bias=True):   
    # Target values: x3[k+1] and x4[k+1]                                        
    Y3 = x3[start_idx+1 : end_idx+1]                                            
    Y4 = x4[start_idx+1 : end_idx+1]                                            
                                                                                
    # Feature values: x1[k], x3[k] for x3; x2[k], x4[k] for x4                  
    X3 = np.stack([x1[start_idx : end_idx], x3[start_idx : end_idx]], axis=1)   
    X4 = np.stack([x2[start_idx : end_idx], x4[start_idx : end_idx]], axis=1)   
                                                                                
    reg3 = LinearRegression(fit_intercept=include_bias).fit(X3, Y3)             
    reg4 = LinearRegression(fit_intercept=include_bias).fit(X4, Y4)             
                                                                                
    a, b = reg3.coef_                                                           
    bias_x3 = reg3.intercept_ if include_bias else 0                            
    c, d = reg4.coef_                                                           
    bias_x4 = reg4.intercept_ if include_bias else 0                            
                                                                                
    return a, b, bias_x3, c, d, bias_x4                                         
                                                                                
