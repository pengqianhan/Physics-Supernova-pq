import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
state = data['state'] # (4, 10001)                                              
# Transpose to (10001, 4)                                                       
state = state.T                                                                 
dt = 0.001                                                                      
t = np.arange(state.shape[0]) * dt                                              
                                                                                
x1, x2, x3, x4 = state[:, 0], state[:, 1], state[:, 2], state[:, 3]             
                                                                                
# Calculate derivatives                                                         
dx1 = np.gradient(x1, dt)                                                       
dx2 = np.gradient(x2, dt)                                                       
dx3 = np.gradient(x3, dt)                                                       
dx4 = np.gradient(x4, dt)                                                       
                                                                                
# Verify x1' = x3 and x2' = x4                                                  
print(f"Mean abs error dx1 - x3: {np.mean(np.abs(dx1 - x3))}")                  
print(f"Mean abs error dx2 - x4: {np.mean(np.abs(dx2 - x4))}")                  
                                                                                
# Identify jump in dx3 or dx4 around t=7.55                                     
# Using central difference for second derivative to find spike                  
d2x3 = np.abs(np.diff(dx3) / dt)                                                
jump_idx = np.argmax(d2x3[7000:8000]) + 7000                                    
print(f"Jump index: {jump_idx}, Time: {t[jump_idx]}")                           
                                                                                
# Split data - avoid the immediate vicinity of the jump to reduce noise         
mode1_indices = slice(0, jump_idx - 10)                                         
mode2_indices = slice(jump_idx + 10, None)                                      
                                                                                
def solve_coefficients(indices, target_dx, x_vals_A, x_vals_B):                 
    y = target_dx[indices]                                                      
    X = np.column_stack([x_vals_A[indices], x_vals_B[indices], np.ones_like(y)])
    coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)              
    return coeffs                                                               
                                                                                
# Mode 1                                                                        
m1_x3_coeffs = solve_coefficients(mode1_indices, dx3, x1, x3)                   
m1_x4_coeffs = solve_coefficients(mode1_indices, dx4, x2, x4)                   
                                                                                
# Mode 2                                                                        
m2_x3_coeffs = solve_coefficients(mode2_indices, dx3, x1, x3)                   
m2_x4_coeffs = solve_coefficients(mode2_indices, dx4, x2, x4)                   
                                                                                
# Guard condition: sqrt(x1^2 + x2^2) at jump                                    
dist_at_jump = np.sqrt(x1[jump_idx]**2 + x2[jump_idx]**2)                       
                                                                                
print(f"Mode 1 x3 coeffs (A, B, Bias): {m1_x3_coeffs}")                         
print(f"Mode 1 x4 coeffs (C, D, Bias): {m1_x4_coeffs}")                         
print(f"Mode 2 x3 coeffs (A, B, Bias): {m2_x3_coeffs}")                         
print(f"Mode 2 x4 coeffs (C, D, Bias): {m2_x4_coeffs}")                         
print(f"Distance at jump: {dist_at_jump}")                                      
                                                                                
