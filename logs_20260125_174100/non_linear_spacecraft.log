import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state'] # shape (4, 10001)                                    
    # state[0] is x1, state[1] is x2, state[2] is x3, state[3] is x4            
                                                                                
    # Assume t goes from 0 to 10s based on the prompt's mention of 7.5s.        
    # 10001 points => 10000 intervals. dt = 0.001                               
    dt = 10.0 / 10000.0                                                         
                                                                                
    x1, x2, x3, x4 = state[0], state[1], state[2], state[3]                     
                                                                                
    # Numerical derivatives                                                     
    dx3 = np.diff(x3) / dt                                                      
    dx4 = np.diff(x4) / dt                                                      
                                                                                
    # Find abrupt change in derivatives.                                        
    # Let's look at the second derivative or just the jump.                     
    # We can use the magnitude of the change in dx3/dx4.                        
    d2x3 = np.diff(dx3)                                                         
    d2x4 = np.diff(dx4)                                                         
    jump_mag = np.sqrt(d2x3**2 + d2x4**2)                                       
                                                                                
    transition_idx = np.argmax(jump_mag) + 1 # +1 because of diff               
                                                                                
    # r at transition                                                           
    r_trans = np.sqrt(x1[transition_idx]**2 + x2[transition_idx]**2)            
                                                                                
    return state, transition_idx, r_trans, dt                                   
                                                                                
