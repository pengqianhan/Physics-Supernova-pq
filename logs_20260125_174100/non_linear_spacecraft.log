          B = np.zeros(2*N)                                                     
          for i in range(N):                                                    
              A[2*i] = [X1[i][0], X1[i][1], 1, 0]                               
              B[2*i] = Y3[i]                                                    
              A[2*i+1] = [X2[i][0], X2[i][1], 0, 1]                             
              B[2*i+1] = Y4[i]                                                  
