        f"Mode 2 (t > 7.554s):\n"                                               
        f"  dx3/dt = {a2:.10f}*x1 + {b2:.10f}*x3 + {c2:.10f}\n"                 
        f"  dx4/dt = {a2_alt:.10f}*x2 + {b2_alt:.10f}*x4 + {d2:.10f}\n"         
