import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
def solve():                                                                    
    all_results = []                                                            
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        t = data['t']                                                           
        x = data['x'] # Shape (N, 4)                                            
                                                                                
        dt = t[1] - t[0]                                                        
        x1, x2, x3, x4 = x[:, 0], x[:, 1], x[:, 2], x[:, 3]                     
                                                                                
        # Calculate derivatives                                                 
        dx3 = np.diff(x3) / dt                                                  
        dx4 = np.diff(x4) / dt                                                  
                                                                                
        # Find jump in derivatives to identify mode switch                      
        # We look for the index where the change in derivative is maximum       
        ddx3 = np.abs(np.diff(dx3))                                             
        ddx4 = np.abs(np.diff(dx4))                                             
        jump_idx = np.argmax(ddx3 + ddx4) + 1 # +1 because of double diff       
                                                                                
        # Mode 1: 0 to jump_idx                                                 
        # Mode 2: jump_idx to end                                               
                                                                                
        def fit_mode(start, end):                                               
            # dx[i] is (x[i+1] - x[i]) / dt                                     
            # We match it with features at index i                              
            indices = np.arange(start, end)                                     
            if len(indices) < 5: return None                                    
                                                                                
            # y = X @ beta + b                                                  
            X = np.column_stack([x1[indices], x2[indices], x3[indices],         
x4[indices]])                                                                   
            y3 = (x3[indices+1] - x3[indices]) / dt                             
            y4 = (x4[indices+1] - x4[indices]) / dt                             
                                                                                
            # Use least squares                                                 
            X_bias = np.column_stack([X, np.ones(len(X))])                      
            beta3, _, _, _ = np.linalg.lstsq(X_bias, y3, rcond=None)            
            beta4, _, _, _ = np.linalg.lstsq(X_bias, y4, rcond=None)            
                                                                                
            return beta3, beta4                                                 
                                                                                
        res1 = fit_mode(0, jump_idx)                                            
        res2 = fit_mode(jump_idx, len(t) - 1)                                   
                                                                                
        # Threshold at switch                                                   
        threshold = np.sqrt(x1[jump_idx]**2 + x2[jump_idx]**2)                  
                                                                                
        all_results.append({                                                    
            'mode1': res1,                                                      
            'mode2': res2,                                                      
            'threshold': threshold                                              
        })                                                                      
                                                                                
    # Average results                                                           
    m1_b3 = np.mean([r['mode1'][0] for r in all_results], axis=0)               
    m1_b4 = np.mean([r['mode1'][1] for r in all_results], axis=0)               
    m2_b3 = np.mean([r['mode2'][0] for r in all_results], axis=0)               
    m2_b4 = np.mean([r['mode2'][1] for r in all_results], axis=0)               
    avg_threshold = np.mean([r['threshold'] for r in all_results])              
                                                                                
    return m1_b3, m1_b4, m2_b3, m2_b4, avg_threshold                            
                                                                                
