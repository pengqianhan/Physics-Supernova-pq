import numpy as np                                                              
                                                                                
# Load sample 0                                                                 
data0 = np.load('data_all/non_linear/spacecraft/sample_0.npz')                  
state0 = data0['state']                                                         
T = state0.shape[1]                                                             
                                                                                
# Test 1: Check for r_i(t+1) = r_j(t)                                           
print("Shift test:")                                                            
for i in range(4):                                                              
    for j in range(4):                                                          
        err = np.abs(state0[i, 1:] - state0[j, :-1]).max()                      
        if err < 1e-6:                                                          
            print(f"  state[{i}, t+1] = state[{j}, t] (err={err})")             
                                                                                
# Test 2: Check for r_i(t+1) = r_i(t) + r_j(t)*dt                               
print("Derivative test:")                                                       
for i in range(4):                                                              
    for j in range(4):                                                          
        if i == j: continue                                                     
        diffs = state0[i, 1:] - state0[i, :-1]                                  
        vels = state0[j, :-1]                                                   
        # Only use indices where vels is not too small to avoid division by zero
        mask = np.abs(vels) > 1e-3                                              
        if np.any(mask):                                                        
