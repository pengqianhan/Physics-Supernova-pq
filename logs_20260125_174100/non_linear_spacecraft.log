│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[1\] = -0.5 * x1[0\] + x2[0\], x2[1\] = -0.5 *      │
│ x2[0\] + x3[0\], x3[1\] = -0.5 * x3[0\] + x4[0\], x4[1\] = -0.5 * x4[0\]"    │
│             }                                                                │
│         ],                                                                   │
│         "edge": []                                                           │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.001,                                                         │
│         "total_time": 10.0,                                                  │
│         "order": 1,                                                          │
│         "need_reset": false,                                                 │
│         "non_linear_items": ""                                               │
│     }                                                                        │
│ }                                                                            │
│ ```                                                                          │
