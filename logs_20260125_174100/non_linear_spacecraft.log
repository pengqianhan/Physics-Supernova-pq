            # Let's see the jump.                                               
            print(f"Max R in mode 2: {np.max(R_at_mode2)}")                     
            print(f"Min R in mode 1: {np.min(R_at_transition)}")                
                                                                                
            # Now fit Mode 1: x3[1] = a1*x1[0] + b1*x3[0] + c1                  
