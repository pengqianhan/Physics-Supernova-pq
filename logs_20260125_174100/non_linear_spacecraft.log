import numpy as np                                                              
import scipy.linalg as la                                                       
                                                                                
# 1. Load data                                                                  
samples = [np.load(path)['state'] for path in DATA_FILE_PATHS]                  
                                                                                
results = []                                                                    
r_switches = []                                                                 
                                                                                
for sample_idx, state in enumerate(samples):                                    
    x1, x2, x3, x4 = state[0], state[1], state[2], state[3]                     
                                                                                
    # 2. Identify switch point                                                  
    # Looking for a significant jump in the second derivative of x3 or x4       
    # Compute second order difference for x3                                    
    d2x3 = np.diff(x3, n=2)                                                     
    # The jump is typically the point with maximum absolute second difference   
    # because of the discrete mode switch.                                      
    idx_s = np.argmax(np.abs(d2x3)) + 1                                         
                                                                                
    r = np.sqrt(x1**2 + x2**2)                                                  
    r_s = r[idx_s]                                                              
    r_switches.append(r_s)                                                      
                                                                                
    results.append({                                                            
        'idx_s': idx_s,                                                         
        'r_s': r_s,                                                             
        'x1': x1, 'x2': x2, 'x3': x3, 'x4': x4                                  
    })                                                                          
                                                                                
# Average threshold r_th                                                        
r_th = np.mean(r_switches)                                                      
                                                                                
# 3. Fit coefficients for both modes                                            
# Define a helper function to fit Mode 1 and Mode 2 equations                   
def solve_coeffs(x1_vals, x2_vals, x3_vals, x4_vals):                           
    # Equations:                                                                
    # x3[i+1] = a*x1[i] + b*x3[i] + c                                           
    # x4[i+1] = a*x2[i] + b*x4[i] + d                                           
                                                                                
    # Mode 1 data                                                               
    # Matrix A for linear system A*coeffs = B                                   
    # coeffs = [a, b, c, d]                                                     
    # We combine both equations to get a better fit                             
    # Row for x3: [x1[i], x3[i], 1, 0] * [a, b, c, d]^T = x3[i+1]               
    # Row for x4: [x2[i], x4[i], 0, 1] * [a, b, c, d]^T = x4[i+1]               
                                                                                
    A_mat = []                                                                  
    B_vec = []                                                                  
                                                                                
    for i in range(len(x1_vals) - 1):                                           
        # x3 transition                                                         
        A_mat.append([x1_vals[i], x3_vals[i], 1, 0])                            
        B_vec.append(x3_vals[i+1])                                              
        # x4 transition                                                         
        A_mat.append([x2_vals[i], x4_vals[i], 0, 1])                            
        B_vec.append(x4_vals[i+1])                                              
                                                                                
    A_mat = np.array(A_mat)                                                     
    B_vec = np.array(B_vec)                                                     
                                                                                
    # Solve using least squares                                                 
    coeffs, _, _, _ = la.lstsq(A_mat, B_vec)                                    
    return coeffs                                                               
                                                                                
