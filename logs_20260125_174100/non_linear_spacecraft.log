def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1, x2, x3, x4 = state[0], state[1], state[2], state[3]                     
                                                                                
    # Simple numerical derivative (assuming dt=1 for index-based, or we can find
a better dt)                                                                    
    # Actually, let's look at the switching condition r = sqrt(x1^2 + x2^2)     
    r = np.sqrt(x1**2 + x2**2)                                                  
                                                                                
    # x3' and x4'                                                               
    dx3 = np.diff(x3)                                                           
    dx4 = np.diff(x4)                                                           
                                                                                
    # Look for changes in the dynamics.                                         
    # Mode 1: x3' = a1*x1 + b1*x3                                               
    # Mode 2: x3' = a2*x1 + b2*x3                                               
    # We can calculate the residuals of a linear fit or look for a jump in (dx3 
- (a*x1 + b*x3))                                                                
    # or just look for where r crosses some threshold.                          
                                                                                
    return x1, x2, x3, x4, r, dx3, dx4                                          
                                                                                
# Analyze first sample                                                          
