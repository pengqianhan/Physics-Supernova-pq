# Let's try to fit a model to the left and right of every point in a window and 
find the best split.                                                            
candidates = np.where((R_s > 842.7) & (R_s < 842.9))[0]                         
best_split_idx = -1                                                             
min_total_error = float('inf')                                                  
                                                                                
for idx in candidates:                                                          
