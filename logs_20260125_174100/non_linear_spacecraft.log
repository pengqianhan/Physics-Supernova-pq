import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def process_file(path):                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    # state is (4, 10001)                                                       
    x1, x2, x3, x4 = state[0], state[1], state[2], state[3]                     
    dt = 0.001                                                                  
                                                                                
    # Derivatives                                                               
    dx3 = (x3[1:] - x3[:-1]) / dt                                               
    dx4 = (x4[1:] - x4[:-1]) / dt                                               
                                                                                
    # Features                                                                  
    # We use x1, x3 for dx3; x2, x4 for dx4.                                    
    # To find a, b common to both:                                              
    # Y = [dx3, dx4]                                                            
    # X = [[x1, x3], [x2, x4]]                                                  
                                                                                
    dist = np.sqrt(x1**2 + x2**2)[:-1]                                          
                                                                                
    return x1[:-1], x2[:-1], x3[:-1], x4[:-1], dx3, dx4, dist                   
                                                                                
