import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
state = data['state']                                                           
# state shape is (4, 10001)                                                     
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
x3 = state[2, :]                                                                
x4 = state[3, :]                                                                
                                                                                
# 1. Determine dt                                                               
# x1_dot approx x3 -> (x1[k+1] - x1[k]) / dt = x3[k]                            
# Let's average a few points to be sure                                         
dt_estimates = (x1[1:100] - x1[0:99]) / x3[0:99]                                
dt = np.mean(dt_estimates)                                                      
print(f"Estimated dt: {dt}")                                                    
                                                                                
# 2. Identify switching point                                                   
# Check derivatives of x3 and x4                                                
dx3 = np.diff(x3) / dt                                                          
dx4 = np.diff(x4) / dt                                                          
                                                                                
# Look for discontinuity in the derivative of x3 and x4 (acceleration jump)     
# We look for a jump in the derivatives                                         
jump3 = np.diff(dx3)                                                            
jump4 = np.diff(dx4)                                                            
jump_mag = np.sqrt(jump3**2 + jump4**2)                                         
# The switch happens where the dynamics change                                  
