      x_tp1 = state[:, 1:]                                                      
                                                                                
      # Differences                                                             
      dy = (x_tp1 - x_t) / dt                                                   
                                                                                
      # R at time t                                                             
      r_t = np.sqrt(x_t[0, :]**2 + x_t[1, :]**2)                                
                                                                                
      X_list.append(x_t.T)                                                      
      Y_list.append(dy.T)                                                       
      R_list.append(r_t)                                                        
                                                                                
  X_all = np.concatenate(X_list, axis=0)                                        
  Y_all = np.concatenate(Y_list, axis=0)                                        
  R_all = np.concatenate(R_list, axis=0)                                        
                                                                                
