import numpy as np                                                              
                                                                                
# Load all files and check R ranges                                             
data_files = ['data_all/non_linear/spacecraft/sample_0.npz',                    
'data_all/non_linear/spacecraft/sample_1.npz',                                  
'data_all/non_linear/spacecraft/sample_2.npz']                                  
                                                                                
for i, f in enumerate(data_files):                                              
    data = np.load(f)                                                           
    state = data['state']                                                       
    r = np.sqrt(state[0, :]**2 + state[1, :]**2)                                
    print(f"File {i} R range: {r.min():.2f} to {r.max():.2f}")                  
                                                                                
# Re-evaluating dt accurately                                                   
data = np.load(data_files[0])                                                   
state = data['state']                                                           
# We know dx1/dt = x3. Let's find dt such that x1[t+1] - x1[t] = dt * x3[t]     
# Using many points to average out noise                                        
dts = []                                                                        
for i in range(100):                                                            
    if abs(state[2, i]) > 0.1:                                                  
        dts.append((state[0, i+1] - state[0, i]) / state[2, i])                 
dt = np.median(dts)                                                             
print(f"Determined dt: {dt}")                                                   
                                                                                
# Collect all data                                                              
all_x = []                                                                      
all_dot_x = []                                                                  
                                                                                
for f in data_files:                                                            
    data = np.load(f)                                                           
    s = data['state'].T # (N, 4)                                                
    all_x.append(s)                                                             
    # 2nd order central difference for better acceleration estimation           
    dx3 = np.gradient(s[:, 2], dt)                                              
    dx4 = np.gradient(s[:, 3], dt)                                              
    all_dot_x.append(np.stack([dx3, dx4], axis=1))                              
                                                                                
X_data = np.concatenate(all_x)                                                  
Y_data = np.concatenate(all_dot_x)                                              
R_data = np.sqrt(X_data[:, 0]**2 + X_data[:, 1]**2)                             
                                                                                
# Find r_star. Let's look at (dot_x3 / x1) vs R.                                
# In Mode 1: dot_x3 approx a1*x1 + ...                                          
# In Mode 2: dot_x3 approx a2*x1 + ...                                          
ratio = Y_data[:, 0] / X_data[:, 0]                                             
# Sort by R                                                                     
sort_idx = np.argsort(R_data)                                                   
r_sorted = R_data[sort_idx]                                                     
ratio_sorted = ratio[sort_idx]                                                  
                                                                                
# Detect jump in ratio                                                          
diffs = np.abs(np.diff(ratio_sorted))                                           
jump_idx = np.argmax(diffs)                                                     
r_star = r_sorted[jump_idx]                                                     
print(f"Detected r_star: {r_star}")                                             
                                                                                
# Regression for identified modes                                               
def get_params(mask):                                                           
    if not np.any(mask): return None                                            
    # X_mat: [x1, x2, x3, x4, 1]                                                
    X_mat = np.column_stack([X_data[mask, :4], np.ones(np.sum(mask))])          
    # Fit dot_x3                                                                
    c3, _, _, _ = np.linalg.lstsq(X_mat, Y_data[mask, 0], rcond=None)           
    # Fit dot_x4                                                                
    c4, _, _, _ = np.linalg.lstsq(X_mat, Y_data[mask, 1], rcond=None)           
    return c3, c4                                                               
                                                                                
# We'll test a clean threshold near the detected jump                           
r_star_clean = round(r_star / 5) * 5 # Rounding to nearest 5 or 10              
if abs(r_star_clean - r_star) > 10: r_star_clean = r_star                       
                                                                                
params1 = get_params(R_data > r_star_clean)                                     
params2 = get_params(R_data <= r_star_clean)                                    
                                                                                
if params1:                                                                     
    print(f"Mode 1 coeffs (> {r_star_clean}):")                                 
    print(f"a-e: {params1[0]}")                                                 
    print(f"f-j: {params1[1]}")                                                 
if params2:                                                                     
    print(f"Mode 2 coeffs (<= {r_star_clean}):")                                
