import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state'].T                                                     
    dt = 0.001                                                                  
    n = state.shape[0]                                                          
                                                                                
    x1, x2, x3, x4 = state[:, 0], state[:, 1], state[:, 2], state[:, 3]         
    dx3 = np.gradient(x3, dt)                                                   
    dx4 = np.gradient(x4, dt)                                                   
                                                                                
    # Search for switch between 7.0 and 8.0s                                    
    search_start, search_end = 7000, 8000                                       
    ddx3 = np.abs(np.diff(dx3))                                                 
    jump_idx = np.argmax(ddx3[search_start:search_end]) + search_start + 1      
                                                                                
    dist = np.sqrt(x1**2 + x2**2)                                               
    return jump_idx, dist[jump_idx], x1, x2, x3, x4, dx3, dx4                   
                                                                                
# Check consistency on multiple files                                           
for i in range(3):                                                              
    idx, d_switch, x1, x2, x3, x4, dx3, dx4 = analyze_sample(DATA_FILE_PATHS[i])
    print(f"File {i}: Switch Index={idx}, Time={idx*0.001:.3f},                 
Dist={d_switch:.4f}")                                                           
                                                                                
# Using the first file for final coefficients                                   
jump_idx, guard_threshold, x1, x2, x3, x4, dx3, dx4 =                           
analyze_sample(DATA_FILE_PATHS[0])                                              
n = len(x1)                                                                     
                                                                                
def get_coeffs(idx_range, target_dx, v_main, v_deriv):                          
    Y = target_dx[idx_range]                                                    
    X = np.column_stack([v_main[idx_range], v_deriv[idx_range],                 
np.ones_like(Y)])                                                               
    c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                              
    return c                                                                    
                                                                                
# Buffer to avoid switch artifacts                                              
buf = 50                                                                        
m1_range = np.arange(buf, jump_idx - buf)                                       
m2_range = np.arange(jump_idx + buf, n - buf)                                   
                                                                                
