  for idx in candidates:                                                        
      # Split at R_s[idx]                                                       
      # Mode 2 is R <= threshold, Mode 1 is R > threshold                       
      # So left part is Mode 2, right part is Mode 1                            
      X_m2 = X_s[:idx+1]                                                        
      Y_m2 = Y_s[:idx+1, 2:] # x3 and x4                                        
      X_m1 = X_s[idx+1:]                                                        
      Y_m1 = Y_s[idx+1:, 2:]                                                    
                                                                                
      if len(X_m2) < 10 or len(X_m1) < 10: continue                             
                                                                                
      # Regression for M2                                                       
      A_m2 = np.column_stack([X_m2, np.ones(len(X_m2))])                        
      res_m2 = np.linalg.lstsq(A_m2, Y_m2, rcond=None)                          
      err_m2 = np.sum(res_m2[1])                                                
                                                                                
      # Regression for M1                                                       
      A_m1 = np.column_stack([X_m1, np.ones(len(X_m1))])                        
      res_m1 = np.linalg.lstsq(A_m1, Y_m1, rcond=None)                          
      err_m1 = np.sum(res_m1[1])                                                
                                                                                
      total_err = err_m1 + err_m2                                               
      if total_err < min_total_error:                                           
          min_total_error = total_err                                           
          best_split_idx = idx                                                  
                                                                                
  R_crit = R_s[best_split_idx]                                                  
  print(f"Refined R_crit: {R_crit}")                                            
                                                                                
  # Final regressions                                                           
  X_m2_final = X_s[:best_split_idx+1]                                           
  Y_m2_final = Y_s[:best_split_idx+1, 2:]                                       
  X_m1_final = X_s[best_split_idx+1:]                                           
  Y_m1_final = Y_s[best_split_idx+1:, 2:]                                       
                                                                                
  A_m1 = np.column_stack([X_m1_final, np.ones(len(X_m1_final))])                
  coeffs_m1 = np.linalg.lstsq(A_m1, Y_m1_final, rcond=None)[0]                  
                                                                                
  A_m2 = np.column_stack([X_m2_final, np.ones(len(X_m2_final))])                
  coeffs_m2 = np.linalg.lstsq(A_m2, Y_m2_final, rcond=None)[0]                  
                                                                                
  print("Mode 1 Coeffs (M1):", coeffs_m1)                                       
  print("Mode 2 Coeffs (M2):", coeffs_m2)                                       
