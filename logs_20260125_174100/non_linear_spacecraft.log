import numpy as np                                                              
                                                                                
def solve():                                                                    
    # Load sample 0                                                             
    data0 = np.load('data_all/non_linear/spacecraft/sample_0.npz')              
    state0 = data0['state']                                                     
    # Based on previous observation, state shape is (4, T)                      
    x1, x2, x3, x4 = state0                                                     
    T = state0.shape[1]                                                         
                                                                                
    # Check shift relations                                                     
    err1 = np.abs(x1[1:] - x3[:-1]).max()                                       
    err2 = np.abs(x2[1:] - x4[:-1]).max()                                       
    print(f"Shift errors: {err1}, {err2}")                                      
                                                                                
    # R values                                                                  
    R = np.sqrt(x1**2 + x2**2)                                                  
                                                                                
    # Mode 2: x3[t+1] = a2*x1[t] + b2*x3[t]                                     
    # Use the last 100 points to fit Mode 2 (assuming it ends in Mode 2)        
    def fit_mode2(indices):                                                     
        if len(indices) < 2: return None                                        
        # x3[t+1] = a2*x1[t] + b2*x3[t]                                         
        # x4[t+1] = a2*x2[t] + b2*x4[t]                                         
        Y = np.concatenate([x3[indices+1], x4[indices+1]])                      
        X = np.zeros((len(indices)*2, 2))                                       
        X[:len(indices), 0] = x1[indices]                                       
        X[:len(indices), 1] = x3[indices]                                       
        X[len(indices):, 0] = x2[indices]                                       
        X[len(indices):, 1] = x4[indices]                                       
        coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                     
        return coeffs                                                           
                                                                                
    # Find the transition point by looking for where the Mode 2 model starts to 
fail                                                                            
    # or just try thresholds. Let's look at R.                                  
    print(f"R range: {R.min()} to {R.max()}")                                   
                                                                                
    # Check a few points at the end                                             
    end_indices = np.arange(T-101, T-1)                                         
    a2, b2 = fit_mode2(end_indices)                                             
    print(f"Mode 2 candidate: a2={a2}, b2={b2}")                                
                                                                                
    # Calculate error for Mode 2 across all points                              
    err_m2 = []                                                                 
    for t in range(T-1):                                                        
        pred3 = a2*x1[t] + b2*x3[t]                                             
        pred4 = a2*x2[t] + b2*x4[t]                                             
        err_m2.append(max(abs(x3[t+1]-pred3), abs(x4[t+1]-pred4)))              
    err_m2 = np.array(err_m2)                                                   
                                                                                
    # Threshold identification                                                  
    # Where does Mode 2 error jump?                                             
    m2_active = err_m2 < 1e-6                                                   
    # R[t] values where Mode 2 is active                                        
    R_active = R[:-1][m2_active]                                                
    R_inactive = R[:-1][~m2_active]                                             
                                                                                
    threshold = (R_active.max() + R_inactive.min()) / 2                         
    print(f"Estimated threshold: {threshold}")                                  
    print(f"R_active max: {R_active.max()}, R_inactive min: {R_inactive.min()}")
                                                                                
    # Fit Mode 1                                                                
    m1_indices = np.where(R[:-1] > threshold)[0]                                
    def fit_mode1(indices):                                                     
        # x3[t+1] = a1*x1[t] + b1*x3[t] + c1                                    
        # x4[t+1] = a1*x2[t] + b1*x4[t] + d1                                    
        # target = [x3_next, x4_next]                                           
        # features = [[x1, x3, 1, 0], [x2, x4, 0, 1]]                           
        n = len(indices)                                                        
        Y = np.concatenate([x3[indices+1], x4[indices+1]])                      
        X = np.zeros((2*n, 4))                                                  
        X[:n, 0] = x1[indices]                                                  
        X[:n, 1] = x3[indices]                                                  
        X[:n, 2] = 1.0                                                          
        X[n:, 0] = x2[indices]                                                  
        X[n:, 1] = x4[indices]                                                  
        X[n:, 3] = 1.0                                                          
        coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                     
        return coeffs                                                           
                                                                                
    a1, b1, c1, d1 = fit_mode1(m1_indices)                                      
    print(f"Mode 1: a1={a1}, b1={b1}, c1={c1}, d1={d1}")                        
                                                                                
    return a1, b1, c1, d1, a2, b2, threshold                                    
                                                                                
a1, b1, c1, d1, a2, b2, threshold = solve()                                     
                                                                                
