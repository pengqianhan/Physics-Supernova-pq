# 6. Estimate coefficients                                                      
# Mode A: Before switch (indices 0 to switch_idx-1)                             
# Mode B: After switch (indices switch_idx to end)                              
                                                                                
def fit_mode(idx_start, idx_end):                                               
    # dx is calculated from i to i+1, so for state indices idx_start to idx_end,
    # we use derivatives idx_start to idx_end-1                                 
    x1_part = x1[idx_start:idx_end]                                             
    x2_part = x2[idx_start:idx_end]                                             
    x3_part = x3[idx_start:idx_end]                                             
    x4_part = x4[idx_start:idx_end]                                             
    dx3_part = dx3[idx_start:idx_end]                                           
    dx4_part = dx4[idx_start:idx_end]                                           
                                                                                
