from sklearn.linear_model import LinearRegression                               
import numpy as np                                                              
                                                                                
def fit_mode(states_list, dt):                                                  
    # X = [x1, x3], Y = dx3/dt                                                  
    # X = [x2, x4], Y = dx4/dt                                                  
    X_data = []                                                                 
    Y_data = []                                                                 
                                                                                
    for state in states_list:                                                   
        x1, x2, x3, x4 = state                                                  
        dx3 = np.diff(x3) / dt                                                  
        dx4 = np.diff(x4) / dt                                                  
                                                                                
        # Use x1, x3 to predict dx3                                             
        for i in range(len(dx3)):                                               
            X_data.append([x1[i], x3[i]])                                       
            Y_data.append(dx3[i])                                               
                                                                                
        # Use x2, x4 to predict dx4                                             
        for i in range(len(dx4)):                                               
            X_data.append([x2[i], x4[i]])                                       
            Y_data.append(dx4[i])                                               
                                                                                
    X_data = np.array(X_data)                                                   
    Y_data = np.array(Y_data)                                                   
                                                                                
    model = LinearRegression()                                                  
    model.fit(X_data, Y_data)                                                   
                                                                                
    k1, k2 = model.coef_                                                        
    bias = model.intercept_                                                     
    return k1, k2, bias                                                         
                                                                                
mode1_states = []                                                               
mode2_states = []                                                               
radii_at_transition = []                                                        
                                                                                
for sample in data_samples:                                                     
    state = sample['state']                                                     
    x1, x2, x3, x4 = state                                                      
                                                                                
    # Use second derivative to find transition                                  
    dx3 = np.diff(x3) / dt                                                      
    ddx3 = np.diff(dx3) / dt                                                    
    t_idx = np.argmax(np.abs(ddx3)) + 1 # +1 because of double diff             
                                                                                
    mode1_states.append(state[:, :t_idx])                                       
    mode2_states.append(state[:, t_idx:])                                       
                                                                                
    r = np.sqrt(x1[t_idx]**2 + x2[t_idx]**2)                                    
    radii_at_transition.append(r)                                               
                                                                                
k1_m1, k2_m1, bias_m1 = fit_mode(mode1_states, dt)                              
k1_m2, k2_m2, bias_m2 = fit_mode(mode2_states, dt)                              
