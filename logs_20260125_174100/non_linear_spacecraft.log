import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
dt = 0.001                                                                      
data_files = DATA_FILE_PATHS[:3]                                                
                                                                                
all_x = []                                                                      
all_dx = []                                                                     
all_r = []                                                                      
                                                                                
for file_path in data_files:                                                    
    data = np.load(file_path)                                                   
    # Assuming the file contains an array named 'X' or similar.                 
    # Let's check keys first.                                                   
    if 'data' in data:                                                          
        X = data['data']                                                        
    elif 'x' in data:                                                           
        X = data['x']                                                           
    else:                                                                       
        # Check first key                                                       
        X = data[list(data.keys())[0]]                                          
                                                                                
    # X shape is likely (T, 4)                                                  
    all_x.append(X[:-1]) # State at t                                           
    dx = (X[1:] - X[:-1]) / dt                                                  
    all_dx.append(dx)                                                           
                                                                                
    r = np.sqrt(X[:-1, 0]**2 + X[:-1, 1]**2)                                    
    all_r.append(r)                                                             
                                                                                
X_concat = np.concatenate(all_x, axis=0)                                        
DX_concat = np.concatenate(all_dx, axis=0)                                      
R_concat = np.concatenate(all_r, axis=0)                                        
                                                                                
# Check for transition by looking at jumps in DX3/DX4                           
# and seeing if they correlate with R.                                          
# Let's plot or analyze the relationship between R and DX.                      
# Or just try to find the threshold by looking at the data.                     
                                                                                
import matplotlib.pyplot as plt                                                 
plt.figure(figsize=(10,6))                                                      
plt.scatter(R_concat, DX_concat[:, 2], s=1, label='dx3')                        
plt.scatter(R_concat, DX_concat[:, 3], s=1, label='dx4')                        
plt.xlabel('R')                                                                 
plt.ylabel('dx')                                                                
plt.legend()                                                                    
plt.savefig('dx_vs_r.png')                                                      
                                                                                
# It's likely a sharp transition at some R.                                     
# Let's look for a jump.                                                        
sorted_indices = np.argsort(R_concat)                                           
R_sorted = R_concat[sorted_indices]                                             
DX3_sorted = DX_concat[sorted_indices, 2]                                       
                                                                                
# Detect jump in DX3/DX4 relative to X1, X3 etc.                                
# Actually, since we have 2 modes, we can try to find R_crit by                 
# sweeping potential thresholds and minimizing regression error.                
                                                                                
def evaluate_threshold(r_thresh, R, X, DX):                                     
    mask1 = R < r_thresh                                                        
    mask2 = R >= r_thresh                                                       
                                                                                
    if np.sum(mask1) < 10 or np.sum(mask2) < 10:                                
        return float('inf')                                                     
                                                                                
    def get_error(mask):                                                        
        if np.sum(mask) == 0: return 0                                          
        # Target: DX3, DX4                                                      
        # Features: X1, X3 (for DX3) and X2, X4 (for DX4)                       
        # Shared a, b? x3_dot = a*x1 + b*x3 + c; x4_dot = a*x2 + b*x4 + d       
                                                                                
        # We can treat x3 and x4 independently or together.                     
        # Let's do independent first to see if a, b are similar.                
        reg3 = LinearRegression().fit(X[mask][:, [0, 2]], DX[mask, 2])          
        reg4 = LinearRegression().fit(X[mask][:, [1, 3]], DX[mask, 3])          
        err = np.sum((reg3.predict(X[mask][:, [0, 2]]) - DX[mask, 2])**2) + \   
              np.sum((reg4.predict(X[mask][:, [1, 3]]) - DX[mask, 3])**2)       
        return err, reg3.coef_, reg3.intercept_, reg4.coef_, reg4.intercept_    
                                                                                
    err1, c3_1, i3_1, c4_1, i4_1 = get_error(mask1)                             
    err2, c3_2, i3_2, c4_2, i4_2 = get_error(mask2)                             
    return err1 + err2                                                          
                                                                                
thresholds = np.linspace(np.percentile(R_concat, 5), np.percentile(R_concat,    
95), 50)                                                                        
errors = [evaluate_threshold(t, R_concat, X_concat, DX_concat) for t in         
thresholds]                                                                     
best_r_crit = thresholds[np.argmin(errors)]                                     
                                                                                
print(f"Best R_crit: {best_r_crit}")                                            
                                                                                
# Now get final coefficients for the best R_crit                                
mask1 = R_concat < best_r_crit                                                  
mask2 = R_concat >= best_r_crit                                                 
                                                                                
def fit_mode(mask):                                                             
    # dx3 = a*x1 + b*x3 + bias3                                                 
    # dx4 = a*x2 + b*x4 + bias4                                                 
    # Combined fit to force shared a and b                                      
    # Y = [dx3; dx4]                                                            
