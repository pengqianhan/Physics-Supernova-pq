    # Use forward difference for derivatives                                    
    # dx3(t) = (x3(t+dt) - x3(t)) / dt                                          
    dx3 = (x3[1:] - x3[:-1]) / dt                                               
    dx4 = (x4[1:] - x4[:-1]) / dt                                               
                                                                                
    all_x1.extend(x1[:-1])                                                      
