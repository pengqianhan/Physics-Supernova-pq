  sort_idx = np.argsort(R_all)                                                  
  R_sorted = R_all[sort_idx]                                                    
  err_sorted = err[sort_idx]                                                    
                                                                                
  # Search in a narrow window around R_crit                                     
  search_mask = (R_sorted > 842.0) & (R_sorted < 843.5)                         
  R_search = R_sorted[search_mask]                                              
  err_search = err_sorted[search_mask]                                          
                                                                                
  # Jump is where error increases as R decreases                                
  # Let's find index where the jump occurs                                      
  jump_idx = np.argmax(np.abs(np.diff(err_search)))                             
