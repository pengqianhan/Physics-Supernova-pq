import numpy as np                                                              
from scipy.linalg import lstsq                                                  
                                                                                
dt = 0.001                                                                      
                                                                                
def get_data_for_mode(states, threshold, mode):                                 
    X_list = []                                                                 
    Y_list = []                                                                 
    for s in states:                                                            
        r = np.sqrt(s[0, :-1]**2 + s[1, :-1]**2)                                
        if mode == 1:                                                           
            idx = np.where(r >= threshold)[0]                                   
        else:                                                                   
            idx = np.where(r < threshold)[0]                                    
                                                                                
        if len(idx) > 0:                                                        
            # state at k                                                        
            xk = s[:, idx]                                                      
            # state at k+1                                                      
            xkp1 = s[:, idx + 1]                                                
                                                                                
            # derivatives at k                                                  
            dx = (xkp1 - xk) / dt                                               
                                                                                
            # Using midpoint for regression can be more accurate                
            x_mid = (xk + xkp1) / 2.0                                           
                                                                                
            X_list.append(x_mid)                                                
            Y_list.append(dx[2:]) # only x3', x4'                               
                                                                                
    return np.concatenate(X_list, axis=1), np.concatenate(Y_list, axis=1)       
                                                                                
def joint_fit(X, Y):                                                            
    # X: (4, N), Y: (2, N)                                                      
    # Equations:                                                                
    # x3' = a*x1 + b*x3 + c                                                     
    # x4' = a*x2 + b*x4 + d                                                     
    # Target vector: [x3'_1, x4'_1, x3'_2, x4'_2, ..., x3'_N, x4'_N]            
    # Matrix:                                                                   
    # [x1_1, x3_1, 1, 0]                                                        
    # [x2_1, x4_1, 0, 1]                                                        
    # ...                                                                       
    N = X.shape[1]                                                              
    A = np.zeros((2*N, 4))                                                      
    b = np.zeros(2*N)                                                           
    for i in range(N):                                                          
        A[2*i] = [X[0, i], X[2, i], 1, 0]                                       
        A[2*i+1] = [X[1, i], X[3, i], 0, 1]                                     
        b[2*i] = Y[0, i]                                                        
        b[2*i+1] = Y[1, i]                                                      
                                                                                
    sol, resid, rank, s = lstsq(A, b)                                           
    return sol # [a, b, c, d]                                                   
                                                                                
