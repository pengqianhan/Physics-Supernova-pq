import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
state = data['state']                                                           
# Determine orientation                                                         
if state.shape[0] == 4 and state.shape[1] > 4:                                  
    x1, x2, x3, x4 = state[0, :], state[1, :], state[2, :], state[3, :]         
else:                                                                           
    x1, x2, x3, x4 = state[:, 0], state[:, 1], state[:, 2], state[:, 3]         
                                                                                
dt = 0.001                                                                      
t = np.arange(len(x1)) * dt                                                     
                                                                                
# Compute derivatives                                                           
x3_dot = np.gradient(x3, dt)                                                    
x4_dot = np.gradient(x4, dt)                                                    
                                                                                
# Switching condition                                                           
dist = np.sqrt(x1**2 + x2**2)                                                   
# Find transition based on the distance condition                               
threshold_val = 842.81                                                          
transition_indices = np.where(dist <= threshold_val)[0]                         
if len(transition_indices) > 0:                                                 
    switch_idx = transition_indices[0]                                          
else:                                                                           
    # Fallback to the suggested 7.55s                                           
    switch_idx = np.argmin(np.abs(t - 7.55))                                    
                                                                                
switch_time = t[switch_idx]                                                     
switch_dist = dist[switch_idx]                                                  
                                                                                
# Separation                                                                    
m1 = t < switch_time                                                            
m2 = t >= switch_time                                                           
                                                                                
def fit_model(p, v, a):                                                         
    A = np.column_stack([p, v, np.ones_like(p)])                                
    coeffs, _, _, _ = np.linalg.lstsq(A, a, rcond=None)                         
    return coeffs                                                               
                                                                                
# Mode 1 Coefficients                                                           
c3_m1 = fit_model(x1[m1], x3[m1], x3_dot[m1])                                   
c4_m1 = fit_model(x2[m1], x4[m1], x4_dot[m1])                                   
                                                                                
# Mode 2 Coefficients                                                           
c3_m2 = fit_model(x1[m2], x3[m2], x3_dot[m2])                                   
c4_m2 = fit_model(x2[m2], x4[m2], x4_dot[m2])                                   
                                                                                
print(f"Switch Time: {switch_time}")                                            
print(f"Switch Distance: {switch_dist}")                                        
print(f"Mode 1 x3_dot: a1={c3_m1[0]:.6f}, b1={c3_m1[1]:.6f}, c1={c3_m1[2]:.6f}")
print(f"Mode 1 x4_dot: a2={c4_m1[0]:.6f}, b2={c4_m1[1]:.6f}, d1={c4_m1[2]:.6f}")
print(f"Mode 2 x3_dot: a1={c3_m2[0]:.6f}, b1={c3_m2[1]:.6f}, c1={c3_m2[2]:.6f}")
