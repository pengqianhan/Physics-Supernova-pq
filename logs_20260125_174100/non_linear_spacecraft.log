import numpy as np                                                              
                                                                                
# Load data                                                                     
data_files = ['data_all/non_linear/spacecraft/sample_0.npz',                    
'data_all/non_linear/spacecraft/sample_1.npz',                                  
'data_all/non_linear/spacecraft/sample_2.npz']                                  
dt = 0.001                                                                      
                                                                                
all_x, all_dot_x = [], []                                                       
for f in data_files:                                                            
    data = np.load(f)                                                           
    s = data['state'].T                                                         
    all_x.append(s)                                                             
    dx3 = np.gradient(s[:, 2], dt)                                              
    dx4 = np.gradient(s[:, 3], dt)                                              
    all_dot_x.append(np.column_stack([dx3, dx4]))                               
                                                                                
X = np.concatenate(all_x)                                                       
Y = np.concatenate(all_dot_x)                                                   
R = np.sqrt(X[:, 0]**2 + X[:, 1]**2)                                            
                                                                                
# Grid search for r_star                                                        
potential_r = np.linspace(R.min()+5, R.max()-5, 100)                            
best_r = 0                                                                      
min_error = float('inf')                                                        
                                                                                
for r_test in potential_r:                                                      
    m1, m2 = R > r_test, R <= r_test                                            
    if np.sum(m1) < 10 or np.sum(m2) < 10: continue                             
                                                                                
    # Simple error check                                                        
    def get_err(mask):                                                          
        Xm = np.column_stack([X[mask, :4], np.ones(np.sum(mask))])              
        c3, res3, _, _ = np.linalg.lstsq(Xm, Y[mask, 0], rcond=None)            
        c4, res4, _, _ = np.linalg.lstsq(Xm, Y[mask, 1], rcond=None)            
        return (res3[0] if res3.size else 0) + (res4[0] if res4.size else 0)    
                                                                                
    total_error = get_err(m1) + get_err(m2)                                     
    if total_error < min_error:                                                 
        min_error = total_error                                                 
        best_r = r_test                                                         
                                                                                
print(f"Optimal r_star from search: {best_r}")                                  
                                                                                
# Final params with best_r                                                      
def final_fit(mask):                                                            
    Xm = np.column_stack([X[mask, :4], np.ones(np.sum(mask))])                  
    c3, _, _, _ = np.linalg.lstsq(Xm, Y[mask, 0], rcond=None)                   
    c4, _, _, _ = np.linalg.lstsq(Xm, Y[mask, 1], rcond=None)                   
    return c3, c4                                                               
                                                                                
r_star = best_r                                                                 
p1_3, p1_4 = final_fit(R > r_star)                                              
p2_3, p2_4 = final_fit(R <= r_star)                                             
                                                                                
print(f"Mode 1 coeffs (> {r_star}):")                                           
print(f"a-e: {p1_3}")                                                           
print(f"f-j: {p1_4}")                                                           
print(f"Mode 2 coeffs (<= {r_star}):")                                          
print(f"a-e: {p2_3}")                                                           
print(f"f-j: {p2_4}")                                                           
                                                                                
# Check for resets at best_r                                                    
max_jump = 0                                                                    
for f in data_files:                                                            
