def get_data_with_adaptive_dt(states, threshold):                               
    X1_list, Y1_list = [], []                                                   
    X2_list, Y2_list = [], []                                                   
                                                                                
    for s in states:                                                            
        # per-step dt                                                           
        dx1 = s[0, 1:] - s[0, :-1]                                              
        dx2 = s[1, 1:] - s[1, :-1]                                              
        x3_avg = (s[2, 1:] + s[2, :-1]) / 2.0                                   
        x4_avg = (s[3, 1:] + s[3, :-1]) / 2.0                                   
                                                                                
        # dt[k] = (dx1*x3_avg + dx2*x4_avg) / (x3_avg^2 + x4_avg^2)             
        dt_k = (dx1 * x3_avg + dx2 * x4_avg) / (x3_avg**2 + x4_avg**2)          
                                                                                
        dx3 = s[2, 1:] - s[2, :-1]                                              
        dx4 = s[3, 1:] - s[3, :-1]                                              
                                                                                
        y3 = dx3 / dt_k                                                         
        y4 = dx4 / dt_k                                                         
                                                                                
        x_mid = (s[:, :-1] + s[:, 1:]) / 2.0                                    
        r = np.sqrt(s[0]**2 + s[1]**2)                                          
                                                                                
        m1_indices = np.where((r[:-1] >= threshold) & (r[1:] >= threshold))[0]  
        m2_indices = np.where((r[:-1] < threshold) & (r[1:] < threshold))[0]    
                                                                                
        if len(m1_indices) > 0:                                                 
            X1_list.append(x_mid[:, m1_indices])                                
            Y1_list.append(np.vstack([y3[m1_indices], y4[m1_indices]]))         
        if len(m2_indices) > 0:                                                 
            X2_list.append(x_mid[:, m2_indices])                                
            Y2_list.append(np.vstack([y3[m2_indices], y4[m2_indices]]))         
                                                                                
    X1 = np.concatenate(X1_list, axis=1)                                        
    Y1 = np.concatenate(Y1_list, axis=1)                                        
    X2 = np.concatenate(X2_list, axis=1)                                        
    Y2 = np.concatenate(Y2_list, axis=1)                                        
    return X1, Y1, X2, Y2                                                       
                                                                                
