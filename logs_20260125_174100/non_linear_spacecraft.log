    row2 = np.column_stack([X_in[:, 1], X_in[:, 3], np.zeros(len(X_in)),        
np.ones(len(X_in))])                                                            
    X_reg = np.vstack([row1, row2])                                             
                                                                                
    reg = LinearRegression(fit_intercept=False).fit(X_reg, Y)                   
    a, b, bias3, bias4 = reg.coef_                                              
    return a, b, bias3, bias4                                                   
                                                                                
a1, b1, bias3_1, bias4_1 = fit_mode(mask1)                                      
a2, b2, bias3_2, bias4_2 = fit_mode(mask2)                                      
                                                                                
print(f"Mode 1: a={a1}, b={b1}, bias3={bias3_1}, bias4={bias4_1}")              
