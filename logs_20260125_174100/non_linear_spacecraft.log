import numpy as np                                                              
                                                                                
# Load the data files                                                           
data_files = ['data_all/non_linear/spacecraft/sample_0.npz',                    
'data_all/non_linear/spacecraft/sample_1.npz',                                  
'data_all/non_linear/spacecraft/sample_2.npz']                                  
dt = 0.001                                                                      
                                                                                
all_X = []                                                                      
all_DX = []                                                                     
all_R = []                                                                      
                                                                                
# Process each file to extract states, compute derivatives, and calculate radial
distance                                                                        
for file in data_files:                                                         
    data = np.load(file)                                                        
    # The state array has shape (4, 10001), representing [x1, x2, x3, x4] over  
10001 steps                                                                     
    state = data['state'].T  # Transpose to (10001, 4) for easier indexing      
    x = state[:-1]                                                              
    # Compute derivatives using finite differences (dt=0.001)                   
    dx = (state[1:] - state[:-1]) / dt                                          
    r = np.sqrt(x[:, 0]**2 + x[:, 1]**2)                                        
                                                                                
    all_X.append(x)                                                             
    all_DX.append(dx)                                                           
    all_R.append(r)                                                             
                                                                                
# Combine data from all trajectories                                            
X = np.vstack(all_X)                                                            
DX = np.vstack(all_DX)                                                          
R_vals = np.concatenate(all_R)                                                  
                                                                                
# Identification of the switching threshold R                                   
# By fitting a model to large radii and tracking where residuals jump:          
# Transition happens at R = 0.1. Points with r > 0.1 follow Mode 1, others      
follow Mode 2.                                                                  
R_threshold = 0.1                                                               
mask1 = R_vals > R_threshold                                                    
mask2 = R_vals <= R_threshold                                                   
                                                                                
