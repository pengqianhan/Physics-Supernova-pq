# Check shapes                                                                  
print("t shape:", t.shape)                                                      
print("x shape:", x.shape)                                                      
                                                                                
# Identify individual variables                                                 
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
x3 = x[:, 2]                                                                    
x4 = x[:, 3]                                                                    
                                                                                
# Calculate dt                                                                  
dt = t[1] - t[0]                                                                
print("dt:", dt)                                                                
                                                                                
# Find switching index                                                          
switching_time = 7.55                                                           
switch_idx = np.argmin(np.abs(t - switching_time))                              
print("Switch index:", switch_idx, "Time at switch:", t[switch_idx])            
                                                                                
# Calculate derivatives                                                         
# x_dot[i] = (x[i+1] - x[i]) / dt                                               
x3_dot = (x3[1:] - x3[:-1]) / dt                                                
x4_dot = (x4[1:] - x4[:-1]) / dt                                                
                                                                                
# Prepare features for regression (x1, x3 for x3_dot; x2, x4 for x4_dot)        
# We need to slice x1, x2, x3, x4 to match the length of derivatives            
x1_f = x1[:-1]                                                                  
x2_f = x2[:-1]                                                                  
x3_f = x3[:-1]                                                                  
x4_f = x4[:-1]                                                                  
t_f = t[:-1]                                                                    
                                                                                
# Segment 1: t < switching_time                                                 
mask1 = t_f < switching_time                                                    
# Segment 2: t >= switching_time                                                
mask2 = t_f >= switching_time                                                   
                                                                                
def fit_model(y, feat1, feat2):                                                 
    # Model: y = a*feat1 + b*feat2 + bias                                       
    # A * [a, b, bias]^T = y                                                    
    A = np.column_stack([feat1, feat2, np.ones_like(feat1)])                    
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    return coeffs                                                               
                                                                                
# Segment 1 fits                                                                
coeffs_x3_seg1 = fit_model(x3_dot[mask1], x1_f[mask1], x3_f[mask1])             
coeffs_x4_seg1 = fit_model(x4_dot[mask1], x2_f[mask1], x4_f[mask1])             
                                                                                
# Segment 2 fits                                                                
coeffs_x3_seg2 = fit_model(x3_dot[mask2], x1_f[mask2], x3_f[mask2])             
coeffs_x4_seg2 = fit_model(x4_dot[mask2], x2_f[mask2], x4_f[mask2])             
                                                                                
# Guard condition value                                                         
# sqrt(x1^2 + x2^2) at switching time                                           
guard_val = np.sqrt(x1[switch_idx]**2 + x2[switch_idx]**2)                      
                                                                                
print("Segment 1 Coeffs (x3_dot): a, b, bias =", coeffs_x3_seg1)                
print("Segment 1 Coeffs (x4_dot): c, d, bias =", coeffs_x4_seg1)                
print("Segment 2 Coeffs (x3_dot): a, b, bias =", coeffs_x3_seg2)                
