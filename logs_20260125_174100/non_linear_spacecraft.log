  x4 = X_curr[:, 3]                                                             
                                                                                
  # Targets at time t+1                                                         
  y_x3 = Y_target[:, 0]                                                         
  y_x4 = Y_target[:, 1]                                                         
                                                                                
  # Calculate R                                                                 
  R = np.sqrt(x1**2 + x2**2)                                                    
                                                                                
  # Define a function for linear regression using lstsq                         
  def solve_linear(X_data, y_data):                                             
      # Add bias term (constant 1)                                              
      A = np.column_stack([X_data, np.ones(X_data.shape[0])])                   
      # coeffs will be [w1, w2, w3, w4, bias]                                   
      coeffs, residuals, rank, s = np.linalg.lstsq(A, y_data, rcond=None)       
      return coeffs                                                             
                                                                                
  def calculate_mse(X_data, y_data, coeffs):                                    
      # coeffs is [w1, w2, w3, w4, bias]                                        
      # Use np.dot because @ is not allowed                                     
      # prediction = X_data * coeffs[:4] + coeffs[4]                            
      # X_data is (N, 4), coeffs[:4] is (4,)                                    
      pred = np.dot(X_data, coeffs[:-1]) + coeffs[-1]                           
      return np.mean((y_data - pred)**2)                                        
                                                                                
  # Search for R_crit                                                           
  r_min, r_max = np.min(R), np.max(R)                                           
  # Test many candidates to find the transition                                 
  r_candidates = np.linspace(r_min + 0.02*(r_max-r_min), r_max -                
  0.02*(r_max-r_min), 100)                                                      
  best_r_crit = None                                                            
  min_total_mse = float('inf')                                                  
                                                                                
  for r_crit in r_candidates:                                                   
      mask1 = R > r_crit                                                        
      mask2 = R <= r_crit                                                       
                                                                                
      if np.sum(mask1) < 50 or np.sum(mask2) < 50:                              
          continue                                                              
                                                                                
      # Mode 1                                                                  
      X1 = X_curr[mask1]                                                        
      y1_x3 = y_x3[mask1]                                                       
      y1_x4 = y_x4[mask1]                                                       
      sol1_x3 = solve_linear(X1, y1_x3)                                         
      sol1_x4 = solve_linear(X1, y1_x4)                                         
      mse1 = calculate_mse(X1, y1_x3, sol1_x3) + calculate_mse(X1, y1_x4,       
  sol1_x4)                                                                      
                                                                                
      # Mode 2                                                                  
      X2 = X_curr[mask2]                                                        
      y2_x3 = y_x3[mask2]                                                       
      y2_x4 = y_x4[mask2]                                                       
      sol2_x3 = solve_linear(X2, y2_x3)                                         
      sol2_x4 = solve_linear(X2, y2_x4)                                         
      mse2 = calculate_mse(X2, y2_x3, sol2_x3) + calculate_mse(X2, y2_x4,       
  sol2_x4)                                                                      
                                                                                
      total_mse = mse1 + mse2                                                   
      if total_mse < min_total_mse:                                             
          min_total_mse = total_mse                                             
          best_r_crit = r_crit                                                  
                                                                                
  # Final solve with best R_crit                                                
  mask1 = R > best_r_crit                                                       
  mask2 = R <= best_r_crit                                                      
                                                                                
  # Mode 1 coefficients                                                         
  sol1_x3 = solve_linear(X_curr[mask1], y_x3[mask1])                            
  sol1_x4 = solve_linear(X_curr[mask1], y_x4[mask1])                            
                                                                                
  # Mode 2 coefficients                                                         
  sol2_x3 = solve_linear(X_curr[mask2], y_x3[mask2])                            
  sol2_x4 = solve_linear(X_curr[mask2], y_x4[mask2])                            
                                                                                
  print(f"Optimal R_crit: {best_r_crit:.6f}")                                   
  print("Mode 1 (R > R_crit):")                                                 
  print(f"x3[1] = {sol1_x3[0]:.10f}*x1 + {sol1_x3[1]:.10f}*x2 +                 
  {sol1_x3[2]:.10f}*x3 + {sol1_x3[3]:.10f}*x4 + {sol1_x3[4]:.10f}")             
  print(f"x4[1] = {sol1_x4[0]:.10f}*x1 + {sol1_x4[1]:.10f}*x2 +                 
  {sol1_x4[2]:.10f}*x3 + {sol1_x4[3]:.10f}*x4 + {sol1_x4[4]:.10f}")             
  print("\nMode 2 (R <= R_crit):")                                              
  print(f"x3[1] = {sol2_x3[0]:.10f}*x1 + {sol2_x3[1]:.10f}*x2 +                 
  {sol2_x3[2]:.10f}*x3 + {sol2_x3[3]:.10f}*x4 + {sol2_x3[4]:.10f}")             
  print(f"x4[1] = {sol2_x4[0]:.10f}*x1 + {sol2_x4[1]:.10f}*x2 +                 
