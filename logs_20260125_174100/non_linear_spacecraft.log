import numpy as np                                                              
from scipy.optimize import least_squares                                        
                                                                                
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
state = data['state']                                                           
x1, x2, x3, x4 = state                                                          
                                                                                
# Fit for k from 0 to 7000                                                      
K = 7000                                                                        
# Equations:                                                                    
# x3[k+1] = a1*x1[k] + b1*x3[k] + bias_x3                                       
# x4[k+1] = a1*x2[k] + b1*x4[k] + bias_x4                                       
                                                                                
# Constructing the system:                                                      
# [x1[k] x3[k] 1 0] [a1, b1, bias_x3, bias_x4]^T = x3[k+1]                      
# [x2[k] x4[k] 0 1] [a1, b1, bias_x3, bias_x4]^T = x4[k+1]                      
                                                                                
A = []                                                                          
B = []                                                                          
for k in range(K):                                                              
    A.append([x1[k], x3[k], 1, 0])                                              
    B.append(x3[k+1])                                                           
    A.append([x2[k], x4[k], 0, 1])                                              
    B.append(x4[k+1])                                                           
                                                                                
A = np.array(A)                                                                 
B = np.array(B)                                                                 
                                                                                
params, residuals, rank, s = np.linalg.lstsq(A, B, rcond=None)                  
a1, b1, bias_x3, bias_x4 = params                                               
print(f"Fitted parameters: a1={a1}, b1={b1}, bias_x3={bias_x3},                 
bias_x4={bias_x4}")                                                             
                                                                                
# Now calculate residuals for all k                                             
res3 = x3[1:] - (a1 * x1[:-1] + b1 * x3[:-1] + bias_x3)                         
res4 = x4[1:] - (a1 * x2[:-1] + b1 * x4[:-1] + bias_x4)                         
total_res = np.abs(res3) + np.abs(res4)                                         
                                                                                
# Look for the jump in total_res                                                
for i in range(7540, 7560):                                                     
    print(f"Index {i}, Time {i*0.001:.3f}, Total Res={total_res[i]:.5e}")       
                                                                                
