import numpy as np                                                              
                                                                                
def check_mode2_bias(sample_idx, threshold):                                    
    data = np.load(f'data_all/non_linear/spacecraft/sample_{sample_idx}.npz')   
    x1, x2, x3, x4 = data['state']                                              
    dist = np.sqrt(x1**2 + x2**2)                                               
    m2_idx = np.where(dist <= threshold)[0]                                     
    m2_idx = [k for k in m2_idx if k+1 < len(x1) and dist[k+1] <= threshold]    
                                                                                
    Y3 = x3[np.array(m2_idx)+1]                                                 
    X3 = np.stack([x1[m2_idx], x3[m2_idx], np.ones(len(m2_idx))], axis=1)       
    beta3, _, _, _ = np.linalg.lstsq(X3, Y3, rcond=None)                        
                                                                                
    Y4 = x4[np.array(m2_idx)+1]                                                 
    X4 = np.stack([x2[m2_idx], x4[m2_idx], np.ones(len(m2_idx))], axis=1)       
    beta4, _, _, _ = np.linalg.lstsq(X4, Y4, rcond=None)                        
                                                                                
    return beta3, beta4                                                         
                                                                                
print(check_mode2_bias(0, 842.61))                                              
                                                                                
