      all_x1.extend(x1[:-1])                                                    
      all_x2.extend(x2[:-1])                                                    
      all_x3.extend(x3[:-1])                                                    
      all_x4.extend(x4[:-1])                                                    
      all_dx3.extend(dx3)                                                       
      all_dx4.extend(dx4)                                                       
      all_r.extend(np.sqrt(x1[:-1]**2 + x2[:-1]**2))                            
                                                                                
  all_x1 = np.array(all_x1)                                                     
  all_x2 = np.array(all_x2)                                                     
  all_x3 = np.array(all_x3)                                                     
  all_x4 = np.array(all_x4)                                                     
  all_dx3 = np.array(all_dx3)                                                   
  all_dx4 = np.array(all_dx4)                                                   
  all_r = np.array(all_r)                                                       
                                                                                
  threshold = 842.814402635                                                     
                                                                                
  def solve_reg(X, y):                                                          
      A = np.column_stack((X, np.ones(len(y))))                                 
      res = np.linalg.lstsq(A, y, rcond=None)[0]                                
      return res                                                                
                                                                                
  results = {}                                                                  
  for mode_name, mask in [("Mode 1", all_r > threshold), ("Mode 2", all_r <=    
  threshold)]:                                                                  
      if np.any(mask):                                                          
          # dx3 = k1*x1 + k2*x3 + bias_x3                                       
          X_x3 = np.column_stack((all_x1[mask], all_x3[mask]))                  
          res_x3 = solve_reg(X_x3, all_dx3[mask])                               
                                                                                
          # dx4 = k3*x2 + k4*x4 + bias_x4                                       
          X_x4 = np.column_stack((all_x2[mask], all_x4[mask]))                  
          res_x4 = solve_reg(X_x4, all_dx4[mask])                               
                                                                                
          results[mode_name] = {                                                
              'k1': res_x3[0], 'k2': res_x3[1], 'bias_x3': res_x3[2],           
              'k3': res_x4[0], 'k4': res_x4[1], 'bias_x4': res_x4[2]            
          }                                                                     
                                                                                
  print(results)                                                                
