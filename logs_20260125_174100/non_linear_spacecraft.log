m1_x1, m1_x2, m1_x3, m1_x4 = [], [], [], []                                     
m2_x1, m2_x2, m2_x3, m2_x4 = [], [], [], []                                     
                                                                                
for res in results:                                                             
    s = res['idx_s']                                                            
    m1_x1.extend(res['x1'][:s])                                                 
    m1_x2.extend(res['x2'][:s])                                                 
    m1_x3.extend(res['x3'][:s])                                                 
    m1_x4.extend(res['x4'][:s])                                                 
                                                                                
    m2_x1.extend(res['x1'][s:])                                                 
    m2_x2.extend(res['x2'][s:])                                                 
    m2_x3.extend(res['x3'][s:])                                                 
    m2_x4.extend(res['x4'][s:])                                                 
                                                                                
coeffs1 = solve_coeffs(m1_x1, m1_x2, m1_x3, m1_x4)                              
