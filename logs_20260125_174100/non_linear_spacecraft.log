import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
t = data['t']                                                                   
x = data['x']  # Assuming x has columns x1, x2, x3, x4                          
                                                                                
dt = 0.001                                                                      
                                                                                
# x1, x2, x3, x4                                                                
x1, x2, x3, x4 = x[:, 0], x[:, 1], x[:, 2], x[:, 3]                             
                                                                                
# Compute derivatives using central difference                                  
x1_dot = np.gradient(x1, dt)                                                    
x2_dot = np.gradient(x2, dt)                                                    
x3_dot = np.gradient(x3, dt)                                                    
x4_dot = np.gradient(x4, dt)                                                    
                                                                                
# Identify switching point                                                      
dist = np.sqrt(x1**2 + x2**2)                                                   
# The condition is dist <= 842.81. Let's find where it crosses.                 
# Previous feedback suggests t approx 7.55s.                                    
# Let's find the index where t is closest to 7.55s or check the condition.      
mode1_mask = t < 7.55                                                           
mode2_mask = t >= 7.55                                                          
                                                                                
# Define a function to fit the models                                           
def fit_model(X_sub, x_dot_sub, vars_indices, const_index):                     
    # Model: x_dot = a*x_var + b*x_dot_var + c                                  
    # For x3': vars=[x1, x3]                                                    
    # For x4': vars=[x2, x4]                                                    
                                                                                
    # We need to solve for coefficients                                         
    # y = [x_var, x_dot_var, 1] @ [a, b, c]^T                                   
                                                                                
    A = np.column_stack([X_sub[:, vars_indices[0]], X_sub[:, vars_indices[1]],  
np.ones(len(X_sub))])                                                           
    coeffs, residuals, rank, s = np.linalg.lstsq(A, x_dot_sub, rcond=None)      
    return coeffs                                                               
                                                                                
# Mode 1 Fitting                                                                
mode1_x = x[mode1_mask]                                                         
mode1_x3_dot = x3_dot[mode1_mask]                                               
mode1_x4_dot = x4_dot[mode1_mask]                                               
                                                                                
coeffs_x3_m1 = fit_model(mode1_x, mode1_x3_dot, [0, 2], None) # a1, b1, c1      
coeffs_x4_m1 = fit_model(mode1_x, mode1_x4_dot, [1, 3], None) # a2, b2, d1      
                                                                                
# Mode 2 Fitting                                                                
mode2_x = x[mode2_mask]                                                         
mode2_x3_dot = x3_dot[mode2_mask]                                               
mode2_x4_dot = x4_dot[mode2_mask]                                               
                                                                                
coeffs_x3_m2 = fit_model(mode2_x, mode2_x3_dot, [0, 2], None) # a1, b1, c1      
coeffs_x4_m2 = fit_model(mode2_x, mode2_x4_dot, [1, 3], None) # a2, b2, d1      
                                                                                
# Switching threshold                                                           
# At t approx 7.55                                                              
idx_transition = np.argmin(np.abs(t - 7.55))                                    
threshold_val = dist[idx_transition]                                            
                                                                                
print("Mode 1 Coeffs (x3'):", coeffs_x3_m1)                                     
print("Mode 1 Coeffs (x4'):", coeffs_x4_m1)                                     
print("Mode 2 Coeffs (x3'):", coeffs_x3_m2)                                     
print("Mode 2 Coeffs (x4'):", coeffs_x4_m2)                                     
print("Threshold at t=7.55:", threshold_val)                                    
                                                                                
