import numpy as np                                                              
                                                                                
def identify_system(file_path):                                                 
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1, x2, x3, x4 = state[0,:], state[1,:], state[2,:], state[3,:]             
    dt = 0.001                                                                  
    dx3 = np.zeros_like(x3)                                                     
    dx4 = np.zeros_like(x4)                                                     
    dx3[1:-1] = (x3[2:] - x3[:-2]) / (2 * dt)                                   
    dx4[1:-1] = (x4[2:] - x4[:-2]) / (2 * dt)                                   
    dx3[0] = (x3[1] - x3[0]) / dt                                               
    dx3[-1] = (x3[-1] - x3[-2]) / dt                                            
    dx4[0] = (x4[1] - x4[0]) / dt                                               
    dx4[-1] = (x4[-1] - x4[-2]) / dt                                            
    R = np.sqrt(x1**2 + x2**2)                                                  
                                                                                
    # Precise switching point refinement                                        
    # Calculate residuals for Mode 1 (current best) and Mode 2 (current best)   
    # across the range [7500, 7600]                                             
    # Current best:                                                             
    a1, b1, c1, d1 = -0.05944, -2.8994, -1.5630, 2.5933                         
    a2, b2 = -0.5760, -19.2311                                                  
                                                                                
    res1 = np.sqrt((dx3 - (a1*x1 + b1*x3 + c1))**2 + (dx4 - (a1*x2 + b1*x4 +    
d1))**2)                                                                        
    res2 = np.sqrt((dx3 - (a2*x1 + b2*x3))**2 + (dx4 - (a2*x2 + b2*x4))**2)     
                                                                                
    # The switch occurs when res2 becomes smaller than res1                     
    # or where res1 starts increasing rapidly.                                  
    idx_switch = 7500                                                           
    for i in range(7500, 7600):                                                 
        if res2[i] < res1[i]:                                                   
            idx_switch = i                                                      
            break                                                               
                                                                                
    # Now re-fit with this improved split                                       
    # Mode 1                                                                    
    idx_start_stop = idx_switch                                                 
    A1_joint = np.zeros((2*idx_start_stop, 4))                                  
    A1_joint[:idx_start_stop, 0] = x1[:idx_start_stop]                          
    A1_joint[:idx_start_stop, 1] = x3[:idx_start_stop]                          
    A1_joint[:idx_start_stop, 2] = 1                                            
    A1_joint[idx_start_stop:, 0] = x2[:idx_start_stop]                          
    A1_joint[idx_start_stop:, 1] = x4[:idx_start_stop]                          
    A1_joint[idx_start_stop:, 3] = 1                                            
    B1_joint = np.concatenate([dx3[:idx_start_stop], dx4[:idx_start_stop]])     
    params1, _, _, _ = np.linalg.lstsq(A1_joint, B1_joint, rcond=None)          
                                                                                
    # Mode 2                                                                    
    idx_end_start = idx_switch                                                  
    A2 = np.vstack([                                                            
        np.column_stack([x1[idx_end_start:], x3[idx_end_start:]]),              
        np.column_stack([x2[idx_end_start:], x4[idx_end_start:]])               
    ])                                                                          
    B2 = np.concatenate([dx3[idx_end_start:], dx4[idx_end_start:]])             
    params2, _, _, _ = np.linalg.lstsq(A2, B2, rcond=None)                      
                                                                                
    return params1, params2, idx_switch, R[idx_switch]                          
                                                                                
