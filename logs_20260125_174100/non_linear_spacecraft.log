import numpy as np                                                              
                                                                                
# Load the data                                                                 
data_paths = ['data_all/non_linear/spacecraft/sample_0.npz',                    
              'data_all/non_linear/spacecraft/sample_1.npz',                    
              'data_all/non_linear/spacecraft/sample_2.npz']                    
                                                                                
X_list = []                                                                     
for path in data_paths:                                                         
    data = np.load(path)                                                        
    # Print keys to identify the correct one                                    
    if 'X' in data:                                                             
        X_list.append(data['X'])                                                
    elif 'states' in data:                                                      
        X_list.append(data['states'])                                           
    else:                                                                       
        print(f"Keys in {path}: {data.files}")                                  
                                                                                
# Combine all trajectories                                                      
X_all = np.concatenate(X_list, axis=0)                                          
                                                                                
# Verify the assumption: x1[t+1] = x3[t], x2[t+1] = x4[t]                       
# We need to treat each trajectory separately for the t+1 relationship          
# because the transition between trajectories is not valid.                     
# Assuming each file is one trajectory.                                         
                                                                                
all_x_current = []                                                              
all_y_targets = []                                                              
                                                                                
for X in X_list:                                                                
    # X shape is (N, 4)                                                         
    # Current states (t): x1, x2, x3, x4                                        
    x_curr = X[:-1, :]                                                          
    # Target states (t+1): x3, x4                                               
    y_target = X[1:, 2:4]                                                       
                                                                                
    all_x_current.append(x_curr)                                                
    all_y_targets.append(y_target)                                              
                                                                                
X_curr = np.vstack(all_x_current)                                               
Y_target = np.vstack(all_y_targets)                                             
                                                                                
# State variables at time t                                                     
x1 = X_curr[:, 0]                                                               
x2 = X_curr[:, 1]                                                               
x3 = X_curr[:, 2]                                                               
x4 = X_curr[:, 3]                                                               
                                                                                
# Targets at time t+1                                                           
y_x3 = Y_target[:, 0]                                                           
y_x4 = Y_target[:, 1]                                                           
                                                                                
# Calculate R                                                                   
R = np.sqrt(x1**2 + x2**2)                                                      
                                                                                
# Define a function for linear regression using lstsq                           
def solve_linear(X, y):                                                         
    # Add bias term                                                             
    A = np.column_stack([X, np.ones(X.shape[0])])                               
    coeffs, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)              
    return coeffs                                                               
                                                                                
# Search for R_crit                                                             
# Let's look at the range of R                                                  
r_min, r_max = np.min(R), np.max(R)                                             
print(f"R range: {r_min} to {r_max}")                                           
                                                                                
# Try 100 values for R_crit                                                     
r_candidates = np.linspace(r_min + 0.01*(r_max-r_min), r_max -                  
0.01*(r_max-r_min), 100)                                                        
best_r_crit = None                                                              
min_error = float('inf')                                                        
                                                                                
for r_crit in r_candidates:                                                     
    mask1 = R > r_crit                                                          
    mask2 = R <= r_crit                                                         
                                                                                
    # We need enough points in both modes                                       
    if np.sum(mask1) < 10 or np.sum(mask2) < 10:                                
        continue                                                                
                                                                                
    # Mode 1 error                                                              
    X1 = X_curr[mask1]                                                          
    y1_x3 = y_x3[mask1]                                                         
    y1_x4 = y_x4[mask1]                                                         
    sol1_x3 = solve_linear(X1, y1_x3)                                           
    sol1_x4 = solve_linear(X1, y1_x4)                                           
    err1 = np.sum((y1_x3 - (X1 @ sol1_x3[:-1] + sol1_x3[-1]))**2) + \           
           np.sum((y1_x4 - (X1 @ sol1_x4[:-1] + sol1_x4[-1]))**2)               
                                                                                
    # Mode 2 error                                                              
    X2 = X_curr[mask2]                                                          
    y2_x3 = y_x3[mask2]                                                         
    y2_x4 = y_x4[mask2]                                                         
    sol2_x3 = solve_linear(X2, y2_x3)                                           
    sol2_x4 = solve_linear(X2, y2_x4)                                           
    err2 = np.sum((y2_x3 - (X2 @ sol2_x3[:-1] + sol2_x3[-1]))**2) + \           
           np.sum((y2_x4 - (X2 @ sol2_x4[:-1] + sol2_x4[-1]))**2)               
                                                                                
    total_err = err1 + err2                                                     
    if total_err < min_error:                                                   
        min_error = total_err                                                   
        best_r_crit = r_crit                                                    
                                                                                
print(f"Optimal R_crit found: {best_r_crit}")                                   
                                                                                
# Final solve with best R_crit                                                  
mask1 = R > best_r_crit                                                         
mask2 = R <= best_r_crit                                                        
                                                                                
# Mode 1                                                                        
X1 = X_curr[mask1]                                                              
sol1_x3 = solve_linear(X1, y_x3[mask1])                                         
sol1_x4 = solve_linear(X1, y_x4[mask1])                                         
                                                                                
# Mode 2                                                                        
X2 = X_curr[mask2]                                                              
sol2_x3 = solve_linear(X2, y_x3[mask2])                                         
sol2_x4 = solve_linear(X2, y_x4[mask2])                                         
                                                                                
# Results                                                                       
print("Mode 1 Coefficients (x3[1]):", sol1_x3)                                  
print("Mode 1 Coefficients (x4[1]):", sol1_x4)                                  
print("Mode 2 Coefficients (x3[1]):", sol2_x3)                                  
print("Mode 2 Coefficients (x4[1]):", sol2_x4)                                  
                                                                                
