threshold = 837.35                                                              
                                                                                
X1_m1, X1_m2 = [], []                                                           
X2_m1, X2_m2 = [], []                                                           
Y3_m1, Y3_m2 = [], []                                                           
Y4_m1, Y4_m2 = [], []                                                           
                                                                                
for s_idx in range(3):                                                          
    x1, x2, x3, x4 = get_data(s_idx)                                            
    r = np.sqrt(x1**2 + x2**2)                                                  
                                                                                
    for k in range(len(r)-1):                                                   
        if r[k] > threshold:                                                    
            X1_m1.append([x1[k], x3[k]])                                        
            X2_m1.append([x2[k], x4[k]])                                        
            Y3_m1.append(x3[k+1])                                               
            Y4_m1.append(x4[k+1])                                               
        else:                                                                   
            X1_m2.append([x1[k], x3[k]])                                        
            X2_m2.append([x2[k], x4[k]])                                        
            Y3_m2.append(x3[k+1])                                               
            Y4_m2.append(x4[k+1])                                               
                                                                                
def fit_shared(X1, X2, Y3, Y4, affine=True):                                    
    # Fit Y3 = a*x1 + b*x3 + c                                                  
    # Fit Y4 = a*x2 + b*x4 + d                                                  
    # Minimize sum of squared errors                                            
    # X1, X2 are (N, 2), Y3, Y4 are (N,)                                        
    N = len(X1)                                                                 
    if affine:                                                                  
        # We have 4 parameters: a, b, c, d                                      
        # Law: [x1, x3, 1, 0] * [a, b, c, d]^T = Y3                             
        #      [x2, x4, 0, 1] * [a, b, c, d]^T = Y4                             
        A = np.zeros((2*N, 4))                                                  
        B = np.zeros(2*N)                                                       
        for i in range(N):                                                      
            A[2*i] = [X1[i][0], X1[i][1], 1, 0]                                 
            B[2*i] = Y3[i]                                                      
            A[2*i+1] = [X2[i][0], X2[i][1], 0, 1]                               
            B[2*i+1] = Y4[i]                                                    
    else:                                                                       
        # We have 2 parameters: a, b                                            
        A = np.zeros((2*N, 2))                                                  
        B = np.zeros(2*N)                                                       
        for i in range(N):                                                      
