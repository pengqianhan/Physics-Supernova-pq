  import numpy as np                                                            
                                                                                
  # Load all data                                                               
  all_states = []                                                               
  for path in ['data_all/non_linear/spacecraft/sample_0.npz',                   
  'data_all/non_linear/spacecraft/sample_1.npz',                                
  'data_all/non_linear/spacecraft/sample_2.npz']:                               
      data = np.load(path)                                                      
      all_states.append(data['state'])                                          
                                                                                
  dt = 1.0                                                                      
                                                                                
  X_list = []                                                                   
  Y_list = []                                                                   
  R_list = []                                                                   
                                                                                
  for state in all_states:                                                      
      x_t = state[:, :-1]                                                       
      x_tp1 = state[:, 1:]                                                      
      dy = (x_tp1 - x_t) / dt                                                   
      r = np.sqrt(x_t[0, :]**2 + x_t[1, :]**2)                                  
      X_list.append(x_t.T)                                                      
      Y_list.append(dy.T)                                                       
      R_list.append(r)                                                          
                                                                                
  X_all = np.concatenate(X_list, axis=0)                                        
  Y_all = np.concatenate(Y_list, axis=0)                                        
  R_all = np.concatenate(R_list, axis=0)                                        
                                                                                
  # Regression helper                                                           
  def solve_reg(X, y):                                                          
      A = np.column_stack([X, np.ones(X.shape[0])])                             
      return np.linalg.lstsq(A, y, rcond=None)[0]                               
                                                                                
  # Initial Mode 1 estimate (R > 850)                                           
  mask_rough = R_all > 850                                                      
  c3_rough = solve_reg(X_all[mask_rough], Y_all[mask_rough, 2])                 
  c4_rough = solve_reg(X_all[mask_rough], Y_all[mask_rough, 3])                 
                                                                                
  # Calculate error of Mode 1 model on all points                               
  A_all = np.column_stack([X_all, np.ones(X_all.shape[0])])                     
  err = (np.dot(A_all, c3_rough) - Y_all[:, 2])**2 + (np.dot(A_all, c4_rough)   
  - Y_all[:, 3])**2                                                             
                                                                                
