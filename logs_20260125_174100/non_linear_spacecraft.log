# Let's use a small window around the suspected T                               
is_mode1 = r[:-1] > T_approx                                                    
mode_changes = np.where(is_mode1[:-1] != is_mode1[1:])[0]                       
                                                                                
# For each transition, the boundary T should be between the r values            
r_switches = []                                                                 
for idx in mode_changes:                                                        
    # idx is the index in r such that r[idx] and r[idx+1] are on different sides
    r_switches.append((r[idx] + r[idx+1]) / 2)                                  
                                                                                
refined_T = np.mean(r_switches) if r_switches else T_approx                     
                                                                                
# Filter data for Mode 1 (r > refined_T) and Mode 2 (r <= refined_T)            
