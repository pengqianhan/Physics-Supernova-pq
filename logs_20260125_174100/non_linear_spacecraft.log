import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
# 1. Load data and compute R and differences                                    
all_states = []                                                                 
for path in ['data_all/non_linear/spacecraft/sample_0.npz',                     
'data_all/non_linear/spacecraft/sample_1.npz',                                  
'data_all/non_linear/spacecraft/sample_2.npz']:                                 
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
# We will process each sample separately to compute differences, then           
concatenate                                                                     
X_list = []                                                                     
Y_list = []                                                                     
R_list = []                                                                     
                                                                                
dt = 1.0 # Initial assumption, will refine if possible or requested             
                                                                                
for state in all_states:                                                        
    # state is (4, 10001)                                                       
    # x[t]                                                                      
    x_t = state[:, :-1]                                                         
    # x[t+1]                                                                    
    x_tp1 = state[:, 1:]                                                        
                                                                                
    # Differences                                                               
    dy = (x_tp1 - x_t) / dt                                                     
                                                                                
    # R at time t                                                               
    r_t = np.sqrt(x_t[0, :]**2 + x_t[1, :]**2)                                  
                                                                                
    X_list.append(x_t.T)                                                        
    Y_list.append(dy.T)                                                         
    R_list.append(r_t)                                                          
                                                                                
X_all = np.concatenate(X_list, axis=0)                                          
Y_all = np.concatenate(Y_list, axis=0)                                          
R_all = np.concatenate(R_list, axis=0)                                          
                                                                                
# 2. Fit Mode 1 for R > 850 to find the switch                                  
mask_m1_clear = R_all > 850                                                     
X_m1 = X_all[mask_m1_clear]                                                     
Y_m1 = Y_all[mask_m1_clear]                                                     
                                                                                
reg_m1_x3 = LinearRegression().fit(X_m1, Y_m1[:, 2])                            
reg_m1_x4 = LinearRegression().fit(X_m1, Y_m1[:, 3])                            
                                                                                
# 3. Find exact R_crit                                                          
# We'll look at the MSE of these models as a function of R                      
# Sort data by R to find the transition                                         
sort_idx = np.argsort(R_all)                                                    
R_sorted = R_all[sort_idx]                                                      
X_sorted = X_all[sort_idx]                                                      
Y_sorted = Y_all[sort_idx]                                                      
                                                                                
# Predict with Mode 1 model                                                     
pred_x3 = reg_m1_x3.predict(X_sorted)                                           
pred_x4 = reg_m1_x4.predict(X_sorted)                                           
err = (pred_x3 - Y_sorted[:, 2])**2 + (pred_x4 - Y_sorted[:, 3])**2             
                                                                                
# Search near 842.8144                                                          
# Let's find the R value where the error jumps                                  
search_mask = (R_sorted > 840) & (R_sorted < 845)                               
R_search = R_sorted[search_mask]                                                
err_search = err[search_mask]                                                   
                                                                                
# The transition should be a sharp jump.                                        
# Let's find the index of the maximum jump in error.                            
jump_idx = np.argmax(np.diff(err_search))                                       
exact_R_crit = R_search[jump_idx + 1]                                           
print(f"Exact R_crit found: {exact_R_crit}")                                    
                                                                                
# 4. Fit coefficients for Mode 1 (R > R_crit) and Mode 2 (R <= R_crit)          
mask_m1 = R_all > exact_R_crit                                                  
mask_m2 = R_all <= exact_R_crit                                                 
                                                                                
def get_coeffs(X, y):                                                           
    model = LinearRegression().fit(X, y)                                        
    return list(model.coef_) + [model.intercept_]                               
                                                                                
coeffs_m1_x3 = get_coeffs(X_all[mask_m1], Y_all[mask_m1, 2])                    
coeffs_m1_x4 = get_coeffs(X_all[mask_m1], Y_all[mask_m1, 3])                    
coeffs_m2_x3 = get_coeffs(X_all[mask_m2], Y_all[mask_m2, 2])                    
coeffs_m2_x4 = get_coeffs(X_all[mask_m2], Y_all[mask_m2, 3])                    
                                                                                
# Format output                                                                 
def format_coeffs(c, names):                                                    
    return ", ".join([f"{n}={val:.10f}" for n, val in zip(names, c)])           
                                                                                
print("Mode 1 (x3):", format_coeffs(coeffs_m1_x3, ["a1", "a2", "a3", "a4",      
"bias_x3"]))                                                                    
print("Mode 1 (x4):", format_coeffs(coeffs_m1_x4, ["b1", "b2", "b3", "b4",      
"bias_x4"]))                                                                    
print("Mode 2 (x3):", format_coeffs(coeffs_m2_x3, ["c1", "c2", "c3", "c4",      
