import numpy as np                                                              
                                                                                
data = np.load('data_all/non_linear/spacecraft/sample_0.npz')                   
state = data['state']                                                           
x1, x2, x3, x4 = state[0], state[1], state[2], state[3]                         
                                                                                
# Estimate dt                                                                   
# dx1 = x3 * dt => dt = dx1 / x3                                                
dx1 = np.diff(x1)                                                               
dt_estimates = dx1 / x3[:-1]                                                    
dt = np.median(dt_estimates)                                                    
print(f"Estimated dt: {dt}")                                                    
                                                                                
# Now compute derivatives                                                       
v1 = np.diff(x1) / dt                                                           
v2 = np.diff(x2) / dt                                                           
a1 = np.diff(x3) / dt                                                           
a2 = np.diff(x4) / dt                                                           
                                                                                
# The dynamics are:                                                             
# a1 = a*x1 + b*x3 + c                                                          
# a2 = d*x2 + e*x4 + f                                                          
                                                                                
# To find transitions, we can look at the residuals of a linear fit or just look
at a1, a2                                                                       
# Let's look at the distance to origin                                          
dist = np.sqrt(x1**2 + x2**2)                                                   
                                                                                
# Let's try to see where the behavior changes.                                  
# We can use a rolling window or check the consistency of a, b, c, d, e, f.     
# Or just plot a1/x1 etc.                                                       
                                                                                
# Let's plot dist and a1, a2 to see correlations                                
import matplotlib.pyplot as plt                                                 
fig, ax = plt.subplots(3, 1, figsize=(10, 10))                                  
ax[0].plot(dist)                                                                
ax[0].set_ylabel('Distance')                                                    
ax[1].plot(a1)                                                                  
ax[1].set_ylabel('a1')                                                          
ax[2].plot(a2)                                                                  
ax[2].set_ylabel('a2')                                                          
plt.savefig('dynamics_overview.png')                                            
                                                                                
# Let's find where a1 or a2 jump                                                
jump_a1 = np.abs(np.diff(a1))                                                   
jump_a2 = np.abs(np.diff(a2))                                                   
threshold = 0.1 * np.max(jump_a1) # Heuristic                                   
potential_transitions = np.where((jump_a1 > threshold) | (jump_a2 >             
threshold))[0]                                                                  
