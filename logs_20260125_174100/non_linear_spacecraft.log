    if errs[-1] < 1e-5:                                                         
        print(f"Confirmed mapping: x1={ix1}, x2={ix2}, x3={ix3}, x4={ix4}")     
        print(f"R range: {R.min()} to {R.max()}")                               
                                                                                
        # Determine the transition                                              
        # Mode 2 is active where errs is small                                  
        is_mode2 = errs < 1e-7                                                  
        if np.any(~is_mode2):                                                   
            # Find the threshold R                                              
            # Threshold is where R starts to be <= threshold                    
            # Mode 1: R > thresh, Mode 2: R <= thresh                           
            R_at_transition = R[:-1][~is_mode2]                                 
            R_at_mode2 = R[:-1][is_mode2]                                       
