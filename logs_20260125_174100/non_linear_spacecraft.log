import numpy as np                                                              
                                                                                
def get_data_for_mode(samples, threshold, mode):                                
    X3_list, Y3_list, X4_list, Y4_list = [], [], [], []                         
    for i in samples:                                                           
        data = np.load(f'data_all/non_linear/spacecraft/sample_{i}.npz')        
        state = data['state']                                                   
        x1, x2, x3, x4 = state                                                  
        dist = np.sqrt(x1**2 + x2**2)                                           
                                                                                
        if mode == 1:                                                           
            indices = np.where(dist > threshold)[0]                             
        else:                                                                   
            indices = np.where(dist <= threshold)[0]                            
                                                                                
        # We need pairs (k, k+1)                                                
        valid_indices = []                                                      
        for idx in indices:                                                     
            if idx + 1 < len(x1):                                               
                if mode == 1 and dist[idx+1] > threshold:                       
                    valid_indices.append(idx)                                   
                elif mode == 2 and dist[idx+1] <= threshold:                    
                    valid_indices.append(idx)                                   
                                                                                
        if not valid_indices: continue                                          
                                                                                
        v_idx = np.array(valid_indices)                                         
        X3_list.append(np.stack([x1[v_idx], x3[v_idx]], axis=1))                
        Y3_list.append(x3[v_idx + 1])                                           
        X4_list.append(np.stack([x2[v_idx], x4[v_idx]], axis=1))                
        Y4_list.append(x4[v_idx + 1])                                           
                                                                                
    return np.vstack(X3_list), np.concatenate(Y3_list), np.vstack(X4_list),     
np.concatenate(Y4_list)                                                         
                                                                                
