print(f"dx3 range: {np.min(dx3)} to {np.max(dx3)}")                             
                                                                                
# Detect switch point by looking at the second derivative of x3 or x4           
# or by looking at the change in the ratio dx3 / (a*x1 + b*x3)                  
# Let's try to see if there's a specific r where the behavior changes.          
# We can try to fit (x1, x3) -> dx3 for the beginning and end of the sequence.  
                                                                                
def estimate_dynamics(x1_part, x3_part, dx3_part, x2_part, x4_part, dx4_part):  
    # solve [x1 x3] [a] = [dx3]                                                 
    #       [x2 x4] [b]   [dx4]                                                 
    # Combine x1 and x2 into a single vector, and x3 and x4 into another        
    A = np.vstack([np.column_stack([x1_part, x3_part]),                         
np.column_stack([x2_part, x4_part])])                                           
    B = np.concatenate([dx3_part, dx4_part])                                    
    params, residuals, rank, s = np.linalg.lstsq(A, B, rcond=None)              
    return params # [a, b]                                                      
                                                                                
