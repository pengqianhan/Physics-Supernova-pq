state = data['state'] # (4, 10001)                                              
x = state.T # (10001, 4)                                                        
dt = 0.001                                                                      
num_points = x.shape[0]                                                         
t = np.arange(num_points) * dt                                                  
                                                                                
x1, x2, x3, x4 = x[:, 0], x[:, 1], x[:, 2], x[:, 3]                             
                                                                                
# Calculate derivatives                                                         
dx1 = np.gradient(x1, dt)                                                       
dx2 = np.gradient(x2, dt)                                                       
dx3 = np.gradient(x3, dt)                                                       
dx4 = np.gradient(x4, dt)                                                       
                                                                                
# Identify the switch point around t=7.55                                       
# Using the jump in dx3 or dx4 derivatives                                      
search_range = slice(7000, 8000)                                                
diff_dx3 = np.abs(np.diff(dx3))                                                 
max_diff_idx = 7000 + np.argmax(diff_dx3[7000:7999])                            
switch_idx = max_diff_idx + 1                                                   
print(f"Switch index: {switch_idx}, Time: {t[switch_idx]}")                     
                                                                                
# Define masks for Mode 1 and Mode 2, avoiding the switch region                
gap = 20                                                                        
m1_mask = np.arange(0, switch_idx - gap)                                        
m2_mask = np.arange(switch_idx + gap, num_points)                               
                                                                                
def get_coeffs(idx_list, target_dx, v1, v2):                                    
    Y = target_dx[idx_list]                                                     
    V1 = v1[idx_list]                                                           
    V2 = v2[idx_list]                                                           
    A_mat = np.column_stack([V1, V2, np.ones_like(V1)])                         
    coeffs, residuals, rank, s = np.linalg.lstsq(A_mat, Y, rcond=None)          
    return coeffs                                                               
                                                                                
# Mode 1 regression                                                             
m1_x3 = get_coeffs(m1_mask, dx3, x1, x3)                                        
m1_x4 = get_coeffs(m1_mask, dx4, x2, x4)                                        
                                                                                
# Mode 2 regression                                                             
m2_x3 = get_coeffs(m2_mask, dx3, x1, x3)                                        
m2_x4 = get_coeffs(m2_mask, dx4, x2, x4)                                        
                                                                                
# Guard distance at switching point                                             
dist_switch = np.sqrt(x1[switch_idx]**2 + x2[switch_idx]**2)                    
                                                                                
