import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def get_dynamics_data(x1, x2, x3, x4):                                          
    # Dynamics for x3: x3[t+1] = a * x1[t] + b * x3[t] + c                      
    # Dynamics for x4: x4[t+1] = a * x2[t] + b * x4[t] + d                      
    # We can stack them to solve for (a, b, c, d)                               
    # Target Y: x3[1:], x4[1:]                                                  
    # Features X: [x1[0:-1], x3[0:-1], 1, 0], [x2[0:-1], x4[0:-1], 0, 1]        
                                                                                
    N = len(x1) - 1                                                             
    Y3 = x3[1:].reshape(-1, 1)                                                  
    Y4 = x4[1:].reshape(-1, 1)                                                  
                                                                                
    # Mode parameters (a, b, c, d)                                              
    # x3_next = a*x1 + b*x3 + c*1 + d*0                                         
    # x4_next = a*x2 + b*x4 + c*0 + d*1                                         
                                                                                
    X3 = np.column_stack([x1[:-1], x3[:-1], np.ones(N), np.zeros(N)])           
    X4 = np.column_stack([x2[:-1], x4[:-1], np.zeros(N), np.ones(N)])           
                                                                                
    X = np.vstack([X3, X4])                                                     
    Y = np.vstack([Y3, Y4])                                                     
                                                                                
    return X, Y                                                                 
                                                                                
def check_fit(X, Y):                                                            
    model = LinearRegression().fit(X, Y)                                        
    score = model.score(X, Y)                                                   
    return score, model.coef_, model.intercept_                                 
                                                                                
for i in range(3):                                                              
    x1, x2, x3, x4, r = analyze_trace(DATA_FILE_PATHS[i])                       
