import numpy as np                                                              
                                                                                
def analyze_sample(path):                                                       
    data = np.load(path)                                                        
    state = data['state'] # (2, 10001)                                          
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # x1[k+1] = alpha * x1[k] - beta * x1[k] * x2[k]                            
    # x2[k+1] = delta * x1[k] * x2[k] - gamma * x2[k]                           
                                                                                
    # Let's try to find change points by checking the local fit                 
    # We'll use a sliding window to see if parameters are stable                
    window_size = 100                                                           
    params_history = []                                                         
                                                                                
    for i in range(0, len(x1) - window_size - 1, window_size):                  
        # x1[k+1] = alpha * x1[k] - beta * x1[k] * x2[k]                        
        X1_curr = x1[i:i+window_size]                                           
        X2_curr = x2[i:i+window_size]                                           
        X1_next = x1[i+1:i+window_size+1]                                       
        X2_next = x2[i+1:i+window_size+1]                                       
                                                                                
        # Fit alpha, beta                                                       
        # X1_next = A * [alpha, beta]^T where A = [X1_curr, -X1_curr * X2_curr] 
        A = np.stack([X1_curr, -X1_curr * X2_curr], axis=1)                     
        res1, _, _, _ = np.linalg.lstsq(A, X1_next, rcond=None)                 
        alpha, beta = res1                                                      
                                                                                
        # Fit delta, gamma                                                      
        # X2_next = B * [delta, gamma]^T where B = [X1_curr * X2_curr, -X2_curr]
        B = np.stack([X1_curr * X2_curr, -X2_curr], axis=1)                     
        res2, _, _, _ = np.linalg.lstsq(B, X2_next, rcond=None)                 
        delta, gamma = res2                                                     
                                                                                
        params_history.append((i, alpha, beta, delta, gamma))                   
                                                                                
    return params_history                                                       
                                                                                
# Analyze all samples                                                           
all_params = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    print(f"Analyzing {path}...")                                               
    all_params.append(analyze_sample(path))                                     
                                                                                
