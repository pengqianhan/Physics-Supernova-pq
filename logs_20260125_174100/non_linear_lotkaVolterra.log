import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
state = data['state']                                                           
x1_raw = state[0, :]                                                            
x2_raw = state[1, :]                                                            
                                                                                
# Assume dt = 0.01 for better scaling, but it won't affect alpha/beta ratio     
dt = 0.01                                                                       
dx1 = (x1_raw[1:] - x1_raw[:-1]) / dt                                           
dx2 = (x2_raw[1:] - x2_raw[:-1]) / dt                                           
x1 = x1_raw[:-1]                                                                
x2 = x2_raw[:-1]                                                                
                                                                                
# Estimate parameters locally                                                   
window_size = 100                                                               
step = 50                                                                       
estimates = []                                                                  
                                                                                
for i in range(0, len(dx1) - window_size, step):                                
    win_x1 = x1[i : i + window_size]                                            
    win_x2 = x2[i : i + window_size]                                            
    win_dx1 = dx1[i : i + window_size]                                          
    win_dx2 = dx2[i : i + window_size]                                          
                                                                                
    # Equation 1: dx1/x1 = alpha - beta*x2                                      
    # Regression: Y1 = dx1/x1, A1 = [1, -x2]                                    
    Y1 = win_dx1 / win_x1                                                       
    A1 = np.column_stack([np.ones_like(win_x2), -win_x2])                       
    p1, _, _, _ = np.linalg.lstsq(A1, Y1, rcond=None)                           
                                                                                
    # Equation 2: dx2/x2 = delta*x1 - gamma                                     
    # Regression: Y2 = dx2/x2, A2 = [x1, -1]                                    
    Y2 = win_dx2 / win_x2                                                       
    A2 = np.column_stack([win_x1, -np.ones_like(win_x1)])                       
    p2, _, _, _ = np.linalg.lstsq(A2, Y2, rcond=None)                           
                                                                                
    estimates.append([i, p1[0], p1[1], p2[0], p2[1]])                           
                                                                                
estimates = np.array(estimates)                                                 
                                                                                
# Identify modes by clustering or looking at parameter jumps                    
print("Averaged parameters over windows:")                                      
for row in estimates[:10]:                                                      
    print(f"Index {int(row[0])}: alpha={row[1]:.2f}, beta={row[2]:.2f},         
delta={row[3]:.2f}, gamma={row[4]:.2f}")                                        
                                                                                
# Look for large changes                                                        
diffs = np.linalg.norm(np.diff(estimates[:, 1:], axis=0), axis=1)               
threshold = np.mean(diffs) * 3                                                  
change_indices = np.where(diffs > threshold)[0]                                 
print("Detected changes at indices:", estimates[change_indices, 0])             
                                                                                
