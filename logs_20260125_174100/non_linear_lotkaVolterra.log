│         "total_time",                                                        │
│         "order"                                                              │
│       \],                                                                    │
│       "properties": {                                                        │
│         "dt": {                                                              │
│           "type": "number",                                                  │
│           "description": "Integration time step in seconds",                 │
│           "exclusiveMinimum": 0,                                             │
│           "examples": [                                                      │
│             0.001,                                                           │
│             0.01                                                             │
│           \]                                                                 │
│         },                                                                   │
│         "total_time": {                                                      │
│           "type": "number",                                                  │
│           "description": "Total simulation duration in seconds",             │
│           "exclusiveMinimum": 0,                                             │
│           "examples": [                                                      │
│             10.0,                                                            │
│             20.0                                                             │
│           \]                                                                 │
│         },                                                                   │
│         "order": {                                                           │
│           "type": "integer",                                                 │
│           "description": "Order of the ODE system (1=first-order,            │
