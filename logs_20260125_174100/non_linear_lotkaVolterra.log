import numpy as np                                                              
                                                                                
def get_residuals(x1, x2, alpha, beta, delta, gamma):                           
    x1_next = x1[1:]                                                            
    x1_curr = x1[:-1]                                                           
    x2_next = x2[1:]                                                            
    x2_curr = x2[:-1]                                                           
                                                                                
    res1 = x1_next - (alpha * x1_curr - beta * x1_curr * x2_curr)               
    res2 = x2_next - (delta * x1_curr * x2_curr - gamma * x2_curr)              
    return res1, res2                                                           
                                                                                
