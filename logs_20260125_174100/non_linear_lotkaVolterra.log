Thought: I will load the data, calculate numerical derivatives, and then use a  
sliding window to perform local regression for the Lotka-Volterra coefficients. 
By tracking how these coefficients change over time, I will be able to identify 
change points and segment the data accordingly.                                 
                                                                                
<code>                                                                          
import numpy as np                                                              
                                                                                
def fit_lv(x1, x2, dx1, dx2):                                                   
    # x1' = a*x1 - b*x1*x2                                                      
    # x2' = d*x1*x2 - g*x2                                                      
    # We can use least squares                                                  
    A1 = np.vstack([x1, -x1*x2]).T                                              
    coeffs1, _, _, _ = np.linalg.lstsq(A1, dx1, rcond=None)                     
                                                                                
    A2 = np.vstack([x1*x2, -x2]).T                                              
    coeffs2, _, _, _ = np.linalg.lstsq(A2, dx2, rcond=None)                     
                                                                                
    return coeffs1[0], coeffs1[1], coeffs2[0], coeffs2[1]                       
                                                                                
# Load sample 0                                                                 
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
dt = 0.01                                                                       
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
x1_mid = (x1[:-1] + x1[1:]) / 2                                                 
x2_mid = (x2[:-1] + x2[1:]) / 2                                                 
                                                                                
# Sliding window fit                                                            
window_size = 100                                                               
step = 50                                                                       
results = []                                                                    
for i in range(0, len(dx1) - window_size, step):                                
    idx = slice(i, i + window_size)                                             
    a, b, d, g = fit_lv(x1_mid[idx], x2_mid[idx], dx1[idx], dx2[idx])           
    results.append([i, a, b, d, g])                                             
                                                                                
results = np.array(results)                                                     
                                                                                
print("Sliding window coefficients (first 10):")                                
print(results[:10])                                                             
                                                                                
# Check for large changes in coefficients                                       
diffs = np.abs(np.diff(results[:, 1:], axis=0))                                 
max_diffs = np.max(diffs, axis=1)                                               
change_points = np.where(max_diffs > 0.1)[0] # Threshold might need tuning      
print("Potential change points in window indices:", change_points)              
                                                                                
