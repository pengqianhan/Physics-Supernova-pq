import numpy as np                                                              
                                                                                
def get_params(x1, x2, start, end):                                             
    X1_curr = x1[start:end]                                                     
    X2_curr = x2[start:end]                                                     
    X1_next = x1[start+1:end+1]                                                 
    X2_next = x2[start+1:end+1]                                                 
                                                                                
    A = np.stack([X1_curr, -X1_curr * X2_curr], axis=1)                         
    res1, _, _, _ = np.linalg.lstsq(A, X1_next, rcond=None)                     
                                                                                
    B = np.stack([X1_curr * X2_curr, -X2_curr], axis=1)                         
    res2, _, _, _ = np.linalg.lstsq(B, X2_next, rcond=None)                     
                                                                                
    return list(res1) + list(res2)                                              
                                                                                
