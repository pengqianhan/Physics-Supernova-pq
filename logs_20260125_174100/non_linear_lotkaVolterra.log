import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Re-estimate alpha and delta using the model:                                  
# x1[k+1] = alpha * (x1[k] - x1[k]*x2[k])                                       
# x2[k+1] = delta * (x1[k]*x2[k] - x2[k])                                       
# Note: These values might be very large if the model is discrete-step like     
this.                                                                           
# Let's check the values.                                                       
                                                                                
# alpha = x1[k+1] / (x1[k] * (1 - x2[k]))                                       
# delta = x2[k+1] / (x2[k] * (x1[k] - 1))                                       
                                                                                
alpha_vals = x1[1:] / (x1[:-1] * (1 - x2[:-1]))                                 
delta_vals = x2[1:] / (x2[:-1] * (x1[:-1] - 1))                                 
                                                                                
# Find transitions again with more robust method                                
alpha_diff = np.abs(np.diff(alpha_vals))                                        
delta_diff = np.abs(np.diff(delta_vals))                                        
                                                                                
# Using a more robust threshold for transitions based on median absolute        
deviation                                                                       
threshold_a = 5 * np.median(alpha_diff)                                         
threshold_d = 5 * np.median(delta_diff)                                         
change_indices = np.where((alpha_diff > threshold_a) | (delta_diff >            
threshold_d))[0] + 1                                                            
                                                                                
if len(change_indices) > 0:                                                     
    transitions = [change_indices[0]]                                           
    for i in range(1, len(change_indices)):                                     
        if change_indices[i] - transitions[-1] > 50: # Minimum segment length   
            transitions.append(change_indices[i])                               
    print("Transitions indices:", transitions)                                  
                                                                                
# Analyze segments                                                              
indices = [0] + list(transitions) + [len(x1)-1]                                 
results = []                                                                    
for i in range(len(indices) - 1):                                               
    start = indices[i]                                                          
    end = indices[i+1]                                                          
    # Use median to avoid outliers at transitions                               
    seg_alpha = np.median(alpha_vals[start:end])                                
    seg_delta = np.median(delta_vals[start:end])                                
    results.append({                                                            
        'segment': i,                                                           
        'start': start,                                                         
        'end': end,                                                             
        'alpha': seg_alpha,                                                     
        'delta': seg_delta,                                                     
        'x1_end': x1[end],                                                      
        'x2_end': x2[end]                                                       
    })                                                                          
                                                                                
for res in results:                                                             
    print(res)                                                                  
                                                                                
                                                                                
