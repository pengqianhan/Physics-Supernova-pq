x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Let's assume dt = 0.001 since it's 10001 steps for 10 seconds                 
N = state.shape[1]                                                              
dt = 0.01 # Wait, the prompt says "11 transitions in 10 seconds". 10001 steps.  
# Usually 10s / 10000 = 0.001.                                                  
                                                                                
# Identify segments by looking at local dynamics                                
# x1[k+1] = a*x1[k] + b*x1[k]*x2[k]                                             
# x2[k+1] = c*x1[k]*x2[k] + d*x2[k]                                             
                                                                                
def get_coeffs(idx_start, idx_end):                                             
    if idx_end - idx_start < 5: return None                                     
    X_mat = x1[idx_start:idx_end-1]                                             
    XY_mat = x1[idx_start:idx_end-1] * x2[idx_start:idx_end-1]                  
    Y_mat = x2[idx_start:idx_end-1]                                             
                                                                                
    # Equation 1: y1 = a*x1 + b*x1*x2                                           
    A1 = np.column_stack([X_mat, XY_mat])                                       
    b1 = x1[idx_start+1:idx_end]                                                
    coeffs1, _, _, _ = linalg.lstsq(A1, b1)                                     
                                                                                
    # Equation 2: y2 = c*x1*x2 + d*x2                                           
    A2 = np.column_stack([XY_mat, Y_mat])                                       
    b2 = x2[idx_start+1:idx_end]                                                
    coeffs2, _, _, _ = linalg.lstsq(A2, b2)                                     
                                                                                
    return np.concatenate([coeffs1, coeffs2])                                   
                                                                                
# Detect change points by sliding window regression error                       
window = 50                                                                     
change_scores = []                                                              
for i in range(window, N - window, 10):                                         
    c1 = get_coeffs(i-window, i)                                                
    c2 = get_coeffs(i, i+window)                                                
    change_scores.append((i, np.linalg.norm(c1 - c2)))                          
                                                                                
change_scores = np.array(change_scores)                                         
