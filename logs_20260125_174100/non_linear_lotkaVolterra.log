def count_peaks(errors, thresh=1e-8):                                           
    # Find indices where error is significantly higher than baseline            
    # The baseline error is around 1e-12 (due to noise or discretization)       
    peaks = []                                                                  
    i = 0                                                                       
    while i < len(errors):                                                      
        if errors[i] > thresh:                                                  
            # Find the peak in this cluster                                     
            start = i                                                           
            while i < len(errors) and errors[i] > thresh:                       
                i += 1                                                          
            peak_idx = start + np.argmax(errors[start:i])                       
            peaks.append(peak_idx)                                              
        else:                                                                   
            i += 1                                                              
    return peaks                                                                
                                                                                
total_peaks = 0                                                                 
for i in range(3):                                                              
    peaks = count_peaks(all_errors[i])                                          
    print(f"Sample {i} peaks:", peaks)                                          
    total_peaks += len(peaks)                                                   
print("Total peaks:", total_peaks)                                              
                                                                                
