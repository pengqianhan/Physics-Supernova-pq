import numpy as np                                                              
                                                                                
# Load the data from all files                                                  
all_states = []                                                                 
for path in ['data_all/non_linear/lotkaVolterra/sample_0.npz',                  
'data_all/non_linear/lotkaVolterra/sample_1.npz',                               
'data_all/non_linear/lotkaVolterra/sample_2.npz']:                              
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
                                                                                
# We'll use the first sample for detailed analysis                              
state = all_states[0] # Shape (2, 10001)                                        
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate the terms for the Lotka-Volterra model:                             
# x1[k+1] = a * x1[k] - b * x1[k] * x2[k]                                       
# x2[k+1] = c * x1[k] * x2[k] - d * x2[k]                                       
                                                                                
# Let's try to detect change points by fitting parameters locally and looking   
for jumps                                                                       
# Or by looking at the error of a global fit.                                   
# A more robust way is to check the residuals of a local fit.                   
                                                                                
def fit_local(x1_seg, x2_seg):                                                  
    # x1[k+1] = a*x1[k] - b*x1[k]*x2[k]                                         
    # x2[k+1] = c*x1[k]*x2[k] - d*x2[k]                                         
                                                                                
    Y1 = x1_seg[1:]                                                             
    X1 = np.vstack([x1_seg[:-1], -x1_seg[:-1]*x2_seg[:-1]]).T                   
    params1, _, _, _ = np.linalg.lstsq(X1, Y1, rcond=None)                      
                                                                                
    Y2 = x2_seg[1:]                                                             
    X2 = np.vstack([x1_seg[:-1]*x2_seg[:-1], -x2_seg[:-1]]).T                   
    params2, _, _, _ = np.linalg.lstsq(X2, Y2, rcond=None)                      
                                                                                
    return params1[0], params1[1], params2[0], params2[1]                       
                                                                                
# Sliding window analysis to find where the parameters jump                     
window_size = 50                                                                
errors = []                                                                     
for i in range(window_size, len(x1) - window_size - 1):                         
    # Fit on left window, test on right point                                   
    p1a, p1b, p2c, p2d = fit_local(x1[i-window_size:i], x2[i-window_size:i])    
                                                                                
    pred_x1 = p1a * x1[i-1] - p1b * x1[i-1] * x2[i-1]                           
    pred_x2 = p2c * x1[i-1] * x2[i-1] - p2d * x2[i-1]                           
                                                                                
    err = (pred_x1 - x1[i])**2 + (pred_x2 - x2[i])**2                           
    errors.append(err)                                                          
                                                                                
import matplotlib.pyplot as plt                                                 
plt.plot(errors)                                                                
plt.yscale('log')                                                               
plt.savefig('errors.png')                                                       
                                                                                
# Alternatively, just look at when the state makes a big jump in its            
"derivative"                                                                    
# but Lotka-Volterra is smooth. The hybrid change should be visible.            
# Let's find the 11 largest peaks in error or parameter change.                 
print("Finished initial error analysis")                                        
                                                                                
