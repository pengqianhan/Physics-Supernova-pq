def fit_segment(x1, x2, start, end):                                            
    if end - start < 10: return None                                            
    X = x1[start:end-1]                                                         
    Y = x2[start:end-1]                                                         
    XY = X * Y                                                                  
    T1 = x1[start+1:end]                                                        
    T2 = x2[start+1:end]                                                        
                                                                                
