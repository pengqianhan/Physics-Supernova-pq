  X2_curr = []                                                                  
  X1_next = []                                                                  
  X2_next = []                                                                  
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      state = data['state']                                                     
      # x1 is state[0], x2 is state[1]                                          
      X1_curr.append(state[0, :-1])                                             
      X2_curr.append(state[1, :-1])                                             
      X1_next.append(state[0, 1:])                                              
      X2_next.append(state[1, 1:])                                              
                                                                                
  # Convert to flat arrays                                                      
  x1 = np.concatenate(X1_curr)                                                  
  x2 = np.concatenate(X2_curr)                                                  
  x1_next = np.concatenate(X1_next)                                             
  x2_next = np.concatenate(X2_next)                                             
                                                                                
  x1_x2 = x1 * x2                                                               
  ones = np.ones_like(x1)                                                       
                                                                                
  # Fit Equation 1: x1_next = alpha * x1 + beta * x1*x2 + bias1                 
  # Features: [x1, x1*x2, 1]                                                    
  A1 = np.vstack([x1, x1_x2, ones]).T                                           
  params1, res1, rank1, s1 = np.linalg.lstsq(A1, x1_next, rcond=None)           
  alpha, beta, bias1 = params1                                                  
                                                                                
  # Fit Equation 2: x2_next = delta * x1*x2 + gamma * x2 + bias2                
  # Features: [x1*x2, x2, 1]                                                    
  A2 = np.vstack([x1_x2, x2, ones]).T                                           
  params2, res2, rank2, s2 = np.linalg.lstsq(A2, x2_next, rcond=None)           
  delta, gamma, bias2 = params2                                                 
                                                                                
  print(f"Discrete Model Parameters:")                                          
  print(f"alpha: {alpha}")                                                      
  print(f"beta: {beta}")                                                        
  print(f"bias1: {bias1}")                                                      
  print(f"delta: {delta}")                                                      
  print(f"gamma: {gamma}")                                                      
  print(f"bias2: {bias2}")                                                      
                                                                                
  # Also try a more general model to check for other terms                      
  # x1_next = c1*x1 + c2*x1*x2 + c3*x2 + c4                                     
  # x2_next = d1*x1 + d2*x1*x2 + d3*x2 + d4                                     
  A_full = np.vstack([x1, x1_x2, x2, ones]).T                                   
  params1_full, _, _, _ = np.linalg.lstsq(A_full, x1_next, rcond=None)          
  params2_full, _, _, _ = np.linalg.lstsq(A_full, x2_next, rcond=None)          
                                                                                
  print("\nFull Model Parameters (checking for other dependencies):")           
  print(f"Eq 1 coeffs [x1, x1*x2, x2, 1]: {params1_full}")                      
  print(f"Eq 2 coeffs [x1, x1*x2, x2, 1]: {params2_full}")                      
                                                                                
  # To satisfy "Estimate the derivatives dx1/dt and dx2/dt",                    
  # assuming dt = 0.01 (common for such datasets) or just reporting             
  (x(k+1)-x(k))/dt.                                                             
  # Actually, since dt is not provided, I'll report the discrete coefficients   
  first.                                                                        
  # If I look at alpha and gamma, if alpha approx 1 and gamma approx 1,         
  # then (x1_next - x1) = (alpha-1)x1 + beta*x1*x2, which is dt * (a*x1 -       
  b*x1*x2).                                                                     
