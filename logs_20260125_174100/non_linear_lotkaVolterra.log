import numpy as np                                                              
                                                                                
def estimate_params(states):                                                    
    x1 = states[0, :]                                                           
    x2 = states[1, :]                                                           
    n = len(x1)                                                                 
                                                                                
    # Global fit as a baseline                                                  
    Y1 = x1[1:]                                                                 
    A1 = np.vstack([x1[:-1], -x1[:-1]*x2[:-1]]).T                               
    p1, _, _, _ = np.linalg.lstsq(A1, Y1, rcond=None)                           
                                                                                
    Y2 = x2[1:]                                                                 
    A2 = np.vstack([x1[:-1]*x2[:-1], -x2[:-1]]).T                               
    p2, _, _, _ = np.linalg.lstsq(A2, Y2, rcond=None)                           
                                                                                
    return p1[0], p1[1], p2[0], p2[1]                                           
                                                                                
