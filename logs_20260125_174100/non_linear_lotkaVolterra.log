for i in range(3):                                                              
    path = f'data_all/non_linear/lotkaVolterra/sample_{i}.npz'                  
    x = np.load(path)['state'].T                                                
    samples_data.append(x)                                                      
    indices, diffs = find_transitions_in_sample(x)                              
    all_indices.append(indices)                                                 
    all_diffs.append(diffs)                                                     
                                                                                
# Combine all diffs to find global threshold or top 11                          
global_diffs = []                                                               
for i in range(3):                                                              
    for j in range(len(all_diffs[i])):                                          
        global_diffs.append((all_diffs[i][j], i, all_indices[i][j]))            
                                                                                
global_diffs.sort(key=lambda x: x[0], reverse=True)                             
                                                                                
# Select top transitions but ensure they are not too close to each other        
selected_transitions = []                                                       
for score, sample_idx, pos in global_diffs:                                     
    # Check proximity to existing ones in the same sample                       
    too_close = False                                                           
    for s, si, p in selected_transitions:                                       
        if si == sample_idx and abs(p - pos) < 500:                             
            too_close = True                                                    
            break                                                               
    if not too_close:                                                           
        selected_transitions.append((score, sample_idx, pos))                   
