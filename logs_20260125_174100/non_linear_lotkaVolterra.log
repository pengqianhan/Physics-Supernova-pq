times = []                                                                      
                                                                                
for i in range(0, len(x1) - window_size, step):                                 
    s1 = x1[i : i + window_size]                                                
    s2 = x2[i : i + window_size]                                                
    sd1 = dx1[i : i + window_size]                                              
    sd2 = dx2[i : i + window_size]                                              
                                                                                
    # Fit dx1 = a*x1 - b*x1*x2                                                  
    A1 = np.stack([s1, -s1*s2], axis=1)                                         
    p1, _, _, _ = np.linalg.lstsq(A1, sd1, rcond=None)                          
                                                                                
    # Fit dx2 = c*x1*x2 - d*x2                                                  
    A2 = np.stack([s1*s2, -s2], axis=1)                                         
    p2, _, _, _ = np.linalg.lstsq(A2, sd2, rcond=None)                          
                                                                                
    params.append([p1[0], p1[1], p2[0], p2[1]])                                 
    times.append(i + window_size // 2)                                          
                                                                                
