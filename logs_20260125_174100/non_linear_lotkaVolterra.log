import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def estimate_params(x1, x2, dx1, dx2):                                          
    # dx1 = a * x1 + b * x1 * x2  => dx1/x1 = a + b * x2                        
    # dx2 = d * x2 + c * x1 * x2  => dx2/x2 = d + c * x1                        
                                                                                
    # Avoid division by zero                                                    
    mask1 = np.abs(x1) > 1e-6                                                   
    mask2 = np.abs(x2) > 1e-6                                                   
                                                                                
    if np.sum(mask1) < 2 or np.sum(mask2) < 2:                                  
