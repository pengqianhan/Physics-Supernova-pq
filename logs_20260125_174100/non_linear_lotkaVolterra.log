import numpy as np                                                              
import scipy.signal                                                             
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
state = data['state'] # Shape (2, 10001)                                        
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
n = len(x1) - 1                                                                 
X1_curr = x1[:-1]                                                               
X2_curr = x2[:-1]                                                               
X1_next = x1[1:]                                                                
X2_next = x2[1:]                                                                
                                                                                
# Calculate local parameters using a small window to see changes                
window_size = 100                                                               
step = 10                                                                       
alphas, betas, deltas, gammas = [], [], [], []                                  
indices = []                                                                    
                                                                                
for i in range(0, n - window_size, step):                                       
    idx = slice(i, i + window_size)                                             
    # Eq 1: x1_next = alpha * x1 - beta * (x1*x2)                               
    A1 = np.column_stack([X1_curr[idx], -X1_curr[idx] * X2_curr[idx]])          
    y1 = X1_next[idx]                                                           
                                                                                
    # Eq 2: x2_next = delta * (x1*x2) - gamma * x2                              
    A2 = np.column_stack([X1_curr[idx] * X2_curr[idx], -X2_curr[idx]])          
    y2 = X2_next[idx]                                                           
                                                                                
    try:                                                                        
        coef1 = np.linalg.lstsq(A1, y1, rcond=None)[0]                          
        coef2 = np.linalg.lstsq(A2, y2, rcond=None)[0]                          
        alphas.append(coef1[0])                                                 
        betas.append(coef1[1])                                                  
        deltas.append(coef2[0])                                                 
        gammas.append(coef2[1])                                                 
        indices.append(i + window_size // 2)                                    
    except:                                                                     
        pass                                                                    
                                                                                
# Detect jumps in parameters                                                    
params = np.column_stack([alphas, betas, deltas, gammas])                       
param_diffs = np.linalg.norm(np.diff(params, axis=0), axis=1)                   
                                                                                
# Finding indices of top 11 peaks in param_diffs                                
peaks, _ = scipy.signal.find_peaks(param_diffs, height=0.01, distance=20)       
# Map back to original indices                                                  
change_indices = [indices[p] for p in peaks]                                    
                                                                                
# Sort indices and add boundaries                                               
change_indices = sorted(change_indices)                                         
print(f"Detected change points at indices: {change_indices}")                   
print(f"Number of change points: {len(change_indices)}")                        
                                                                                
# Now for each segment, get precise parameters and check for resets             
segments = [0] + change_indices + [n]                                           
modes_params = []                                                               
for i in range(len(segments)-1):                                                
    start, end = segments[i], segments[i+1]                                     
    # Use a small buffer to avoid transitions                                   
    buf = 5                                                                     
    if end - start > 2 * buf:                                                   
        idx = slice(start + buf, end - buf)                                     
    else:                                                                       
        idx = slice(start, end)                                                 
                                                                                
    A1 = np.column_stack([X1_curr[idx], -X1_curr[idx] * X2_curr[idx]])          
    y1 = X1_next[idx]                                                           
    A2 = np.column_stack([X1_curr[idx] * X2_curr[idx], -X2_curr[idx]])          
    y2 = X2_next[idx]                                                           
                                                                                
    coef1 = np.linalg.lstsq(A1, y1, rcond=None)[0]                              
    coef2 = np.linalg.lstsq(A2, y2, rcond=None)[0]                              
    modes_params.append({                                                       
        'alpha': coef1[0], 'beta': coef1[1],                                    
        'delta': coef2[0], 'gamma': coef2[1]                                    
    })                                                                          
                                                                                
for i, p in enumerate(modes_params):                                            
    print(f"Mode {i}: {p}")                                                     
                                                                                
# Check for resets                                                              
resets = []                                                                     
for cp in change_indices:                                                       
    # Compare x[cp] with the prediction from the previous mode                  
    prev_mode = modes_params[change_indices.index(cp)]                          
    x1_prev = x1[cp-1]                                                          
    x2_prev = x2[cp-1]                                                          
    x1_pred = prev_mode['alpha'] * x1_prev - prev_mode['beta'] * x1_prev *      
x2_prev                                                                         
    x2_pred = prev_mode['delta'] * x1_prev * x2_prev - prev_mode['gamma'] *     
x2_prev                                                                         
                                                                                
    diff = np.array([x1[cp] - x1_pred, x2[cp] - x2_pred])                       
    resets.append(diff)                                                         
    print(f"Jump at index {cp}: {diff}")                                        
                                                                                
# Guard conditions                                                              
for cp in change_indices:                                                       
    print(f"State at change point {cp}: x1={x1[cp]:.4f}, x2={x2[cp]:.4f}")      
                                                                                
