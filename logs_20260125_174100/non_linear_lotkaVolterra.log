    data = np.load(path)                                                        
    state = data['state']                                                       
    x1, x2 = state[0], state[1]                                                 
    n = len(x1)                                                                 
                                                                                
    # Identify segments by looking at the variance of a rolling fit error or    
param change                                                                    
    # But from previous logs, the changes are quite clear.                      
    # Let's detect where the parameters jump.                                   
    window = 20                                                                 
    modes = []                                                                  
    change_points = []                                                          
                                                                                
    curr_start = 0                                                              
    i = 0                                                                       
    while i < n - window - 1:                                                   
        p = get_params(x1, x2, i, i + window)                                   
        # Round to identify modes                                               
        p_rounded = np.round(p, 4)                                              
                                                                                
        if i == 0:                                                              
            last_p = p_rounded                                                  
                                                                                
        if not np.array_equal(p_rounded, last_p):                               
            # Transition detected                                               
            # The transition window might be noisy, so we skip it to find the   
next stable mode                                                                
            change_points.append(i)                                             
            # Find when it stabilizes again                                     
            found_stable = False                                                
            for j in range(i + 1, n - window - 1):                              
                pj = get_params(x1, x2, j, j + window)                          
                pj_rounded = np.round(pj, 4)                                    
                # Check if it stays stable for a few steps                      
                if np.array_equal(pj_rounded, np.round(get_params(x1, x2, j+5,  
j+5+window), 4)):                                                               
                    modes.append({'start': curr_start, 'end': i, 'params':      
get_params(x1, x2, curr_start, i)})                                             
                    curr_start = j                                              
                    i = j                                                       
                    last_p = pj_rounded                                         
                    found_stable = True                                         
                    break                                                       
            if not found_stable:                                                
                break                                                           
        else:                                                                   
            i += 1                                                              
                                                                                
    modes.append({'start': curr_start, 'end': n-1, 'params': get_params(x1, x2, 
