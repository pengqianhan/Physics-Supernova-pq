import numpy as np                                                              
from scipy.linalg import lstsq                                                  
                                                                                
# Load data                                                                     
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
y1 = x1[1:]                                                                     
y2 = x2[1:]                                                                     
X1 = np.column_stack([x1[:-1], x1[:-1]*x2[:-1]])                                
X2 = np.column_stack([x1[:-1]*x2[:-1], x2[:-1]])                                
                                                                                
def get_segment_cost(start, end):                                               
    if end - start < 5:                                                         
        return 0, np.zeros(2), np.zeros(2)                                      
                                                                                
    # x1[k+1] = a*x1[k] + b*x1[k]*x2[k]                                         
    c1, res1, rank1, s1 = lstsq(X1[start:end], y1[start:end])                   
    cost1 = res1[0] if (len(res1) > 0) else np.sum((y1[start:end] -             
X1[start:end] @ c1)**2)                                                         
                                                                                
    # x2[k+1] = c*x1[k]*x2[k] + d*x2[k]                                         
    c2, res2, rank2, s2 = lstsq(X2[start:end], y2[start:end])                   
    cost2 = res2[0] if (len(res2) > 0) else np.sum((y2[start:end] -             
X2[start:end] @ c2)**2)                                                         
                                                                                
    return cost1 + cost2, c1, c2                                                
                                                                                
def find_best_split(start, end):                                                
    best_cost_reduction = -1                                                    
    best_idx = -1                                                               
    initial_cost, _, _ = get_segment_cost(start, end)                           
                                                                                
    # Search for split point, skip boundaries                                   
    step = max(1, (end - start) // 50)                                          
    for i in range(start + 10, end - 10, step):                                 
        cost_left, _, _ = get_segment_cost(start, i)                            
        cost_right, _, _ = get_segment_cost(i, end)                             
        reduction = initial_cost - (cost_left + cost_right)                     
        if reduction > best_cost_reduction:                                     
            best_cost_reduction = reduction                                     
            best_idx = i                                                        
                                                                                
    return best_idx, best_cost_reduction                                        
                                                                                
# Binary Segmentation to find 11 points                                         
segments = [(0, 10000)]                                                         
split_points = []                                                               
                                                                                
for _ in range(11):                                                             
    best_reduction = -1                                                         
    best_split_idx = -1                                                         
    best_seg_idx = -1                                                           
                                                                                
    for i, (start, end) in enumerate(segments):                                 
        idx, reduction = find_best_split(start, end)                            
        if reduction > best_reduction:                                          
            best_reduction = reduction                                          
            best_split_idx = idx                                                
            best_seg_idx = i                                                    
                                                                                
    if best_split_idx != -1:                                                    
        start, end = segments.pop(best_seg_idx)                                 
        split_points.append(best_split_idx)                                     
        segments.append((start, best_split_idx))                                
        segments.append((best_split_idx, end))                                  
        segments.sort()                                                         
        split_points.sort()                                                     
                                                                                
print("Split points indices:", split_points)                                    
                                                                                
# Fit models for each segment                                                   
results = []                                                                    
for start, end in segments:                                                     
    cost, c1, c2 = get_segment_cost(start, end)                                 
    results.append({                                                            
        'range': (start, end),                                                  
        'coeffs': np.concatenate([c1, c2])                                      
    })                                                                          
                                                                                
for i, res in enumerate(results):                                               
    print(f"Segment {i} ({res['range']}): {res['coeffs']}")                     
                                                                                
                                                                                
