import numpy as np                                                              
                                                                                
def detect_change_points(state, window_size=50):                                
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    n = len(x1)                                                                 
                                                                                
    change_points = []                                                          
    current_params = None                                                       
                                                                                
    # We'll store parameters at each window                                     
    params_list = []                                                            
                                                                                
    for i in range(0, n - window_size, 10): # Step of 10 for efficiency         
        X1_curr = x1[i:i+window_size]                                           
        X2_curr = x2[i:i+window_size]                                           
        X1_next = x1[i+1:i+window_size+1]                                       
        X2_next = x2[i+1:i+window_size+1]                                       
                                                                                
        # Fit alpha, beta                                                       
        A = np.stack([X1_curr, -X1_curr * X2_curr], axis=1)                     
        res1, resid1, _, _ = np.linalg.lstsq(A, X1_next, rcond=None)            
        alpha, beta = res1                                                      
                                                                                
        # Fit delta, gamma                                                      
        B = np.stack([X1_curr * X2_curr, -X2_curr], axis=1)                     
        res2, resid2, _, _ = np.linalg.lstsq(B, X2_next, rcond=None)            
        delta, gamma = res2                                                     
                                                                                
        params_list.append((i, alpha, beta, delta, gamma))                      
                                                                                
    # Check for significant changes in parameters                               
    # Comparing with the first window's parameters                              
    base_alpha, base_beta, base_delta, base_gamma = params_list[0][1:]          
                                                                                
    for i, alpha, beta, delta, gamma in params_list:                            
        if abs(alpha - base_alpha) > 1e-4 or abs(beta - base_beta) > 1e-4 or \  
           abs(delta - base_delta) > 1e-4 or abs(gamma - base_gamma) > 1e-4:    
            # Possible change point                                             
            change_points.append(i)                                             
            # Update base parameters to the new ones to detect the next change  
            base_alpha, base_beta, base_delta, base_gamma = alpha, beta, delta, 
gamma                                                                           
                                                                                
    return change_points, params_list                                           
                                                                                
