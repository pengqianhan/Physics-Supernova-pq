<code>                                                                          
import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load data                                                                     
data0 = np.load(DATA_FILE_PATHS[0])                                             
states = data0['state']                                                         
x1 = states[0, :]                                                               
x2 = states[1, :]                                                               
n = len(x1)                                                                     
                                                                                
# Window size for local parameter estimation                                    
window_size = 50                                                                
alphas, betas, deltas, gammas = [], [], [], []                                  
times = []                                                                      
                                                                                
for i in range(0, n - window_size, window_size):                                
    # Prepare data for x1[k+1] = alpha * x1[k] - beta * x1[k]*x2[k]             
    # Y1 = A1 * [alpha, beta]^T                                                 
    Y1 = x1[i+1 : i+window_size+1]                                              
    A1 = np.vstack([x1[i:i+window_size],                                        
-x1[i:i+window_size]*x2[i:i+window_size]]).T                                    
                                                                                
    # Prepare data for x2[k+1] = delta * x1[k]*x2[k] - gamma * x2[k]            
    # Y2 = A2 * [delta, gamma]^T                                                
    Y2 = x2[i+1 : i+window_size+1]                                              
    A2 = np.vstack([x1[i:i+window_size]*x2[i:i+window_size],                    
-x2[i:i+window_size]]).T                                                        
                                                                                
    try:                                                                        
        p1, _, _, _ = np.linalg.lstsq(A1, Y1, rcond=None)                       
        p2, _, _, _ = np.linalg.lstsq(A2, Y2, rcond=None)                       
        alphas.append(p1[0])                                                    
        betas.append(p1[1])                                                     
        deltas.append(p2[0])                                                    
        gammas.append(p2[1])                                                    
        times.append(i + window_size // 2)                                      
    except:                                                                     
        pass                                                                    
                                                                                
# Plot local parameters                                                         
plt.figure(figsize=(12, 8))                                                     
plt.subplot(2, 2, 1); plt.plot(times, alphas); plt.title('Alpha')               
plt.subplot(2, 2, 2); plt.plot(times, betas); plt.title('Beta')                 
plt.subplot(2, 2, 3); plt.plot(times, deltas); plt.title('Delta')               
plt.subplot(2, 2, 4); plt.plot(times, gammas); plt.title('Gamma')               
plt.tight_layout()                                                              
plt.savefig('parameter_evolution.png')                                          
                                                                                
# Print some values to see the scale and changes                                
print("Alpha sample values:", alphas[::10])                                     
print("Beta sample values:", betas[::10])                                       
                                                                                
