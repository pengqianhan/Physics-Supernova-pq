  import numpy as np                                                            
                                                                                
  def get_coeffs(X_k, X_kp1):                                                   
      # Model: x1[k+1] = a*x1[k] + b*x1[k]*x2[k]                                
      A1 = np.column_stack([X_k[:, 0], X_k[:, 0] * X_k[:, 1]])                  
      c1, _, _, _ = np.linalg.lstsq(A1, X_kp1[:, 0], rcond=None)                
      # Model: x2[k+1] = c*x1[k]*x2[k] + d*x2[k]                                
      A2 = np.column_stack([X_k[:, 0] * X_k[:, 1], X_k[:, 1]])                  
      c2, _, _, _ = np.linalg.lstsq(A2, X_kp1[:, 1], rcond=None)                
      return np.concatenate([c1, c2])                                           
                                                                                
  def find_transitions_in_sample(x, n_expected=None):                           
      # Calculate local coefficients in sliding windows                         
      window_size = 100                                                         
      step = 20                                                                 
      coeffs_history = []                                                       
      indices = []                                                              
      for i in range(0, len(x) - window_size, step):                            
          seg = x[i : i + window_size]                                          
          X_k, X_kp1 = seg[:-1], seg[1:]                                        
          coeffs_history.append(get_coeffs(X_k, X_kp1))                         
          indices.append(i + window_size // 2)                                  
                                                                                
      coeffs_history = np.array(coeffs_history)                                 
      # Norm of the difference between consecutive window coefficients          
      diffs = np.linalg.norm(np.diff(coeffs_history, axis=0), axis=1)           
                                                                                
      # Identify peaks in diffs                                                 
