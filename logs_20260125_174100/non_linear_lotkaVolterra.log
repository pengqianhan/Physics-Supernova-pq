  import numpy as np                                                            
  import scipy.linalg                                                           
                                                                                
  def solve_lv_coeffs(x_seg, dx_seg):                                           
      # dx1 = a*x1 + b*x1*x2                                                    
      # dx2 = c*x1*x2 + d*x2                                                    
      A1 = np.column_stack([x_seg[:, 0], x_seg[:, 0] * x_seg[:, 1]])            
      A2 = np.column_stack([x_seg[:, 0] * x_seg[:, 1], x_seg[:, 1]])            
                                                                                
      coeffs1, _, _, _ = np.linalg.lstsq(A1, dx_seg[:, 0], rcond=None)          
      coeffs2, _, _, _ = np.linalg.lstsq(A2, dx_seg[:, 1], rcond=None)          
                                                                                
      return [coeffs1[0], coeffs1[1], coeffs2[0], coeffs2[1]]                   
                                                                                
  def get_segments(sample_path):                                                
      data = np.load(sample_path)                                               
      # state is (2, 10001)                                                     
      x = data['state'].T                                                       
      dx = np.diff(x, axis=0)                                                   
      x_mid = x[:-1]                                                            
                                                                                
      # Identify transitions by looking at the change in local coefficients     
      window = 20                                                               
      coeffs_list = []                                                          
      for i in range(0, len(dx) - window, window):                              
          c = solve_lv_coeffs(x_mid[i:i+window], dx[i:i+window])                
          coeffs_list.append(c)                                                 
                                                                                
      coeffs_list = np.array(coeffs_list)                                       
      # Find indices where coeffs change significantly                          
      diffs = np.linalg.norm(np.diff(coeffs_list, axis=0), axis=1)              
      # threshold for jumps                                                     
      threshold = np.mean(diffs) + 3 * np.std(diffs)                            
      jumps = np.where(diffs > threshold)[0]                                    
                                                                                
      # Convert window indices back to original indices                         
      change_points = (jumps + 1) * window                                      
                                                                                
      # Refine change points                                                    
      refined_points = [0]                                                      
      for cp in change_points:                                                  
          # Search around cp for the exact jump in dx                           
          search_range = range(max(1, cp-window), min(len(dx)-1, cp+window))    
          # Look for the max norm of the second derivative (change in first     
  derivative)                                                                   
          d2x = np.linalg.norm(dx[1:] - dx[:-1], axis=1)                        
          # Find local max in search range                                      
          local_d2x = d2x[max(0, cp-window-1):min(len(d2x), cp+window-1)]       
          if len(local_d2x) > 0:                                                
              best_idx = np.argmax(local_d2x) + max(0, cp-window-1) + 1         
              refined_points.append(best_idx)                                   
                                                                                
      refined_points.append(len(x))                                             
      return x, sorted(list(set(refined_points)))                               
                                                                                
