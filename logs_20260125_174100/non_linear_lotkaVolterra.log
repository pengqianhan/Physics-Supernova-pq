import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load the first trace                                                          
data = np.load(DATA_FILE_PATHS[0])                                              
t = data['t']                                                                   
x = data['x']  # shape (N, 2)                                                   
                                                                                
# Calculate derivatives                                                         
dt = np.diff(t)                                                                 
dx = np.diff(x, axis=0)                                                         
x_dot = dx / dt[:, np.newaxis]                                                  
x_mid = (x[:-1] + x[1:]) / 2                                                    
                                                                                
# Identify change points                                                        
# We look for where the local dynamics change abruptly.                         
# Since we expect ~11 change points, we look for spikes in the residuals of a   
local fit                                                                       
# or just look at the raw changes in x_dot.                                     
residuals = np.linalg.norm(np.diff(x_dot, axis=0), axis=1)                      
change_point_indices = np.where(residuals > np.percentile(residuals, 99))[0]    
                                                                                
# Refine change points (keep them separated)                                    
refined_indices = []                                                            
if len(change_point_indices) > 0:                                               
    refined_indices.append(change_point_indices[0])                             
    for idx in change_point_indices[1:]:                                        
        if idx - refined_indices[-1] > 10:                                      
            refined_indices.append(idx)                                         
                                                                                
print(f"Detected {len(refined_indices)} change points.")                        
print(f"Indices: {refined_indices}")                                            
                                                                                
# Segment the data                                                              
segments = []                                                                   
start = 0                                                                       
for idx in refined_indices:                                                     
    segments.append((start, idx))                                               
    start = idx + 1                                                             
segments.append((start, len(x_mid)))                                            
                                                                                
# Filter for large segments                                                     
large_segments = [s for s in segments if s[1] - s[0] > 20]                      
                                                                                
def estimate_params(seg_x, seg_x_dot):                                          
    # x1' = a*x1 - b*x1*x2  => x1' = [x1, -x1*x2] * [a, b]^T                    
    # x2' = d*x1*x2 - g*x2  => x2' = [x1*x2, -x2] * [d, g]^T                    
    x1 = seg_x[:, 0]                                                            
    x2 = seg_x[:, 1]                                                            
    x1_dot = seg_x_dot[:, 0]                                                    
    x2_dot = seg_x_dot[:, 1]                                                    
                                                                                
    A1 = np.column_stack([x1, -x1*x2])                                          
    params1, _, _, _ = np.linalg.lstsq(A1, x1_dot, rcond=None)                  
                                                                                
    A2 = np.column_stack([x1*x2, -x2])                                          
    params2, _, _, _ = np.linalg.lstsq(A2, x2_dot, rcond=None)                  
                                                                                
    return params1[0], params1[1], params2[0], params2[1]                       
                                                                                
results = []                                                                    
for i, (s, e) in enumerate(large_segments):                                     
    alpha, beta, delta, gamma = estimate_params(x_mid[s:e], x_dot[s:e])         
    results.append({                                                            
        'segment': i,                                                           
        'range': (s, e),                                                        
        'params': (alpha, beta, delta, gamma),                                  
        'end_state': x[e]                                                       
    })                                                                          
    print(f"Segment {i} ({s}-{e}): alpha={alpha:.2f}, beta={beta:.2f},          
delta={delta:.2f}, gamma={gamma:.2f}")                                          
                                                                                
# Look at guards (transition logic)                                             
for i in range(len(large_segments) - 1):                                        
    trans_idx = large_segments[i][1]                                            
    print(f"Transition {i}->{i+1} at x={x[trans_idx]}")                         
                                                                                
final_answer({                                                                  
    "Task outcome (short version)": "Identified 11 change points and estimated  
Lotka-Volterra coefficients for the primary modes.",                            
