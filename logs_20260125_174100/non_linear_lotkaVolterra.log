import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
states = data['state'] # Shape [T, 2]                                           
x1 = states[:, 0]                                                               
x2 = states[:, 1]                                                               
T = len(x1)                                                                     
                                                                                
# Function to estimate parameters for a segment                                 
def estimate_params(s1, s2):                                                    
    # s1, s2 are trajectories of x1, x2 for the segment                         
    # x1[t+1] = a*x1[t] - b*x1[t]*x2[t]                                         
    # x2[t+1] = c*x1[t]*x2[t] - d*x2[t]                                         
                                                                                
    Y1 = s1[1:]                                                                 
    X1 = np.column_stack([s1[:-1], -s1[:-1] * s2[:-1]])                         
    a_b, _, _, _ = np.linalg.lstsq(X1, Y1, rcond=None)                          
                                                                                
    Y2 = s2[1:]                                                                 
    X2 = np.column_stack([s1[:-1] * s2[:-1], -s2[:-1]])                         
    c_d, _, _, _ = np.linalg.lstsq(X2, Y2, rcond=None)                          
                                                                                
    return a_b[0], a_b[1], c_d[0], c_d[1]                                       
                                                                                
# Sliding window to detect jumps in parameters                                  
window = 20                                                                     
param_history = []                                                              
for t in range(T - window):                                                     
    p = estimate_params(x1[t:t+window], x2[t:t+window])                         
    param_history.append(p)                                                     
                                                                                
param_history = np.array(param_history)                                         
diffs = np.linalg.norm(np.diff(param_history, axis=0), axis=1)                  
                                                                                
# Identify change points (peaks in diffs)                                       
change_points = []                                                              
threshold = np.percentile(diffs, 95) # Heuristic                                
for i in range(1, len(diffs) - 1):                                              
    if diffs[i] > threshold and diffs[i] > diffs[i-1] and diffs[i] > diffs[i+1]:
        # Map back to original time index.                                      
        # Window-based estimation shifts the change point signal.               
        # We'll refine the point by looking for the jump in state dynamics.     
        change_points.append(i + window // 2)                                   
                                                                                
# Merge close points and ensure we have ~11 as per prompt hint                  
refined_points = []                                                             
if change_points:                                                               
    refined_points.append(change_points[0])                                     
    for p in change_points[1:]:                                                 
        if p - refined_points[-1] > 30:                                         
            refined_points.append(p)                                            
                                                                                
# We want roughly 11 segments -> 10 change points                               
# Let's adjust if needed, but start with these.                                 
segments = [0] + refined_points + [T]                                           
                                                                                
