import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load state data                                                               
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate increments                                                          
dx1 = x1[1:] - x1[:-1]                                                          
dx2 = x2[1:] - x2[:-1]                                                          
                                                                                
# Denominators for both models                                                  
den1 = x1[:-1] * (1 - x2[:-1])                                                  
den2 = x2[:-1] * (x1[:-1] - 1)                                                  
                                                                                
# Estimate alpha and delta assuming the second model (more likely for           
continuous-like systems)                                                        
# alpha = (x1[k+1] - x1[k]) / (x1[k]*(1 - x2[k]))                               
alpha_est = dx1 / den1                                                          
delta_est = dx2 / den2                                                          
                                                                                
# Visualize estimated parameters to find jumps                                  
plt.figure(figsize=(12, 6))                                                     
plt.subplot(2, 1, 1)                                                            
plt.plot(alpha_est)                                                             
plt.title('Estimated alpha')                                                    
plt.subplot(2, 1, 2)                                                            
plt.plot(delta_est)                                                             
plt.title('Estimated delta')                                                    
plt.tight_layout()                                                              
plt.savefig('params.png')                                                       
                                                                                
# Identify transition points by looking for large changes in parameters         
alpha_diff = np.abs(np.diff(alpha_est))                                         
delta_diff = np.abs(np.diff(delta_est))                                         
                                                                                
# Print first few estimates to check values                                     
print("First 10 alpha_est:", alpha_est[:10])                                    
print("First 10 delta_est:", delta_est[:10])                                    
                                                                                
# Find indices where the change in parameters is significant                    
threshold = 0.001                                                               
change_indices = np.where((alpha_diff > threshold) | (delta_diff >              
threshold))[0] + 1                                                              
print("Change indices:", change_indices)                                        
                                                                                
# If change_indices is too large, it might be noise; let's filter               
if len(change_indices) > 0:                                                     
    # Filter to get distinct transition points                                  
    transitions = [change_indices[0]]                                           
    for i in range(1, len(change_indices)):                                     
        if change_indices[i] - transitions[-1] > 10:                            
            transitions.append(change_indices[i])                               
    print("Filtered transitions:", transitions)                                 
                                                                                
