segment_params = []                                                             
for i in range(len(segments) - 1):                                              
    start, end = segments[i], segments[i+1]                                     
    # Small buffer to avoid the transition itself                               
    if end - start > 10:                                                        
        s1 = x1[start+5 : end-5]                                                
        s2 = x2[start+5 : end-5]                                                
        sd1 = dx1[start+5 : end-5]                                              
        sd2 = dx2[start+5 : end-5]                                              
                                                                                
        A1 = np.stack([s1, -s1*s2], axis=1)                                     
        p1, _, _, _ = np.linalg.lstsq(A1, sd1, rcond=None)                      
        A2 = np.stack([s1*s2, -s2], axis=1)                                     
        p2, _, _, _ = np.linalg.lstsq(A2, sd2, rcond=None)                      
        segment_params.append((p1[0], p1[1], p2[0], p2[1]))                     
    else:                                                                       
        # Segment too short, just fit anyway                                    
        s1 = x1[start : end]                                                    
        s2 = x2[start : end]                                                    
        sd1 = dx1[start : end]                                                  
        sd2 = dx2[start : end]                                                  
        A1 = np.stack([s1, -s1*s2], axis=1)                                     
        p1, _, _, _ = np.linalg.lstsq(A1, sd1, rcond=None)                      
        A2 = np.stack([s1*s2, -s2], axis=1)                                     
        p2, _, _, _ = np.linalg.lstsq(A2, sd2, rcond=None)                      
        segment_params.append((p1[0], p1[1], p2[0], p2[1]))                     
                                                                                
for i, p in enumerate(segment_params):                                          
    print(f"Segment {i} (t={segments[i]*dt:.2f} to {segments[i+1]*dt:.2f}):     
a={p[0]:.2f}, b={p[1]:.2f}, c={p[2]:.2f}, d={p[3]:.2f}")                        
                                                                                
# Guard conditions: check x1, x2 at transitions                                 
print("\nTransition values:")                                                   
for cp in sorted(change_point_indices):                                         
    print(f"t={cp*dt:.2f}: x1={x1[cp]:.4f}, x2={x2[cp]:.4f}")                   
                                                                                
