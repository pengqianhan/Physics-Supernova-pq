import numpy as np                                                              
from scipy import linalg                                                        
                                                                                
def analyze_file(path):                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1, x2 = state[0], state[1]                                                 
                                                                                
    # Calculate ratios to detect transitions                                    
    # x1[k+1] = a*x1[k] + b*x1[k]*x2[k] => x1[k+1]/x1[k] = a + b*x2[k]          
    # x2[k+1] = c*x1[k]*x2[k] + d*x2[k] => x2[k+1]/x2[k] = c*x1[k] + d          
                                                                                
    r1 = x1[1:] / x1[:-1]                                                       
    r2 = x2[1:] / x2[:-1]                                                       
                                                                                
    # Differences of ratios to find discontinuities                             
    dr1 = np.abs(np.diff(r1))                                                   
    dr2 = np.abs(np.diff(r2))                                                   
                                                                                
    # Combine differences                                                       
    dr = dr1 + dr2                                                              
                                                                                
    # Find indices of transitions                                               
    # Using a threshold for "jumps"                                             
    threshold = np.mean(dr) + 5 * np.std(dr)                                    
    indices = np.where(dr > threshold)[0]                                       
                                                                                
    refined_indices = []                                                        
    if len(indices) > 0:                                                        
        refined_indices.append(indices[0] + 1) # +1 because of diff             
        for idx in indices[1:]:                                                 
            if idx + 1 - refined_indices[-1] > 50:                              
                refined_indices.append(idx + 1)                                 
                                                                                
    return x1, x2, refined_indices                                              
                                                                                
