import numpy as np                                                              
from scipy import linalg                                                        
from scipy.ndimage import median_filter                                         
                                                                                
def analyze_hybrid_system(file_path):                                           
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1, x2 = state[0], state[1]                                                 
                                                                                
    # 1. Fit known segments to extract primary modes (using findings from       
previous steps)                                                                 
    # Mode 0 (Normal): a=1.003, b=-0.003, c=0.001, d=0.999                      
    # Mode 1 (Alternative): a=1.002, b=-0.002, c=0.0005, d=0.9995               
    m0 = [1.003, -0.003, 0.001, 0.999]                                          
    m1 = [1.002, -0.002, 0.0005, 0.9995]                                        
                                                                                
    def get_residuals(coeffs):                                                  
        a, b, c, d = coeffs                                                     
        pred1 = a * x1[:-1] + b * x1[:-1] * x2[:-1]                             
        pred2 = c * x1[:-1] * x2[:-1] + d * x2[:-1]                             
        return (x1[1:] - pred1)**2 + (x2[1:] - pred2)**2                        
                                                                                
    err0 = get_residuals(m0)                                                    
    err1 = get_residuals(m1)                                                    
                                                                                
    # Determine which mode is active at each point                              
    better_mode = (err1 < err0).astype(int)                                     
    # Smoothing to find robust transitions                                      
    filtered_mode = median_filter(better_mode, size=51)                         
                                                                                
    # Detect transition indices                                                 
    trans_indices = np.where(np.diff(filtered_mode) != 0)[0]                    
                                                                                
    return trans_indices, filtered_mode, x1, x2                                 
                                                                                
# Perform analysis on Sample 0                                                  
