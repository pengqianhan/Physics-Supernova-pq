import numpy as np                                                              
                                                                                
def get_change_points(state, window=20, threshold_pct=99.5):                    
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    T = len(x1)                                                                 
    errors = []                                                                 
    for i in range(window, T - 1):                                              
        Y1 = x1[i-window+1:i+1]                                                 
        X1 = np.vstack([x1[i-window:i], -x1[i-window:i]*x2[i-window:i]]).T      
        p1, _, _, _ = np.linalg.lstsq(X1, Y1, rcond=None)                       
        Y2 = x2[i-window+1:i+1]                                                 
        X2 = np.vstack([x1[i-window:i]*x2[i-window:i], -x2[i-window:i]]).T      
        p2, _, _, _ = np.linalg.lstsq(X2, Y2, rcond=None)                       
        pred1 = p1[0]*x1[i] - p1[1]*x1[i]*x2[i]                                 
        pred2 = p2[0]*x1[i]*x2[i] - p2[1]*x2[i]                                 
        err = (pred1 - x1[i+1])**2 + (pred2 - x2[i+1])**2                       
        errors.append(err)                                                      
    errors = np.array(errors)                                                   
    threshold = np.percentile(errors, threshold_pct)                            
    potential_indices = np.where(errors > threshold)[0] + window                
    change_points = []                                                          
    if len(potential_indices) > 0:                                              
        change_points.append(potential_indices[0])                              
        for idx in potential_indices[1:]:                                       
            if idx - change_points[-1] > window:                                
                change_points.append(idx)                                       
    return change_points                                                        
                                                                                
