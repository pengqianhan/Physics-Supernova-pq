import numpy as np                                                              
from scipy import linalg                                                        
                                                                                
# Define the two candidate modes based on previous findings                     
# Mode 0 (Normal): a=1.003, b=-0.003, c=0.001, d=0.999                          
# Mode 1 (Alternative): a=1.002, b=-0.002, c=0.0005, d=0.9995                   
                                                                                
m0 = [1.003, -0.003, 0.001, 0.999]                                              
m1 = [1.002, -0.002, 0.0005, 0.9995]                                            
                                                                                
def get_mode_residuals(x1, x2, coeffs):                                         
    a, b, c, d = coeffs                                                         
    x1_next_pred = a * x1[:-1] + b * x1[:-1] * x2[:-1]                          
    x2_next_pred = c * x1[:-1] * x2[:-1] + d * x2[:-1]                          
    res1 = np.abs(x1[1:] - x1_next_pred)                                        
    res2 = np.abs(x2[1:] - x2_next_pred)                                        
    return res1 + res2                                                          
                                                                                
def find_all_transitions(path):                                                 
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1, x2 = state[0], state[1]                                                 
                                                                                
    r0 = get_mode_residuals(x1, x2, m0)                                         
    r1 = get_mode_residuals(x1, x2, m1)                                         
                                                                                
    # At each point, see which mode fits better                                 
    # But mode transitions are discrete, so we look for where the 'better' mode 
switches                                                                        
    current_mode = 0 if r0[0] < r1[0] else 1                                    
    transitions = []                                                            
                                                                                
    # Use a small window to avoid noise                                         
    win = 10                                                                    
    for i in range(len(r0) - win):                                              
        m0_err = np.mean(r0[i:i+win])                                           
        m1_err = np.mean(r1[i:i+win])                                           
        new_mode = 0 if m0_err < m1_err else 1                                  
        if new_mode != current_mode:                                            
            transitions.append(i + win//2)                                      
            current_mode = new_mode                                             
                                                                                
    return transitions, x1, x2                                                  
                                                                                
for i in range(3):                                                              
