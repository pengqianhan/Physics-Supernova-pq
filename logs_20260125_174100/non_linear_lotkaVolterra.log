    peak_heights = diffs[peaks]                                                 
    largest_peaks_indices = np.argsort(peak_heights)[-11:]                      
    largest_peaks_indices = np.sort(largest_peaks_indices)                      
    change_point_indices = [times[peaks[p]] for p in largest_peaks_indices]     
    print("Top 11 change point indices:", change_point_indices)                 
                                                                                
# Segment the data and fit each segment                                         
