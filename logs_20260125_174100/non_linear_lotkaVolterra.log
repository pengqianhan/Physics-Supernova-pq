import numpy as np                                                              
                                                                                
def find_exact_change_points(s):                                                
    x1, x2 = s[0], s[1]                                                         
    # Mode 0 params                                                             
    a0, b0, d0, g0 = 1.003, 0.003, 0.001, -0.999                                
    # Mode 1 params                                                             
    a1, b1, d1, g1 = 1.002, 0.002, 0.0005, -0.9995                              
                                                                                
    modes = []                                                                  
    change_points = []                                                          
                                                                                
    current_mode = 0                                                            
    for k in range(len(x1)-1):                                                  
        # Predict with Mode 0                                                   
        p0_x1 = a0*x1[k] - b0*x1[k]*x2[k]                                       
        p0_x2 = d0*x1[k]*x2[k] - g0*x2[k]                                       
        err0 = (x1[k+1]-p0_x1)**2 + (x2[k+1]-p0_x2)**2                          
                                                                                
        # Predict with Mode 1                                                   
        p1_x1 = a1*x1[k] - b1*x1[k]*x2[k]                                       
        p1_x2 = d1*x1[k]*x2[k] - g1*x2[k]                                       
        err1 = (x1[k+1]-p1_x1)**2 + (x2[k+1]-p1_x2)**2                          
                                                                                
        new_mode = 0 if err0 < err1 else 1                                      
        if new_mode != current_mode:                                            
            change_points.append((k, current_mode, new_mode, x1[k], x2[k]))     
            current_mode = new_mode                                             
                                                                                
    return change_points                                                        
                                                                                
