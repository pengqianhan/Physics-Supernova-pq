import numpy as np                                                              
from scipy import linalg                                                        
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    N = state.shape[1]                                                          
                                                                                
    # 1. Detect state jumps (resets)                                            
    dx1 = np.abs(np.diff(x1))                                                   
    dx2 = np.abs(np.diff(x2))                                                   
    jumps = np.where((dx1 > 0.1) | (dx2 > 0.1))[0]                              
                                                                                
    # 2. Group jumps that are very close (same transition)                      
    refined_transitions = []                                                    
    if len(jumps) > 0:                                                          
        refined_transitions.append(jumps[0])                                    
        for i in range(1, len(jumps)):                                          
            if jumps[i] - refined_transitions[-1] > 20:                         
                refined_transitions.append(jumps[i])                            
                                                                                
    return refined_transitions, x1, x2                                          
                                                                                
all_trans = []                                                                  
for p in ['data_all/non_linear/lotkaVolterra/sample_0.npz',                     
          'data_all/non_linear/lotkaVolterra/sample_1.npz',                     
          'data_all/non_linear/lotkaVolterra/sample_2.npz']:                    
    trans, x1, x2 = analyze_sample(p)                                           
    all_trans.append(trans)                                                     
    print(f"File {p}: Transitions at indices {trans}")                          
                                                                                
# Use sample_0 for detailed analysis                                            
