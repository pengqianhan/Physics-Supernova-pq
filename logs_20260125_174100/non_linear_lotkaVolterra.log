│                 "eq": "x1[1\] = -x1[0\] - 3"                                 │
│             }                                                                │
│         ],                                                                   │
│         "edge": [                                                            │
│             {                                                                │
│                 "direction": "1 -> 2",                                       │
│                 "condition": "x1 >= 4"                                       │
│             },                                                               │
│             {                                                                │
│                 "direction": "2 -> 1",                                       │
│                 "condition": "x1 <= 9"                                       │
│             }                                                                │
│         \]                                                                   │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.01,                                                          │
