Thought: I will load all the samples, calculate the $\alpha$ and $\beta$        
parameters for each using numerical differentiation (assuming a time step of    
0.01), and check if they remain constant or change over time. I will also check 
for any state resets by looking for large jumps in the state trajectories.      
                                                                                
<code>                                                                          
import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
results = []                                                                    
                                                                                
for i in range(3):                                                              
    data = np.load(f'data_all/non_linear/lotkaVolterra/sample_{i}.npz')         
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Numerical derivatives                                                     
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    # Average x values for the intervals                                        
    x1_m = (x1[:-1] + x1[1:]) / 2                                               
    x2_m = (x2[:-1] + x2[1:]) / 2                                               
                                                                                
    # alpha = dx1/dt / (x1 * (1 - x2))                                          
    # beta = dx2/dt / (x2 * (x1 - 1))                                           
                                                                                
    # To avoid division by zero or very small numbers, use a robust mean        
    # Or just inspect a few segments                                            
    denom_alpha = x1_m * (1 - x2_m)                                             
    denom_beta = x2_m * (x1_m - 1)                                              
                                                                                
    alpha = dx1 / denom_alpha                                                   
    beta = dx2 / denom_beta                                                     
                                                                                
    # Check for resets:                                                         
    jumps = np.max(np.abs(np.diff(state, axis=1)), axis=0)                      
    max_jump = np.max(jumps)                                                    
                                                                                
    results.append({                                                            
        'sample': i,                                                            
        'alpha_start': np.median(alpha[:500]),                                  
        'alpha_end': np.median(alpha[-500:]),                                   
        'beta_start': np.median(beta[:500]),                                    
        'beta_end': np.median(beta[-500:]),                                     
        'max_jump': max_jump,                                                   
        'alpha_std': np.std(alpha),                                             
        'beta_std': np.std(beta)                                                
    })                                                                          
                                                                                
for res in results:                                                             
    print(res)                                                                  
                                                                                
