import numpy as np                                                              
                                                                                
# Load all data files to inspect                                                
data_files = [np.load(path) for path in DATA_FILE_PATHS]                        
                                                                                
# Use the first file for analysis                                               
data = data_files[0]                                                            
state = data['state']                                                           
# Shape is (2, 10001), transpose to (10001, 2)                                  
x = state.T                                                                     
t = np.linspace(0, 10, x.shape[0])                                              
dt = t[1] - t[0]                                                                
                                                                                
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
# Calculate numerical derivatives                                               
dx1 = np.gradient(x1, dt)                                                       
dx2 = np.gradient(x2, dt)                                                       
                                                                                
# Identify change points.                                                       
# We look for discontinuities in the derivatives or where the LV model          
parameters change.                                                              
# Let's compute local parameters using a small window                           
window_size = 50                                                                
params_list = []                                                                
                                                                                
for i in range(0, len(t) - window_size, window_size // 2):                      
    X1 = x1[i:i+window_size]                                                    
    X2 = x2[i:i+window_size]                                                    
    dX1 = dx1[i:i+window_size]                                                  
    dX2 = dx2[i:i+window_size]                                                  
                                                                                
    # Model: dX1 = alpha*X1 - beta*X1*X2                                        
    #        dX2 = delta*X1*X2 - gamma*X2                                       
    # Solve for alpha, beta: [X1, -X1*X2] * [alpha, beta]^T = dX1               
    # Solve for delta, gamma: [X1*X2, -X2] * [delta, gamma]^T = dX2             
                                                                                
    A1 = np.vstack([X1, -X1*X2]).T                                              
    p1, _, _, _ = np.linalg.lstsq(A1, dX1, rcond=None)                          
                                                                                
    A2 = np.vstack([X1*X2, -X2]).T                                              
    p2, _, _, _ = np.linalg.lstsq(A2, dX2, rcond=None)                          
                                                                                
    params_list.append((t[i + window_size//2], p1[0], p1[1], p2[0], p2[1]))     
                                                                                
# Convert to array for easy analysis                                            
params_array = np.array(params_list)                                            
                                                                                
# Find change points by looking at the variance of the parameters               
# Or simply check the residuals of a global fit vs local                        
print("Param stats - Min Alpha:", np.min(params_array[:, 1]), "Max Alpha:",     
np.max(params_array[:, 1]))                                                     
print("Param stats - Min Beta:", np.min(params_array[:, 2]), "Max Beta:",       
np.max(params_array[:, 2]))                                                     
                                                                                
