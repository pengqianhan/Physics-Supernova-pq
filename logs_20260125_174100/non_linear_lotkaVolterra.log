Lotka-Volterra parameters ($\alpha, \beta, \delta, \gamma$) over time. This will
help identify different operating modes and the conditions under which they     
change.                                                                         
                                                                                
<code>                                                                          
import numpy as np                                                              
from scipy import stats                                                         
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
                                                                                
# Calculate differences (assume dt = 1 for relative parameter estimation)       
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
x1_mid = (x1[:-1] + x1[1:]) / 2                                                 
x2_mid = (x2[:-1] + x2[1:]) / 2                                                 
                                                                                
# Sliding window estimation                                                     
window_size = 200                                                               
step_size = 50                                                                  
n_points = len(dx1)                                                             
results = []                                                                    
                                                                                
for i in range(0, n_points - window_size, step_size):                           
    idx = slice(i, i + window_size)                                             
                                                                                
    # Equation 1: dx1 = alpha*x1 - beta*x1*x2                                   
    # Y1 = [dx1], A1 = [[x1, -x1*x2]]                                           
    Y1 = dx1[idx]                                                               
    A1 = np.column_stack([x1_mid[idx], -x1_mid[idx]*x2_mid[idx]])               
    params1, _, _, _ = np.linalg.lstsq(A1, Y1, rcond=None)                      
                                                                                
    # Equation 2: dx2 = delta*x1*x2 - gamma*x2                                  
    # Y2 = [dx2], A2 = [[x1*x2, -x2]]                                           
    Y2 = dx2[idx]                                                               
    A2 = np.column_stack([x1_mid[idx]*x2_mid[idx], -x2_mid[idx]])               
    params2, _, _, _ = np.linalg.lstsq(A2, Y2, rcond=None)                      
                                                                                
    results.append({                                                            
        'index': i + window_size // 2,                                          
        'alpha': params1[0],                                                    
        'beta': params1[1],                                                     
        'delta': params2[0],                                                    
        'gamma': params2[1],                                                    
        'x1': x1_mid[i + window_size // 2],                                     
        'x2': x2_mid[i + window_size // 2]                                      
    })                                                                          
                                                                                
import pandas as pd                                                             
df = pd.DataFrame(results)                                                      
print(df.head(20))                                                              
print(df.tail(20))                                                              
                                                                                
# Check for regime changes by looking at variations in parameters               
print("Parameter stats:")                                                       
print(df[['alpha', 'beta', 'delta', 'gamma']].describe())                       
                                                                                
