import numpy as np                                                              
                                                                                
def identify_modes_fine(path):                                                  
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1, x2 = state[0], state[1]                                                 
                                                                                
    # Modes                                                                     
    m0 = [1.003, -0.003, 0.001, 0.999]                                          
    m1 = [1.002, -0.002, 0.0005, 0.9995]                                        
                                                                                
    def err(x1_c, x2_c, x1_n, x2_n, m):                                         
        p1 = m[0]*x1_c + m[1]*x1_c*x2_c                                         
        p2 = m[2]*x1_c*x2_c + m[3]*x2_c                                         
        return (x1_n - p1)**2 + (x2_n - p2)**2                                  
                                                                                
    mode_map = []                                                               
    for i in range(len(x1)-1):                                                  
        e0 = err(x1[i], x2[i], x1[i+1], x2[i+1], m0)                            
        e1 = err(x1[i], x2[i], x1[i+1], x2[i+1], m1)                            
        mode_map.append(0 if e0 < e1 else 1)                                    
                                                                                
    # Filter mode map to remove noise (majority vote in window)                 
    filtered_modes = []                                                         
    w = 11                                                                      
    for i in range(len(mode_map)):                                              
        start = max(0, i - w//2)                                                
        end = min(len(mode_map), i + w//2 + 1)                                  
        window = mode_map[start:end]                                            
        filtered_modes.append(1 if sum(window) > len(window)/2 else 0)          
                                                                                
    # Find transitions                                                          
    transitions = []                                                            
    for i in range(1, len(filtered_modes)):                                     
        if filtered_modes[i] != filtered_modes[i-1]:                            
            transitions.append(i)                                               
                                                                                
    return transitions, filtered_modes, x1, x2                                  
                                                                                
for i in range(3):                                                              
    trans, f_modes, x1, x2 =                                                    
identify_modes_fine(f'data_all/non_linear/lotkaVolterra/sample_{i}.npz')        
    print(f"Sample {i}: {len(trans)} transitions at {trans}")                   
    # Print state at transitions                                                
    states = [(x1[t], x2[t]) for t in trans]                                    
    print(f"States: {states}")                                                  
                                                                                
