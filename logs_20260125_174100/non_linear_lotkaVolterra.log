import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
                                                                                
def analyze_sample(sample_idx):                                                 
    data = np.load(f'data_all/non_linear/lotkaVolterra/sample_{sample_idx}.npz')
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Numerical derivatives                                                     
    dx1_dt = np.diff(x1) / dt                                                   
    dx2_dt = np.diff(x2) / dt                                                   
                                                                                
    # Midpoints for alignment                                                   
    x1_m = (x1[:-1] + x1[1:]) / 2                                               
    x2_m = (x2[:-1] + x2[1:]) / 2                                               
                                                                                
    # Estimate alpha and beta                                                   
    # dx1/dt = alpha * x1 * (1 - x2) => alpha = (dx1/dt) / (x1 * (1 - x2))      
    # dx2/dt = beta * x2 * (x1 - 1) => beta = (dx2/dt) / (x2 * (x1 - 1))        
    alpha = dx1_dt / (x1_m * (1 - x2_m))                                        
    beta = dx2_dt / (x2_m * (x1_m - 1))                                         
                                                                                
    # Detect jumps in alpha                                                     
    alpha_diff = np.abs(np.diff(alpha))                                         
    # Use a threshold for jumps                                                 
    threshold = 5 * np.std(alpha_diff)                                          
    jump_indices = np.where(alpha_diff > threshold)[0]                          
                                                                                
    # Refine jumps: sometimes multiple indices are found for one jump           
    refined_jumps = []                                                          
    if len(jump_indices) > 0:                                                   
        refined_jumps.append(jump_indices[0])                                   
        for i in range(1, len(jump_indices)):                                   
            if jump_indices[i] > jump_indices[i-1] + 10:                        
                refined_jumps.append(jump_indices[i])                           
                                                                                
    # Define segments                                                           
    segments = []                                                               
    start = 0                                                                   
    for jump in refined_jumps:                                                  
        segments.append((start, jump))                                          
        start = jump + 1                                                        
    segments.append((start, len(alpha) - 1))                                    
                                                                                
    seg_results = []                                                            
    for s, e in segments:                                                       
        if e - s < 20: continue # ignore tiny segments                          
        seg_alpha = np.median(alpha[s:e+1])                                     
        seg_beta = np.median(beta[s:e+1])                                       
        # Switch condition state (end of segment)                               
        switch_state = (x1[e], x2[e])                                           
        seg_results.append({                                                    
            'range': (s, e),                                                    
            'alpha': seg_alpha,                                                 
            'beta': seg_beta,                                                   
            'end_state': switch_state                                           
        })                                                                      
                                                                                
    return seg_results                                                          
                                                                                
all_samples_results = {}                                                        
for i in range(3):                                                              
    all_samples_results[f'sample_{i}'] = analyze_sample(i)                      
                                                                                
for s, res in all_samples_results.items():                                      
    print(f"Results for {s}:")                                                  
    for seg in res:                                                             
        print(seg)                                                              
                                                                                
