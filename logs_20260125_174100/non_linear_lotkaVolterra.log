end-1]])                                                                        
                                                                                
    a_b = np.linalg.lstsq(X1, Y1, rcond=None)[0]                                
    c_d = np.linalg.lstsq(X2, Y2, rcond=None)[0]                                
                                                                                
    results.append({                                                            
