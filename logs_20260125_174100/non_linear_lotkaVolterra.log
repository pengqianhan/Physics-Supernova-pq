```python                                                                       
import numpy as np                                                              
                                                                                
def fit_local(x1_seg, x2_seg, dx1_seg, dx2_seg):                                
    # dx1 = a*x1 - b*x1*x2                                                      
    # [x1, -x1*x2] * [a, b]^T = dx1                                             
    A1 = np.stack([x1_seg, -x1_seg * x2_seg], axis=1)                           
    p1, _, _, _ = np.linalg.lstsq(A1, dx1_seg, rcond=None)                      
    # dx2 = c*x1*x2 - d*x2                                                      
    # [x1*x2, -x2] * [c, d]^T = dx2                                             
    A2 = np.stack([x1_seg * x2_seg, -x2_seg], axis=1)                           
    p2, _, _, _ = np.linalg.lstsq(A2, dx2_seg, rcond=None)                      
    return p1[0], p1[1], p2[0], p2[1] # a, b, c, d                              
```                                                                             
                                                                                
