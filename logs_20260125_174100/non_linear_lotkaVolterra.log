import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
t = data['t']                                                                   
x = data['x']  # Shape likely (N, 2)                                            
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
# Prepare for parameter estimation                                              
# Equations:                                                                    
# x1[k+1] = alpha * x1[k] - beta * x1[k] * x2[k]                                
# x2[k+1] = delta * x1[k] * x2[k] - gamma * x2[k]                               
                                                                                
# We can find segments by looking at the residuals of a local fit               
# or by calculating rolling parameters.                                         
n = len(t)                                                                      
alphas, betas, deltas, gammas = [], [], [], []                                  
                                                                                
for i in range(n - 1):                                                          
    # For a single step, we have 2 equations and 4 unknowns? No, we need more   
points.                                                                         
    # Actually, per step k:                                                     
    # x1[k+1] = alpha*x1[k] - beta*x1[k]*x2[k]                                  
    # x2[k+1] = delta*x1[k]*x2[k] - gamma*x2[k]                                 
    # This is 2 equations for 2 pairs of parameters.                            
    # To solve for (alpha, beta) we need at least 2 steps, or assume they are   
constant.                                                                       
    pass                                                                        
                                                                                
# Let's use a sliding window to find where parameters change                    
window_size = 5                                                                 
params_list = []                                                                
for i in range(n - window_size):                                                
    X1_curr = x1[i:i+window_size]                                               
    X2_curr = x2[i:i+window_size]                                               
    X1_next = x1[i+1:i+window_size+1]                                           
    X2_next = x2[i+1:i+window_size+1]                                           
                                                                                
    # Solve for alpha, beta: X1_next = alpha * X1_curr - beta * (X1_curr *      
X2_curr)                                                                        
    # A * [alpha, beta]^T = X1_next where A = [X1_curr, -X1_curr*X2_curr]       
    A_1 = np.vstack([X1_curr, -X1_curr * X2_curr]).T                            
    p1, _, _, _ = np.linalg.lstsq(A_1, X1_next, rcond=None)                     
                                                                                
    # Solve for delta, gamma: X2_next = delta * (X1_curr * X2_curr) - gamma *   
X2_curr                                                                         
    # A * [delta, gamma]^T = X2_next where A = [X1_curr*X2_curr, -X2_curr]      
    A_2 = np.vstack([X1_curr * X2_curr, -X2_curr]).T                            
    p2, _, _, _ = np.linalg.lstsq(A_2, X2_next, rcond=None)                     
                                                                                
    params_list.append(np.concatenate([p1, p2]))                                
                                                                                
params_arr = np.array(params_list)                                              
# Detect change points by looking at the derivative of parameters               
diffs = np.sum(np.abs(np.diff(params_arr, axis=0)), axis=1)                     
change_points = np.where(diffs > np.percentile(diffs, 95))[0]                   
# Cluster change points                                                         
clusters = []                                                                   
if len(change_points) > 0:                                                      
    curr_cluster = [change_points[0]]                                           
    for i in range(1, len(change_points)):                                      
        if change_points[i] - change_points[i-1] < 10:                          
            curr_cluster.append(change_points[i])                               
        else:                                                                   
            clusters.append(int(np.mean(curr_cluster)))                         
            curr_cluster = [change_points[i]]                                   
    clusters.append(int(np.mean(curr_cluster)))                                 
                                                                                
print("Change point indices:", clusters)                                        
                                                                                
# Now estimate parameters for each segment                                      
segments = [0] + clusters + [n-1]                                               
results = []                                                                    
for i in range(len(segments)-1):                                                
    idx_start = segments[i]                                                     
    idx_end = segments[i+1]                                                     
    if idx_end - idx_start < 2: continue                                        
                                                                                
    X1_c = x1[idx_start:idx_end]                                                
    X2_c = x2[idx_start:idx_end]                                                
    X1_n = x1[idx_start+1:idx_end+1]                                            
    X2_n = x2[idx_start+1:idx_end+1]                                            
                                                                                
    A1 = np.vstack([X1_c, -X1_c * X2_c]).T                                      
    p1, _, _, _ = np.linalg.lstsq(A1, X1_n, rcond=None)                         
    A2 = np.vstack([X1_c * X2_c, -X2_c]).T                                      
    p2, _, _, _ = np.linalg.lstsq(A2, X2_n, rcond=None)                         
                                                                                
    results.append({                                                            
        'start': idx_start,                                                     
        'end': idx_end,                                                         
        'alpha': p1[0], 'beta': p1[1], 'delta': p2[0], 'gamma': p2[1],          
        'x1_start': x1[idx_start], 'x2_start': x2[idx_start],                   
        'x1_end': x1[idx_end], 'x2_end': x2[idx_end]                            
    })                                                                          
                                                                                
for r in results:                                                               
    print(r)                                                                    
                                                                                
