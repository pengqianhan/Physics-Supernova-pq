import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the data                                                                 
data = np.load('data_all/non_linear/lotkaVolterra/sample_0.npz')                
t = data['t']                                                                   
x = data['x']  # Assuming x is (N, 2)                                           
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
                                                                                
# Numerical differentiation                                                     
dt = np.diff(t)                                                                 
dx1_dt = np.diff(x1) / dt                                                       
dx2_dt = np.diff(x2) / dt                                                       
t_mid = t[:-1] + dt/2                                                           
x1_mid = (x1[:-1] + x1[1:]) / 2                                                 
x2_mid = (x2[:-1] + x2[1:]) / 2                                                 
                                                                                
# To identify change points, we can estimate local parameters (a, c)            
# assuming dx1/dt = a * (x1 - x1*x2) and dx2/dt = c * (x1*x2 - x2)              
# since a=b and c=d.                                                            
# Let's compute a_local and c_local                                             
a_local = dx1_dt / (x1_mid - x1_mid * x2_mid)                                   
c_local = dx2_dt / (x1_mid * x2_mid - x2_mid)                                   
                                                                                
print(f"Data length: {len(t)}")                                                 
print(f"Time range: {t[0]} to {t[-1]}")                                         
                                                                                
# Identify change points by looking for jumps in local parameters               
# Using a median filter or looking at the difference                            
diff_a = np.abs(np.diff(a_local))                                               
# Threshold for jump detection                                                  
threshold = np.percentile(diff_a, 99) # Top 1% of changes                       
change_indices = np.where(diff_a > threshold)[0]                                
                                                                                
# Filter change indices to ensure we don't pick adjacent points                 
filtered_changes = []                                                           
if len(change_indices) > 0:                                                     
    filtered_changes.append(change_indices[0])                                  
    for idx in change_indices[1:]:                                              
        if idx - filtered_changes[-1] > 20: # Minimum segment length            
            filtered_changes.append(idx)                                        
                                                                                
print(f"Detected change point indices: {filtered_changes}")                     
print(f"Number of segments: {len(filtered_changes) + 1}")                       
                                                                                
# Fit parameters for each segment                                               
segments = []                                                                   
start_idx = 0                                                                   
for end_idx in filtered_changes + [len(t_mid)]:                                 
    seg_x1 = x1_mid[start_idx:end_idx]                                          
    seg_x2 = x2_mid[start_idx:end_idx]                                          
    seg_dx1 = dx1_dt[start_idx:end_idx]                                         
    seg_dx2 = dx2_dt[start_idx:end_idx]                                         
                                                                                
    # Fit dx1/dt = a*x1 - b*x1*x2                                               
    # Matrix A1 = [x1, -x1*x2]                                                  
    A1 = np.column_stack([seg_x1, -seg_x1 * seg_x2])                            
    params1, _, _, _ = np.linalg.lstsq(A1, seg_dx1, rcond=None)                 
    a, b = params1                                                              
                                                                                
    # Fit dx2/dt = c*x1*x2 - d*x2                                               
    # Matrix A2 = [x1*x2, -x2]                                                  
    A2 = np.column_stack([seg_x1 * seg_x2, -seg_x2])                            
    params2, _, _, _ = np.linalg.lstsq(A2, seg_dx2, rcond=None)                 
    c, d = params2                                                              
                                                                                
    # State at change point                                                     
    state_at_end = (x[end_idx] if end_idx < len(t) else x[-1])                  
                                                                                
    segments.append({                                                           
        'a': a, 'b': b, 'c': c, 'd': d,                                         
        'state_at_end': state_at_end,                                           
