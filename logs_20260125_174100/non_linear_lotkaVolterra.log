# Load the first data file                                                      
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
dt = 0.01                                                                       
                                                                                
# Calculate derivatives                                                         
dx1_dt = np.gradient(x1, dt)                                                    
dx2_dt = np.gradient(x2, dt)                                                    
                                                                                
# Relationship:                                                                 
# dx1/dt = a * x1 - b * x1 * x2                                                 
# dx2/dt = c * x1 * x2 - d * x2                                                 
                                                                                
# We can rewrite these as:                                                      
# (dx1/dt) / x1 = a - b * x2                                                    
# (dx2/dt) / x2 = c * x1 - d                                                    
                                                                                
# To find change points, we look for discontinuities in the relationship        
# Let's compute local 'a, b, c, d' in small windows                             
window = 50                                                                     
steps = len(x1)                                                                 
a_list, b_list, c_list, d_list = [], [], [], []                                 
ts = []                                                                         
                                                                                
for i in range(0, steps - window, 20):                                          
    # Segment data                                                              
    s_x1 = x1[i : i + window]                                                   
    s_x2 = x2[i : i + window]                                                   
    s_dx1 = dx1_dt[i : i + window]                                              
    s_dx2 = dx2_dt[i : i + window]                                              
                                                                                
    # Fit dx1/dt = a*x1 - b*x1*x2                                               
    # [x1, -x1*x2] @ [a, b]^T = dx1/dt                                          
    mat1 = np.stack([s_x1, -s_x1 * s_x2], axis=1)                               
    p1, _, _, _ = np.linalg.lstsq(mat1, s_dx1, rcond=None)                      
                                                                                
    # Fit dx2/dt = c*x1*x2 - d*x2                                               
    # [x1*x2, -x2] @ [c, d]^T = dx2/dt                                          
    mat2 = np.stack([s_x1 * s_x2, -s_x2], axis=1)                               
    p2, _, _, _ = np.linalg.lstsq(mat2, s_dx2, rcond=None)                      
                                                                                
    a_list.append(p1[0])                                                        
    b_list.append(p1[1])                                                        
    c_list.append(p2[0])                                                        
    d_list.append(p2[1])                                                        
    ts.append(i + window // 2)                                                  
                                                                                
# Now analyze the jumps in these parameters                                     
a_arr = np.array(a_list)                                                        
diffs = np.abs(np.diff(a_arr))                                                  
# Find indices of large jumps                                                   
jump_indices = np.where(diffs > np.percentile(diffs, 95))[0]                    
print("Indices of potential jumps in 'a':", jump_indices)                       
print("Corresponding time indices in original data:", [ts[i] for i in           
jump_indices])                                                                  
                                                                                
