filtered_switches = []                                                          
if len(switch_indices) > 0:                                                     
    filtered_switches.append(switch_indices[0])                                 
    for s in switch_indices[1:]:                                                
        if s - filtered_switches[-1] > 10: # Minimum 10 steps between switches  
