mask1 = x1_full >= 0                                                            
mask2 = x1_full < 0                                                             
                                                                                
def fit_mode(x, xd, xdd):                                                       
    if len(x) < 3: return None                                                  
    # xdd = a*xd + b*x + c                                                      
    A = np.column_stack([xd, x, np.ones_like(x)])                               
    params, residuals, rank, s = np.linalg.lstsq(A, xdd, rcond=None)            
    return params, residuals                                                    
                                                                                
