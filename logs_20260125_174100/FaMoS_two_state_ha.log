          m1 = x1 <= t                                                          
          m2 = x1 > t                                                           
                                                                                
          if np.sum(m1) < 100 or np.sum(m2) < 100:                              
              continue                                                          
                                                                                
          def fit(mask):                                                        
              A = np.column_stack([x1_dot[mask], x1[mask],                      
  np.ones(np.sum(mask))])                                                       
              y = x1_ddot[mask]                                                 
              coeffs, residuals, _, _ = np.linalg.lstsq(A, y, rcond=None)       
              error = np.sum((y - A @ coeffs)**2)                               
