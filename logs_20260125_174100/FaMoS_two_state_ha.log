import numpy as np                                                              
                                                                                
# Load data                                                                     
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
x1 = state[0]                                                                   
dt = 0.01                                                                       
                                                                                
# Compute derivatives                                                           
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Identify switching points by looking for jumps in x1_ddot                     
# Calculate the absolute difference between consecutive points in x1_ddot       
ddot_diff = np.abs(np.diff(x1_ddot))                                            
# Threshold for a jump. Let's look at the distribution of jumps.                
threshold = np.mean(ddot_diff) + 5 * np.std(ddot_diff)                          
switches = np.where(ddot_diff > threshold)[0]                                   
                                                                                
# Consolidate switches that are very close to each other (e.g., within 5        
indices)                                                                        
consolidated_switches = []                                                      
if len(switches) > 0:                                                           
    consolidated_switches.append(switches[0])                                   
    for s in switches[1:]:                                                      
        if s - consolidated_switches[-1] > 10:                                  
            consolidated_switches.append(s)                                     
                                                                                
print(f"Detected potential switch indices: {consolidated_switches}")            
# Define modes based on switches                                                
indices = [0] + [s + 1 for s in consolidated_switches] + [len(x1)]              
print(f"Mode segments: {list(zip(indices[:-1], indices[1:]))}")                 
                                                                                
