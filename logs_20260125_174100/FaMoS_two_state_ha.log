# Usually hybrid systems like 'two_state_ha' switch at x1=0                     
mask_mode1 = x1 >= 0                                                            
mask_mode2 = x1 < 0                                                             
                                                                                
def solve_regression(mask):                                                     
    if np.sum(mask) < 10: return None                                           
