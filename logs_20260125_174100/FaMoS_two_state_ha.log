# Detect switches by looking for large jumps in x1_2                            
def detect_switches(x1_2, threshold_multiplier=10):                             
    diff_x1_2 = np.abs(np.diff(x1_2))                                           
    threshold = np.mean(diff_x1_2) * threshold_multiplier                       
    switches = np.where(diff_x1_2 > threshold)[0]                               
    # Filter consecutive switches to get single points                          
    if len(switches) == 0:                                                      
        return []                                                               
    filtered_switches = [switches[0]]                                           
    for i in range(1, len(switches)):                                           
        if switches[i] > switches[i-1] + 10:                                    
            filtered_switches.append(switches[i])                               
    return filtered_switches                                                    
                                                                                
# Analyze segments                                                              
