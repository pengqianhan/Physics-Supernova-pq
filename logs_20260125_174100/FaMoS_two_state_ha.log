import numpy as np                                                              
                                                                                
# List to collect data from all samples                                         
all_x0_B, all_x1_B, all_x2_B = [], [], []                                       
all_x0_A, all_x1_A, all_x2_A = [], [], []                                       
all_guards = []                                                                 
                                                                                
dt = 0.001                                                                      
                                                                                
for path in ['data_all/FaMoS/two_state_ha/sample_0.npz',                        
'data_all/FaMoS/two_state_ha/sample_1.npz',                                     
'data_all/FaMoS/two_state_ha/sample_2.npz']:                                    
    data = np.load(path)                                                        
    state = data['state']                                                       
                                                                                
    # Extract x1 (first dimension)                                              
    if state.ndim == 2:                                                         
        x1_0 = state[0, :] if state.shape[0] < state.shape[1] else state[:, 0]  
    else:                                                                       
        x1_0 = state.flatten()                                                  
                                                                                
    # Calculate derivatives                                                     
    x1_1 = np.gradient(x1_0, dt)                                                
    x1_2 = np.gradient(x1_1, dt)                                                
                                                                                
    # Mode B: Increasing (x1_1 > 0)                                             
    # Mode A: Decreasing (x1_1 < 0)                                             
    # Filter out near-zero derivatives to reduce noise at switching points      
    mask_b = x1_1 > 0.01                                                        
    mask_a = x1_1 < -0.01                                                       
                                                                                
    all_x0_B.append(x1_0[mask_b])                                               
    all_x1_B.append(x1_1[mask_b])                                               
    all_x2_B.append(x1_2[mask_b])                                               
                                                                                
    all_x0_A.append(x1_0[mask_a])                                               
    all_x1_A.append(x1_1[mask_a])                                               
    all_x2_A.append(x1_2[mask_a])                                               
                                                                                
    # Identify guards (inflection points where sign of x1_1 changes)            
    sign_changes = np.where(np.diff(np.sign(x1_1)) != 0)[0]                     
    all_guards.extend(x1_0[sign_changes].tolist())                              
                                                                                
# Combine data for fitting                                                      
def get_coeffs(x0_list, x1_list, x2_list):                                      
    X0 = np.concatenate(x0_list)                                                
    X1 = np.concatenate(x1_list)                                                
    Y = np.concatenate(x2_list)                                                 
    A = np.column_stack([X1, X0, np.ones(len(X0))])                             
    coeffs, _, _, _ = np.linalg.lstsq(A, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
coeffs_b = get_coeffs(all_x0_B, all_x1_B, all_x2_B)                             
coeffs_a = get_coeffs(all_x0_A, all_x1_A, all_x2_A)                             
                                                                                
# Process guards to find thresholds                                             
all_guards = np.sort(all_guards)                                                
# We expect two main guard values: one for A->B (min) and one for B->A (max)    
# Clustering/averaging the points                                               
guard_min = np.mean([g for g in all_guards if g < 15])                          
guard_max = np.mean([g for g in all_guards if g > 15])                          
                                                                                
print(f"Final Coeffs B: {coeffs_b}")                                            
print(f"Final Coeffs A: {coeffs_a}")                                            
print(f"Guard A->B (min): {guard_min}")                                         
print(f"Guard B->A (max): {guard_max}")                                         
                                                                                
