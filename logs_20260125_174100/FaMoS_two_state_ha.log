          x = data['state'][0]                                                  
          dx = np.gradient(x, dt)                                               
          ddx = np.gradient(dx, dt)                                             
          all_x1.append(x)                                                      
          all_x1_dot.append(dx)                                                 
          all_x1_ddot.append(ddx)                                               
                                                                                
      x1 = np.concatenate(all_x1)                                               
      x1_dot = np.concatenate(all_x1_dot)                                       
      x1_ddot = np.concatenate(all_x1_ddot)                                     
                                                                                
      # Grid search for the best threshold                                      
      thresholds = np.linspace(np.min(x1) + 1, np.max(x1) - 1, 40)              
      best_t = None                                                             
      min_total_error = float('inf')                                            
      best_models = (None, None)                                                
                                                                                
