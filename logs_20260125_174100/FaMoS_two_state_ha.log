  all_X = []                                                                    
  all_Y = []                                                                    
  for s in samples:                                                             
      X = np.column_stack([s[1:-1], s[:-2], np.ones(len(s)-2)])                 
      Y = s[2:]                                                                 
      all_X.append(X)                                                           
      all_Y.append(Y)                                                           
                                                                                
  X_total = np.vstack(all_X)                                                    
  Y_total = np.concatenate(all_Y)                                               
                                                                                
  # Use a sliding window to detect local coefficients and identify segments     
  window_size = 50                                                              
  coeffs = []                                                                   
  for s in samples:                                                             
      for i in range(len(s) - window_size - 2):                                 
          win_x = np.column_stack([s[i+1:i+window_size+1], s[i:i+window_size],  
  np.ones(window_size)])                                                        
          win_y = s[i+2:i+window_size+2]                                        
          c, _, _, _ = np.linalg.lstsq(win_x, win_y, rcond=None)                
          coeffs.append(c)                                                      
                                                                                
  coeffs = np.array(coeffs)                                                     
  # Cluster the coefficients to identify the number of modes                    
  kmeans = KMeans(n_clusters=2, random_state=42, n_init=10).fit(coeffs)         
  labels = kmeans.labels_                                                       
                                                                                
  # Identify mode properties                                                    
  mode_0_coeffs = kmeans.cluster_centers_[0]                                    
  mode_1_coeffs = kmeans.cluster_centers_[1]                                    
                                                                                
  # 3. Refine Coefficients for each mode                                        
