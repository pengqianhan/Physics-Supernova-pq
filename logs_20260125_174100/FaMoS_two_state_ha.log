  def manual_kmeans(data, k, iterations=10):                                    
      # Initialize centroids randomly                                           
      indices = np.random.choice(data.shape[0], k, replace=False)               
      centroids = data[indices]                                                 
      for _ in range(iterations):                                               
          # Assign clusters - using a more memory efficient way if needed, but  
  let's try this                                                                
          # distances shape (N, K)                                              
          distances = np.sqrt(((data[:, np.newaxis] -                           
  centroids)**2).sum(axis=2))                                                   
          labels = np.argmin(distances, axis=1)                                 
          # Update centroids                                                    
          centroids = np.array([data[labels == i].mean(axis=0) for i in         
  range(k)])                                                                    
      return labels, centroids                                                  
                                                                                
  features = np.column_stack([x_full_s, v_full_s, a_full_s])                    
  feat_min = features.min(axis=0)                                               
  feat_max = features.max(axis=0)                                               
  feat_norm = (features - feat_min) / (feat_max - feat_min)                     
                                                                                
  labels, centroids = manual_kmeans(feat_norm, 2)                               
                                                                                
  for i in range(2):                                                            
      mask = (labels == i)                                                      
