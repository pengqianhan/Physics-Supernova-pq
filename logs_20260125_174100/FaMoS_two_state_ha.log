│                 "condition": "x1 >= 4"                                       │
│             },                                                               │
│             {                                                                │
│                 "direction": "2 -> 1",                                       │
│                 "condition": "x1 <= 9"                                       │
│             }                                                                │
│         \]                                                                   │
│     },                                                                       │
│     "config": {                                                              │
