import numpy as np                                                              
import pandas as pd                                                             
                                                                                
dt = 0.001                                                                      
all_data = []                                                                   
                                                                                
# Load files and calculate derivatives                                          
for i, path in enumerate(DATA_FILE_PATHS):                                      
    data = np.load(path)                                                        
    state = data['state']                                                       
    # x1 is the first (and likely only) column                                  
    x1 = state[:, 0]                                                            
                                                                                
    # Calculate derivatives                                                     
    v1 = np.gradient(x1, dt)                                                    
    a1 = np.gradient(v1, dt)                                                    
                                                                                
    df = pd.DataFrame({'x1': x1, 'v1': v1, 'a1': a1})                           
    df['sample_id'] = i                                                         
    all_data.append(df)                                                         
                                                                                
df_total = pd.concat(all_data, ignore_index=True)                               
                                                                                
# Define modes based on thresholds                                              
def identify_mode(x):                                                           
    if x < 15:                                                                  
        return "Mode 0 (x1 < 15)"                                               
    elif x < 25:                                                                
        return "Mode 1 (15 <= x1 < 25)"                                         
    else:                                                                       
        return "Mode 2 (x1 >= 25)"                                              
                                                                                
df_total['mode'] = df_total['x1'].apply(identify_mode)                          
                                                                                
# Fit linear model for each mode: a1 = a*v1 + b*x1 + c                          
model_results = {}                                                              
for mode_name in df_total['mode'].unique():                                     
    subset = df_total[df_total['mode'] == mode_name]                            
    if len(subset) < 10:                                                        
        continue                                                                
                                                                                
    # Target: a1                                                                
    # Features: [v1, x1, 1]                                                     
    Y = subset['a1'].values                                                     
    X = np.column_stack([subset['v1'].values, subset['x1'].values,              
np.ones(len(subset))])                                                          
                                                                                
    # Solve linear least squares                                                
    coeffs, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)              
    a, b, c = coeffs                                                            
                                                                                
    model_results[mode_name] = {'a': a, 'b': b, 'c': c}                         
                                                                                
print("Model Results:")                                                         
for mode, params in model_results.items():                                      
    print(f"{mode}: a={params['a']:.4f}, b={params['b']:.4f},                   
c={params['c']:.4f}")                                                           
                                                                                
