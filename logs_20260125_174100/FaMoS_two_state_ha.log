        # x1 is the first component, which is the entire row here?              
        # Or is it the first row of a multi-row state?                          
        # The shape (1, 10001) suggests x1 is the first and only row.           
        x1 = state[0, :]                                                        
                                                                                
        if len(x1) < 2:                                                         
            continue                                                            
                                                                                
        # a. Compute derivatives                                                
        x1_dot = np.gradient(x1, dt)                                            
        x1_ddot = np.gradient(x1_dot, dt)                                       
                                                                                
        # b. Identify peaks and troughs                                         
        peaks, _ = find_peaks(x1)                                               
        troughs, _ = find_peaks(-x1)                                            
                                                                                
        all_peaks.extend(x1[peaks])                                             
        all_troughs.extend(x1[troughs])                                         
                                                                                
        # Combine and sort critical points                                      
        events = sorted([(p, 'peak') for p in peaks] + [(t, 'trough') for t in  
troughs])                                                                       
                                                                                
        # c. Segment the data                                                   
        for i in range(len(events) - 1):                                        
            idx_start, type_start = events[i]                                   
            idx_end, type_end = events[i+1]                                     
                                                                                
            # Segment A: Trough to Peak (x1 increasing)                         
            if type_start == 'trough' and type_end == 'peak':                   
                indices = range(idx_start, idx_end + 1)                         
                for idx in indices:                                             
                    all_seg_A.append([x1_dot[idx], x1[idx], 1.0, x1_ddot[idx]]) 
                                                                                
            # Segment B: Peak to Trough (x1 decreasing)                         
            elif type_start == 'peak' and type_end == 'trough':                 
                indices = range(idx_start, idx_end + 1)                         
                for idx in indices:                                             
                    all_seg_B.append([x1_dot[idx], x1[idx], 1.0, x1_ddot[idx]]) 
                                                                                
    def perform_regression(seg_data):                                           
        if not seg_data:                                                        
            return None                                                         
        seg_data = np.array(seg_data)                                           
        X = seg_data[:, :3] # x1_dot, x1, 1 (bias)                              
        y = seg_data[:, 3]  # x1_ddot                                           
        beta, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)            
        return beta                                                             
                                                                                
    coeffs_A = perform_regression(all_seg_A)                                    
    coeffs_B = perform_regression(all_seg_B)                                    
                                                                                
    return coeffs_A, coeffs_B, all_peaks, all_troughs                           
                                                                                
