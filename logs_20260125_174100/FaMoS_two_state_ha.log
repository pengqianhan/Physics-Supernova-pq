            'dx1': dx1[:-1],                                                    
            'ddx1': ddx1,                                                       
            'sample': i,                                                        
            't_idx': np.arange(len(ddx1))                                       
        })                                                                      
        all_data.append(df)                                                     
                                                                                
    df_all = pd.concat(all_data).reset_index(drop=True)                         
                                                                                
    # Identify modes based on discontinuities in ddx1                           
    # We look at the residual of a simple model to cluster                      
    # Rough estimate for separation: ddx1 + 0.002*x1                            
