res_B = f"a={coeffs_B[0]:.6f}, b={coeffs_B[1]:.6f}, bias={coeffs_B[2]:.6f}" if  
coeffs_B is not None else "N/A"                                                 
                                                                                
mean_peak = np.mean(peaks) if peaks else 0                                      
