  # Load data and compute derivatives                                           
  dt = 0.001                                                                    
  all_x, all_v, all_a = [], [], []                                              
                                                                                
  for path in ['data_all/FaMoS/two_state_ha/sample_0.npz',                      
  'data_all/FaMoS/two_state_ha/sample_1.npz',                                   
