from sklearn.linear_model import LinearRegression                               
                                                                                
def process_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    x1 = data['x'][:, 0]                                                        
    dt = 0.001                                                                  
                                                                                
    # Calculate derivatives                                                     
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    # Identify peaks and troughs                                                
    peaks, _ = find_peaks(x1)                                                   
    troughs, _ = find_peaks(-x1)                                                
                                                                                
    # Sort critical points to define segments                                   
    crit_points = sorted([(p, 'peak') for p in peaks] + [(t, 'trough') for t in 
troughs])                                                                       
                                                                                
    seg_A_pts = []                                                              
    seg_B_pts = []                                                              
                                                                                
    for i in range(len(crit_points) - 1):                                       
        idx_start, type_start = crit_points[i]                                  
        idx_end, type_end = crit_points[i+1]                                    
                                                                                
        # Segment A: Trough to Peak                                             
        if type_start == 'trough' and type_end == 'peak':                       
            for idx in range(idx_start, idx_end):                               
                seg_A_pts.append([x1[idx], x1_dot[idx], x1_ddot[idx]])          
        # Segment B: Peak to Trough                                             
        elif type_start == 'peak' and type_end == 'trough':                     
            for idx in range(idx_start, idx_end):                               
                seg_B_pts.append([x1[idx], x1_dot[idx], x1_ddot[idx]])          
                                                                                
    peak_vals = x1[peaks]                                                       
    trough_vals = x1[troughs]                                                   
                                                                                
    return seg_A_pts, seg_B_pts, peak_vals, trough_vals                         
                                                                                
