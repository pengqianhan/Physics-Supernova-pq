                    'x1_1': sample['x1_1'][s:e],                                
                    'x1_2': sample['x1_2'][s:e],                                
                    'val_at_switch': sample['x1_0'][end-1] if end <             
len(sample['x1_0']) else None                                                   
                })                                                              
                                                                                
# Fit models and group them                                                     
results = []                                                                    
for seg in all_segments:                                                        
