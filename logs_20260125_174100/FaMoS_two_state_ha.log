def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    dt = 0.001                                                                  
    v = np.gradient(x, dt)                                                      
    acc = np.gradient(v, dt)                                                    
    N = len(x)                                                                  
                                                                                
