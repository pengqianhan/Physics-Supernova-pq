Thought: I will load the data from 'Sample 0', compute the derivatives $x1\_dot$
and $x1\_ddot$ using finite differences, and analyze the relationship between   
them. I will then perform a single-mode linear regression to identify the       
switching point by examining the residuals. Once the switch is found, I will    
perform separate regressions for each mode and determine the switching condition
based on the $x1$ value.                                                        
                                                                                
<code>                                                                          
import numpy as np                                                              
import pandas as pd                                                             
import matplotlib.pyplot as plt                                                 
from sklearn.linear_model import LinearRegression                               
                                                                                
# 1. Load data                                                                  
data = np.load('data_all/FaMoS/two_state_ha/sample_0.npz')                      
# Inspect keys                                                                  
print(f"Keys: {list(data.keys())}")                                             
t = data['t']                                                                   
x = data['x'] # Assuming x contains the trajectory                              
dt = 0.001                                                                      
                                                                                
# x might be (N, 1) or (N,)                                                     
if len(x.shape) > 1 and x.shape[1] > 0:                                         
    x1 = x[:, 0]                                                                
else:                                                                           
    x1 = x                                                                      
                                                                                
# Finite differences                                                            
# x1_dot (v)                                                                    
x1_dot = np.gradient(x1, dt)                                                    
# x1_ddot (a)                                                                   
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Prepare data for regression: x1_ddot = a*x1_dot + b*x1 + c                    
# We use indices where derivatives are stable (avoiding edges if necessary, but 
gradient handles it)                                                            
X = np.column_stack((x1_dot, x1))                                               
y = x1_ddot                                                                     
                                                                                
# 2. Fit single mode to find switch                                             
model_global = LinearRegression().fit(X, y)                                     
residuals = np.abs(y - model_global.predict(X))                                 
                                                                                
# Find the jump in residuals                                                    
# Often switching happens at a specific time. Let's look for a sharp peak or    
change.                                                                         
# Rolling mean of residuals might help                                          
roll_res = pd.Series(residuals).rolling(window=50).mean()                       
switch_idx = np.argmax(np.abs(np.diff(roll_res.fillna(0))))                     
                                                                                
print(f"Estimated switching index: {switch_idx}")                               
print(f"Switching time: {t[switch_idx]}")                                       
print(f"x1 at switch: {x1[switch_idx]}")                                        
                                                                                
# 3. Fit two modes                                                              
# Mode 1: before switch, Mode 2: after switch                                   
X1, y1 = X[:switch_idx], y[:switch_idx]                                         
X2, y2 = X[switch_idx:], y[switch_idx:]                                         
                                                                                
model1 = LinearRegression().fit(X1, y1)                                         
model2 = LinearRegression().fit(X2, y2)                                         
                                                                                
results = {                                                                     
    'mode1': {'a': model1.coef_[0], 'b': model1.coef_[1], 'c':                  
model1.intercept_},                                                             
    'mode2': {'a': model2.coef_[0], 'b': model2.coef_[1], 'c':                  
model2.intercept_},                                                             
    'switch_x1': x1[switch_idx],                                                
    'switch_t': t[switch_idx]                                                   
}                                                                               
                                                                                
print(results)                                                                  
                                                                                
