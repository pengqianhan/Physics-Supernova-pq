import numpy as np                                                              
import scipy.linalg                                                             
                                                                                
# Load data                                                                     
dt = 0.001                                                                      
all_x = []                                                                      
all_dx = []                                                                     
all_ddx = []                                                                    
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    x = data['state'][0]                                                        
    dx = np.gradient(x, dt)                                                     
    ddx = np.gradient(dx, dt)                                                   
    all_x.append(x)                                                             
    all_dx.append(dx)                                                           
    all_ddx.append(ddx)                                                         
                                                                                
X = np.concatenate(all_x)                                                       
dX = np.concatenate(all_dx)                                                     
ddX = np.concatenate(all_ddx)                                                   
                                                                                
# Define regions based on thresholds                                            
# Region 1: x < 15                                                              
# Region 2: 15 <= x < 25                                                        
# Region 3: x >= 25                                                             
                                                                                
def fit_ode(x_seg, dx_seg, ddx_seg):                                            
    if len(x_seg) < 10:                                                         
        return None                                                             
    # Model: ddx = c1*dx + c2*x + bias                                          
    # A * [c1, c2, bias]^T = ddx                                                
    A = np.stack([dx_seg, x_seg, np.ones_like(x_seg)], axis=1)                  
    coeffs, residuals, rank, s = np.linalg.lstsq(A, ddx_seg, rcond=None)        
    return coeffs, residuals                                                    
                                                                                
regions = [                                                                     
    (X < 15),                                                                   
    (X >= 15) & (X < 25),                                                       
    (X >= 25)                                                                   
]                                                                               
                                                                                
results = []                                                                    
for i, mask in enumerate(regions):                                              
    if np.any(mask):                                                            
        coeffs, res = fit_ode(X[mask], dX[mask], ddX[mask])                     
        results.append({'region': i+1, 'coeffs': coeffs, 'res': res, 'count':   
np.sum(mask)})                                                                  
                                                                                
for res in results:                                                             
    print(f"Region {res['region']}: Coeffs {res['coeffs']}, Mean Res            
{res['res']/res['count'] if res['res'].size > 0 else 0}")                       
                                                                                
# Analyze switching logic                                                       
# The thresholds are at 15 and 25.                                              
# Let's check if the system actually uses both or just one.                     
# From the results we can see if the fit is good in each region.                
                                                                                
