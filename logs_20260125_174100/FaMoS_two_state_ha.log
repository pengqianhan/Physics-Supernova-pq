import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data files                                                           
data_0 = np.load('data_all/FaMoS/two_state_ha/sample_0.npz')                    
data_1 = np.load('data_all/FaMoS/two_state_ha/sample_1.npz')                    
data_2 = np.load('data_all/FaMoS/two_state_ha/sample_2.npz')                    
                                                                                
def process_sample(data, dt=0.001):                                             
    # Assuming 'X' contains the state and 't' the time                          
    X = data['X']                                                               
    x1 = X[:, 0]                                                                
                                                                                
    # Calculate derivatives                                                     
    dx1 = np.gradient(x1, dt)                                                   
    ddx1 = np.gradient(dx1, dt)                                                 
                                                                                
    return x1, dx1, ddx1                                                        
                                                                                
# Combine data from all samples for robust analysis                             
all_x1, all_dx1, all_ddx1 = [], [], []                                          
for d in [data_0, data_1, data_2]:                                              
    x1, dx1, ddx1 = process_sample(d)                                           
    all_x1.append(x1)                                                           
    all_dx1.append(dx1)                                                         
    all_ddx1.append(ddx1)                                                       
                                                                                
X1 = np.concatenate(all_x1)                                                     
DX1 = np.concatenate(all_dx1)                                                   
DDX1 = np.concatenate(all_ddx1)                                                 
                                                                                
# Analyze potential switching condition (e.g., sign of x1)                      
mask_pos = X1 >= 0                                                              
mask_neg = X1 < 0                                                               
                                                                                
def fit_mode(x, dx, ddx):                                                       
    features = np.stack([dx, x, np.ones_like(x)], axis=1)                       
    model = LinearRegression(fit_intercept=False).fit(features, ddx)            
    return model.coef_                                                          
                                                                                
coeffs_pos = fit_mode(X1[mask_pos], DX1[mask_pos], DDX1[mask_pos])              
coeffs_neg = fit_mode(X1[mask_neg], DX1[mask_neg], DDX1[mask_neg])              
                                                                                
print(f"Mode 1 (x1 >= 0) Coefficients (a, b, c): {coeffs_pos}")                 
print(f"Mode 2 (x1 < 0) Coefficients (a, b, c): {coeffs_neg}")                  
                                                                                
