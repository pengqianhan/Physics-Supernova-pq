# Or just large changes in x1_2                                                 
x1_3 = np.gradient(x1_2, dt)                                                    
threshold = np.std(x1_3) * 5 # Heuristic for jump detection                     
switches = np.where(np.abs(x1_3) > threshold)[0]                                
                                                                                
# Filter switches to get clear change points (avoid clusters)                   
clean_switches = []                                                             
if len(switches) > 0:                                                           
    clean_switches.append(switches[0])                                          
    for i in range(1, len(switches)):                                           
        if switches[i] - switches[i-1] > 10:                                    
            clean_switches.append(switches[i])                                  
                                                                                
print(f"Detected switches at indices: {clean_switches}")                        
print(f"Times of switches: {[times[i] for i in clean_switches]}")               
print(f"Values of x1 at switches: {[x1_0[i] for i in clean_switches]}")         
                                                                                
# Identify segments (modes)                                                     
segments = []                                                                   
start = 0                                                                       
for s in clean_switches:                                                        
    segments.append((start, s))                                                 
    start = s                                                                   
segments.append((start, len(state)))                                            
                                                                                
# For each mode, fit: x1_2 = c1 * x1_1 + c0 * x1_0 + bias                       
results = []                                                                    
for i, (start, end) in enumerate(segments):                                     
    # Skip very short segments                                                  
    if end - start < 20: continue                                               
                                                                                
    # Take a window to avoid boundary effects from gradient at switches         
    s_idx = start + 5                                                           
    e_idx = end - 5                                                             
                                                                                
    Y = x1_2[s_idx:e_idx]                                                       
    X = np.column_stack([x1_1[s_idx:e_idx], x1_0[s_idx:e_idx], np.ones(e_idx -  
s_idx)])                                                                        
                                                                                
    # Solve linear regression                                                   
    coef, residuals, rank, s_vals = np.linalg.lstsq(X, Y, rcond=None)           
    c1, c0, bias = coef                                                         
                                                                                
    results.append({                                                            
        'mode_id': i,                                                           
        'equation': f"x1'' = {c1:.4f} * x1' + {c0:.4f} * x1 + {bias:.4f}",      
        'start_idx': start,                                                     
        'end_idx': end,                                                         
        'x_at_end': x1_0[end-1] if end < len(state) else None                   
    })                                                                          
                                                                                
for res in results:                                                             
    print(res)                                                                  
                                                                                
