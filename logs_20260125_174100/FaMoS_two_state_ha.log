# Concatenate data                                                              
x1_full = np.concatenate(all_x1)                                                
t_full = np.arange(len(x1_full)) * dt                                           
                                                                                
# Compute derivatives                                                           
x1_dot = np.gradient(x1_full, dt)                                               
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Organize data for analysis                                                    
df = pd.DataFrame({                                                             
    't': t_full,                                                                
    'x1': x1_full,                                                              
    'x1_dot': x1_dot,                                                           
    'x1_ddot': x1_ddot                                                          
})                                                                              
                                                                                
# Detect discontinuities or mode shifts                                         
# Let's compute a sliding window regression error or look for jumps in x1_ddot  
# We'll try to split the data based on where x1_ddot changes significantly      
compared to x1 and x1_dot                                                       
