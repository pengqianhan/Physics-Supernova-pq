Thought: I will extract the state, compute the first and second derivatives for 
all traces, and combine them. I will also keep track of which point belongs to  
which trace to identify the "initial mode of each trace".                       
                                                                                
<code>                                                                          
import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
data_files = ['data_all/FaMoS/two_state_ha/sample_0.npz',                       
              'data_all/FaMoS/two_state_ha/sample_1.npz',                       
              'data_all/FaMoS/two_state_ha/sample_2.npz']                       
                                                                                
all_x0 = []                                                                     
all_x1 = []                                                                     
all_x2 = []                                                                     
trace_indices = []                                                              
                                                                                
for i, path in enumerate(data_files):                                           
    data = np.load(path)                                                        
    state = data['state'][0]                                                    
                                                                                
    # Compute derivatives                                                       
    x0 = state                                                                  
    x1 = np.gradient(x0, dt)                                                    
    x2 = np.gradient(x1, dt)                                                    
                                                                                
    all_x0.append(x0)                                                           
    all_x1.append(x1)                                                           
    all_x2.append(x2)                                                           
    trace_indices.append(np.full(len(x0), i))                                   
                                                                                
# Flatten lists                                                                 
full_x0 = np.concatenate(all_x0)                                                
full_x1 = np.concatenate(all_x1)                                                
full_x2 = np.concatenate(all_x2)                                                
full_trace_idx = np.concatenate(trace_indices)                                  
                                                                                
print(f"Total points: {len(full_x0)}")                                          
print(f"x0 range: {np.min(full_x0):.4f} to {np.max(full_x0):.4f}")              
print(f"x1 range: {np.min(full_x1):.4f} to {np.max(full_x1):.4f}")              
print(f"x2 range: {np.min(full_x2):.4f} to {np.max(full_x2):.4f}")              
                                                                                
