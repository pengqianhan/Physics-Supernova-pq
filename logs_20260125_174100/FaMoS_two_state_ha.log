│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[2\] = x1[1\] + x1[0\]"                             │
│             }                                                                │
│         ],                                                                   │
│         "edge": []                                                           │
│     },                                                                       │
│     "config": {                                                              │
