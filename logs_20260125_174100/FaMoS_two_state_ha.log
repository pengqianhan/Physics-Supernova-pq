def fit_linear(x_in, v_in, a_in):                                               
    # a = a_coeff * v + b_coeff * x + bias                                      
    # A * [a_coeff, b_coeff, bias]^T = a_in                                     
    A = np.stack([v_in, x_in, np.ones_like(x_in)], axis=1)                      
    coeffs, residuals, rank, s = np.linalg.lstsq(A, a_in, rcond=None)           
    mse = residuals[0] / len(x_in) if len(residuals) > 0 else 0                 
    return coeffs, mse                                                          
                                                                                
