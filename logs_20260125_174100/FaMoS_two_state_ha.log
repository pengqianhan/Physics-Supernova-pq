import numpy as np                                                              
                                                                                
dt = 0.001                                                                      
data_files = ['data_all/FaMoS/two_state_ha/sample_0.npz',                       
              'data_all/FaMoS/two_state_ha/sample_1.npz',                       
              'data_all/FaMoS/two_state_ha/sample_2.npz']                       
                                                                                
all_x = []                                                                      
all_dx = []                                                                     
all_ddx = []                                                                    
                                                                                
for f in data_files:                                                            
    data = np.load(f)                                                           
    # state is (1, 10001)                                                       
    x = data['state'][0]                                                        
    # first derivative                                                          
    dx = np.gradient(x, dt)                                                     
    # second derivative                                                         
    ddx = np.gradient(dx, dt)                                                   
                                                                                
    all_x.append(x)                                                             
    all_dx.append(dx)                                                           
    all_ddx.append(ddx)                                                         
                                                                                
X = np.concatenate(all_x)                                                       
DX = np.concatenate(all_dx)                                                     
DDX = np.concatenate(all_ddx)                                                   
                                                                                
print(f"X range: {np.min(X)} to {np.max(X)}")                                   
                                                                                
def get_coeffs(x_vals, dx_vals, ddx_vals):                                      
    # Solve ddx = a*dx + b*x + c                                                
    # A * [a, b, c]^T = ddx                                                     
    A = np.column_stack([dx_vals, x_vals, np.ones_like(x_vals)])                
    coeffs, residuals, rank, s = np.linalg.lstsq(A, ddx_vals, rcond=None)       
    return coeffs                                                               
                                                                                
# Try finding a threshold by scanning                                           
thresholds = np.linspace(np.min(X), np.max(X), 50)                              
best_threshold = None                                                           
min_error = float('inf')                                                        
                                                                                
for t in thresholds:                                                            
    mask1 = X < t                                                               
    mask2 = X >= t                                                              
    if np.sum(mask1) > 100 and np.sum(mask2) > 100:                             
        c1 = get_coeffs(X[mask1], DX[mask1], DDX[mask1])                        
        c2 = get_coeffs(X[mask2], DX[mask2], DDX[mask2])                        
                                                                                
        err1 = np.sum((DDX[mask1] - (c1[0]*DX[mask1] + c1[1]*X[mask1] +         
c1[2]))**2)                                                                     
        err2 = np.sum((DDX[mask2] - (c2[0]*DX[mask2] + c2[1]*X[mask2] +         
c2[2]))**2)                                                                     
        total_err = err1 + err2                                                 
        if total_err < min_error:                                               
            min_error = total_err                                               
            best_threshold = t                                                  
                                                                                
print(f"Best threshold: {best_threshold}")                                      
c1 = get_coeffs(X[X < best_threshold], DX[X < best_threshold], DDX[X <          
best_threshold])                                                                
c2 = get_coeffs(X[X >= best_threshold], DX[X >= best_threshold], DDX[X >=       
best_threshold])                                                                
print(f"Mode 1 (x < {best_threshold}) coeffs: {c1}")                            
print(f"Mode 2 (x >= {best_threshold}) coeffs: {c2}")                           
                                                                                
# Also check for simple whole dataset fit to see if it's really 2 modes         
c_all = get_coeffs(X, DX, DDX)                                                  
err_all = np.sum((DDX - (c_all[0]*DX + c_all[1]*X + c_all[2]))**2)              
print(f"Total error with 1 mode: {err_all}")                                    
print(f"Total error with 2 modes: {min_error}")                                 
                                                                                
