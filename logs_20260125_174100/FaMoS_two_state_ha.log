# For simplicity, let's look at the distribution of residuals if we fit a single
model                                                                           
reg = LinearRegression().fit(df_all[['x1_dot', 'x1']], df_all['x1_ddot'])       
residuals = df_all['x1_ddot'] - reg.predict(df_all[['x1_dot', 'x1']])           
                                                                                
# Simple thresholding on residuals to find two modes                            
mid = (residuals.min() + residuals.max()) / 2                                   
df_all['mode'] = (residuals > mid).astype(int)                                  
                                                                                
# Refine coefficients for each mode                                             
modes = {}                                                                      
for m in [0, 1]:                                                                
    df_m = df_all[df_all['mode'] == m]                                          
    model = LinearRegression().fit(df_m[['x1_dot', 'x1']], df_m['x1_ddot'])     
    modes[m] = {                                                                
        'a': model.coef_[0],                                                    
        'b': model.coef_[1],                                                    
        'c': model.intercept_,                                                  
        'df': df_m                                                              
    }                                                                           
                                                                                
print(f"Mode 0: a={modes[0]['a']:.3f}, b={modes[0]['b']:.3f},                   
c={modes[0]['c']:.3f}")                                                         
print(f"Mode 1: a={modes[1]['a']:.3f}, b={modes[1]['b']:.3f},                   
c={modes[1]['c']:.3f}")                                                         
                                                                                
# Find transitions                                                              
df_all['mode_diff'] = df_all['mode'].diff().fillna(0)                           
transitions = df_all[df_all['mode_diff'] != 0]                                  
                                                                                
for i, row in transitions.iterrows():                                           
    prev_row = df_all.iloc[i-1]                                                 
    print(f"Transition Sample {row['sample']} at t={row['t']:.2f}: Mode         
{int(prev_row['mode'])} -> {int(row['mode'])}. x1={row['x1']:.2f},              
x1_dot={row['x1_dot']:.2f}")                                                    
                                                                                
# Check initial modes                                                           
for i in range(3):                                                              
    initial_mode = df_all[(df_all['sample'] == i) & (df_all['t'] ==             
0)]['mode'].values[0]                                                           
    initial_x1 = df_all[(df_all['sample'] == i) & (df_all['t'] ==               
0)]['x1'].values[0]                                                             
