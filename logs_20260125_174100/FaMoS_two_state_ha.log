          mse2 = get_mse(X_flat[mask2], V_flat[mask2], A_flat[mask2], c2)       
          total_x_mse = (mse1 * np.sum(mask1) + mse2 * np.sum(mask2)) /         
  len(V_flat)                                                                   
          print(f"X-split {th} Total MSE: {total_x_mse}")                       
