import numpy as np                                                              
from scipy.signal import find_peaks                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/two_state_ha/sample_0.npz')                      
state = data['state']                                                           
x = state[:, 0]                                                                 
dt = 0.001                                                                      
                                                                                
# Compute derivatives                                                           
x_dot = np.gradient(x, dt)                                                      
x_ddot = np.gradient(x_dot, dt)                                                 
                                                                                
# Identify peaks and troughs                                                    
peaks, _ = find_peaks(x)                                                        
troughs, _ = find_peaks(-x)                                                     
                                                                                
# Combine and sort critical points to define segments                           
critical_points = np.sort(np.concatenate([peaks, troughs]))                     
transition_points = critical_points.tolist()                                    
                                                                                
mode_a_indices = []                                                             
mode_b_indices = []                                                             
                                                                                
for i in range(len(critical_points) - 1):                                       
    start, end = critical_points[i], critical_points[i+1]                       
    segment = np.arange(start, end)                                             
    # Mode A: Peak to Trough (decreasing)                                       
    if x[start] > x[end]:                                                       
        mode_a_indices.extend(segment)                                          
    # Mode B: Trough to Peak (increasing)                                       
    else:                                                                       
        mode_b_indices.extend(segment)                                          
                                                                                
def get_coefficients(indices):                                                  
    if not indices: return None                                                 
    target = x_ddot[indices]                                                    
    features = np.vstack([x_dot[indices], x[indices], np.ones(len(indices))]).T 
    model = LinearRegression().fit(features, target)                            
    return model.coef_[0], model.coef_[1], model.intercept_                     
                                                                                
coef_a = get_coefficients(mode_a_indices)                                       
coef_b = get_coefficients(mode_b_indices)                                       
                                                                                
print(f"Transitions: {transition_points}")                                      
print(f"Mode A (a, b, c): {coef_a}")                                            
print(f"Mode B (a, b, c): {coef_b}")                                            
                                                                                
final_answer({                                                                  
    "### 1. Task outcome (short version):": "Successfully identified system     
coefficients for two distinct modes (A and B) and mapped transition points.",   
    "### 2. Task outcome (extremely detailed version):": f"The system dynamics  
were modeled as x'' = a*x' + b*x + c. For Mode A (descending), coefficients are 
