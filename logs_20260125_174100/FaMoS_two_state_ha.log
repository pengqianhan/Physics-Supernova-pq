import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/FaMoS/two_state_ha/sample_0.npz')                      
x = data['state'][0]                                                            
dt = 0.001                                                                      
                                                                                
# Calculate derivatives                                                         
# x1[0] = x                                                                     
# x1[1] = dx/dt                                                                 
# x1[2] = d^2x/dt^2                                                             
v = np.gradient(x, dt)                                                          
a = np.gradient(v, dt)                                                          
                                                                                
# We want to find modes for x[2] = a*x[1] + b*x[0] + c                          
# Let's try to detect the switching point by looking at the consistency of the  
local linear relation.                                                          
# Since it's 'two_state_ha', we expect 2 modes.                                 
# We can use a sliding window to see if the relationship changes.               
                                                                                
# Let's try to fit the whole thing first and see residuals                      
from sklearn.linear_model import LinearRegression                               
                                                                                
# x1[0] is x, x1[1] is v, x1[2] is a                                            
# Prepare data for regression: x1[2] ~ x1[1] + x1[0]                            
X = np.column_stack((v, x))                                                     
y = a                                                                           
                                                                                
# Since we suspect 2 modes, let's look for a single split point that minimizes  
total squared error                                                             
def get_mse(X_seg, y_seg):                                                      
    if len(y_seg) < 3: return 0                                                 
    model = LinearRegression().fit(X_seg, y_seg)                                
    preds = model.predict(X_seg)                                                
    return np.sum((y_seg - preds)**2)                                           
                                                                                
best_split = 0                                                                  
min_error = float('inf')                                                        
                                                                                
# To speed up, check every 100 points                                           
for i in range(500, len(x) - 500, 100):                                         
    err1 = get_mse(X[:i], y[:i])                                                
    err2 = get_mse(X[i:], y[i:])                                                
    if err1 + err2 < min_error:                                                 
        min_error = err1 + err2                                                 
        best_split = i                                                          
                                                                                
print(f"Best split point found at index: {best_split}")                         
print(f"State value at split: {x[best_split]}")                                 
print(f"Velocity value at split: {v[best_split]}")                              
                                                                                
# Now fit the two modes                                                         
def fit_mode(X_seg, y_seg):                                                     
    model = LinearRegression().fit(X_seg, y_seg)                                
    # x1[2] = a * x1[1] + b * x1[0] + c                                         
    # coefficients: a is model.coef_[0], b is model.coef_[1], c is              
model.intercept_                                                                
    return model.coef_[0], model.coef_[1], model.intercept_                     
                                                                                
a1, b1, c1 = fit_mode(X[:best_split], y[:best_split])                           
a2, b2, c2 = fit_mode(X[best_split:], y[best_split:])                           
                                                                                
print(f"Mode 1: a={a1}, b={b1}, c={c1}")                                        
print(f"Mode 2: a={a2}, b={b2}, c={c2}")                                        
                                                                                
# Check for resets: x and v continuity at the split                             
print(f"Jump in x: {x[best_split] - x[best_split-1]}")                          
print(f"Jump in v: {v[best_split] - v[best_split-1]}")                          
                                                                                
