# Check residuals of a global fit                                               
params, residuals, rank, s = np.linalg.lstsq(A, ddx1, rcond=None)               
global_resid = ddx1 - A @ params                                                
                                                                                
print(f"Global fit residuals mean: {np.mean(np.abs(global_resid))}")            
                                                                                
