│         "var": "x1, x2",                                                     │
│         "input": "u1",                                                       │
│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[1\] = x2[0\], x2[1\] = x1[0\] + u1"                │
│             }                                                                │
│         ],                                                                   │
│         "edge": [                                                            │
│             {                                                                │
