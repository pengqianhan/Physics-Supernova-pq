    results = {}                                                                
    for m in [0, 1]:                                                            
        df_m = df_all[df_all['mode'] == m]                                      
        # X^(2) = a*X^(1) + b*X^(0) + c                                         
        # (ddx1/dt^2) = a*(dx1/dt) + b*(x1) + c                                 
        Y = df_m['ddx1'].values / (dt**2)                                       
        X_mat = np.column_stack([df_m['dx1'].values / dt, df_m['x1'].values,    
np.ones(len(df_m))])                                                            
        coeffs, _, _, _ = np.linalg.lstsq(X_mat, Y, rcond=None)                 
        results[m] = coeffs                                                     
                                                                                
    # Find thresholds and state resets                                          
    transitions = []                                                            
    for s in range(3):                                                          
        samp = df_all[df_all['sample'] == s].copy()                             
        samp['mode_change'] = samp['mode'].diff()                               
        trans_idx = samp[samp['mode_change'] != 0].index[1:] # Skip first       
        for idx in trans_idx:                                                   
            row = df_all.iloc[idx]                                              
            prev = df_all.iloc[idx-1]                                           
            transitions.append({                                                
                'from': prev['mode'],                                           
                'to': row['mode'],                                              
                'x1': row['x1'],                                                
                'dx1_dt': row['dx1']/dt                                         
            })                                                                  
                                                                                
    trans_df = pd.DataFrame(transitions)                                        
                                                                                
    # Identify starting modes                                                   
    init_modes = {}                                                             
    for s in range(3):                                                          
        mode = df_all[df_all['sample'] == s].iloc[0]['mode']                    
        init_modes[s] = mode                                                    
                                                                                
    return results, trans_df, init_modes                                        
                                                                                
