import numpy as np                                                              
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    x1 = data['state'][0]                                                       
    dt = 0.01                                                                   
    x1_dot = np.gradient(x1, dt)                                                
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    # Identify switches                                                         
    ddot_diff = np.abs(np.diff(x1_ddot))                                        
    threshold = np.mean(ddot_diff) + 5 * np.std(ddot_diff)                      
    switches = np.where(ddot_diff > threshold)[0]                               
                                                                                
    consolidated_switches = []                                                  
    if len(switches) > 0:                                                       
        consolidated_switches.append(switches[0])                               
        for s in switches[1:]:                                                  
            if s - consolidated_switches[-1] > 20:                              
                consolidated_switches.append(s)                                 
                                                                                
    # Define segments (excluding indices near switches to avoid                 
transients/noise)                                                               
    indices = [0] + [s for s in consolidated_switches] + [len(x1)]              
    modes_results = []                                                          
                                                                                
    for i in range(len(indices)-1):                                             
        start = indices[i] + 5                                                  
        end = indices[i+1] - 5                                                  
        if end - start < 10: continue                                           
                                                                                
        A = np.column_stack((x1_dot[start:end], x1[start:end], np.ones(end -    
start)))                                                                        
        y = x1_ddot[start:end]                                                  
        coeffs, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                     
                                                                                
        # Calculate R2 using np.dot                                             
        y_pred = np.dot(A, coeffs)                                              
        y_mean = np.mean(y)                                                     
        ss_tot = np.sum((y - y_mean)**2)                                        
        ss_res = np.sum((y - y_pred)**2)                                        
        r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else 0                        
                                                                                
        modes_results.append({                                                  
            'coeffs': coeffs,                                                   
            'r2': r2,                                                           
            'switch_val': x1[indices[i+1]] if i < len(indices)-2 else None,     
            'switch_dot_val': x1_dot[indices[i+1]] if i < len(indices)-2 else   
None                                                                            
        })                                                                      
                                                                                
    return modes_results                                                        
                                                                                
all_results = []                                                                
for path in DATA_FILE_PATHS:                                                    
    all_results.append(analyze_sample(path))                                    
                                                                                
# Print results for the first sample to inspect                                 
for i, mode in enumerate(all_results[0]):                                       
    a, b, c = mode['coeffs']                                                    
    print(f"Sample 0 Mode {i+1}: a={a:.4f}, b={b:.4f}, c={c:.4f},               
