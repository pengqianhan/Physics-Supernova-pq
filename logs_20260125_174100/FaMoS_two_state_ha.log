import numpy as np                                                              
                                                                                
def find_best_split(file_path):                                                 
    data = np.load(file_path)                                                   
    x = data['state'][0]                                                        
    dt = 0.001                                                                  
    v = np.gradient(x, dt)                                                      
    acc = np.gradient(v, dt)                                                    
    N = len(x)                                                                  
                                                                                
    best_split = -1                                                             
    min_total_res = float('inf')                                                
    for split in range(500, N - 500, 200):                                      
        X1 = np.column_stack((v[:split], x[:split], np.ones(split)))            
        y1 = acc[:split]                                                        
        p1, res1, _, _ = np.linalg.lstsq(X1, y1, rcond=None)                    
        r1 = res1[0] if len(res1) > 0 else 0                                    
        X2 = np.column_stack((v[split:], x[split:], np.ones(N - split)))        
        y2 = acc[split:]                                                        
        p2, res2, _, _ = np.linalg.lstsq(X2, y2, rcond=None)                    
        r2 = res2[0] if len(res2) > 0 else 0                                    
        if r1 + r2 < min_total_res:                                             
            min_total_res = r1 + r2                                             
            best_split = split                                                  
                                                                                
    return best_split, min_total_res / N                                        
                                                                                
