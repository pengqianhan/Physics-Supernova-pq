import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
def analyze_sample(file_path):                                                  
    data = np.load(file_path)                                                   
    # Assume 'X' contains [x1, x1_dot] and 't' is time                          
    X = data['X']                                                               
    t = data['t'].flatten()                                                     
    dt = t[1] - t[0]                                                            
                                                                                
    x1 = X[:, 0]                                                                
    x1_dot = X[:, 1]                                                            
                                                                                
    # Estimate x1_ddot using finite differences of x1_dot                       
    x1_ddot = np.gradient(x1_dot, dt)                                           
                                                                                
    return t, x1, x1_dot, x1_ddot                                               
                                                                                
# Load and combine data to identify modes                                       
all_data = []                                                                   
for i in range(3):                                                              
    t, x1, x1_dot, x1_ddot = analyze_sample(DATA_FILE_PATHS[i])                 
    df = pd.DataFrame({'t': t, 'x1': x1, 'x1_dot': x1_dot, 'x1_ddot': x1_ddot,  
'sample': i})                                                                   
    all_data.append(df)                                                         
                                                                                
df_all = pd.concat(all_data).reset_index(drop=True)                             
                                                                                
# Detect modes based on x1_ddot behavior                                        
# We expect x1_ddot = a*x1_dot + b*x1 + c                                       
# Looking for clusters in (x1_ddot - a*x1_dot - b*x1)                           
# Initial guess for a, b (e.g., small damping/stiffness) or just looking at the 
distribution                                                                    
# Let's try to find discontinuities in x1_ddot that aren't explained by smooth  
