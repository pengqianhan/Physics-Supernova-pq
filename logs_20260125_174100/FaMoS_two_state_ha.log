import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
from sklearn.linear_model import LinearRegression                               
                                                                                
dt = 0.001                                                                      
data_paths = [                                                                  
    'data_all/FaMoS/two_state_ha/sample_0.npz',                                 
    'data_all/FaMoS/two_state_ha/sample_1.npz',                                 
    'data_all/FaMoS/two_state_ha/sample_2.npz'                                  
]                                                                               
                                                                                
