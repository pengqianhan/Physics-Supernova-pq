import numpy as np                                                              
from scipy.signal import find_peaks                                             
                                                                                
def analyze_oscillator_data(file_paths):                                        
    all_seg_A = []                                                              
    all_seg_B = []                                                              
    all_peaks = []                                                              
    all_troughs = []                                                            
                                                                                
    dt = 0.001                                                                  
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        # state is (1, 10001) based on inspection                               
