    m2_err = np.abs(ddx - (-0.05*dx - 0.005*x))                                 
                                                                                
    active_mode = np.where(m1_err < m2_err, 1, 2)                               
    switches = np.where(np.diff(active_mode) != 0)[0]                           
                                                                                
    return active_mode, switches, dx, ddx, x_val                                
                                                                                
