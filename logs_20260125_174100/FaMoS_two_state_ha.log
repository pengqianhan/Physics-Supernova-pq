import numpy as np                                                              
                                                                                
dt = 0.01                                                                       
def get_data(path):                                                             
    data = np.load(path)['state'][0]                                            
    v = (data[2:] - data[:-2]) / (2 * dt)                                       
    a = (data[2:] - 2 * data[1:-1] + data[:-2]) / (dt**2)                       
    x = data[1:-1]                                                              
    return x, v, a                                                              
                                                                                
all_x, all_v, all_a = [], [], []                                                
for path in DATA_FILE_PATHS:                                                    
    x, v, a = get_data(path)                                                    
    all_x.append(x)                                                             
    all_v.append(v)                                                             
    all_a.append(a)                                                             
                                                                                
def calc_mse(x, v, a, mask, c):                                                 
    if np.sum(mask) == 0: return 0                                              
    A = np.stack([v[mask], x[mask], np.ones(np.sum(mask))], axis=1)             
    # Using np.dot instead of @                                                 
    preds = np.dot(A, c)                                                        
    return np.sum((a[mask] - preds)**2)                                         
                                                                                
# V-split                                                                       
v_coeffs_pos = fit(np.concatenate(all_v) > 0) # I need to define fit() again or 
use the previous result                                                         
v_coeffs_neg = fit(np.concatenate(all_v) < 0)                                   
                                                                                
# X-split                                                                       
x_coeffs_low = fit(np.concatenate(all_x) < 25)                                  
x_coeffs_high = fit(np.concatenate(all_x) >= 25)                                
                                                                                
total_v_err = 0                                                                 
total_x_err = 0                                                                 
n_points = 0                                                                    
for i in range(3):                                                              
    x, v, a = all_x[i], all_v[i], all_a[i]                                      
    total_v_err += calc_mse(x, v, a, v > 0, v_coeffs_pos)                       
    total_v_err += calc_mse(x, v, a, v < 0, v_coeffs_neg)                       
    total_x_err += calc_mse(x, v, a, x < 25, x_coeffs_low)                      
    total_x_err += calc_mse(x, v, a, x >= 25, x_coeffs_high)                    
    n_points += len(x)                                                          
                                                                                
print(f"Total V-split MSE: {total_v_err / n_points}")                           
print(f"Total X-split MSE: {total_x_err / n_points}")                           
                                                                                
