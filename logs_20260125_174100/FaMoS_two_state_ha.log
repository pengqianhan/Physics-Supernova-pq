      np.random.seed(42)                                                        
      centroids = data[np.random.choice(data.shape[0], k, replace=False)]       
      for _ in range(20):                                                       
          distances = np.linalg.norm(data[:, np.newaxis] - centroids, axis=2)   
          labels = np.argmin(distances, axis=1)                                 
          centroids = np.array([data[labels == i].mean(axis=0) for i in         
  range(k)])                                                                    
      return labels, centroids                                                  
                                                                                
  features = full_df[['x', 'v', 'a']].values                                    
  features_norm = (features - features.mean(axis=0)) / features.std(axis=0)     
  full_df['mode'], norm_centroids = simple_kmeans(features_norm, k=2)           
                                                                                
  # Parameter estimation                                                        
  results = {}                                                                  
  for m in [0, 1]:                                                              
      m_data = full_df[full_df['mode'] == m]                                    
      A = np.column_stack([m_data['v'], m_data['x'], np.ones(len(m_data))])     
      y = m_data['a']                                                           
      p, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                            
      results[m] = {'a': p[0], 'b': p[1], 'c': p[2]}                            
                                                                                
  # Refine transition analysis                                                  
  transitions = []                                                              
  for df in all_data_list:                                                      
      seq_feat = (df[['x', 'v', 'a']].values - features.mean(axis=0)) /         
  features.std(axis=0)                                                          
      df['mode'] = np.argmin(np.linalg.norm(seq_feat[:, np.newaxis] -           
  norm_centroids, axis=2), axis=1)                                              
      changes = df.index[df['mode'].diff().fillna(0) != 0]                      
      for idx in changes:                                                       
          if idx > 0:                                                           
              transitions.append({                                              
                  'from': df.loc[idx-1, 'mode'], 'to': df.loc[idx, 'mode'],     
                  'x': df.loc[idx-1, 'x'], 'v': df.loc[idx-1, 'v'],             
                  'dx': df.loc[idx, 'x'] - df.loc[idx-1, 'x'],                  
                  'dv': df.loc[idx, 'v'] - df.loc[idx-1, 'v']                   
              })                                                                
                                                                                
  # Format output                                                               
  output = []                                                                   
  for m in sorted(results.keys()):                                              
      r = results[m]                                                            
      output.append(f"Mode {m}: x'' = {r['a']:.3f}*x' + {r['b']:.3f}*x +        
  {r['c']:.3f}")                                                                
                                                                                
  guards = {}                                                                   
  for t in transitions:                                                         
      key = (int(t['from']), int(t['to']))                                      
      guards.setdefault(key, []).append(t['x'])                                 
                                                                                
  guard_strs = [f"Mode {k[0]} -> Mode {k[1]} when x1 ≈ {np.mean(v):.2f}" for    
  k, v in guards.items()]                                                       
                                                                                
  print("\n".join(output))                                                      
  print("\n".join(guard_strs))                                                  
