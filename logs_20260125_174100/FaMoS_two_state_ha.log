              all_x1_ddot_m2.append(xdd[i])                                     
                                                                                
  def fit_data(x, xd, xdd):                                                     
      A = np.column_stack([xd, x, np.ones_like(x)])                             
      p, residuals, rank, s = np.linalg.lstsq(A, xdd, rcond=None)               
      preds = np.dot(A, p)                                                      
      mse = np.mean((xdd - preds)**2)                                           
      return p, mse                                                             
                                                                                
  p1, mse1 = fit_data(np.array(all_x1_m1), np.array(all_x1_dot_m1),             
  np.array(all_x1_ddot_m1))                                                     
  p2, mse2 = fit_data(np.array(all_x1_m2), np.array(all_x1_dot_m2),             
