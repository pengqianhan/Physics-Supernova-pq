      a = (data[2:] - 2 * data[1:-1] + data[:-2]) / (dt**2)                     
      x = data[1:-1]                                                            
      return x, v, a                                                            
                                                                                
  all_x_list, all_v_list, all_a_list = [], [], []                               
  for path in DATA_FILE_PATHS:                                                  
      x, v, a = get_data(path)                                                  
      all_x_list.append(x)                                                      
      all_v_list.append(v)                                                      
      all_a_list.append(a)                                                      
                                                                                
  X_flat = np.concatenate(all_x_list)                                           
  V_flat = np.concatenate(all_v_list)                                           
  A_flat = np.concatenate(all_a_list)                                           
                                                                                
  def fit_data(x, v, a):                                                        
      M = np.stack([v, x, np.ones_like(x)], axis=1)                             
      coeffs, _, _, _ = np.linalg.lstsq(M, a, rcond=None)                       
      return coeffs                                                             
                                                                                
  # Split by velocity                                                           
  mask_pos = V_flat > 0                                                         
  mask_neg = V_flat < 0                                                         
  c_pos = fit_data(X_flat[mask_pos], V_flat[mask_pos], A_flat[mask_pos])        
  c_neg = fit_data(X_flat[mask_neg], V_flat[mask_neg], A_flat[mask_neg])        
                                                                                
  # Compute MSE for v-split                                                     
  def get_mse(x, v, a, coeffs):                                                 
      M = np.stack([v, x, np.ones_like(x)], axis=1)                             
      preds = np.dot(M, coeffs)                                                 
      return np.mean((a - preds)**2)                                            
                                                                                
  mse_pos = get_mse(X_flat[mask_pos], V_flat[mask_pos], A_flat[mask_pos],       
  c_pos)                                                                        
  mse_neg = get_mse(X_flat[mask_neg], V_flat[mask_neg], A_flat[mask_neg],       
  c_neg)                                                                        
  total_v_mse = (mse_pos * np.sum(mask_pos) + mse_neg * np.sum(mask_neg)) /     
  len(V_flat)                                                                   
                                                                                
  print(f"V-split Coeffs Pos: {c_pos}, Neg: {c_neg}")                           
  print(f"V-split Total MSE: {total_v_mse}")                                    
                                                                                
  # Split by x threshold                                                        
  thresholds = [10, 15, 20, 25]                                                 
