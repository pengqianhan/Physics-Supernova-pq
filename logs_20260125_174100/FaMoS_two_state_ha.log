  # Compute second differences to find the threshold for modes                  
  all_d2 = []                                                                   
  for s in samples:                                                             
      d2 = s[2:] - 2*s[1:-1] + s[:-2]                                           
      all_d2.append(d2)                                                         
  all_d2_flat = np.concatenate(all_d2)                                          
  threshold = np.median(all_d2_flat)                                            
                                                                                
  # Collect data for linear regression per mode                                 
  # Target: x[k+2] = a*x[k+1] + b*x[k] + c                                      
  mode_data = {                                                                 
