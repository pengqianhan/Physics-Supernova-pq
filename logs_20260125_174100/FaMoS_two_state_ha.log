      data = np.load(path)                                                      
      # Using 'state' key as discovered earlier                                 
      x = data['state'][0, :]                                                   
      v = np.gradient(x, dt)                                                    
      a = np.gradient(v, dt)                                                    
      all_x.append(x)                                                           
      all_v.append(v)                                                           
      all_a.append(a)                                                           
                                                                                
  # Determine modes using hysteresis logic:                                     
  # Mode 1 -> Mode 2 when x1 <= 15                                              
  # Mode 2 -> Mode 1 when x1 >= 25                                              
  def get_modes(x_data, low=15, high=25):                                       
      modes = np.zeros_like(x_data, dtype=int)                                  
      # Heuristic for initial mode based on position relative to thresholds     
      curr = 1 if x_data[0] > 15 else 2                                         
      for i in range(len(x_data)):                                              
          if curr == 1 and x_data[i] <= low:                                    
              curr = 2                                                          
          elif curr == 2 and x_data[i] >= high:                                 
              curr = 1                                                          
          modes[i] = curr                                                       
      return modes                                                              
                                                                                
  X1_all = np.concatenate(all_x)                                                
  V1_all = np.concatenate(all_v)                                                
  A1_all = np.concatenate(all_a)                                                
  modes_all = np.concatenate([get_modes(x) for x in all_x])                     
                                                                                
  def fit_reg(x_vals, v_vals, a_vals, mode_indices):                            
      # Features: [x1', x1, 1]                                                  
      X = np.column_stack([v_vals[mode_indices], x_vals[mode_indices],          
  np.ones(np.sum(mode_indices))])                                               
      y = a_vals[mode_indices]                                                  
      params, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)            
                                                                                
      # Calculate R-squared using np.dot instead of @                           
      y_pred = np.dot(X, params)                                                
      ss_res = np.sum((y - y_pred)**2)                                          
      ss_tot = np.sum((y - np.mean(y))**2)                                      
      r2 = 1 - (ss_res / ss_tot)                                                
                                                                                
      return params, r2                                                         
                                                                                
