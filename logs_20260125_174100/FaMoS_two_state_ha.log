    A = np.column_stack([m_dx, m_x, np.ones_like(m_x)])                         
    # Solve for [c1, c0, bias]                                                  
    coefs, residues, rank, s = lstsq(A, m_ddx)                                  
    mode_equations.append({'id': i, 'coefs': coefs, 'switch_val': switch_val})  
