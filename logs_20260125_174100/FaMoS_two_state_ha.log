# For simplicity, we can look at the sign of x1 or x1_dot if it's a simple      
physical system like a bouncing ball or oscillator with deadband.               
# Let's look for jumps in x1_ddot that are not explained by x1 and x1_dot.      
residuals = []                                                                  
# We'll first fit a global model to see where it fails                          
X = df[['x1_dot', 'x1']].values                                                 
y = df['x1_ddot'].values                                                        
reg = LinearRegression().fit(X, y)                                              
pred = reg.predict(X)                                                           
error = np.abs(y - pred)                                                        
                                                                                
# If the error is large at certain points, it indicates a mode switch           
threshold = np.percentile(error, 95)                                            
df['potential_switch'] = error > threshold                                      
                                                                                
# Print some stats                                                              
print(f"Global model coefficients: {reg.coef_}, Intercept: {reg.intercept_}")   
print(f"Max error: {np.max(error)}")                                            
print(f"Mean error: {np.mean(error)}")                                          
                                                                                
# Identify clusters or segments.                                                
# Since it's a "two_state_ha" (from file path), there are likely 2 modes.       
# Let's use x1 to partition the data if possible, or use clustering on the (x,  
x_dot, x_ddot) space.                                                           
from sklearn.cluster import KMeans                                              
features = df[['x1', 'x1_dot', 'x1_ddot']].values                               
# Normalize features                                                            
features_norm = (features - features.mean(axis=0)) / features.std(axis=0)       
kmeans = KMeans(n_clusters=2, random_state=0).fit(features_norm)                
df['mode'] = kmeans.labels_                                                     
                                                                                
# Fit models for each mode                                                      
modes = {}                                                                      
for m in df['mode'].unique():                                                   
    subset = df[df['mode'] == m]                                                
    X_m = subset[['x1_dot', 'x1']].values                                       
    y_m = subset['x1_ddot'].values                                              
    reg_m = LinearRegression().fit(X_m, y_m)                                    
    modes[m] = {                                                                
        'a': reg_m.coef_[0],                                                    
        'b': reg_m.coef_[1],                                                    
        'c': reg_m.intercept_,                                                  
        'score': reg_m.score(X_m, y_m),                                         
        'x1_range': (subset['x1'].min(), subset['x1'].max())                    
    }                                                                           
                                                                                
print("Mode details:", modes)                                                   
                                                                                
# Check for guards                                                              
# Find transitions                                                              
df['mode_change'] = df['mode'].diff().fillna(0) != 0                            
transitions = df[df['mode_change']]                                             
print("Transitions at x1 values:", transitions['x1'].values)                    
                                                                                
