import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load all data                                                                 
all_states = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # 'state' seems to be (N, 2) or (N, 1). Let's check first sample.           
    state = data['state']                                                       
    all_states.append(state)                                                    
                                                                                
# Concatenate for analysis                                                      
state_concat = np.concatenate(all_states)                                       
# Assuming x1 is the first column                                               
x1 = state_concat[:, 0]                                                         
dt = 0.001                                                                      
                                                                                
# Calculate derivatives per trajectory to avoid jumps                           
processed_trajectories = []                                                     
for state in all_states:                                                        
    x = state[:, 0]                                                             
    dx = np.gradient(x, dt)                                                     
    ddx = np.gradient(dx, dt)                                                   
    traj_df = pd.DataFrame({'x': x, 'dx': dx, 'ddx': ddx})                      
    processed_trajectories.append(traj_df)                                      
                                                                                
full_df = pd.concat(processed_trajectories, ignore_index=True)                  
                                                                                
print(f"x range: {full_df['x'].min()} to {full_df['x'].max()}")                 
                                                                                
def solve_regression(df_subset):                                                
    if len(df_subset) < 20: return None                                         
    # ddx = c1*dx + c0*x + bias                                                 
    A = np.column_stack([df_subset['dx'], df_subset['x'],                       
np.ones(len(df_subset))])                                                       
    b = df_subset['ddx'].values                                                 
    sol, residuals, rank, s = np.linalg.lstsq(A, b, rcond=None)                 
    # R-squared calculation                                                     
    y_mean = np.mean(b)                                                         
    ss_tot = np.sum((b - y_mean)**2)                                            
    ss_res = np.sum((b - A @ sol)**2)                                           
    r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else 0                            
    return sol, r2                                                              
                                                                                
# Try different regions based on the hint (switching near 15 and 25)            
regions = [                                                                     
    (full_df['x'] < 15),                                                        
    ((full_df['x'] >= 15) & (full_df['x'] <= 25)),                              
    (full_df['x'] > 25)                                                         
]                                                                               
                                                                                
for i, region in enumerate(regions):                                            
    res = solve_regression(full_df[region])                                     
    if res:                                                                     
        sol, r2 = res                                                           
        print(f"Region {i} (count={sum(region)}): c1={sol[0]:.4f},              
