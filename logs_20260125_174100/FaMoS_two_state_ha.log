│                                                                              │
│ ### Examples                                                                 │
│                                                                              │
│ **Single-mode 2nd-order:**                                                   │
│ ```json                                                                      │
│ {                                                                            │
│     "automaton": {                                                           │
│         "var": "x1",                                                         │
│         "input": "u1",                                                       │
│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[2\] = x1[1\] + x1[0\] + x1[0\] ** 2 + u1"          │
│             }                                                                │
│         ],                                                                   │
│         "edge": []                                                           │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.001,                                                         │
│         "total_time": 10.0,                                                  │
│         "order": 2,                                                          │
│         "need_reset": false,                                                 │
│         "non_linear_items": "x1[?\] ** 2"                                    │
│     }                                                                        │
│ }                                                                            │
│ ```                                                                          │
│                                                                              │
│ **Two-mode switching:**                                                      │
│ ```json                                                                      │
│ {                                                                            │
│     "automaton": {                                                           │
│         "var": "x1",                                                         │
│         "mode": [                                                            │
│             {                                                                │
│                 "id": 1,                                                     │
│                 "eq": "x1[1\] = x1[0\] + 5"                                  │
│             },                                                               │
│             {                                                                │
│                 "id": 2,                                                     │
│                 "eq": "x1[1\] = -x1[0\] - 3"                                 │
│             }                                                                │
│         ],                                                                   │
│         "edge": [                                                            │
│             {                                                                │
│                 "direction": "1 -> 2",                                       │
│                 "condition": "x1 >= 4"                                       │
│             },                                                               │
│             {                                                                │
│                 "direction": "2 -> 1",                                       │
│                 "condition": "x1 <= 9"                                       │
│             }                                                                │
│         \]                                                                   │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.01,                                                          │
