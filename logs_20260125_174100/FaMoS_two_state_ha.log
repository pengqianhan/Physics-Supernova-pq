# We suspect two modes based on "two_state_ha" in the path                      
from sklearn.cluster import KMeans                                              
                                                                                
# Feature matrix for regression                                                 
X = np.column_stack([all_v, all_x, np.ones_like(all_x)])                        
y = all_a                                                                       
                                                                                
# Use a simple heuristic or clustering if needed                                
# Let's look at the distribution of residuals from a single fit                 
from sklearn.linear_model import LinearRegression                               
model = LinearRegression()                                                      
model.fit(X, y)                                                                 
resid = y - model.predict(X)                                                    
                                                                                
plt.figure()                                                                    
plt.hist(resid, bins=100)                                                       
plt.savefig('residuals_hist.png')                                               
print("Residuals histogram saved.")                                             
                                                                                
