      1: {'X': [], 'Y': []}                                                     
  }                                                                             
                                                                                
  for s in samples:                                                             
      for k in range(len(s) - 2):                                               
          d2_val = s[k+2] - 2*s[k+1] + s[k]                                     
          mode = 1 if d2_val > threshold else 0                                 
          mode_data[mode]['X'].append([s[k+1], s[k], 1.0])                      
          mode_data[mode]['Y'].append(s[k+2])                                   
                                                                                
  def solve_regression(X_list, Y_list):                                         
      X = np.array(X_list)                                                      
      Y = np.array(Y_list)                                                      
      # Solve X * coeffs = Y using least squares                                
      coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                       
      return coeffs                                                             
                                                                                
  coeffs0 = solve_regression(mode_data[0]['X'], mode_data[0]['Y'])              
  coeffs1 = solve_regression(mode_data[1]['X'], mode_data[1]['Y'])              
                                                                                
