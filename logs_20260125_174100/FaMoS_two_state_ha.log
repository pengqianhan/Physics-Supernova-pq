mask2 = all_pos >= 20                                                           
                                                                                
def get_coeffs(pos, vel, acc):                                                  
    if len(pos) < 10: return None                                               
    X = np.column_stack([vel, pos, np.ones_like(pos)])                          
    model = LinearRegression().fit(X, acc)                                      
    return model.coef_[0], model.coef_[1], model.intercept_                     
                                                                                
coeffs1 = get_coeffs(all_pos[mask1], all_vel[mask1], all_acc[mask1])            
