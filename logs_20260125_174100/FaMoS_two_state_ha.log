  all_labels = []                                                               
  for s in samples:                                                             
      s_labels = []                                                             
      for i in range(len(s) - 2):                                               
          feat = np.array([s[i+1], s[i], 1.0])                                  
          pred0 = np.dot(feat, mode_0_coeffs)                                   
          pred1 = np.dot(feat, mode_1_coeffs)                                   
          err0 = (s[i+2] - pred0)**2                                            
          err1 = (s[i+2] - pred1)**2                                            
          s_labels.append(0 if err0 < err1 else 1)                              
      all_labels.append(np.array(s_labels))                                     
                                                                                
