all_x = np.concatenate(all_x)                                                   
all_v = np.concatenate(all_v)                                                   
all_a = np.concatenate(all_a)                                                   
                                                                                
# Splitting by velocity sign                                                    
mask_pos = all_v > 0                                                            
mask_neg = all_v < 0                                                            
                                                                                
def fit(mx):                                                                    
    A = np.stack([all_v[mx], all_x[mx], np.ones(np.sum(mx))], axis=1)           
    c, _, _, _ = np.linalg.lstsq(A, all_a[mx], rcond=None)                      
    return c                                                                    
                                                                                
c_pos = fit(mask_pos)                                                           
c_neg = fit(mask_neg)                                                           
                                                                                
print("Mode 1 (v > 0):", c_pos)                                                 
print("Mode 2 (v < 0):", c_neg)                                                 
                                                                                
