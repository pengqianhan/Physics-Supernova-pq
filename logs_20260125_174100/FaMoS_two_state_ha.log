import numpy as np                                                              
                                                                                
# Load the data from Sample 0                                                   
data_path = "data_all/FaMoS/two_state_ha/sample_0.npz"                          
data = np.load(data_path)                                                       
state = data['state']                                                           
x1 = state[0]                                                                   
                                                                                
# Estimate derivatives using np.gradient with dt=1.0 (step-based)               
dt = 1.0                                                                        
x1_dot = np.gradient(x1, dt)                                                    
x1_ddot = np.gradient(x1_dot, dt)                                               
                                                                                
# Perform linear regression: x1_ddot = a*x1_dot + b*x1 + c                      
# Build the design matrix X = [x1_dot, x1, 1]                                   
X = np.column_stack((x1_dot, x1, np.ones_like(x1)))                             
y = x1_ddot                                                                     
                                                                                
# Solve for coefficients [a, b, c] using least squares                          
coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)                  
a, b, c = coeffs                                                                
                                                                                
# Calculate R-squared to evaluate fit quality                                   
y_pred = X @ coeffs                                                             
ss_res = np.sum((y - y_pred)**2)                                                
ss_tot = np.sum((y - np.mean(y))**2)                                            
r_squared = 1 - (ss_res / ss_tot)                                               
                                                                                
print(f"a: {a}")                                                                
print(f"b: {b}")                                                                
print(f"c: {c}")                                                                
