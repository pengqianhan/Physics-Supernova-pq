    x1 = X[:, 0]                                                                
                                                                                
    # Estimate derivatives                                                      
    # Using central differences or simple gradient                              
    dx1 = np.gradient(x1, dt)                                                   
    ddx1 = np.gradient(dx1, dt)                                                 
                                                                                
    all_x1.append(x1)                                                           
    all_dx1.append(dx1)                                                         
