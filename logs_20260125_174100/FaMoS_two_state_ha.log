    y = seg['x1_2']                                                             
    # Linear regression: y = X * beta                                           
    beta, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)                
    results.append({'beta': beta, 'val_at_switch': seg['val_at_switch']})       
                                                                                
# Cluster results into 2 modes (as suggested by the name)                       
# Sort by beta[1] which is the coefficient for x1_0                             
results.sort(key=lambda x: x['beta'][1])                                        
