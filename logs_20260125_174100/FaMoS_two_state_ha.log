for path in data_paths:                                                         
    data = np.load(path)                                                        
    x1 = data['x1']                                                             
                                                                                
    # Compute velocity and acceleration                                         
    v = np.diff(x1, axis=0) / dt                                                
    a = np.diff(v, axis=0) / dt                                                 
                                                                                
    # Align shapes: x1[0:-2], v[0:-1] or similar                                
    x_pos = x1[:-2]                                                             
    x_vel = v[:-1]                                                              
    x_acc = a                                                                   
                                                                                
    results.append({'pos': x_pos, 'vel': x_vel, 'acc': x_acc})                  
                                                                                
# Identify modes based on thresholds x1=15 and x1=25                            
# Combining data from all samples to get better regression                      
all_pos = np.concatenate([r['pos'] for r in results])                           
all_vel = np.concatenate([r['vel'] for r in results])                           
all_acc = np.concatenate([r['acc'] for r in results])                           
                                                                                
# Filter modes                                                                  
# Mode 1: x1 < 15 or 15 < x1 < 25 or x1 > 25?                                   
# Usually, hybrid systems have regions. Let's look at the behavior.             
# Let's assume two modes separated by a threshold.                              
# Check if x1 < 20 or similar.                                                  
