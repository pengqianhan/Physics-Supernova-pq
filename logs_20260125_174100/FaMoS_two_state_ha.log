mid = len(results) // 2                                                         
mode1_betas = [r['beta'] for r in results[:mid]]                                
mode2_betas = [r['beta'] for r in results[mid:]]                                
                                                                                
m1_avg = np.mean(mode1_betas, axis=0)                                           
m2_avg = np.mean(mode2_betas, axis=0)                                           
                                                                                
# Check guard                                                                   
switch_vals = [r['val_at_switch'] for r in results if r['val_at_switch'] is not 
None]                                                                           
guard_val = np.mean(switch_vals) if switch_vals else None                       
                                                                                
print(f"Mode 1 coeffs (a, b, c): {m1_avg}")                                     
print(f"Mode 2 coeffs (a, b, c): {m2_avg}")                                     
print(f"Detected Guard x1 ~: {guard_val}")                                      
                                                                                
# Check resets by comparing values at switches                                  
resets_found = False                                                            
for sample in all_data:                                                         
    sw = detect_switches(sample['x1_2'])                                        
    for s in sw:                                                                
        gap_0 = np.abs(sample['x1_0'][s+1] - sample['x1_0'][s])                 
