import numpy as np                                                              
from scipy.linalg import lstsq                                                  
                                                                                
def get_coefficients(x, v, acc):                                                
    A = np.column_stack((v, x, np.ones_like(x)))                                
    coeffs, _, _, _ = lstsq(A, acc)                                             
    return coeffs                                                               
                                                                                
all_coeffs = { "Mode A": [], "Mode B": [] }                                     
                                                                                
for sample_idx in range(3):                                                     
    data = np.load(DATA_FILE_PATHS[sample_idx])                                 
    x = data['state'][0]                                                        
    dt = 0.001                                                                  
    v = np.diff(x) / dt                                                         
    acc = np.diff(v) / dt                                                       
                                                                                
    diff_acc = np.abs(np.diff(acc))                                             
    transitions = np.where(diff_acc > np.std(diff_acc) * 10)[0]                 
                                                                                
    # Filter transitions to get distinct ones (taking the first of a cluster)   
    if len(transitions) > 0:                                                    
        distinct_transitions = [transitions[0]]                                 
        for t in transitions[1:]:                                               
            if t > distinct_transitions[-1] + 10:                               
                distinct_transitions.append(t)                                  
    else:                                                                       
        distinct_transitions = []                                               
                                                                                
    # Segment bounds                                                            
    bounds = [0] + distinct_transitions + [len(acc)]                            
                                                                                
    for i in range(len(bounds) - 1):                                            
        start = bounds[i] + 5                                                   
        end = bounds[i+1] - 5                                                   
        if end - start < 100: continue                                          
                                                                                
        c = get_coefficients(x[start:end], v[start:end], acc[start:end])        
        mode = "Mode A" if c[1] > 0 else "Mode B"                               
        all_coeffs[mode].append(c)                                              
        print(f"Sample {sample_idx}, Segment {i}: Mode {'A' if c[1] > 0 else    
'B'}, a={c[0]:.4f}, b={c[1]:.4f}, c={c[2]:.4f}")                                
                                                                                
for mode in all_coeffs:                                                         
    avg = np.mean(all_coeffs[mode], axis=0)                                     
    print(f"Average {mode}: a={avg[0]:.4f}, b={avg[1]:.4f}, c={avg[2]:.4f}")    
                                                                                
