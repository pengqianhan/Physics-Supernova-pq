def get_derivatives(x, dt):                                                     
    dx = np.diff(x) / dt                                                        
    ddx = np.diff(dx) / dt                                                      
    return dx[:-1], ddx, x[:-2]                                                 
                                                                                
def find_switch(x_data, dt):                                                    
    dx, ddx, x_val = get_derivatives(x_data, dt)                                
    # Mode 1: ddx = -0.05*dx + 0.005*x + 0                                      
