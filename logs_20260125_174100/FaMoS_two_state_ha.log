import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
dt = 0.001                                                                      
results = []                                                                    
                                                                                
for i, path in enumerate(DATA_FILE_PATHS):                                      
    data = np.load(path)                                                        
    x1 = data['x1'][0] # Shape (num_steps,)                                     
                                                                                
    # Finite differences                                                        
    v = np.diff(x1) / dt                                                        
    a = np.diff(v) / dt                                                         
                                                                                
    # Align lengths                                                             
    x1_val = x1[:-2]                                                            
    v_val = v[:-1]                                                              
                                                                                
    results.append({                                                            
        'x': x1_val,                                                            
        'v': v_val,                                                             
        'a': a                                                                  
    })                                                                          
                                                                                
# Combine all data for global analysis                                          
all_x = np.concatenate([res['x'] for res in results])                           
all_v = np.concatenate([res['v'] for res in results])                           
all_a = np.concatenate([res['a'] for res in results])                           
                                                                                
# Plotting to see if there are clusters                                         
plt.figure(figsize=(10, 6))                                                     
plt.scatter(all_x, all_a, c=all_v, s=1, cmap='viridis')                         
plt.xlabel('x1')                                                                
plt.ylabel('x1_ddot')                                                           
plt.title('Acceleration vs Position (colored by Velocity)')                     
plt.savefig('scatter_plot.png')                                                 
print("Scatter plot saved.")                                                    
                                                                                
