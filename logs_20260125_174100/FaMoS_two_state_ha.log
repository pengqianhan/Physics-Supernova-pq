import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data and prepare variables                                               
dt = 0.001                                                                      
data_list = []                                                                  
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # The task says 'x1' is the variable. Let's assume 'state' contains x1.     
    # We'll check the shape.                                                    
    state = data['state']                                                       
    if len(state.shape) > 1 and state.shape[1] > 0:                             
        x1 = state[:, 0]                                                        
    else:                                                                       
        x1 = state.flatten()                                                    
                                                                                
    # Calculate derivatives                                                     
    v1 = np.gradient(x1, dt)                                                    
    a1 = np.gradient(v1, dt)                                                    
                                                                                
    df = pd.DataFrame({'x1': x1, 'v1': v1, 'a1': a1})                           
    data_list.append(df)                                                        
                                                                                
full_data = pd.concat(data_list, ignore_index=True)                             
                                                                                
# Identify modes based on thresholds 15 and 25                                  
# Likely modes: Mode 1: x1 < 15, Mode 2: 15 <= x1 < 25, Mode 3: x1 >= 25        
# Let's check the range of x1                                                   
print(f"x1 range: {full_data['x1'].min()} to {full_data['x1'].max()}")          
                                                                                
def get_mode(x):                                                                
    if x < 15: return 0                                                         
    elif x < 25: return 1                                                       
    else: return 2                                                              
                                                                                
full_data['mode'] = full_data['x1'].apply(get_mode)                             
                                                                                
results = {}                                                                    
for m in full_data['mode'].unique():                                            
    subset = full_data[full_data['mode'] == m]                                  
    if len(subset) < 10: continue                                               
                                                                                
    X = subset[['v1', 'x1']].values                                             
    y = subset['a1'].values                                                     
                                                                                
    model = LinearRegression().fit(X, y)                                        
    a, b = model.coef_                                                          
    c = model.intercept_                                                        
    results[m] = {'a': a, 'b': b, 'c': c, 'score': model.score(X, y)}           
                                                                                
print(results)                                                                  
                                                                                
