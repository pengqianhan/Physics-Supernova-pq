  'data_all/FaMoS/two_state_ha/sample_2.npz']                                   
                                                                                
  dfs = []                                                                      
  for i, path in enumerate(data_files):                                         
      data = np.load(path)                                                      
      x1 = data['state'][0]                                                     
      v = np.diff(x1) / dt                                                      
      a = np.diff(v) / dt                                                       
      n = len(a)                                                                
      df = pd.DataFrame({                                                       
          'x1': x1[:n],                                                         
          'v': v[:n],                                                           
          'a': a[:n],                                                           
          'trace': i                                                            
      })                                                                        
                                                                                
      # Identify initial mode and labeling                                      
      # Hysteresis: switch 1->2 at x1=25, 2->1 at x1=15                         
      modes = []                                                                
      # If initial x1 is between 15 and 25, we need to know the initial mode.   
      # Looking at the trace 0: starts at 10.008 -> Mode 1.                     
      # Let's check start of each trace.                                        
      start_x = df.iloc[0]['x1']                                                
      if start_x < 25:                                                          
          current_mode = 1                                                      
      else:                                                                     
          current_mode = 2                                                      
                                                                                
      for _, row in df.iterrows():                                              
          x = row['x1']                                                         
          if current_mode == 1 and x > 25:                                      
              current_mode = 2                                                  
          elif current_mode == 2 and x < 15:                                    
              current_mode = 1                                                  
          modes.append(current_mode)                                            
      df['mode'] = modes                                                        
      dfs.append(df)                                                            
      print(f"Trace {i} start x1: {start_x:.2f}, start mode: {modes[0]}")       
                                                                                
  df_all = pd.concat(dfs, ignore_index=True)                                    
                                                                                
  def fit_mode_refined(df_subset):                                              
      Y = df_subset['a'].values                                                 
      X = df_subset[['v', 'x1']].values                                         
      X = np.column_stack([X, np.ones(len(X))])                                 
      coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                       
      # Manual residual calculation                                             
      preds = np.dot(X, coeffs)                                                 
      mse = np.mean((Y - preds)**2)                                             
      return coeffs, mse                                                        
                                                                                
  c1, mse1 = fit_mode_refined(df_all[df_all['mode'] == 1])                      
  c2, mse2 = fit_mode_refined(df_all[df_all['mode'] == 2])                      
                                                                                
  print(f"Mode 1 Coeffs (v, x1, const): {c1}, MSE: {mse1:.4e}")                 
  print(f"Mode 2 Coeffs (v, x1, const): {c2}, MSE: {mse2:.4e}")                 
