for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    state = data['state'] # (N, 2)                                              
    t = data['t'] # (N,)                                                        
                                                                                
    # x1 = state[:, 0], x2 = state[:, 1]                                        
    dx = np.diff(state, axis=0) / np.diff(t)[:, np.newaxis]                     
    x_mid = state[:-1]                                                          
                                                                                
    all_x.append(x_mid)                                                         
    all_dx.append(dx)                                                           
    all_t.append(t[:-1])                                                        
                                                                                
X = np.vstack(all_x)                                                            
DX = np.vstack(all_dx)                                                          
                                                                                
