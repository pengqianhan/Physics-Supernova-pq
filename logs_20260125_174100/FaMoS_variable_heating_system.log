# Mode identification                                                           
# Mode 1: increasing x1 (from ~10 to 25)                                        
# Mode 2: decreasing x1                                                         
# Mode 1 -> Mode 2: x1 peak                                                     
# Mode 2 -> Mode 1: x2 min                                                      
                                                                                
mode_labels = np.zeros(len(x1), dtype=int)                                      
current_mode = 1 if x1[1] > x1[0] else 2                                        
                                                                                
for i in range(len(x1)):                                                        
    mode_labels[i] = current_mode                                               
    if i < len(x1) - 1:                                                         
        if current_mode == 1:                                                   
            if x1[i+1] < x1[i]: # Peak of x1                                    
                current_mode = 2                                                
        else: # current_mode == 2                                               
            if x2[i+1] > x2[i]: # Min of x2                                     
                current_mode = 1                                                
                                                                                
# Fitting models                                                                
# Define function to get pairs (state[t], state[t+1]) within same mode          
def get_transitions(mode_val):                                                  
    idx = np.where((mode_labels[:-1] == mode_val) & (mode_labels[1:] ==         
mode_val))[0]                                                                   
    return state[idx], state[idx+1]                                             
                                                                                
# Mode 1: x1[1] = a1*x1[0] + b1; x2[1] = a2*x2[0] + b2                          
s0_m1, s1_m1 = get_transitions(1)                                               
a1, b1, _, _, _ = stats.linregress(s0_m1[:, 0], s1_m1[:, 0])                    
a2, b2, _, _, _ = stats.linregress(s0_m1[:, 1], s1_m1[:, 1])                    
                                                                                
# Mode 2: x1[1] = c1*x1[0] + d1; x2[1] = e1*x1[0] + f1*x2[0] + g1               
s0_m2, s1_m2 = get_transitions(2)                                               
c1, d1, _, _, _ = stats.linregress(s0_m2[:, 0], s1_m2[:, 0])                    
                                                                                
# Multivariate for Mode 2 x2                                                    
# x2[1] = e1*x1[0] + f1*x2[0] + g1                                              
X_m2 = np.column_stack([s0_m2[:, 0], s0_m2[:, 1], np.ones(len(s0_m2))])         
Y_m2 = s1_m2[:, 1]                                                              
coeffs_m2, _, _, _ = np.linalg.lstsq(X_m2, Y_m2, rcond=None)                    
e1, f1, g1 = coeffs_m2                                                          
                                                                                
# Check for resets                                                              
# Resets happen at mode transitions. Let's compare the state at transition t and
t+1                                                                             
trans_indices = np.where(mode_labels[:-1] != mode_labels[1:])[0]                
resets = []                                                                     
for idx in trans_indices:                                                       
    # A reset would typically mean a large jump that doesn't follow the dynamics
    # However, just checking if x(t) and x(t+1) are very different              
    jump = np.linalg.norm(state[idx+1] - state[idx])                            
    resets.append(jump)                                                         
                                                                                
print(f"Mode 1 fits: a1={a1:.4f}, b1={b1:.4f}, a2={a2:.4f}, b2={b2:.4f}")       
print(f"Mode 2 fits: c1={c1:.4f}, d1={d1:.4f}, e1={e1:.4f}, f1={f1:.4f},        
g1={g1:.4f}")                                                                   
print(f"Jump magnitudes at transitions: {resets}")                              
print(f"Max jump: {max(resets) if resets else 0}")                              
                                                                                
