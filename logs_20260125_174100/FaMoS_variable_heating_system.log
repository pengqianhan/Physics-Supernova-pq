│   "type": "object",                                                          │
│   "required": [                                                              │
│     "automaton",                                                             │
│     "config"                                                                 │
│   \],                                                                        │
│   "additionalProperties": true,                                              │
│   "properties": {                                                            │
│     "automaton": {                                                           │
│       "type": "object",                                                      │
│       "description": "The hybrid automaton definition with variables, modes, │
│ and transitions",                                                            │
│       "required": [                                                          │
│         "var",                                                               │
│         "mode",                                                              │
│         "edge"                                                               │
