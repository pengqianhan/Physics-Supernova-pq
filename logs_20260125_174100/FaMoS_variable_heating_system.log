│                     "x2": ["-0.1 * x1[0\]"]                                  │
│                 }                                                            │
│             }                                                                │
│         ]                                                                    │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.001,                                                         │
│         "total_time": 10.0,                                                  │
│         "order": 1,                                                          │
│         "need_reset": true,                                                  │
