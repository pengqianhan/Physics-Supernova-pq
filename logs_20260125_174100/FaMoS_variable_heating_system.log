def get_combined_dynamics(data_list):                                           
    all_X = []                                                                  
    all_dx1 = []                                                                
    all_dx2 = []                                                                
    dt = 0.01                                                                   
    for x1, x2, start, end in data_list:                                        
        if end - start < 2: continue                                            
        x1_s = x1[start:end+1]                                                  
        x2_s = x2[start:end+1]                                                  
        dx1 = np.diff(x1_s) / dt                                                
        dx2 = np.diff(x2_s) / dt                                                
        X = np.column_stack([x1_s[:-1], x2_s[:-1], np.ones(len(x1_s)-1)])       
        all_X.append(X)                                                         
        all_dx1.append(dx1)                                                     
        all_dx2.append(dx2)                                                     
                                                                                
    X_total = np.vstack(all_X)                                                  
    dx1_total = np.concatenate(all_dx1)                                         
    dx2_total = np.concatenate(all_dx2)                                         
                                                                                
    sol1, _, _, _ = lstsq(X_total, dx1_total)                                   
    sol2, _, _, _ = lstsq(X_total, dx2_total)                                   
    return sol1, sol2                                                           
                                                                                
