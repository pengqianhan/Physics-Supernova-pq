  def analyze_all_samples(file_paths):                                          
      all_s0_m1, all_s1_m1 = [], []                                             
      all_s0_m2, all_s1_m2 = [], []                                             
      transition_jumps = []                                                     
                                                                                
      for path in file_paths:                                                   
          data = np.load(path)                                                  
          state = data['state'].T                                               
          x1 = state[:, 0]                                                      
          x2 = state[:, 1]                                                      
                                                                                
          mode_labels = np.zeros(len(x1), dtype=int)                            
          # Assuming we start in Mode 1 based on task description or data       
  inspection                                                                    
          current_mode = 1                                                      
                                                                                
          for i in range(len(x1)):                                              
              mode_labels[i] = current_mode                                     
              if i < len(x1) - 1:                                               
                  if current_mode == 1:                                         
                      if x1[i+1] < x1[i]: # Peak                                
                          current_mode = 2                                      
                          transition_jumps.append(np.linalg.norm(state[i+1] -   
  state[i]))                                                                    
                  else: # Mode 2                                                
                      if x2[i+1] > x2[i]: # Minimum                             
                          current_mode = 1                                      
                          transition_jumps.append(np.linalg.norm(state[i+1] -   
  state[i]))                                                                    
                                                                                
          # Collect intra-mode transitions                                      
          idx_m1 = np.where((mode_labels[:-1] == 1) & (mode_labels[1:] ==       
  1))[0]                                                                        
          if len(idx_m1) > 0:                                                   
              all_s0_m1.append(state[idx_m1])                                   
              all_s1_m1.append(state[idx_m1+1])                                 
                                                                                
          idx_m2 = np.where((mode_labels[:-1] == 2) & (mode_labels[1:] ==       
  2))[0]                                                                        
          if len(idx_m2) > 0:                                                   
              all_s0_m2.append(state[idx_m2])                                   
              all_s1_m2.append(state[idx_m2+1])                                 
                                                                                
      # Concatenate                                                             
      s0_m1 = np.concatenate(all_s0_m1)                                         
      s1_m1 = np.concatenate(all_s1_m1)                                         
      s0_m2 = np.concatenate(all_s0_m2)                                         
      s1_m2 = np.concatenate(all_s1_m2)                                         
                                                                                
