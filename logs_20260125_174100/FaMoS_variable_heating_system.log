import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
data = np.load('data_all/FaMoS/variable_heating_system/sample_0.npz')           
t = data['t']                                                                   
x = data['x']                                                                   
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
dt = 0.001                                                                      
                                                                                
# 1. Calculate derivatives                                                      
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
# Align x for regression (using x[i] to predict dx[i])                          
x1_reg = x1[:-1]                                                                
x2_reg = x2[:-1]                                                                
                                                                                
# 2. Segment into modes                                                         
# Mode 1: x1 inc, x2 inc                                                        
# Mode 2: x1 dec, x2 inc                                                        
# Mode 3: x1 dec, x2 dec                                                        
# (Note: we use smoothed versions or simple signs to determine modes)           
modes = np.zeros(len(dx1))                                                      
for i in range(len(dx1)):                                                       
    if dx1[i] >= 0 and dx2[i] >= 0:                                             
        modes[i] = 1                                                            
    elif dx1[i] < 0 and dx2[i] >= 0:                                            
        modes[i] = 2                                                            
    elif dx1[i] < 0 and dx2[i] < 0:                                             
        modes[i] = 3                                                            
    else:                                                                       
        # Check for transition back to 1: x1 starts increasing                  
        modes[i] = 1                                                            
                                                                                
# Find transition indices                                                       
transitions = []                                                                
for i in range(1, len(modes)):                                                  
    if modes[i] != modes[i-1]:                                                  
        transitions.append((i, modes[i-1], modes[i], x[i]))                     
                                                                                
# 3. Linear Regression for each mode                                            
results = {}                                                                    
for m in [1, 2, 3]:                                                             
    mask = (modes == m)                                                         
    if np.any(mask):                                                            
        X = np.stack([x1_reg[mask], x2_reg[mask]], axis=1)                      
        y1 = dx1[mask]                                                          
        y2 = dx2[mask]                                                          
                                                                                
        reg1 = LinearRegression().fit(X, y1)                                    
        reg2 = LinearRegression().fit(X, y2)                                    
                                                                                
        results[m] = {                                                          
            'a': reg1.coef_[0], 'b': reg1.coef_[1], 'c': reg1.intercept_,       
            'd': reg2.coef_[0], 'e': reg2.coef_[1], 'f': reg2.intercept_        
        }                                                                       
                                                                                
print("Transitions:", transitions)                                              
print("Regression Results:", results)                                           
                                                                                
# 4. & 5. Guard conditions and Continuity                                       
# Extract specific transitions                                                  
t12 = [t for t in transitions if t[1] == 1 and t[2] == 2]                       
t23 = [t for t in transitions if t[1] == 2 and t[2] == 3]                       
t31 = [t for t in transitions if t[1] == 3 and t[2] == 1]                       
                                                                                
print("1->2 Transition State:", t12[0][3] if t12 else "N/A")                    
print("2->3 Transition State:", t23[0][3] if t23 else "N/A")                    
print("3->1 Transition State:", t31[0][3] if t31 else "N/A")                    
                                                                                
# Continuity check: Since we are using continuous time-series data sampled at   
dt,                                                                             
# the state is inherently continuous unless there's a jump in the data.         
# We'll check the jump magnitude at transitions.                                
jumps = []                                                                      
for idx, m_from, m_to, state in transitions:                                    
    jump = np.linalg.norm(x[idx] - x[idx-1])                                    
    jumps.append(jump)                                                          
print("Max jump at transitions:", max(jumps) if jumps else 0)                   
                                                                                
