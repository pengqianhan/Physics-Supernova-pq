heating_x1_y = []                                                               
heating_x2_x = []                                                               
heating_x2_y = []                                                               
cooling_x1_x = []                                                               
cooling_x1_y = []                                                               
cooling_x2_x = []                                                               
cooling_x2_y = []                                                               
                                                                                
for x1_seg, x2_seg, mode in all_segments_data:                                  
