def get_segments(file_path):                                                    
    data = np.load(file_path)                                                   
    X = data['state']                                                           
    # Use a small dt for now, we'll scale later                                 
    dt = 0.1                                                                    
    dX = np.gradient(X, axis=1) / dt                                            
    T = X.shape[1]                                                              
                                                                                
    # Detect jumps in dX to find segments                                       
    jumps = []                                                                  
    for i in range(2):                                                          
        d2X = np.diff(dX[i, :])                                                 
        # Find where d2X is significantly larger than its neighbors             
        threshold = 5 * np.std(d2X)                                             
        jumps.extend(np.where(np.abs(d2X) > threshold)[0])                      
                                                                                
    jumps = sorted(list(set(jumps)))                                            
    # Group jumps that are very close to each other                             
    if not jumps:                                                               
        return [(0, T)]                                                         
                                                                                
    refined_jumps = [jumps[0]]                                                  
    for j in jumps[1:]:                                                         
        if j - refined_jumps[-1] > 50:                                          
            refined_jumps.append(j)                                             
                                                                                
    indices = [0] + refined_jumps + [T]                                         
    return [(indices[i], indices[i+1]) for i in range(len(indices)-1)]          
                                                                                
