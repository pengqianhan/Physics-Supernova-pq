                guard = state[:, i+1]                                           
                # Reset is state[i+2] - state[i+1] (or just check if state is   
continuous)                                                                     
                # Since we are using diff, the "next" state in the derivative   
sense is i+1                                                                    
                # But let's check for jumps in the state itself.                
                reset = state[:, i+2] - state[:, i+1] if i+2 < state.shape[1]   
else np.zeros(2)                                                                
                                                                                
                transitions.append({                                            
                    'from': modes[i],                                           
                    'to': modes[i+1],                                           
                    'guard': guard,                                             
                    'reset': reset,                                             
                    'index': i+1                                                
                })                                                              
                                                                                
        all_x1.extend(x1[:-1])                                                  
        all_x2.extend(x2[:-1])                                                  
        all_dx1.extend(dx1)                                                     
        all_dx2.extend(dx2)                                                     
        all_modes.extend(modes)                                                 
                                                                                
    all_x1 = np.array(all_x1)                                                   
    all_x2 = np.array(all_x2)                                                   
    all_dx1 = np.array(all_dx1)                                                 
    all_dx2 = np.array(all_dx2)                                                 
    all_modes = np.array(all_modes)                                             
                                                                                
    # Separate data by mode                                                     
    m1_indices = (all_modes == 1)                                               
    m2_indices = (all_modes == 2)                                               
                                                                                
