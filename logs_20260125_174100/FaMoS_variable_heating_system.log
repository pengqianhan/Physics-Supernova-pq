  import numpy as np                                                            
                                                                                
  # Data collection                                                             
  m1_X, m1_dX1, m1_dX2 = [], [], []                                             
  m2_X, m2_dX1, m2_dX2 = [], [], []                                             
  switches_1to2_x1 = []                                                         
  switches_2to1_x2 = []                                                         
  all_resets = []                                                               
                                                                                
  dt = 1.0  # Assumed time step since 't' is not provided                       
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      state = data['state']                                                     
      x1 = state[0, :]                                                          
      x2 = state[1, :]                                                          
                                                                                
      # Calculate differences                                                   
      dx1_vals = np.diff(x1) / dt                                               
      dx2_vals = np.diff(x2) / dt                                               
                                                                                
      # Mode identification (dx1 > 0 -> Mode 1, else Mode 2)                    
      modes = np.where(dx1_vals > 0, 1, 2)                                      
                                                                                
      for i in range(len(modes)):                                               
          row = [x1[i], x2[i], 1.0] # [x1, x2, constant term]                   
          if modes[i] == 1:                                                     
              m1_X.append(row)                                                  
              m1_dX1.append(dx1_vals[i])                                        
              m1_dX2.append(dx2_vals[i])                                        
          else:                                                                 
              m2_X.append(row)                                                  
              m2_dX1.append(dx1_vals[i])                                        
              m2_dX2.append(dx2_vals[i])                                        
                                                                                
      # Switch detection                                                        
      for i in range(len(modes) - 1):                                           
          if modes[i] == 1 and modes[i+1] == 2:                                 
              # Mode 1 -> Mode 2 switch                                         
              switches_1to2_x1.append(x1[i+1])                                  
              # Check for reset (x_after - x_before)                            
              # But the 'before' state for the next mode is x[i+1]              
              # If there was a jump, x[i+1] would be different from the limit   
              # In sampled data, we usually don't see the jump unless it's      
  explicitly recorded.                                                          
              # We'll just check the difference between adjacent samples.       
              all_resets.append([x1[i+1] - x1[i], x2[i+1] - x2[i]])             
          elif modes[i] == 2 and modes[i+1] == 1:                               
              # Mode 2 -> Mode 1 switch                                         
              switches_2to1_x2.append(x2[i+1])                                  
              all_resets.append([x1[i+1] - x1[i], x2[i+1] - x2[i]])             
                                                                                
  def solve_regression(X, Y):                                                   
      X_arr = np.array(X)                                                       
      Y_arr = np.array(Y)                                                       
      coeffs, residuals, rank, s = np.linalg.lstsq(X_arr, Y_arr, rcond=None)    
      return coeffs                                                             
                                                                                
