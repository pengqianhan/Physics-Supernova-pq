import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
# Load all data files                                                           
all_data = []                                                                   
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    # Check keys                                                                
    if 'x' in data:                                                             
        all_data.append(data['x'])                                              
    elif 'arr_0' in data:                                                       
        all_data.append(data['arr_0'])                                          
                                                                                
# Concatenate all trajectories                                                  
# Assuming x is (N, 2) where N is number of timesteps                           
trajectories = all_data                                                         
                                                                                
# Lists to store pairs for regression                                           
mode1_x1_pairs = [] # (x1[t], x1[t+1])                                          
mode1_x2_pairs = [] # (x2[t], x2[t+1])                                          
                                                                                
mode2_x1_pairs = [] # (x1[t], x1[t+1])                                          
mode2_x2_quad = [] # (x1[t], x2[t], x2[t+1])                                    
                                                                                
for traj in trajectories:                                                       
    for t in range(len(traj) - 1):                                              
        x1_t, x2_t = traj[t]                                                    
        x1_next, x2_next = traj[t+1]                                            
                                                                                
        # Check if x1 is in range [10, 25]                                      
        if 10 <= x1_t <= 25:                                                    
            if x1_next > x1_t: # Mode 1: increasing                             
                mode1_x1_pairs.append([x1_t, x1_next])                          
                mode1_x2_pairs.append([x2_t, x2_next])                          
            elif x1_next < x1_t: # Mode 2: decreasing                           
                mode2_x1_pairs.append([x1_t, x1_next])                          
                mode2_x2_quad.append([x1_t, x2_t, x2_next])                     
                                                                                
# Regression for Mode 1                                                         
# x1[1] = a1 * x1[0] + b1                                                       
m1_x1 = np.array(mode1_x1_pairs)                                                
slope_a1, intercept_b1, _, _, _ = stats.linregress(m1_x1[:, 0], m1_x1[:, 1])    
                                                                                
# x2[1] = a2 * x2[0] + b2                                                       
m1_x2 = np.array(mode1_x2_pairs)                                                
slope_a2, intercept_b2, _, _, _ = stats.linregress(m1_x2[:, 0], m1_x2[:, 1])    
                                                                                
# Regression for Mode 2                                                         
# x1[1] = c1 * x1[0] + d1                                                       
m2_x1 = np.array(mode2_x1_pairs)                                                
slope_c1, intercept_d1, _, _, _ = stats.linregress(m2_x1[:, 0], m2_x1[:, 1])    
                                                                                
# x2[1] = e1 * x1[0] + f1 * x2[0] + g1                                          
m2_x2 = np.array(mode2_x2_quad)                                                 
X = np.column_stack((m2_x2[:, 0], m2_x2[:, 1], np.ones(len(m2_x2))))            
y = m2_x2[:, 2]                                                                 
coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)                  
e1, f1, g1 = coeffs                                                             
                                                                                
print(f"Mode 1: a1={slope_a1}, b1={intercept_b1}, a2={slope_a2},                
b2={intercept_b2}")                                                             
print(f"Mode 2: c1={slope_c1}, d1={intercept_d1}, e1={e1}, f1={f1}, g1={g1}")   
                                                                                
