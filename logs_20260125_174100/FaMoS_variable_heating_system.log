    last_s = switch_indices[0]                                                  
    for s in switch_indices[1:]:                                                
        if s > last_s + 50:                                                     
            refined_switches.append(s)                                          
            last_s = s                                                          
refined_switches.append(len(x1)-1)                                              
                                                                                
def fit_linear_model(s_idx, e_idx, x1_data, x2_data):                           
    # Fit x1[k+1] = a1*x1[k] + b1*x2[k] + c1                                    
    # Fit x2[k+1] = a2*x1[k] + b2*x2[k] + c2                                    
    A = np.stack([x1_data[s_idx:e_idx], x2_data[s_idx:e_idx],                   
np.ones(e_idx-s_idx)], axis=1)                                                  
    y1 = x1_data[s_idx+1:e_idx+1]                                               
    y2 = x2_data[s_idx+1:e_idx+1]                                               
                                                                                
    sol1, _, _, _ = np.linalg.lstsq(A, y1, rcond=None)                          
    sol2, _, _, _ = np.linalg.lstsq(A, y2, rcond=None)                          
                                                                                
    return sol1, sol2 # [a, b, c]                                               
                                                                                
# Print segment info                                                            
