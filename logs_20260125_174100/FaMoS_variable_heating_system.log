  import numpy as np                                                            
                                                                                
  # Load the data                                                               
  data = np.load(DATA_FILE_PATH)                                                
  state = data['state']                                                         
  x1 = state[0]                                                                 
  x2 = state[1]                                                                 
                                                                                
  # Calculate differences                                                       
  dx1 = np.diff(x1)                                                             
  dx2 = np.diff(x2)                                                             
                                                                                
  # Identify modes based on derivative signs                                    
  # Phase 1: Heating (x1 up, x2 up) -> dx1 > 0, dx2 > 0                         
  # Phase 2: Transition (x1 down, x2 up) -> dx1 < 0, dx2 > 0                    
  # Phase 3: Cooling (x1 down, x2 down) -> dx1 < 0, dx2 < 0                     
                                                                                
  modes = np.zeros(len(dx1))                                                    
  for i in range(len(dx1)):                                                     
      if dx1[i] > 1e-6 and dx2[i] > 1e-6:                                       
          modes[i] = 1                                                          
      elif dx1[i] < -1e-6 and dx2[i] > 1e-6:                                    
          modes[i] = 2                                                          
      elif dx1[i] < -1e-6 and dx2[i] < -1e-6:                                   
          modes[i] = 3                                                          
                                                                                
  # Segment the data by mode                                                    
  segments = []                                                                 
  if len(modes) > 0:                                                            
      curr_mode = int(modes[0])                                                 
      curr_start = 0                                                            
      for i in range(1, len(modes)):                                            
          if int(modes[i]) != curr_mode:                                        
              if curr_mode != 0:                                                
                  segments.append((curr_mode, curr_start, i))                   
              curr_mode = int(modes[i])                                         
              curr_start = i                                                    
      if curr_mode != 0:                                                        
          segments.append((curr_mode, curr_start, len(modes)))                  
                                                                                
  # Fit linear models for each mode using least squares                         
  def fit_linear_model(mode_indices):                                           
      # Collect all (x1[k], x2[k]) and (x1[k+1], x2[k+1]) for a specific mode   
  across all segments                                                           
      X_list = []                                                               
      Y1_list = []                                                              
      Y2_list = []                                                              
                                                                                
      for start, end in mode_indices:                                           
          # Features: [x1[k], x2[k], 1]                                         
          features = np.stack([x1[start:end], x2[start:end],                    
  np.ones(end-start)], axis=1)                                                  
          X_list.append(features)                                               
          Y1_list.append(x1[start+1:end+1])                                     
          Y2_list.append(x2[start+1:end+1])                                     
                                                                                
      X = np.concatenate(X_list, axis=0)                                        
      Y1 = np.concatenate(Y1_list, axis=0)                                      
      Y2 = np.concatenate(Y2_list, axis=0)                                      
                                                                                
      # Solve X * beta = Y                                                      
      beta1, _, _, _ = np.linalg.lstsq(X, Y1, rcond=None)                       
      beta2, _, _, _ = np.linalg.lstsq(X, Y2, rcond=None)                       
                                                                                
      return {                                                                  
          'a1': beta1[0], 'a2': beta1[1], 'b1': beta1[2],                       
          'a3': beta2[0], 'a4': beta2[1], 'b2': beta2[2]                        
      }                                                                         
                                                                                
  # Group segments by mode type                                                 
  mode_groups = {1: [], 2: [], 3: []}                                           
  for m, s, e in segments:                                                      
      mode_groups[m].append((s, e))                                             
                                                                                
  results = {}                                                                  
  for m in [1, 2, 3]:                                                           
      if mode_groups[m]:                                                        
          results[m] = fit_linear_model(mode_groups[m])                         
          # Find the transition condition (guard) from the first occurrence     
          first_seg_end = mode_groups[m][0][1]                                  
          results[m]['guard_x1'] = x1[first_seg_end]                            
          results[m]['guard_x2'] = x2[first_seg_end]                            
                                                                                
  # Output formatting                                                           
  report = "Fitted coefficients for each mode:\n"                               
  for m in [1, 2, 3]:                                                           
      if m in results:                                                          
          res = results[m]                                                      
          report += f"Mode {m} (Phase: {'Heating' if m==1 else 'Transition' if  
  m==2 else 'Cooling'}):\n"                                                     
          report += f"  x1[k+1] = {res['a1']:.6f}*x1[k] +                       
  {res['a2']:.6f}*x2[k] + {res['b1']:.6f}\n"                                    
          report += f"  x2[k+1] = {res['a3']:.6f}*x1[k] +                       
  {res['a4']:.6f}*x2[k] + {res['b2']:.6f}\n"                                    
          report += f"  Guard Condition to exit: x1 ~ {res['guard_x1']:.4f},    
  x2 ~ {res['guard_x2']:.4f}\n"                                                 
                                                                                
  print(report)                                                                 
                                                                                
