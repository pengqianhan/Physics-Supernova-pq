import numpy as np                                                              
                                                                                
def get_exact_coeffs(x_series, dt=0.1):                                         
    x_k = x_series[:-1]                                                         
    x_kp1 = x_series[1:]                                                        
    A = np.column_stack([x_k, np.ones(len(x_k))])                               
    c, _, _, _ = np.linalg.lstsq(A, x_kp1, rcond=None)                          
    P, Q = c[0], c[1]                                                           
    a = np.log(P) / dt                                                          
    b = Q * a / (P - 1)                                                         
    return a, b                                                                 
                                                                                
for i, path in enumerate(DATA_FILE_PATHS):                                      
    data = np.load(path)                                                        
    X = data['state']                                                           
    a1, b1 = get_exact_coeffs(X[0, :])                                          
    a2, b2 = get_exact_coeffs(X[1, :])                                          
    print(f"Mode {i+1}: a11={a1:.8f}, a22={a2:.8f}, b1={b1:.8f}, b2={b2:.8f}")  
                                                                                
