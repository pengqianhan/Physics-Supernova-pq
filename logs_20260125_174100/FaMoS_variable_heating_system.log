import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def process_data(file_paths):                                                   
    all_x = []                                                                  
    all_s = []                                                                  
    all_dx = []                                                                 
                                                                                
    dt = 0.1  # Assuming a standard time step, will verify if possible          
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        X = data['X']  # Trajectories (T, N)                                    
        S = data['S']  # Modes (T,)                                             
                                                                                
        # Calculate numerical derivative dX/dt                                  
        dX = np.gradient(X, axis=0) / dt                                        
                                                                                
        all_x.append(X)                                                         
        all_s.append(S)                                                         
        all_dx.append(dX)                                                       
                                                                                
    return np.vstack(all_x), np.concatenate(all_s), np.vstack(all_dx)           
                                                                                
X_full, S_full, DX_full = process_data(DATA_FILE_PATHS)                         
                                                                                
