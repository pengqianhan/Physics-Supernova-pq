    idx = np.where(modes == m)[0]                                               
    if len(idx) > 0:                                                            
        # For x1                                                                
        slope1, intercept1, _, _, _ = linregress(x1[idx], dx1[idx])             
        # For x2                                                                
        slope2, intercept2, _, _, _ = linregress(x2[idx], dx2[idx])             
        results[m] = {                                                          
