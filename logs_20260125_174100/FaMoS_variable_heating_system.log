import numpy as np                                                              
                                                                                
def get_precise_params(path, dt=0.01):                                          
    data = np.load(path)                                                        
    X = data['state']                                                           
    dx = np.diff(X, axis=1) / dt                                                
                                                                                
    # Jump detection                                                            
    d2x = np.diff(dx, axis=1)                                                   
    jumps = [0]                                                                 
    for v in range(2):                                                          
        threshold = np.std(d2x[v]) * 8                                          
        j = np.where(np.abs(d2x[v]) > threshold)[0] + 1                         
        jumps.extend(j)                                                         
    jumps = sorted(list(set(jumps)))                                            
                                                                                
    refined = [0]                                                               
    for j in jumps:                                                             
        if j - refined[-1] > 100:                                               
            refined.append(j)                                                   
    refined.append(X.shape[1])                                                  
                                                                                
    segments = []                                                               
    for i in range(len(refined)-1):                                             
        s, e = refined[i], refined[i+1]                                         
        if e - s < 100: continue                                                
                                                                                
        seg_x = X[:, s:e]                                                       
        seg_params = {}                                                         
        for v in range(2):                                                      
            xv = seg_x[v, :-1]                                                  
            yv = (seg_x[v, 1:] - seg_x[v, :-1]) / dt                            
            A = np.column_stack([xv, np.ones(len(xv))])                         
            c, _, _, _ = np.linalg.lstsq(A, yv, rcond=None)                     
            seg_params[f'a{v+1}{v+1}'] = c[0]                                   
            seg_params[f'b{v+1}'] = c[1]                                        
        segments.append(seg_params)                                             
    return segments                                                             
                                                                                
all_segments = []                                                               
for path in DATA_FILE_PATHS:                                                    
    all_segments.extend(get_precise_params(path))                               
                                                                                
# Group by unique (a11, a22, b1, b2)                                            
unique_modes = []                                                               
for seg in all_segments:                                                        
    found = False                                                               
    for mode in unique_modes:                                                   
        if np.allclose([seg['a11'], seg['a22'], seg['b1'], seg['b2']],          
                       [mode['a11'], mode['a22'], mode['b1'], mode['b2']],      
atol=1e-3):                                                                     
            mode['samples'].append(seg)                                         
            found = True                                                        
            break                                                               
    if not found:                                                               
        unique_modes.append({'a11': seg['a11'], 'a22': seg['a22'], 'b1':        
seg['b1'], 'b2': seg['b2'], 'samples': [seg]})                                  
                                                                                
for mode in unique_modes:                                                       
    mode['a11_avg'] = np.mean([s['a11'] for s in mode['samples']])              
    mode['a22_avg'] = np.mean([s['a22'] for s in mode['samples']])              
    mode['b1_avg'] = np.mean([s['b1'] for s in mode['samples']])                
    mode['b2_avg'] = np.mean([s['b2'] for s in mode['samples']])                
                                                                                
# Sort modes to identify Mode 1, 2, 3                                           
# Based on common conventions and b1 requirement:                               
# Mode 1 is likely the heating mode (b1 > 0)                                    
# Let's sort by b1 descending                                                   
unique_modes.sort(key=lambda x: x['b1_avg'], reverse=True)                      
                                                                                
for i, mode in enumerate(unique_modes):                                         
