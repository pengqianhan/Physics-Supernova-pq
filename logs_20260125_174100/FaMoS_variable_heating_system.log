def get_dynamics(x1, x2, dt, start, end):                                       
    x1_s = x1[start:end+1]                                                      
    x2_s = x2[start:end+1]                                                      
    dx1 = np.diff(x1_s) / dt                                                    
    dx2 = np.diff(x2_s) / dt                                                    
                                                                                
    # Feature matrix: [x1, x2, 1]                                               
    X = np.column_stack([x1_s[:-1], x2_s[:-1], np.ones(len(x1_s)-1)])           
                                                                                
    sol1, _, _, _ = lstsq(X, dx1)                                               
    sol2, _, _, _ = lstsq(X, dx2)                                               
                                                                                
    return sol1, sol2                                                           
                                                                                
