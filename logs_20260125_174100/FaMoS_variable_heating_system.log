for s, e, m in segments:                                                        
    if m in [1, 2, 3]:                                                          
        mode_data[m]['x1'].extend(x1[s:e])                                      
        mode_data[m]['x1_next'].extend(x1[s+1:e+1])                             
        mode_data[m]['x2'].extend(x2[s:e])                                      
        mode_data[m]['x2_next'].extend(x2[s+1:e+1])                             
                                                                                
results = {}                                                                    
for m in [1, 2, 3]:                                                             
