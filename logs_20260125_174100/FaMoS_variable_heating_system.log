import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def analyze_all_samples(file_paths):                                            
    all_s0_m1, all_s1_m1 = [], []                                               
    all_s0_m2, all_s1_m2 = [], []                                               
    transition_jumps = []                                                       
                                                                                
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        state = data['state'].T                                                 
        x1 = state[:, 0]                                                        
        x2 = state[:, 1]                                                        
                                                                                
        mode_labels = np.zeros(len(x1), dtype=int)                              
        # Assuming we start in Mode 1 based on task description or data         
inspection                                                                      
