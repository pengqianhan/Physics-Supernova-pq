    if dx1[i] > 0 and dx2[i] > 0:                                               
        modes[i] = 1                                                            
    elif dx1[i] < 0 and dx2[i] > 0:                                             
        modes[i] = 2                                                            
    elif dx1[i] < 0 and dx2[i] < 0:                                             
        modes[i] = 3                                                            
                                                                                
# Fit dx/dt = a*x + b for each mode                                             
# Note: dx/dt at index i corresponds to state x[i]                              
results = {}                                                                    
