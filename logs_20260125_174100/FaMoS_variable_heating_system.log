    data = np.load(file_path)                                                   
    # Assuming 'state' is (2, N) and 't' is (N,)                                
    state = data['state']                                                       
    t = data['t']                                                               
                                                                                
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dt = np.diff(t)                                                             
                                                                                
    # Calculate dx/dt                                                           
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    # Mode identification: Mode 1 (x1 increasing), Mode 2 (x1 decreasing)       
    # Using a threshold to avoid noise issues                                   
    modes = []                                                                  
    for i in range(len(dx1)):                                                   
        if dx1[i] > 0:                                                          
            modes.append(1)                                                     
        else:                                                                   
            modes.append(2)                                                     
    modes = np.array(modes)                                                     
                                                                                
    # Store for regression                                                      
    for i in range(len(modes)):                                                 
        all_x.append([x1[i], x2[i], modes[i]])                                  
        all_dx.append([dx1[i], dx2[i]])                                         
                                                                                
    # Switch detection                                                          
    for i in range(1, len(modes)):                                              
        if modes[i-1] != modes[i]:                                              
            # Switch at index i (transitioning from modes[i-1] to modes[i])     
            all_switches.append({                                               
                'from': modes[i-1],                                             
                'to': modes[i],                                                 
                'x1_before': x1[i],                                             
                'x2_before': x2[i],                                             
                'x1_after': x1[i+1] if i+1 < len(x1) else x1[i],                
                'x2_after': x2[i+1] if i+1 < len(x1) else x2[i]                 
            })                                                                  
                                                                                
all_x = np.array(all_x)                                                         
all_dx = np.array(all_dx)                                                       
                                                                                
# Refine coefficients for Mode 1                                                
m1_mask = all_x[:, 2] == 1                                                      
X1 = all_x[m1_mask, :2]                                                         
Y1 = all_dx[m1_mask]                                                            
reg1 = LinearRegression().fit(X1, Y1)                                           
                                                                                
# Refine coefficients for Mode 2                                                
m2_mask = all_x[:, 2] == 2                                                      
X2 = all_x[m2_mask, :2]                                                         
Y2 = all_dx[m2_mask]                                                            
reg2 = LinearRegression().fit(X2, Y2)                                           
                                                                                
# Analyze guards and resets                                                     
guards = {'1->2': [], '2->1': []}                                               
resets = []                                                                     
for s in all_switches:                                                          
    key = f"{int(s['from'])}->{int(s['to'])}"                                   
    guards[key].append((s['x1_before'], s['x2_before']))                        
    resets.append((s['x1_after'] - s['x1_before'], s['x2_after'] -              
s['x2_before']))                                                                
                                                                                
avg_guard_12_x1 = np.mean([g[0] for g in guards['1->2']])                       
avg_guard_21_x2 = np.mean([g[1] for g in guards['2->1']])                       
avg_reset = np.mean(resets, axis=0)                                             
                                                                                
print(f"Mode 1: dx1/dt = {reg1.coef_[0,0]}*x1 + {reg1.coef_[0,1]}*x2 +          
{reg1.intercept_[0]}")                                                          
print(f"Mode 1: dx2/dt = {reg1.coef_[1,0]}*x1 + {reg1.coef_[1,1]}*x2 +          
{reg1.intercept_[1]}")                                                          
print(f"Mode 2: dx1/dt = {reg2.coef_[0,0]}*x1 + {reg2.coef_[0,1]}*x2 +          
{reg2.intercept_[0]}")                                                          
print(f"Mode 2: dx2/dt = {reg2.coef_[1,0]}*x1 + {reg2.coef_[1,1]}*x2 +          
{reg2.intercept_[1]}")                                                          
print(f"Guard 1->2 (x1): {avg_guard_12_x1}")                                    
print(f"Guard 2->1 (x2): {avg_guard_21_x2}")                                    
print(f"Average Reset: {avg_reset}")                                            
                                                                                
