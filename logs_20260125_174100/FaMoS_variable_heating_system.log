import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def analyze_system():                                                           
    all_x1 = []                                                                 
    all_x1_next = []                                                            
    all_x2 = []                                                                 
    all_x2_next = []                                                            
    all_modes = []                                                              
                                                                                
    # Aggregating data across all samples                                       
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        state = data['state']                                                   
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
                                                                                
        dx1 = x1[1:] - x1[:-1]                                                  
        dx2 = x2[1:] - x2[:-1]                                                  
                                                                                
        # Determine mode for each point i (transitioning from i to i+1)         
        modes = np.zeros(len(dx1), dtype=int)                                   
        modes[(dx1 > 0) & (dx2 > 0)] = 1                                        
        modes[(dx1 < 0) & (dx2 > 0)] = 2                                        
        modes[(dx1 < 0) & (dx2 < 0)] = 3                                        
                                                                                
        all_x1.extend(x1[:-1])                                                  
        all_x1_next.extend(x1[1:])                                              
        all_x2.extend(x2[:-1])                                                  
        all_x2_next.extend(x2[1:])                                              
        all_modes.extend(modes)                                                 
                                                                                
    all_x1 = np.array(all_x1)                                                   
    all_x1_next = np.array(all_x1_next)                                         
    all_x2 = np.array(all_x2)                                                   
    all_x2_next = np.array(all_x2_next)                                         
    all_modes = np.array(all_modes)                                             
                                                                                
    # Perform Linear Regression for each Mode                                   
    coeffs = {}                                                                 
    for m in [1, 2, 3]:                                                         
        mask = (all_modes == m)                                                 
        if np.any(mask):                                                        
            a1, b1, r1, _, _ = stats.linregress(all_x1[mask], all_x1_next[mask])
            a2, b2, r2, _, _ = stats.linregress(all_x2[mask], all_x2_next[mask])
            coeffs[m] = {                                                       
                'a1': a1, 'b1': b1, 'r_sq1': r1**2,                             
                'a2': a2, 'b2': b2, 'r_sq2': r2**2                              
            }                                                                   
                                                                                
    # Detect Guard Thresholds                                                   
    t12_x1 = []                                                                 
    t23_x2 = []                                                                 
    t31_x1 = []                                                                 
    t31_x2 = []                                                                 
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        state = data['state']                                                   
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
                                                                                
        dx1 = x1[1:] - x1[:-1]                                                  
        dx2 = x2[1:] - x2[:-1]                                                  
                                                                                
        modes = np.zeros(len(dx1), dtype=int)                                   
        modes[(dx1 > 0) & (dx2 > 0)] = 1                                        
        modes[(dx1 < 0) & (dx2 > 0)] = 2                                        
        modes[(dx1 < 0) & (dx2 < 0)] = 3                                        
                                                                                
        for i in range(len(modes) - 1):                                         
            if modes[i] == 1 and modes[i+1] == 2:                               
                t12_x1.append(x1[i+1]) # Value when x1 starts decreasing        
            elif modes[i] == 2 and modes[i+1] == 3:                             
                t23_x2.append(x2[i+1]) # Value when x2 starts decreasing        
            elif modes[i] == 3 and modes[i+1] == 1:                             
                t31_x1.append(x1[i+1])                                          
                t31_x2.append(x2[i+1])                                          
                                                                                
    guards = {                                                                  
        '1->2': {'x1_threshold': np.mean(t12_x1) if t12_x1 else None},          
        '2->3': {'x2_threshold': np.mean(t23_x2) if t23_x2 else None},          
        '3->1': {'x1_threshold': np.mean(t31_x1) if t31_x1 else None,           
                 'x2_threshold': np.mean(t31_x2) if t31_x2 else None}           
    }                                                                           
                                                                                
    return coeffs, guards                                                       
                                                                                
