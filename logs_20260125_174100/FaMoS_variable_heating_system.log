def analyze_trajectories(x1_list, x2_list):                                     
    modes_list = []                                                             
    switches_info = []                                                          
                                                                                
    for traj_idx, (x1, x2) in enumerate(zip(x1_list, x2_list)):                 
        modes = np.zeros(len(x1), dtype=int)                                    
        current_mode = 1                                                        
        for i in range(len(x1)):                                                
            if current_mode == 1:                                               
                if x1[i] >= 24.5:                                               
                    current_mode = 2                                            
                    switches_info.append({'traj': traj_idx, 'idx': i, 'from': 1,
'to': 2})                                                                       
            elif current_mode == 2:                                             
                if x2[i] <= 10.5:                                               
                    current_mode = 1                                            
                    switches_info.append({'traj': traj_idx, 'idx': i, 'from': 2,
'to': 1})                                                                       
            modes[i] = current_mode                                             
        modes_list.append(modes)                                                
                                                                                
    return modes_list, switches_info                                            
                                                                                
modes_list, switches_info = analyze_trajectories(all_x1, all_x2)                
                                                                                
def estimate_all_modes(x1_list, x2_list, modes_list):                           
    results = {}                                                                
    for mode_idx in [1, 2]:                                                     
        X_data = []                                                             
        Y1_data = []                                                            
        Y2_data = []                                                            
                                                                                
        for x1, x2, modes in zip(x1_list, x2_list, modes_list):                 
            for i in range(len(x1) - 1):                                        
                if modes[i] == mode_idx and modes[i+1] == mode_idx:             
                    X_data.append([x1[i], x2[i], 1.0])                          
                    Y1_data.append(x1[i+1])                                     
                    Y2_data.append(x2[i+1])                                     
                                                                                
        if X_data:                                                              
            A = np.array(X_data)                                                
            c1, _, _, _ = np.linalg.lstsq(A, np.array(Y1_data), rcond=None)     
            c2, _, _, _ = np.linalg.lstsq(A, np.array(Y2_data), rcond=None)     
            results[mode_idx] = (c1, c2)                                        
    return results                                                              
                                                                                
