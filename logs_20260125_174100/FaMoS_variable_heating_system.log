                        current_mode = 1                                        
                        transition_jumps.append(np.linalg.norm(state[i+1] -     
state[i]))                                                                      
                                                                                
        # Collect intra-mode transitions                                        
        idx_m1 = np.where((mode_labels[:-1] == 1) & (mode_labels[1:] == 1))[0]  
        if len(idx_m1) > 0:                                                     
            all_s0_m1.append(state[idx_m1])                                     
            all_s1_m1.append(state[idx_m1+1])                                   
                                                                                
        idx_m2 = np.where((mode_labels[:-1] == 2) & (mode_labels[1:] == 2))[0]  
        if len(idx_m2) > 0:                                                     
            all_s0_m2.append(state[idx_m2])                                     
            all_s1_m2.append(state[idx_m2+1])                                   
                                                                                
    # Concatenate                                                               
    s0_m1 = np.concatenate(all_s0_m1)                                           
    s1_m1 = np.concatenate(all_s1_m1)                                           
    s0_m2 = np.concatenate(all_s0_m2)                                           
    s1_m2 = np.concatenate(all_s1_m2)                                           
                                                                                
    # Fit Mode 1                                                                
    a1, b1, r11, _, _ = stats.linregress(s0_m1[:, 0], s1_m1[:, 0])              
    a2, b2, r12, _, _ = stats.linregress(s0_m1[:, 1], s1_m1[:, 1])              
                                                                                
    # Fit Mode 2                                                                
    c1, d1, r21, _, _ = stats.linregress(s0_m2[:, 0], s1_m2[:, 0])              
    # Multivariate for x2 in Mode 2                                             
    X_m2 = np.column_stack([s0_m2[:, 0], s0_m2[:, 1], np.ones(len(s0_m2))])     
    Y_m2 = s1_m2[:, 1]                                                          
    coeffs_m2, _, _, _ = np.linalg.lstsq(X_m2, Y_m2, rcond=None)                
    e1, f1, g1 = coeffs_m2                                                      
                                                                                
