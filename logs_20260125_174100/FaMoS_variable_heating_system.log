    a11 = reg1.coef_[0]                                                         
    b1 = reg1.intercept_ if mode == 1 else 0.0                                  
                                                                                
    # x2 dynamics                                                               
    reg2 = LinearRegression(fit_intercept=False)                                
    reg2.fit(X_m[:, 1:2], DX_m[:, 1])                                           
    a22 = reg2.coef_[0]                                                         
                                                                                
    results[mode] = {'a11': a11, 'a22': a22, 'b1': b1}                          
                                                                                
for mode, vals in results.items():                                              
