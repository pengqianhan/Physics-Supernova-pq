# Mode 1: dx1/dt > 0                                                            
# Mode 2: dx1/dt < 0                                                            
mode1_mask = DX[:, 0] > 0                                                       
mode2_mask = DX[:, 0] < 0                                                       
                                                                                
X1, DX1 = X[mode1_mask], DX[mode1_mask]                                         
X2, DX2 = X[mode2_mask], DX[mode2_mask]                                         
                                                                                
def fit_ode(X_in, DX_in):                                                       
    # DX = [x1, x2, 1] * [a11, a21; a12, a22; b1, b2]                           
    A_mat = np.column_stack([X_in, np.ones(X_in.shape[0])])                     
    # Fit dx1/dt                                                                
    coeffs1, _, _, _ = lstsq(A_mat, DX_in[:, 0])                                
    # Fit dx2/dt                                                                
    coeffs2, _, _, _ = lstsq(A_mat, DX_in[:, 1])                                
    return coeffs1, coeffs2                                                     
                                                                                
