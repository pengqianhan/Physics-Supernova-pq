import numpy as np                                                              
import matplotlib.pyplot as plt                                                 
                                                                                
# Load the primary data file                                                    
data = np.load(DATA_FILE_PATH)                                                  
# Assuming keys are 't', 'x1', 'x2' or similar. Let's check keys first.         
print(f"Data keys: {list(data.keys())}")                                        
                                                                                
t = data['t']                                                                   
x1 = data['x'][:, 0]                                                            
x2 = data['x'][:, 1]                                                            
                                                                                
# Calculate derivatives (finite differences)                                    
dx1 = np.diff(x1) / np.diff(t)                                                  
dx2 = np.diff(x2) / np.diff(t)                                                  
t_mid = (t[:-1] + t[1:]) / 2                                                    
                                                                                
# Identify modes based on derivative signs or shifts                            
# According to the task:                                                        
# Phase 1: Heating (x1 up, x2 up) -> dx1 > 0, dx2 > 0                           
# Phase 2: Transition (x1 down, x2 up) -> dx1 < 0, dx2 > 0                      
# Phase 3: Cooling (x1 down, x2 down) -> dx1 < 0, dx2 < 0                       
                                                                                
modes = []                                                                      
for i in range(len(dx1)):                                                       
    if dx1[i] > 0 and dx2[i] > 0:                                               
        modes.append(1)                                                         
    elif dx1[i] < 0 and dx2[i] > 0:                                             
        modes.append(2)                                                         
    elif dx1[i] < 0 and dx2[i] < 0:                                             
        modes.append(3)                                                         
    else:                                                                       
        modes.append(0) # Unknown or transition noise                           
                                                                                
