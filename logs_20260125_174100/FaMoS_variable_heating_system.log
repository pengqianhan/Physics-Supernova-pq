import numpy as np                                                              
                                                                                
dt = 0.1                                                                        
                                                                                
def perform_regression(X_series, include_b=True):                               
    # X_series: (2, T)                                                          
    # DX_series: (2, T)                                                         
    T = X_series.shape[1]                                                       
    # Use central difference for better precision, but gradient is fine         
    DX_series = np.gradient(X_series, axis=1) / dt                              
                                                                                
    results = []                                                                
    for i in range(2): # For each state variable                                
        x = X_series[i, :]                                                      
        dx = DX_series[i, :]                                                    
        if include_b:                                                           
            # y = a*x + b                                                       
            A = np.column_stack([x, np.ones(len(x))])                           
            y = dx                                                              
            c, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                      
            results.append((c[0], c[1]))                                        
        else:                                                                   
            # y = a*x                                                           
            A = x.reshape(-1, 1)                                                
            y = dx                                                              
            c, _, _, _ = np.linalg.lstsq(A, y, rcond=None)                      
            results.append((c[0], 0.0))                                         
    return results                                                              
                                                                                
for i, path in enumerate(DATA_FILE_PATHS):                                      
    data = np.load(path)                                                        
    X = data['state']                                                           
    # Try regression with b for all to see what we get                          
    res = perform_regression(X, include_b=True)                                 
    print(f"File {i} (Mode {i+1}):")                                            
    print(f"  Var 1: a={res[0][0]:.10f}, b={res[0][1]:.10f}")                   
