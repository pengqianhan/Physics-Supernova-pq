import numpy as np                                                              
from scipy.linalg import lstsq                                                  
                                                                                
def estimate_dynamics(x1, x2, dt, indices):                                     
    # Slice the data                                                            
    x1_slice = x1[indices[0]:indices[1]+1]                                      
    x2_slice = x2[indices[0]:indices[1]+1]                                      
                                                                                
    # Calculate derivatives (forward difference for simplicity, or central)     
    dx1 = np.diff(x1_slice) / dt                                                
    dx2 = np.diff(x2_slice) / dt                                                
                                                                                
    # Prepare the regression matrix A and target vector B                       
    # We use the state at time t to predict derivative at time t                
    # dx1/dt = a11*x1 + a12*x2 + b1                                             
    # dx2/dt = a21*x1 + a22*x2 + b2                                             
    X = np.column_stack([x1_slice[:-1], x2_slice[:-1],                          
np.ones(len(x1_slice)-1)])                                                      
                                                                                
    # Solve for x1 dynamics                                                     
    coeffs1, _, _, _ = lstsq(X, dx1)                                            
    a11, a12, b1 = coeffs1                                                      
                                                                                
    # Solve for x2 dynamics                                                     
    coeffs2, _, _, _ = lstsq(X, dx2)                                            
    a21, a22, b2 = coeffs2                                                      
                                                                                
    return (a11, a12, b1), (a21, a22, b2)                                       
                                                                                
