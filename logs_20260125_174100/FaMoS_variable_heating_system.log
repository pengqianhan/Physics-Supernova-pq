def fit_linear(X, Y):                                                           
    # Fit Y = a*X + b                                                           
    A = np.vstack([X, np.ones(len(X))]).T                                       
    a, b = np.linalg.lstsq(A, Y, rcond=None)[0]                                 
    return a, b                                                                 
                                                                                
# Collect data for each mode across all segments                                
