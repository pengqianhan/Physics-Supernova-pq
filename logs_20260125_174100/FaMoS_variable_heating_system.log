files = ['data_all/FaMoS/variable_heating_system/sample_0.npz',                 
         'data_all/FaMoS/variable_heating_system/sample_1.npz',                 
         'data_all/FaMoS/variable_heating_system/sample_2.npz']                 
                                                                                
mode_data = {1: [], 2: [], 3: []}                                               
transitions = {'1->2': [], '2->3': [], '3->1': []}                              
                                                                                
for f in files:                                                                 
    data = np.load(f)                                                           
    X = data['X']                                                               
    t = data['t']                                                               
    n = len(X)                                                                  
                                                                                
    # Calculate differences as proxies for derivatives                          
    dX = np.diff(X, axis=0)                                                     
                                                                                
    # Modes assignment for each interval [k, k+1]                               
    # We'll use the sign of the difference to determine the mode of the current 
state                                                                           
    modes = []                                                                  
    for i in range(n-1):                                                        
        dx1 = dX[i, 0]                                                          
        dx2 = dX[i, 1]                                                          
                                                                                
        if dx1 > 0:                                                             
            m = 1                                                               
        elif dx1 < 0 and dx2 > 0:                                               
            m = 2                                                               
        elif dx1 < 0 and dx2 < 0:                                               
            m = 3                                                               
        else:                                                                   
            # Fallback for dx=0                                                 
            m = modes[-1] if modes else 1                                       
        modes.append(m)                                                         
                                                                                
    # Collect regression data                                                   
    for i in range(n-1):                                                        
        m = modes[i]                                                            
        # x[k], x[k+1]                                                          
        mode_data[m].append([X[i, 0], X[i, 1], X[i+1, 0], X[i+1, 1]])           
                                                                                
    # Find transitions                                                          
    for i in range(len(modes)-1):                                               
        m_curr = modes[i]                                                       
        m_next = modes[i+1]                                                     
        if m_curr != m_next:                                                    
            if m_curr == 1 and m_next == 2:                                     
                transitions['1->2'].append(X[i+1, 0])                           
            elif m_curr == 2 and m_next == 3:                                   
                transitions['2->3'].append([X[i+1, 0], X[i+1, 1]])              
            elif m_curr == 3 and m_next == 1:                                   
                transitions['3->1'].append(X[i+1, 1])                           
                                                                                
# Linear Regression helper                                                      
def fit_mode(data_list):                                                        
    arr = np.array(data_list)                                                   
    # Target: x1_kp1 = a11*x1_k + a12*x2_k + b1                                 
    # Target: x2_kp1 = a21*x1_k + a22*x2_k + b2                                 
    X_mat = np.column_stack([arr[:, 0], arr[:, 1], np.ones(len(arr))])          
    y1 = arr[:, 2]                                                              
    y2 = arr[:, 3]                                                              
                                                                                
    beta1, _, _, _ = np.linalg.lstsq(X_mat, y1, rcond=None)                     
    beta2, _, _, _ = np.linalg.lstsq(X_mat, y2, rcond=None)                     
                                                                                
    return {                                                                    
        'a11': beta1[0], 'a12': beta1[1], 'b1': beta1[2],                       
        'a21': beta2[0], 'a22': beta2[1], 'b2': beta2[2]                        
    }                                                                           
                                                                                
results = {}                                                                    
for m in [1, 2, 3]:                                                             
    if mode_data[m]:                                                            
        results[m] = fit_mode(mode_data[m])                                     
                                                                                
# Summarize guards                                                              
guard_12_x1 = np.mean(transitions['1->2']) if transitions['1->2'] else None     
guard_23 = np.mean(transitions['2->3'], axis=0) if transitions['2->3'] else     
[None, None]                                                                    
guard_31_x2 = np.mean(transitions['3->1']) if transitions['3->1'] else None     
                                                                                
print("Results:")                                                               
for m, res in results.items():                                                  
    print(f"Mode {m}: {res}")                                                   
print(f"Guard 1->2 (x1): {guard_12_x1}")                                        
print(f"Guard 2->3 (x1, x2): {guard_23}")                                       
print(f"Guard 3->1 (x2): {guard_31_x2}")                                        
                                                                                
