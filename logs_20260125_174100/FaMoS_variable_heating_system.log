import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def analyze_modes(path):                                                        
    data = np.load(path)                                                        
    state = data['state']                                                       
    # Assuming dt = 0.01 based on typical values for such datasets              
    dt = 0.01                                                                   
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
    x1_t = x1[:-1]                                                              
    x2_t = x2[:-1]                                                              
    return x1_t, x2_t, dx1, dx2                                                 
                                                                                
# Combine all data                                                              
X1, X2, DX1, DX2 = [], [], [], []                                               
for path in DATA_FILE_PATHS:                                                    
    x1t, x2t, dx1, dx2 = analyze_modes(path)                                    
    X1.append(x1t)                                                              
    X2.append(x2t)                                                              
    DX1.append(dx1)                                                             
    DX2.append(dx2)                                                             
                                                                                
X1 = np.concatenate(X1)                                                         
X2 = np.concatenate(X2)                                                         
DX1 = np.concatenate(DX1)                                                       
DX2 = np.concatenate(DX2)                                                       
                                                                                
# Separate modes based on dx1 (heating/cooling)                                 
# Let's see the distribution of dx1                                             
print(f"DX1 range: {np.min(DX1)} to {np.max(DX1)}")                             
                                                                                
# Since it's a heating system, dx1 > some_threshold likely means heater ON      
# Let's find a threshold. Look at the histogram of DX1.                         
hist, bin_edges = np.histogram(DX1, bins=50)                                    
print(f"DX1 histogram bins: {bin_edges}")                                       
                                                                                
# Divide into Mode 0 (Cooling) and Mode 1 (Heating)                             
# Usually cooling dx1 is negative or lower than heating dx1                     
threshold = (np.min(DX1) + np.max(DX1)) / 2                                     
mode1_mask = DX1 > threshold                                                    
mode0_mask = ~mode1_mask                                                        
                                                                                
def fit_mode(mask, label):                                                      
    if np.sum(mask) < 10: return                                                
    x_input = np.stack([X1[mask], X2[mask]], axis=1)                            
                                                                                
    reg1 = LinearRegression().fit(x_input, DX1[mask])                           
    reg2 = LinearRegression().fit(x_input, DX2[mask])                           
                                                                                
    print(f"--- Mode {label} ---")                                              
    print(f"dx1/dt = {reg1.coef_[0]:.4f}*x1 + {reg1.coef_[1]:.4f}*x2 +          
{reg1.intercept_:.4f}")                                                         
    print(f"dx2/dt = {reg2.coef_[0]:.4f}*x1 + {reg2.coef_[1]:.4f}*x2 +          
{reg2.intercept_:.4f}")                                                         
    return reg1, reg2                                                           
                                                                                
fit_mode(mode0_mask, "0 (Cooling/Heater OFF)")                                  
fit_mode(mode1_mask, "1 (Heating/Heater ON)")                                   
                                                                                
# Find switching conditions                                                     
# Mode transitions happen when the mode mask changes                            
# Look at the values of x1 and x2 at transition points                          
for path in DATA_FILE_PATHS:                                                    
    x1t, x2t, dx1, dx2 = analyze_modes(path)                                    
    m = dx1 > threshold                                                         
    switches = np.where(m[:-1] != m[1:])[0]                                     
    for s in switches:                                                          
        direction = "0 -> 1" if m[s+1] else "1 -> 0"                            
        print(f"Switch {direction} at x1={x1t[s]:.4f}, x2={x2t[s]:.4f}")        
                                                                                
