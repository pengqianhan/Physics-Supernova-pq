  def fit(x1, x2, dx):                                                          
      x1 = np.concatenate(x1)                                                   
      x2 = np.concatenate(x2)                                                   
      dx = np.concatenate(dx)                                                   
      A = np.vstack([x1, x2, np.ones(len(x1))]).T                               
      p, _, _, _ = np.linalg.lstsq(A, dx, rcond=None)                           
