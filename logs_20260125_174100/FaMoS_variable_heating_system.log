import numpy as np                                                              
                                                                                
def analyze_mode(file_path, dt=0.001):                                          
    data = np.load(file_path)                                                   
    X = data['state']  # shape (2, T)                                           
    T = X.shape[1]                                                              
                                                                                
    # Use central difference for derivative                                     
    # dX/dt = (X(t+dt) - X(t-dt)) / (2*dt)                                      
    # We use np.gradient which is more robust                                   
    dX = np.gradient(X, axis=1) / dt                                            
                                                                                
    coeffs = []                                                                 
    for i in range(2):                                                          
        # Fit dx_i/dt = a_ii * x_i + b_i                                        
        # Regression: y = A @ [a, b]                                            
        A = np.column_stack([X[i, :], np.ones(T)])                              
        y = dX[i, :]                                                            
        sol, residuals, rank, s = np.linalg.lstsq(A, y, rcond=None)             
        coeffs.append(sol)                                                      
    return coeffs                                                               
                                                                                
