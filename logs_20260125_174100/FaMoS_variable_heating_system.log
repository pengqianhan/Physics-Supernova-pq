import numpy as np                                                              
                                                                                
def segment_regression(state, jumps, dt=0.1):                                   
    T = state.shape[1]                                                          
    dx = np.gradient(state, axis=1) / dt                                        
                                                                                
    indices = [0] + list(jumps) + [T]                                           
    segments = []                                                               
    for i in range(len(indices)-1):                                             
        start, end = indices[i], indices[i+1]                                   
        # Skip very short segments                                              
        if end - start < 100: continue                                          
                                                                                
        seg_x = state[:, start:end]                                             
        seg_dx = dx[:, start:end]                                               
                                                                                
        # Fit dx = ax + b for each variable                                     
