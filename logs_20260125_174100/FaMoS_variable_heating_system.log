import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def get_segments(x1):                                                           
    # Find peaks and troughs                                                    
    peaks = []                                                                  
    troughs = []                                                                
    for i in range(1, len(x1) - 1):                                             
        if x1[i] > x1[i-1] and x1[i] > x1[i+1]:                                 
            peaks.append(i)                                                     
        if x1[i] < x1[i-1] and x1[i] < x1[i+1]:                                 
            troughs.append(i)                                                   
                                                                                
    # Sort them to get a timeline of events                                     
    events = [(p, 'peak') for p in peaks] + [(t, 'trough') for t in troughs]    
    events.sort()                                                               
                                                                                
    mode1_data = [] # (x1_k, x2_k) -> x1_kp1, x2_kp1                            
    mode2_data = []                                                             
                                                                                
    # Determine initial mode                                                    
    # If first event is peak, then initially it was increasing (Mode 1)         
    # If first event is trough, then initially it was decreasing (Mode 2)       
    if not events:                                                              
        return [], []                                                           
                                                                                
    current_idx = 0                                                             
    if events[0][1] == 'peak':                                                  
        current_mode = 1                                                        
    else:                                                                       
        current_mode = 2                                                        
                                                                                
    for event_idx, event_type in events:                                        
        # Segment from current_idx to event_idx                                 
        for k in range(current_idx, event_idx):                                 
            # Target is k+1                                                     
            data_point = ([x1[k], x2[k]], [x1[k+1], x2[k+1]])                   
            if current_mode == 1:                                               
                mode1_data.append(data_point)                                   
            else:                                                               
                mode2_data.append(data_point)                                   
                                                                                
        # Transition                                                            
        current_idx = event_idx                                                 
        current_mode = 2 if event_type == 'peak' else 1                         
                                                                                
    # Process remaining data after last event                                   
    for k in range(current_idx, len(x1) - 1):                                   
        data_point = ([x1[k], x2[k]], [x1[k+1], x2[k+1]])                       
        if current_mode == 1:                                                   
            mode1_data.append(data_point)                                       
        else:                                                                   
            mode2_data.append(data_point)                                       
                                                                                
    return mode1_data, mode2_data                                               
                                                                                
def fit_ode(data):                                                              
    if not data:                                                                
        return None, None                                                       
    X = np.array([d[0] for d in data])                                          
    Y = np.array([d[1] for d in data])                                          
                                                                                
    # X has [x1, x2], we want to add a constant term for a3 and b3              
    X_aug = np.column_stack([X, np.ones(len(X))])                               
                                                                                
    # Fit for x1[k+1]                                                           
    res1 = np.linalg.lstsq(X_aug, Y[:, 0], rcond=None)[0]                       
    # Fit for x2[k+1]                                                           
    res2 = np.linalg.lstsq(X_aug, Y[:, 1], rcond=None)[0]                       
                                                                                
    return res1, res2                                                           
                                                                                
all_mode1 = []                                                                  
all_mode2 = []                                                                  
                                                                                
file_paths = ['data_all/FaMoS/variable_heating_system/sample_0.npz',            
              'data_all/FaMoS/variable_heating_system/sample_1.npz',            
              'data_all/FaMoS/variable_heating_system/sample_2.npz']            
                                                                                
peak_vals = []                                                                  
trough_vals_x1 = []                                                             
trough_vals_x2 = []                                                             
                                                                                
for path in file_paths:                                                         
    data = np.load(path)                                                        
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    m1, m2 = get_segments(x1)                                                   
    all_mode1.extend(m1)                                                        
    all_mode2.extend(m2)                                                        
                                                                                
    # Also find thresholds                                                      
    for i in range(1, len(x1)-1):                                               
        if x1[i] > x1[i-1] and x1[i] > x1[i+1]:                                 
            peak_vals.append(x1[i])                                             
        if x1[i] < x1[i-1] and x1[i] < x1[i+1]:                                 
            trough_vals_x1.append(x1[i])                                        
            trough_vals_x2.append(x2[i])                                        
                                                                                
res1_m1, res2_m1 = fit_ode(all_mode1)                                           
res1_m2, res2_m2 = fit_ode(all_mode2)                                           
                                                                                
