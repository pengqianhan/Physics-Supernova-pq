      # Model 3: Simplest (a*x1)                                                
                                                                                
      # Model 1                                                                 
      c1, res1, _, _ = np.linalg.lstsq(X_all, Y_all, rcond=None)                
                                                                                
      # Model 2                                                                 
      X2 = X_all[:, [0, 2]]                                                     
      c2, res2, _, _ = np.linalg.lstsq(X2, Y_all, rcond=None)                   
                                                                                
      # Model 3                                                                 
      X3 = X_all[:, [0]]                                                        
      c3, res3, _, _ = np.linalg.lstsq(X3, Y_all, rcond=None)                   
                                                                                
      return (res1, c1), (res2, c2), (res3, c3)                                 
                                                                                
  # For heating                                                                 
  heating_x1_x = []                                                             
  heating_x1_y = []                                                             
  heating_x2_x = []                                                             
  heating_x2_y = []                                                             
  cooling_x1_x = []                                                             
  cooling_x1_y = []                                                             
  cooling_x2_x = []                                                             
  cooling_x2_y = []                                                             
                                                                                
  for x1_seg, x2_seg, mode in all_segments_data:                                
      X_seg = np.column_stack([x1_seg[:-1], x2_seg[:-1],                        
  np.ones(len(x1_seg)-1)])                                                      
      if mode == 'heating':                                                     
          heating_x1_x.append(X_seg)                                            
          heating_x1_y.append(x1_seg[1:])                                       
          heating_x2_x.append(X_seg)                                            
          heating_x2_y.append(x2_seg[1:])                                       
      else:                                                                     
          cooling_x1_x.append(X_seg)                                            
          cooling_x1_y.append(x1_seg[1:])                                       
          cooling_x2_x.append(X_seg)                                            
          cooling_x2_y.append(x2_seg[1:])                                       
                                                                                
  def process_results(x_list, y_list, name):                                    
      X = np.vstack(x_list)                                                     
      Y = np.concatenate(y_list)                                                
      r1, r2, r3 = evaluate_simpler_model(X, Y)                                 
      print(f"--- {name} ---")                                                  
      print(f"Full model: res={r1[0]}, coeffs={r1[1]}")                         
      print(f"x1+c model: res={r2[0]}, coeffs={r2[1]}")                         
      print(f"x1 model: res={r3[0]}, coeffs={r3[1]}")                           
                                                                                
  process_results(heating_x1_x, heating_x1_y, "Heating x1")                     
  process_results(heating_x2_x, heating_x2_y, "Heating x2")                     
  process_results(cooling_x1_x, cooling_x1_y, "Cooling x1")                     
  process_results(cooling_x2_x, cooling_x2_y, "Cooling x2")                     
