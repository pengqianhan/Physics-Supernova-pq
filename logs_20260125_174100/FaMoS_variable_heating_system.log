        X = data['state']                                                       
        # Detect mode jumps                                                     
        diffs = np.diff(X, axis=1)                                              
        jumps = [0]                                                             
        for v in range(2):                                                      
            d2 = np.abs(np.diff(diffs[v]))                                      
            threshold = np.std(d2) * 20                                         
            j = np.where(d2 > threshold)[0] + 1                                 
            jumps.extend(j)                                                     
        jumps = sorted(list(set(jumps)))                                        
                                                                                
        refined = [0]                                                           
        for j in jumps:                                                         
            if j - refined[-1] > 100:                                           
                refined.append(j)                                               
        refined.append(X.shape[1])                                              
                                                                                
        for i in range(len(refined) - 1):                                       
            s, e = refined[i], refined[i+1]                                     
            if e - s < 200: continue                                            
                                                                                
            seg_x = X[:, s:e]                                                   
            seg_results = []                                                    
            for v in range(2):                                                  
                x_k = seg_x[v, :-1]                                             
                x_kp1 = seg_x[v, 1:]                                            
