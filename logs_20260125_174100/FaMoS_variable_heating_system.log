all_data = []                                                                   
for path in DATA_FILE_PATHS:                                                    
    with np.load(path) as data:                                                 
        # Assuming the keys are 'x1' and 'x2' or 'x'                            
        # Let's check keys first                                                
        keys = list(data.keys())                                                
        if 'x' in keys:                                                         
            x = data['x']                                                       
            x1 = x[:, 0]                                                        
            x2 = x[:, 1]                                                        
        elif 'x1' in keys and 'x2' in keys:                                     
            x1 = data['x1']                                                     
            x2 = data['x2']                                                     
        else:                                                                   
            # Try to guess                                                      
            x1 = data[keys[0]]                                                  
            x2 = data[keys[1]]                                                  
        all_data.append((x1, x2))                                               
                                                                                
def analyze_modes(x1, x2):                                                      
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    modes = []                                                                  
    # Mode 1: Both increasing                                                   
    # Mode 2: x1 decreasing, x2 increasing                                      
    # Mode 3: Both decreasing                                                   
                                                                                
    for i in range(len(dx1)):                                                   
        if dx1[i] > 0 and dx2[i] > 0:                                           
            modes.append(1)                                                     
        elif dx1[i] < 0 and dx2[i] > 0:                                         
            modes.append(2)                                                     
        elif dx1[i] < 0 and dx2[i] < 0:                                         
            modes.append(3)                                                     
        else:                                                                   
            modes.append(0) # Unknown or transition                             
    return np.array(modes)                                                      
                                                                                
results = []                                                                    
for x1, x2 in all_data:                                                         
    modes = analyze_modes(x1, x2)                                               
    # Fit coefficients                                                          
    for m in [1, 2, 3]:                                                         
        idx = np.where(modes == m)[0]                                           
        if len(idx) > 1:                                                        
            # x1[i+1] = a1 * x1[i] + b1                                         
            slope1, intercept1, _, _, _ = stats.linregress(x1[idx], x1[idx+1])  
            slope2, intercept2, _, _, _ = stats.linregress(x2[idx], x2[idx+1])  
            results.append({                                                    
                'mode': m,                                                      
                'a1': slope1, 'b1': intercept1,                                 
                'a2': slope2, 'b2': intercept2,                                 
                'x1_vals': x1[idx], 'x2_vals': x2[idx]                          
            })                                                                  
                                                                                
# Identify guards                                                               
# Trans 1->2: x1 starts decreasing. Guard usually depends on x1 or x2 threshold.
# Trans 2->3: x2 starts decreasing.                                             
# Trans 3->1: both start increasing.                                            
                                                                                
# Aggregate results                                                             
final_coeffs = {}                                                               
for m in [1, 2, 3]:                                                             
    m_data = [r for r in results if r['mode'] == m]                             
    if m_data:                                                                  
        final_coeffs[m] = {                                                     
            'a1': np.mean([r['a1'] for r in m_data]),                           
            'b1': np.mean([r['b1'] for r in m_data]),                           
            'a2': np.mean([r['a2'] for r in m_data]),                           
            'b2': np.mean([r['b2'] for r in m_data])                            
        }                                                                       
                                                                                
# Finding thresholds (approximate guards)                                       
guards = {}                                                                     
for x1, x2 in all_data:                                                         
    modes = analyze_modes(x1, x2)                                               
    for i in range(len(modes)-1):                                               
        if modes[i] == 1 and modes[i+1] == 2:                                   
            guards['1->2'] = guards.get('1->2', []) + [x1[i+1]]                 
        if modes[i] == 2 and modes[i+1] == 3:                                   
            guards['2->3'] = guards.get('2->3', []) + [x2[i+1]]                 
        if modes[i] == 3 and modes[i+1] == 1:                                   
            guards['3->1'] = guards.get('3->1', []) + [x1[i+1], x2[i+1]]        
                                                                                
print("Coefficients:", final_coeffs)                                            
print("Guard samples:", guards)                                                 
                                                                                
# Calculate guard averages                                                      
avg_guards = {k: np.mean(v) for k, v in guards.items()}                         
print("Average Guards:", avg_guards)                                            
                                                                                
