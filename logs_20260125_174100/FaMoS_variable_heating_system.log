import numpy as np                                                              
from sklearn.linear_model import LinearRegression                               
                                                                                
def get_segments(data_path):                                                    
    data = np.load(data_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
                                                                                
    # Calculate derivatives (difference)                                        
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    # Identify change points                                                    
    # Use a slightly more robust way to find change points                      
    # Sudden jumps in dx1 or dx2                                                
    # Since dx is diff, it's essentially the derivative if dt=1                 
    change_points = []                                                          
    for i in range(1, len(dx1)):                                                
        # Check if the derivative changed significantly                         
        if abs(dx1[i] - dx1[i-1]) > 1e-4 or abs(dx2[i] - dx2[i-1]) > 1e-4:      
            change_points.append(i+1) # state[i+1] is where the new mode starts 
                                                                                
    # Define segments                                                           
    segments = []                                                               
    indices = [0] + change_points + [len(x1)]                                   
    for i in range(len(indices)-1):                                             
        start, end = indices[i], indices[i+1]                                   
        if end - start > 5: # ignore very short segments if any                 
            segments.append({                                                   
                'x1': x1[start:end],                                            
                'x2': x2[start:end],                                            
                'dx1': dx1[start:end-1] if end < len(x1) else                   
dx1[start-1:end-1],                                                             
                'dx2': dx2[start:end-1] if end < len(x1) else                   
dx2[start-1:end-1],                                                             
                'start_idx': start,                                             
                'end_idx': end                                                  
            })                                                                  
    return segments, state                                                      
                                                                                
all_segments = []                                                               
transitions = []                                                                
                                                                                
for path in DATA_FILE_PATHS:                                                    
    segs, state = get_segments(path)                                            
    all_segments.extend(segs)                                                   
    # Track transitions for guards and resets                                   
    for i in range(len(segs)-1):                                                
        curr_seg = segs[i]                                                      
        next_seg = segs[i+1]                                                    
        # Guard is the state at the end of the current segment                  
        # Reset is the difference between start of next and end of current      
        guard_state = state[:, curr_seg['end_idx'] - 1]                         
        next_state_start = state[:, next_seg['start_idx']]                      
        reset = next_state_start - guard_state                                  
                                                                                
        # Determine mode transition                                             
        mode_from = 1 if np.mean(curr_seg['dx1']) > 0 else 2                    
        mode_to = 1 if np.mean(next_seg['dx1']) > 0 else 2                      
                                                                                
        transitions.append({                                                    
            'from': mode_from,                                                  
            'to': mode_to,                                                      
            'guard': guard_state,                                               
            'reset': reset                                                      
        })                                                                      
                                                                                
# Group segments by mode                                                        
mode1_data = {'x1': [], 'x2': [], 'dx1': [], 'dx2': []}                         
mode2_data = {'x1': [], 'x2': [], 'dx1': [], 'dx2': []}                         
                                                                                
for seg in all_segments:                                                        
    m = 1 if np.mean(seg['dx1']) > 0 else 2                                     
    target = mode1_data if m == 1 else mode2_data                               
    # For regression, we need x(t) and dx(t).                                   
    # dx[k] = x[k+1] - x[k]. So we pair dx[k] with x[k].                        
    target['x1'].extend(seg['x1'][:-1])                                         
    target['x2'].extend(seg['x2'][:-1])                                         
    target['dx1'].extend(seg['dx1'])                                            
    target['dx2'].extend(seg['dx2'])                                            
                                                                                
def fit_mode(data):                                                             
    X = np.column_stack([data['x1'], data['x2']])                               
    y1 = np.array(data['dx1'])                                                  
