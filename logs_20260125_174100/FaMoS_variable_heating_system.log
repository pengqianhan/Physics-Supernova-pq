    data = np.load(path)                                                        
    x = data['state']                                                           
    x1, x2 = x[0, :], x[1, :]                                                   
    dx1, dx2 = np.diff(x1), np.diff(x2)                                         
    x1t, x2t = x1[:-1], x2[:-1]                                                 
                                                                                
    # Simple threshold to separate modes                                        
    mid = (np.min(dx1) + np.max(dx1)) / 2                                       
    m = (dx1 > mid).astype(int)                                                 
                                                                                
    all_X1_0.append(x1t[m==0])                                                  
    all_X2_0.append(x2t[m==0])                                                  
    all_DX1_0.append(dx1[m==0])                                                 
    all_DX2_0.append(dx2[m==0])                                                 
                                                                                
    all_X1_1.append(x1t[m==1])                                                  
    all_X2_1.append(x2t[m==1])                                                  
    all_DX1_1.append(dx1[m==1])                                                 
    all_DX2_1.append(dx2[m==1])                                                 
                                                                                
    sw = np.where(m[:-1] != m[1:])[0]                                           
    for s in sw:                                                                
