import numpy as np                                                              
                                                                                
def extract_modes(file_paths, dt=0.001):                                        
    all_results = []                                                            
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        X = data['state']                                                       
        # Numerical derivative                                                  
        dx = np.diff(X, axis=1) / dt                                            
        # Jumps detection                                                       
        d2x = np.diff(dx, axis=1)                                               
        jumps = [0]                                                             
        for v in range(2):                                                      
            threshold = np.std(d2x[v]) * 10                                     
            j = np.where(np.abs(d2x[v]) > threshold)[0] + 2                     
            jumps.extend(j)                                                     
        jumps = sorted(list(set(jumps)))                                        
        refined = [0]                                                           
        for j in jumps:                                                         
            if j - refined[-1] > 100:                                           
                refined.append(j)                                               
        refined.append(X.shape[1])                                              
                                                                                
        for i in range(len(refined)-1):                                         
            s, e = refined[i], refined[i+1]                                     
            seg_x = X[:, s:e]                                                   
            if seg_x.shape[1] < 100: continue                                   
                                                                                
            # Regression for var 0                                              
            x0 = seg_x[0, :-1]                                                  
            y0 = (seg_x[0, 1:] - seg_x[0, :-1]) / dt                            
            A0 = np.column_stack([x0, np.ones(len(x0))])                        
            c0 = np.linalg.lstsq(A0, y0, rcond=None)[0]                         
                                                                                
            # Regression for var 1                                              
            x1 = seg_x[1, :-1]                                                  
            y1 = (seg_x[1, 1:] - seg_x[1, :-1]) / dt                            
            A1 = np.column_stack([x1, np.ones(len(x1))])                        
            c1 = np.linalg.lstsq(A1, y1, rcond=None)[0]                         
                                                                                
            all_results.append({'a11': c0[0], 'a22': c1[0], 'b1': c0[1], 'b2':  
c1[1]})                                                                         
    return all_results                                                          
                                                                                
