import numpy as np                                                              
                                                                                
def analyze_slopes(data_path):                                                  
    data = np.load(data_path)                                                   
    state = data['state']                                                       
    x1 = state[0]                                                               
    x2 = state[1]                                                               
                                                                                
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    # Identify segments by looking at jumps in dx1                              
    # We saw dx1 jumps between 0.008 and -0.002                                 
    # Threshold for jump detection                                              
    ddx1 = np.abs(np.diff(dx1))                                                 
    switches = np.where(ddx1 > 0.001)[0] + 1 # +1 because diff reduces length   
                                                                                
    segments = []                                                               
    start_idx = 0                                                               
    indices = list(switches) + [len(dx1)]                                       
                                                                                
    for end_idx in indices:                                                     
        seg_x1 = x1[start_idx:end_idx]                                          
        seg_x2 = x2[start_idx:end_idx]                                          
        seg_dx1 = dx1[start_idx:end_idx]                                        
        seg_dx2 = dx2[start_idx:end_idx]                                        
                                                                                
        segments.append({                                                       
            'start_idx': start_idx,                                             
            'end_idx': end_idx,                                                 
            'mean_dx1': np.mean(seg_dx1),                                       
            'std_dx1': np.std(seg_dx1),                                         
            'mean_dx2': np.mean(seg_dx2),                                       
            'std_dx2': np.std(seg_dx2),                                         
            'start_val': (x1[start_idx], x2[start_idx]),                        
            'end_val': (x1[end_idx], x2[end_idx]) if end_idx < len(x1) else     
(x1[-1], x2[-1])                                                                
        })                                                                      
        start_idx = end_idx                                                     
                                                                                
    return segments                                                             
                                                                                
for i in range(3):                                                              
    print(f"--- Analysis for Sample {i} ---")                                   
    segs = analyze_slopes(f'data_all/linear/two_tank/sample_{i}.npz')           
    for idx, s in enumerate(segs):                                              
        print(f"Segment {idx}:")                                                
        print(f"  Range: indices {s['start_idx']} to {s['end_idx']}")           
