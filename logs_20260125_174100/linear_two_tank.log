def check_resets(file_path):                                                    
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
    dx1_r = np.round(dx1, 6)                                                    
    dx2_r = np.round(dx2, 6)                                                    
                                                                                
    for i in range(len(dx1_r) - 1):                                             
        if (dx1_r[i], dx2_r[i]) != (dx1_r[i+1], dx2_r[i+1]):                    
            # State at transition index i+1 is x[i+1]                           
            # State before transition is x[i]                                   
            # Predicted next state without reset would be x[i] + dx[i]          
            # But dx[i] = x[i+1] - x[i] by definition of how I computed dx.     
            # I should instead check if the jump at the transition is "large"   
compared to normal steps.                                                       
            # Normal steps are 0.008, -0.002, etc.                              
            jump1 = x1[i+1] - x1[i]                                             
            jump2 = x2[i+1] - x2[i]                                             
            print(f"Index {i+1}: jumps are {jump1:.6f}, {jump2:.6f}")           
            # Actually, to check for resets, I should check if x[i+1] is        
different from what we'd expect.                                                
            # But I don't have the time step 'dt'.                              
            # If the data is (state_t0, state_t1, ...), then x[i+1] - x[i] is   
just the step.                                                                  
            # If there was a reset, it would typically happen AT the transition.
            # Let's check the very next step x[i+2] - x[i+1] too.               
                                                                                
check_resets('data_all/linear/two_tank/sample_0.npz')                           
                                                                                
