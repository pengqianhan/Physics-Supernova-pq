import numpy as np                                                              
                                                                                
def analyze_sample_extended(data_idx):                                          
    data = np.load(DATA_FILE_PATHS[data_idx])                                   
    x = data['state']                                                           
    dx = np.diff(x, axis=1)                                                     
    ddx = np.diff(dx, axis=1)                                                   
    threshold = 1e-6                                                            
    switches = np.where(np.any(np.abs(ddx) > threshold, axis=0))[0] + 1         
                                                                                
    filtered_switches = []                                                      
    if len(switches) > 0:                                                       
        filtered_switches = [switches[0]]                                       
        for s in switches[1:]:                                                  
            if s > filtered_switches[-1] + 1:                                   
                filtered_switches.append(s)                                     
                                                                                
    results = []                                                                
    for s in filtered_switches:                                                 
        results.append({                                                        
            'index': int(s),                                                    
            'x1': float(x[0, s]),                                               
            'x2': float(x[1, s]),                                               
            'dx_before': dx[:, s-2].tolist(),                                   
            'dx_after': dx[:, s].tolist()                                       
        })                                                                      
    return results                                                              
                                                                                
print("Sample 2 Analysis:")                                                     
