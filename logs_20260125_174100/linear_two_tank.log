import numpy as np                                                              
                                                                                
def analyze_sample(sample_path):                                                
    data = np.load(sample_path)                                                 
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    # Identify transition points                                                
    transitions = []                                                            
    for i in range(1, len(dx1)):                                                
        if not (np.isclose(dx1[i], dx1[i-1], atol=1e-6) and np.isclose(dx2[i],  
dx2[i-1], atol=1e-6)):                                                          
            transitions.append(i)                                               
                                                                                
    print(f"\nAnalysis for {sample_path}:")                                     
    print(f"Transitions at indices: {transitions}")                             
                                                                                
    segments = [0] + transitions + [len(dx1)]                                   
    for i in range(len(segments)-1):                                            
        start = segments[i]                                                     
        end = segments[i+1]                                                     
        # Get slopes in this segment (take mean of a few values to avoid noise, 
though it looks constant)                                                       
        m_dx1 = np.mean(dx1[start:end])                                         
        m_dx2 = np.mean(dx2[start:end])                                         
        print(f"  Segment {i} (indices {start}-{end}): dx1={m_dx1:.4f},         
dx2={m_dx2:.4f}")                                                               
                                                                                
    for trans_idx in transitions:                                               
        # State at transition                                                   
        # Value at the last point of the old mode                               
        v_trans = state[:, trans_idx]                                           
        v_next = state[:, trans_idx + 1]                                        
        print(f"  Transition at index {trans_idx}: x1={v_trans[0]:.4f},         
x2={v_trans[1]:.4f}")                                                           
        # Check reset                                                           
        jump = v_next - v_trans                                                 
        # Note: even without reset, state[i+1] - state[i] is dx[i].             
        # A reset is a jump ABOVE the regular derivative change.                
        # But in discrete time, it's hard to distinguish.                       
        # However, if the change matches the new derivative or old derivative,  
it's likely just a mode change.                                                 
        # Let's see if x is continuous. Usually in these files, state[i+1] is   
reached from state[i] by the ODE.                                               
        # If there's a reset, state[i+1] would be different from what the ODE   
predicts.                                                                       
                                                                                
for i in range(3):                                                              
    analyze_sample(DATA_FILE_PATHS[i])                                          
                                                                                
