import numpy as np                                                              
                                                                                
results = []                                                                    
                                                                                
for idx, state in enumerate(all_states):                                        
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    # Identify indices where the mode changes                                   
    change_indices = [i for i in range(1, len(dx1)) if not np.allclose([dx1[i], 
dx2[i]], [dx1[i-1], dx2[i-1]], atol=1e-5)]                                      
                                                                                
    # Segment boundaries                                                        
    boundaries = [0] + change_indices + [len(dx1)]                              
                                                                                
    modes = []                                                                  
    for i in range(len(boundaries) - 1):                                        
        start = boundaries[i]                                                   
        end = boundaries[i+1]                                                   
                                                                                
        # Derivative in this mode                                               
        mode_dx1 = dx1[start]                                                   
        mode_dx2 = dx2[start]                                                   
                                                                                
        # State at start and end of mode                                        
        x_start = state[:, start]                                               
        x_end = state[:, end] # state at end of the mode (last point before     
change)                                                                         
                                                                                
        modes.append({                                                          
            'mode_id': i,                                                       
            'dx': (mode_dx1, mode_dx2),                                         
            'start_idx': start,                                                 
            'end_idx': end,                                                     
            'x_start': x_start,                                                 
            'x_end': x_end                                                      
        })                                                                      
                                                                                
    # Transitions                                                               
    transitions = []                                                            
    for i in range(len(modes) - 1):                                             
        m_from = modes[i]                                                       
        m_to = modes[i+1]                                                       
                                                                                
        # Check for resets                                                      
        # Point 'end' of mode i is state[:, boundaries[i+1]]                    
        # Point 'start' of mode i+1 is state[:, boundaries[i+1]]                
        # Since the transition is at 'boundaries[i+1]', the state value is the  
same if there's no jump.                                                        
        # Let's check if the values at the transition point match.              
        # Wait, the way np.diff works, dx[i] = x[i+1] - x[i].                   
        # If the derivative changes at index 'k', then:                         
        # dx[k-1] = x[k] - x[k-1] (old mode)                                    
        # dx[k] = x[k+1] - x[k] (new mode)                                      
        # So x[k] is the point of transition.                                   
        # Is there a discontinuous jump?                                        
        # To check for jumps, we'd need to see if x[k] is consistent with the   
trend.                                                                          
        # But in many hybrid systems, resets are explicit.                      
        # Let's check if there are any obvious discontinuities in the           
trajectories.                                                                   
                                                                                
        transitions.append({                                                    
            'from': m_from['mode_id'],                                          
            'to': m_to['mode_id'],                                              
            'at_idx': m_to['start_idx'],                                        
            'x_at_transition': state[:, m_to['start_idx']]                      
        })                                                                      
                                                                                
    results.append({                                                            
        'sample': idx,                                                          
        'modes': modes,                                                         
        'transitions': transitions                                              
    })                                                                          
                                                                                
for r in results:                                                               
    print(f"Sample {r['sample']}:")                                             
    for m in r['modes']:                                                        
        print(f"  Mode {m['mode_id']}: dx={m['dx']}, range=[{m['start_idx']},   
{m['end_idx']}], x_start={m['x_start']}, x_end={m['x_end']}")                   
    for t in r['transitions']:                                                  
         print(f"  Transition: {t['from']} -> {t['to']} at                      
x={t['x_at_transition']}")                                                      
                                                                                
