the samples. I'll also verify the total number of modes by comparing the        
derivative pairs in all identified segments.                                    
                                                                                
<code>                                                                          
import numpy as np                                                              
                                                                                
def analyze_sample(i):                                                          
    data = np.load(f'data_all/linear/two_tank/sample_{i}.npz')                  
    state = data['state']                                                       
    dx1 = np.diff(state[0])                                                     
    dx2 = np.diff(state[1])                                                     
                                                                                
    # Identify segments by looking for changes in dx1                           
    switches = np.where(np.abs(np.diff(dx1)) > 1e-9)[0] + 1                     
    segments = []                                                               
    start = 0                                                                   
    for s in switches:                                                          
        segments.append((start, s))                                             
        start = s                                                               
    segments.append((start, len(dx1)))                                          
                                                                                
    print(f"\nSample {i} Analysis:")                                            
    for start, end in segments:                                                 
        seg_dx1 = dx1[start:end]                                                
        seg_dx2 = dx2[start:end]                                                
        avg_dx1 = np.mean(seg_dx1)                                              
        std_dx1 = np.std(seg_dx1)                                               
        avg_dx2 = np.mean(seg_dx2)                                              
        std_dx2 = np.std(seg_dx2)                                               
        print(f"  Segment {start}-{end}:")                                      
        print(f"    dx1: {avg_dx1:.6f} (std: {std_dx1:.2e})")                   
        print(f"    dx2: {avg_dx2:.6f} (std: {std_dx2:.2e})")                   
        print(f"    Start State: x1={state[0, start]:.4f}, x2={state[1,         
start]:.4f}")                                                                   
        # end is the index of the first point of the next mode                  
        print(f"    Switch Point State (index {end}): x1={state[0, end]:.4f},   
x2={state[1, end]:.4f}")                                                        
                                                                                
for i in range(3):                                                              
    analyze_sample(i)                                                           
                                                                                
