# Let's check for resets more carefully                                         
def check_resets(sample_path):                                                  
    data = np.load(sample_path)                                                 
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
                                                                                
    transitions = []                                                            
    for i in range(1, len(dx1)):                                                
        if not (np.isclose(dx1[i], dx1[i-1], atol=1e-6) and np.isclose(dx2[i],  
dx2[i-1], atol=1e-6)):                                                          
            transitions.append(i)                                               
                                                                                
    print(f"\nResets check for {sample_path}:")                                 
    for trans_idx in transitions:                                               
        # State right before the transition (last point of old mode)            
        s_before = state[:, trans_idx]                                          
        # State at the start of the next step                                   
        s_after = state[:, trans_idx + 1]                                       
                                                                                
        # Calculate the jump                                                    
        jump = s_after - s_before                                               
        # In a discrete simulation, x[t+1] = x[t] + f(x[t])*dt                  
        # If there is a reset, x[t+1] = ResetFunction(x[t])                     
        # If there's no reset, x[t+1] - x[t] should be roughly the derivative.  
                                                                                
        # In Segment 0 (before transition), dx was roughly [0.008, -0.003]      
        # In Segment 1 (after transition), dx is roughly [-0.002, 0.007]        
        # The jump s_after - s_before is exactly what np.diff[trans_idx] gives. 
        # Let's look at the transition again.                                   
        print(f"  Transition at index {trans_idx}:")                            
        print(f"    s_before: {s_before}")                                      
        print(f"    s_after : {s_after}")                                       
        print(f"    Difference: {jump}")                                        
                                                                                
        # If the difference is roughly equal to the next segment's derivative,  
then there is probably NO reset.                                                
        # Or more accurately, if the state is continuous.                       
        # Let's see if the difference matches the NEW derivative.               
                                                                                
check_resets(DATA_FILE_PATHS[0])                                                
                                                                                
