    data = np.load(file_path)                                                   
    state = data['state']                                                       
    x1 = state[0, :]                                                            
    x2 = state[1, :]                                                            
    dx1 = np.diff(x1)                                                           
    dx2 = np.diff(x2)                                                           
    dx1_r = np.round(dx1, 6)                                                    
    dx2_r = np.round(dx2, 6)                                                    
                                                                                
    transitions = []                                                            
    for i in range(len(dx1_r) - 1):                                             
        if (dx1_r[i], dx2_r[i]) != (dx1_r[i+1], dx2_r[i+1]):                    
            transitions.append({                                                
                'from': (dx1_r[i], dx2_r[i]),                                   
                'to': (dx1_r[i+1], dx2_r[i+1]),                                 
                'x1': x1[i+1],                                                  
                'x2': x2[i+1],                                                  
                'idx': i+1                                                      
            })                                                                  
    return transitions                                                          
                                                                                
