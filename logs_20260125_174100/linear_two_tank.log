import numpy as np                                                              
                                                                                
files = ['data_all/linear/two_tank/sample_0.npz',                               
'data_all/linear/two_tank/sample_1.npz',                                        
'data_all/linear/two_tank/sample_2.npz']                                        
                                                                                
for i, file_path in enumerate(files):                                           
    data = np.load(file_path)                                                   
    state = data['state']                                                       
                                                                                
    # Calculate differences between consecutive states                          
    diffs = np.diff(state, axis=1)                                              
                                                                                
    # Find indices where the mode changes.                                      
    # A change in mode should result in a change in the derivative.             
    # Let's look at the differences in derivatives.                             
    # We use a threshold to detect "significant" changes.                       
    d_diffs = np.diff(diffs, axis=1)                                            
    # Norm of the change in derivative                                          
    change_magnitude = np.linalg.norm(d_diffs, axis=0)                          
                                                                                
    # Identify indices where change_magnitude is high.                          
    # Since it's linear segments, the second derivative should be mostly zero   
except at transitions.                                                          
    transition_indices = np.where(change_magnitude > 1e-6)[0] + 1 # +1 because  
of diff                                                                         
                                                                                
    # Filter transitions to avoid multiple detections for the same event        
    if len(transition_indices) > 0:                                             
        filtered_transitions = [transition_indices[0]]                          
        for idx in transition_indices[1:]:                                      
            if idx > filtered_transitions[-1] + 5:                              
                filtered_transitions.append(idx)                                
    else:                                                                       
        filtered_transitions = []                                               
                                                                                
    print(f"--- Sample {i} Analysis ---")                                       
    print(f"Initial State: x1={state[0, 0]:.4f}, x2={state[1, 0]:.4f}")         
                                                                                
    # Intervals                                                                 
    intervals = [0] + filtered_transitions + [state.shape[1] - 1]               
                                                                                
    for j in range(len(intervals) - 1):                                         
        start = intervals[j]                                                    
        end = intervals[j+1]                                                    
                                                                                
        # Calculate average derivatives in this interval                        
        # Note: We don't know dt yet, but we can report change per step         
(delta_x)                                                                       
        # Assuming dt = 1 for now or just reporting the slope in steps.         
        # Looking at Sample 0: dx1 = 0.008, dx2 = -0.003                        
        avg_dx1 = np.mean(diffs[0, start:end])                                  
        avg_dx2 = np.mean(diffs[1, start:end])                                  
                                                                                
        print(f"Mode {j+1} (Steps {start} to {end}):")                          
        print(f"  Avg Delta x1: {avg_dx1:.6f}, Avg Delta x2: {avg_dx2:.6f}")    
                                                                                
        if j < len(intervals) - 2:                                              
            trans_idx = intervals[j+1]                                          
            # State at transition                                               
            s_at_trans = state[:, trans_idx]                                    
            # Check for jump: compare state[trans_idx] with state[trans_idx-1]  
            jump = state[:, trans_idx] - state[:, trans_idx-1]                  
            # If the transition is purely a change in slope, the state should be
continuous.                                                                     
            # However, np.diff used for transition detection might point to the 
last point of old mode                                                          
            # or first of new mode.                                             
            print(f"  Transition to Mode {j+2} at step {trans_idx}:")           
            print(f"    State at transition: x1={s_at_trans[0]:.4f},            
x2={s_at_trans[1]:.4f}")                                                        
            print(f"    State Jump: dx1={jump[0]:.6f}, dx2={jump[1]:.6f} (Likely
{'Reset' if np.linalg.norm(jump) > 0.01 else 'Continuous'})")                   
                                                                                
    print("\n")                                                                 
                                                                                
