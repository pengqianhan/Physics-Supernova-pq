        elif current_mode == 'Rising':                                          
            rising_data.append([x1, x2, u1, dx1, dx2])                          
            if x2 >= 1.0:                                                       
                current_mode = 'Falling'                                        
                                                                                
def fit_model(data):                                                            
    if not data: return None                                                    
    data = np.array(data)                                                       
    # Falling/Rising dx1 = a*x1 + b*u1 + c                                      
    X1 = data[:, [0, 2]] # x1, u1                                               
