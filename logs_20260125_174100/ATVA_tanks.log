# Mode 2 has a distinct dx1 constant (+3 vs -2)                                 
df['mode_guess'] = 0                                                            
df.loc[val_m123 > 0.5, 'mode_guess'] = 2                                        
                                                                                
# To distinguish 1 and 3: check dx2 - x1 - u1                                   
# Mode 1: dx2 - x1 - u1 approx 0                                                
# Mode 3: dx2 - x1 - u1 approx -x2 - 5                                          
