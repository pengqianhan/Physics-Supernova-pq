    if not mode_segs: continue                                                  
                                                                                
    X1 = np.concatenate([s['x1'] for s in mode_segs])                           
    X2 = np.concatenate([s['x2'] for s in mode_segs])                           
    U1 = np.concatenate([s['u1'] for s in mode_segs])                           
    DX1 = np.concatenate([s['dx1'] for s in mode_segs])                         
    DX2 = np.concatenate([s['dx2'] for s in mode_segs])                         
                                                                                
    # Design matrix: [x1, x2, u1, 1]                                            
    M = np.vstack([X1, X2, U1, np.ones_like(X1)]).T                             
                                                                                
    coeff1, residuals1, rank1, s1 = np.linalg.lstsq(M, DX1, rcond=None)         
    coeff2, residuals2, rank2, s2 = np.linalg.lstsq(M, DX2, rcond=None)         
                                                                                
    results[mode] = {                                                           
