def get_mode_data(paths, dt=0.001):                                             
    mode_data = {0: [], 1: [], 2: []}                                           
    for p in paths:                                                             
        data = np.load(p)                                                       
        x1, x2, u = data['state'][0], data['state'][1], data['input'][0]        
                                                                                
        # Determine mode at each step                                           
        modes = np.zeros_like(x1, dtype=int)                                    
        current_mode = 0                                                        
        for i in range(len(x1)):                                                
            if x1[i] <= -1.0:                                                   
                current_mode = 2                                                
            elif x2[i] >= 1.0:                                                  
                current_mode = 1                                                
            modes[i] = current_mode                                             
                                                                                
        # Segment and collect                                                   
        start = 0                                                               
        for i in range(1, len(modes)):                                          
            if modes[i] != modes[i-1]:                                          
                m = modes[i-1]                                                  
                if i - start > 5:                                               
                    mode_data[m].append((x1[start:i], x2[start:i], u[start:i])) 
                start = i                                                       
        m = modes[-1]                                                           
        if len(modes) - start > 5:                                              
            mode_data[m].append((x1[start:], x2[start:], u[start:]))            
                                                                                
    return mode_data                                                            
                                                                                
