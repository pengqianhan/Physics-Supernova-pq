    s = data['state']                                                           
    u = data['input']                                                           
    x = s[:, :-1]                                                               
    u_in = u[:, :-1]                                                            
    dx = np.diff(s, axis=1)                                                     
    return x, u_in, dx                                                          
                                                                                
