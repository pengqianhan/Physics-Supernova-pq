ts1 = t[idx_ts1]                                                                
x1_min = x1[idx_ts1]                                                            
                                                                                
# 2. Find tr1: x2 resets from ~1.0 to ~0.0                                      
# Look for the first reset (large jump down) after ts1                          
diff_x2 = np.diff(x2)                                                           
