def estimate_segment_dynamics(x1, x2, u, start, end, dt=0.001):                 
    X = np.vstack([x1[start:end-1], x2[start:end-1]])                           
    U = u[start:end-1]                                                          
    Y1 = (x1[start+1:end] - x1[start:end-1]) / dt                               
    Y2 = (x2[start+1:end] - x2[start:end-1]) / dt                               
                                                                                
    M = np.column_stack([X[0], X[1], U, np.ones_like(X[0])])                    
    p1, _, _, _ = np.linalg.lstsq(M, Y1, rcond=None)                            
    p2, _, _, _ = np.linalg.lstsq(M, Y2, rcond=None)                            
    return p1, p2                                                               
                                                                                
