    state = all_states[i]                                                       
    input_val = all_inputs[i]                                                   
    # x1[k], x2[k], u1[k]                                                       
    X_list.append(np.vstack([state[0, :-1], state[1, :-1], input_val[0,         
:-1]]).T)                                                                       
    # x1[k+1], x2[k+1]                                                          
    Y_list.append(state[:, 1:].T)                                               
                                                                                
X = np.vstack(X_list)                                                           
