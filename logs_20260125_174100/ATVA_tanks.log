import numpy as np                                                              
                                                                                
def analyze_file(i):                                                            
    data = np.load(DATA_FILE_PATHS[i])                                          
    x1 = data['state'][0, :]                                                    
    x2 = data['state'][1, :]                                                    
    u1 = data['input'][0, :]                                                    
                                                                                
    # Calculate difference                                                      
    dx2 = np.diff(x2)                                                           
    # Mode could be defined by sign of dx2                                      
    # But since it's a discrete system, let's look at the segments              
                                                                                
    # Let's find where dx2 changes sign significantly                           
    # Or where it crosses 1.0 or 0.0                                            
                                                                                
    modes = []                                                                  
    current_mode_start = 0                                                      
                                                                                
    for k in range(1, len(x2) - 1):                                             
        # Potential mode switches:                                              
        # 1. x2 reaches 1.0 (it peaks and starts decreasing)                    
        # 2. x2 reaches 0.0                                                     
        # 3. x1 reaches 3.0 or -1.0                                             
                                                                                
        switched = False                                                        
        # Detection of peak at 1.0                                              
        if x2[k] >= 1.0 and x2[k-1] < 1.0: switched = True                      
        if x2[k] <= 1.0 and x2[k-1] > 1.0: switched = True                      
                                                                                
        # Crossing 0.0                                                          
        if x2[k] * x2[k-1] <= 0: switched = True                                
                                                                                
        # x1 crossing 3.0                                                       
        if (x1[k] - 3.0) * (x1[k-1] - 3.0) <= 0: switched = True                
                                                                                
        # x1 crossing -1.0                                                      
        if (x1[k] + 1.0) * (x1[k-1] + 1.0) <= 0: switched = True                
                                                                                
        if switched:                                                            
            modes.append((current_mode_start, k))                               
            current_mode_start = k                                              
    modes.append((current_mode_start, len(x2)-1))                               
                                                                                
    return modes, x1, x2, u1                                                    
                                                                                
# Analyze File 0                                                                
