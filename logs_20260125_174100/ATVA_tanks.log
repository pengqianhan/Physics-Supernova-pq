# Define a function to find segments and estimate dynamics                      
def analyze_trajectories(data_paths):                                           
    all_segments = []                                                           
                                                                                
    for path in data_paths:                                                     
        data = np.load(path)                                                    
        t = data['t'].flatten()                                                 
        states = data['states']                                                 
        inputs = data['inputs']                                                 
                                                                                
        x1 = states[:, 0]                                                       
        x2 = states[:, 1]                                                       
        u1 = inputs.flatten()                                                   
