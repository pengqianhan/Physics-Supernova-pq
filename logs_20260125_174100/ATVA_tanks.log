# Let's pool data from all files based on these conditions:                     
# Mode A: x1 > -0.998 and x2 < 0.985                                            
# Mode B: x1 <= -0.998                                                          
# Mode C: x2 >= 0.985                                                           
                                                                                
def classify_and_fit(data_list):                                                
    X_A, Y_A = [], []                                                           
    X_B, Y_B = [], []                                                           
    X_C, Y_C = [], []                                                           
                                                                                
    for states, inputs in data_list:                                            
        x1, x2, u1 = states[0, :], states[1, :], inputs[0, :]                   
        for k in range(len(x1)-1):                                              
            feat = [x1[k], x2[k], u1[k], 1.0]                                   
            target = [x1[k+1], x2[k+1]]                                         
                                                                                
            # Order of checks might matter. Let's try:                          
            if x1[k] <= -0.997: # Mode B                                        
                X_B.append(feat)                                                
                Y_B.append(target)                                              
            elif x2[k] >= 0.985: # Mode C                                       
                X_C.append(feat)                                                
                Y_C.append(target)                                              
            else: # Mode A                                                      
                X_A.append(feat)                                                
                Y_A.append(target)                                              
                                                                                
    def solve(X, Y):                                                            
        return np.linalg.lstsq(np.array(X), np.array(Y), rcond=None)[0]         
                                                                                
    return solve(X_A, Y_A), solve(X_B, Y_B), solve(X_C, Y_C)                    
                                                                                
cA, cB, cC = classify_and_fit(datasets)                                         
