  # For threshold identification                                                
  trans_x1_to_2 = []                                                            
  trans_x2_to_3 = []                                                            
  trans_x2_to_1 = []                                                            
                                                                                
  dt = 0.001                                                                    
                                                                                
  for path in DATA_FILE_PATHS:                                                  
      data = np.load(path)                                                      
      s = data['state']                                                         
      u = data['input']                                                         
                                                                                
      x1 = s[:, 0]                                                              
      x2 = s[:, 1]                                                              
      u1 = u[:, 0]                                                              
                                                                                
      dx1 = np.diff(x1) / dt                                                    
      dx2 = np.diff(x2) / dt                                                    
                                                                                
      # State machine for this trajectory                                       
      n_pts = len(dx1)                                                          
      modes = np.zeros(n_pts, dtype=int)                                        
      current_mode = 1                                                          
                                                                                
      # Check start condition? Assume Mode 1                                    
      for i in range(n_pts):                                                    
          prev_mode = current_mode                                              
                                                                                
          # Check transitions logic                                             
          if current_mode == 1:                                                 
              if x1[i] <= -1.0: current_mode = 2                                
              elif x2[i] >= 1.0: current_mode = 3                               
          elif current_mode == 2:                                               
              if x2[i] >= 1.0: current_mode = 3                                 
          elif current_mode == 3:                                               
              if x2[i] <= 0.0: current_mode = 1                                 
              elif x1[i] <= -1.0: current_mode = 2                              
                                                                                
          modes[i] = current_mode                                               
                                                                                
          # Track transition points                                             
          if prev_mode != current_mode:                                         
              if current_mode == 2: trans_x1_to_2.append(x1[i])                 
              if current_mode == 3: trans_x2_to_3.append(x2[i])                 
              if current_mode == 1: trans_x2_to_1.append(x2[i])                 
                                                                                
      all_x1_dot.append(dx1)                                                    
      all_x2_dot.append(dx2)                                                    
      all_x1.append(x1[:-1])                                                    
      all_x2.append(x2[:-1])                                                    
      all_u1.append(u1[:-1])                                                    
      all_modes.append(modes)                                                   
                                                                                
  # Flatten                                                                     
  X1_dot = np.concatenate(all_x1_dot)                                           
  X2_dot = np.concatenate(all_x2_dot)                                           
  X1 = np.concatenate(all_x1)                                                   
  X2 = np.concatenate(all_x2)                                                   
  U1 = np.concatenate(all_u1)                                                   
  Modes = np.concatenate(all_modes)                                             
                                                                                
