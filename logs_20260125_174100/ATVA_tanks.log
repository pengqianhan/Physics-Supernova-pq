x2 = state[1, :]                                                                
u1 = inputs[0, :]                                                               
                                                                                
# Compute differences                                                           
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
                                                                                
# Compute second differences to find discontinuities in derivatives             
ddx1 = np.diff(dx1)                                                             
ddx2 = np.diff(dx2)                                                             
                                                                                
# Check for resets (large jumps in x)                                           
jumps_x1 = np.where(np.abs(dx1) > 0.5)[0]                                       
jumps_x2 = np.where(np.abs(dx2) > 0.5)[0]                                       
                                                                                
# Check for mode transitions (large jumps in dx)                                
trans_x1 = np.where(np.abs(ddx1) > 0.01)[0]                                     
trans_x2 = np.where(np.abs(ddx2) > 0.01)[0]                                     
                                                                                
print(f"Jumps in x1: {jumps_x1}")                                               
print(f"Jumps in x2: {jumps_x2}")                                               
print(f"Transitions in dx1: {trans_x1}")                                        
print(f"Transitions in dx2: {trans_x2}")                                        
                                                                                
# Let's inspect the state values at transitions to find guard conditions        
if len(trans_x1) > 0:                                                           
    print(f"x1 at transitions: {x1[trans_x1]}")                                 
    print(f"x2 at transitions: {x2[trans_x1]}")                                 
                                                                                
