import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def fit_linear_model(X, Y, U):                                                  
    """                                                                         
    Fits x[k+1] = A*x[k] + B*u[k] + C                                           
    X: state at k (2, N)                                                        
    Y: state at k+1 (2, N)                                                      
    U: input at k (1, N)                                                        
    """                                                                         
    # Construct Design Matrix [x1, x2, u, 1]                                    
    N = X.shape[1]                                                              
    A_mat = np.vstack([X, U, np.ones(N)]).T                                     
    # Solve for each dimension of Y                                             
    params_x1, _, _, _ = np.linalg.lstsq(A_mat, Y[0], rcond=None)               
    params_x2, _, _, _ = np.linalg.lstsq(A_mat, Y[1], rcond=None)               
    return params_x1, params_x2                                                 
                                                                                
