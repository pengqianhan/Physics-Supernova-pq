def solve_with_r2(X, Y):                                                        
    c, resid, rank, s = np.linalg.lstsq(X, Y, rcond=None)                       
    y_pred = X @ c                                                              
    ss_res = np.sum((Y - y_pred)**2)                                            
    ss_tot = np.sum((Y - np.mean(Y))**2)                                        
    r2 = 1 - (ss_res / ss_tot)                                                  
    return c, r2                                                                
                                                                                
