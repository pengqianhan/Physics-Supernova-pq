    all_states.append(d['state'])                                               
    all_inputs.append(d['input'])                                               
                                                                                
# We need to find transitions. Let's look at the derivatives of the state.      
# Since it's a discrete time system x[k+1] = f(x[k], u[k]), let's calculate the 
difference.                                                                     
# Also, look for discontinuities (resets).                                      
                                                                                
def analyze_trajectory(s, u):                                                   
    x1 = s[0, :]                                                                
    x2 = s[1, :]                                                                
    u1 = u[0, :]                                                                
                                                                                
    dx1 = x1[1:] - x1[:-1]                                                      
    dx2 = x2[1:] - x2[:-1]                                                      
                                                                                
    return x1, x2, u1, dx1, dx2                                                 
                                                                                
# Combine all trajectories to find general behavior                             
total_x1 = []                                                                   
total_x2 = []                                                                   
total_u1 = []                                                                   
total_nx1 = [] # x1 at next step                                                
total_nx2 = [] # x2 at next step                                                
                                                                                
for i in range(len(all_states)):                                                
    s = all_states[i]                                                           
    u = all_inputs[i]                                                           
    total_x1.extend(s[0, :-1])                                                  
    total_x2.extend(s[1, :-1])                                                  
    total_u1.extend(u[0, :-1])                                                  
    total_nx1.extend(s[0, 1:])                                                  
    total_nx2.extend(s[1, 1:])                                                  
                                                                                
total_x1 = np.array(total_x1)                                                   
total_x2 = np.array(total_x2)                                                   
total_u1 = np.array(total_u1)                                                   
total_nx1 = np.array(total_nx1)                                                 
total_nx2 = np.array(total_nx2)                                                 
                                                                                
# Find discontinuities by looking at large jumps                                
# Let's check the jumps in the original trajectories                            
for i in range(len(all_states)):                                                
    s = all_states[i]                                                           
    dx1 = np.abs(np.diff(s[0, :]))                                              
    dx2 = np.abs(np.diff(s[1, :]))                                              
    jump_indices = np.where((dx1 > 0.5) | (dx2 > 0.5))[0]                       
    if len(jump_indices) > 0:                                                   
        print(f"Trajectory {i} has jumps at indices: {jump_indices}")           
        for idx in jump_indices:                                                
            print(f"  Jump at {idx}: x1 {s[0, idx]} -> {s[0, idx+1]}, x2 {s[1,  
idx]} -> {s[1, idx+1]}")                                                        
                                                                                
# Identify modes. The prompt suggests x1 approx -1.0 or x2 approx 1.0 as        
thresholds.                                                                     
# Let's see how many modes we have based on these conditions.                   
# Mode A: x1 < -1.0                                                             
# Mode B: x1 >= -1.0 and x2 < 1.0                                               
# Mode C: x1 >= -1.0 and x2 >= 1.0                                              
# Let's test this.                                                              
                                                                                
def get_mode(x1, x2):                                                           
    if x1 < -1.0:                                                               
        return 0                                                                
    elif x2 < 1.0:                                                              
        return 1                                                                
    else:                                                                       
        return 2                                                                
                                                                                
modes = np.array([get_mode(x1, x2) for x1, x2 in zip(total_x1, total_x2)])      
                                                                                
def fit_mode(mask):                                                             
    X = np.column_stack([total_x1[mask], total_x2[mask], total_u1[mask],        
