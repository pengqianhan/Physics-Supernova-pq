│             }                                                                │
│         ],                                                                   │
│         "edge": [                                                            │
│             {                                                                │
│                 "direction": "1 -> 2",                                       │
│                 "condition": "x1 >= 4"                                       │
│             },                                                               │
│             {                                                                │
│                 "direction": "2 -> 1",                                       │
│                 "condition": "x1 <= 9"                                       │
│             }                                                                │
│         \]                                                                   │
│     },                                                                       │
│     "config": {                                                              │
│         "dt": 0.01,                                                          │
