# But keep track of discontinuities between trajectories                        
segments = []                                                                   
for x, u in zip(x_list, u_list):                                                
    # x is (N, 2), u is (N, 1)                                                  
    N = len(x)                                                                  
    current_segment_start = 0                                                   
    for i in range(N - 1):                                                      
        # Detect x2 reset                                                       
        reset_x2 = (x[i, 1] > 0.8 and x[i+1, 1] < 0.2)                          
        # Detect x1 mode switch (crossing -1.0)                                 
        switch_x1 = (x[i, 0] > -1.0 and x[i+1, 0] <= -1.0) or (x[i, 0] <= -1.0  
and x[i+1, 0] > -1.0)                                                           
                                                                                
