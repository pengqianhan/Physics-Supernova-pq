import numpy as np                                                              
                                                                                
def solve():                                                                    
    dt = 0.001                                                                  
    all_A = []                                                                  
    all_B = []                                                                  
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x = data['state']                                                       
        u = data['input']                                                       
                                                                                
        idx_A_end = np.where(x[0] <= -1.0)[0][0]                                
        idx_B_start = idx_A_end                                                 
        idx_B_end_cands = np.where(x[1, idx_B_start:] >= 1.0)[0]                
        if len(idx_B_end_cands) > 0:                                            
            idx_B_end = idx_B_start + idx_B_end_cands[0]                        
        else:                                                                   
            idx_B_end = x.shape[1] - 1                                          
                                                                                
        dx = np.gradient(x, dt, axis=1)                                         
                                                                                
        def fit(idx):                                                           
            res = []                                                            
            for i in range(2):                                                  
                Y = dx[i, idx]                                                  
                X = np.vstack([x[0, idx], x[1, idx], u[0, idx],                 
np.ones(len(idx))]).T                                                           
                c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                  
                res.extend(c)                                                   
            return np.array(res)                                                
                                                                                
        all_A.append(fit(np.arange(0, idx_A_end)))                              
        all_B.append(fit(np.arange(idx_A_end + 1, idx_B_end)))                  
                                                                                
    print("Avg A:", np.mean(all_A, axis=0))                                     
    print("Avg B:", np.mean(all_B, axis=0))                                     
                                                                                
solve()                                                                         
                                                                                
