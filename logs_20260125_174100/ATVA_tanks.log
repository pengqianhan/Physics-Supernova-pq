import numpy as np                                                              
                                                                                
def identify_modes(state):                                                      
    # state is (2, N)                                                           
    x1 = state[0]                                                               
    x2 = state[1]                                                               
    dx1 = np.diff(x1)                                                           
                                                                                
    modes = np.zeros(len(dx1))                                                  
    # Mode 1: x1 decreasing                                                     
    modes[dx1 < 0] = 1                                                          
    # Mode 2: x1 increasing                                                     
    modes[dx1 > 0] = 2                                                          
                                                                                
    return modes                                                                
                                                                                
def get_clean_data(file_paths, dt=0.1):                                         
    m1_data = []                                                                
    m2_data = []                                                                
                                                                                
    for fp in file_paths:                                                       
        data = np.load(fp)                                                      
        x = data['state'].T                                                     
        u = data['input'].T                                                     
        n = x.shape[0]                                                          
                                                                                
        dx = np.diff(x, axis=0) / dt                                            
        modes = identify_modes(data['state'])                                   
                                                                                
        # Reset detection                                                       
        reset = np.abs(np.diff(x[:, 1])) > 0.5                                  
                                                                                
        for i in range(n - 1):                                                  
            if reset[i]: continue                                               
                                                                                
            feat = [x[i, 0], x[i, 1], u[i, 0], 1.0]                             
            if modes[i] == 1:                                                   
                m1_data.append((feat, dx[i]))                                   
            elif modes[i] == 2:                                                 
                m2_data.append((feat, dx[i]))                                   
                                                                                
    return m1_data, m2_data                                                     
                                                                                
m1_data, m2_data = get_clean_data(file_paths)                                   
                                                                                
def solve(data):                                                                
    X = np.array([d[0] for d in data])                                          
    Y1 = np.array([d[1][0] for d in data])                                      
    Y2 = np.array([d[1][1] for d in data])                                      
                                                                                
    c1, _, _, _ = np.linalg.lstsq(X, Y1, rcond=None)                            
    c2, _, _, _ = np.linalg.lstsq(X, Y2, rcond=None)                            
    return c1, c2                                                               
                                                                                
