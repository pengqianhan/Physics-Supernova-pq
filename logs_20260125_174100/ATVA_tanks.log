def get_clean_segments(data_list):                                              
    all_mode_segs = {1: [], 2: [], 3: []}                                       
    for i, (states, inputs) in enumerate(data_list):                            
        x1, x2, u1 = states[0, :], states[1, :], inputs[0, :]                   
                                                                                
        errors = []                                                             
        window_size = 10                                                        
        for j in range(len(x1) - window_size - 1):                              
            X_win = np.column_stack([x1[j:j+window_size], x2[j:j+window_size],  
u1[j:j+window_size], np.ones(window_size)])                                     
            Y_win = np.column_stack([x1[j+1:j+window_size+1],                   
x2[j+1:j+window_size+1]])                                                       
            _, res, _, _ = np.linalg.lstsq(X_win, Y_win, rcond=None)            
            errors.append(np.sum(res))                                          
                                                                                
        sw = [0] + get_clean_switches(errors, 1e-10, window_size) + [len(x1)]   
                                                                                
        for j in range(len(sw)-1):                                              
            start, end = sw[j], sw[j+1]                                         
            if end - start < 10: continue                                       
                                                                                
            # Identify mode based on end condition or sequence                  
            # M1: ends at x1 approx -1                                          
            # M2: ends at x2 approx 1                                           
            # M3: ends at x2 approx 0                                           
                                                                                
            last_x1 = x1[end-1]                                                 
            last_x2 = x2[end-1]                                                 
                                                                                
            mode = 0                                                            
            if last_x1 <= -0.99: mode = 1                                       
            elif last_x2 >= 0.98: mode = 2                                      
            elif last_x2 <= 0.03: mode = 3                                      
                                                                                
            if mode != 0:                                                       
                all_mode_segs[mode].append((x1[start:end-1], x2[start:end-1],   
u1[start:end-1], x1[start+1:end], x2[start+1:end]))                             
                                                                                
    return all_mode_segs                                                        
                                                                                
mode_data = get_clean_segments(datasets)                                        
                                                                                
def fit_pooled_v2(data_list):                                                   
    X = []                                                                      
    Y = []                                                                      
    for x1_in, x2_in, u1_in, x1_out, x2_out in data_list:                       
        X.append(np.column_stack([x1_in, x2_in, u1_in, np.ones_like(x1_in)]))   
        Y.append(np.column_stack([x1_out, x2_out]))                             
    X = np.concatenate(X)                                                       
    Y = np.concatenate(Y)                                                       
    coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                         
    return coeffs                                                               
                                                                                
