from scipy.stats import linregress                                              
                                                                                
# Load the primary data file                                                    
data = np.load(DATA_FILE_PATH)                                                  
print("Keys in the data file:", list(data.keys()))                              
                                                                                
# Extract variables (assuming common naming conventions for these datasets)     
t = data['t']                                                                   
x = data['x']  # Assuming x is a 2D array [N, 2]                                
u = data['u']  # Assuming u is a 1D or 2D array [N, 1]                          
                                                                                
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
u1 = u.flatten()                                                                
                                                                                
print(f"Shapes: t={t.shape}, x1={x1.shape}, x2={x2.shape}, u1={u1.shape}")      
                                                                                
# Detect switch points and resets                                               
# x1 switch points (around -1)                                                  
# x2 resets (around 1.0)                                                        
# A switch/reset point is where the derivative is very large or there's a jump. 
# However, usually resets are sudden changes in values.                         
                                                                                
# Let's find indices where x1 crosses -1 or x2 jumps to/from ~1.0               
switches = []                                                                   
for i in range(1, len(t)):                                                      
    # Simple jump detection for resets or crossings                             
    if (x1[i-1] < -1 and x1[i] >= -1) or (x1[i-1] > -1 and x1[i] <= -1):        
        switches.append(i)                                                      
    elif abs(x2[i] - x2[i-1]) > 0.5: # Sudden jump in x2                        
        switches.append(i)                                                      
                                                                                
