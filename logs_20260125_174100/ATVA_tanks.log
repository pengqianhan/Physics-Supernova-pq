import numpy as np                                                              
                                                                                
def fit_segment(seg_X, seg_Y1, seg_Y2):                                         
    beta1, res1, rank1, s1 = np.linalg.lstsq(seg_X, seg_Y1, rcond=None)         
    beta2, res2, rank2, s2 = np.linalg.lstsq(seg_X, seg_Y2, rcond=None)         
    return beta1, beta2, res1, res2                                             
                                                                                
all_segments = []                                                               
                                                                                
for i in range(len(all_states)):                                                
    state = all_states[i]                                                       
    u = all_inputs[i]                                                           
    trans = np.concatenate([[0], transitions[i], [state.shape[1]]])             
    trans = np.unique(trans)                                                    
                                                                                
    for start, end in zip(trans[:-1], trans[1:]):                               
        if end - start > 5: # need enough points to fit                         
            x1_k = state[0, start:end-1]                                        
            x2_k = state[1, start:end-1]                                        
            u1_k = u[0, start:end-1]                                            
            x1_next = state[0, start+1:end]                                     
            x2_next = state[1, start+1:end]                                     
                                                                                
            seg_X = np.column_stack([x1_k, x2_k, u1_k, np.ones_like(x1_k)])     
            beta1, beta2, res1, res2 = fit_segment(seg_X, x1_next, x2_next)     
                                                                                
            # Store segment info                                                
            all_segments.append({                                               
                'file': i,                                                      
                'start': start,                                                 
                'end': end,                                                     
                'beta1': beta1,                                                 
                'beta2': beta2,                                                 
                'mean_x1': np.mean(x1_k),                                       
                'mean_x2': np.mean(x2_k),                                       
                'first_x1': x1_k[0],                                            
                'first_x2': x2_k[0],                                            
                'last_x1': x1_k[-1],                                            
                'last_x2': x2_k[-1]                                             
