import numpy as np                                                              
                                                                                
# Load the data                                                                 
data = np.load('data_all/ATVA/tanks/sample_0.npz')                              
x = data['state'] # shape (2, 10001)                                            
u = data['input'] # shape (1, 10001)                                            
                                                                                
x1 = x[0, :]                                                                    
x2 = x[1, :]                                                                    
u1 = u[0, :]                                                                    
                                                                                
# Assume dt = 0.001 (standard for 10001 samples over 10s)                       
dt = 0.001                                                                      
t = np.linspace(0, 10, 10001)                                                   
                                                                                
# Compute central differences for derivatives                                   
# For interior points: (x[i+1] - x[i-1]) / (2*dt)                               
dx1 = np.zeros_like(x1)                                                         
dx2 = np.zeros_like(x2)                                                         
dx1[1:-1] = (x1[2:] - x1[:-2]) / (2*dt)                                         
dx2[1:-1] = (x2[2:] - x2[:-2]) / (2*dt)                                         
                                                                                
# Use forward/backward for endpoints                                            
dx1[0] = (x1[1] - x1[0]) / dt                                                   
dx1[-1] = (x1[-1] - x1[-2]) / dt                                                
dx2[0] = (x2[1] - x2[0]) / dt                                                   
dx2[-1] = (x2[-1] - x2[-2]) / dt                                                
                                                                                
# Look for mode changes. A simple way is to look for a jump in the residual of a
linear fit.                                                                     
# Or just look at the plot of x1. In many tank problems, transitions happen at a
height threshold.                                                               
print(f"x1 range: {np.min(x1)} to {np.max(x1)}")                                
print(f"x2 range: {np.min(x2)} to {np.max(x2)}")                                
                                                                                
# Let's try to detect the transition by looking at where dx/dt changes abruptly 
# relative to the state.                                                        
# We'll check the error of a global linear model.                               
A_stack = np.column_stack([x1, x2, u1, np.ones_like(x1)])                       
params1, residuals1, _, _ = np.linalg.lstsq(A_stack, dx1, rcond=None)           
params2, residuals2, _, _ = np.linalg.lstsq(A_stack, dx2, rcond=None)           
                                                                                
# Calculate error over time                                                     
err1 = np.abs(dx1 - A_stack @ params1)                                          
err2 = np.abs(dx2 - A_stack @ params2)                                          
                                                                                
# Find indices where error is large                                             
threshold = 0.1                                                                 
change_indices = np.where(err1 > threshold)[0]                                  
if len(change_indices) > 0:                                                     
    print(f"Potential transition indices in dx1: {change_indices[0]},           
{change_indices[-1]}")                                                          
                                                                                
change_indices_2 = np.where(err2 > threshold)[0]                                
if len(change_indices_2) > 0:                                                   
    print(f"Potential transition indices in dx2: {change_indices_2[0]},         
{change_indices_2[-1]}")                                                        
                                                                                
# Let's just print some values to find where it changes                         
# Looking for a sharp change in dx1 or dx2                                      
diff_dx1 = np.abs(np.diff(dx1))                                                 
max_diff_idx = np.argmax(diff_dx1)                                              
print(f"Max change in dx1 at index {max_diff_idx}, time {t[max_diff_idx]}, x1   
{x1[max_diff_idx]}")                                                            
                                                                                
