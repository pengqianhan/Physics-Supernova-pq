def process_data(file_paths, dt=0.1):                                           
    m1_X, m1_Y1, m1_Y2 = [], [], []                                             
    m2_X, m2_Y1, m2_Y2 = [], [], []                                             
                                                                                
    for file_path in file_paths:                                                
