print(f"x2 range: {all_data[:, 1].min()} to {all_data[:, 1].max()}")            
                                                                                
# Helper to identify mode                                                       
def get_mode(x):                                                                
    x1, x2 = x                                                                  
    if x1 <= -1.0:                                                              
        return 2                                                                
    elif x2 >= 1.0:                                                             
        return 3                                                                
    else:                                                                       
        return 1                                                                
                                                                                
# Analyze transitions and dynamics                                              
# We'll calculate dx = x[t+1] - x[t]                                            
# We'll group (x[t], dx[t]) by mode of x[t]                                     
                                                                                
mode_data = {1: [], 2: [], 3: []}                                               
resets = []                                                                     
                                                                                
for traj in trajectories:                                                       
    for i in range(len(traj) - 1):                                              
        curr_x = traj[i]                                                        
        next_x = traj[i+1]                                                      
        m_curr = get_mode(curr_x)                                               
        m_next = get_mode(next_x)                                               
                                                                                
        if m_curr == m_next:                                                    
            mode_data[m_curr].append((curr_x, next_x - curr_x))                 
        else:                                                                   
            # Possible transition                                               
            resets.append((m_curr, m_next, curr_x, next_x))                     
                                                                                
# Print counts                                                                  
for m in [1, 2, 3]:                                                             
    print(f"Mode {m} data points: {len(mode_data[m])}")                         
                                                                                
# For each mode, fit dx = A*x + b                                               
# We want to find A_tilde and b_tilde such that dx = A_tilde * x + b_tilde      
# where A_tilde = A * dt and b_tilde = b * dt.                                  
# Usually dt is small, so we can try to guess it or just provide the rate.      
# Let's assume dt = 0.01 for now or just solve for the coefficients.            
                                                                                
for m in [1, 2, 3]:                                                             
