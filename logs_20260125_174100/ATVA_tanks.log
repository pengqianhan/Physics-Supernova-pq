segments_m1_x1 = []                                                             
segments_m1_x2 = []                                                             
segments_m2_feat = []                                                           
segments_m2_x1 = []                                                             
segments_m2_x2 = []                                                             
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    s = data['state']                                                           
    u = data['input']                                                           
                                                                                
    x2_vals = s[1, :]                                                           
    # Find the first index where x2 >= 1.0                                      
    hit_idx = np.where(x2_vals >= 1.0)[0]                                       
    if len(hit_idx) > 0:                                                        
        split_idx = hit_idx[0]                                                  
                                                                                
        # Mode 1: 0 to split_idx - 1                                            
        # (The update from split_idx-1 to split_idx is still Mode 1)            
        m1_s = s[:, :split_idx+1]                                               
        m1_u = u[:, :split_idx+1]                                               
                                                                                
        m1_feat = np.vstack([m1_s[0, :-1], m1_s[1, :-1], m1_u[0, :-1],          
np.ones(split_idx)]).T                                                          
        segments_m1_feat.append(m1_feat)                                        
        segments_m1_x1.append(m1_s[0, 1:])                                      
        segments_m1_x2.append(m1_s[1, 1:])                                      
                                                                                
        # Mode 2: split_idx to end                                              
        m2_s = s[:, split_idx:]                                                 
