        x1, x2 = state[0], state[1]                                             
        u1 = u[0]                                                               
                                                                                
        # 1. Segments                                                           
        idx_A_end = np.where(x1 <= -1.0)[0][0]                                  
        segA = np.arange(0, idx_A_end + 1)                                      
                                                                                
        idx_B_start = idx_A_end                                                 
        idx_B_end_cands = np.where(x2[idx_B_start:] >= 1.0)[0]                  
        if len(idx_B_end_cands) > 0:                                            
            idx_B_end = idx_B_start + idx_B_end_cands[0]                        
        else:                                                                   
            idx_B_end = len(x1) - 1                                             
        segB = np.arange(idx_B_start, idx_B_end + 1)                            
                                                                                
        # 2. Derivatives                                                        
        dx = np.gradient(state, dt, axis=1)                                     
                                                                                
        # 3. Fit                                                                
        def get_coeffs(idx):                                                    
            res = []                                                            
            for i in range(2): # for dx1 and dx2                                
                Y = dx[i, idx]                                                  
                X = np.vstack([x1[idx], x2[idx], u1[idx], np.ones(len(idx))]).T 
                c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                  
                res.extend(c)                                                   
            return np.array(res)                                                
                                                                                
        all_A.append(get_coeffs(segA))                                          
        all_B.append(get_coeffs(segB))                                          
        x1_turning.append(x1[idx_A_end])                                        
                                                                                
    print("Avg Coeffs A:", np.mean(all_A, axis=0))                              
    print("Avg Coeffs B:", np.mean(all_B, axis=0))                              
    print("Avg x1 turning:", np.mean(x1_turning))                               
                                                                                
solve()                                                                         
                                                                                
