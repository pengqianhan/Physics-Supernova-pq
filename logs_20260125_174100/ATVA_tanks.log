import numpy as np                                                              
                                                                                
def merge_close_points(points, gap=200):                                        
    if not points: return []                                                    
    merged = [points[0]]                                                        
    for p in points[1:]:                                                        
        if p - merged[-1] < gap:                                                
            merged[-1] = (merged[-1] + p) // 2                                  
        else:                                                                   
            merged.append(p)                                                    
    return merged                                                               
                                                                                
