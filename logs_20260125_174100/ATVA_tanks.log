def fit_segment(x1, x2, u1, start, end):                                        
    if end - start < 5: return None                                             
                                                                                
    curr_x1 = x1[start:end]                                                     
    curr_x2 = x2[start:end]                                                     
    curr_u1 = u1[start:end]                                                     
    next_x1 = x1[start+1:end+1]                                                 
    next_x2 = x2[start+1:end+1]                                                 
                                                                                
    X = np.stack([curr_x1, curr_x2, curr_u1, np.ones_like(curr_x1)], axis=1)    
    beta1, _, _, _ = np.linalg.lstsq(X, next_x1, rcond=None)                    
    beta2, _, _, _ = np.linalg.lstsq(X, next_x2, rcond=None)                    
                                                                                
    res1 = np.max(np.abs(next_x1 - np.dot(X, beta1)))                           
    res2 = np.max(np.abs(next_x2 - np.dot(X, beta2)))                           
                                                                                
    return beta1, beta2, res1, res2                                             
                                                                                
