import numpy as np                                                              
                                                                                
def fit_linear(X_mat, Y_vec):                                                   
    coeffs, _, _, _ = np.linalg.lstsq(X_mat, Y_vec, rcond=None)                 
    return coeffs                                                               
                                                                                
def solve():                                                                    
    dt = 0.001                                                                  
    all_C = []                                                                  
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x = data['state']                                                       
        u = data['input']                                                       
                                                                                
        # Find first x2 >= 1                                                    
        idx_B_end = np.where(x[1] >= 1.0)[0][0]                                 
                                                                                
        # Segment C: after x2 hits 1 until something else                       
        # Let's just take 500 points after B_end                                
        idx_C_start = idx_B_end + 1                                             
        idx_C_end = min(idx_C_start + 1000, x.shape[1] - 1)                     
                                                                                
        xC = x[:, idx_C_start:idx_C_end+1]                                      
        uC = u[:, idx_C_start:idx_C_end+1]                                      
                                                                                
        dx_seg = (xC[:, 1:] - xC[:, :-1]) / dt                                  
        x_input = xC[:, :-1]                                                    
        u_input = uC[:, :-1]                                                    
        X = np.vstack([x_input[0], x_input[1], u_input[0],                      
np.ones(x_input.shape[1])]).T                                                   
                                                                                
        c1 = fit_linear(X, dx_seg[0])                                           
        c2 = fit_linear(X, dx_seg[1])                                           
        all_C.append(np.concatenate([c1, c2]))                                  
                                                                                
    print("Avg C:", np.mean(all_C, axis=0))                                     
                                                                                
solve()                                                                         
                                                                                
