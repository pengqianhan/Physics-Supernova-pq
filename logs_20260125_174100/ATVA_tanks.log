import numpy as np                                                              
                                                                                
def fit_mode_numpy(X, Y):                                                       
    if len(X) < 5: return None                                                  
    # Add a column of ones for the intercept                                    
    A = np.column_stack([X, np.ones(len(X))])                                   
    # Solve A * W = Y                                                           
    W, residuals, rank, s = np.linalg.lstsq(A, Y, rcond=None)                   
    # W is (4, 2)                                                               
    # x1_next = W[0,0]*x1 + W[1,0]*x2 + W[2,0]*u + W[3,0]                       
    # x2_next = W[0,1]*x1 + W[1,1]*x2 + W[2,1]*u + W[3,1]                       
    a, e = W[0]                                                                 
    b, f = W[1]                                                                 
    c, g = W[2]                                                                 
    d, h = W[3]                                                                 
                                                                                
    # Calculate R-squared manually                                              
    SS_res = np.sum((Y - A @ W)**2)                                             
    SS_tot = np.sum((Y - np.mean(Y, axis=0))**2)                                
    r2 = 1 - SS_res / SS_tot                                                    
                                                                                
    return (a, b, c, d, e, f, g, h), r2                                         
                                                                                
