          if abs(x2[i] - x2[i-1]) > 0.5:                                        
              switches.append(i)                                                
                                                                                
      segment_indices = sorted(list(set([0] + switches + [len(x1)])))           
                                                                                
      file_results = []                                                         
      for i in range(len(segment_indices) - 1):                                 
          start, end = segment_indices[i], segment_indices[i+1]                 
          if end - start < 20: continue                                         
                                                                                
          x1_s = x1[start:end]                                                  
          x2_s = x2[start:end]                                                  
          u1_s = u1[start:end]                                                  
                                                                                
          dx1 = np.diff(x1_s) / dt                                              
          dx2 = np.diff(x2_s) / dt                                              
                                                                                
          x1_f = x1_s[:-1]                                                      
          x2_f = x2_s[:-1]                                                      
          u1_f = u1_s[:-1]                                                      
                                                                                
          X1 = np.column_stack([x1_f, u1_f, np.ones_like(x1_f)])                
          c1, _, _, _ = np.linalg.lstsq(X1, dx1, rcond=None)                    
                                                                                
          X2 = np.column_stack([x1_f, x2_f, u1_f, np.ones_like(x1_f)])          
          c2, _, _, _ = np.linalg.lstsq(X2, dx2, rcond=None)                    
                                                                                
          file_results.append({                                                 
              'file': file_path,                                                
              'x1_mean': np.mean(x1_s),                                         
              'a1': c1[0], 'b1': c1[1], 'c1': c1[2],                            
              'a2': c2[0], 'b2': c2[1], 'c2': c2[2], 'd2': c2[3]                
          })                                                                    
      return file_results                                                       
                                                                                
  all_results = []                                                              
  for path in DATA_FILE_PATHS:                                                  
      all_results.extend(process_file(path))                                    
                                                                                
  df = pd.DataFrame(all_results)                                                
  df['mode'] = df['x1_mean'].apply(lambda x: 'low' if x < -1 else 'high')       
                                                                                
  # Check consistency by summarizing coefficients per mode                      
  summary = df.groupby('mode').agg({                                            
      'a1': ['mean', 'std'],                                                    
      'b1': ['mean', 'std'],                                                    
      'c1': ['mean', 'std'],                                                    
      'a2': ['mean', 'std'],                                                    
      'b2': ['mean', 'std'],                                                    
      'c2': ['mean', 'std'],                                                    
      'd2': ['mean', 'std']                                                     
  })                                                                            
                                                                                
  print(summary)                                                                
  print("\nIndividual Segment Results:")                                        
  print(df)                                                                     
