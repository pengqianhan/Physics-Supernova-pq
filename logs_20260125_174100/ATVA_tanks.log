        dy = np.array([item[1] for item in mode_data[m]])                       
                                                                                
        # Fit dx1 = a11*x1 + a12*x2 + b1                                        
        # Fit dx2 = a21*x1 + a22*x2 + b2                                        
        reg1 = LinearRegression().fit(X, dy[:, 0])                              
        reg2 = LinearRegression().fit(X, dy[:, 1])                              
                                                                                
        print(f"\nMode {m} Results:")                                           
        print(f"  dx1 = {reg1.coef_[0]:.4f}*x1 + {reg1.coef_[1]:.4f}*x2 +       
{reg1.intercept_:.4f}")                                                         
        print(f"  dx2 = {reg2.coef_[0]:.4f}*x1 + {reg2.coef_[1]:.4f}*x2 +       
{reg2.intercept_:.4f}")                                                         
        print(f"  R2 scores: {reg1.score(X, dy[:, 0]):.4f}, {reg2.score(X, dy[:,
1]):.4f}")                                                                      
                                                                                
# Check resets                                                                  
if resets:                                                                      
