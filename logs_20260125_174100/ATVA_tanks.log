            'x1_mean': np.mean(x1_s),                                           
            'a1': c1[0], 'b1': c1[1], 'c1': c1[2],                              
            'a2': c2[0], 'b2': c2[1], 'c2': c2[2], 'd2': c2[3]                  
        })                                                                      
    return file_results                                                         
                                                                                
