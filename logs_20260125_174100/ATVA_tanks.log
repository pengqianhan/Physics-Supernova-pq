# Linear Regression for each mode                                               
for m in [1, 2, 3]:                                                             
    idx = np.where(modes == m)[0]                                               
    if len(idx) > 0:                                                            
        # For x1: dx1 = a*x1 + b*u1 + c                                         
        X = np.stack([x1_c[idx], u1_c[idx]], axis=1)                            
        y = dx1[idx]                                                            
        reg1 = LinearRegression().fit(X, y)                                     
                                                                                
        # For x2: dx2 = d*x1 + e*x2 + f*u1 + g                                  
        X2 = np.stack([x1_c[idx], x2_c[idx], u1_c[idx]], axis=1)                
        y2 = dx2[idx]                                                           
        reg2 = LinearRegression().fit(X2, y2)                                   
                                                                                
        print(f"\nMode {m} Coefficients:")                                      
        print(f"  dx1 = {reg1.coef_[0]:.2f}*x1 + {reg1.coef_[1]:.2f}*u1 +       
{reg1.intercept_:.2f}")                                                         
        print(f"  dx2 = {reg2.coef_[0]:.2f}*x1 + {reg2.coef_[1]:.2f}*x2 +       
{reg2.coef_[2]:.2f}*u1 + {reg2.intercept_:.2f}")                                
                                                                                
# Check for resets in x2                                                        
for idx in transitions:                                                         
    print(f"Jump in x2 at t={t[idx]:.4f}: {x2[idx+1] - x2[idx]:.6f}")           
                                                                                
