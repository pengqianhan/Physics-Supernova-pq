import numpy as np                                                              
                                                                                
all_states = []                                                                 
all_inputs = []                                                                 
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'].T)                                          
    all_inputs.append(data['input'].T)                                          
                                                                                
def get_mode(x):                                                                
    if x[0] <= -1.0: return 2                                                   
    if x[1] >= 1.0: return 3                                                    
    return 1                                                                    
                                                                                
dt = 0.001                                                                      
results = {}                                                                    
                                                                                
for m_id in [1, 2, 3]:                                                          
    X_list = []                                                                 
    Y_list = []                                                                 
    for traj, inputs in zip(all_states, all_inputs):                            
        for i in range(len(traj)-1):                                            
            if get_mode(traj[i]) == m_id:                                       
                X_list.append([traj[i][0], traj[i][1], inputs[i][0], 1.0])      
                # Numerical derivative (x[t+1] - x[t]) / dt                     
                Y_list.append((traj[i+1] - traj[i]) / dt)                       
                                                                                
    if X_list:                                                                  
        X = np.array(X_list)                                                    
        Y = np.array(Y_list)                                                    
        coeffs, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                     
        results[m_id] = coeffs                                                  
                                                                                
for m_id, coeffs in results.items():                                            
    print(f"Mode {m_id} ODE Coefficients (x' = A*x + B*u + b):")                
    # coeffs is (4, 2). coeffs[:, 0] are for x1', coeffs[:, 1] for x2'          
    # Row 0: x1, Row 1: x2, Row 2: u, Row 3: intercept                          
    print(f"  x1' = {coeffs[0,0]:.4f}*x1 + {coeffs[1,0]:.4f}*x2 +               
{coeffs[2,0]:.4f}*u + {coeffs[3,0]:.4f}")                                       
    print(f"  x2' = {coeffs[0,1]:.4f}*x1 + {coeffs[1,1]:.4f}*x2 +               
{coeffs[2,1]:.4f}*u + {coeffs[3,1]:.4f}")                                       
                                                                                
# Verification of transitions                                                   
for traj in all_states:                                                         
    for i in range(len(traj)-1):                                                
        m_curr = get_mode(traj[i])                                              
        m_next = get_mode(traj[i+1])                                            
        if m_curr != m_next:                                                    
            print(f"Transition {m_curr} -> {m_next} at x={traj[i]}")            
                                                                                
                                                                                
