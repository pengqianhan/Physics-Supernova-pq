dt = 0.001                                                                      
t = np.arange(state.shape[1]) * dt                                              
                                                                                
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
u1 = u_data[0, :]                                                               
                                                                                
# Calculate derivatives                                                         
dx1 = np.diff(x1) / dt                                                          
dx2 = np.diff(x2) / dt                                                          
                                                                                
# Center values for derivative alignment                                        
x1_c = x1[:-1]                                                                  
x2_c = x2[:-1]                                                                  
u1_c = u1[:-1]                                                                  
                                                                                
# Heuristic to identify modes based on existing model structure                 
# Mode 1: dx1 approx -x1 + u1 - 2.0, dx2 approx x1 + u1                         
# Mode 2: dx1 approx -x1 + u1 + 3.0, dx2 approx x1 + u1                         
# Mode 3: dx1 approx -x1 + u1 - 2.0, dx2 approx x1 - x2 + u1 - 5.0              
                                                                                
# Using dx1 as primary differentiator for Mode 2                                
# dx1 + x1 - u1 is approx -2 for Mode 1/3, and +3 for Mode 2                    
res1 = dx1 + x1_c - u1_c                                                        
modes = np.zeros(len(res1))                                                     
modes[res1 > 0.5] = 2 # Mode 2 candidate                                        
                                                                                
# Distinguish 1 vs 3 using dx2                                                  
# dx2 - x1 - u1 is approx 0 for Mode 1, and -x2 - 5 for Mode 3                  
res2 = dx2 - x1_c - u1_c                                                        
modes[(modes == 0) & (res2 < -1.0)] = 3                                         
modes[modes == 0] = 1                                                           
                                                                                
# Refine switching points                                                       
transitions = np.where(np.diff(modes) != 0)[0]                                  
print("Transitions at indices:", transitions)                                   
for idx in transitions:                                                         
    print(f"Transition at t={t[idx]:.4f} from Mode {modes[idx]} to              
