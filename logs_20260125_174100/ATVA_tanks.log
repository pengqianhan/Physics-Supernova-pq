<code>                                                                          
import numpy as np                                                              
                                                                                
def perform_estimation():                                                       
    data_files = ['data_all/ATVA/tanks/sample_0.npz',                           
'data_all/ATVA/tanks/sample_1.npz', 'data_all/ATVA/tanks/sample_2.npz']         
                                                                                
    m1_X = []                                                                   
    m1_y1 = []                                                                  
    m1_y2 = []                                                                  
                                                                                
    m2_X = []                                                                   
    m2_y1 = []                                                                  
    m2_y2 = []                                                                  
                                                                                
    for f in data_files:                                                        
        data = np.load(f)                                                       
        state = data['state']                                                   
        u = data['input']                                                       
                                                                                
        # We need to determine the mode for each step.                          
        # Initial mode determination:                                           
        # If x1 is very close to -1.0 or just above it after being below, we are
in Mode 2.                                                                      
        # If x2 is very close to 1.0 or just below it after being above, we are 
in Mode 1.                                                                      
        # Let's assume we start in Mode 2 if x1 is near -1 and increasing,      
        # but better to just look for the first guard hit.                      
                                                                                
        current_mode = None                                                     
        for t in range(state.shape[1] - 1):                                     
            x1_t, x2_t = state[:, t]                                            
            u_t = u[0, t]                                                       
            x1_next, x2_next = state[:, t+1]                                    
                                                                                
            # Check guards                                                      
            if x1_t <= -1.0:                                                    
                current_mode = 2                                                
            elif x2_t >= 1.0:                                                   
                current_mode = 1                                                
                                                                                
            if current_mode == 1:                                               
                # In Mode 1 until x1 hits -1.0                                  
                m1_X.append([x1_t, x2_t, u_t, 1.0])                             
                m1_y1.append(x1_next)                                           
                m1_y2.append(x2_next)                                           
            elif current_mode == 2:                                             
                # In Mode 2 until x2 hits 1.0                                   
                m2_X.append([x1_t, x2_t, u_t, 1.0])                             
                m2_y1.append(x1_next)                                           
                m2_y2.append(x2_next)                                           
                                                                                
    def solve(X, y1, y2):                                                       
        X = np.array(X)                                                         
        y1 = np.array(y1)                                                       
        y2 = np.array(y2)                                                       
        c1, _, _, _ = np.linalg.lstsq(X, y1, rcond=None)                        
        c2, _, _, _ = np.linalg.lstsq(X, y2, rcond=None)                        
        return c1, c2                                                           
                                                                                
    res1 = solve(m1_X, m1_y1, m1_y2)                                            
    res2 = solve(m2_X, m2_y1, m2_y2)                                            
                                                                                
    print("Mode 1 Coeffs (a, b, c, d):", res1[0])                               
    print("Mode 1 Coeffs (e, f, g, h):", res1[1])                               
    print("Mode 2 Coeffs (a, b, c, d):", res2[0])                               
    print("Mode 2 Coeffs (e, f, g, h):", res2[1])                               
                                                                                
perform_estimation()                                                            
                                                                                
