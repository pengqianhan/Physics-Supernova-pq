import numpy as np                                                              
                                                                                
def fit_dynamics(x, u, dt=0.01):                                                
    x1, x2 = x[0, :], x[1, :]                                                   
    u1 = u[0, :]                                                                
    dx1 = (x1[1:] - x1[:-1]) / dt                                               
    dx2 = (x2[1:] - x2[:-1]) / dt                                               
    X = np.vstack([x1[:-1], x2[:-1], u1[:-1], np.ones_like(x1[:-1])]).T         
    coeffs1 = np.linalg.lstsq(X, dx1, rcond=None)[0]                            
    coeffs2 = np.linalg.lstsq(X, dx2, rcond=None)[0]                            
    return coeffs1, coeffs2                                                     
                                                                                
