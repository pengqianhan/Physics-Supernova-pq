import numpy as np                                                              
                                                                                
def get_transitions(all_states, all_inputs):                                    
    X = []                                                                      
    Y1 = []                                                                     
    Y2 = []                                                                     
    for state, inp in zip(all_states, all_inputs):                              
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
        u1 = inp[0, :]                                                          
                                                                                
        # Current state and input                                               
        curr_x1 = x1[:-1]                                                       
        curr_x2 = x2[:-1]                                                       
        curr_u1 = u1[:-1]                                                       
                                                                                
        # Next state                                                            
        next_x1 = x1[1:]                                                        
        next_x2 = x2[1:]                                                        
                                                                                
        X.append(np.stack([curr_x1, curr_x2, curr_u1, np.ones_like(curr_x1)],   
axis=1))                                                                        
        Y1.append(next_x1)                                                      
        Y2.append(next_x2)                                                      
                                                                                
    return np.vstack(X), np.concatenate(Y1), np.concatenate(Y2)                 
                                                                                
X_all, Y1_all, Y2_all = get_transitions(all_states, all_inputs)                 
                                                                                
