import numpy as np                                                              
                                                                                
# Load data and transpose                                                       
files = ['data_all/ATVA/tanks/sample_0.npz', 'data_all/ATVA/tanks/sample_1.npz',
'data_all/ATVA/tanks/sample_2.npz']                                             
all_x = []                                                                      
all_u = []                                                                      
for f in files:                                                                 
    data = np.load(f)                                                           
    x = data['state'].T  # (10001, 2)                                           
    u = data['input'].T  # (10001, 1)                                           
    all_x.append(x)                                                             
    all_u.append(u)                                                             
                                                                                
# Prepare data for clustering: [x1, x2, u, dx1, dx2]                            
X_p_list, U_list, DX_list = [], [], []                                          
for x, u in zip(all_x, all_u):                                                  
    X_p_list.append(x[:-1])                                                     
    U_list.append(u[:-1])                                                       
    DX_list.append(x[1:] - x[:-1])                                              
                                                                                
X_p_all = np.vstack(X_p_list)                                                   
U_all = np.vstack(U_list)                                                       
DX_all = np.vstack(DX_list)                                                     
                                                                                
# Features for clustering: we want to separate by dynamics                      
# dx = f(x, u). Let's use [dx1, dx2] normalized or just [dx1, dx2]              
cluster_features = DX_all                                                       
                                                                                
def manual_kmeans(data, k, max_iters=20):                                       
    n_samples = data.shape[0]                                                   
    indices = np.linspace(0, n_samples-1, k).astype(int)                        
    centroids = data[indices]                                                   
    for _ in range(max_iters):                                                  
        dists = np.linalg.norm(data[:, np.newaxis] - centroids, axis=2)         
        labels = np.argmin(dists, axis=1)                                       
        new_centroids = np.array([data[labels == i].mean(axis=0) if             
np.any(labels == i) else centroids[i] for i in range(k)])                       
        if np.allclose(centroids, new_centroids): break                         
        centroids = new_centroids                                               
    return labels                                                               
                                                                                
labels = manual_kmeans(cluster_features, 3)                                     
                                                                                
# Refine parameters for each mode                                               
# x_next = A*x + B*u + C                                                        
mode_params = {}                                                                
for m in range(3):                                                              
    mask = (labels == m)                                                        
    if not np.any(mask): continue                                               
                                                                                
    xp = X_p_all[mask]                                                          
    up = U_all[mask]                                                            
    xn = (DX_all + X_p_all)[mask]                                               
                                                                                
    feat = np.column_stack([xp, up, np.ones(len(xp))])                          
    # x1[k+1] = a11*x1 + a12*x2 + b1*u + c1                                     
    # x2[k+1] = a21*x1 + a22*x2 + b2*u + c2                                     
    coeffs, _, _, _ = np.linalg.lstsq(feat, xn, rcond=None)                     
    mode_params[m] = coeffs.T                                                   
                                                                                
# Identify guards: values of x when switching                                   
all_switches = []                                                               
for x, u in zip(all_x, all_u):                                                  
    dx = x[1:] - x[:-1]                                                         
    # Assign labels to this trajectory                                          
    dists = np.linalg.norm(dx[:, np.newaxis] - np.array([DX_all[labels ==       
i].mean(axis=0) for i in range(3)]), axis=2)                                    
    traj_labels = np.argmin(dists, axis=1)                                      
                                                                                
    sw = np.where(traj_labels[:-1] != traj_labels[1:])[0]                       
    for s in sw:                                                                
        all_switches.append({                                                   
            'from': traj_labels[s],                                             
            'to': traj_labels[s+1],                                             
            'x': x[s+1],                                                        
            'jump': np.linalg.norm(x[s+1] - x[s]) # Discrete step, jump is      
normal if continuous                                                            
        })                                                                      
                                                                                
print("Mode Parameters:")                                                       
for m, p in mode_params.items():                                                
    print(f"Mode {m}:")                                                         
    print(f"  x1[k+1] = {p[0,0]:.3f}*x1 + {p[0,1]:.3f}*x2 + {p[0,2]:.3f}*u1 +   
{p[0,3]:.3f}")                                                                  
    print(f"  x2[k+1] = {p[1,0]:.3f}*x1 + {p[1,1]:.3f}*x2 + {p[1,2]:.3f}*u1 +   
{p[1,3]:.3f}")                                                                  
                                                                                
# Analyze guard thresholds                                                      
if all_switches:                                                                
    for m_from in range(3):                                                     
        for m_to in range(3):                                                   
            if m_from == m_to: continue                                         
            relevant = [s['x'] for s in all_switches if s['from'] == m_from and 
s['to'] == m_to]                                                                
            if relevant:                                                        
                r = np.array(relevant)                                          
                print(f"Transition {m_from} -> {m_to}: x mean {r.mean(axis=0)}, 
