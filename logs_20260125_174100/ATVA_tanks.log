import numpy as np                                                              
                                                                                
def load_and_prep(file_path):                                                   
    data = np.load(file_path)                                                   
    x = data['state'].T                                                         
    u = data['input'].T                                                         
    return x, u                                                                 
                                                                                
samples = []                                                                    
for i in range(3):                                                              
    samples.append(load_and_prep(f'data_all/ATVA/tanks/sample_{i}.npz'))        
                                                                                
def find_transitions(x):                                                        
    dx = np.diff(x, axis=0)                                                     
    ddx = np.diff(dx, axis=0)                                                   
    norms = np.linalg.norm(ddx, axis=1)                                         
    median_norm = np.median(norms)                                              
    # Using a slightly more robust thresholding                                 
    threshold = median_norm + 10 * (np.percentile(norms, 75) -                  
np.percentile(norms, 25))                                                       
    indices = np.where(norms > threshold)[0] + 1                                
    # Filtering indices that are too close (noise)                              
    if len(indices) == 0: return []                                             
    filtered = [indices[0]]                                                     
    for idx in indices[1:]:                                                     
        if idx - filtered[-1] > 5:                                              
            filtered.append(idx)                                                
    return np.array(filtered)                                                   
                                                                                
dt = 0.1                                                                        
                                                                                
def perform_regression(x_seg, u_seg):                                           
    if len(x_seg) < 5: return None                                              
    X = x_seg[:-1]                                                              
    U = u_seg[:-1]                                                              
    ones = np.ones((X.shape[0], 1))                                             
    phi = np.hstack([X, U, ones])                                               
    target = x_seg[1:]                                                          
    theta, _, _, _ = np.linalg.lstsq(phi, target, rcond=None)                   
    return theta.T # Rows: [a11, a12, b11, c1] and [a21, a22, b21, c2]          
                                                                                
all_segments_results = []                                                       
                                                                                
for s_idx, (x, u) in enumerate(samples):                                        
    indices = find_transitions(x)                                               
    # Define segments                                                           
    segs = []                                                                   
    start = 0                                                                   
    for idx in indices:                                                         
        segs.append((start, idx))                                               
        start = idx                                                             
    segs.append((start, len(x)))                                                
                                                                                
    for start, end in segs:                                                     
        coeffs = perform_regression(x[start:end], u[start:end])                 
        if coeffs is not None:                                                  
            all_segments_results.append({                                       
                'sample': s_idx,                                                
                'range': (start, end),                                          
                'coeffs': coeffs,                                               
                'mid_x': np.mean(x[start:end], axis=0)                          
            })                                                                  
                                                                                
# Group segments by coeffs                                                      
def are_similar(c1, c2, tol=1e-3):                                              
    return np.allclose(c1, c2, atol=tol)                                        
                                                                                
modes = []                                                                      
for seg in all_segments_results:                                                
    found = False                                                               
    for mode in modes:                                                          
        if are_similar(mode['avg_coeffs'], seg['coeffs']):                      
            mode['segments'].append(seg)                                        
            # update average                                                    
            mode['avg_coeffs'] = np.mean([s['coeffs'] for s in                  
