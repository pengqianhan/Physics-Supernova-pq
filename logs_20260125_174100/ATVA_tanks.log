  def fit_mode(m, mode_data, dt=0.001):                                         
      X1, X2, U, Y1, Y2 = [], [], [], [], []                                    
      for x1, x2, u in mode_data[m]:                                            
          X1.extend(x1[:-1])                                                    
          X2.extend(x2[:-1])                                                    
          U.extend(u[:-1])                                                      
          Y1.extend(np.diff(x1)/dt)                                             
          Y2.extend(np.diff(x2)/dt)                                             
                                                                                
      M = np.column_stack([X1, X2, U, np.ones_like(X1)])                        
      p1, _, _, _ = np.linalg.lstsq(M, Y1, rcond=None)                          
      p2, _, _, _ = np.linalg.lstsq(M, Y2, rcond=None)                          
      return p1, p2                                                             
                                                                                
  # Fit for each sample separately to see consistency                           
  for i in range(3):                                                            
      md = get_mode_data([paths[i]])                                            
      print(f"Sample {i}:")                                                     
      for m in [0, 1, 2]:                                                       
          if not md[m]: continue                                                
          p1, p2 = fit_mode(m, md)                                              
          print(f"  Mode {m} x1': {p1}")                                        
          print(f"  Mode {m} x2': {p2}")                                        
