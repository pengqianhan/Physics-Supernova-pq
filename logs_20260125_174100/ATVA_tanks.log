import numpy as np                                                              
import pandas as pd                                                             
from scipy import stats                                                         
                                                                                
def solve():                                                                    
    all_coeffs_A = []                                                           
    all_coeffs_B = []                                                           
    x1_min_values = []                                                          
    x2_reset_from = []                                                          
    x2_reset_to = []                                                            
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        # Expected keys: t, x, u                                                
        t = data['t'].flatten()                                                 
        x = data['x']  # Shape (2, N) or (N, 2)                                 
        u = data['u']  # Shape (1, N) or (N, 1)                                 
                                                                                
        # Ensure correct shapes                                                 
        if x.shape[0] != 2: x = x.T                                             
        if u.ndim > 1 and u.shape[0] != 1: u = u.T                              
        u = u.flatten()                                                         
                                                                                
        dt = t[1] - t[0]                                                        
        dx = np.gradient(x, dt, axis=1)                                         
                                                                                
        x1 = x[0, :]                                                            
        x2 = x[1, :]                                                            
        dx1 = dx[0, :]                                                          
        dx2 = dx[1, :]                                                          
                                                                                
        # Segment A: x1 is decreasing (until it hits its minimum, or reaches -1)
        # Find index where x1 first reaches -1 or starts increasing             
        idx_min = np.argmin(x1)                                                 
        x1_min_values.append(x1[idx_min])                                       
                                                                                
        # Find reset in x2                                                      
        # A reset is a large jump. Let's look for diffs                         
        dx2_jump = np.diff(x2)                                                  
        reset_indices = np.where(np.abs(dx2_jump) > 0.5)[0]                     
        if len(reset_indices) > 0:                                              
            ridx = reset_indices[0]                                             
            x2_reset_from.append(x2[ridx])                                      
            x2_reset_to.append(x2[ridx+1])                                      
            idx_end_B = ridx                                                    
        else:                                                                   
            idx_end_B = len(x1) - 1                                             
                                                                                
        # Segment A: 0 to idx_min                                               
        segA_mask = np.arange(0, idx_min)                                       
        # Segment B: idx_min to idx_end_B                                       
        segB_mask = np.arange(idx_min, idx_end_B)                               
                                                                                
        def fit_linear(mask):                                                   
            if len(mask) < 5: return None                                       
            # Target: dx1 = a*x1 + b*x2 + c*u1 + d                              
            # Target: dx2 = e*x1 + f*x2 + g*u1 + h                              
            Y1 = dx1[mask]                                                      
            Y2 = dx2[mask]                                                      
            X = np.vstack([x1[mask], x2[mask], u[mask], np.ones(len(mask))]).T  
                                                                                
            coeffs1, _, _, _ = np.linalg.lstsq(X, Y1, rcond=None)               
            coeffs2, _, _, _ = np.linalg.lstsq(X, Y2, rcond=None)               
            return np.concatenate([coeffs1, coeffs2])                           
                                                                                
        cA = fit_linear(segA_mask)                                              
        cB = fit_linear(segB_mask)                                              
                                                                                
        if cA is not None: all_coeffs_A.append(cA)                              
        if cB is not None: all_coeffs_B.append(cB)                              
                                                                                
    avg_A = np.mean(all_coeffs_A, axis=0)                                       
    avg_B = np.mean(all_coeffs_B, axis=0)                                       
                                                                                
    print("Avg Coeffs A (a,b,c,d, e,f,g,h):", avg_A)                            
    print("Avg Coeffs B (a,b,c,d, e,f,g,h):", avg_B)                            
    print("X1 turning point:", np.mean(x1_min_values))                          
    print("X2 resets from:", np.mean(x2_reset_from))                            
    print("X2 resets to:", np.mean(x2_reset_to))                                
                                                                                
solve()                                                                         
                                                                                
