<code>import numpy as np                                                        
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
data = np.load('data_all/ATVA/tanks/sample_0.npz')                              
state = data['state']                                                           
u1 = data['input'][0]                                                           
x1 = state[0]                                                                   
x2 = state[1]                                                                   
                                                                                
# Calculate derivatives (assuming dt=1 or similar, we'll find scaling in        
regression)                                                                     
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
x1_prev = x1[:-1]                                                               
x2_prev = x2[:-1]                                                               
u1_prev = u1[:-1]                                                               
                                                                                
# Detect jump indices                                                           
ddx1 = np.abs(np.diff(dx1))                                                     
ddx2 = np.abs(np.diff(dx2))                                                     
jump_indices = np.where((ddx1 > 5 * np.mean(ddx1)) | (ddx2 > 5 *                
np.mean(ddx2)))[0] + 1                                                          
                                                                                
# Define segments                                                               
segments = []                                                                   
start = 0                                                                       
for jump in jump_indices:                                                       
    segments.append((start, jump))                                              
    start = jump                                                                
segments.append((start, len(dx1)))                                              
                                                                                
# Analyze each segment and identify modes                                       
results = []                                                                    
for i, (s, e) in enumerate(segments):                                           
    X = np.stack([x1_prev[s:e], x2_prev[s:e], u1_prev[s:e]], axis=1)            
    y1 = dx1[s:e]                                                               
    y2 = dx2[s:e]                                                               
                                                                                
    reg1 = LinearRegression().fit(X, y1)                                        
    reg2 = LinearRegression().fit(X, y2)                                        
                                                                                
    # Check for state resets at start of segment (except first)                 
    reset = "None"                                                              
    if s > 0:                                                                   
        jump_x1 = x1[s] - x1[s-1]                                               
        jump_x2 = x2[s] - x2[s-1]                                               
        if abs(jump_x1) > 0.01 or abs(jump_x2) > 0.01:                          
            reset = f"Jump in x1: {jump_x1:.4f}, x2: {jump_x2:.4f}"             
                                                                                
    # Guard condition (state at the end of the previous segment)                
    guard = "N/A"                                                               
    if s > 0:                                                                   
        guard = f"x1 ≈ {x1[s-1]:.3f}, x2 ≈ {x2[s-1]:.3f}, u1 ≈ {u1[s-1]:.3f}"   
                                                                                
    results.append({                                                            
        "segment": i,                                                           
        "indices": (s, e),                                                      
        "coef1": reg1.coef_, "int1": reg1.intercept_,                           
        "coef2": reg2.coef_, "int2": reg2.intercept_,                           
        "reset": reset,                                                         
        "guard": guard,                                                         
        "x1_range": (np.min(x1[s:e]), np.max(x1[s:e])),                         
        "x2_range": (np.min(x2[s:e]), np.max(x2[s:e])),                         
        "u1_range": (np.min(u1[s:e]), np.max(u1[s:e]))                          
    })                                                                          
                                                                                
# Group segments into modes by comparing coefficients                           
modes = []                                                                      
for res in results:                                                             
    found = False                                                               
    for mode in modes:                                                          
        if np.allclose(res['coef1'], mode['coef1'], atol=1e-3) and              
np.allclose(res['coef2'], mode['coef2'], atol=1e-3):                            
            mode['segments'].append(res)                                        
            found = True                                                        
            break                                                               
    if not found:                                                               
        modes.append({'coef1': res['coef1'], 'int1': res['int1'], 'coef2':      
res['coef2'], 'int2': res['int2'], 'segments': [res]})                          
                                                                                
# Construct the output parts                                                    
summary_text = f"Identified {len(modes)} distinct modes in the hybrid automaton.
Switching occurs at {len(jump_indices)} points."                                
                                                                                
