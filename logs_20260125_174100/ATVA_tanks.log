  def fit_linear_model_v2(X, U, Y):                                             
      N = X.shape[1]                                                            
      Z = np.vstack([X, U, np.ones((1, N))])                                    
      # Z is (4, N), Y is (2, N)                                                
      # Solve Z.T * A.T = Y.T                                                   
      res, residuals, rank, s = np.linalg.lstsq(Z.T, Y.T, rcond=None)           
      # res is (4, 2)                                                           
      return res.T, residuals                                                   
                                                                                
  def get_error_v2(A, X, U, Y):                                                 
      N = X.shape[1]                                                            
      Z = np.vstack([X, U, np.ones((1, N))])                                    
      pred = np.dot(A, Z)                                                       
      error = np.mean((pred - Y)**2)                                            
      return error                                                              
                                                                                
