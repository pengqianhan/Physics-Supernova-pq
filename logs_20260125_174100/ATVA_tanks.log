import numpy as np                                                              
                                                                                
# Load data                                                                     
files = ['data_all/ATVA/tanks/sample_0.npz', 'data_all/ATVA/tanks/sample_1.npz',
'data_all/ATVA/tanks/sample_2.npz']                                             
all_x = []                                                                      
all_u = []                                                                      
for f in files:                                                                 
    data = np.load(f)                                                           
    all_x.append(data['state'])                                                 
    all_u.append(data['input'])                                                 
                                                                                
def manual_kmeans(data, k, max_iters=100):                                      
    # Initialize centroids randomly from data                                   
    n_samples = data.shape[0]                                                   
    idx = np.random.choice(n_samples, k, replace=False)                         
    centroids = data[idx]                                                       
                                                                                
    for _ in range(max_iters):                                                  
        # Assign clusters                                                       
        distances = np.linalg.norm(data[:, np.newaxis] - centroids, axis=2)     
        labels = np.argmin(distances, axis=1)                                   
                                                                                
        # Update centroids                                                      
        new_centroids = np.array([data[labels == i].mean(axis=0) for i in       
range(k)])                                                                      
        if np.all(centroids == new_centroids):                                  
            break                                                               
        centroids = new_centroids                                               
    return labels, centroids                                                    
                                                                                
# Prepare data for clustering: [x(t), u(t), x(t+1)]                             
processed_data = []                                                             
for x, u in zip(all_x, all_u):                                                  
    if u.ndim == 1: u = u.reshape(-1, 1)                                        
    # x(t), u(t), x(t+1)                                                        
    trans = np.column_stack([x[:-1], u[:-1], x[1:]])                            
    processed_data.append(trans)                                                
                                                                                
full_data = np.vstack(processed_data)                                           
                                                                                
# Cluster to find modes. Use x(t+1) - x(t) as a feature for easier separation   
diffs = full_data[:, 3:] - full_data[:, :2]                                     
labels, _ = manual_kmeans(diffs, 3)                                             
                                                                                
# For each mode, fit the coefficients                                           
results = {}                                                                    
for i in range(3):                                                              
    mask = (labels == i)                                                        
    sub_data = full_data[mask]                                                  
                                                                                
    # x_next = a11*x1 + a12*x2 + b1*u1 + c1                                     
    # Target: sub_data[:, 3:] (x1_next, x2_next)                                
    # Features: [x1, x2, u1, 1]                                                 
    X = np.column_stack([sub_data[:, :3], np.ones(len(sub_data))])              
    Y1 = sub_data[:, 3]                                                         
    Y2 = sub_data[:, 4]                                                         
                                                                                
    # Linear regression using lstsq                                             
    sol1, _, _, _ = np.linalg.lstsq(X, Y1, rcond=None)                          
    sol2, _, _, _ = np.linalg.lstsq(X, Y2, rcond=None)                          
                                                                                
    results[i] = {                                                              
        'coeffs1': sol1, # [a11, a12, b1, c1]                                   
        'coeffs2': sol2  # [a21, a22, b2, c2]                                   
    }                                                                           
                                                                                
# Print results                                                                 
for i in range(3):                                                              
    c1 = results[i]['coeffs1']                                                  
    c2 = results[i]['coeffs2']                                                  
    print(f"Mode {i}:")                                                         
    print(f"  x1[t+1] = {c1[0]:.3f}*x1 + {c1[1]:.3f}*x2 + {c1[2]:.3f}*u +       
{c1[3]:.3f}")                                                                   
