import numpy as np                                                              
                                                                                
def get_data(paths):                                                            
    all_states = []                                                             
    all_inputs = []                                                             
    for path in paths:                                                          
        data = np.load(path)                                                    
        all_states.append(data['state'])                                        
        all_inputs.append(data['input'])                                        
    return all_states, all_inputs                                               
                                                                                
states_list, inputs_list = get_data(DATA_FILE_PATHS)                            
                                                                                
# Combine data for regression, but we need to track the mode                    
# Mode 0: x1 > -1.0                                                             
# Mode 1: x1 <= -1.0                                                            
# Transition 0 -> 1: x1 reaches -1.0                                            
# Transition 1 -> 0: x2 reaches 1.0 (Reset)                                     
                                                                                
def process_trajectories(states_list, inputs_list):                             
    mode0_data = [] # [x1, x2, u1, next_x1, next_x2]                            
    mode1_data = []                                                             
    resets = []                                                                 
                                                                                
    for state, u in zip(states_list, inputs_list):                              
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
        u1 = u[0, :]                                                            
        n = len(x1)                                                             
                                                                                
        mode = 0 # Assume starting in mode 0                                    
        for i in range(n - 1):                                                  
            # Check for reset in x2                                             
            # Guard: x2 reaches 1.0. Reset: x2 -> 0.0, Mode -> 0                
            if x2[i] >= 0.99 and x2[i+1] < 0.2:                                 
                resets.append((x2[i], x2[i+1], mode))                           
                mode = 0                                                        
                continue # Skip reset step for ODE estimation                   
                                                                                
            # Check for mode switch x1 reaches -1.0                             
            if mode == 0 and x1[i] <= -1.0:                                     
                mode = 1                                                        
                                                                                
            # Record data point                                                 
            point = [x1[i], x2[i], u1[i], x1[i+1], x2[i+1]]                     
            if mode == 0:                                                       
                mode0_data.append(point)                                        
