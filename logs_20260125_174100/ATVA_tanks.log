    u = data['u']                                                               
                                                                                
    n_samples = x.shape[0]                                                      
                                                                                
    # Identify segments                                                         
    current_mode = 'Falling'                                                    
                                                                                
    for i in range(n_samples - 1):                                              
        x1, x2 = x[i]                                                           
        u1 = u[i][0]                                                            
        dx1 = (x[i+1, 0] - x[i, 0]) / dt                                        
        dx2 = (x[i+1, 1] - x[i, 1]) / dt                                        
                                                                                
        # Check for reset (x2 drops to ~0)                                      
        if i > 0 and x[i, 1] < 0.05 and x[i-1, 1] > 0.5:                        
