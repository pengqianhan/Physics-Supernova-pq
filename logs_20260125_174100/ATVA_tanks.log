    print(f"File {i}: x shape {x.shape}, u shape {u.shape}")                    
                                                                                
# Function to detect switches                                                   
def detect_switches(x, u, threshold=0.1):                                       
    # dx = x[t+1] - x[t]                                                        
    dx = x[1:] - x[:-1]                                                         
    # Discontinuities in dx                                                     
    ddx = dx[1:] - dx[:-1]                                                      
    # Magnitude of jump in ddx                                                  
    mag = np.linalg.norm(ddx, axis=1)                                           
    switches = np.where(mag > threshold)[0] + 1 # +1 because of double diff     
    return switches                                                             
                                                                                
# Process all files and find segments                                           
segments = []                                                                   
for x, u in all_data:                                                           
    switches = detect_switches(x, u)                                            
    # Start and end of segments                                                 
    indices = [0] + list(switches) + [len(x)-1]                                 
    for i in range(len(indices)-1):                                             
        start, end = indices[i], indices[i+1]                                   
        if end - start > 5: # Ignore very short segments                        
            seg_x = x[start:end+1]                                              
            seg_u = u[start:end]                                                
            segments.append((seg_x, seg_u))                                     
                                                                                
print(f"Total segments found: {len(segments)}")                                 
                                                                                
# For each segment, calculate the average 'delta' or use a small portion to     
identify the mode                                                               
# Or better, just group segments by their linear fit parameters                 
def get_fit(seg_x, seg_u):                                                      
    # x[t+1] = A*x[t] + B*u[t] + C                                              
    X_prev = seg_x[:-1]                                                         
    U_prev = seg_u                                                              
    if len(U_prev.shape) == 1: U_prev = U_prev.reshape(-1, 1)                   
    Y = seg_x[1:]                                                               
                                                                                
    # Features [x1, x2, u1, 1]                                                  
    feat = np.column_stack([X_prev, U_prev, np.ones(len(X_prev))])              
    # Solve feat * coeffs = Y                                                   
    coeffs, _, _, _ = np.linalg.lstsq(feat, Y, rcond=None)                      
    return coeffs.T # returns [[a11, a12, b1, c1], [a21, a22, b2, c2]]          
                                                                                
segment_fits = [get_fit(sx, su) for sx, su in segments]                         
                                                                                
# Cluster fits into 3 modes                                                     
from scipy.cluster.vq import kmeans, vq                                         
