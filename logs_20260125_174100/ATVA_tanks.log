import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load the data                                                                 
data0 = np.load('data_all/ATVA/tanks/sample_0.npz')                             
data1 = np.load('data_all/ATVA/tanks/sample_1.npz')                             
data2 = np.load('data_all/ATVA/tanks/sample_2.npz')                             
                                                                                
def process_data(data):                                                         
    states = data['state']                                                      
    inputs = data['input']                                                      
                                                                                
    # x is (N, 2), u is (N, 1)                                                  
    x1 = states[:, 0]                                                           
    x2 = states[:, 1]                                                           
    u1 = inputs[:, 0]                                                           
                                                                                
    # Next states                                                               
    x1_next = x1[1:]                                                            
    x2_next = x2[1:]                                                            
                                                                                
    # Current states/inputs for the regression                                  
    x1_curr = x1[:-1]                                                           
    x2_curr = x2[:-1]                                                           
    u1_curr = u1[:-1]                                                           
                                                                                
    return x1_curr, x2_curr, u1_curr, x1_next, x2_next                          
                                                                                
# Combine all data                                                              
all_x1_curr, all_x2_curr, all_u1_curr, all_x1_next, all_x2_next = [], [], [],   
[], []                                                                          
                                                                                
for d in [data0, data1, data2]:                                                 
    x1c, x2c, u1c, x1n, x2n = process_data(d)                                   
    all_x1_curr.append(x1c)                                                     
    all_x2_curr.append(x2c)                                                     
    all_u1_curr.append(u1c)                                                     
    all_x1_next.append(x1n)                                                     
    all_x2_next.append(x2n)                                                     
                                                                                
x1_c = np.concatenate(all_x1_curr)                                              
x2_c = np.concatenate(all_x2_curr)                                              
u1_c = np.concatenate(all_u1_curr)                                              
x1_n = np.concatenate(all_x1_next)                                              
x2_n = np.concatenate(all_x2_next)                                              
                                                                                
# Check for resets in x2                                                        
# A reset usually happens when x2_next is significantly different from what the 
continuous model predicts                                                       
# Let's compute delta_x2                                                        
dx2 = x2_n - x2_c                                                               
dx1 = x1_n - x1_c                                                               
                                                                                
# Identify modes based on thresholds mentioned:                                 
# x1 hits -1.0, x1 hits 3.0, x2 hits 1.0, x2 hits 0.0                           
# Let's find segments.                                                          
# Since I don't have time indices, I'll use the indices from concatenated       
arrays.                                                                         
# But jumps are easier to see in individual samples.                            
                                                                                
# Let's look at one sample trajectory                                           
states0 = data0['state']                                                        
print("States0 shape:", states0.shape)                                          
# Print some samples to see if there are clear jumps                            
for i in range(1, 100):                                                         
    if abs(states0[i, 1] - states0[i-1, 1]) > 0.5:                              
        print(f"Jump at index {i}: {states0[i-1, 1]} -> {states0[i, 1]},        
x1={states0[i-1, 0]}")                                                          
                                                                                
# Define modes based on conditions:                                             
# The task mentions x1=-1, x1=3, x2=1, x2=0.                                    
# Let's try to partition data.                                                  
def get_mode(x1, x2):                                                           
    if x1 < -1.0:                                                               
        return 0                                                                
    elif x1 >= -1.0 and x1 < 3.0:                                               
        return 1                                                                
    else:                                                                       
        return 2                                                                
                                                                                
# Actually, let's just inspect the derivatives.                                 
# Or check if mode depends on x2 reaching 1.0.                                  
                                                                                
modes = []                                                                      
for i in range(len(x1_c)):                                                      
    if x1_c[i] < -1.0:                                                          
        modes.append(0)                                                         
    elif x1_c[i] < 3.0:                                                         
        modes.append(1)                                                         
    else:                                                                       
        modes.append(2)                                                         
                                                                                
modes = np.array(modes)                                                         
                                                                                
def fit_mode(m_idx):                                                            
    mask = (modes == m_idx)                                                     
    # Exclude jumps                                                             
    jump_mask = np.abs(x2_n - x2_c) < 0.5                                       
