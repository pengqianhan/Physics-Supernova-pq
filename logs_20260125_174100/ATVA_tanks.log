    # Raw differences                                                           
    dx = np.diff(x, axis=0)                                                     
    # Mode identification (dx1 < 0 is Mode 1, dx1 > 0 is Mode 2)                
    dx1 = dx[:, 0]                                                              
    # Filter resets                                                             
    reset = np.abs(np.diff(x[:, 1])) > 0.5                                      
                                                                                
    m1_mask = (dx1 < 0) & (~reset)                                              
    m2_mask = (dx1 > 0) & (~reset)                                              
                                                                                
    # Features for x_i and u_1                                                  
    feat = np.hstack([x[:-1], u[:-1], np.ones((x.shape[0]-1, 1))])              
                                                                                
    all_m1_X.append(feat[m1_mask])                                              
    all_m1_Y1.append(dx[m1_mask, 0] / dt)                                       
    all_m1_Y2.append(dx[m1_mask, 1] / dt)                                       
    all_m2_X.append(feat[m2_mask])                                              
    all_m2_Y1.append(dx[m2_mask, 0] / dt)                                       
    all_m2_Y2.append(dx[m2_mask, 1] / dt)                                       
                                                                                
