import numpy as np                                                              
                                                                                
def fit_linear(X_mat, Y_vec):                                                   
    coeffs, _, _, _ = np.linalg.lstsq(X_mat, Y_vec, rcond=None)                 
    return coeffs                                                               
                                                                                
def solve():                                                                    
    dt = 0.001                                                                  
    all_A = []                                                                  
    all_B = []                                                                  
                                                                                
    for path in DATA_FILE_PATHS:                                                
        data = np.load(path)                                                    
        x = data['state']                                                       
        u = data['input']                                                       
                                                                                
        # Segment A: x1 decreases until it hits -1                              
        idx_A_end = np.where(x[0] <= -1.0)[0][0]                                
        # Use data from 0 to idx_A_end                                          
        xA = x[:, :idx_A_end+1]                                                 
        uA = u[:, :idx_A_end+1]                                                 
                                                                                
        # Segment B: from that point until x2 hits 1                            
        idx_B_start = idx_A_end + 1                                             
        idx_B_end_cands = np.where(x[1, idx_B_start:] >= 1.0)[0]                
        if len(idx_B_end_cands) > 0:                                            
            idx_B_end = idx_B_start + idx_B_end_cands[0]                        
        else:                                                                   
            idx_B_end = x.shape[1] - 1                                          
        xB = x[:, idx_B_start:idx_B_end+1]                                      
        uB = u[:, idx_B_start:idx_B_end+1]                                      
                                                                                
        # Compute derivatives for each segment separately                       
        def get_seg_coeffs(x_seg, u_seg):                                       
            if x_seg.shape[1] < 5: return None                                  
            # dx = (x[t+1] - x[t]) / dt                                         
            dx_seg = (x_seg[:, 1:] - x_seg[:, :-1]) / dt                        
            # Use states at t                                                   
            x_input = x_seg[:, :-1]                                             
            u_input = u_seg[:, :-1]                                             
                                                                                
            # Design matrix [x1, x2, u1, 1]                                     
            X = np.vstack([x_input[0], x_input[1], u_input[0],                  
np.ones(x_input.shape[1])]).T                                                   
                                                                                
            c1 = fit_linear(X, dx_seg[0])                                       
            c2 = fit_linear(X, dx_seg[1])                                       
            return np.concatenate([c1, c2])                                     
                                                                                
        all_A.append(get_seg_coeffs(xA, uA))                                    
        all_B.append(get_seg_coeffs(xB, uB))                                    
                                                                                
    avg_A = np.mean(all_A, axis=0)                                              
    avg_B = np.mean(all_B, axis=0)                                              
    print("Avg A:", avg_A)                                                      
    print("Avg B:", avg_B)                                                      
                                                                                
solve()                                                                         
                                                                                
