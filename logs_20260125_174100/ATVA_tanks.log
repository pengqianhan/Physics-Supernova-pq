  for path in ['data_all/ATVA/tanks/sample_0.npz',                              
  'data_all/ATVA/tanks/sample_1.npz', 'data_all/ATVA/tanks/sample_2.npz']:      
      d = np.load(path)                                                         
      all_data.append((d['state'], d['input']))                                 
                                                                                
  def get_segments(states, inputs):                                             
      x1, x2 = states[0, :], states[1, :]                                       
      u1 = inputs[0, :]                                                         
                                                                                
      window_size = 10                                                          
      errors = []                                                               
      for j in range(len(x1) - window_size - 1):                                
          X_win = np.column_stack([x1[j:j+window_size], x2[j:j+window_size],    
  u1[j:j+window_size], np.ones(window_size)])                                   
          Y_win = np.column_stack([x1[j+1:j+window_size+1],                     
  x2[j+1:j+window_size+1]])                                                     
          _, res, _, _ = np.linalg.lstsq(X_win, Y_win, rcond=None)              
          errors.append(np.sum(res))                                            
                                                                                
      # Clean switches                                                          
      sw = []                                                                   
      i = 0                                                                     
      threshold = 1e-10                                                         
      while i < len(errors):                                                    
          if errors[i] > threshold:                                             
              sw.append(i + window_size // 2)                                   
              i += window_size                                                  
          else:                                                                 
              i += 1                                                            
                                                                                
      sw = [0] + sw + [len(x1)]                                                 
      segments = []                                                             
      for j in range(len(sw)-1):                                                
          start, end = sw[j], sw[j+1]                                           
          if end - start > 5:                                                   
              segments.append((start, end))                                     
      return segments                                                           
                                                                                
  # Pooling data for the 3 modes based on the cycle observed                    
  # Mode 1: Segments 0, 3, 6...                                                 
  # Mode 2: Segments 1, 4, 7...                                                 
  # Mode 3: Segments 2, 5, 8...                                                 
                                                                                
  X_modes = {1: [], 2: [], 3: []}                                               
  Y_modes = {1: [], 2: [], 3: []}                                               
                                                                                
  for states, inputs in all_data:                                               
      x1, x2 = states[0, :], states[1, :]                                       
      u1 = inputs[0, :]                                                         
      segs = get_segments(states, inputs)                                       
      for i, (start, end) in enumerate(segs):                                   
          mode_idx = (i % 3) + 1                                                
          X_modes[mode_idx].append(np.column_stack([x1[start:end-1],            
  x2[start:end-1], u1[start:end-1], np.ones(end-start-1)]))                     
          Y_modes[mode_idx].append(np.column_stack([x1[start+1:end],            
  x2[start+1:end]]))                                                            
                                                                                
  coeffs = {}                                                                   
  for m in [1, 2, 3]:                                                           
      X = np.concatenate(X_modes[m])                                            
      Y = np.concatenate(Y_modes[m])                                            
      c, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)                            
      coeffs[m] = c                                                             
                                                                                
  print("Mode 1 Coeffs:\n", coeffs[1])                                          
  print("Mode 2 Coeffs:\n", coeffs[2])                                          
  print("Mode 3 Coeffs:\n", coeffs[3])                                          
                                                                                
  # Identify Guards and Resets from Sample 0                                    
  states0, inputs0 = all_data[0]                                                
  segs0 = get_segments(states0, inputs0)                                        
  for i in range(len(segs0)-1):                                                 
