def fit_ode(start_idx, end_idx):                                                
    # dx = (x[i+1] - x[i]) / dt                                                 
    # We have N points, so we have N-1 derivatives                              
    # Indices for state and input: [start_idx, end_idx-1]                       
    # Indices for next state: [start_idx+1, end_idx]                            
                                                                                
    # Slice data                                                                
