    print(f"Sample {i} resets at indices: {resets}")                            
    if len(resets) > 0:                                                         
        print(f"Values before reset: {x2[resets[:3]]}")                         
        print(f"Values after reset: {x2[resets[:3]+1]}")                        
                                                                                
