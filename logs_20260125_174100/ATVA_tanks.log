<code>                                                                          
import numpy as np                                                              
                                                                                
def analyze_data():                                                             
    data_files = ['data_all/ATVA/tanks/sample_0.npz',                           
'data_all/ATVA/tanks/sample_1.npz', 'data_all/ATVA/tanks/sample_2.npz']         
                                                                                
    mode1_data = [] # Stores [x1_t, x2_t, u_t, 1, x1_next, x2_next]             
    mode2_data = []                                                             
                                                                                
    resets = []                                                                 
                                                                                
    for file_path in data_files:                                                
        data = np.load(file_path)                                               
        states = data['state'] # (2, 10001)                                     
        inputs = data['input'] # (1, 10001)                                     
                                                                                
        # Determine initial mode                                                
        # If x2 just reset or is low after a potential high, we might be in Mode
1.                                                                              
        # But let's track state transitions.                                    
        # Mode 1: Started after x2 hits 1.0 (resets) until x1 hits -1.0.        
        # Mode 2: Started after x1 hits -1.0 until x2 hits 1.0.                 
                                                                                
        # We'll detect the first mode by looking for a transition or checking   
initial state.                                                                  
        # If x1 > -1.0 and x2 was recently reset, it's Mode 1.                  
        # If x2 < 1.0 and x1 was recently <= -1.0, it's Mode 2.                 
                                                                                
        current_mode = None                                                     
                                                                                
        for t in range(states.shape[1] - 1):                                    
            x1_t, x2_t = states[:, t]                                           
            u_t = inputs[0, t]                                                  
            x1_next, x2_next = states[:, t+1]                                   
                                                                                
            # Check for reset/mode switch                                       
            if x2_t >= 1.0:                                                     
                # Transition to Mode 1                                          
                current_mode = 1                                                
                resets.append(x2_next)                                          
                # Note: The transition step (x_t to x_next) where reset happens 
is the switch.                                                                  
                # The data point after reset belongs to Mode 1.                 
                continue                                                        
            elif x1_t <= -1.0:                                                  
                # Transition to Mode 2                                          
                current_mode = 2                                                
                # Data after switch belongs to Mode 2.                          
                continue                                                        
                                                                                
            # If mode is known, collect data                                    
            if current_mode == 1:                                               
                mode1_data.append([x1_t, x2_t, u_t, 1.0, x1_next, x2_next])     
            elif current_mode == 2:                                             
                mode2_data.append([x1_t, x2_t, u_t, 1.0, x1_next, x2_next])     
                                                                                
    def solve_mode(data):                                                       
        data = np.array(data)                                                   
        A = data[:, :4] # x1, x2, u, 1                                          
        b1 = data[:, 4] # x1_next                                               
        b2 = data[:, 5] # x2_next                                               
                                                                                
        # x_next = A * coeffs                                                   
        coeffs1, _, _, _ = np.linalg.lstsq(A, b1, rcond=None)                   
        coeffs2, _, _, _ = np.linalg.lstsq(A, b2, rcond=None)                   
                                                                                
        return coeffs1, coeffs2                                                 
                                                                                
    m1_c1, m1_c2 = solve_mode(mode1_data)                                       
    m2_c1, m2_c2 = solve_mode(mode2_data)                                       
                                                                                
    print("Resets average:", np.mean(resets))                                   
    print("Mode 1 coeffs:", m1_c1, m1_c2)                                       
    print("Mode 2 coeffs:", m2_c1, m2_c2)                                       
                                                                                
analyze_data()                                                                  
                                                                                
