import numpy as np                                                              
                                                                                
# Load Sample 0                                                                 
data = np.load(DATA_FILE_PATHS[0])                                              
state = data['state']                                                           
input_val = data['input']                                                       
                                                                                
x1 = state[0, :]                                                                
x2 = state[1, :]                                                                
u1 = input_val[0, :]                                                            
                                                                                
# Calculate differences as proxies for derivatives                              
dx1 = np.diff(x1)                                                               
dx2 = np.diff(x2)                                                               
                                                                                
# Identify mode changes by looking at where the derivative changes significantly
# Since the trajectory seems smooth within modes, we look for jumps in dx1 or   
dx2                                                                             
ddx1 = np.diff(dx1)                                                             
ddx2 = np.diff(dx2)                                                             
                                                                                
# Set thresholds for mode change detection (sharp changes in derivative)        
threshold_ddx1 = 10 * np.std(ddx1)                                              
threshold_ddx2 = 10 * np.std(ddx2)                                              
                                                                                
mode_changes = np.unique(np.concatenate([                                       
    np.where(np.abs(ddx1) > threshold_ddx1)[0],                                 
    np.where(np.abs(ddx2) > threshold_ddx2)[0]                                  
]))                                                                             
                                                                                
# Add start and end indices to define segments                                  
segment_indices = np.concatenate([[0], mode_changes + 1, [len(x1) - 1]])        
                                                                                
print(f"Detected mode change indices: {mode_changes}")                          
print(f"Segment boundaries: {segment_indices}")                                 
                                                                                
# Examine values at boundaries to find guards                                   
for idx in mode_changes:                                                        
    print(f"Transition at index {idx}:")                                        
    print(f"  x1: {x1[idx]:.4f}, x2: {x2[idx]:.4f}, u1: {u1[idx]:.4f}")         
    print(f"  dx1 change: {dx1[idx]:.6f} -> {dx1[idx+1]:.6f}")                  
    print(f"  dx2 change: {dx2[idx]:.6f} -> {dx2[idx+1]:.6f}")                  
                                                                                
# Check for resets (jumps in state values)                                      
# We already checked this, but let's confirm with a very small threshold        
threshold_reset = 0.01 # Since max diff was ~0.004                              
resets = np.where((np.abs(dx1) > threshold_reset) | (np.abs(dx2) >              
threshold_reset))[0]                                                            
print(f"Resets detected: {resets}")                                             
                                                                                
