def refine_ode_coefficients():                                                  
    import numpy as np                                                          
    from sklearn.linear_model import LinearRegression                           
                                                                                
    # Load data                                                                 
    data = np.load('data/train_0.npz')                                          
    x1 = data['state'][0, :]                                                    
    x2 = data['state'][1, :]                                                    
    u1 = data['input'][0, :]                                                    
    dt = 0.001                                                                  
                                                                                
    # Calculate derivatives                                                     
    dx1 = np.gradient(x1, dt)                                                   
    dx2 = np.gradient(x2, dt)                                                   
                                                                                
    # Segment 1: t < 1.5 (x1 falling, before first switch)                      
    idx1 = np.where(np.arange(len(x1)) * dt < 1.5)[0]                           
    X1 = np.column_stack([x1[idx1], u1[idx1]])                                  
    reg1_x1 = LinearRegression().fit(X1, dx1[idx1])                             
    reg1_x2 = LinearRegression().fit(np.column_stack([x1[idx1], x2[idx1],       
u1[idx1]]), dx2[idx1])                                                          
                                                                                
    # Segment 2: 1.5 < t < 4.0 (x1 rising)                                      
    idx2 = np.where((np.arange(len(x1)) * dt > 1.6) & (np.arange(len(x1)) * dt <
3.9))[0]                                                                        
    X2 = np.column_stack([x1[idx2], u1[idx2]])                                  
    reg2_x1 = LinearRegression().fit(X2, dx1[idx2])                             
    reg2_x2 = LinearRegression().fit(np.column_stack([x1[idx2], x2[idx2],       
u1[idx2]]), dx2[idx2])                                                          
                                                                                
    # Segment 3: 4.5 < t < 6.0 (x1 falling after reset)                         
    idx3 = np.where((np.arange(len(x1)) * dt > 4.5) & (np.arange(len(x1)) * dt <
5.8))[0]                                                                        
