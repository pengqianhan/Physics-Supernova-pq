        x = data['state'].T  # (10001, 2)                                       
        u = data['input'].T  # (10001, 1)                                       
                                                                                
        dx = np.diff(x, axis=0) / dt                                            
        x_mid = x[:-1]                                                          
        u_mid = u[:-1]                                                          
                                                                                
        # Mask resets: x2 jumps from ~1 to ~0                                   
        # The reset is x2 = 0 when x2 >= 1.0.                                   
        # So we look for x2[i] >= 0.9 and x2[i+1] < 0.1                         
        reset_mask = (x[:-1, 1] > 0.9) & (x[1:, 1] < 0.1)                       
                                                                                
        # Mode detection                                                        
        # Mode 1: x1 is decreasing                                              
        # Mode 2: x1 is increasing                                              
        # Let's use the difference to classify                                  
        dx1 = dx[:, 0]                                                          
                                                                                
        # Filter out reset points and transition points where derivative might  
be messy                                                                        
        # Also avoid the very first/last points of a mode to be safe            
                                                                                
        # Mode 1: dx1 < 0                                                       
        m1_mask = (dx1 < -1e-7) & (~reset_mask)                                 
        # Mode 2: dx1 > 1e-7                                                    
        m2_mask = (dx1 > 1e-7) & (~reset_mask)                                  
                                                                                
        ones = np.ones((x_mid.shape[0], 1))                                     
        features = np.hstack([x_mid, u_mid, ones])                              
                                                                                
        m1_X.append(features[m1_mask])                                          
        m1_Y1.append(dx[m1_mask, 0])                                            
        m1_Y2.append(dx[m1_mask, 1])                                            
                                                                                
        m2_X.append(features[m2_mask])                                          
        m2_Y1.append(dx[m2_mask, 0])                                            
        m2_Y2.append(dx[m2_mask, 1])                                            
                                                                                
    return np.vstack(m1_X), np.concatenate(m1_Y1), np.concatenate(m1_Y2), \     
