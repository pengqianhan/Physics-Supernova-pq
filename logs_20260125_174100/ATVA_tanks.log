    y2 = data[:, 4] # dx2                                                       
    reg2 = LinearRegression().fit(X2, y2)                                       
                                                                                
    return reg1.coef_, reg1.intercept_, reg2.coef_, reg2.intercept_             
                                                                                
falling_res = fit_model(falling_data)                                           
rising_res = fit_model(rising_data)                                             
                                                                                
