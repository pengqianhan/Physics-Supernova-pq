    non_reset = np.where(diffs2 > -0.5)[0]                                      
                                                                                
    X = np.vstack([x1[non_reset], x2[non_reset], u1[non_reset],                 
np.ones_like(x1[non_reset])]).T                                                 
                                                                                
    # Solve for dx1                                                             
    coeffs1, resid1, rank1, s1 = np.linalg.lstsq(X, dx1[non_reset], rcond=None) 
    # Solve for dx2                                                             
    coeffs2, resid2, rank2, s2 = np.linalg.lstsq(X, dx2[non_reset], rcond=None) 
                                                                                
    return coeffs1, coeffs2                                                     
                                                                                
