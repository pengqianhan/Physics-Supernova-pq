import numpy as np                                                              
                                                                                
def analyze_file(file_path):                                                    
    data = np.load(file_path)                                                   
    state = data['state']                                                       
    input_data = data['input']                                                  
    x1, x2, u1 = state[0], state[1], input_data[0]                              
    dx1 = np.diff(x1)                                                           
                                                                                
    # Identify rising/falling segments                                          
    modes = []                                                                  
    current_mode = "rising" if dx1[0] > 0 else "falling"                        
    start = 0                                                                   
    for i in range(1, len(dx1)):                                                
        mode = "rising" if dx1[i] > 0 else "falling"                            
        if mode != current_mode:                                                
            modes.append((start, i, current_mode))                              
            start = i                                                           
            current_mode = mode                                                 
    modes.append((start, len(dx1), current_mode))                               
                                                                                
    # Filter out very short noisy segments                                      
    filtered_modes = [modes[0]]                                                 
    for m in modes[1:]:                                                         
        if m[1] - m[0] > 100:                                                   
            if m[2] == filtered_modes[-1][2]:                                   
                filtered_modes[-1] = (filtered_modes[-1][0], m[1], m[2])        
            else:                                                               
                filtered_modes.append(m)                                        
        else:                                                                   
            # Merge with previous                                               
            filtered_modes[-1] = (filtered_modes[-1][0], m[1],                  
filtered_modes[-1][2])                                                          
                                                                                
    print(f"\nAnalysis for {file_path}:")                                       
    for i, (s, e, m) in enumerate(filtered_modes):                              
        Y1 = x1[s+1:e+1]                                                        
        X1 = np.column_stack([x1[s:e], u1[s:e], np.ones(e-s)])                  
        c1, _, _, _ = np.linalg.lstsq(X1, Y1, rcond=None)                       
                                                                                
        Y2 = x2[s+1:e+1]                                                        
        X2 = np.column_stack([x1[s:e], x2[s:e], u1[s:e], np.ones(e-s)])         
        c2, _, _, _ = np.linalg.lstsq(X2, Y2, rcond=None)                       
                                                                                
        print(f"Mode {i} ({m}, {s} to {e}):")                                   
        print(f"  x1: a={c1[0]:.6f}, b={c1[1]:.6f}, c={c1[2]:.6f}")             
        print(f"  x2: d={c2[0]:.6f}, e={c2[1]:.6f}, f={c2[2]:.6f},              
g={c2[3]:.6f}")                                                                 
        if e < len(x1):                                                         
            print(f"  Exit: x1={x1[e]:.4f}, x2={x2[e]:.4f}, u1={u1[e]:.4f}")    
                                                                                
analyze_file('data_all/ATVA/tanks/sample_0.npz')                                
                                                                                
