import numpy as np                                                              
import pandas as pd                                                             
                                                                                
# Load the data and compute derivatives                                         
all_dfs = []                                                                    
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    t = data['t'].flatten()                                                     
    x = data['x']                                                               
    u = data['u']                                                               
                                                                                
    dt = np.diff(t)                                                             
    dx = np.diff(x, axis=0)                                                     
    dxdt = dx / dt[:, np.newaxis]                                               
                                                                                
    # Align states with derivatives (using the state at the start of the        
interval)                                                                       
    df = pd.DataFrame({                                                         
        't': t[:-1],                                                            
        'x1': x[:-1, 0],                                                        
        'x2': x[:-1, 1],                                                        
        'u1': u[:-1].flatten(),                                                 
        'dx1': dxdt[:, 0],                                                      
        'dx2': dxdt[:, 1]                                                       
    })                                                                          
    all_dfs.append(df)                                                          
                                                                                
df = pd.concat(all_dfs, ignore_index=True)                                      
                                                                                
# Segregate data based on the provided model's characteristics                  
# Mode 1 & 3 have dx1 ~ -x1 + u1 - 2                                            
# Mode 2 has dx1 ~ -x1 + u1 + 3                                                 
# Let's use the error in the Mode 1/3 dx1 equation to separate Mode 2           
err_m13_dx1 = df['dx1'] - (-1.0 * df['x1'] + 1.0 * df['u1'] - 2.0)              
df['mode'] = 1 # default                                                        
df.loc[err_m13_dx1 > 2.5, 'mode'] = 2                                           
                                                                                
# Distinguish between Mode 1 and Mode 3 using dx2                               
# Mode 1: dx2 ~ x1 + u1                                                         
# Mode 3: dx2 ~ x1 - x2 + u1 - 5                                                
# Let's use the error in the Mode 1 dx2 equation                                
err_m1_dx2 = df['dx2'] - (1.0 * df['x1'] + 1.0 * df['u1'])                      
df.loc[(df['mode'] == 1) & (err_m1_dx2 < -2.5), 'mode'] = 3                     
                                                                                
def refine_mode(data):                                                          
    # Form matrix A: [x1, x2, u1, 1]                                            
    A = np.column_stack([data['x1'], data['x2'], data['u1'],                    
np.ones(len(data))])                                                            
    y1 = data['dx1'].values                                                     
    y2 = data['dx2'].values                                                     
                                                                                
    # Solve A * beta = y                                                        
    beta1, _, _, _ = np.linalg.lstsq(A, y1, rcond=None)                         
    beta2, _, _, _ = np.linalg.lstsq(A, y2, rcond=None)                         
    return beta1, beta2                                                         
                                                                                
refined_params = {}                                                             
for m in [1, 2, 3]:                                                             
    m_data = df[df['mode'] == m]                                                
    if len(m_data) > 0:                                                         
        b1, b2 = refine_mode(m_data)                                            
        refined_params[m] = {'dx1': b1, 'dx2': b2}                              
                                                                                
print("Refined Parameters (a, b, c, d) and (e, f, g, h):")                      
for m, params in refined_params.items():                                        
    print(f"Mode {m}: dx1={params['dx1']}, dx2={params['dx2']}")                
                                                                                
# Refine guards: Check transitions                                              
df['prev_mode'] = df['mode'].shift(1)                                           
transitions = df[df['mode'] != df['prev_mode']].dropna()                        
                                                                                
guard_stats = []                                                                
for idx, row in transitions.iterrows():                                         
    guard_stats.append({                                                        
        'from': row['prev_mode'],                                               
        'to': row['mode'],                                                      
        'x1': row['x1'],                                                        
        'x2': row['x2']                                                         
    })                                                                          
                                                                                
gs_df = pd.DataFrame(guard_stats)                                               
print("\nTransition Statistics (Mean of x at change):")                         
print(gs_df.groupby(['from', 'to']).mean())                                     
                                                                                
