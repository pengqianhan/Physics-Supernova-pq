import numpy as np                                                              
from scipy import stats                                                         
                                                                                
def detect_change_points(signal, window_size=50, threshold=5.0):                
    changes = []                                                                
    for i in range(window_size, len(signal) - window_size):                     
        left_mean = np.mean(signal[i-window_size:i])                            
        right_mean = np.mean(signal[i:i+window_size])                           
        left_std = np.std(signal[i-window_size:i]) + 1e-9                       
                                                                                
        # Z-score of the right_mean relative to left distribution               
        z = np.abs(right_mean - left_mean) / left_std                           
        if z > threshold:                                                       
            changes.append(i)                                                   
                                                                                
    # Cluster changes                                                           
    if not changes: return []                                                   
    clustered_changes = [changes[0]]                                            
    for i in range(1, len(changes)):                                            
        if changes[i] > clustered_changes[-1] + window_size:                    
            clustered_changes.append(changes[i])                                
    return clustered_changes                                                    
                                                                                
# Try to find transitions based on dx1 and dx2                                  
# Since the coefficients depend on x1, x2, u1, maybe we should look at the      
residuals                                                                       
# of a linear fit.                                                              
# Let's try fitting a global model first and look at where it fails.            
X = np.column_stack([x1[:-1], u1[:-1], np.ones(len(x1)-1)])                     
coeffs1, residuals1, rank1, s1 = np.linalg.lstsq(X, dx1, rcond=None)            
print("Global coeffs for dx1:", coeffs1)                                        
                                                                                
# Look at residuals                                                             
res1 = dx1 - X.dot(coeffs1)                                                     
change_points = detect_change_points(res1, window_size=100, threshold=10.0)     
print("Detected change points in dx1 residuals:", change_points)                
                                                                                
# Let's also check dx2                                                          
X2 = np.column_stack([x1[:-1], x2[:-1], u1[:-1], np.ones(len(x1)-1)])           
coeffs2, residuals2, rank2, s2 = np.linalg.lstsq(X2, dx2, rcond=None)           
print("Global coeffs for dx2:", coeffs2)                                        
res2 = dx2 - X2.dot(coeffs2)                                                    
change_points2 = detect_change_points(res2, window_size=100, threshold=10.0)    
print("Detected change points in dx2 residuals:", change_points2)               
                                                                                
# Combine and refine change points                                              
all_changes = sorted(list(set(change_points + change_points2)))                 
print("Combined change points:", all_changes)                                   
                                                                                
