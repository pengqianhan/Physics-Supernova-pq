import numpy as np                                                              
                                                                                
def get_data_split(all_states, all_inputs, condition_func):                     
    x_list = []                                                                 
    u_list = []                                                                 
    dx_list = []                                                                
    dt = 0.01                                                                   
    for s, i in zip(all_states, all_inputs):                                    
        x1, x2 = s[0, :], s[1, :]                                               
        u1 = i[0, :]                                                            
        mask = condition_func(s[:, :-1])                                        
        if np.any(mask):                                                        
            x_list.append(s[:, :-1][:, mask])                                   
            u_list.append(i[:, :-1][:, mask])                                   
            dx1 = (x1[1:] - x1[:-1]) / dt                                       
            dx2 = (x2[1:] - x2[:-1]) / dt                                       
            dx_list.append(np.vstack([dx1[mask], dx2[mask]]))                   
                                                                                
    if not x_list:                                                              
        return None, None, None                                                 
    return np.hstack(x_list), np.hstack(u_list), np.hstack(dx_list)             
                                                                                
def fit_linear(X_data, U_data, DX_data):                                        
    # DX = A*X + B*U + C                                                        
    # [dx1, dx2]^T = [a b; e f] * [x1, x2]^T + [c; g] * [u1] + [d; h]           
    # We solve for each row of [A B C]                                          
    # Target is DX_data[0, :] and DX_data[1, :]                                 
                                                                                
    # Feature matrix: [x1, x2, u1, 1]                                           
    M = np.vstack([X_data, U_data, np.ones(X_data.shape[1])]).T                 
                                                                                
    coeffs1 = np.linalg.lstsq(M, DX_data[0, :], rcond=None)[0]                  
    coeffs2 = np.linalg.lstsq(M, DX_data[1, :], rcond=None)[0]                  
                                                                                
    return coeffs1, coeffs2                                                     
                                                                                
# Modes based on x2 sign                                                        
cond_neg = lambda x: x[1, :] < 0                                                
cond_pos = lambda x: x[1, :] >= 0                                               
                                                                                
Xn, Un, DXn = get_data_split(all_states, all_inputs, cond_neg)                  
if Xn is not None:                                                              
    c1n, c2n = fit_linear(Xn, Un, DXn)                                          
