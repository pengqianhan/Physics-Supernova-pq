        # Find first index where x1 <= -1.0                                     
        idx_A_end = np.where(x1 <= -1.0)[0][0]                                  
        segA_mask = np.arange(0, idx_A_end + 1)                                 
                                                                                
        # Segment B: from idx_A_end until x2 reaches 1.0 (reset)                
        # Find first index after idx_A_end where x2 >= 1.0                      
