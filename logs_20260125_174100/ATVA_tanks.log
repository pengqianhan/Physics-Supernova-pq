import numpy as np                                                              
import pandas as pd                                                             
from sklearn.linear_model import LinearRegression                               
                                                                                
# Load data                                                                     
all_states = []                                                                 
all_inputs = []                                                                 
dt = 0.001                                                                      
                                                                                
for path in DATA_FILE_PATHS:                                                    
    data = np.load(path)                                                        
    all_states.append(data['state'])                                            
    all_inputs.append(data['input'])                                            
                                                                                
# Concatenate or process sequentially? Let's process each trajectory to get     
derivatives                                                                     
X1_dot_list, X2_dot_list = [], []                                               
X1_list, X2_list, U1_list = [], [], []                                          
                                                                                
for s, u in zip(all_states, all_inputs):                                        
    # s is [N, 2], u is [N, 1]                                                  
    x1 = s[:, 0]                                                                
    x2 = s[:, 1]                                                                
    u1 = u[:, 0]                                                                
                                                                                
    # Finite differences for derivatives                                        
    dx1 = np.diff(x1) / dt                                                      
    dx2 = np.diff(x2) / dt                                                      
                                                                                
    # Store aligned data (N-1 points)                                           
    X1_dot_list.append(dx1)                                                     
    X2_dot_list.append(dx2)                                                     
    X1_list.append(x1[:-1])                                                     
    X2_list.append(x2[:-1])                                                     
    U1_list.append(u1[:-1])                                                     
                                                                                
# Combine all data                                                              
X1_dot = np.concatenate(X1_dot_list)                                            
X2_dot = np.concatenate(X2_dot_list)                                            
X1 = np.concatenate(X1_list)                                                    
X2 = np.concatenate(X2_list)                                                    
U1 = np.concatenate(U1_list)                                                    
                                                                                
# Mode partitioning logic                                                       
# 1 -> 2 when x1 <= -1.0                                                        
# 2 -> 3 when x2 >= 1.0                                                         
# 3 -> 1 when x2 <= 0.0                                                         
# 1 -> 3 when x2 >= 1.0                                                         
# 3 -> 2 when x1 <= -1.0                                                        
                                                                                
modes = np.zeros(len(X1), dtype=int)                                            
current_mode = 1 # Initial mode assumption (need to check actual start)         
                                                                                
# State machine for mode assignment                                             
for i in range(len(X1)):                                                        
    # Check transitions                                                         
    if current_mode == 1:                                                       
        if X1[i] <= -1.0: current_mode = 2                                      
        elif X2[i] >= 1.0: current_mode = 3                                     
    elif current_mode == 2:                                                     
        if X2[i] >= 1.0: current_mode = 3                                       
    elif current_mode == 3:                                                     
        if X2[i] <= 0.0: current_mode = 1                                       
        elif X1[i] <= -1.0: current_mode = 2                                    
    modes[i] = current_mode                                                     
                                                                                
# Linear Regression for each mode                                               
results = {}                                                                    
for m in [1, 2, 3]:                                                             
    mask = (modes == m)                                                         
    if np.sum(mask) < 2:                                                        
        results[m] = "Insufficient data"                                        
        continue                                                                
                                                                                
    # Target 1: x1_dot = a*x1 + b*u1 + c                                        
    Y1 = X1_dot[mask]                                                           
    A1 = np.column_stack([X1[mask], U1[mask], np.ones(np.sum(mask))])           
    reg1 = LinearRegression(fit_intercept=False).fit(A1, Y1)                    
    a, b, c = reg1.coef_                                                        
                                                                                
    # Target 2: x2_dot = d*x1 + e*x2 + f*u1 + g                                 
    Y2 = X2_dot[mask]                                                           
    A2 = np.column_stack([X1[mask], X2[mask], U1[mask], np.ones(np.sum(mask))]) 
    reg2 = LinearRegression(fit_intercept=False).fit(A2, Y2)                    
    d, e, f, g = reg2.coef_                                                     
                                                                                
    results[m] = {'a': a, 'b': b, 'c': c, 'd': d, 'e': e, 'f': f, 'g': g}       
                                                                                
# Identify precise thresholds                                                   
# By looking at where transitions occur                                         
thresh_x1_low = np.min(X1[modes == 2])                                          
thresh_x2_high = np.max(X2[modes == 1]) # or 2                                  
thresh_x2_low = np.min(X2[modes == 3])                                          
                                                                                
print(f"Results: {results}")                                                    
print(f"Thresholds candidate: x1_low ~ {thresh_x1_low}, x2_high ~               
{thresh_x2_high}, x2_low ~ {thresh_x2_low}")                                    
                                                                                
# Final Answer formatting                                                       
output = f"""### 1. Task outcome (short version):                               
