import numpy as np                                                              
import pandas as pd                                                             
                                                                                
def load_data(file_paths):                                                      
    all_states = []                                                             
    all_inputs = []                                                             
    for path in file_paths:                                                     
        data = np.load(path)                                                    
        all_states.append(data['state'])                                        
        all_inputs.append(data['input'])                                        
    return all_states, all_inputs                                               
                                                                                
file_paths = ['data_all/ATVA/tanks/sample_0.npz',                               
'data_all/ATVA/tanks/sample_1.npz', 'data_all/ATVA/tanks/sample_2.npz']         
states, inputs = load_data(file_paths)                                          
                                                                                
# Let's inspect the first few values and check for resets in x2                 
for i, s in enumerate(states):                                                  
    x1 = s[0, :]                                                                
    x2 = s[1, :]                                                                
    u1 = inputs[i][0, :]                                                        
                                                                                
    # Check for resets: x2 jumps from near 1.0 to near 0.0                      
