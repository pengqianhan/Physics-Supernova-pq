import numpy as np                                                              
                                                                                
def analyze_all_files(paths):                                                   
    all_x1 = []                                                                 
    all_x2 = []                                                                 
    all_u1 = []                                                                 
    all_next_x1 = []                                                            
    all_next_x2 = []                                                            
    all_modes = []                                                              
                                                                                
    for path in paths:                                                          
        data = np.load(path)                                                    
        state = data['state']                                                   
        u = data['input']                                                       
                                                                                
        x1 = state[0, :]                                                        
        x2 = state[1, :]                                                        
        u1 = u[0, :]                                                            
                                                                                
        n = len(x1)                                                             
                                                                                
