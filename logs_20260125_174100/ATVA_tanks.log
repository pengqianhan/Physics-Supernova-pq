        # Mode 1: x1 > -1.0 (initially)                                         
        # Mode 2: x1 <= -1.0                                                    
        # Wait, the prompt says "A mode switch occurs when x1 reaches -1.0"     
        # and "This reset of x2 also causes a mode switch in x1".               
        # This implies the mode is a state variable itself.                     
                                                                                
        current_mode = 1 # Assume start in Mode 1                               
        for i in range(n - 1):                                                  
            # Check for reset in x2                                             
            # Reset occurs when x2 reaches 1.0                                  
            is_reset = False                                                    
            if x2[i] >= 0.99 and x2[i+1] < 0.1:                                 
                is_reset = True                                                 
                                                                                
            # Mode switch logic                                                 
            if current_mode == 1 and x1[i] <= -1.0:                             
                current_mode = 2                                                
            elif is_reset:                                                      
                # Prompt: "This reset of x2 also causes a mode switch in x1."   
                # If we were in mode 2, go to 1. If 1, go to 2?                 
                # Usually it's a toggle or a specific transition.               
                current_mode = 1 if current_mode == 2 else 2                    
                                                                                
            # If a reset happened, x[i+1] is the reset value.                   
            # For ODE estimation, we only want points where no reset/switch     
happened between i and i+1?                                                     
            # Actually, the prompt asks for ODEs "in each identified mode".     
            # So we look at (x[i], u[i]) -> x[i+1] where no discrete event      
occurred.                                                                       
                                                                                
            # Transition check                                                  
            if not is_reset and not (current_mode == 1 and x1[i+1] <= -1.0):    
                 all_x1.append(x1[i])                                           
                 all_x2.append(x2[i])                                           
                 all_u1.append(u1[i])                                           
                 all_next_x1.append(x1[i+1])                                    
                 all_next_x2.append(x2[i+1])                                    
                 all_modes.append(current_mode)                                 
                                                                                
    return np.array(all_x1), np.array(all_x2), np.array(all_u1), \              
           np.array(all_next_x1), np.array(all_next_x2), np.array(all_modes)    
                                                                                
