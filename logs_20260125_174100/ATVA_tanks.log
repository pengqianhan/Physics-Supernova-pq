                segments.append({                                               
                    'x': x[current_segment_start:i+1],                          
                    'u': u[current_segment_start:i+1],                          
                    'mode_x1': 'high' if x[current_segment_start, 0] > -1.0 else
'low'                                                                           
                })                                                              
            current_segment_start = i + 1                                       
    # Add last segment                                                          
    if N - 1 > current_segment_start:                                           
        segments.append({                                                       
            'x': x[current_segment_start:],                                     
            'u': u[current_segment_start:],                                     
            'mode_x1': 'high' if x[current_segment_start, 0] > -1.0 else 'low'  
        })                                                                      
                                                                                
# Now group data points by mode and fit                                         
def fit_mode(mode_segments):                                                    
    X_train = []                                                                
    Y_train_x1 = []                                                             
    Y_train_x2 = []                                                             
    for seg in mode_segments:                                                   
        x_seg = seg['x']                                                        
        u_seg = seg['u']                                                        
        # x[t+1] = A*x[t] + B*u[t] + C                                          
        # Feature vector: [x1(t), x2(t), u1(t), 1]                              
        for t in range(len(x_seg) - 1):                                         
            X_train.append([x_seg[t, 0], x_seg[t, 1], u_seg[t, 0]])             
            Y_train_x1.append(x_seg[t+1, 0])                                    
            Y_train_x2.append(x_seg[t+1, 1])                                    
                                                                                
    if not X_train: return None                                                 
                                                                                
    model_x1 = LinearRegression().fit(X_train, Y_train_x1)                      
    model_x2 = LinearRegression().fit(X_train, Y_train_x2)                      
                                                                                
    return {                                                                    
        'x1_coeffs': model_x1.coef_.tolist() + [model_x1.intercept_],           
        'x2_coeffs': model_x2.coef_.tolist() + [model_x2.intercept_]            
    }                                                                           
                                                                                
high_segments = [s for s in segments if s['mode_x1'] == 'high']                 
low_segments = [s for s in segments if s['mode_x1'] == 'low']                   
                                                                                
print("High segments count:", len(high_segments))                               
print("Low segments count:", len(low_segments))                                 
                                                                                
res_high = fit_mode(high_segments)                                              
res_low = fit_mode(low_segments)                                                
                                                                                
