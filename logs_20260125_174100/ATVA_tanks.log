  def solve_ode_coeffs(t, x, u):                                                
      # x is (N, 2), u is (N, 1) or (N,)                                        
      dt = t[1] - t[0]                                                          
      dx = np.diff(x, axis=0) / dt                                              
                                                                                
      # We use x[i] and u[i] to predict dx[i] (which is (x[i+1]-x[i])/dt)       
      x_mid = x[:-1]                                                            
      u_mid = u[:-1]                                                            
      if u_mid.ndim == 1:                                                       
          u_mid = u_mid[:, np.newaxis]                                          
                                                                                
      # Identify modes based on dx1/dt                                          
      # Mode 1: dx1/dt < 0                                                      
      # Mode 2: dx1/dt > 0                                                      
                                                                                
      # Filter points near resets (x2 jumps) or mode transitions                
      # Reset: x2 jumps from >=1.0 to 0.                                        
      # We should exclude indices where |x2[i+1] - x2[i]| is large              
      # or where the mode changes.                                              
                                                                                
      dx1 = dx[:, 0]                                                            
      dx2 = dx[:, 1]                                                            
                                                                                
      # Mask for reset                                                          
      # A reset happens if x2[i] >= 1.0 and x2[i+1] is around 0.                
      # Let's detect large jumps in x2.                                         
      reset_mask = np.abs(np.diff(x[:, 1])) > 0.5                               
                                                                                
      # Mask for mode transitions based on x1                                   
      # Mode 1 -> 2 when x1 <= -1.0                                             
      # Mode 2 -> 1 when x2 >= 1.0                                              
                                                                                
      # Let's classify based on the sign of dx1                                 
      mode1_indices = np.where((dx1 < -1e-5) & (~reset_mask))[0]                
      mode2_indices = np.where((dx1 > 1e-5) & (~reset_mask))[0]                 
                                                                                
      return mode1_indices, mode2_indices, x_mid, u_mid, dx                     
                                                                                
