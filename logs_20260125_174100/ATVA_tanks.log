        dx1 = np.diff(x1) / dt                                                  
        dx2 = np.diff(x2) / dt                                                  
                                                                                
        # We lose one point with diff, so align                                 
        x1_mid = x1[:-1]                                                        
        x2_mid = x2[:-1]                                                        
        u1_mid = u1[:-1]                                                        
                                                                                
        # Identify segment boundaries                                           
        # 1. Reset: x2 jumps from near 1.0 to near 0.0                          
        # 2. Mode switch: x1 crosses -1.0                                       
                                                                                
        boundaries = [0]                                                        
        for i in range(1, len(x1) - 1):                                         
            # Check for reset in x2 (large negative jump)                       
            if x2[i] > 0.9 and x2[i+1] < 0.1:                                   
                boundaries.append(i+1)                                          
            # Check for x1 crossing -1.0                                        
            # It might just touch it or stay there, but the prompt says         
"reaches"                                                                       
            # Let's detect the sign change of (x1 + 1.0)                        
            if (x1[i-1] > -1.0 and x1[i] <= -1.0) or (x1[i-1] < -1.0 and x1[i]  
>= -1.0):                                                                       
                boundaries.append(i)                                            
                                                                                
        boundaries.append(len(x1) - 1)                                          
        boundaries = sorted(list(set(boundaries)))                              
                                                                                
        for i in range(len(boundaries) - 1):                                    
            start, end = boundaries[i], boundaries[i+1]                         
            if end - start < 5: continue # Skip very short segments             
                                                                                
            seg_x1 = x1[start:end]                                              
            seg_x2 = x2[start:end]                                              
            seg_u1 = u1[start:end]                                              
                                                                                
            # Use mid points for derivatives alignment                          
            seg_dx1 = dx1[start:end-1]                                          
            seg_dx2 = dx2[start:end-1]                                          
            seg_x1_m = x1[start:end-1]                                          
            seg_x2_m = x2[start:end-1]                                          
            seg_u1_m = u1[start:end-1]                                          
                                                                                
            # Determine mode based on state                                     
            # Mode A: x1 > -1.0                                                 
            # Mode B: x1 < -1.0                                                 
            avg_x1 = np.mean(seg_x1)                                            
            mode_id = "A" if avg_x1 > -1.0 else "B"                             
                                                                                
            all_segments.append({                                               
                'mode': mode_id,                                                
                'dx1': seg_dx1,                                                 
                'dx2': seg_dx2,                                                 
                'x1': seg_x1_m,                                                 
                'x2': seg_x2_m,                                                 
                'u1': seg_u1_m                                                  
            })                                                                  
                                                                                
    return all_segments                                                         
                                                                                
data_paths = DATA_FILE_PATHS                                                    
