all_inputs = []                                                                 
                                                                                
for file in data_files:                                                         
    data = np.load(file)                                                        
    all_states.append(data['state'])                                            
    all_inputs.append(data['input'])                                            
                                                                                
# For the first file, calculate the difference between consecutive states to    
check for resets or transitions                                                 
