    u = data['u'] # Likely shape (N, 1)                                         
                                                                                
    # Calculate derivatives                                                     
    dt = np.diff(t)                                                             
    dx = np.diff(x, axis=0)                                                     
    dxdt = dx / dt[:, np.newaxis]                                               
                                                                                
    # Align x and u with dxdt (use the start of the interval)                   
    x_aligned = x[:-1]                                                          
    u_aligned = u[:-1]                                                          
                                                                                
    df = pd.DataFrame({                                                         
        't': t[:-1],                                                            
        'x1': x_aligned[:, 0],                                                  
        'x2': x_aligned[:, 1],                                                  
        'u1': u_aligned.flatten(),                                              
        'dx1': dxdt[:, 0],                                                      
        'dx2': dxdt[:, 1]                                                       
    })                                                                          
    all_data.append(df)                                                         
                                                                                
