            switches.append(i)                                                  
                                                                                
    segment_indices = sorted(list(set([0] + switches + [len(x1)])))             
                                                                                
    file_results = []                                                           
    for i in range(len(segment_indices) - 1):                                   
        start, end = segment_indices[i], segment_indices[i+1]                   
        if end - start < 20: continue                                           
                                                                                
        x1_s = x1[start:end]                                                    
        x2_s = x2[start:end]                                                    
        u1_s = u1[start:end]                                                    
                                                                                
        dx1 = np.diff(x1_s) / dt                                                
        dx2 = np.diff(x2_s) / dt                                                
                                                                                
        x1_f = x1_s[:-1]                                                        
        x2_f = x2_s[:-1]                                                        
        u1_f = u1_s[:-1]                                                        
                                                                                
        X1 = np.column_stack([x1_f, u1_f, np.ones_like(x1_f)])                  
        c1, _, _, _ = np.linalg.lstsq(X1, dx1, rcond=None)                      
                                                                                
        X2 = np.column_stack([x1_f, x2_f, u1_f, np.ones_like(x1_f)])            
        c2, _, _, _ = np.linalg.lstsq(X2, dx2, rcond=None)                      
                                                                                
        file_results.append({                                                   
