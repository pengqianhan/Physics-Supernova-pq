    Y = np.vstack(Y_list)                                                       
                                                                                
    feat = np.column_stack([X_p, U_p, np.ones(len(X_p))])                       
    coeffs, _, _, _ = np.linalg.lstsq(feat, Y, rcond=None)                      
    final_params[m] = coeffs.T                                                  
                                                                                
