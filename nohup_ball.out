import numpy as np                                                              
                                                                                
# Load the first sample                                                         
data = np.load('data_all/ATVA/ball/sample_0.npz')                               
print("Keys in sample_0.npz:", list(data.keys()))                               
                                                                                
# Assuming keys are 't', 'x' where x is (N, 2)                                  
t = data['t']                                                                   
x = data['x']                                                                   
                                                                                
x1 = x[:, 0]                                                                    
x2 = x[:, 1]                                                                    
dt = t[1] - t[0]                                                                
                                                                                
# 1. Calculate gravity (acceleration during flight)                             
# Identify flight phases: when no bounce is happening.                          
# A bounce is a discontinuity in x2.                                            
dx2 = np.diff(x2)                                                               
accel = dx2 / dt                                                                
                                                                                
# Filter out the bounce spikes to find gravity                                  
# Gravity should be constant and negative.                                      
gravity_estimates = accel[np.abs(accel) < 20] # Bounces will have huge positive 
accel                                                                           
g = np.mean(gravity_estimates)                                                  
                                                                                
# 2. Identify bounce events                                                     
# Bounce: x2 changes from negative to positive suddenly                         
bounces = []                                                                    
for i in range(len(x2) - 1):                                                    
    if x2[i] < 0 and x2[i+1] > 0:                                               
        bounces.append(i)                                                       
                                                                                
# 3. Determine restitution coefficient                                          
restitutions = []                                                               
for idx in bounces:                                                             
    v_before = x2[idx]                                                          
    v_after = x2[idx+1]                                                         
    e = -v_after / v_before                                                     
    restitutions.append(e)                                                      
                                                                                
avg_e = np.mean(restitutions)                                                   
                                                                                
# 4. Check state at bounce                                                      
bounce_states = [(x1[idx], x2[idx]) for idx in bounces]                         
                                                                                
print(f"Gravity: {g}")                                                          
print(f"Bounces detected at indices: {bounces}")                                
print(f"Restitution coefficients: {restitutions}")                              
print(f"Average Restitution: {avg_e}")                                          
print(f"States at bounce: {bounce_states}")                                     
                                                                                
