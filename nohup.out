import numpy as np                                                              
from scipy.signal import find_peaks                                             
# import matplotlib.pyplot as plt # Keep imports minimal if not strictly needed 
now                                                                             
                                                                                
data_path = DATA_FILE_PATHS[0]                                                  
loaded_data = np.load(data_path)                                                
                                                                                
keys = list(loaded_data.keys())                                                 
print(f"Data keys found: {keys}")                                               
                                                                                
# Based on observation, shape is (2, 10001), so x1 and x2 are rows, likely under
'state'.                                                                        
if 'state' in loaded_data:                                                      
    full_data = loaded_data['state']                                            
elif keys:                                                                      
    full_data = loaded_data[keys[0]]                                            
else:                                                                           
    raise ValueError("Could not identify the array containing state data.")     
                                                                                
print(f"Shape of time series data: {full_data.shape}")                          
# Correction: x1 is row 0, x2 is row 1, N = time steps                          
x1 = full_data[0, :]                                                            
x2 = full_data[1, :]                                                            
N = len(x1)                                                                     
                                                                                
# Step 3: Calculate derivatives                                                 
x2_dot_approx = np.gradient(x2)                                                 
                                                                                
# Step 4: Identify relevant segments.                                           
x1_min_val = np.min(x1)                                                         
x1_max_val = np.max(x1)                                                         
amplitude = x1_max_val - x1_min_val                                             
threshold = x1_min_val + 0.05 * amplitude                                       
                                                                                
mask = x1 > threshold                                                           
buffer = 10                                                                     
if N > 2 * buffer:                                                              
    mask[:buffer] = False                                                       
    mask[-buffer:] = False                                                      
                                                                                
x1_fit = x1[mask]                                                               
x2_fit = x2[mask]                                                               
x2_dot_fit = x2_dot_approx[mask]                                                
                                                                                
Y = x2_dot_fit                                                                  
X = np.vstack([x1_fit, x2_fit]).T                                               
                                                                                
# Step 5: Perform linear regression                                             
a_est, b_est = None, None                                                       
r_squared = -1.0                                                                
                                                                                
try:                                                                            
    if X.shape[0] > 2:                                                          
        params, residuals, rank, s = np.linalg.lstsq(X, Y, rcond=None)          
        a_est, b_est = params                                                   
                                                                                
        print(f"Estimated parameter a: {a_est}")                                
        print(f"Estimated parameter b: {b_est}")                                
                                                                                
        Y_pred = np.dot(X, params)                                              
        ss_total = np.sum((Y - np.mean(Y))**2)                                  
        if ss_total > 1e-9:                                                     
            ss_residual = np.sum((Y - Y_pred)**2)                               
            r_squared = 1 - (ss_residual / ss_total)                            
        else:                                                                   
            r_squared = 1.0 if ss_residual < 1e-9 else 0.0                      
                                                                                
        print(f"R-squared for the fit: {r_squared}")                            
    else:                                                                       
        print("Not enough data points after filtering to perform regression.")  
                                                                                
except np.linalg.LinAlgError as e:                                              
    print(f"Linear algebra error during fitting: {e}")                          
except Exception as e:                                                          
    print(f"An unexpected error occurred: {e}")                                 
                                                                                
                                                                                
# Step 6: Prepare results using .format() for safety                            
if a_est is not None:                                                           
    a_val = "{:.6f}".format(a_est)                                              
    b_val = "{:.6f}".format(b_est)                                              
    r2_val = "{:.6f}".format(r_squared)                                         
                                                                                
    detailed_outcome = """                                                      
