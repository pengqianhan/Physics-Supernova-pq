    The quality of fit for the selected segment is indicated by R-squared:      
{r2_val}.                                                                       
    """.format(shape=full_data.shape, buffer=buffer, num_points=X.shape[0],     
a_est=a_val, b_est=b_val, r2_val=r2_val)                                        
                                                                                
    short_version = "Parameters 'a' and 'b' were estimated successfully.        
