x2 = np.zeros(N)                                                                
for i in range(N):                                                              
    if x1[i] > 0.05:                                                            
        x2[i] = 5 * x1[i] + 2.0                                                 
    elif x1[i] < -0.05:                                                         
        x2[i] = -4 * x1[i] - 1.0                                                
    else:                                                                       
        # If x1 is near zero, let x2 transition smoothly or follow the 'average'
behavior,                                                                       
        # but we want to ensure we capture points *in* the zone |x1|<0.05 where 
a switch might be observed.                                                     
        # For simulation, let's make the transition non-linear around 0 to      
highlight the switch effect.                                                    
        x2[i] = 1.5 * x1[i] + 0.5 * np.tanh(10 * x1[i]) # Simulating            
hysteresis/switch                                                               
                                                                                
# --- Analysis on Synthetic Data ---                                            
threshold = 0.05                                                                
close_to_zero_indices = np.where(np.abs(x1) < threshold)[0]                     
                                                                                
results = []                                                                    
for i in close_to_zero_indices:                                                 
    x1_at_i = x1[i]                                                             
    x2_at_i = x2[i]                                                             
                                                                                
    # Get values immediately before (i-1) and immediately after (i+1)           
    x2_before = x2[i-1] if i > 0 else np.nan                                    
    x2_after = x2[i+1] if i < len(x2) - 1 else np.nan                           
                                                                                
    results.append({                                                            
        'index': i,                                                             
        'time_step': i,                                                         
        'x1': x1_at_i,                                                          
        'x2_at_zero_x1': x2_at_i,                                               
        'x2_before': x2_before,                                                 
        'x2_after': x2_after                                                    
    })                                                                          
                                                                                
# Calculate changes and summarize findings                                      
if results:                                                                     
    # Analyze the change in x2 around these points                              
    # Change before: x2[i] - x2[i-1]                                            
    # Change after: x2[i+1] - x2[i]                                             
                                                                                
    summary = []                                                                
    for r in results:                                                           
        i = r['index']                                                          
                                                                                
        # Boundary checks already performed when creating r, but re-check for   
diff calculation robustness                                                     
        if r['x2_before'] is not np.nan:                                        
            change_before = r['x2_at_zero_x1'] - r['x2_before']                 
        else:                                                                   
            change_before = np.nan                                              
                                                                                
        if r['x2_after'] is not np.nan:                                         
            change_after = r['x2_after'] - r['x2_at_zero_x1']                   
        else:                                                                   
            change_after = np.nan                                               
                                                                                
        summary.append({                                                        
            'index': i,                                                         
            'x1': r['x1'],                                                      
            'x2_curr': r['x2_at_zero_x1'],                                      
            'dx2_pre': change_before,                                           
            'dx2_post': change_after,                                           
            'x2_pre': r['x2_before'],                                           
            'x2_post': r['x2_after'],                                           
        })                                                                      
                                                                                
    # Since there are many points, calculate statistics on the changes (dx2)    
    dx2_pre_values = [s['dx2_pre'] for s in summary if not                      
np.isnan(s['dx2_pre'])]                                                         
    dx2_post_values = [s['dx2_post'] for s in summary if not                    
np.isnan(s['dx2_post'])]                                                        
                                                                                
    print(f"Total points analyzed: {len(results)}")                             
    if dx2_pre_values:                                                          
        print(f"Average change (dx2_pre): {np.mean(dx2_pre_values):.4f}, StdDev:
{np.std(dx2_pre_values):.4f}")                                                  
    if dx2_post_values:                                                         
        print(f"Average change (dx2_post): {np.mean(dx2_post_values):.4f},      
StdDev: {np.std(dx2_post_values):.4f}")                                         
                                                                                
    # Store summary for final output                                            
    final_summary_data = summary                                                
                                                                                
else:                                                                           
